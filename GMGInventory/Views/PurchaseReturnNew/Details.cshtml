@model PurchaseReturnNewDetailedVM

@{
    ViewData["Title"] = "Purchase Return Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseReturn" asp-action="Index">Purchase Returns</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <div class="dropdown float-right ml-2">
                    <button class="btn btn-info btn-sm dropdown-toggle" type="button" id="dropdownMenuPrint" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="fas fa-print"></span> Print
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuPrint">
                        <li><a class="dropdown-item btn-details-print" data-company="GMG">Use GMG Logo</a></li>
                        <li><a class="dropdown-item btn-details-print" data-company="BAS">Use BAS Logo</a></li>
                    </ul>
                </div>
            }
            @if (Model.Status.ToLower() == "draft")
            {
                @if (userAccess.CanEdit)
                {
                    <button type="button" class="btn btn-secondary btn-sm float-right ml-2 btn-details-save">
                        <span class="fas fa-save"></span> Save as Draft
                    </button>
                }
                @if (userAccess.CanAdd)
                {
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2 btn-details-submit">
                        <span class="fas fa-paper-plane"></span> Submit
                    </button>
                }
            }
            else if (Model.Status.ToLower() == "submitted"
            && string.IsNullOrWhiteSpace(Model.ApprovedBy))
            {
                @if (userAccess.CanApproveDisapprove)
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 btn-details-approve">
                        <span class="fas fa-check"></span> Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-disapprove">
                        <span class="fas fa-times"></span> Disapprove
                    </button>
                }
            }
            else if (Model.Status.ToLower() == "disapproved"
            && !string.IsNullOrWhiteSpace(Model?.DisapprovedBy)
            && Model?.ResubmitId == null)
            {
                @if (userAccess.CanAdd)
                {
                    <a href="@Url.Action("Create")/@Model?.Id" class="btn btn-primary btn-sm float-right ml-2">
                        <span class="fas fa-edit"></span> Update to Resubmit
                    </a>
                }
            }
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) || Model?.ResubmitFromId != null)
        {
            <div class="row">
                @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy))
                {
                    <div class="col-12">
                        <div class="alert alert-danger text-sm" role="alert">
                            <strong>Reason of Disapproval:</strong>
                            @(string.IsNullOrWhiteSpace(Model?.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                        </div>
                    </div>
                }
                @if (Model?.ResubmitId != null || Model?.ResubmitFromId != null)
                {
                    <div class="col-12">
                        <div class="alert alert-info text-sm" role="alert">
                            <strong>Resubmit Details:</strong>
                            @if (Model?.ResubmitId != null)
                            {
                                <div>This has been resubmitted. You can view the new one <a href="@Url.Action("Details", "PurchaseReturn", new {Id = Model?.ResubmitId})" class="alert-link">here</a>.</div>
                            }
                            @if (Model?.ResubmitFromId != null)
                            {
                                <div>This is a resubmission. You can view the previous one <a href="@Url.Action("Details", "PurchaseReturn", new {Id = Model?.ResubmitFromId})" class="alert-link">here</a>.</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </span>
                    <b class="d-block">
                        @Model?.DocumentNumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.RRNumber)
                    </span>
                    <b class="d-block">
                        @Model?.RRNumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PONumber)
                    </span>
                    <b class="d-block">
                        @Model?.PONumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Supplier)
                    </span>
                    <b class="d-block">
                        @Model?.Supplier
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Currency)
                    </span>
                    <b class="d-block">
                        @Model?.Currency
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CurrencyRate)
                    </span>
                    <b class="d-block">
                        @Model?.CurrencyRate
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Warehouse)
                    </span>
                    <b class="d-block">
                        @Model?.Warehouse
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DRNumber)
                    </span>
                    <b class="d-block">
                        @Model?.DRNumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SINumber)
                    </span>
                    <b class="d-block">
                        @Model?.SINumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ReturnDate)
                    </span>
                    <b class="d-block">
                        @Model?.ReturnDate
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Status)
                    </span>
                    <b class="d-block">
                        @Model?.Status
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @Model?.Remarks
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedBy)
                        </span>
                        <b class="d-block">
                            @Model?.ApprovedBy
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DisapprovedBy)
                        </span>
                        <b class="d-block">
                            @Model?.DisapprovedBy
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model?.UserCreated
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model?.DateCreated
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model?.UserModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserModified)
                        </span>
                        <b class="d-block">
                            @Model?.UserModified
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.DateModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block">
                            @Model?.DateModified
                        </b>
                    </p>
                </div>
            }
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Purchase Return Item(s)</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>#</th>
                                    <th>Item Code</th>
                                    <th>Part Number</th>
                                    <th>Item Description</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Unit Cost</th>
                                    <th>Total Amount</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th>Total</th>
                                    <th class="total-quantity">0</th>
                                    <th></th>
                                    <th></th>
                                    <th class="total-amount">0.00</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="rr-status" value="@Model?.Status" />

@if (userAccess.CanAdd)
{
    <!-- Purchase Return Item Modal -->
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Purchase Return Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12 col-sm-6 add-code-container">
                                <div class="form-group">
                                    <label for="add-code" class="form-label mb-0">Item Code</label>
                                    <input type="text" id="add-code" name="Code" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-part-container">
                                <div class="form-group">
                                    <label for="add-part" class="form-label mb-0">Part Number</label>
                                    <input type="text" id="add-part" name="PartNumber" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-name-container">
                                <div class="form-group">
                                    <label for="add-name" class="form-label mb-0">Item Name</label>
                                    <select id="add-name" name="Name" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-quantity-container">
                                <div class="form-group">
                                    <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                    <input type="number" min="0" max="1999999" step="1" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-unit-container">
                                <div class="form-group">
                                    <label for="add-unit" class="form-label mb-0">Unit</label>
                                    <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-unit-cost-container">
                                <div class="form-group">
                                    <label for="add-unit-cost" class="form-label mb-0">Unit Cost</label>
                                    <input type="number" step="0.01" id="add-unit-cost" name="UnitCost" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-total-amount-container">
                                <div class="form-group">
                                    <label for="add-total-amount" class="form-label mb-0">Total Amount</label>
                                    <input type="text" id="add-total-amount" name="TotalAmount" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-add">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var ro_status = @Json.Serialize(Model?.Status);

        var itemDT = $('.table-item').DataTable({
            ajax: {
                url: "@Url.Action("GetItemListJson")",
                data: { purchaseReturnId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        if (ro_status.toLowerCase() == "draft") {
                            return '<input type="checkbox" class="to-return" ' + (data.toReturn == true ? 'checked="checked"' : '') +
                                (data.toReturnQuantityD == 0 ? 'disabled' : '') + ' />';
                        } else {
                            return '';
                        }
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "-";
                        } else {
                            return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemPartNumber", name: "ItemPartNumber", className: "form-cell" },
                { data: "itemDescription", name: "ItemDescription", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (ro_status.toLowerCase() == "draft" && data.toReturn == true) {
                            if (data.quantityD > data.toReturnQuantityD) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Can not exceed ' + data.toReturnQuantity + ' received quantity.</label>';
                            } else if (data.quantityD == 0) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Nothing to return.</label>';
                            } else {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                            }
                        } else {
                            return data.quantity;
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                { data: "unitCost", name: "UnitCost", className: "form-cell" },
                { data: "totalAmount", name: "TotalAmount", className: "form-cell" }
            ],
            order: [[1, "asc"]],
            createdRow: function (row, data, dataIndex) {
                if (data.toReturn == false) {
                    $(row).addClass('text-muted');
                }
            },
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 5);
                columnDTTotalDecimal(api, 8);
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".quantity").off("change").on("change", function () {
                var row = itemDT.row($(this).closest('tr'));
                var rowData = row.data();

                var lineNumber = rowData.lineNumber;

                var quantityValue = parseFloat($(row.node()).find(".quantity").val()) || 0;

                var totalValue = quantityValue * rowData.unitCostD;

                rowData.quantity = FormatStringInteger(quantityValue);
                rowData.quantityD = quantityValue;
                rowData.totalAmount = FormatStringDecimal(totalValue);
                rowData.totalAmountD = totalValue;

                row.data(rowData).draw(false);

                setTimeout(function () {
                    var restoredRow = $(itemDT.row(function (idx, data) {
                        return data.lineNumber == lineNumber;
                    }).node());
                    if (restoredRow) {
                        var restoredInput = $(restoredRow).find(".quantity");

                        if (restoredInput.length)
                            restoredInput.focus();
                    }
                }, 0);
            });

            $(".to-return").off("change").on("change", function () {
                var tr = $(this).closest('tr');
                var row = itemDT.row(tr);
                var rowData = row.data();
           
                if ($(this).prop("checked")) {
                    var quantityValue = rowData.toReturnQuantityD;
                    var totalValue = quantityValue * rowData.unitCostD;

                    rowData.quantity = FormatStringInteger(quantityValue);
                    rowData.quantityD = quantityValue;
                    rowData.totalAmount = FormatStringDecimal(totalValue);
                    rowData.totalAmountD = totalValue;

                    rowData.toReturn = true;
                    tr.removeClass("text-muted");
                } else {
                    rowData.quantity = FormatStringInteger(0);
                    rowData.quantityD = 0;
                    rowData.totalAmount = FormatStringDecimal(0);
                    rowData.totalAmountD = 0;

                    rowData.toReturn = false;
                    tr.addClass("text-muted");
                }
                row.data(rowData).draw(false);
            });
        });

        if (user_access.canAdd) {

            function GetItemsToReturn() {
                var item_to_return = [];
                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                    row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));
                    item_to_return.push(row_data);
                });
                return item_to_return;
            }

            $(".btn-details-save").on("click", function () {
                SaveReturn("Draft");
            });

            $(".btn-details-submit").on("click", function () {
                SaveReturn("Submitted");
            });

            function SaveReturn(status) {
                var items = itemDT.data();
                if (items.filter(s => s.toReturn == true).length == 0) {
                    toastr.warning("No item to return. Select an item on the list to continue", "Warning");
                } else if (items.filter(s => s.toReturn == true && parseInt(s.quantity) == 0).length > 0) {
                    toastr.warning("Some items have 0 quantity. Can't return an item with 0 quantity", "Warning");
                } else if (items.filter(s => s.toReturn == true && parseInt(s.quantity) > parseInt(s.toReturnQuantityD)).length > 0) {
                    toastr.warning("Some items exceed purchase receive quantity. Can't return an item that exceeds to return quantity.", "Warning");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("SaveItemsJson")",
                        data: {
                            Id: @Model?.Id,
                            status: status,
                            items: GetItemsToReturn()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Success") {
                                window.location.reload();
                            } else {
                                toastr.error(data.message, data.status);
                            }
                        }
                    });
                }
            }
        }

        if (user_access.canApproveDisapprove) {
            $('.btn-details-approve').click(function (e) {
                swal({
                    title: "Approve Purchase Return",
                    text: "Continue to approve this purchase return?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("ApproveJson")",
                            type: "POST",
                            data: { Id: @Model!.Id },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });

            $('.btn-details-disapprove').click(function (e) {
                swal({
                    title: "Disapprove Purchase Return",
                    text: "Continue to disapprove this purchase return?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                    content: {
                        element: "input",
                        attributes: {
                            placeholder: "Reason for Disapproving",
                            type: "text"
                        }
                    }
                }).then((confirm) => {
                    if (confirm != null) {
                        $.ajax({
                            url: "@Url.Action("DisapproveJson")",
                            type: "POST",
                            data: {
                                Id: @Model!.Id,
                                reason: confirm
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                var print_company = $(this).data("company");
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintDetails")/' + @Model?.Id + '?Company=' + print_company, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
}
