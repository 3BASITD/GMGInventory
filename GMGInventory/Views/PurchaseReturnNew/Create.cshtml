@{
    if (TempData["PurchaseReturnId"] != null)
    {
        ViewData["Title"] = "Resubmit Purchase Return";
    }
    else
    {

        ViewData["Title"] = "New Purchase Return";
    }
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseReturn" asp-action="Index">Purchase Returns</a></li>
}

<div class="card card-default">
    <form id="form-return">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                    <span class="fas fa-paper-plane"></span> @(TempData["PurchaseReturnId"] != null ? "Resubmit" : "Submit")
                </button>
                <input type="hidden" id="action-type" name="ActionType" value="">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-document-number" class="form-label mb-0">Document Number</label>
                        <input type="text" id="return-document-number" name="DocumentNumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-rrnumber" class="form-label mb-0">Purchase Receiving Number</label>
                        <select id="return-rrnumber" name="RRNumber" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-ponumber" class="form-label mb-0">Purchase Order Number</label>
                        <input type="text" id="return-ponumber" name="PONumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-supplier" class="form-label mb-0">Supplier</label>
                        <input type="text" id="return-supplier" name="Supplier" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-currency" class="form-label mb-0">Currency</label>
                        <input type="text" id="return-currency" name="Currency" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-currency-rate" class="form-label mb-0">Currency Rate</label>
                        <input type="text" id="return-currency-rate" name="CurrencyRate" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-warehouse" class="form-label mb-0">Warehouse</label>
                        <div class="form-switch float-right text-xs">
                            <input type="checkbox" id="return-same-warehouse" class="form-check-input" checked="checked" disabled="disabled" />
                            <label for="return-same-warehouse" class="form-check-label">Same with Purchase Receiving</label>
                        </div>
                        <input type="text" id="return-warehouse" class="form-control form-control-sm" readonly="readonly" />
                        <select id="return-warehouse-select" name="Warehouse" class="form-select form-select-sm" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-drnumber" class="form-label mb-0">Delivery Receipt Number</label>
                        <input type="text" id="return-drnumber" name="DRNumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-sinumber" class="form-label mb-0">Sales Invoice Number</label>
                        <input type="text" id="return-sinumber" name="SINumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-date-returned" class="form-label mb-0">Date Returned</label>
                        <input type="date" id="return-date-returned" name="DateReturned" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="return-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Purchase Return Item(s)</span>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Item Code</th>
                                        <th>Part Number</th>
                                        <th>Item Description</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Cost</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th>Total</th>
                                        <th class="total-quantity">0</th>
                                        <th></th>
                                        <th></th>
                                        <th class="total-amount">0.00</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@if (TempData["PurchaseReturnId"] != null)
{
    <input type="hidden" id="resubmitROId" value="@TempData["PurchaseReturnId"]" />
}

@section Scripts {
    <script>
        if ($("#resubmitROId").length) {
            // for resubmitting a disapproved sales order
            $.ajax({
                type: "post",
                url: "@Url.Action("DetailsJson")",
                data: {
                    id: $("#resubmitROId").val()
                },
                success: function (data, status, xhr) {
                    $("#return-document-number").val(data.documentNumber);

                    $("#return-warehouse").val(data.poWarehouse);
                    $("#return-warehouse").data("Id", data.poWarehouseId);
                    $("#return-warehouse").data("selectedId", data.warehouseId);
                    $("#return-same-warehouse").prop("disabled", false);
                    loadWarehouse(data.warehouseId, data.isSameWarehouse);

                    $("#return-date-returned").val(data.returnDate3);
                    $("#return-remarks").val(data.remarks);
                    loadRRNumber(data.poNumber);
                    $("#return-rrnumber").select2({
                        ajax: null, //already fetched outside
                        disabled: true
                    });
                },
                complete: function (xhr, status) {
                }
            });
        } else {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetNewDocumentNumber")",
                success: function (data, status, xhr) {
                    $("#return-document-number").val(data);
                }
            });
            loadRRNumber(-1);
            loadSelect2Warehouse(null, true);
        }

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        return '<input type="checkbox" class="to-return" ' + (data.toReturn == true ? 'checked="checked"' : '') +
                            (data.toReturnQuantityD == 0 ? 'disabled' : '') + ' />';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "<span class='text-muted'>N/A</span>";
                        } else {
                            return "<a href='/Item/Details/" + data.itemId + "' class='link-info' target='_blank'>" + data.itemCode + "</a>";
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemPartNumber", name: "ItemPartNumber", className: "form-cell" },
                { data: "itemDescription", name: "ItemDescription", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.toReturn == true) {
                            if (data.quantityD > data.toReturnQuantityD) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Can not exceed ' + data.toReturnQuantity + ' remaining received quantity.</label>';
                            } else if (data.quantityD == 0) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Nothing to return.</label>';
                            } else {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                            }
                        } else {
                            return data.quantity;
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                { data: "unitCost", name: "UnitCost", className: "form-cell" },
                { 
                    data: "totalAmount",
                    name: "TotalAmount",
                    className: "form-cell",
                    render: function (data, type, row) {
                        if (type === 'display') {
                            return $("#return-currency").val().split("/")[0].trim() + '&nbsp;' + data;
                        }

                        return data;
                    }
                }
            ],
            order: [[1, "asc"]],
            createdRow: function (row, data, dataIndex) {
                if (data.toReturn == false) {
                    $(row).addClass('text-muted');
                }
            },
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 5);
                columnDTTotalDecimal(api, 8, $("#return-currency").val().split("/")[0].trim() + '&nbsp;');
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".quantity").off("change").on("change", function () {
                var row = itemDT.row($(this).closest('tr'));
                var rowData = row.data();

                var lineNumber = rowData.lineNumber;

                var quantityValue = parseFloat($(row.node()).find(".quantity").val()) || 0;

                var totalValue = quantityValue * rowData.unitCostD;

                rowData.quantity = FormatStringInteger(quantityValue);
                rowData.quantityD = quantityValue;
                rowData.totalAmount = FormatStringDecimal(totalValue);
                rowData.totalAmountD = totalValue;

                row.data(rowData).draw(false);

                setTimeout(function () {
                    var restoredRow = $(itemDT.row(function (idx, data) {
                        return data.lineNumber == lineNumber;
                    }).node());
                    if (restoredRow) {
                        var restoredInput = $(restoredRow).find(".quantity");

                        if (restoredInput.length)
                            restoredInput.focus();
                    }
                }, 0);
            });

            $(".to-return").off("change").on("change", function () {
                var tr = $(this).closest('tr');
                var row = itemDT.row(tr);
                var rowData = row.data();

       
                if ($(this).prop("checked")) {
                    var quantityValue = rowData.toReturnQuantityD;
                    var totalValue = quantityValue * rowData.unitCostD;

                    rowData.quantity = FormatStringInteger(quantityValue);
                    rowData.quantityD = quantityValue;
                    rowData.totalAmount = FormatStringDecimal(totalValue);
                    rowData.totalAmountD = totalValue;

                    rowData.toReturn = true;
                    tr.removeClass("text-muted");
                } else {
                    rowData.quantity = FormatStringInteger(0);
                    rowData.quantityD = 0;
                    rowData.totalAmount = FormatStringDecimal(0);
                    rowData.totalAmountD = 0;

                    rowData.toReturn = false;
                    tr.addClass("text-muted");
                }
                row.data(rowData).draw(false);
            });
        });

        // Load purchase receiving for select2
        function loadRRNumber(selectedReceiving) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseReceivingOptions")",
                data: {
                    SelectedId: selectedReceiving
                },
                success: function (data, status, xhr) {
                    $("#return-rrnumber").select2({
                        ajax: null, //already fetched outside
                        minimumInputLength: -1,
                        placeholder: "<empty>",
                        allowClear: true,
                        data: data
                    }).off("select2:select").on("select2:select", function () {
                        loadRRDetails();
                    }).off("select2:unselecting").on("select2:unselecting", function () {
                        $("#return-ponumber").val("");
                        $("#return-ponumber").removeData("Id");
                        $("#return-supplier").val("");
                        $("#return-supplier").removeData("Id");
                        $("#return-currency").val("");
                        $("#return-currency").removeData("Id");
                        $("#return-currency-rate").val("");

                        //$("#return-warehouse").val("");
                        $("#return-warehouse").removeData("Id");
                        $("#return-warehouse").removeData("selectedId");
                        loadWarehouse(2, true);
                        $("#return-same-warehouse").prop("disabled", true);
                        $("#return-same-warehouse").prop("checked", true);

                        $("#return-drnumber").val("");
                        $("#return-sinumber").val("");
                        itemDT.clear().draw();
                    });
                    if (selectedReceiving == -1) {
                        $("#return-rrnumber").val(null).trigger('change');
                    } else {
                        loadRRDetails();
                    }
                }
            });
        }

        function loadWarehouse(selectedId, isSame) {
            if ($.fn.select2 && !$("#return-warehouse-select").hasClass("select2-hidden-accessible")) {
                loadSelect2Warehouse(selectedId, isSame);
            } else {
                $("#return-warehouse-select").val(selectedId).trigger("change");
            }
            $("#return-warehouse").toggleClass("d-none", isSame);
            $("#return-warehouse-select").next(".select2-container").toggleClass("d-none", !isSame);
        }

        function loadSelect2Warehouse(selectedId, isSame) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Warehouse")",
                data: {
                    IncludeId: selectedId
                },
                success: function (data, status, xhr) {
                    $("#return-warehouse-select").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        minimumResultsForSearch: -1,
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                        }
                    });

                    $("#return-same-warehouse").prop("checked", isSame);
                    $("#return-warehouse").data("Id", selectedId);
                    $("#return-warehouse").toggleClass("d-none", !isSame);
                    $("#return-warehouse-select").next(".select2-container").toggleClass("d-none", isSame);
                }
            });
        }

        $("#return-same-warehouse").on("change",function() {
            $("#return-warehouse").toggleClass("d-none", !$(this).prop("checked"));
            $("#return-warehouse-select").next(".select2-container").toggleClass("d-none", $(this).prop("checked"));
            $("#return-warehouse-select").val($("#return-warehouse").data("selectedId") || $("#return-warehouse").data("Id")).trigger("change");
        });

        // Load purchase receiving for select2
        function loadRRDetails() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("DetailsJson", "PurchaseReceive")",
                data: {
                    Id: $("#return-rrnumber").val()
                },
                success: function (data, status, xhr) {
                    $("#return-ponumber").val(data.poNumber);
                    $("#return-ponumber").data("Id", data.poId);
                    $("#return-supplier").val(data.supplier);
                    $("#return-supplier").data("Id", data.supplierId);
                    $("#return-currency").val(data.currency);
                    $("#return-currency").data("Id", data.currencyId);
                    $("#return-currency-rate").val(data.currencyRate);

                    $("#return-warehouse").val(data.warehouse);
                    $("#return-warehouse").data("Id", data.warehouseId);
                    $("#return-same-warehouse").prop("disabled", false);

                    $("#return-drnumber").val(data.drNumber);
                    $("#return-sinumber").val(data.siNumber);
                },
                complete: function (xhr, status) {
                    loadRRItems();
                }
            });
        }

        function loadRRItems() {
            if ($("#return-rrnumber").prop("disabled")) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetItemListJson")",
                    data: {
                        purchaseReturnId: $("#resubmitROId").val()
                    },
                    success: function (data, status, xhr) {
                        $.each(data, function (i, v) {
                            itemDT.row.add(v).draw();
                        });
                    }
                });
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetItemsFromRRListJson")",
                    data: {
                        purchaseReceiveId: $("#return-rrnumber").val()
                    },
                    beforeSend: function (xhr, settings) {
                        itemDT.clear();
                    },
                    success: function (data, status, xhr) {
                        $.each(data, function (i, v) {
                            itemDT.row.add({
                                toReturn: false,
                                itemId: v.itemId,
                                itemCode: v.itemCode,
                                itemDescription: v.itemDescription,
                                itemPartNumber: v.itemPartNumber,
                                lineNumber: v.lineNumber,
                                quantity: FormatStringInteger(0),
                                quantityD: 0,
                                receivingItemId: v.receivingItemId,
                                receivedQuantity: v.quantity,
                                receivedQuantityD: v.quantityD,
                                toReturnQuantity: v.toReturnQuantity,
                                toReturnQuantityD: v.toReturnQuantityD,
                                unitId: v.unitId,
                                unitCode: v.unitCode,
                                unitCost: FormatStringDecimal(v.unitCost),
                                unitCostD: v.unitCost,
                                totalAmount: FormatStringDecimal(0),
                                totalAmountD: 0
                            });
                        });
                    },
                    complete: function (xhr, status) {
                        itemDT.draw();
                    }
                });
            }
        }

        $("#form-return button[type=submit]").on("click", function () {
            $("#action-type").val($(this).data("action"));
        });

        // Validation for Create
        var validateCreate = $("#form-return").validate({
            rules: {
                RRNumber: {
                    required: true
                },
                DateReturned: {
                    required: true
                },
                Remarks: {
                    maxlength: 500
                }
            },
            messages: {
                RRNumber: {
                    required: "Please select a purchase receiving number."
                },
                DateReturned: {
                    required: "Please enter the date of return."
                },
                Remarks: {
                    maxlength: "Remarks can not exceed 500 characters."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveReturn();
            }
        });

        function GetItemsToReturn() {
            var item_to_return = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));
                item_to_return.push(row_data);
            });
            return item_to_return;
        }

        function SaveReturn() {
            var items = itemDT.data();
            if (items.filter(s => s.toReturn == true).length == 0) {
                toastr.warning("No item to return. Select an item on the list to continue", "Warning");
            } else if (items.filter(s => s.toReturn == true && parseInt(s.quantity) == 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't return an item with 0 quantity", "Warning");
            } else if (items.filter(s => s.toReturn == true && parseInt(s.quantity) > parseInt(s.toReturnQuantityD)).length > 0) {
                toastr.warning("Some items exceed purchase receive quantity. Can't return an item that exceeds purchase receive quantity.", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddJson")",
                    data: {
                        ReceivingId: $("#return-rrnumber").val(),
                        WarehouseId: $("#return-warehouse-select").val(),
                        DateReturn: $("#return-date-returned").val(),
                        Remarks: $("#return-remarks").val(),
                        Status: $("#action-type").val(),
                        ResubmitId: $("#resubmitROId").val(),
                        Items: GetItemsToReturn()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
}
