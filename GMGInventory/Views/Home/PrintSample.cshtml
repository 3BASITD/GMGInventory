@{
    Layout = "";
    var title = "Print Sample";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
    <style>
            @for (int ctr = 10; ctr <= 40; ctr+=2)
        {
            <text>.f@(ctr) { font-size: @(ctr)px!important; }</text>
            
        }
            @for (int ctr = 10; ctr <= 40; ctr+=5)
        {
            <text>.w@(ctr) { width: @(ctr * 5)px!important; }</text>
        }
    </style>
</head>
<body>
    <h3>@title</h3>
    <table class="table-items">
        <tbody>
            @for (int ctr = 10; ctr <= 40; ctr+=2)
            {
                <text>
                <tr class="f@(ctr)">
                    <th class="f@(ctr)">Font Size @(ctr)</th>
                    <td class="f@(ctr)">#@(ctr)</td>
                </tr>
                </text>
            }
        </tbody>
    </table>
            @for (int ctr = 10; ctr <= 40; ctr+=5)
            {
    <table class="table-items">
        <tbody>
                <tr class="f12">
                    <th class="w@(ctr)">Width Size @(ctr * 5)</th>
                    <td class="w@(ctr)">Width Size @(ctr * 5)</td>
                    <td class="w@(ctr)">#@(ctr * 5)</td>
                    <td></td>
                </tr>
        </tbody>
    </table>
            }
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>