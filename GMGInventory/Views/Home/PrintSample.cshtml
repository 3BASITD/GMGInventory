@{
    Layout = "";
    var title = "Print Sample";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
    <style>
        @for (int ctr = 10; ctr <= 20; ctr++)
        {
            <text>.f@(ctr) { font-size: @(ctr)px!important; }</text>
        }
    </style>
</head>
<body>
    <h3>@title</h3>
    <p>
        @for (int ctr = 10; ctr <= 20; ctr++)
        {
            <text>
                <strong class="f@(ctr)">Font Size @(ctr)</strong>
                <span class="f@(ctr)">Font Size @(ctr)</span>
                <br />
            </text>
        }
    </p>
    <table class="table-items">
        <thead>
            @for (int ctr = 10; ctr <= 20; ctr++)
            {
                <text>
                <tr class="f@(ctr)">
                    <th class="f@(ctr)">Name</th>
                    <th class="f@(ctr)">Description</th>
                    <th class="f@(ctr)">Code</th>
                    <th class="f@(ctr)">Date</th>
                </tr>
                </text>
            }
        </thead>
        <tbody>
            @for (int ctr = 10; ctr <= 20; ctr++)
            {
                <text>
                <tr class="f@(ctr)">
                    <td class="f@(ctr)">Font Size @(ctr)</td>
                    <td class="f@(ctr)">A quick brown fox jumps over the lazy dog.</td>
                    <td class="f@(ctr)">#@(ctr)</td>
                    <td class="f@(ctr)">@DateTime.MinValue.ToString()</td>
                </tr>
                </text>
            }
        </tbody>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>