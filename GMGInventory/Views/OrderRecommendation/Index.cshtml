@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Item Class
        $("#filter-class").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "ItemClass")"
            },
            dropdownParent: $('#filterModal')
        });

        // Load Select2 for Brand
        $("#filter-brand").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Brand")"
            },
            dropdownParent: $('#filterModal')
        });

        var recommendationState = {};
        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            if (Object.keys(recommendationState).length == 0) {
                DoApplyFilter();
            } else {
                swal({
                    title: "Selection Resets on Filter",
                    text: "Some movements are already checked; applying a filter will clear the selected items. Are you sure you want to continue?",
                    icon: "info",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        recommendationState = {};
                        DoApplyFilter();
                    }
                });
            }
        }

        function DoApplyFilter() {
            $("#filterModal").modal("hide");
            recommendationDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            if (Object.keys(recommendationState).length == 0) {
                DoResetFilter();
            } else {
                swal({
                    title: "Selection Resets on Filter",
                    text: "Some movements are already checked; applying a filter will clear the selected items. Are you sure you want to continue?",
                    icon: "info",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        recommendationState = {};
                        DoResetFilter();
                    }
                });
            }
        }

        function DoResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            recommendationDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[1, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            MovementId: "",
            ItemClass: "",
            ItemClassId: "",
            Brand: "",
            BrandId: "",
            // Preset: "L7D",
            // DateFrom: DateForInput(getFilterDefaultDateFrom()),
            // DateTo: DateForInput(getFilterDefaultDateTo())
            TargetDays: "7"
        };

        function checkDTChanged() {
            if(!recommendationDT) return false;
            
            return JSON.stringify(recommendationDT.order()) != JSON.stringify(defaultDTState.order) ||
                   recommendationDT.page.info().start != defaultDTState.page ||
                   recommendationDT.page.len() != defaultDTState.length ||
                   (recommendationDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-movement").val() != defaultDTState.MovementId ||
                   $("#filter-class").val() != defaultDTState.ItemId ||
                   $("#filter-brand").val() != defaultDTState.BrandId ||
                   // $("#filter-preset").val() != defaultDTState.Preset ||
                   // $('#filter-from').val() != defaultDTState.DateFrom ||
                   // $('#filter-to').val() != defaultDTState.DateTo;
                   $('#filter-days').val() != defaultDTState.TargetDays;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);

            $('#filter-movement').val(defaultDTState.ItemId);
            $('#filter-class').val(defaultDTState.ItemClassId).trigger('change');
            $('#filter-brand').val(defaultDTState.BrandId).trigger('change');
            // $('#filter-preset').val(defaultDTState.Preset);
            // applyFilterPreset(defaultDTState.Preset);
            $('#filter-days').val(defaultDTState.TargetDays);
            
            if (recommendationDT) {
                recommendationDT.state.clear();
                recommendationDT.order(defaultDTState.order);
                recommendationDT.page(defaultDTState.page);
                recommendationDT.search(defaultDTState.search.search);
            }
        }

        var recommendationDT = $('.table-recommendation').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.MovementId = $('#filter-movement').val();
                data.ItemClass = $('#filter-class option:selected').text();
                data.ItemClassId = $('#filter-class').val();
                data.Brand = $('#filter-brand option:selected').text();
                data.BrandId = $('#filter-brand').val();
                // data.Preset = $('#filter-preset').val();
                // data.DateFrom = $('#filter-from').val();
                // data.DateTo = $('#filter-to').val();
                data.TargetDays = $('#filter-days').val();
            },
            stateLoadParams: function (settings, data) {
                $('#filter-movement').val(data.MovementId);
                if(data.ItemClassId) {
                    var itemClassOption = new Option(data.ItemClass, data.ItemClassId, true, true);
                    $(itemClassOption).data('data', {
                        id: data.ItemClassId,
                        text: data.ItemClass
                    });
                    $("#filter-class").append(itemClassOption).trigger('change');
                }
                if(data.BrandId) {
                    var brandOption = new Option(data.Brand, data.BrandId, true, true);
                    $(brandOption).data('data', {
                        id: data.BrandId,
                        text: data.Brand
                    });
                    $("#filter-brand").append(brandOption).trigger('change');
                }
                // $('#filter-preset').val(data.Preset).trigger('change');
                // $('#filter-from').prop('readonly', data.Preset != "");
                // $('#filter-from').val(data.DateFrom);
                // $('#filter-to').prop('readonly', data.Preset != "");
                // $('#filter-to').val(data.DateTo);
                $('#filter-days').val(data.TargetDays);
            },
            ajax: {
                url: "@Url.Action("GetOrderRecommendationDT")",
                 data: function (data) {
                    var movementId = $("#filter-movement").val();
                    if (movementId) data.MovementCategory = movementId;
                    
                    var itemClassId = $("#filter-class").val();
                    if (itemClassId) data.ItemClassId = itemClassId;
                    
                    var brandId = $("#filter-brand").val();
                    if (brandId) data.BrandId = brandId;

                    // data.DateFrom = $("#filter-from").val();
                    // data.DateTo = $("#filter-to").val();

                    data.TargetDays = $('#filter-days').val();
                },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        if (user_access.canAdd) {
                            return '<input class="sochkclassorder" type="checkbox" ' + ( recommendationState[data.itemId + "_" + data.warehouseId + "_" + (data.locationCodeId || 0)] ? 'checked="checked" ' : '') + ' onchange="SORowSelect(this)" />';
                        } else {
                            return '<span class="text-warning" data-microtip-title="Select item to request&#10;Add access is required." data-microtip-position="right" role="tooltip"><span class="fas fa-exclamation-triangle"></span></span>';
                        }
                    }
                },
                // { data: "itemNumber", name: "ItemNumber" },
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Item/Details/" + data.itemId + "' class='link-info' target='_blank'>" + data.itemCode + "</a>";
                    },
                    name: "ItemCode"
                },
                { data: "partNumber", name: "PartNumber" },
                { data: "itemName", name: "ItemName" },
                {
                    data: function (data, type, dataToSet) {
                        return data.stockOnHand > 0 ? data.stockOnHand : "<span class='text-muted'>0</span>";
                    },
                    name: "StockOnHand", 
                    className: "text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.locationCode || "<span class='text-muted'>N/A</span>";
                    },
                    name: "LocationCode"
                },
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Warehouse/Details/" + data.warehouseId + "' class='link-info' target='_blank'>" + data.warehouse + "</a>";
                    },
                    name: "Warehouse"
                },
                {
                    data: function (data, type, dataToSet) {
                        var msg = `
                        <b>INVOICES</b>
                        <table style='width:100%; border-collapse:collapse;'>
                            <tr>
                                <td>Latest 7 days</td>
                                <td style='text-align:right;'>${data.lastWeekQuantity}</td>
                            </tr>
                            <tr>
                                <td>Latest 30 days</td>
                                <td style='text-align:right;'>${data.lastMonthQuantity}</td>
                            </tr>
                            <tr>
                                <td>Latest 60 days</td>
                                <td style='text-align:right;'>${data.last2MonthsQuantity}</td>
                            </tr>
                            <tr>
                                <td>Latest 365 days&emsp;</td>
                                <td style='text-align:right;'>${data.lastYearQuantity}</td>
                            </tr>
                            <tr>
                                <td><b>All</b></td>
                                <td style='text-align:right;'><b>${data.overallQuantity}</b></td>
                            </tr>
                        </table>
                        `;
                        return '<span class="movement-tooltip" data-tippy-content="' + msg + '" data-tippy-placement="right" data-tippy-theme="translucent">' + data.movementCategory + '</span>';
                    },
                    name: "MovementCategory"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemClass || "<span class='text-muted'>N/A</span>";
                    },
                    name: "ItemClass"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.suggestedOrderQuantity > 0 ? data.suggestedOrderQuantity : "<span class='text-muted'>0</span>";
                    },
                    name: "SuggestedOrderQuantity",
                    className: "text-end"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        if (user_access.canAdd && recommendationState[data.itemId + "_" + data.warehouseId + "_" + (data.locationCodeId || 0)]) {
                            //data.orderQuantityD = recommendationState[data.itemId + "_" + data.warehouseId + "_" + (data.locationCodeId || 0)].orderQuantity;
                            if (data.orderQuantityD > data.suggestedOrderQuantityD) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.orderQuantityD + '" class="form-control form-control-sm orderquantity" style="width: 100%;" /><label class="text-warning text-xs fw-lighter fst-italic m-0">Requesting higher than suggested quantity</label>';
                            } else if (data.orderQuantityD == 0) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.orderQuantityD + '" class="form-control form-control-sm orderquantity" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Cannot request a 0 quantity</label>';
                            } else if (isNaN(data.orderQuantityD) || String(data.orderQuantityD).trim() == "" || data.orderQuantityD < 0) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.orderQuantityD + '" class="form-control form-control-sm orderquantity" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Invalid quantity</label>';
                            } else {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.orderQuantityD + '" class="form-control form-control-sm orderquantity" style="width: 100%;" />';
                            }
                        } else {
                            return '-';
                        }
                    },
                    name: "OrderQuantity",
                    className: "form-cell text-end"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var msg = "";
                        if (data.latestOrderCostD) msg = "Using unit cost from the latest purchase order";
                        else if (data.beginningCostD) msg = "No purchase order found for this item; using beginning cost"
                        else msg = "No purchase orders found and no beginning cost assigned";
                        return '<span data-microtip-title="' + msg + '" data-microtip-position="left" role="tooltip">' + data.unitCost + '</span>';
                    },
                    name: "UnitCost",
                    className: "text-end"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        return data.totalCost;
                    },
                    name: "TotalCost",
                    className: "text-end"
                }
            ],
            order: defaultDTState.order
        }).on("draw", function () {
            checkDefaultFilter();
            tippy('.movement-tooltip', {
                allowHTML: true
            });
        });

        function SORowSelect(elem) {
            var tr = $(elem).closest('tr');
            var row = recommendationDT.row(tr);
            var rowData = row.data();

            var isChecked = $(elem).prop("checked");
            if (isChecked) {
                recommendationState[rowData.itemId + "_" + rowData.warehouseId + "_" + (rowData.locationCodeId || 0)] = {
                    itemId: rowData.itemId,
                    warehouseId: rowData.warehouseId,
                    locationCodeId: rowData.locationCodeId,
                    orderQuantity: parseInt(rowData.suggestedOrderQuantityD)
                };
            } else {
                delete recommendationState[rowData.itemId + "_" + rowData.warehouseId + "_" + (rowData.locationCodeId || 0)];
            }
            
            rowData.orderQuantityD = isChecked ? parseInt(rowData.suggestedOrderQuantityD) : 0;
            
            row.data(rowData);
            row.invalidate();
        }

        $(document).on("blur", ".orderquantity", function() {
            var tr = $(this).closest('tr');
            var row = recommendationDT.row(tr);
            var rowData = row.data();

            recommendationState[rowData.itemId + "_" + rowData.warehouseId + "_" + (rowData.locationCodeId || 0)].orderQuantity = parseInt($(this).val());
            
            rowData.orderQuantityD = parseInt($(this).val() || 0);

            row.data(rowData);
            row.invalidate();
        });
        
        if (user_access.canAdd) {
            $('.btn-add').click(function (e) {
                var selected = Object.values(recommendationState).map(x => ({
                    itemId: x.itemId,
                    quantity: x.orderQuantity
                }));
                if(selected.length > 0) {
                    swal({
                        title: "Add to Purchase Request",
                        text: "You are about to add all selected item to purchase request. Are you sure you want to continue?",
                        icon: "info",
                        buttons: true,
                        successMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            $.ajax({
                                url: "@Url.Action("AddRequest")",
                                type: "POST",
                                data: { recos: selected },
                                success: function (data, status, xhr) {
                                    if (data.purchaseRequestId)
                                        $(".add-purchase-request").html("<a href='/PurchaseRequest/Details/" + data.purchaseRequestId + "' class='link-info' target='_blank'>" + data.documentNumber + "</a>");
                                    else
                                        $(".add-purchase-request").html("<span class='text-muted'>N/A</span>");
                                    
                                    if (data.status) 
                                        $(".add-status").text(data.status);
                                    else 
                                        $(".add-status").html("<span class='text-muted'>N/A</span>");
                                    
                                    $(".table-added tbody").empty();
                                    var tbody = "";
                                    if (data.items.length > 0) {
                                        data.items.forEach(function(item) {
                                            tbody += "<tr><td>" + item.partNumber + "</td><td class='text-end'>" + item.quantity + "</td><td>" + item.status + "</td></tr>";
                                        });
                                    } else { 
                                        tbody += "<tr><td colspan='3'><em class='text-center'>No items were added.</em></td></tr>";
                                    }
                                    $(".table-added tbody").html(tbody);

                                    $("#addModal").modal("show");
                                }
                            });
                        }
                    });
                } else {
                    swal({
                        title: "Add to Purchase Request",
                        text: "Please select at least one item to add to the Purchase Request before continuing",
                        icon: "warning",
                        button: "OK"
                    });
                }
            });
        }
    </script>
}