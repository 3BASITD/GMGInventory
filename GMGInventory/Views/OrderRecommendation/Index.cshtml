@{
    ViewData["Title"] = "Order Recommendation";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
    var purchaseHistories = (List<OrderRecommendationHistoryVM>?)ViewData["PurchaseHistory"];
    var issuanceHistories = (List<OrderRecommendationHistoryVM>?)ViewData["IssuanceHistory"];
}
@* 
<div class="alert alert-warning" role="alert">
    <span class="fas fa-exclamation-triangle mr-3"></span><strong>COMMING SOON</strong> We’re currently working on this page to bring you new features and improvements. Please check back again soon.
</div> *@

@* <div class="alert alert-info" role="alert">
    <span class="fas fa-exclamation-triangle mr-3"></span>You are using a v4 enhancement feature. This message will be removed once v4 is completed and made available as a fully paid version.
</div> *@

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right btn-filter ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanAdd)
            {
                <button type="button" class="btn btn-primary btn-sm float-right btn-add ml-2">
                    <span class="fas fa-plus"></span>Add
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Add&#10;Add access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-plus mr-0"></span>
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-recommendation">
            <thead>
                <tr>
                    <th></th>
                    @* <th>Item Number</th> *@
                    <th>Item Code</th>
                    <th>Part Number</th>
                    <th>Item Name</th>
                    <th>Stock on Hand</th>
                    <th>Location Code</th>
                    <th>Warehouse</th>
                    <th>Movement Category</th>
                    <th>Item Class</th>
                    <th>Suggested Order Quantity</th>
                    <th>Order Quantity</th>
                    <th>Unit Cost</th>
                    <th>Total Cost</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (purchaseHistories != null)
{
    <div class="card shadow-sm">
        <div class="card-header">
            <h3 class="card-title mr-2">Purchase History</h3>
            <span data-microtip-title="Purchase Order Count by Order Date (Approved)" data-microtip-position="top" role="tooltip"><span class="fas fa-info-circle"></span></span>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover table-order">
                <thead class="thead-light">
                    <tr>
                        <th>Year</th>
                        @for (var month = 1; month <= 12; month++)
                        {
                            var dt = new DateTime(2000, month, 1);
                            <th>@dt.ToString("MMMM")</th>
                        }
                        <th>Average</th>

                    </tr>
                </thead>
                <tbody>
                    @if (purchaseHistories.Count == 0)
                    {
                        <tr>
                            <td><em class="text-center">No records can be found.</em></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var purchaseHistory in purchaseHistories)
                        {
                            <tr>
                                <td>@purchaseHistory.Year</td>

                                <td class="text-end@(purchaseHistory.JanuaryD == 0 ? " text-muted" : "")">@purchaseHistory.January</td>
                                <td class="text-end@(purchaseHistory.FebruaryD == 0 ? " text-muted" : "")">@purchaseHistory.February</td>
                                <td class="text-end@(purchaseHistory.MarchD == 0 ? " text-muted" : "")">@purchaseHistory.March</td>
                                <td class="text-end@(purchaseHistory.AprilD == 0 ? " text-muted" : "")">@purchaseHistory.April</td>
                                <td class="text-end@(purchaseHistory.MayD == 0 ? " text-muted" : "")">@purchaseHistory.May</td>
                                <td class="text-end@(purchaseHistory.JuneD == 0 ? " text-muted" : "")">@purchaseHistory.June</td>
                                <td class="text-end@(purchaseHistory.JulyD == 0 ? " text-muted" : "")">@purchaseHistory.July</td>
                                <td class="text-end@(purchaseHistory.AugustD == 0 ? " text-muted" : "")">@purchaseHistory.August</td>
                                <td class="text-end@(purchaseHistory.SeptemberD == 0 ? " text-muted" : "")">@purchaseHistory.September</td>
                                <td class="text-end@(purchaseHistory.OctoberD == 0 ? " text-muted" : "")">@purchaseHistory.October</td>
                                <td class="text-end@(purchaseHistory.NovemberD == 0 ? " text-muted" : "")">@purchaseHistory.November</td>
                                <td class="text-end@(purchaseHistory.DecemberD == 0 ? " text-muted" : "")">@purchaseHistory.December</td>

                                <td class="text-end@(purchaseHistory.AverageD == 0 ? " text-muted" : "")">@purchaseHistory.Average</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

