@model AgentWeeklyVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sales Agent Weekly Activity Report</title>
    <style>
        @@page { size: A4 landscape; margin: 10mm; }
        body { font-family: Calibri, Arial, sans-serif; font-size: 12px; margin: 0; color: #000; }

        .company { text-align: center; font-size: 20px; font-weight: bold; margin: 0; }
        .title   { text-align: center; font-size: 15px; font-weight: bold; margin: 14px 0 18px; }

        .info { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
        .info td { padding: 2px 0; font-size: 13px; }
        .info .lbl { font-weight: bold; width: 110px; }
        .info .gap { width: 40px; }
        .info .lbl2 { font-weight: bold; width: 140px; }

        .summary { border-collapse: collapse; width: 50%; margin-bottom: 18px; }
        .summary td { border: 1px solid #000; padding: 8px 6px; font-size: 13px; }
        .summary .lbl { text-align: right; font-weight: bold; width: 60%; }
        .summary .val { text-align: right; }

        table.report { width: 100%; border-collapse: collapse; }
        table.report th, table.report td { border: 1px solid #000; padding: 2px 3px; vertical-align: middle; }
        table.report th { background: #d9d9d9; text-align: center; font-size: 13px; padding: 5px 3px; }
        table.report thead { display: table-header-group; }   /* repeat header on each page */
        table.report tr { page-break-inside: avoid; }

        .acct { display: flex; justify-content: space-between; gap: 6px; }
        .nowrap { white-space: nowrap; }

        .side-note { display: none; }
        @@media screen {
            .side-note { display: block; position: fixed; top: 6px; right: 10px; font-size: 11px; color: #666; }
            body { margin: 20px; }
        }
        @@media print {
            .side-note { display: none; }
            * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="side-note">This page is for printing only. Press Ctrl+P if the Print dialog did not open automatically.</div>

    <p class="company">3BAS Tiger's Inc.</p>
    <p class="title">SALES AGENT WEEKLY ACTIVITY REPORT</p>

    <table class="info">
        <tr>
            <td class="lbl">NAME :</td>
            <td>@Model.AgentName</td>
            <td class="gap"></td>
            <td class="lbl2">INCLUSIVE DATES :</td>
            <td>@Model.DateFrom.ToString("MMM dd, yyyy") - @Model.DateTo.ToString("MMM dd, yyyy")</td>
        </tr>
    </table>

    <table class="summary">
        <tr>
            <td class="lbl">SALES FOR THE WEEK:</td>
            <td class="val">@Model.SalesForWeek.ToString("C2", new System.Globalization.CultureInfo("en-PH"))</td>
        </tr>
        <tr>
            <td class="lbl">COLLECTION FOR THE WEEK:</td>
            <td class="val">@Model.CollectionForWeek.ToString("C2", new System.Globalization.CultureInfo("en-PH"))</td>
        </tr>
    </table>

    <table class="report">
        <thead>
            <tr>
                <th style="width:6%">Visit Date</th>
                <th style="width:16%">Customer Name</th>
                <th style="width:8%">Contact Person</th>
                <th style="width:6%">Position</th>
                <th style="width:10%">Purpose</th>
                <th style="width:8%">Sales Amount</th>
                <th style="width:8%">Collection</th>
                <th style="width:9%">Action Plan</th>
                <th style="width:9%">Remarks</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
                <tr>
                    <td class="nowrap">@(r.VisitDate?.ToString("MM/dd/yyyy"))</td>
                    <td>@r.CustomerName</td>
                    <td>@r.ContactPerson</td>
                    <td>@r.Position</td>
                    <td>@r.PurposeOfVisit</td>
                    <td><div class="acct"><span>₱</span><span>@((r.SalesAmount ?? 0) != 0 ? (r.SalesAmount ?? 0).ToString("N2") : "")</span></div></td>
                    <td><div class="acct"><span>₱</span><span>@((r.Collection ?? 0) != 0 ? (r.Collection ?? 0).ToString("N2") : "")</span></div></td>
                    <td>@r.ActionPlan</td>
                    <td>@r.Remarks</td>
                </tr>
        }
        </tbody>
    </table>

    <script>
        window.onload = function () { window.print(); };
        window.onafterprint = function () { window.close(); };
    </script>
</body>
</html>