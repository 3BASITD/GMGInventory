@model RolesPagesVM

@{
    var users = (List<string>)ViewData["RoleUsers"]!;
}

<div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Pages Role</h5>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-12">
                    <p class="text-sm">
                        <span class="text-muted">
                            Role Name
                        </span>
                        <b class="d-block form-gayahin">
                            @Model.RoleName
                        </b>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-8">
                    <span class="text-muted">
                        Access
                    </span>
                    <table class="table table-head-fixed table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>
                                    <span data-microtip-title="Can View" data-microtip-position="bottom" role="tooltip">
                                        <span class="fas fa-eye"></span>
                                    </span>
                                </th>
                                <th>
                                    <span data-microtip-title="Can Add" data-microtip-position="bottom" role="tooltip">
                                        <span class="fas fa-plus"></span>
                                    </span>
                                </th>
                                <th>
                                    <span data-microtip-title="Can Edit" data-microtip-position="bottom" role="tooltip">
                                        <span class="fas fa-edit"></span>
                                    </span>
                                </th>
                                <th>
                                    <span data-microtip-title="Can Delete" data-microtip-position="bottom" role="tooltip">
                                        <span class="fas fa-trash-alt"></span>
                                    </span>
                                </th>
                                <th>
                                    <span data-microtip-title="Can Approve / Disapprove" data-microtip-position="bottom" role="tooltip">
                                        <span class="fas fa-thumbs-up"></span>
                                    </span>
                                </th>
                                <th>
                                    <span data-microtip-title="Can Upload&#13; / Download" data-microtip-position="bottom" role="tooltip">
                                        <span class="fas fa-file-download"></span>
                                    </span>
                                </th>
                                <th>
                                    <span data-microtip-title="Can Print" data-microtip-position="bottom" role="tooltip">
                                        <span class="fas fa-print"></span>
                                    </span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var currentGroup = "";
                            }
                            @for (int i = 0; i < Model.Accesses.Count; i++)
                            {
                                if (currentGroup != Model.Accesses[i].PageGroup)
                                {
                                    <tr class="group-header">
                                        <th colspan="8">@Model.Accesses[i].PageGroup</th>
                                    </tr>
                                    currentGroup = Model.Accesses[i].PageGroup;
                                }
                                <tr>
                                    <td>
                                        <span>@Model.Accesses[i].Name</span>
                                    </td>
                                    <td>
                                        @if (Model.Accesses[i].HasView)
                                        {
                                            @if (Model.Accesses[i].CanView)
                                            {
                                                <span class="fas fa-check text-success"></span>
                                            }
                                            else
                                            {
                                                <span class="fas fa-times text-danger"></span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="text-muted">-</i>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.Accesses[i].HasAdd)
                                        {
                                            @if (Model.Accesses[i].CanAdd)
                                            {
                                                <span class="fas fa-check text-success"></span>
                                            }
                                            else
                                            {
                                                <span class="fas fa-times text-danger"></span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="text-muted">-</i>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.Accesses[i].HasEdit)
                                        {
                                            @if (Model.Accesses[i].CanEdit)
                                            {
                                                <span class="fas fa-check text-success"></span>
                                            }
                                            else
                                            {
                                                <span class="fas fa-times text-danger"></span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="text-muted">-</i>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.Accesses[i].HasDelete)
                                        {
                                            @if (Model.Accesses[i].CanDelete)
                                            {
                                                <span class="fas fa-check text-success"></span>
                                            }
                                            else
                                            {
                                                <span class="fas fa-times text-danger"></span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="text-muted">-</i>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.Accesses[i].HasApproveDisapprove)
                                        {
                                            @if (Model.Accesses[i].CanApproveDisapprove)
                                            {
                                                <span class="fas fa-check text-success"></span>
                                            }
                                            else
                                            {
                                                <span class="fas fa-times text-danger"></span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="text-muted">-</i>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.Accesses[i].HasUploadDownload)
                                        {
                                            @if (Model.Accesses[i].CanUploadDownload)
                                            {
                                                <span class="fas fa-check text-success"></span>
                                            }
                                            else
                                            {
                                                <span class="fas fa-times text-danger"></span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="text-muted">-</i>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.Accesses[i].HasPrint)
                                        {
                                            @if (Model.Accesses[i].CanPrint)
                                            {
                                                <span class="fas fa-check text-success"></span>
                                            }
                                            else
                                            {
                                                <span class="fas fa-times text-danger"></span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="text-muted">-</i>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col-4">
                    <span class="text-muted">
                        Users
                    </span>
                    <table class="table table-head-fixed table-striped table-hover">
                        <thead>
                            <tr>
                                <th>
                                    Name
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (users.Count > 0)
                            {
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td>
                                            @user
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="text-center">
                                        <i>No user's using this Role.</i>
                                        <br />
                                        <small><i>Add via users page</i></small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <span class="fas fa-times"></span> Cancel
            </button>
        </div>
    </div>
</div>