@model IEnumerable<AreaViewVM>

@{
    ViewData["Title"] = "Roles";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <button type="button" onclick="Add()" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="fas fa-plus"></span> New Role
                </button>
            }
            else
            {
                <button type="button" class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Add access is required." data-microtip-position="left" role="tooltip">
                    <span class="fas fa-plus"></span> New Role
                </button>
            }
            @* @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right uploadBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <span class="fas fa-upload"></span> Upload
                </button>
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn ml-2">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Upload / Download access is required." data-microtip-position="bottom-left" role="tooltip">
                    <span class="fas fa-upload"></span> Upload
                </button>
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Upload / Download access is required." data-microtip-position="bottom-left" role="tooltip">
                    <span class="fas fa-download"></span> Download
                </button>
            } *@
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-roles">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Is Active</th>
                    <th>User Created</th>
                    <th>Date Created</th>
                    <th>User Modified</th>
                    <th>Date Modified</th>
                    <th></th>
                </tr>
            </thead>

        </table>
    </div>
</div>

<div class="modal fade" id="detailsModal" role="dialog" aria-labelledby="detailsModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
</div>

@if (userAccess.CanAdd || userAccess.CanEdit)
{
    <div class="modal fade" id="saveModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load List on DataTable
        var dataTable = $('.table-roles').on('preXhr.dt', function (e, settings, data) {
            //showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetRolesListJson")",
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "name", name: "Name" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.isActive == true) {
                            return '<span class="fas fa-check text-success"></span>';
                        } else {
                            return '<span class="fas fa-times text-danger"></span>';
                        }
                    }, name: "IsActive"
                },
                { data: "userCreated", name: "UserCreated" },
                { data: "dateCreated", name: "DateCreated" },
                {
                    data: function (data, type, dataToSet) {
                        return data.userModified || "<span class='text-muted'>N/A</span>";
                    }, name: "UserModified"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.dateModified || "<span class='text-muted'>N/A</span>";
                    }, name: "DateModified"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<button class="btn btn-info btn-xs detailsBtn" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></button>';
                        if (data.isActive) {
                            if (user_access.canEdit) {
                                actions += '<button class="btn btn-warning btn-xs editBtn" data-microtip-title="Edit Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-pencil-alt"></span></button>';
                            }
                            if (user_access.canDelete) {
                                actions += '<button class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete / Deactivate Role & Access" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                            }
                        } else {
                            if (user_access.canAdd || user_access.canEdit) {
                                actions += '<button class="btn btn-success btn-xs reactivateBtn" data-microtip-title="Reactivate Role & Access" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-check"></span></button>';
                            }
                        }
                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: [[0, "asc"]]
        });

        // Load functions upon DataTable load
        dataTable.on("draw", function () {
            //hideLoader();

            $(".detailsBtn").click(function (e) {
                var data = dataTable.row($(this).parents('tr')).data();
                $('#detailsModal').load('Access/RoleDetails?RoleId=' + data.id, function () {
                    $(this).modal("show");
                });
            });

            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete / Deactivate Role & Access",
                        text: "Are you sure you want to delete this record? If this is used by any user, this will be deactivated instead.",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var data = dataTable.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("DeleteDeactivateRole")",
                                type: "POST",
                                data: { RoleId: data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        dataTable.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        //toastr.error(data.message, data.status);
                                        ToastrAndConsoleError(data.status, data.message);
                                    }
                                }
                            });
                        }
                    });
                });
            }

            if (user_access.canAdd || user_access.canEdit) {
                $('.reactivateBtn').click(function (e) {
                    swal({
                        title: "Reactivate Role & Access",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var data = dataTable.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("ReactivateRole")",
                                type: "POST",
                                data: { RoleId: data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        dataTable.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else if (data.status == "Error") {
                                        //toastr.error(data.message, data.status);
                                        ToastrAndConsoleError(data.status, data.message);
                                    } else if (data.status == "Warning") {
                                        toastr.warning(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
            }

            if (user_access.canEdit) {
                $(".editBtn").click(function (e) {
                    var data = dataTable.row($(this).parents('tr')).data();
                    $('#saveModal').load('Access/RolesPages?RoleId=' + data.id, function () {
                        $(this).modal("show");
                        setSaveButton();
                    });
                });
            }
        });

        if (user_access.canAdd || user_access.canEdit) {
            function setSaveButton() {
                $(".modal .btn-save").on("click", function () {
                    var form = $("#rolesPagesForm");
                    var url = form.attr('action');
                    var formData = form.serialize().replace(/on/g, "true").replace(/off/g, "false");

                    $.ajax({
                        url: "@Url.Action("SaveRolesPages")",
                        type: "POST",
                        data: formData,
                        success: function (data, status, xhr) {
                            if (data.status == "Success") {
                                $("#saveModal").modal("hide");
                                dataTable.ajax.reload();
                                toastr.success(data.message, data.status);
                            } else {
                                ToastrAndConsoleError(data.status, data.message);
                            }
                        }
                    });
                });
            }
        }

        if (user_access.canAdd) {
            function Add() {
                var $modal = $('#saveModal');
                $modal.load('Access/RolesPages?RoleId=', function () {
                    $modal.modal("show");
                    setSaveButton();
                });
            }
        }
    </script>
}