@model IEnumerable<CustomerPurchaseVM>

@{
    ViewData["Title"] = "Customer Purchase History";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"] (Customer: <strong class="customer-name">All</strong>)</span>
        <div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-history">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ControlNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SellingPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Discount1)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Discount2)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ExtendedPrice)
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-code" class="form-label mb-0">Item Code</label>
                            <select id="filter-item-code" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-name" class="form-label mb-0">Item Name</label>@*
                            <input type="text" id="filter-item-name" class="form-control form-control-sm" readonly="readonly" />*@
                            <select id="filter-item-name" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-category" class="form-label mb-0">Category</label>
                            <select id="filter-category" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-type" class="form-label mb-0">Item Type</label>
                            <select id="filter-item-type" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Invoice Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Invoice Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        var loadfilterloaded = false;
        function LoadFilterSelect2() {
            if (loadfilterloaded) return;
            loadfilterloaded = true;
            // Load Select2 for Customer
            $("#filter-customer").select2({
                tags: true,
                allowClear: true,
                placeholder: 'All',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    if (repo.name) {
                        return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                    }
                    return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                },
                ajax: {
                    url: "@Url.Action("GetOptions", "Customer")",
                    dataType: 'json',
                    type: "POST",
                    delay: 500,
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true
                },
                dropdownParent: $("#filterModal")
            });

            // Load Select2 for Item Code
            $("#filter-item-code").select2({
                tags: true,
                allowClear: true,
                placeholder: {
                    id: "",
                    text: "All"
                },
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    if (repo.name) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                },
                ajax: {
                    url: "@Url.Action("GetOptions", "Item")",
                    dataType: 'json',
                    type: "POST",
                    delay: 500,
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-item-code").on("select2:select", function () {
                if ($(this).select2("data")[0].name) {
                    //$("#filter-item-name").val($(this).select2("data")[0].name);
                    $("#filter-item-name").val(null).trigger("change");
                    $('#select2-filter-item-name-container').find('.select2-selection__placeholder').text($(this).select2("data")[0].name);
                    $('#select2-filter-item-name-container').attr("title", $(this).select2("data")[0].name);
                } else if ($(this).val()) {
                    //$("#filter-item-name").val($("#filter-item").val());
                    $('#select2-filter-item-name-container').find('.select2-selection__placeholder').text("All");
                    $('#select2-filter-item-name-container').attr("title", "All");
                }
            });

            $("#filter-item-code").on("select2:unselecting", function (e) {
                //$("#filter-item-name").val("");
                $('#select2-filter-item-name-container').find('.select2-selection__placeholder').text("All");
                $('#select2-filter-item-name-container').attr("title", "All");
            });

            // Load Select2 for Item Name
            $("#filter-item-name").select2({
                tags: true,
                allowClear: true,
                placeholder: {
                    id: "",
                    text: "All"
                },
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    if (repo.name) {
                        return repo.name;
                    }
                    return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                },
                ajax: {
                    url: "@Url.Action("GetOptions", "Item")",
                    dataType: 'json',
                    type: "POST",
                    delay: 500,
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-item-name").on("select2:select", function () {
                if ($(this).select2("data")[0].name) {
                    $("#filter-item-code").val(null).trigger("change");
                    $('#select2-filter-item-code-container').find('.select2-selection__placeholder').text($(this).select2("data")[0].text);
                    $('#select2-filter-item-code-container').attr("title", $(this).select2("data")[0].text);

                    var selected_name = $(this).select2("data")[0].name;
                    setTimeout(function () {
                        $("#select2-filter-item-name-container").text(selected_name);
                        $("#select2-filter-item-name-container").attr("title", selected_name);
                    }, 100);
                } else if ($(this).val()) {
                    $('#select2-filter-item-code-container').find('.select2-selection__placeholder').text("All");
                    $('#select2-filter-item-code-container').attr("title", "All");
                }
            });

            $("#filter-item-name").on("select2:unselecting", function (e) {
                $('#select2-filter-item-code-container').find('.select2-selection__placeholder').text("All");
                $('#select2-filter-item-code-container').attr("title", "All");
            });

            // Load Select2 for Category
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Category")",
                success: function (data, status, xhr) {
                    $("#filter-category").select2({
                        tags: true,
                        data: data,
                        allowClear: true,
                        placeholder: 'All',
                        templateResult: function (repo) {
                            if (repo.element) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                        },
                        dropdownParent: $("#filterModal")
                    });
                }
            });

            // Load Select2 for Item Type
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "ItemType")",
                success: function (data, status, xhr) {
                    $("#filter-item-type").select2({
                        tags: true,
                        data: data,
                        allowClear: true,
                        placeholder: 'All',
                templateResult: function (repo) {
                            if (repo.element) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                },
                        dropdownParent: $("#filterModal")
                    });
                }
            });

            // Load Select2 for Brand
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Brand")",
                success: function (data, status, xhr) {
                    $("#filter-brand").select2({
                        tags: true,
                        data: data,
                        allowClear: true,
                        placeholder: 'All',
                        templateResult: function (repo) {
                            if (repo.element) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                        },
                        dropdownParent: $("#filterModal")
                    });
                }
            });
        }

        $(".btnFilter").on("click", function () {
            historyDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        // Load List on DataTable
        var historyDT = $('.table-history').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                data: function (data) {
                    var categoryId = $("#filter-category").val();
                    if (categoryId) {
                        if ($("#filter-category").select2("data")[0].name) {
                            data.CategoryId = categoryId;
                        } else {
                            data.CategoryId = 0;
                            data.CategoryKeyword = categoryId;
                        }
                    }

                    var brandId = $("#filter-brand").val();
                    if (brandId) {
                        if ($("#filter-brand").select2("data")[0].text != $("#filter-brand").val()) {
                            data.BrandId = brandId;
                        } else {
                            data.BrandId = 0;
                            data.BrandKeyword = brandId;
                        }
                    }

                    var itemTypeId = $("#filter-item-type").val();
                    if (itemTypeId) {
                        if ($("#filter-item-type").select2("data")[0].name) {
                            data.ItemTypeId = itemTypeId;
                        } else {
                            data.ItemTypeId = 0;
                            data.ItemTypeKeyword = itemTypeId;
                        }
                    }

                    var itemId = $("#filter-item-code").val();
                    if (itemId) {
                        if ($("#filter-item-code").select2("data")[0].name) {
                            data.ItemId = itemId;
                        } else {
                            data.ItemId = 0;
                            data.ItemKeyword = itemId;
                        }
                    }

                    var itemNameId = $("#filter-item-name").val();
                    if (itemNameId) {
                        if ($("#filter-item-name").select2("data")[0].name) {
                            data.ItemId = itemNameId;
                        } else {
                            data.ItemNameKeyword = itemNameId;
                        }
                    }

                    var customerId = $("#filter-customer").val();
                    if (customerId) {
                        if ($("#filter-customer").select2("data")[0].name) {
                            data.CustomerId = customerId;
                        } else {
                            data.CustomerId = 0;
                            data.CustomerKeyword = customerId;
                        }
                    }
                    //var customerId = $("#filter-customer").val();
                    //var itemId = $("#filter-item").val();
                    //var categoryId = $("#filter-category").val();
                    //var itemTypeId = $("#filter-item-type").val();
                    //var brandId = $("#filter-brand").val();

                    //if (customerId) data.CustomerId = customerId;
                    //if (itemId) data.ItemId = itemId;
                    //if (categoryId) data.CategoryId = categoryId;
                    //if (itemTypeId) data.ItemTypeId = itemTypeId;
                    //if (brandId) data.BrandId = brandId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "soNumber", name: "SONumber" },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "controlNumber", name: "ControlNumber" },
                { data: "brand", name: "Brand" },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                { data: "partNumber", name: "PartNumber" },
                { data: "unit", name: "Unit" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "sellingPrice", name: "SellingPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "extendedPrice", name: "ExtendedPrice", className: "text-end" }
            ],
            order: [[0, "desc"]]
        });

        // Load functions upon DataTable load
        historyDT.on("draw", function () {
            hideLoader();

            LoadFilterSelect2();
            $(".customer-name").text($("#filter-customer").select2("data")[0].name ?? "All");
        });
    </script>
    }