@model IEnumerable<ItemPriceVM>

@{
    ViewData["Title"] = "Price List";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @await Html.PartialAsync("ItemFilter", ViewData["ItemFilter"])
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ModelNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Size)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var dataTable = $('.table').on('preXhr.dt', function(e, settings, data) {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fa fa-cog fa-spin"
            });
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function(data) {
                    var categoryId = $("#CategoryId").val();
                    var itemTypeId = $("#ItemTypeId").val();
                    var brandId = $("#BrandId").val();

                    if (categoryId) data.CategoryId = categoryId;
                    if (itemTypeId) data.ItemTypeId = itemTypeId;
                    if (brandId) data.BrandId = brandId;
                },
            },
            //processing: true,
            serverSide: true,
            filter: true,
            columns: [
                { data: "brand", name: "Brand" },
                { data: "modelNumber", name: "ModelNumber" },
                { data: "size", name: "Size" },
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "partNumber", name: "PartNumber" },
                { data: "unit", name: "Unit" },
                {
                    data: function(data, type, dataToSet) { return data.retailPrice.toFixed(2); },
                    name: "RetailPrice",
                    className: "text-end"
                },
                {
                    data: function(data, type, dataToSet) { return data.netPrice.toFixed(2); },
                    name: "NetPrice",
                    className: "text-end"
                },
                { data: "quantity", name: "Quantity", className: "text-end" },
            ]
        });

        dataTable.on("draw", function() {
            $.LoadingOverlay("hide");
        });

        function ApplyFilter() {
            $(".table").DataTable().ajax.reload();
            $("#filterModal").modal("hide");
        }
    </script>
}