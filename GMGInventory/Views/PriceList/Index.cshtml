@model IEnumerable<ItemPriceVM>

@{
    ViewData["Title"] = "Price List";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterPriceModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-price">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ModelNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Size)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="filterPriceModal" role="dialog" aria-labelledby="filterPriceModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-type" class="form-label mb-0">Item Type</label>
                            <select id="filter-type" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-code" class="form-label mb-0">Item Code</label>
                            <select id="filter-item-code" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-name" class="form-label mb-0">Item Name</label>
                            <input type="text" id="filter-item-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-model" class="form-label mb-0">Model Number</label>
                            <select id="filter-model" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-size" class="form-label mb-0">Size</label>
                            <select id="filter-size" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var priceDT = $('.table-price').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function (data) {
                    var brandId = $("#filter-brand").val();
                    if (brandId) {
                        if (isNaN(brandId)) {
                            data.BrandId = 0;
                            data.BrandKeyword = brandId;
                        } else {
                            data.BrandId = brandId;
                        }
                    }

                    var itemTypeId = $("#filter-type").val();
                    if (itemTypeId) {
                        if (isNaN(itemTypeId)) {
                            data.ItemTypeId = 0;
                            data.ItemTypeKeyword = itemTypeId;
                        } else {
                            data.ItemTypeId = itemTypeId;
                        }
                    }

                    var itemId = $("#filter-item-code").val();
                    if (itemId) {
                        if (isNaN(itemId)) {
                            data.ItemId = 0;
                            data.ItemKeyword = itemId;
                        } else {
                            data.ItemId = itemId;
                        }
                    }

                    if ($("#filter-model").hasClass("select2-hidden-accessible")) {
                        var model = $("#filter-model").select2("data")[0].text;
                        if (model) {
                            data.ModelNumber = model;
                        }
                    }

                    if ($("#filter-size").hasClass("select2-hidden-accessible")) {
                        var size = $("#filter-size").select2("data")[0].text;
                        if (size) {
                            data.Size = size;
                        }
                    }
                },
            },
            processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "brand", name: "Brand" },
                { data: "modelNumber", name: "ModelNumber" },
                { data: "size", name: "Size" },
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "partNumber", name: "PartNumber" },
                { data: "unit", name: "Unit" },
                {
                    data: function (data, type, dataToSet) { return data.retailPrice.toFixed(2); },
                    name: "RetailPrice",
                    className: "text-end"
                },
                {
                    data: function (data, type, dataToSet) { return data.netPrice.toFixed(2); },
                    name: "NetPrice",
                    className: "text-end"
                },
                { data: "quantity", name: "Quantity", className: "text-end" },
            ],
            order: [[3, "asc"]]
        });

        priceDT.on("draw", function () {
            hideLoader();
        });

        function ApplyFilter() {
            priceDT.ajax.reload();
            $("#filterPriceModal").modal("hide");
        }

        // Load Select2 for Brand
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Brand")",
            success: function (data, status, xhr) {
                $("#filter-brand").select2({
                    tags: true,
                    data: data,
                    allowClear: true,
                    templateResult: function (repo) {
                        if (repo.element) {
                            return repo.text;
                        }
                        return $("<span>" + repo.text + "</span> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                    },
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterPriceModal')
                });
            }
        });

        // Load Select2 for Item Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "ItemType")",
            success: function (data, status, xhr) {
                $("#filter-type").select2({
                    tags: true,
                    data: data,
                    allowClear: true,
                    templateResult: function (repo) {
                        if (repo.element) {
                            return repo.text;
                        }
                        return $("<span>" + repo.text + "</span> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
                    },
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterPriceModal')
                });
            }
        });

        // Load Select2 for Item
        $("#filter-item-code").select2({
            tags: true,
            minimumInputLength: 1,
            allowClear: true,
            placeholder: {
                id: "",
                text: "All"
            },
            templateResult: function (repo) {
                if (repo.element) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - " + repo.name + "</em>");
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light text-secondary'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#filterPriceModal")
        });

        $("#filter-item-code").on("select2:select", function () {
            if ($(this).select2("data")[0].name) {
                $("#filter-item-name").val($(this).select2("data")[0].name);
            } else if ($(this).val()) {
                $("#filter-item-name").val($("#filter-item").val());
            }
        });

        $("#filter-item-code").on("select2:unselecting", function (e) {
            $("#filter-item-name").val("");
        });

        // Load Select2 for Model Number
        $("#filter-model").select2({
            tags: true,
            minimumInputLength: 1,
            allowClear: true,
            placeholder: {
                id: "",
                text: "All"
            },
            ajax: {
                url: "@Url.Action("GetModelNumberOptions", "Item")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#filterPriceModal")
        });

        // Load Select2 for Size
        $("#filter-size").select2({
            tags: true,
            minimumInputLength: 1,
            allowClear: true,
            placeholder: {
                id: "",
                text: "All"
            },
            ajax: {
                url: "@Url.Action("GetSizeOptions", "Item")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#filterPriceModal")
        });

        $(".printBtn").on("click", function () {
            if (priceDT.page.info().recordsTotal > 1000) {
                swal({
                    title: "A lot of records to print",
                    text: "You are trying to print " + priceDT.page.info().recordsTotal + " record(s). Genererating a page to print for this much will take a while. Would you like to continue?",
                    icon: "info",
                    buttons: {
                        cancel: "No",
                        filter: "Do Filter",
                        continue: "Yes"
                    },
                    infoMode: true
                }).then((value) => {
                    if (value == "filter") {
                        $("#filterPriceModal").modal("show");
                    } else if (value == "continue") {
                        DoPrint();
                    }
                });
            } else {
                DoPrint();
            }
        });

        function DoPrint() {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];

            var brandId = $("#filter-brand").val();
            if (brandId) {
                if (isNaN(brandId)) {
                    urlQuery.push("BrandId=0");
                    urlQuery.push("BrandKeyword=" + brandId);
                } else {
                    urlQuery.push("BrandId=" + brandId);
                }
            }

            var itemTypeId = $("#filter-type").val();
            if (itemTypeId) {
                if (isNaN(itemTypeId)) {
                    urlQuery.push("ItemTypeId=0");
                    urlQuery.push("ItemTypeKeyword=" + itemTypeId);
                } else {
                    urlQuery.push("ItemTypeId=" + itemTypeId);
                }
            }

            var itemId = $("#filter-item-code").val();
            if (itemId) {
                if (isNaN(itemId)) {
                    urlQuery.push("ItemId=0");
                    urlQuery.push("ItemCategory=" + itemId);
                } else {
                    urlQuery.push("ItemId=" + itemId);
                }
            }

            var model = $("#filter-model").select2("data")[0].text;
            if (model) {
                urlQuery.push("ModelNumber=" + model);
            }

            var size = $("#filter-size").select2("data")[0].text;
            if (size) {
                urlQuery.push("Size=" + size);
            }

            setTimeout(function () {
                let win = window.open('@Url.Action("Print")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        }
    </script>
}