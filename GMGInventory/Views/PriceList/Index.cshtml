@model IEnumerable<ItemPriceVM>

@{
    ViewData["Title"] = "Price List";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                    <span class="fas fa-print"></span> Print
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right btn-filter ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-price">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ModelNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Size)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-category" class="form-label mb-0">Category</label>
                            <select id="filter-category" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-type" class="form-label mb-0">Item Type</label>
                            <select id="filter-type" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-code" class="form-label mb-0">Item Code</label>
                            <select id="filter-item-code" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-name" class="form-label mb-0">Item Description</label>
                            <select id="filter-item-name" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-model" class="form-label mb-0">Model Number</label>
                            <select id="filter-model" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-size" class="form-label mb-0">Size</label>
                            <select id="filter-size" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Brand
        $("#filter-brand").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Brand")"
            },
            dropdownParent: $('#filterModal')
        });

        // Load Select2 for Category
        $("#filter-category").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Category")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-category").on("select2:select", function () {
            $("#filter-type").val(null).trigger("change");
        });

        $("#filter-category").on("select2:unselecting", function (e) {
            $("#filter-type").val(null).trigger("change");
        });

        // Load Select2 for Item Type
        $("#filter-type").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "ItemType")",
                data: {
                    CategoryId: function() {
                        return $("#filter-category").val()
                    }
                }
            },
            dropdownParent: $('#filterModal')
        });

        // Load Select2 for Item Code
        $("#filter-item-code").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $(
                        "<strong>" + repo.text + "</strong> " +
                        (repo.text != repo.name
                            ? "<em class='fw-light'> - " + repo.name + "</em>"
                            : "") +
                        "<br />" +
                        "<small class='text-muted'>" +
                        (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                        (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                        "</small>");
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-item-code").on("select2:select", function () {
            var name = $(this).select2("data")[0].name;
            if(name) {
                var itemNameOption = new Option(name, $(this).val(), true, true);
                $("#filter-item-name").append(itemNameOption).trigger('change');
            } else {
                $("#filter-item-name").val(null).trigger('change');
            }
        });

        $("#filter-item-code").on("select2:unselecting", function (e) {
            $("#filter-item-name").val(null).trigger('change');
        });

        // Load Select2 for Item Name
        $("#filter-item-name").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $(
                        "<strong>" + repo.text + "</strong> " +
                        (repo.text != repo.name
                            ? "<em class='fw-light'> - " + repo.name + "</em>"
                            : "") +
                        "<br />" +
                        "<small class='text-muted'>" +
                        (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                        (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                        "</small>");
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-item-name").on("select2:select", function () {
            var name = $(this).select2("data")[0].name;
            if(name) {
                var itemCodeOption = new Option(name, $(this).val(), true, true);
                $("#filter-item-code").append(itemCodeOption).trigger('change');
            } else {
                $("#filter-item-code").val(null).trigger('change');
            }
        });

        $("#filter-item-name").on("select2:unselecting", function (e) {
            $("#filter-item-code").val(null).trigger('change');
        });

        // Load Select2 for Model Number
        $("#filter-model").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.element) {
                    return repo.text;
                }
                return $("<span>" + repo.text + "</span> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetModelNumberOptions", "Item")"
            },
            dropdownParent: $("#filterModal")
        });

        // Load Select2 for Size
        $("#filter-size").select2({
            tags: true,
            allowClear: true,
            templateResult: function (repo) {
                if (repo.element) {
                    return repo.text;
                }
                return $("<span>" + repo.text + "</span> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            placeholder: {
                id: "",
                text: "ALL"
            },
            ajax: {
                url: "@Url.Action("GetSizeOptions", "Item")"
            },
            dropdownParent: $("#filterModal")
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            priceDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            priceDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            Brand: "",
            BrandId: "",
            Category: "",
            CategoryId: "",
            ItemType: "",
            ItemTypeId: "",
            ItemCodeId: "",
            ItemCode: "",
            ItemNameId: "",
            ItemName: "",
            ModelNumber: "",
            ModelNumberId: "",
            Size: "",
            SizeId: ""
        };

        function checkDTChanged() {
            if(!priceDT) return false;
            
            return JSON.stringify(priceDT.order()) != JSON.stringify(defaultDTState.order) ||
                   priceDT.page.info().start != defaultDTState.page ||
                   priceDT.page.len() != defaultDTState.length ||
                   (priceDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-brand").val() != defaultDTState.BrandId ||
                   $("#filter-category").val() != defaultDTState.CategoryId ||
                   $("#filter-type").val() != defaultDTState.ItemTypeId ||
                   $("#filter-item-code").val() != defaultDTState.ItemCodeId ||
                   $("#filter-item-name").val() != defaultDTState.ItemNameId ||
                   $("#filter-model").val() != defaultDTState.ModelNumberId ||
                   $("#filter-size").val() != defaultDTState.SizeId;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);

            $('#filter-brand').val(defaultDTState.BrandId).trigger('change');
            $('#filter-category').val(defaultDTState.CategoryId).trigger('change');
            $('#filter-type').val(defaultDTState.ItemTypeId).trigger('change');
            $('#filter-item-code').val(defaultDTState.ItemCodeId).trigger('change');
            $('#filter-item-name').val(defaultDTState.ItemNameId).trigger('change');
            $('#filter-model').val(defaultDTState.ModelId).trigger('change');
            $('#filter-size').val(defaultDTState.SizeId).trigger('change');
            
            if (priceDT) {
                priceDT.state.clear();
                priceDT.order(defaultDTState.order);
                priceDT.page(defaultDTState.page);
                priceDT.search(defaultDTState.search.search);
            }
        }

        var priceDT = $('.table-price').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.Brand = $('#filter-brand option:selected').text();
                data.BrandId = $('#filter-brand').val();
                data.Category = $('#filter-category option:selected').text();
                data.CategoryId = $('#filter-category').val();
                data.ItemType = $('#filter-type option:selected').text();
                data.ItemTypeId = $('#filter-type').val();
                data.ItemCode = $('#filter-item-code option:selected').text();
                data.ItemCodeId = $('#filter-item-code').val();
                data.ItemName = $('#filter-item-name option:selected').text();
                data.ItemNameId = $('#filter-item-name').val();
                data.Model = $('#filter-model option:selected').text();
                data.ModelId = $('#filter-model').val();
                data.Size = $('#filter-size option:selected').text();
                data.SizeId = $('#filter-size').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.BrandId) {
                    var brandOption = new Option(data.Brand, data.BrandId, true, true);
                    $("#filter-brand").append(brandOption).trigger('change');
                }
                if(data.CategoryId) {
                    var categoryOption = new Option(data.Category, data.CategoryId, true, true);
                    $("#filter-category").append(categoryOption).trigger('change');
                }
                if(data.ItemTypeId) {
                    var itemTypeOption = new Option(data.ItemType, data.ItemTypeId, true, true);
                    $("#filter-type").append(itemTypeOption).trigger('change');
                }
                if(data.ItemCodeId) {
                    var itemCodeOption = new Option(data.ItemCode, data.ItemCodeId, true, true);
                    $("#filter-item-code").append(itemCodeOption).trigger('change');
                }
                if(data.ItemNameId) {
                    var itemNameOption = new Option(data.ItemName, data.ItemNameId, true, true);
                    $("#filter-item-name").append(itemNameOption).trigger('change');
                }
                if(data.ModelId) {
                    var modelOption = new Option(data.Model, data.ModelId, true, true);
                    $("#filter-model").append(modelOption).trigger('change');
                }
                if(data.SizeId) {
                    var sizeOption = new Option(data.Size, data.SizeId, true, true);
                    $("#filter-size").append(sizeOption).trigger('change');
                }
            },
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function (data) {
                    var brandId = $("#filter-brand").val();
                    if (brandId) {
                        if ($("#filter-brand").select2("data")[0].name) {
                            data.BrandId = brandId;
                        } else {
                            data.BrandId = 0;
                            data.BrandKeyword = brandId;
                        }
                    }
                    
                    var categoryId = $("#filter-category").val();
                    if (categoryId) {
                        if ($("#filter-category").select2("data")[0].name) {
                            data.CategoryId = categoryId;
                        } else {
                            data.CategoryId = 0;
                            data.CategoryKeyword = categoryId;
                        }
                    }

                    var itemTypeId = $("#filter-type").val();
                    if (itemTypeId) {
                        if ($("#filter-type").select2("data")[0].name) {
                            data.ItemTypeId = itemTypeId;
                        } else {
                            data.ItemTypeId = 0;
                            data.ItemTypeKeyword = itemTypeId;
                        }
                    }

                    var itemId = $("#filter-item-code").val();
                    if (itemId) {
                        if ($("#filter-item-code").select2("data")[0].name) {
                            data.ItemId = itemId;
                        } else {
                            data.ItemId = 0;
                            data.ItemKeyword = itemId;
                        }
                    }

                    var itemNameId = $("#filter-item-name").val();
                    if (itemNameId) {
                        if ($("#filter-item-name").select2("data")[0].name) {
                            data.ItemId = itemNameId;
                        } else {
                            data.ItemNameKeyword = itemNameId;
                        }
                    }

                    if ($("#filter-model").hasClass("select2-hidden-accessible")) {
                        var model = $("#filter-model").select2("data")[0].text;
                        if (model) {
                            data.ModelNumber = model;
                        }
                    }

                    if ($("#filter-size").hasClass("select2-hidden-accessible")) {
                        var size = $("#filter-size").select2("data")[0].text;
                        if (size) {
                            data.Size = size;
                        }
                    }
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Item/Details/" + data.id + "' class='link-info' target='_blank'>" + data.code + "</a>";
                    },
                    name: "Code"
                },
                { data: "name", name: "Name" },
                { data: "partNumber", name: "PartNumber" },
                { data: "modelNumber", name: "ModelNumber" },
                { data: "brand", name: "Brand" },
                { data: "size", name: "Size" },
                { data: "unit", name: "Unit" },
                {
                    data: function (data, type, dataToSet) { return data.retailPrice.toFixed(2); },
                    name: "RetailPrice",
                    className: "text-end"
                },
                {
                    data: function (data, type, dataToSet) { return data.netPrice.toFixed(2); },
                    name: "NetPrice",
                    className: "text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<span data-microtip-title="[Inventory:' + FormatStringInteger(data.quantityInventoryD) + ']+[Served:' + FormatStringInteger(data.quantityServedD == null ? 0 : data.quantityServedD) + ']-[Invoiced:' + FormatStringInteger(data.quantityInvoiceD == null ? 0 : data.quantityInvoiceD) + ']" data-microtip-position="bottom-left" role="tooltip">' + data.quantity + '</span>';
                    },
                    name: "Quantity",
                    className: "text-end"
                },
            ],
            order: defaultDTState.order
        }).on("draw", function () {
            checkDefaultFilter();
        });

        if (user_access.canPrint) {
            $(".printBtn").on("click", function () {
                if (priceDT.page.info().recordsTotal > 1000) {
                    swal({
                        title: "A lot of records to print",
                        text: "You are trying to print " + priceDT.page.info().recordsTotal + " record(s). Genererating a page to print for this much will take a while. Would you like to continue?",
                        icon: "info",
                        buttons: {
                            cancel: "No",
                            filter: "Do Filter",
                            continue: "Yes"
                        },
                        infoMode: true
                    }).then((value) => {
                        if (value == "filter") {
                            $("#filterModal").modal("show");
                        } else if (value == "continue") {
                            DoPrint();
                        }
                    });
                } else {
                    DoPrint();
                }
            });

            function DoPrint() {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                var urlQuery = [];

                var brandId = $("#filter-brand").val();
                if (brandId) {
                    if (isNaN(brandId)) {
                        urlQuery.push("BrandId=0");
                        urlQuery.push("BrandKeyword=" + brandId);
                    } else {
                        urlQuery.push("BrandId=" + brandId);
                    }
                }

                var itemTypeId = $("#filter-type").val();
                if (itemTypeId) {
                    if (isNaN(itemTypeId)) {
                        urlQuery.push("ItemTypeId=0");
                        urlQuery.push("ItemTypeKeyword=" + itemTypeId);
                    } else {
                        urlQuery.push("ItemTypeId=" + itemTypeId);
                    }
                }

                var itemId = $("#filter-item-code").val();
                if (itemId) {
                    if (isNaN(itemId)) {
                        urlQuery.push("ItemId=0");
                        urlQuery.push("ItemCategory=" + itemId);
                    } else {
                        urlQuery.push("ItemId=" + itemId);
                    }
                }

                var model = $("#filter-model").select2("data")[0].text;
                if (model) {
                    urlQuery.push("ModelNumber=" + model);
                }

                var size = $("#filter-size").select2("data")[0].text;
                if (size) {
                    urlQuery.push("Size=" + size);
                }

                setTimeout(function () {
                    let win = window.open('@Url.Action("Print")?' + urlQuery.join("&"), '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            }
        }

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];

                var brandId = $("#filter-brand").val();
                if (brandId) {
                    if (isNaN(brandId)) {
                        urlQuery.push("BrandId=0");
                        urlQuery.push("BrandKeyword=" + brandId);
                    } else {
                        urlQuery.push("BrandId=" + brandId);
                    }
                }

                var itemCategoryId = $("#filter-category").val();
                if (itemCategoryId) {
                    if (isNaN(itemCategoryId)) {
                        urlQuery.push("CategoryId=0");
                        urlQuery.push("CategoryKeyword=" + itemCategoryId);
                    } else {
                        urlQuery.push("CategoryId=" + itemCategoryId);
                    }
                }

                var itemTypeId = $("#filter-type").val();
                if (itemTypeId) {
                    if (isNaN(itemTypeId)) {
                        urlQuery.push("ItemTypeId=0");
                        urlQuery.push("ItemTypeKeyword=" + itemTypeId);
                    } else {
                        urlQuery.push("ItemTypeId=" + itemTypeId);
                    }
                }

                var itemId = $("#filter-item-code").val();
                if (itemId) {
                    if (isNaN(itemId)) {
                        urlQuery.push("ItemId=0");
                        urlQuery.push("ItemKeyword=" + itemId);
                    } else {
                        urlQuery.push("ItemId=" + itemId);
                    }
                }

                var itemNameId = $("#filter-item-name").val();
                if (itemNameId) {
                    if (isNaN(itemNameId)) {
                        urlQuery.push("ItemId=0");
                        urlQuery.push("ItemNameKeyword=" + itemNameId);
                    } else {
                        urlQuery.push("ItemId=" + itemNameId);
                    }
                }

                var model = $("#filter-model").select2("data")[0].text;
                if (model) {
                    urlQuery.push("ModelNumber=" + model);
                }

                var size = $("#filter-size").select2("data")[0].text;
                if (size) {
                    urlQuery.push("Size=" + size);
                }

                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });

        }
    </script>
}