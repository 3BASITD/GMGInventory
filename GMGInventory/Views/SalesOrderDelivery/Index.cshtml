@model IEnumerable<SalesOrderDeliveryVM>

@{
    ViewData["Title"] = "Sales Order Delivery Monitoring";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-delivery">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SalesOrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DatePickup)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateDeliver)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Forwarder)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.WaybillNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Remarks)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PONumber)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent Code</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date Delivered From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date Delivered To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>
@if (userAccess.CanEdit)
{
    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Sales Order Delivery</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="editForm">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="delivery-pickup-date" class="form-label mb-0">Pick-up Date</label>
                            <input type="date" id="delivery-pickup-date" name="PickupDate" class="form-control form-control-sm" />
                            <span data-valmsg-for="delivery-pickup-date" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="delivery-date" class="form-label mb-0">Delivery Date</label>
                            <input type="date" id="delivery-date" name="DeliveryDate" class="form-control form-control-sm" />
                            <span data-valmsg-for="delivery-date" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="delivery-forwarder" class="form-label mb-0">Forwarder</label>
                            <div>
                                <select id="delivery-forwarder" name="Forwarder" style="width:100%">
                                    <option></option>
                                </select>
                            </div>
                            <span data-valmsg-for="delivery-forwarder" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="delivery-waybill" class="form-label mb-0">Waybill Number</label>
                            <input type="text" id="delivery-waybill" name="Waybill" class="form-control form-control-sm" />
                            <span data-valmsg-for="delivery-waybill" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="delivery-remarks" class="form-label mb-0">Remarks</label>
                            <input type="text" id="delivery-remarks" class="form-control form-control-sm" />
                        </div>
                        <input type="hidden" id="delivery-sales-order-id" />
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-save">
                            <span class="fas fa-save"></span> Save
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<!-- View Modal -->
<div class="modal fade" id="viewModal" role="dialog" aria-labelledby="viewModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sales Order Item(s)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table class="table table-head-fixed table-striped table-hover table-item">
                    <thead>
                        <tr>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Quantity</th>
                            <th>Packed Quantity</th>
                            <th>Invoiced Quantity</th>
                            <th>Unit</th>
                            <th>Selling Price</th>
                            <th>Discount 1</th>
                            <th>Discount 2</th>
                            <th>Gross Price</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th colspan="2" class="text-end">Total</th>
                            <th class="total-quantity">0</th>
                            <th class="total-quantity">0</th>
                            <th class="total-quantity">0</th>
                            <th colspan="4"></th>
                            <th class="total-net-price">0.00</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Action Modal -->
<div class="modal fade" id="actionModal" role="dialog" aria-labelledby="actionModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">History</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-4">@Html.DisplayNameFor(model => model.CreatedBy)</div>
                    <div class="col-8"><strong class="action-created-by"></strong></div>
                </div>
                <div class="row">
                    <div class="col-4">@Html.DisplayNameFor(model => model.CreatedDate)</div>
                    <div class="col-8"><strong class="action-created-date"></strong></div>
                </div>
                <div class="row">
                    <div class="col-4">@Html.DisplayNameFor(model => model.ModifiedBy)</div>
                    <div class="col-8"><strong class="action-modified-by"></strong></div>
                </div>
                <div class="row">
                    <div class="col-4">@Html.DisplayNameFor(model => model.ModifiedDate)</div>
                    <div class="col-8"><strong class="action-modified-date"></strong></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setFullYear(dt_from.getFullYear() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setFullYear(dt_to.getFullYear() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        var loadfilterloaded = false;
        function LoadFilterSelect2() {
            if (loadfilterloaded) return;
            loadfilterloaded = true;

            // Load Select2 for Agent
            $("#filter-agent").select2({
                minimumInputLength: 1,
                allowClear: true,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetOptions2", "Agent")",
                    dataType: 'json',
                    type: "POST",
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-agent").on("select2:select", function () {
                $("#filter-agent-name").val($(this).select2("data")[0].name);
            });

            $("#filter-agent").on("select2:unselecting", function (e) {
                $("#filter-agent-name").val("");
            });

            // Load Select2 for Customer
            $("#filter-customer").select2({
                minimumInputLength: 1,
                allowClear: true,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetOptions", "Customer")",
                    dataType: 'json',
                    type: "POST",
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-customer").on("select2:select", function () {
                $("#filter-customer-name").val($(this).select2("data")[0].name);
            });

            $("#filter-customer").on("select2:unselecting", function (e) {
                $("#filter-customer-name").val("");
            });

            // Load region data for select2
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Region")",
                success: function (data, status, xhr) {
                    $("#filter-region").select2({
                        allowClear: true,
                        placeholder: '<empty>',
                        data: data,
                        minimumResultsForSearch: Infinity
                    });
                }
            });

            // Load forwarder data for select2 on edit
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Forwarder")",
                success: function (data, status, xhr) {
                    $("#delivery-forwarder").select2({
                        data: data,
                        allowClear: true,
                        placeholder: {
                            id: "",
                            text: "<empty>"
                        },
                        dropdownParent: $("#editModal")
                    });
                }
            });
        }

        $(".btnFilter").on("click", function () {
            deliveryDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        // Load List on DataTable
        var deliveryDT = $('.table-delivery').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    var customerId = $("#filter-customer").val();
                    var regionId = $("#filter-region").val();

                    if (agentId) data.AgentId = agentId;
                    if (customerId) data.CustomerId = customerId;
                    if (regionId) data.RegionId = regionId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "salesOrderDate", name: "SalesOrderDate" },
                { data: "soNumber", name: "SONumber" },
                { data: "customerCode", name: "CustomerCode" },
                { data: "customerName", name: "CustomerName" },
                { data: "datePickup", name: "DatePickup" },
                { data: "dateDeliver", name: "DateDeliver" },
                { data: "forwarder", name: "Forwarder" },
                { data: "waybillNumber", name: "WaybillNumber" },
                { data: "remarks", name: "Remarks" },
                { data: "poNumber", name: "PONumber" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<button class="btn btn-primary btn-xs viewBtn" onclick="ShowItemList(' + data.id + ')" data-microtip-title="View Item(s)" data-microtip-position="top-left" role="tooltip"><i class="fas fa-info-circle"></i></button>';
                        if (user_access.canEdit) {
                            actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                        }
                        actions += '<button class="btn btn-info btn-xs actionBtn" onclick="ShowAction(\'' + data.createdBy + '\', \'' + data.createdDate + '\', \'' + data.modifiedBy + '\', \'' + data.modifiedDate + '\')" data-microtip-title="History" data-microtip-position="top-left" role="tooltip"><i class="fas fa-history"></i></button>';
                        return actions + "</div>";
                    }
                }
            ],
            order: [[0, "desc"]]
        });

        // Load functions upon DataTable load
        deliveryDT.on("draw", function () {
            hideLoader();

            LoadFilterSelect2();

            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = deliveryDT.row($(this).parents('tr')).data();

                    $("#delivery-sales-order-id").val(data.id);
                    $("#delivery-date").val(DateForInput(data.dateDeliverD));
                    $("#delivery-pickup-date").val(DateForInput(data.datePickupD));
                    $("#delivery-waybill").val(data.waybillNumber == "-" ? "" : data.waybillNumber);
                    $("#delivery-remarks").val(data.remarks == "-" ? "" : data.remarks);

                    // Load forwarder data for select2 on edit
                    //if ($("#delivery-forwarder").attr("data-select2-id")) {
                    //    $("#delivery-forwarder").select2("destroy");
                    //    $("#delivery-forwarder").empty();
                    //}
                    //$.ajax({
                    //    type: "POST",
                    //    url: "@Url.Action("GetOptions", "Forwarder")",
                    //    data: { includeId: data.forwarderId },
                    //    success: function (data, status, xhr) {
                    //        $("#delivery-forwarder").select2({
                    //            data: data,
                    //            allowClear: true,
                    //            placeholder: {
                    //                id: "",
                    //                text: "<empty>"
                    //            },
                    //            dropdownParent: $("#editModal")
                    //        });
                    //    }
                    //});
                    $("#delivery-forwarder").val(data.forwarderId);
                    $("#delivery-forwarder").trigger("change");
                });

                // Validation for Edit Modal
                var validateEdit = $("#editForm").validate({
                    errorClass: 'text-danger text-xs',
                    rules: {
                        Forwarder: { required: true },
                        Waybill: { required: true, maxlength: 150 },
                        Remarks: { maxlength: 250 }
                    },
                    messages: {
                        Forwarder: { required: "Please select a forwarder." },
                        Waybill: { required: "Please enter waybill number.", maxlength: "Waybill must not exceed 150 characters." },
                        Remarks: { maxlength: "Remarks must not exceed 250 characters." }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoEdit();
                    },
                    invalidHandler: validateShowInvalids
                });

                // Send Edit to Controller
                function DoEdit() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("EditJson")",
                        data: {
                            SalesOrderId: $("#delivery-sales-order-id").val(),
                            DateDeliver: $("#delivery-date").val(),
                            DatePickup: $("#delivery-pickup-date").val(),
                            Forwarder: $("#delivery-forwarder").val(),
                            Waybill: $("#delivery-waybill").val(),
                            Remarks: $("#delivery-remarks").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#editModal").modal("hide");
                                deliveryDT.ajax.reload();
                            }
                        }
                    });
                }
            }
        });

        function ShowItemList(soId) {
            if ($.fn.dataTable.isDataTable('.table-item')) {
                $('.table-item').DataTable().destroy();
            }
            $('.table-item').on('preXhr.dt', function (e, settings, data) {
                showLoader();
            }).DataTable({
                ajax: {
                    url: "@Url.Action("GetItemsJson", "SalesOrder")",
                    data: { salesOrderId: soId },
                    dataSrc: function (json) {
                        return JSON.parse(JSON.stringify(json));
                    },
                    type: "POST",
                },
                filter: true,
                responsive: true,
                autoWidth: false,
                columns: [
                    { data: "itemCode", name: "ItemCode" },
                    { data: "itemName", name: "ItemName" },
                    { data: "quantity", name: "Quantity", className: "text-end" },
                    { data: "packedQuantity", name: "PackedQuantity", className: "text-end" },
                    { data: "invoicedQuantity", name: "InvoicedQuantity", className: "text-end" },
                    { data: "unit", name: "Unit" },
                    { data: "sellingPriceD", name: "SellingPrice", className: "text-end" },
                    { data: "discount1", name: "Discount1", className: "text-end" },
                    { data: "discount2", name: "Discount2", className: "text-end" },
                    { data: "grossPrice", name: "GrossPrice", className: "text-end grossprice" }
                ],
                order: [[0, "asc"]],
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api(), data;

                    columnDTTotalInteger(api, 2);
                    columnDTTotalInteger(api, 3);
                    columnDTTotalInteger(api, 4);
                    columnDTTotalDecimal(api, 9);
                }
            }).on("draw", function () {
                hideLoader();

                $(".table-item thead th").removeClass("form-cell");
                $(".table-item thead th").removeClass("text-end");
                $(".table-item thead th").removeClass("grossprice");

                $("#viewModal").modal("show");
            });
        }

        function ShowAction(usercreated, datecreated, usermodified, datemodified) {
            $(".action-created-by").text(usercreated);
            $(".action-created-date").text(datecreated);
            $(".action-modified-by").text(usermodified);
            $(".action-modified-date").text(datemodified);
            $("#actionModal").modal("show");
        }
    </script>
    }