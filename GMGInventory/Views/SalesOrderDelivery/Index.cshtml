@model IEnumerable<SalesOrderDeliveryVM>

@{
    ViewData["Title"] = "Sales Order Delivery Monitoring";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-delivery">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SalesOrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerAddress)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SalesOrderStatus)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RequiredDeliveryDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateReceive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DatePickup)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateDeliver)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Forwarder)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.WaybillNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Representative)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.VehicleName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Remarks)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedBy)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ModifiedBy)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ModifiedDate)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent Code</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date Delivered From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date Delivered To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>
@if (userAccess.CanEdit)
{
    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Sales Order Delivery</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="editForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-pickup-date" class="form-label mb-0">@Html.DisplayNameFor(model => model.DatePickup)</label>
                                    <input type="date" id="delivery-pickup-date" name="PickupDate" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-date" class="form-label mb-0">@Html.DisplayNameFor(model => model.DateDeliver)</label>
                                    <input type="date" id="delivery-date" name="DeliveryDate" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-forwarder" class="form-label mb-0">@Html.DisplayNameFor(model => model.Forwarder)</label>
                                    <div>
                                        <select id="delivery-forwarder" name="Forwarder" style="width:100%">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-waybill" class="form-label mb-0">@Html.DisplayNameFor(model => model.WaybillNumber)</label>
                                    <input type="text" id="delivery-waybill" name="Waybill" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-sla-date" class="form-label mb-0">@Html.DisplayNameFor(model => model.ServiceLevelAgreement)</label>
                                    <input type="date" id="delivery-sla-date" name="ServiceLevelAgreement" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-6">
                                 @*<div class="form-group">
                                    <label for="delivery-representative" class="form-label mb-0">@Html.DisplayNameFor(model => model.Representative)</label>
                                    <input type="text" id="delivery-representative" name="Representative" class="form-control form-control-sm" />
                                </div>*@
                                <div class="form-group">
                                    <label for="delivery-driver" class="form-label mb-0">@Html.DisplayNameFor(model => model.Representative)</label>
                                    <select id="delivery-driver" name="Driver" style="width: 100%"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-receive-date" class="form-label mb-0">@Html.DisplayNameFor(model => model.DateReceive)</label>
                                    <input type="date" id="delivery-receive-date" name="DateReceive" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-vehicle" class="form-label mb-0">@Html.DisplayNameFor(model => model.VehicleName)</label>
                                    <select id="delivery-vehicle" name="Vehicle" style="width: 100%" ></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="delivery-remarks" class="form-label mb-0">@Html.DisplayNameFor(model => model.Remarks)</label>
                                    <input type="text" id="delivery-remarks" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="delivery-sales-order-id" />
                        <input type="hidden" id="delivery-representative" name="Representative" />
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-save">
                            <span class="fas fa-save"></span> Save
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<!-- View Modal -->
