@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setFullYear(dt_from.getFullYear() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setFullYear(dt_to.getFullYear() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);
        
        



        var loadfilterloaded = false;
        function LoadFilterSelect2() {
            if (loadfilterloaded) return;
            loadfilterloaded = true;

            // Load Select2 for Agent
            $("#filter-agent").select2({
                minimumInputLength: 1,
                allowClear: true,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetOptions2", "Agent")"
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-agent").on("select2:select", function () {
                $("#filter-agent-name").val($(this).select2("data")[0].name);
            });

            $("#filter-agent").on("select2:unselecting", function (e) {
                $("#filter-agent-name").val("");
            });

            // Load Select2 for Customer
            $("#filter-customer").select2({
                minimumInputLength: 1,
                allowClear: true,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetOptions", "Customer")"
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-customer").on("select2:select", function () {
                $("#filter-customer-name").val($(this).select2("data")[0].name);
            });

            $("#filter-customer").on("select2:unselecting", function (e) {
                $("#filter-customer-name").val("");
            });

            // Load region data for select2
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Region")",
                success: function (data, status, xhr) {
                    $("#filter-region").select2({
                        ajax: null, //already fetched outside
                        allowClear: true,
                        placeholder: '<empty>',
                        data: data,
                        minimumResultsForSearch: Infinity
                    });
                }
            });

            // Load forwarder data for select2 on edit
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Forwarder")",
                success: function (data, status, xhr) {
                    $("#delivery-forwarder").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        allowClear: true,
                        placeholder: {
                            id: "",
                            text: "<empty>"
                        },
                        dropdownParent: $("#editModal")
                    });
                }
            });

            
        }

        // Load vehicle for select2
        $("#delivery-vehicle").select2({
           // minimumInputLength: 1,
            placeholder: '<empty>',
            allowClear: true,
            dropdownParent: $("#editModal"),
            
            ajax: {
                url: "@Url.Action("GetOptions", "Vehicle")"
            }
        });




       

        // Load driver for select2
        $("#delivery-driver").select2({
           // minimumInputLength: 1,
            placeholder: '<empty>',
            allowClear: true,
            dropdownParent: $("#editModal"),
           
            ajax: {
                url: "@Url.Action("GetOptions", "Driver")"
            }
        });


        $("#delivery-driver").on("select2:select",function (e){
            var data = e.params.data

             $("#delivery-representative").val(data.text);

        
        
        });


        $(".btnFilter").on("click", function () {
            deliveryDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        // Load List on DataTable
        var deliveryDT = $('.table-delivery').on('preXhr.dt', function (e, settings, data) {
            //showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    var customerId = $("#filter-customer").val();
                    var regionId = $("#filter-region").val();

                    if (agentId) data.AgentId = agentId;
                    if (customerId) data.CustomerId = customerId;
                    if (regionId) data.RegionId = regionId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Loading table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "salesOrderDate", name: "SalesOrderDate" },
                {
                  data: function (data, type, dataToSet) {
                        return data.poNumber == null ? "<span class='text-muted'>N/A</span>" : data.poNumber;
                  },
                  name: "PONumber"
                },
                { data: "soNumber", name: "SONumber" },
                { data: "customerCode", name: "CustomerCode" },
                { data: "customerName", name: "CustomerName" },
                { data: "customerAddress", name: "CustomerAddress" },
                { data: "salesOrderStatus", name: "SalesOrderStatus" },
                { data: "requiredDeliveryDate", name: "RequiredDeliveryDate" },
                {
                    data: function (data, type, dataToSet) {
                        return data.dateReceive == null ? "<span class='text-muted'>N/A</span>" : data.dateReceive;
                    },
                    name: "DateReceive"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.datePickup == null ? "<span class='text-muted'>N/A</span>" : data.datePickup;
                    },
                    name: "DatePickup"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.dateDeliver == null ? "<span class='text-muted'>N/A</span>" : data.dateDeliver;
                    }, name: "DateDeliver"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.forwarder == null ? "<span class='text-muted'>N/A</span>" : data.forwarder;
                    },
                    name: "Forwarder"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.waybillNumber == null ? "<span class='text-muted'>N/A</span>" : data.waybillNumber;
                    },
                    name: "WaybillNumber"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.representative == null ? "<span class='text-muted'>N/A</span>" : data.representative;
                    },
                    name: "Representative"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.vehicleName == null ? "<span class='text-muted'>N/A</span>" : data.vehicleName;
                    },
                    name: "VehicleName"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.remarks == null ? "<span class='text-muted'>N/A</span>" : data.remarks;
                    },
                    name: "Remarks"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.createdBy == null ? "<span class='text-muted'>N/A</span>" : data.createdBy;
                    },
                    name: "CreatedBy"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.createdDate == null ? "<span class='text-muted'>N/A</span>" : data.createdDate;
                    },
                    name: "CreatedDate"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.modifiedBy == null ? "<span class='text-muted'>N/A</span>" : data.modifiedBy;
                    },
                    name: "ModifiedBy"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.modifiedDate == null ? "<span class='text-muted'>N/A</span>" : data.modifiedDate;
                    },
                    name: "ModifiedDate"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<button class="btn btn-primary btn-xs viewBtn" onclick="ShowItemList(' + data.id + ')" data-microtip-title="View Item(s)" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></button>';
                        if (user_access.canEdit && data.salesOrderStatus.toLowerCase() != "disapproved") {
                            actions += '<button class="btn btn-warning btn-xs editBtn" onclick="ShowEdit(' + data.id + ')" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-pencil-alt"></span></button>';
                        }
                        //actions += '<button class="btn btn-info btn-xs actionBtn" onclick="ShowAction(\'' + data.createdBy + '\', \'' + data.createdDate + '\', \'' + data.modifiedBy + '\', \'' + data.modifiedDate + '\')" data-microtip-title="History" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-history"></span></button>';
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: [[0, "desc"]]
        });

        // Load functions upon DataTable load
        deliveryDT.on("draw", function () {
            //hideLoader();

            LoadFilterSelect2();
        });

        if (user_access.canEdit) {
            function ShowEdit(id){
                var datas = deliveryDT.rows().data().toArray().filter(row => row.id === id);
                var data = datas[0];

                $("#delivery-sales-order-id").val(data.id);
                $("#delivery-date").val(DateForInput(data.dateDeliverD));
                $("#delivery-pickup-date").val(DateForInput(data.datePickupD));
                $("#delivery-waybill").val(data.waybillNumber == "-" ? "" : data.waybillNumber);
                $("#delivery-remarks").val(data.remarks == "-" ? "" : data.remarks);
                $("#delivery-sla-date").val(DateForInput(data.serviceLevelAgreement));
                $("#delivery-representative").val(data.representative);
                $("#delivery-receive-date").val(DateForInput(data.dateReceive));
                $("#delivery-forwarder").val(data.forwarderId);
                $("#delivery-forwarder").trigger("change");

                if (data.vehicleId) {
                    var vehicleOption = new Option(data.vehicleName, data.vehicleId, true, true);
                    $("#delivery-vehicle").append(vehicleOption).trigger('change');
                } else {
                    $("#delivery-vehicle").val(null).trigger('change');
                }
               // $("#delivery-vehicle").val(data.vehicleId);
               // $("#delivery-vehicle").trigger("change");

               if (data.driverId) {
                   var driverOption = new Option(data.representative, data.driverId, true, true);
                   $("#delivery-driver").append(driverOption).trigger('change');
               } else {
                    $("#delivery-driver").val(null).trigger('change');
               }
                //$("#delivery-driver").val(data.driverId);
                //$("#delivery-driver").trigger("change");
            }

            // Validation for Edit Modal
            var validateEdit = $("#editForm").validate({
                rules: {
                    Forwarder: { required: true },
                    Waybill: { required: true, maxlength: 150 },
                    Remarks: { maxlength: 500 },
                    //Representative: { maxlength: 150 },
                    Vehicle: { required: true },
                    Driver: { required: true }
                },
                messages: {
                    Forwarder: { required: "Please select a forwarder." },
                    Waybill: { required: "Please enter waybill number.", maxlength: "Waybill must not exceed 150 characters." },
                    Remarks: { maxlength: "Remarks must not exceed 500 characters." },
                    //Representative: { maxlength: "Driver / Representative must not exceed 150 characters." },
                    Vehicle: { required: "Please select a vehicle." },
                    Driver: { required: "Please select a driver." }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoEdit();
                }
            });

            // Send Edit to Controller
            function DoEdit() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("EditJson")",
                    data: {
                        SalesOrderId: $("#delivery-sales-order-id").val(),
                        DateDeliver: $("#delivery-date").val(),
                        DatePickup: $("#delivery-pickup-date").val(),
                        Forwarder: $("#delivery-forwarder").val(),
                        Waybill: $("#delivery-waybill").val(),
                        Remarks: $("#delivery-remarks").val(),
                        ServiceLevelAgreement: $("#delivery-sla-date").val(),
                        Representative: $("#delivery-representative").val(),
                        DateReceive: $("#delivery-receive-date").val(),
                        VehicleId: $("#delivery-vehicle").val(),
                        DriverId: $("#delivery-driver").val(),
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#editModal").modal("hide");
                            deliveryDT.ajax.reload();
                        }
                    }
                });
            }
        }

        function ShowItemList(soId) {
            if ($.fn.dataTable.isDataTable('.table-item')) {
                $('.table-item').DataTable().destroy();
            }
            $('.table-item').on('preXhr.dt', function (e, settings, data) {
                //showLoader();
            }).DataTable({
                ajax: {
                    url: "@Url.Action("GetItemsJson", "SalesOrder")",
                    data: { salesOrderId: soId },
                    dataSrc: function (json) {
                        return JSON.parse(JSON.stringify(json));
                    },
                    type: "POST",
                    beforeSend: function (jqXHR, settings) {
                        settings.isDataTableRequest = true;
                    }
                },
                processing: true,
                language: {
                    processing: "<div class='dt-loader'>Loading table, please wait...</div>"
                },
                filter: true,
                responsive: true,
                autoWidth: false,
                columns: [
                    { data: "itemCode", name: "ItemCode" },
                    { data: "itemName", name: "ItemName" },
                    { data: "quantity", name: "Quantity", className: "text-end" },
                    { data: "packedQuantity", name: "PackedQuantity", className: "text-end" },
                    { data: "invoicedQuantity", name: "InvoicedQuantity", className: "text-end" },
                    { data: "unit", name: "Unit" },
                    { data: "sellingPriceD", name: "SellingPrice", className: "text-end" },
                    { data: "discount1", name: "Discount1", className: "text-end" },
                    { data: "discount2", name: "Discount2", className: "text-end" },
                    { data: "grossPrice", name: "GrossPrice", className: "text-end grossprice" }
                ],
                order: [[0, "asc"]],
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api(), data;

                    columnDTTotalInteger(api, 2);
                    columnDTTotalInteger(api, 3);
                    columnDTTotalInteger(api, 4);
                    columnDTTotalDecimal(api, 9);
                }
            }).on("draw", function () {
                //hideLoader();

                $(".table-item thead th").removeClass("form-cell");
                $(".table-item thead th").removeClass("text-end");
                $(".table-item thead th").removeClass("grossprice");

                $("#viewModal").modal("show");
            });
        }

