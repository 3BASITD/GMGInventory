@model SOACRDetailsVM

@{
    ViewData["Title"] = "SOA/CR Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Soacr" asp-action="Index">SOA / Counter Receipt</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light btn-sm float-right ml-2" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
            @if (userAccess.CanPrint)
            {
                <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                    <span class="fas fa-print"></span> Print
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Id)
                    </span>
                    <b class="d-block">
                        @Model?.Id
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Customer)
                    </span>
                    <b class="d-block">
                        @Model?.Customer
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Type)
                    </span>
                    <b class="d-block SoacrType">
                        @Model?.Type
                    </b>
                </p>
            </div>
        </div>
        @if (Model?.Type == "Statement of Account")
        {
            <div class="row">
                <div class="col-12 col-md-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateFrom)
                        </span>
                        <b class="d-block">
                            @Model?.DateFrom
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateTo)
                        </span>
                        <b class="d-block">
                            @Model?.DateTo
                        </b>
                    </p>
                </div>
            </div>
        }
        <div class="card card-default">
            <div class="card-header">
                <span class="card-title">Invoice(s)</span>
                <div class="card-tools">
                    @if (Model?.Type == "Counter Receipt")
                    {
                        @if (userAccess.CanAdd)
                        {
                            <a class="btn btn-primary btn-sm float-right ml-2 btn-add-invoice">
                                <span class="fas fa-plus"></span> Add Invoice
                            </a>
                        }
                    }
                    @if (userAccess.CanAdd)
                    {
                        <button type="button" class="btn btn-primary btn-sm float-right paymentBtn ml-2">
                            <span class="fas fa-money-bill"></span> Add Payment
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                <table class="table table-head-fixed table-striped table-hover table-soa">
                    <thead>
                        <tr>
                            <th>
                                <input class="chkclassinvoiceall" type="checkbox" />
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().InvoiceDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().InvoiceNumber)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().InvoiceAmount)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().TBR)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().Credit)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().Debit)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().PaidAmount)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().FreightCharge)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Items.First().Balance)
                            </th>
                            <th>
                            </th>

                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th>0.00</th>
                            <th>0.00</th>
                            <th>0.00</th>
                            <th>0.00</th>
                            <th>0.00</th>
                            <th>0.00</th>
                            <th>0.00</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
@if (userAccess.CanEdit)
{
    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Invoice</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="editForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="edit-debit" class="control-label mb-0 d-block">Debit</label>
                                    @*<input type="number" step="0.01" min="0" max="1999999.99" name="Debit" id="edit-debit" class="form-control form-control-sm" />*@
                                    <input type="text" name="Debit" id="edit-debit" class="form-control form-control-sm mask-decimal" />
                                    <span data-valmsg-for="edit-debit" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="edit-credit" class="control-label mb-0 d-block">Credit</label>
                                    @*<input type="number" step="0.01" min="0" max="1999999.99" name="Credit" id="edit-credit" class="form-control form-control-sm" />*@
                                    <input type="text" name="Credit" id="edit-credit" class="form-control form-control-sm mask-decimal" />
                                    <span data-valmsg-for="edit-credit" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="edit-freight-cost" class="control-label mb-0 d-block">Freight Cost</label>
                                    @*<input type="number" step="0.01" min="0" max="1999999.99" name="FreightCost" id="edit-freight-cost" class="form-control form-control-sm" />*@
                                    <input type="text" name="FreightCost" id="edit-freight-cost" class="form-control form-control-sm mask-decimal" />
                                    <span data-valmsg-for="edit-freight-cost" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="edit-freight-waybill" class="control-label mb-0 d-block">Freight's Waybill</label>
                                    <input type="text" name="FreightWaybill" id="edit-freight-waybill" class="form-control form-control-sm" />
                                    <span data-valmsg-for="edit-freight-waybill" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<!-- TBR Modal -->
<div class="modal fade" id="tbrModal" role="dialog" aria-labelledby="tbrModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">TBR</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="tbrForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="tbr-for" class="control-label mb-0 d-block">TBR For</label>
                                <input type="text" id="tbr-for" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group">
                                <label for="tbr-invoice" class="control-label mb-0 d-block">Sales Return Invoice Number</label>
                                <select id="tbr-invoice" name="InvoiceNumber" style="width: 100%"></select>
                                <span data-valmsg-for="tbr-invoice" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group">
                                <label for="tbr-amount" class="control-label mb-0 d-block">Amount</label>
                                @*<input type="number" step="0.01" min="0" max="1999999.99" name="Amount" id="tbr-amount" class="form-control form-control-sm" />
                                *@
                                <input type="text" name="Amount" id="tbr-amount" class="form-control form-control-sm mask-decimal" />
                                <input type="hidden" id="tbr-amount-max" class="form-control form-control-sm" />
                                <span data-valmsg-for="tbr-amount" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info mr-auto btnTBRHistory">
                        <span class="fas fa-history"></span>
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-save"></span> Save
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- TBR History Modal -->
<div class="modal fade" id="tbrHistoryModal" role="dialog" aria-labelledby="tbrHistoryModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">TBR History</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="tbr-history-for" class="control-label mb-0 d-block">TBR For</label>
                            <input type="text" id="tbr-history-for" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                    <div class="col-12">
                        <table class="table table-head-fixed table-striped table-hover table-tbr-history">
                            <thead>
                                <tr>
                                    <th>
                                        Invoice Number
                                    </th>
                                    <th>
                                        Amount
                                    </th>
                                    <th>
                                        Added By
                                    </th>
                                    <th>
                                        Date Added
                                    </th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th class="text-end">Total</th>
                                    <th>0.00</th>
                                    <th colspan="2"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Close
                </button>
            </div>
        </div>
    </div>
</div>
@if (userAccess.CanEdit)
