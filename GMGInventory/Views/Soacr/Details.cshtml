@section Scripts {
    <script>
        var itemTable = $('.table-soa').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetSoaDetailsJson", "Soacr")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                    data.custId = @Model?.CustomerId;
                },
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "invoiceAmount", name: "InvoiceAmount", className: "text-end" },
                { data: "tbr", name: "TBR", className: "text-end" },
                { data: "credit", name: "Credit", className: "text-end" },
                { data: "debit", name: "Debit", className: "text-end" },
                { data: "paidAmount", name: "PaidAmount", className: "text-end" },
                { data: "freightCharge", name: "FreightCharge", className: "text-end" },
                { data: "balance", name: "Balance", className: "text-end" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Invoice" data-microtip-position="top-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                        actions += '<button class="btn btn-primary btn-xs paymentBtn" data-microtip-title="Edit Payment" data-microtip-position="top-left" role="tooltip"><i class="fas fa-money-bill"></i></button>';
                        actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete Invoice" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions;
                    }
                }
            ],
            order: [[0, "desc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalDecimal(api, 2);
                columnDTTotalDecimal(api, 3);
                columnDTTotalDecimal(api, 4);
                columnDTTotalDecimal(api, 5);
                columnDTTotalDecimal(api, 6);
                columnDTTotalDecimal(api, 7);
                columnDTTotalDecimal(api, 8);
            }
        });

        itemTable.on("draw", function () {
            hideLoader();

            //$('.table-soa thead th').removeClass("text-end");

            $(".printBtn").on("click", function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                var urlQuery = [];
                //urlQuery.push("DateFrom=" + $("#filter-from").val());
                //urlQuery.push("DateTo=" + $("#filter-to").val());
                //if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
                //if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
                if ($(".SoacrType").text().trim() == "Statement of Account") {
                    setTimeout(function () {
                        //let win = window.open('@Url.Action("PrintCRDetails")?' + urlQuery.join("&"), '');

                        let win = window.open('@Url.Action("PrintSoaDetails")/@Model?.Id', '');
                        var wintimer = setInterval(function () {
                            if (win.closed) {
                                clearInterval(wintimer);
                                hideLoader();
                            }
                        }, 100);
                    }, 500);

                }
                else if ($(".SoacrType").text().trim() == "Counter Receipt") {
                    setTimeout(function () {
                        //let win = window.open('@Url.Action("PrintCRDetails")?' + urlQuery.join("&"), '');

                        let win = window.open('@Url.Action("PrintCRDetails")/@Model?.Id', '');
                        var wintimer = setInterval(function () {
                            if (win.closed) {
                                clearInterval(wintimer);
                                hideLoader();
                            }
                        }, 100);
                    }, 500);

                }

            });

            $('.deleteBtn').click(function (e) {
                swal({
                    title: "Delete Invoice",
                    text: "Are you sure you want to delete this record?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        var btn = $(this);
                        var id = btn.data("id");
                        $('#deleteSoaLineItemId').val(id);
                        $('#deleteSoaLineItemForm').submit();
                    }
                });
            });



            // Actions upon Display Edit Modal
            $(".editBtn").click(function (e) {
                var data = itemTable.row($(this).parents('tr')).data();
                $("#edit-id").val(data.id);
                $("#edit-tbr").val(data.tbrd);
                $("#edit-debit").val(data.debitD);
                $("#edit-credit").val(data.creditD);
                $("#edit-freight-cost").val(data.freightChargeD);
                $("#edit-invoice").val(data.invoiceId);

            });

            // Validation for Edit Modal
            var validateEdit = $("#editForm").validate({
                errorClass: 'text-danger text-xs',
                rules: {
                    TBR: { range: [0, 1999999.99] },
                    Debit: { range: [0, 1999999.99] },
                    Credit: { range: [0, 1999999.99] },
                    FreightCost: { range: [0, 1999999.99] }
                },
                messages: {
                    TBR: { range: "Credit Limit must be between 0-1999999.99." },
                    Debit: { range: "Credit Limit must be between 0-1999999.99." },
                    Credit: { range: "Credit Limit must be between 0-1999999.99." },
                    FreightCost: { range: "Credit Limit must be between 0-1999999.99." }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoEdit();
                },
                showErrors: validateShowErrors
            });

            // Send Edit to Controller
            function DoEdit() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("EditInvoiceJson")",
                    data: {
                        Id: $("#edit-id").val(),
                        InvoiceId: $("#edit-invoice").val(),
                        TBRD: $("#edit-tbr").val(),
                        DebitD: $("#edit-debit").val(),
                        CreditD: $("#edit-credit").val(),
                        FreightChargeD: $("#edit-freight-cost").val()
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastrNoDuplicate(data.message, "Error", "error");
                        } else {
                            toastrNoDuplicate(data.message, "Success", "success");
                            $("#editModal").modal("hide");
                            itemTable.ajax.reload();
                        }
                    },
                    complete: function (xhr, status) {
                    }
                });
            }


            // Actions upon Display Create Modal
            $(".paymentBtn").click(function (e) {
                var data = itemTable.row($(this).parents('tr')).data();
                $("#payment-customer-receipt").data("invoice", data.invoiceId);
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetPaymentDetailsJson")",
                    data: {
                        CustomerId: @Model?.CustomerId,
                        SOACRId: @Model?.Id,
                        InvoiceId: data.invoiceId
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        $("#payment-customer-receipt").val(data.customerReceiptNumber);
                        $("#payment-customer-receipt").data("CustomerPaymentId", data.id);
                        $("#payment-remarks").val(data.remarks);
                        $("#payment-over-payment").val(data.overPayment.toFixed(2));
                        $("#payment-tkt").val(data.tktSolicitation.toFixed(2));
                        $("#payment-tax").val(data.tax.toFixed(2));
                        $("#payment-cash-advanced").val(data.cashAdvance.toFixed(2));
                        $("#payment-discount").val(data.discount.toFixed(2));
                        $("#payment-offset").val(data.offset.toFixed(2));
                        $("#payment-cash-amount").val(data.cashAmount.toFixed(2));
                        $("#payment-backload").val(data.backLoad.toFixed(2));
                    },
                    complete: function (xhr, status) {
                        checkTable.ajax.reload();
                        ResetCheckPaymentForm();
                        $("#paymentModal").modal("show");
                    }
                });
            });

            $("#payment-customer-receipt").on("change", function () {
                if ($("#payment-customer-receipt").val() == "") {
                    toastrNoDuplicate("Please enter customer receipt", "Required field &lt;Customer Receipt&gt;", "warning");
                    $('span[data-valmsg-for="payment-customer-receipt"]').text("Please enter customer receipt");
                } else {
                    $('span[data-valmsg-for="payment-customer-receipt"]').text("");
                }
            })

            $(".btn-payment").on("click", function () {
                if ($("#payment-customer-receipt").val() == "") {
                    toastrNoDuplicate("Please enter customer receipt", "Required field &lt;Customer Receipt&gt;", "warning");
                    $('span[data-valmsg-for="payment-customer-receipt"]').text("Please enter customer receipt");
                } else {
                    $('span[data-valmsg-for="payment-customer-receipt"]').text("");
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("UpdatePaymentDetailsJson")",
                        data: {
                            Id: $("#payment-customer-receipt").data("CustomerPaymentId"),
                            CustomerReceiptNumber: $("#payment-customer-receipt").val(),
                            remarks: $("#payment-remarks").val(),
                            overPayment: $("#payment-over-payment").val(),
                            tktSolicitation: $("#payment-tkt").val(),
                            tax: $("#payment-tax").val(),
                            cashAdvance: $("#payment-cash-advanced").val(),
                            discount: $("#payment-discount").val(),
                            offset: $("#payment-offset").val(),
                            cashAmount: $("#payment-cash-amount").val(),
                            backLoad: $("#payment-backload").val()
                        },
                        error: jQueryCommonError,
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastrNoDuplicate(data.message, "Error", "error");
                            } else {
                                toastrNoDuplicate(data.message, "Success", "success");
                                $("#paymentModal").modal("hide");
                                itemTable.ajax.reload();
                            }
                        }
                    });
                }
            });
        });

        var checkTable = $('.table-check').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetPaymentChecksJson", "Soacr")",
                type: "POST",
                data: function (data) {
                    data.CustomerPaymentId = $("#payment-customer-receipt").data("CustomerPaymentId");
                },
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "bankName", name: "BankName" },
                { data: "bankBranch", name: "BankBranch" },
                { data: "checkNumber", name: "CheckNumber" },
                { data: "checkAmount", name: "CheckAmount", className: "text-end" },
                { data: "checkDate", name: "CheckDate" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button class="btn btn-danger btn-xs btn-remove-check" data-microtip-title="Remove Check" data-microtip-position="top-left" role="tooltip"><i class="fas fa-trash"></i></button>';
                        return actions;
                    }
                }
            ],
            order: [[4, "desc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalDecimal(api, 3);
            }
        });

        checkTable.on("draw", function () {
            hideLoader();

            $('.table-check thead th').removeClass("text-end");

            $(".btn-remove-check").on("click", function () {
                var data = checkTable.row($(this).parents('tr')).data();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("RemoveCheckJson")",
                    data: {
                        soaCheckId: data.id
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastrNoDuplicate(data.message, "Error", "error");
                        } else {
                            toastrNoDuplicate(data.message, "Success", "success");
                            $("#checkModal").modal("hide");
                            checkTable.ajax.reload();
                            hideLoader();
                        }
                    }
                });
            });
        });

        // Validation for Check Modal
        var validateCheck = $("#checkForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                BankName: { required: true, maxlength: 100 },
                CheckDate: { required: true },
                CheckAmount: { required: true, range: [0.01, 1999999.99] },
                BankBranch: { required: true, maxlength: 100 },
                CheckNumber: { required: true, maxlength: 50 }
            },
            messages: {
                BankName: { required: "Please enter Bank Name", maxlength: "Bank Name must not exceed 100 characters." },
                CheckDate: { required: "Please enter Check Date" },
                CheckAmount: { required: "Please enter Check Amount", range: "Check Amount must be between 0.01-1999999.99." },
                BankBranch: { required: "Please enter Bank Branch", maxlength: "Bank Branch must not exceed 100 characters." },
                CheckNumber: { required: "Please enter Check Number", maxlength: "Check Number must not exceed 50 characters." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoCreateCheck();
            },
            showErrors: validateShowErrors
        });


        // Send Create Check to Controller
        function DoCreateCheck() {
            var customer_payment_id = $("#payment-customer-receipt").data("CustomerPaymentId");
            if (customer_payment_id == null) {
                toastrNoDuplicate("Please try again later", "Error", "error");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddCheckJson")",
                    data: {
                        CustomerPaymentId: customer_payment_id,
                        BankName: $("#check-bankname").val(),
                        CheckDateD: $("#check-checkdate").val(),
                        CheckAmountD: $("#check-checkamount").val(),
                        BankBranch: $("#check-bankbranch").val(),
                        CheckNumber: $("#check-checknumber").val()
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastrNoDuplicate(data.message, "Error", "error");
                        } else {
                            toastrNoDuplicate(data.message, "Success", "success");
                            ResetCheckPaymentForm();
                            checkTable.ajax.reload();
                            hideLoader();
                        }
                    }
                });
            }
        }

        $(".btnClearCheck").on("click", ResetCheckPaymentForm);

        function ResetCheckPaymentForm() {
            $("#check-bankname").val("");
            $("#check-checkdate").val(DateForInput(new Date()));
            $("#check-checkamount").val("0.00");
            $("#check-bankbranch").val("");
            $("#check-checknumber").val("");
            validateCheck.resetForm();
        }

        var invoiceDT = $('.table-invoice').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetCustomerInvoicesJson")",
                data: function (data) {
                    data.Id = @Model?.CustomerId;
                    data.soaId = @Model?.Id;

                },
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var input = '<input class="chkclassinvoice" type="checkbox" id="checkInvoice"  name="CheckInvoice" data-id = "' + data.id + '">';

                        return input;
                    }
                },
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "invoiceType", name: "InvoiceType" },
                { data: "totalAmount", name: "TotalAmount" }
            ],
            order: [[1, "desc"]]
        });

        // Load functions upon DataTable load
        invoiceDT.on("draw", function () {
            hideLoader();
        });

        $(".createInvoiceBtn").click(function (e) {
            invoiceDT.ajax.reload();
        });


        $(".btn-add").click(function (e) {

            var invoiceIds = [];

            invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var invlist = $(this.node()).find(".chkclassinvoice");
                if (invlist.prop("checked")) {
                    invoiceIds.push(invlist.data("id"));
                }

            });

            $.ajax({
                type: "POST",
                url: "@Url.Action("AddInvoices")",
                data: {
                    soaId: @Model?.Id,
                    invoiceIds: invoiceIds

                },
                error: jQueryCommonError,
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastrNoDuplicate(data.message, "Error", "error");
                    } else {
                        toastrNoDuplicate(data.message, "Success", "success");
                        $("#createInvoiceModal").modal("hide");
                        itemTable.ajax.reload();
                        hideLoader();
                        //window.location = '@Url.Action("ContractReceiptDetails")/' + Id;
                    }
                }
            });

        });

    </script>
	}


