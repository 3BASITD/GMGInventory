                    </button>
                </div>
                <div class="modal-body">
                    <div class="row align-items-center form-group">
                        <div class="col-12 col-lg-3">
                            <label for="payment-collector-receipt" class="control-label mb-0">Collector Receipt No</label>
                        </div>
                        <div class="col-12 col-lg-5">
                            <input type="text" name="CollectorReceipt" id="payment-collector-receipt" class="form-control form-control-sm" autocomplete="off" />
                        </div>
                        <div class="col-12 col-lg-4">
                            <span data-valmsg-for="payment-collector-receipt" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row align-items-center form-group">
                        <div class="col-12 col-lg-3">
                            <label for="payment-remarks" class="control-label mb-0">Remarks</label>
                        </div>
                        <div class="col-12 col-lg-9">
