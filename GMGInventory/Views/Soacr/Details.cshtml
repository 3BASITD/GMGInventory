@section Scripts {
	<script>
		var itemTable = $('.table-soa').on('preXhr.dt', function (e, settings, data) {
			showLoader();
		}).DataTable({
			ajax: {
				url: "@Url.Action("GetSoaDetailsJson", "Soacr")",
				type: "POST",
				data: function(data) {
					data.Id = @Model?.Id;
					data.custId = @Model?.CustomerId;
				},
			},
			serverSide: true,
			filter: true,
			responsive: true,
			autoWidth: false,
			columns: [
				{ data: "invoiceNumber", name: "InvoiceNumber" },
				{ data: "invoiceAmount", name: "InvoiceAmount" },
				{ data: "tbr", name: "TBR" },
				{ data: "credit", name: "Credit" },
				{ data: "debit", name: "Debit" },
				{ data: "paidAmount", name: "PaidAmount" },
				{ data: "freightCharge", name: "FreightCharge" },
				{ data: "balance", name: "Balance"/*, className: "text-end"*/},
				{
					orderable: false,
					data: function (data, type, dataToSet) {
						var actions = '';
							actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Invoice" data-microtip-position="left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
							actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete Invoice" data-microtip-position="left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
						actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
						return actions;
					}
				}
			   
			]
		});

		itemTable.on("draw", function () {
			hideLoader();

			DatatablesSearchOnEnter('.table-soa', itemTable);

			$(".printBtn").on("click", function() {
				$.LoadingOverlay("show", {
					image: "",
					fontawesome: "fas fa-print"
				});
				var urlQuery = [];
				//urlQuery.push("DateFrom=" + $("#filter-from").val());
				//urlQuery.push("DateTo=" + $("#filter-to").val());
				//if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
				//if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
			if ($(".SoacrType").text().trim() == "Statement of Account") { 
			setTimeout(function() {
					//let win = window.open('@Url.Action("PrintCRDetails")?' + urlQuery.join("&"), '');

					let win = window.open('@Url.Action("PrintSoaDetails")/@Model?.Id', '');
					var wintimer = setInterval(function() {
						if (win.closed) {
							clearInterval(wintimer);
							hideLoader();
						}
					}, 100);
				}, 500);

			}
			else if ($(".SoacrType").text().trim() == "Counter Receipt") { 
			setTimeout(function() {
					//let win = window.open('@Url.Action("PrintCRDetails")?' + urlQuery.join("&"), '');

					let win = window.open('@Url.Action("PrintCRDetails")/@Model?.Id', '');
					var wintimer = setInterval(function() {
						if (win.closed) {
							clearInterval(wintimer);
							hideLoader();
						}
					}, 100);
				}, 500);

			}

			});

			$('.deleteBtn').click(function(e) {
				swal({
					title: "Delete Invoice",
					text: "Are you sure you want to delete this record?",
					icon: "warning",
					buttons: true,
					dangerMode: true
				}).then((confirm) => {
					if (confirm) {
						var btn = $(this);
						var id = btn.data("id");
						$('#deleteSoaLineItemId').val(id);
						$('#deleteSoaLineItemForm').submit();
					}
				});
			});



			// Actions upon Display Edit Modal
			$(".editBtn").click(function (e) {
				var data = itemTable.row($(this).parents('tr')).data();
				console.log(data);
				console.log(data.invoiceId);
					$("#edit-id").val(data.id);
					$("#edit-tbr").val(data.tbrd);
					$("#edit-debit").val(data.debitD);
					$("#edit-credit").val(data.creditD);
					$("#edit-freight-cost").val(data.freightChargeD);
					$("#edit-invoice").val(data.invoiceId);

			});

			// Validation for Edit Modal
			var validateEdit = $("#editForm").validate({
				errorClass: 'text-danger text-xs',
				rules: {
					TBR: { range: [0, 1999999.99] },
					Debit: { range: [0, 1999999.99] },
					Credit: { range: [0, 1999999.99] },
					FreightCost: { range: [0, 1999999.99] }
				},
				messages: {
					TBR: { range: "Credit Limit must be between 0-1999999.99." },
					Debit: { range: "Credit Limit must be between 0-1999999.99." },
					Credit: { range: "Credit Limit must be between 0-1999999.99." },
					FreightCost: { range: "Credit Limit must be between 0-1999999.99." }
				},
				submitHandler: function (form, event) {
					event.preventDefault();
					DoEdit();
				}
			});

			// Send Edit to Controller
			function DoEdit() {
				$.ajax({
					type: "POST",
					url: "@Url.Action("EditInvoiceJson")",
					data: {
						Id: $("#edit-id").val(),
						InvoiceId: $("#edit-invoice").val(),
						TBRD: $("#edit-tbr").val(),
						DebitD: $("#edit-debit").val(),
						CreditD: $("#edit-credit").val(),
						FreightChargeD: $("#edit-freight-cost").val()
					},
					error: jQueryCommonError,
					success: function (data, status, xhr) {
						if (data.status == "Error") {
							toastr.error(data.message, "Error");
						} else {
							toastr.success(data.message, "Success");
							$("#editModal").modal("hide");
							itemTable.ajax.reload();
						}
					},
					complete: function (xhr, status) {
					}
				});
			}


		 // Actions upon Display Create Modal
		$(".createBtn").click(function(e) {
			var data = itemTable.row($(this).parents('tr')).data();
			//$("#create-invoice").val(data.invoiceId);
			$("#create-customer").val(@Model?.CustomerId);
			$("#create-customer-receipt").val("");
			$("#create-remarks").val("");
			$("#create-over-payment").val("");
			$("#create-tkt").val("");
			$("#create-tax").val("");
			$("#create-cash-advanced").val("");
			$("#create-discount").val("");
			$("#create-offset").val("");
			$("#create-cash-amount").val("");
			$("#create-backload").val("");
			$("#create-bankname").val("");
			$("#create-bankbranch").val("");
			$("#create-checkdate").val("");
			$("#create-checkamount").val("");
			$("#create-checknumber").val("");
		});

		// Validation for Create Modal
		var validateCreate = $("#createForm").validate({
			errorClass: 'text-danger text-xs',
			rules: {
				CustomerReceipt: { required: true, maxlength: 50 },
				Remarks: { required: true, maxlength: 100 },
				OverPayment: { range: [0, 1999999.99] },
				TKT: { range: [0, 1999999.99] },
				TAX: { range: [0, 1999999.99] },
				CashAdvanced: { range: [0, 1999999.99] },
				Discount: { range: [0, 1999999.99] },
				Offset: { range: [0, 1999999.99] },
				CashAmount: { range: [0, 1999999.99] },
				BackLoad: { range: [0, 1999999.99] },
				BankName: { required: true},
				BankBranch: { required: true },
				CheckDate: { required: true},
				CheckAmount: { required: true},
				CheckNumber: { required: true}
			},
			messages: {
				CustomerReceipt: { required: "Please enter Customer Receipt No.", maxlength: "Code must not exceed 50 characters."  },
				Remarks: { required: "Please enter Remarks.", maxlength: "Remarks must not exceed 100 characters." },
				OverPayment: { range: "Over Payment must be between 0-1999999.99." },
				TKT: { range: "TKT must be between 0-1999999.99." },
				TAX: { range: "TAX must be between 0-1999999.99." },
				CashAdvanced: { range: "Cash Advanced must be between 0-1999999.99."},
				Discount: { range: "Discount must be between 0-1999999.99." },
				Offset: { range: "Offset must be between 0-1999999.99." },
				CashAmount: { range: "Cash Amount must be between 0-1999999.99." },
				BackLoad: { range: "Back Load must be between 0-1999999.99." },
				BankName: { required: "Please enter Bank Name."},
				BankBranch: { required: "Please enter Bank Branch." },
				CheckDate: { required: "Please enter Check Date."},
				CheckAmount: { required: "Please enter Check Amount."},
				CheckNumber: { required: "Please enter Check Number."}
				
			},
			submitHandler: function (form, event) {
				event.preventDefault();
				DoCreate();
			}
		});


		// Send Create to Controller
		function DoCreate() {
			$.ajax({
				type: "POST",
				url: "@Url.Action("CreatePaymentJson")",
				data: {
					SOANo: @Model?.Id,
					CustomerId: @Model?.CustomerId,
					InvoiceId: $("#create-invoice").val(),
					CRNumber: $("#create-customer-receipt").val(),
					Remarks: $("#create-remarks").val(),
					OverPaymentD: $("#create-over-payment").val(),
					TKTD: $("#create-tkt").val(),
					TaxD: $("#create-tax").val(),
					CashAdvancedD: $("#create-cash-advanced").val(),
					DiscountD: $("#create-discount").val(),
					OffsetD: $("#create-offset").val(),
					CashAmountD: $("#create-cash-amount").val(),
					BackLoadD: $("#create-backload").val(),
					BankName: $("#create-bankname").val(),
					BankBranch: $("#create-bankbranch").val(),
					CheckAmountD: $("#create-checkamount").val(),
					CheckDateD: $("#create-checkdate").val(),
					CheckNo: $("#create-checknumber").val()
				},
				error: jQueryCommonError,
				success: function(data, status, xhr) {
					if (data.status == "Error") {
						toastr.error(data.message, "Error");
					} else {
						toastr.success(data.message, "Success");
						$("#createModal").modal("hide");
						itemTable.ajax.reload();
						hideLoader();
					}
				}
			});
		}



	  
	
		});

		


		var invoiceDT = $('.table-invoice').on('preXhr.dt', function (e, settings, data) {
			showLoader();
		}).DataTable({
			ajax: {
				url: "@Url.Action("GetCustomerInvoicesJson")",
				data: function (data) {
					data.Id = @Model?.CustomerId;
					data.soaId = @Model?.Id;

				},
				type: "POST",
			},
			serverSide: true,
			filter: true,
			responsive: true,
			autoWidth: false,
			columns: [
				{
					orderable: false,
					data: function(data, type, dataToSet) {
					  var input = '<input class="chkclassinvoice" type="checkbox" id="checkInvoice"  name="CheckInvoice" data-id = "'+data.id+'">';
						
						return input;
					}
				},
				{ data: "invoiceDate", name: "InvoiceDate" },
				{ data: "invoiceNumber", name: "InvoiceNumber" },
				{ data: "invoiceType", name: "InvoiceType" },
				{ data: "totalAmount", name: "TotalAmount" }
			],
			order: [[1, "desc"]]
		});

		// Load functions upon DataTable load
		invoiceDT.on("draw", function () {
			hideLoader();

			DatatablesSearchOnEnter('.table-invoice', invoiceDT);


		});

		$(".createInvoiceBtn").click(function(e) {
			invoiceDT.ajax.reload();
		});


		$(".btn-add").click(function(e) {

			var invoiceIds = []; 
			
				invoiceDT.rows().every( function ( rowIdx, tableLoop, rowLoop ) {
				var invlist = $(this.node()).find(".chkclassinvoice");
				if (invlist.prop("checked"))
				{ 
					invoiceIds.push(invlist.data("id"));
				}

			} );

			$.ajax({
				type: "POST",
				url: "@Url.Action("AddInvoices")",
				data: {
					soaId: @Model?.Id,
					invoiceIds: invoiceIds

				},
				error: jQueryCommonError,
				success: function(data, status, xhr) {
					if (data.status == "Error") {
						toastr.error(data.message, "Error");
					} else {
						toastr.success(data.message, "Success");
						$("#createInvoiceModal").modal("hide");
						itemTable.ajax.reload();
						hideLoader();
						//window.location = '@Url.Action("ContractReceiptDetails")/' + Id;
					}
				}
			});

		});

	</script>
	}


				