                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="CashAdvanced" id="payment-cash-advanced" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="row align-items-center form-group">
                    <div class="col-4 col-lg-3">
                        <label for="payment-discount" class="control-label mb-0">Discount</label>
                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="Discount" id="payment-discount" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4 col-lg-3">
                        <label for="payment-offset" class="control-label mb-0 d-block">Offset</label>
                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="Offset" id="payment-offset" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="row align-items-center form-group">
                    <div class="col-4 col-lg-3">
                        <label for="payment-cash-amount" class="control-label mb-0">Cash Amount</label>
                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="CashAmount" id="payment-cash-amount" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4 col-lg-3">
                        <label for="payment-backload" class="control-label mb-0 d-block">Back Load</label>
                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="BackLoad" id="payment-backload" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card border-secondary border-1">
                            <div class="card-header bg-secondary">
                                <strong>Check</strong>
                            </div>
                            <div class="card-body pb-0">
                                <form autocomplete="off" id="checkForm">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label for="check-bankname" class="control-label mb-0 d-block">Bank Name</label>
                                                <input type="text" name="BankName" id="check-bankname" class="form-control form-control-sm" />
                                                <span data-valmsg-for="check-bankname" data-valmsg-replace="true" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label for="check-checkdate" class="control-label mb-0 d-block">Check Date</label>
                                                <input type="date" name="CheckDate" id="check-checkdate" class="form-control form-control-sm" />
                                                <span data-valmsg-for="check-checkdate" data-valmsg-replace="true" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label for="check-checkamount" class="control-label mb-0 d-block">Check Amount</label>
                                                <input type="number" step="0.01" min="0" max="1999999.99" name="CheckAmount" id="check-checkamount" class="form-control form-control-sm" />
                                                <span data-valmsg-for="check-checkamount" data-valmsg-replace="true" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label for="check-bankbranch" class="control-label mb-0 d-block">Bank Branch</label>
                                                <input type="text" name="BankBranch" id="check-bankbranch" class="form-control form-control-sm" />
                                                <span data-valmsg-for="check-bankbranch" data-valmsg-replace="true" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label for="check-checknumber" class="control-label mb-0 d-block">Check Number</label>
                                                <input type="text" name="CheckNumber" id="check-checknumber" class="form-control form-control-sm" />
                                                <span data-valmsg-for="check-checknumber" data-valmsg-replace="true" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <button type="button" class="btn btn-secondary btn-sm float-right btnClearCheck ml-2">
                                                    <span class="fas fa-undo-alt"></span> Clear
                                                </button>
                                                <button type="submit" class="btn btn-primary btn-sm float-right">
                                                    <span class="fas fa-arrow-down"></span> Add Check
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="card-body">
                                <table class="table table-head-fixed table-striped table-hover table-check">
                                    <thead>
                                        <tr>
                                            <th>Bank Name</th>
                                            <th>Bank Branch</th>
                                            <th>Check Number</th>
                                            <th>Check Amount</th>
                                            <th>Check Date</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3">Total</th>
                                            <th>0.00</th>
                                            <th colspan="2"></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-payment">
                    <span class="fas fa-edit"></span> Update
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Cancel
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Edit Modal -->
