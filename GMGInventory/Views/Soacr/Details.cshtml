                        <label for="payment-remarks" class="control-label mb-0">Remarks</label>
                    </div>
                    <div class="col-12 col-lg-9">
                        <input type="text" name="Remarks" id="payment-remarks" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="row align-items-center form-group">
                    <div class="col-4 col-lg-3">
                        <label for="payment-over-payment" class="control-label mb-0">Over Payment</label>
                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="OverPayment" id="payment-over-payment" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4 col-lg-3">
                        <label for="payment-tkt" class="control-label mb-0 d-block">TKT/ Solicitation</label>
                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="TKT" id="payment-tkt" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="row align-items-center form-group">
                    <div class="col-4 col-lg-3">
                        <label for="payment-tax" class="control-label mb-0">Tax</label>
                    </div>
                    <div class="col-8 col-lg-3">
                        <input type="number" step="0.01" min="0" max="1999999.99" name="TAX" id="payment-tax" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4 col-lg-3">
