@model SoacrVM

@{
	ViewData["Title"] = "SOACr Details";
}
@section Breadcrumb {
	<li class="breadcrumb-item"><a asp-controller="Soacr" asp-action="Index">Soacr</a></li>
}

<div class="card card-default">
   <div class="card-header">
			<span class="card-title">@ViewData["Title"]</span>
			<div class="card-tools"> 
			<a class="btn btn-light btn-sm float-right ml-2" asp-action="Index">
				<span class="fas fa-arrow-left"></span> Back to List
			</a>
		  
			<button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
				<span class="fas fa-print"></span> Print
			</button>
			@if (Model?.Type == "Counter Receipt")
			{
				@*<button type="button" class="btn btn-primary btn-sm float-right createInvoiceBtn ml-2" data-bs-toggle="modal" data-bs-target="#createInvoiceModal">
					<span class="fas fa-file-alt"></span> Add Invoice
				</button>*@

				<a class="btn btn-primary btn-sm float-right ml-2" asp-action="AddInvoice" asp-route-id = "@Model.Id" asp-route-custId="@Model.CustomerId">
					<span class="fas fa-plus"></span> Add Invoice
				 </a>
			}
			

			<button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
				<span class="fas fa-file-alt"></span> Add Payment
			</button>
			</div>
	</div>
	 <div class="card-body">
		<div class="row">
			<div class="col-md-4">
				<p class="text-sm">
					<span class="text-muted">
						@Html.DisplayNameFor(model => model.Id)
					</span>
					<b class="d-block">
						@Model?.Id
					</b>
				</p>
				<p class="text-sm">
					<span class="text-muted">
						@Html.DisplayNameFor(model => model.CustomerName)
					</span>
					<b class="d-block">
						@Model?.CustomerName
					</b>
				</p>

				<p class="text-sm">
					<span class="text-muted">
						@Html.DisplayNameFor(model => model.Type)
					</span>
					<b class="d-block SoacrType">
						@Model?.Type
					</b>
				</p>
				
			  </div>
		</div>
	</div>
	<div class="card-body">
		<table class="table table-head-fixed table-striped table-hover table-soa">
			<thead>
				<tr>

					<th>
						@Html.DisplayNameFor(model => model.InvoiceNumber)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.InvoiceAmount)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.TBR)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Credit)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Debit)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.PaidAmount)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.FreightCharge)
					</th>
					 <th>
						@Html.DisplayNameFor(model => model.Balance)
					</th>
					<th>

					</th>
					
				</tr>
			</thead>
		</table>
	</div>
</div>

<form id="deleteSoaLineItemForm" asp-action="Delete">
	<input type="hidden" id="deleteSoaLineItemId" name="Id"/>
	<input type="hidden" id="deleteSoaCrId" name="soacrId" value="@Model?.Id"/>
</form>

<form id="reactivateSoaLineItemForm" asp-action="Reactivate">
	<input type="hidden" id="reactivateSoaLineItemId" name="Id" />
</form>

