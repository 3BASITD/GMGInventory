    </div>
}
@if (userAccess.CanAdd)
{
    <!-- Add Invoice Modal   -->
    <div class="modal fade" id="addInvoiceModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Invoice</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-head-fixed table-striped table-hover table-invoice">
                        <thead>
                            <tr>
                                <th>
                                    <input class="chkclassaddinvoiceall" type="checkbox" />
                                </th>
                                <th>Invoice Date</th>
                                <th>Invoice Number</th>
                                <th>Invoice Type</th>
                                <th>Total Amount</th>
                            </tr>
                        </thead>
                    </table>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-add-selected-invoice">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        var soaDT = $('.table-soa').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetSOACRItemsJson", "Soacr")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                },
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.isPaid == false) {
                            actions += '<input class="chkclassinvoice" type="checkbox" value="' + data.invoiceId + '" />';
                        }
                        return actions;
                    }
                },
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "invoiceAmount", name: "InvoiceAmount", className: "text-end" },
                { data: "tbr", name: "TBR", className: "text-end" },
                { data: "credit", name: "Credit", className: "text-end" },
                { data: "debit", name: "Debit", className: "text-end" },
                { data: "paidAmount", name: "PaidAmount", className: "text-end" },
                { data: "freightCharge", name: "FreightCharge", className: "text-end" },
                { data: "balance", name: "Balance", className: "text-end" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.isPaid == false) {
                            if (user_access.canEdit) {
                                actions += '<button class="btn btn-info btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Invoice" data-microtip-position="top-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                            }
                            actions += '<button class="btn btn-warning btn-xs tbrBtn" data-bs-toggle="modal" data-bs-target="#tbrModal" data-microtip-title="TBR" data-microtip-position="top-left" role="tooltip"><i class="fas fa-exchange-alt"></i></button>';
                            if ($(".SoacrType").text().trim() == "Counter Receipt"/* && data.invoiceAmount == data.balance*/) {
                                if (user_access.canDelete) {
                                    actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete Invoice" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                                }
                            }
                            actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        }
                        return actions;
                    }
                }
            ],
            order: [[1, "desc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalDecimal(api, 3);
                columnDTTotalDecimal(api, 4);
                columnDTTotalDecimal(api, 5);
                columnDTTotalDecimal(api, 6);
                columnDTTotalDecimal(api, 7);
                columnDTTotalDecimal(api, 8);
                var baltotal = api.rows().data().reduce(function (a, b) {
                    return a + b.invoiceAmountD - b.tbrd - b.creditD + b.debitD - b.paidAmountD + b.freightChargeD;
                }, 0);
                $(api.column(9).footer()).html(FormatStringDecimal(Math.max(baltotal, 0)));
            }
        });

        soaDT.on("draw", function () {
            hideLoader();

            //$('.table-soa thead th').removeClass("text-end");

            $(".chkclassinvoiceall").prop("checked", false);
            $(".chkclassinvoiceall").prop("indeterminate", false);

            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = soaDT.row($(this).parents('tr')).data();
                    $("#edit-debit").data("id", data.id);
                    $("#edit-debit").val(data.debitD.toFixed(2));
                    $("#edit-credit").val(data.creditD.toFixed(2));
                    $("#edit-freight-cost").val(data.freightChargeD.toFixed(2));
                    $("#edit-frieght-waybill").val(data.frieghtWaybill);
                });
            }
            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete Invoice",
                        text: "Are you sure you want to delete this record?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn_clicked = $(this);
                            $.ajax({
                                type: "POST",
                                url: "@Url.Action("DeleteInvoiceJson")",
                                data: {
                                    Id: btn_clicked.data("id")
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Error") {
                                        toastr.error(data.message, "Error");
                                    } else {
                                        toastr.success(data.message, "Success");
                                        soaDT.row(btn_clicked.parents('tr')).remove().draw();
                                    }
                                }
                            });
                        }
                    });
                });
            }
            $(".chkclassinvoiceall").on("change", function () {
                soaDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    $(this.node()).find(".chkclassinvoice").prop("checked", $(".chkclassinvoiceall").prop("checked"));
                });
            });

            $(".chkclassinvoice").on("change", function () {
                var rows_checked = 0;
                soaDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if ($(this.node()).find(".chkclassinvoice").prop("checked")) {
                        rows_checked++;
                    }
                });

                if (rows_checked == 0) {
                    $(".chkclassinvoiceall").prop("checked", false);
                    $(".chkclassinvoiceall").prop("indeterminate", false);
                } else if (rows_checked == soaDT.rows().count()) {
                    $(".chkclassinvoiceall").prop("checked", true);
                    $(".chkclassinvoiceall").prop("indeterminate", false);
                } else if (rows_checked == 0) {
                    $(".chkclassinvoiceall").prop("checked", false);
                    $(".chkclassinvoiceall").prop("indeterminate", false);
                } else {
                    $(".chkclassinvoiceall").prop("checked", false);
                    $(".chkclassinvoiceall").prop("indeterminate", true);
                }
            });

            $(".tbrBtn").on("click", function () {
                var data = soaDT.row($(this).parents('tr')).data();
                $("#tbr-for").val(data.invoiceNumber);
                $("#tbr-for").data("id", data.id);
                $("#tbr-invoice").val("").trigger("change");
                $("#tbr-amount").val("0.00");
                $("#tbr-history-for").val(data.invoiceNumber);
                $("#tbr-history-for").data("id", data.id);
            });
        });

        // Validation for Edit Modal
        var validateEdit = $("#editForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Debit: { rangeForMasked: [0, 1999999.99] },
                Credit: { rangeForMasked: [0, 1999999.99] },
                FreightCost: { rangeForMasked: [0, 1999999.99] },
                //FreightWaybill: {
                //    required: function (element) {
                //        return $("#edit-freight-cost").val() != "" && removeCommaOfNumber($("#edit-freight-cost").val()) != 0;
                //    }
                //}
            },
            messages: {
                //FreightWaybill: { required: "Freight's Waybill is required" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoEdit();
            },
            showErrors: validateShowErrors
        });

        // Send Edit to Controller
        function DoEdit() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("EditInvoiceJson")",
                data: {
                    Id: $("#edit-debit").data("id"),
                    Debit: removeCommaOfNumber($("#edit-debit").val()),
                    Credit: removeCommaOfNumber($("#edit-credit").val()),
                    FreightCharge: removeCommaOfNumber($("#edit-freight-cost").val()),
                    FreightWaybill: $("#edit-frieght-waybill").val(),
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#editModal").modal("hide");
                        soaDT.ajax.reload();
                    }
                },
                complete: function (xhr, status) {
                }
            });
        }

        // Actions upon Display Payment Modal
        $(".paymentBtn").click(function (e) {
            if (GetInvoiceSelected().length == 0) {
                toastr.error("Please select atleast 1 invoice", "No Invoice Selected");
            } else {
                $("#payment-collector-receipt").val("");
                $("#payment-remarks").val("");
                $("#payment-over-payment").val("0.00");
                $("#payment-tkt").val("0.00");
                $("#payment-tax").val("0.00");
                $("#payment-cash-advanced").val("0.00");
                $("#payment-discount").val("0.00");
                $("#payment-offset").val("0.00");
                $("#payment-cash-amount").val("0.00");
                $("#payment-backload").val("0.00");
                ResetCheckPaymentForm();
                checkTable.clear().draw();
                $("#paymentModal").modal("show");
            }
        });

        $("#payment-collector-receipt").on("change", function () {
            if ($("#payment-collector-receipt").val() == "") {
                toastr.warning("Please enter collector receipt", "Required field &lt;Collector Receipt&gt;");
                $("#payment-collector-receipt").addClass("text-danger");
                $('span[data-valmsg-for="payment-collector-receipt"]').text("Please enter collector receipt");
            } else {
                //$.ajax({
                //    type: "POST",
                //    url: "@Url.Action("AddPaymentDetailsJson")",
                //    data: {
                //        CollectorReceiptNumber: $("#payment-collector-receipt").val()
                //    },
                //    success: function (data, status, xhr) {
                //        if (data.status == "Error") {
                //            toastr.error(data.message, "Error");
                //            $("#payment-collector-receipt").addClass("text-danger");
                //            $('span[data-valmsg-for="payment-collector-receipt"]').text(data.message);
                //        } else {
                $("#payment-collector-receipt").removeClass("text-danger");
                $('span[data-valmsg-for="payment-collector-receipt"]').text("");
                //        }
                //    }
                //});
            }
        });

        $(".btn-payment").on("click", function () {
            var checkData = GetChecks();
            if ($("#payment-collector-receipt").val() == "") {
                toastr.warning("Please enter collector receipt", "Required field &lt;Collection Receipt&gt;");
                $('span[data-valmsg-for="payment-collector-receipt"]').text("Please enter collector receipt");
            } else if ($("#payment-over-payment").val() == 0 && $("#payment-tkt").val() == 0
                && $("#payment-tax").val() == 0 && $("#payment-cash-advanced").val() == 0
                && $("#payment-discount").val() == 0 && $("#payment-offset").val() == 0
                && $("#payment-cash-amount").val() == 0 && $("#payment-backload").val() == 0
                && checkData.length == 0) {
                toastr.warning("Please enter atleast 1 amount/check", "No amount available");
            } else {
                $('span[data-valmsg-for="payment-collector-receipt"]').text("");
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddPaymentDetailsJson")",
                    data: {
                        SOACRId: @Model?.Id,
                        CollectorReceiptNumber: $("#payment-collector-receipt").val(),
                        Remarks: $("#payment-remarks").val(),
                        OverPayment: removeCommaOfNumber($("#payment-over-payment").val()),
                        TKTSolicitation: removeCommaOfNumber($("#payment-tkt").val()),
                        Tax: removeCommaOfNumber($("#payment-tax").val()),
                        CashAdvance: removeCommaOfNumber($("#payment-cash-advanced").val()),
                        Discount: removeCommaOfNumber($("#payment-discount").val()),
                        Offset: removeCommaOfNumber($("#payment-offset").val()),
                        CashAmount: removeCommaOfNumber($("#payment-cash-amount").val()),
                        BackLoad: removeCommaOfNumber($("#payment-backload").val()),
                        Checks: checkData,
                        InvoiceIds: GetInvoiceSelected()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#paymentModal").modal("hide");
                            soaDT.ajax.reload();
                        }
                    }
                });
            }
        });

        tbrselect();
        function tbrselect() {
            //if ($('#tbr-invoice').hasClass("select2-hidden-accessible")){
            //    $("#tbr-invoice").destroy();
            //}
            $("#tbr-invoice").select2().empty();
            $("#tbr-invoice").select2({
                ajax: {
                    url: "@Url.Action("GetInvoiceTBR")",
                    dataType: 'json',
                    type: "POST",
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1,
                            CustomerId: @Model?.CustomerId
                            };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    //cache: true
                },
                dropdownParent: $("#tbrModal")
            });

            $("#tbr-invoice").on("select2:select", function () {
                //$("#tbr-amount").val(FormatStringDecimal($(this).select2("data")[0].invoiceAmount.toFixed(2)));
                $("#tbr-amount").val($(this).select2("data")[0].invoiceAmount.toFixed(2));
                $("#tbr-amount-max").val($(this).select2("data")[0].invoiceAmount.toFixed(2));
            });

            $("#tbr-invoice").on("select2:unselecting", function (e) {
                $("#tbr-amount").val("0.00");
                $("#tbr-amount-max").val("0.00");
            });
        }

        // Validation for TBR Modal
        var validateTBR = $("#tbrForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                InvoiceNumber: { required: true },
                Amount: {
                    required: true, isNotZero: true, lessThanOrEqual: "#tbr-amount-max"
                }
            },
            messages: {
                InvoiceNumber: { required: "Please select an Invoice Number" },
                Amount: { required: "Amount is required", isNotZero: "Amount cannot be 0", lessThanOrEqual: function () { return "Cannot exceed invoice amount " + FormatStringDecimal($("#tbr-amount-max").val()); } }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoTBR();
            },
            showErrors: validateShowErrors
        });

        // Send TBR to Controller
        function DoTBR() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("AddInvoiceTBR")",
                data: {
                    soaLineItemId: $("#tbr-for").data("id"),
                    salesReturnId: $("#tbr-invoice").val(),
                    amount: removeCommaOfNumber($("#tbr-amount").val())
                },
                success: function (data, status, xhr) {
                    toastr.success(data.message, "Success");
                    tbrselect();
                    $("#tbrModal").modal("hide");
                    soaDT.ajax.reload();
                },
                complete: function (xhr, status) {
                }
            });
        }

        $(".btnTBRHistory").on("click", function () {
            tbrHistoryDT.ajax.reload();
            $("#tbrModal").modal("hide");
            $("#tbrHistoryModal").modal("show");
        });

        $("#tbrHistoryModal").on("hide.bs.modal", function () {
            $("#tbr-invoice").val("").trigger("change");
            $("#tbr-amount").val("0.00");
            $("#tbrModal").modal("show");
        });

        var tbrHistoryDT = $('.table-tbr-history').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetInvoiceTBRHistory")",
                data: function (data) {
                    data.soaLineItemId = $("#tbr-history-for").data("id");
                },
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            columns: [
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "amount", name: "Amount", className: "text-end" },
                { data: "userCreated", name: "UserCreated" },
                { data: "dateCreated", name: "DateCreated" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalDecimal(api, 1);
            },
            order: [[3, "desc"]]
        });

        // Load functions upon DataTable load
        tbrHistoryDT.on("draw", function () {
            hideLoader();
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            setTimeout(function () {
                var printLink = "";
                if ($(".SoacrType").text().trim() == "Statement of Account") {
                    printLink = '@Url.Action("PrintSOADetails")/@Model?.Id';
                }
                else if ($(".SoacrType").text().trim() == "Counter Receipt") {
                    printLink = '@Url.Action("PrintCRDetails")/@Model?.Id';
                }
                let win = window.open(printLink, '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });

        function GetInvoiceSelected() {
            var invoice_selected = [];
            soaDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var invlist = $(this.node()).find(".chkclassinvoice");
                if (invlist.prop("checked")) {
                    invoice_selected.push(invlist.val());
                }
            });
            return invoice_selected;
        }

        var checkTable = $('.table-check').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            columns: [
                { data: "BankName", name: "BankName" },
                { data: "BankBranch", name: "BankBranch" },
                { data: "CheckNumber", name: "CheckNumber" },
                { data: "CheckAmount", name: "CheckAmount", className: "text-end" },
                { data: "CheckDate", name: "CheckDate" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (user_access.canEdit) {
                            actions += '<button class="btn btn-danger btn-xs btn-remove-check" data-microtip-title="Remove Check" data-microtip-position="top-left" role="tooltip"><i class="fas fa-trash"></i></button>';
                        }
                        return actions;
                    }
                }
            ],
            order: [[4, "desc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalDecimal(api, 3);
            }
        });

        checkTable.on("draw", function () {
            hideLoader();
            if (user_access.canEdit) {
                $(".btn-remove-check").on("click", function () {
                    checkTable.row($(this).parents('tr')).remove().draw();
                });
            }
        });

        // Validation for Check Modal
        var validateCheck = $("#checkForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                BankName: { required: true, maxlength: 100 },
                CheckDate: { required: true },
                CheckAmount: { required: true, rangeForMasked: [0.01, 1999999.99] },
                BankBranch: { required: true, maxlength: 100 },
                CheckNumber: { required: true, maxlength: 50 }
            },
            messages: {
                BankName: { required: "Please enter Bank Name", maxlength: "Bank Name must not exceed 100 characters." },
                CheckDate: { required: "Please enter Check Date" },
                CheckAmount: { required: "Please enter Check Amount", rangeForMasked: "Check Amount must be between 0.01-1999999.99." },
                BankBranch: { required: "Please enter Bank Branch", maxlength: "Bank Branch must not exceed 100 characters." },
                CheckNumber: { required: "Please enter Check Number", maxlength: "Check Number must not exceed 50 characters." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoAddCheck();
            },
            showErrors: validateShowErrors
        });

        // Send Add Check to Controller
        function DoAddCheck() {
            $('span[data-valmsg-for="check-checknumber"]').text("");
            $("#check-checknumber").removeClass("text-danger text-xs");
            $.ajax({
                type: "POST",
                url: "@Url.Action("CheckCheckNumberJson")",
                data: {
                    CheckNumber: $("#check-checknumber").val()
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.warning("Check Number already in use in other payment", "Required field &lt;Check Number&gt;");
                        $('span[data-valmsg-for="check-checknumber"]').text("Check Number already in use in other payment");
                        $("#check-checknumber").addClass("text-danger text-xs");
                    } else {
                        var checkDuplicateNumber = false;
                        checkTable.rows().every(function (rowIdx, tableLoop, rowLoop) {
                            if (this.data().CheckNumber == $("#check-checknumber").val()) { checkDuplicateNumber = true; }
                            $("#check-checknumber").addClass("text-danger text-xs");
                        });
                        if (checkDuplicateNumber) {
                            toastr.warning("Duplicate Check Number", "Required field &lt;Check Number&gt;");
                            $('span[data-valmsg-for="check-checknumber"]').text("Duplicate Check Number");
                        } else {
                            var invoiceForm = {
                                BankName: $("#check-bankname").val(),
                                CheckDate: $("#check-checkdate").val(),
                                CheckAmount: $("#check-checkamount").val(),
                                BankBranch: $("#check-bankbranch").val(),
                                CheckNumber: $("#check-checknumber").val()
                            };
                            checkTable.row.add(invoiceForm).draw();
                            ResetCheckPaymentForm();
                        }
                    }
                }
            });
        }

        $(".btnClearCheck").on("click", ResetCheckPaymentForm);

        function ResetCheckPaymentForm() {
            $("#check-bankname").val("");
            $("#check-checkdate").val(DateForInput(new Date()));
            $("#check-checkamount").val("0.00");
            $("#check-bankbranch").val("");
            $("#check-checknumber").val("");
            $('span[data-valmsg-for="check-checknumber"]').text("");
            $("#check-checknumber").removeClass("text-danger text-xs");
            validateCheck.resetForm();
        }

        function GetChecks() {
            var checks = [];
            checkTable.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                checks.push({
                    BankName: row_data.BankName,
                    CheckDate: row_data.CheckDate,
                    CheckAmount: removeCommaOfNumber(row_data.CheckAmount),
                    BankBranch: row_data.BankBranch,
                    CheckNumber: row_data.CheckNumber
                });
            });
            return checks;
        }

        if (user_access.canAdd) {
            $(".btn-add-invoice").on("click", function () {
                invoiceDT.ajax.reload();
                $("#addInvoiceModal").modal("show");
            });
        }

        var invoiceDT = $('.table-invoice').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetCustomerInvoiceToAddDT")",
                data: function (data) {
                    data.Id = @Model?.CustomerId;
                },
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<input class="chkclassaddinvoice" type="checkbox" value="' + data.id + '" />';
                        return actions;
                    }
                },
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "invoiceType", name: "InvoiceType" },
                { data: "totalAmount", name: "TotalAmount", className: "text-end" }
            ],
            order: [[1, "desc"]]
        });

        // Load functions upon DataTable load
        invoiceDT.on("draw", function () {
            hideLoader();

            $(".chkclassaddinvoiceall").on("change", function () {
                invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    $(this.node()).find(".chkclassaddinvoice").prop("checked", $(".chkclassaddinvoiceall").prop("checked"));
                });
            });

            $(".chkclassaddinvoice").on("change", function () {
                var rows_checked = 0;
                invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if ($(this.node()).find(".chkclassaddinvoice").prop("checked")) {
                        rows_checked++;
                    }
                });

                if (rows_checked == 0) {
                    $(".chkclassaddinvoiceall").prop("checked", false);
                    $(".chkclassaddinvoiceall").prop("indeterminate", false);
                } else if (rows_checked == invoiceDT.rows().count()) {
                    $(".chkclassaddinvoiceall").prop("checked", true);
                    $(".chkclassaddinvoiceall").prop("indeterminate", false);
                } else if (rows_checked == 0) {
                    $(".chkclassaddinvoiceall").prop("checked", false);
                    $(".chkclassaddinvoiceall").prop("indeterminate", false);
                } else {
                    $(".chkclassaddinvoiceall").prop("checked", false);
                    $(".chkclassaddinvoiceall").prop("indeterminate", true);
                }
            });
        });
        if (user_access.canAdd) {
           $(".btn-add-selected-invoice").on("click", function () {
            var invoiceIds = [];
            invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var invlist = $(this.node()).find(".chkclassaddinvoice");
                if (invlist.prop("checked")) {
                    invoiceIds.push(invlist.val());
                }
            });

            $.ajax({
                type: "POST",
                url: "@Url.Action("AddInvoices")",
                data: {
                    soaId: @Model?.Id,
                    invoiceIds: invoiceIds
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#addInvoiceModal").modal("hide");
                        soaDT.ajax.reload();
                        hideLoader();
                    }
                }
            });
        });
        }
    </script>
	}


