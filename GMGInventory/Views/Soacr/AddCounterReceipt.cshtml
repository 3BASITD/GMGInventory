@section Scripts {
    <script>
        // Load Select2 for Customer
        $("#filter-customer").select2({
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
        });

        $("#filter-customer").on("select2:select", function () {
            $("#filter-customer-name").val($(this).select2("data")[0].name);
        });

        $("#filter-customer").on("select2:unselecting", function (e) {
            $("#filter-customer-name").val("");
        });

        var invoiceDT = $('.table-invoice').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetCustomerInvoiceToAddDT")",
                type: "POST",
                data: function (data) {
                    data.Id = $("#filter-customer").val();
                }
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            //search: {
            //    return: true,
            //},
            columns: [
                {
                    orderable: false,
                    width: "120px",
                data: function (data, type, dataToSet) {
                    var actions = '';
                        actions += '<input class="chkclassinvoice" type="checkbox" value="' + data.id + '" />';
                    return actions;
                }
            },
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "invoiceType", name: "InvoiceType" },
                { data: "totalAmount", name: "TotalAmount", className: "text-end" }
            ],
            //lengthMenu: [
            //    [-1, 10, 25, 50],
            //    ['All', 10, 25, 50],
            //],
            order: [[1, 'desc']]
        });

        invoiceDT.on("init.dt", function () {
            hideLoader();
        });




        //// Load List on DataTable
        //var invoiceDT = $('.table').on('preXhr.dt', function (e, settings, data) {
        //    showLoader();
        //}).DataTable({
        //    columnDefs: [
        //        {
        //            orderable: false,
        //            width: "120px",
        //            targets: 0
        //        },
        //        {
        //            type: "date-g",
        //            targets: 1
        //        }
        //    ],
        //    lengthMenu: [
        //        [10, 25, 50, -1],
        //        [10, 25, 50, 'All'],
        //    ]

        //});
        ///////////////////////////////////////////////////////////////////////////
        function dtCheckboxes() {
            $(".chkclassinvoiceall").on("change", function () {
                invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    $(this.node()).find(".chkclassinvoice").prop("checked", $(".chkclassinvoiceall").prop("checked"));
                });
            });


            $(".chkclassinvoice").on("change", function () {
                var rows_checked = 0;
                invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if ($(this.node()).find(".chkclassinvoice").prop("checked")) {
                        rows_checked++;
                    }
                });

                if (rows_checked == 0) {
                    $(".chkclassinvoiceall").prop("checked", false);
                    $(".chkclassinvoiceall").prop("indeterminate", false);
                } else if (rows_checked == invoiceDT.rows().count()) {
                    $(".chkclassinvoiceall").prop("checked", true);
                    $(".chkclassinvoiceall").prop("indeterminate", false);
                } else if (rows_checked == 0) {
                    $(".chkclassinvoiceall").prop("checked", false);
                    $(".chkclassinvoiceall").prop("indeterminate", false);
                } else {
                    $(".chkclassinvoiceall").prop("checked", false);
                    $(".chkclassinvoiceall").prop("indeterminate", true);
                }
            });
        }

        dtCheckboxes();
        invoiceDT.on("draw", dtCheckboxes);

        ///////////////////////////////////////////////////////////////////////////
        // Load functions upon DataTable load
        //invoiceDT.on("draw", function () {
        //    hideLoader();

        //    DatatablesSearchOnEnter('.table', invoiceDT);

        //    //LoadFilterSelect2();

        //});


        //$(".btnFilter").on("click", function () {
        $("#filter-customer").on("change", function() {

            invoiceDT.ajax.reload();
            //var customerId = $("#filter-customer").val();


            //$("#filterModal").modal("hide");
            ////location.hash = $("#filter-customer").val();
            ////var hash = location.hash.replace(/^#/, '');

            //window.location = window.location.origin + '/Soacr/AddCounterReceipt/' + customerId;
        });

        
        $(".btn-add").click(function (e) {
            if ($("#filter-customer").val() == "") {
                toastrNoDuplicate("Please select a customer first", "Customer", "warning");
            } else {
                var invoiceIds = [];

                invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var invlist = $(this.node()).find(".chkclassinvoice");
                    if (invlist.prop("checked")) {
                        invoiceIds.push(invlist.val());
                    }
                });

                if (invoiceIds.length == 0) {
                    toastrNoDuplicate("Please select atleast 1 invoice", "No Invoice Selected", "error");
                } else {
                    $.ajax({
                        type: "POST",
                        //url: "@Url.Action("CreateJsonCR")",
                        url: "@Url.Action("CreateCRJson")",
                        data: {
                            InvoiceIds: invoiceIds,
                            CustomerId: $("#filter-customer").val()

                            },
                        error: jQueryCommonError,
                        success: function (data, status, xhr) {
                            //if (data.status == "Error") {
                            //    toastrNoDuplicate(data.message, "Error", "error");
                            //} else {
                                toastrNoDuplicate(data.message, "Success", "success");
                                hideLoader();
                                window.location = '@Url.Action("Details")/' + data.newRow;
                            //}
                        }
                    });
                }
            }
        });

    </script>
}

