@model SoaDetailsPVM

@{
    ViewData["Title"] = "Add Invoice";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Soacr" asp-action="Index">SOA / Counter Receipt</a></li>
    <li class="breadcrumb-item"><a asp-controller="Soacr" asp-action="Details" asp-route-id="@Model?.Id">SOACr Details</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light float-right ml-2" asp-action="Details" asp-route-id="@Model?.Id">
                <span class="fas fa-arrow-left"></span> Back to Details
            </a>
            <button type="button" class="btn btn-primary btn-add">
                <span class="fas fa-plus"></span> Add
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover">
            <thead>
                <tr>
                    <th>
                        <input class="chkclassinvoiceall" type="checkbox" style="min-width: 100px;" />
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().InvoiceDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().InvoiceNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().InvoiceType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().TotalAmount)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Contents)
                {
                    <tr>
                        <td>
                            <input class="chkclassinvoice" type="checkbox" data-id="@item.Id" />
                        </td>
                        <td>@item.InvoiceDate</td>
                        <td>@item.InvoiceNumber</td>
                        <td>@item.InvoiceType</td>
                        <td>@item.TotalAmount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



@section Scripts {
    <script>
        var invoiceDT = $('.table').DataTable({
            columnDefs: [
                {
                    orderable: false,
                    width: "120px",
                    targets: 0
                },
                {
                    type: "date-g",
                    targets: 1
                }
            ],
            lengthMenu: [
                [10, 25, 50, -1],
                [10, 25, 50, 'All'],
            ]
        });

        function dtCheckboxes() {
            $(".chkclassinvoiceall").on("change", function () {
                invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    $(this.node()).find(".chkclassinvoice").prop("checked", $(".chkclassinvoiceall").prop("checked"));
                });
            });


            $(".chkclassinvoice").on("change", function () {
                var rows_checked = 0;
                invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if ($(this.node()).find(".chkclassinvoice").prop("checked")) {
                        rows_checked++;
                    }

                    if (rows_checked == 0) {
                        $(".chkclassinvoiceall").prop("checked", false);
                        $(".chkclassinvoiceall").prop("indeterminate", false);
                    } else if (rows_checked == invoiceDT.rows().count()) {
                        $(".chkclassinvoiceall").prop("checked", true);
                        $(".chkclassinvoiceall").prop("indeterminate", false);
                    } else if (rows_checked == 0) {
                        $(".chkclassinvoiceall").prop("checked", false);
                        $(".chkclassinvoiceall").prop("indeterminate", false);
                    } else {
                        $(".chkclassinvoiceall").prop("checked", false);
                        $(".chkclassinvoiceall").prop("indeterminate", true);
                    }
                });
            });
        }

        dtCheckboxes();
        invoiceDT.on("draw", dtCheckboxes);

        $(".btn-add").click(function (e) {

            var invoiceIds = [];

            invoiceDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var invlist = $(this.node()).find(".chkclassinvoice");
                if (invlist.prop("checked")) {
                    invoiceIds.push(invlist.data("id"));
                }

            });

            $.ajax({
                type: "POST",
                url: "@Url.Action("AddInvoices")",
                data: {
                    soaId: @Model?.Id,
                    invoiceIds: invoiceIds

                },
                error: jQueryCommonError,
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastrNoDuplicate(data.message, "Error", "error");
                    } else {
                        toastrNoDuplicate(data.message, "Success", "success");
                        hideLoader();
                        window.location = '@Url.Action("Details", "Soacr")/' + @Model?.Id;
                    }
                }
            });

        });


    </script>
}

