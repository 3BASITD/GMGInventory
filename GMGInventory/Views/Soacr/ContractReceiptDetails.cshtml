@model InvoiceVM

@{
    ViewData["Title"] = "Contract Receipt Details";
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-4">
                
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Id)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Id
                    </b>
                </p>
                <p class="text-sm">
                    <label for="item-code" class="text-muted fw-normal mb-0">
                        @Html.DisplayNameFor(model => model.InvoiceNumber)
                    </label>
                        <select id="item-code" class="s2-bold s2ph-bold s2ph-dark" style="width: 100%;">
                    </select>
                    @*<span class="text-muted">
                        @Html.DisplayNameFor(model => model.Code)
                    </span>
                    <b class="d-block">
                        @Model?.Code
                    </b>*@
                </p>

                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Customer)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Customer
                    </b>
                </p>
              
            </div>
 
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-danger card-tabs">
                    <div class="card-header p-0 pt-1 pl-2 pr-2">
                        <ul class="nav nav-tabs nav-fill" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="nav-warehouse-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-warehouse"
                                   aria-controls="nav-warehouse" aria-selected="true">
                                    @*<br />Warehouse Details*@
                                </a>
                            </li>
                           
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-warehouse" role="tabpanel"
                                 aria-labelledby="nav-warehouse-tab">
                                <table class="table table-head-fixed table-striped table-hover table-warehouse">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Invoice No</th>
                                            <th>Invoice Amount</th>
                                            <th>TBR Amount</th>
                                            <th>Credit Amount</th>
                                            <th>Debit Amount</th>
                                            <th>Total Amount Paid</th>
                                            <th>Freight Cost</th>
                                            <th>Balance</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    
                                </table>
                            </div>
                         
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Quantity Modal -->
<div class="modal fade" id="quantityModal" role="dialog" aria-labelledby="quantityModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Invoice</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="quantityForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="quantity-warehouse" class="control-label mb-0 d-block">TBR</label>
                                <input type="text" name="Warehouse" id="quantity-warehouse" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="quantity-warehouse" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="quantity-current" class="control-label mb-0 d-block">Debit</label>
                                <input type="number" step="1" min="0" max="1999999" name="Current" id="quantity-current" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="quantity-current" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="quantity-new" class="control-label mb-0 d-block">Credit</label>
                                <input type="number" step="1" min="0" max="1999999" name="New" id="quantity-new" class="form-control form-control-sm" />
                                <span data-valmsg-for="quantity-new" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="quantity-remarks" class="control-label mb-0 d-block">Freight Cost</label>
                                <textarea rows="2" name="Remarks" id="quantity-remarks" class="form-control form-control-sm">

                                </textarea>
                                <span data-valmsg-for="quantity-remarks" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" id="quantity-id" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-edit"></span> Update
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $("#item-code").select2({
            minimumInputLength: 1,
            placeholder: '@Model?.InvoiceNumber',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Invoice")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });

        $("#item-code").on("select2:select", function () {
            window.location = window.location.href.replace("@Model?.Id",$("#item-code").val());
        });

        $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function(e) {
            var selectedTab = e.currentTarget.dataset.bsTarget;
            if (selectedTab == "#nav-warehouse") warehouseDT.ajax.reload();
        });

        // Warehouse Details
        var warehouseDT = $('.table-warehouse').on('preXhr.dt', function(e, settings, data) {
            ShowTabLoader("warehouse");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetContractReceiptDetailsJson", "Soacr")",
                type: "POST",
                data: function(data) {
                    data.Id = @Model?.Id;
                }
            },
            searchDelay: 1000,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-warehouse" data-microtip-title="Remove Item" data-microtip-position="left" role="tooltip"><i class="fas fa-minus"></i></button>';
                        return actions;
                    }
                },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "totalAmount", name: "TotalAmount" },
                { data: "tbr", name: "TBR" },
                { data: "credit", name: "Credit" },
                { data: "debit", name: "Debit" },
                { data: "paidAmount", name: "PaidAmount" },
                { data: "freightCharge", name: "FreightCharge" },
                { data: "balance", name: "Balance" },
                {
                    orderable: false,
                    data: function(data, type, dataToSet) {
                        var actions = '';
                        actions += '<div data-microtip-title="Edit" data-microtip-position="left" role="tooltip" class="d-inline-block"><button class="btn btn-warning btn-xs quantityBtn" data-bs-toggle="modal" data-bs-target="#quantityModal"><i class="fas fa-pencil-alt"></i></button></div>';
                        return actions;
                    }
                }
            ],
            order: [[0, "asc"]]
        }).on("draw.dt", function () {

            HideTabLoader("warehouse");

            DatatablesSearchOnEnter('.table-warehouse', warehouseDT);

            $(".btn-remove-warehouse").on("click", function () {
                warehouseDT.row($(this).parents('tr')).remove().draw();
            });
            $(".table-warehouse thead th").removeClass("form-cell");
            $(".table-warehouse thead th").removeClass("text-end");
            //$(".table-item th").removeClass("netprice");

            // Actions upon Display Edit Quantity Modal
            $(".quantityBtn").click(function(e) {
                var data = warehouseDT.row($(this).parents('tr')).data();
                validateEdit.hideThese(validateEdit.errors());
                $("#quantity-warehouse").val(data.name);
                $("#quantity-current").val(data.quantity);
                $("#quantity-new").val(data.quantity);
                $("#quantity-remarks").val("");
                $("#quantity-id").val(data.id);
            });
        });

        // Validation for Edit Quantity Modal
        var validateEdit = $("#quantityForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                New: {
                    required: true,
                    notEqualTo: "#quantity-current"
                }
            },
            messages: {
                New: {
                    required: "Please enter new quantity.",
                    notEqualTo: "Equal quantity. No change will be done."
                }
            },
            submitHandler: function(form) {
                DoQuantity();
                return false;
            }
        });

        // Send Quantity to Controller
        function DoQuantity() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("EditDetailQuantity")",
                data: {
                    Id: $("#quantity-id").val(),
                    Quantity: $("#quantity-new").val(),
                    Remarks: $("#quantity-remarks").val()
                },
                error: jQueryCommonError,
                success: function(data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#quantityModal").modal("hide");
                        warehouseDT.ajax.reload();
                    }
                }
            });
        }

      
    </script>
}