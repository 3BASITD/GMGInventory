@model SOACRInvoicesPVM

@{
    Layout = "";
    var title = "Invoices";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Date From:</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Data To:</strong>
        <span>@Model.DateTo</span>
        <br />
        <strong>Customer:</strong>
        <span>@Model.Customer</span>
        <br />
        <strong>Agent:</strong>
        <span>@Model.Agent</span>
        <br />
        <table class="table-items">
            <thead>
                <tr>

                    <th>
                        @Html.DisplayNameFor(model => model.Invoices.First().InvoiceDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Invoices.First().InvoiceNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Invoices.First().InvoiceType)
                    </th>
                    <th class="right-text">
                        @Html.DisplayNameFor(model => model.Invoices.First().TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Invoices.First().Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Invoices.First().Agent)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Invoices)
                {
                    <tr>
                        <td>@item.InvoiceDate</td>
                        <td>@item.InvoiceNumber</td>
                        <td>@item.InvoiceType</td>
                        <td class="right-text">@item.TotalAmount</td>
                        <td>@item.Customer</td>
                        <td>@item.Agent</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="right-text">Total</th>
                    <th class="right-text"><nobr>@Model.TotalAmount</nobr></th>
                    <th colspan="2" class="right-text"></th>
                </tr>
            </tfoot>
        </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = window.close;
</script>
</html>