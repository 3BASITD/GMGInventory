@model IEnumerable<SoacrVM>

@{
	ViewData["Title"] = "SOA/ CR";
}


<div class="card card-default">
	<div class="card-header">
		<span class="card-title">@ViewData["Title"]</span>
		<div class="card-tools">
			<button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
				<span class="fas fa-plus"></span> Generate SoA
			</button>
			<a class="btn btn-primary btn-sm float-right createContractBtn ml-2" asp-action="AddCounterReceipt">
				<span class="fas fa-plus"></span> Generate Counter Receipt
			</a>

			<a class="btn btn-primary btn-sm float-right createBtn ml-2" asp-action="Invoice">
				<span class="fas fa-file-alt"></span> Invoice
			</a>

	@*        <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
				<span class="fas fa-file-alt"></span> Filter
			</button>*@

		</div> 
	</div>
	<div class="card-body">
		<table class="table table-head-fixed table-striped table-hover table-soa">
			<thead>
				<tr>
					<th>
						@Html.DisplayNameFor(model => model.Id)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.CustomerName)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Type)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.SOAFrom)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.SOATo)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.TotalAmount)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.TBR)
					</th>
					 <th>
						@Html.DisplayNameFor(model => model.Credit)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Debit)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.PaidAmount)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.FreightCharge)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.Balance)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.OverPayment)
					</th>
					<th></th>
				</tr>
			</thead>
		</table>
	</div>
</div>


<!-- Create Modal -->
<div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
	<div class="modal-dialog modal-sm" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Generate Statement of Account</h5>
				<button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<form autocomplete="off" id="createForm">
				<div class="modal-body">
					<div class="row">
						<div class="col-md-12">
							<div class="form-group">
								<label for="create-customer" class="form-label mb-0">Customer Code</label>
								<select id="create-customer" style="width:100%">
								<option></option>
								</select>
							</div>
							<div class="form-group">
								<label for="create-customer-name" class="form-label mb-0">Agent</label>
								<input type="text" id="create-customer-name" class="form-control form-control-sm" readonly="readonly" />
							</div>
							<div class="form-group">
								<label for="create-dateFrom" class="control-label mb-0 d-block">Date From</label>
								<input type="date" name="dateFrom" id="create-dateFrom" class="form-control form-control-sm" />
								<span data-valmsg-for="create-dateFrom" data-valmsg-replace="true" class="text-danger"></span>
							</div>
							<div class="form-group">
								<label for="create-dateTo" class="control-label mb-0 d-block">Date To</label>
								<input type="date" name="dateTo" id="create-dateTo" class="form-control form-control-sm" />
								<span data-valmsg-for="create-dateTo" data-valmsg-replace="true" class="text-danger"></span>
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-primary">
						<span class="fas fa-plus"></span> Save
					</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						<span class="fas fa-times"></span> Cancel
					</button>
				</div>
			</form>
		</div>
	</div>
</div>




@section Scripts {
	<script>

		var loadfilterloaded = false;
		function LoadFilterSelect2() {
			if (loadfilterloaded) return;
			loadfilterloaded = true;

			// Load Select2 for Customer
			$("#create-customer").select2({
				minimumInputLength: 1,
				allowClear: true,
				placeholder: '<empty>',
				templateResult: function (repo) {
					if (repo.loading) {
						return repo.text;
					}
					return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.agent ? "<em class='fw-light text-secondary'> - " + repo.agent + "</em>" : ""));
				},
				ajax: {
					url: "@Url.Action("GetOptions", "Customer")",
					dataType: 'json',
					type: "POST",
					data: function (params) {
						return {
							search: params.term,
							page: params.page || 1
						};
					},
					processResults: function (data, params) {
						params.page = params.page || 1;
						return {
							results: data.items,
							pagination: {
								more: (params.page * 50) < data.total_count
							}
						};
					},
					cache: true
				},
				dropdownParent: $("#createModal")
			});

			$("#create-customer").on("select2:select", function () {
				$("#create-customer-name").val($(this).select2("data")[0].agent);
			});

			$("#create-customer").on("select2:unselecting", function (e) {
				$("#create-customer-name").val("");
			});
		}

		// Load List on DataTable
		var soaDT = $('.table-soa').on('preXhr.dt', function (e, settings, data) {
			showLoader();
		}).DataTable({
			ajax: {
				url: "@Url.Action("GetListJson")",
				data: function (data) {
					//var agentId = $("#filter-agent").val();
					//var customerId = $("#filter-customer").val();

					//if (agentId) data.AgentId = agentId;
					//if (customerId) data.CustomerId = customerId;

					//data.DateFrom = $("#filter-from").val();
					//data.DateTo = $("#filter-to").val();
				},
				type: "POST",
			},
			serverSide: true,
			filter: true,
			responsive: true,
			autoWidth: false,
			search: {
				return: true,
			},
			columns: [
				{ data: "id", name: "Id" },
				{ data: "customerName", name: "CustomerName" },
				{ data: "type", name: "Type" },
				{ data: "soaFrom", name: "SOAFrom" },
				{ data: "soaTo", name: "SOATo" },
				{ data: "totalAmount", name: "TotalAmount" },
				{ data: "tbr", name: "TBR" },
				{ data: "credit", name: "Credit" },
				{ data: "debit", name: "Debit" },
				{ data: "paidAmount", name: "PaidAmount" },
				{ data: "freightCharge", name: "FreightCharge" },
				{ data: "balance", name: "Balance" },
				{ data: "overPayment", name: "OverPayment" },
				{
					orderable: false,
					data: function(data, type, dataToSet) {
					  var actions = '<div class="btn-group" role="group">';
						actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
						return actions;
					}
				}
			],
			order: [[0, "desc"]]
		});

		
		// Load functions upon DataTable load
		soaDT.on("draw", function () {
			hideLoader();

			LoadFilterSelect2();

			$(".printBtn").on("click", function () {
			$.LoadingOverlay("show", {
				image: "",
				fontawesome: "fas fa-print"
			});
			var urlQuery = [];
			urlQuery.push("DateFrom=" + $("#filter-from").val());
			urlQuery.push("DateTo=" + $("#filter-to").val());
			if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
			if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
			setTimeout(function () {
				//let win = window.open('@Url.Action("PrintCRDetails")?' + urlQuery.join("&"), '');
				
				let win = window.open('@Url.Action("PrintInvoice")?', '');
				var wintimer = setInterval(function () {
					if (win.closed) {
						clearInterval(wintimer);
						hideLoader();
					}
				}, 100);
			}, 500);
			});



		});




		 // Actions upon Display Create Modal
		$(".createBtn").click(function(e) {
			$("#create-customer").prop("selectedIndex", 0).trigger("change");
			$("#create-agent").prop("selectedIndex", 0).trigger("change");
			$("#create-dateFrom").val("");
			$("#create-dateTo").val("");
		});

		// Validation for Create Modal
		var validateCreate = $("#createForm").validate({
			errorClass: 'text-danger text-xs',
			rules: {
				Code: { required: true, maxlength: 10 },
				Name: { required: true, maxlength: 100 },
				ContactPerson: { maxlength: 50 },
				ContactNumber: { maxlength: 50 },
				Email: { maxlength: 50 },
				Address: { required: true, maxlength: 50 },
				CreditLimit: { required: true, range: [0, 1999999.99] }
			},
			messages: {
				Code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
				Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
				ContactPerson: { maxlength: "Contact Person must not exceed 50 characters." },
				ContactNumber: { maxlength: "Contact Number number must not exceed 50 characters." },
				Email: { maxlength: "Email number must not exceed 50 characters." },
				Address: { required: "Please enter address.", maxlength: "Address must not exceed 50 characters." },
				CreditLimit: { required: "Please enter credit limit.", range: "Credit Limit must be between 0-1999999.99." }
				
			},
			submitHandler: function (form, event) {
				event.preventDefault();
				DoCreate();
			}
		});


		// Send Create to Controller
		function DoCreate() {
			$.ajax({
				type: "POST",
				url: "@Url.Action("CreateJson", "Soacr")",
				data: {
					CustomerId: $("#create-customer").val(),
					SOAFromD: $("#create-dateFrom").val(),
					SOAToD: $("#create-dateTo").val()
				},
				error: jQueryCommonError,
				success: function(data, status, xhr) {
					if (data.status == "Error") {
						toastr.error(data.message, "Error");
					} else {
						toastr.success(data.message, "Success");
						$("#createModal").modal("hide");
						soaDT.ajax.reload();
						hideLoader();
						console.log(data);
						window.location = '@Url.Action("Details")/' + data.newRow;
					}
				}
			});
		}

	</script>
 }