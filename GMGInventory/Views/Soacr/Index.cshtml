@model IEnumerable<SOACRVM>

@{
    ViewData["Title"] = "SOA / Counter Receipt";
}


<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right btn-generate-soa ml-2" data-bs-toggle="modal" data-bs-target="#generateSOA">
                <span class="fas fa-plus"></span> Generate SOA
            </button>
            <a class="btn btn-primary btn-sm float-right ml-2" asp-action="GenerateCR">
                <span class="fas fa-plus"></span> Generate Counter Receipt
            </a>
            <a class="btn btn-primary btn-sm float-right" asp-action="Invoice">
                <span class="fas fa-file-alt"></span> Invoice
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-soacr">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Id)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Type)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SOAFrom)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SOATo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TBR)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Credit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Debit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PaidAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FreightCharge)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Balance)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OverPayment)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>


<!-- Create Modal -->
<div class="modal fade" id="generateSOA" role="dialog" aria-labelledby="generateSOALabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Generate Statement of Account</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="generateSOAForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="soa-from" class="control-label mb-0 d-block">Date From</label>
                                <input type="date" name="DateFrom" id="soa-from" class="form-control form-control-sm" />
                                <span data-valmsg-for="soa-from" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="soa-to" class="control-label mb-0 d-block">Date To</label>
                                <input type="date" name="DateTo" id="soa-to" class="form-control form-control-sm" />
                                <span data-valmsg-for="soa-to" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="soa-customer" class="form-label mb-0">Customer Code</label>
                                <select id="soa-customer" name="Customer" style="width:100%">
                                    <option></option>
                                </select>
                                <span data-valmsg-for="soa-customer" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="soa-customer-name" class="form-label mb-0">Customer Name</label>
                                <input type="text" id="soa-customer-name" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="soa-agent" class="form-label mb-0">Agent Code</label>
                                <select id="soa-agent" name="Agent" style="width:100%">
                                    <option></option>
                                </select>
                                <span data-valmsg-for="soa-agent" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="soa-agent-name" class="form-label mb-0">Agent Name</label>
                                <input type="text" id="soa-agent-name" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-plus"></span> Save
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        // Load Select2 for Customer
        $("#soa-customer").select2({
            minimumInputLength: 0,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptionsWithOrder", "Customer")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#generateSOA")
        });

        $("#soa-customer").on("select2:select", function () {
            $("#soa-customer-name").val($(this).select2("data")[0].name);
            $("#soa-agent").val("").trigger("change");
        });

        $("#soa-customer").on("select2:unselecting", function (e) {
            $("#soa-customer-name").val("");
            $("#soa-agent").val("").trigger("change");
        });

        // Load Select2 for Agent
        $("#soa-agent").select2({
            minimumInputLength: 0,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptionsWithOrder", "Agent")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1,
                        CustomerId: $("#soa-customer").val(),
                        DateFrom: $("#soa-from").val(),
                        DateTo: $("#soa-to").val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#generateSOA")
        });

        $("#soa-agent").on("select2:select", function () {
            $("#soa-agent-name").val($(this).select2("data")[0].name);
        });

        $("#soa-agent").on("select2:unselecting", function (e) {
            $("#soa-agent-name").val("");
        });

        // Load List on DataTable
        var soacrDT = $('.table-soacr').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            stateSave: true,
            columns: [
                { data: "id", name: "Id" },
                { data: "customer", name: "Customer" },
                { data: "type", name: "Type" },
                { data: "soaFrom", name: "SOAFrom" },
                { data: "soaTo", name: "SOATo" },
                { data: "totalAmount", name: "TotalAmount", className: "text-end" },
                { data: "tbr", name: "TBR", className: "text-end" },
                { data: "credit", name: "Credit", className: "text-end" },
                { data: "debit", name: "Debit", className: "text-end" },
                { data: "paidAmount", name: "PaidAmount", className: "text-end" },
                { data: "freightCharge", name: "FreightCharge", className: "text-end" },
                { data: "balance", name: "Balance", className: "text-end" },
                { data: "overPayment", name: "OverPayment", className: "text-end" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                        return actions;
                    }
                }
            ],
            order: [[0, "desc"]]
        });

        // Load functions upon DataTable load
        soacrDT.on("draw", function () {
            hideLoader();

            //$(".printBtn").on("click", function () {
            //    $.LoadingOverlay("show", {
            //        image: "",
            //        fontawesome: "fas fa-print"
            //    });
            //    var urlQuery = [];
            //    urlQuery.push("DateFrom=" + $("#filter-from").val());
            //    urlQuery.push("DateTo=" + $("#filter-to").val());
            //    if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
            //    if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
            //    setTimeout(function () {
            //        //let win = window.open('@Url.Action("PrintCRDetails")?' + urlQuery.join("&"), '');

            //        let win = window.open('@Url.Action("PrintInvoice")?', '');
            //        var wintimer = setInterval(function () {
            //            if (win.closed) {
            //                clearInterval(wintimer);
            //                hideLoader();
            //            }
            //        }, 100);
            //    }, 500);
            //});
        });

        // Actions upon Display Generate SOA Modal
        $(".btn-generate-soa").click(function (e) {
            $("#soa-customer").val("").trigger("change");
            $("#soa-agent").val("").trigger("change");

            var dt_from = new Date();
            dt_from.setMonth(dt_from.getMonth() - 1);
            $("#soa-from").val(DateForInput(dt_from));
            $("#soa-to").val(DateForInput(new Date()));
        });

        // Validation for Generate SOA Modal
        var validateSOA = $("#generateSOAForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Customer: { required: true },
                Agent: { required: true },
                DateFrom: { required: true },
                DateTo: { required: true }
            },
            messages: {
                Code: { required: "Please select a customer." },
                Agent: { required: "Please select an agent." },
                DateFrom: { required: "Please select a date." },
                DateTo: { required: "Please select a date." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoGenerateSOA();
            },
            showErrors: validateShowErrors
        });


        // Send GenerateSOA to Controller
        function DoGenerateSOA() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GenerateSOAJson", "Soacr")",
                data: {
                    Customer: $("#soa-customer").val(),
                    Agent: $("#soa-agent").val(),
                    DateFrom: $("#soa-from").val(),
                    DateTo: $("#soa-to").val()
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#generateSOA").modal("hide");
                        soacrDT.ajax.reload();
                        hideLoader();
                        //window.location = '@Url.Action("Details")/' + data.newRow;
                    }
                }
            });
        }

    </script>
 }