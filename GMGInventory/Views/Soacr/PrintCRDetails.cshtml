@model SOACRDetailsPVM

@{
    Layout = "";
    var title = "Counter Receipt";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print_bas.css" asp-append-version="true" />
</head>
<body>
    <table class="table-items">
        <thead>
            <tr>
                <td colspan="6">
                    <div class="text-center">@title</div>
                </td>
            </tr>
            <tr>
                <td colspan="6">
                    <div class="text-center">@title</div>
                </td>
            </tr>
            <tr>
                <td colspan="6">
                    <div class="text-center">CR No. @Model.SOACRNumber</div>
                </td>
            </tr>
            <tr>
                <td colspan="6">
                    <span>Customer Code:</span>
                    <strong>@Model.CustomerCode</strong>
                    <span>Counter Receipt Date:</span>
                    <strong>@Model.DateFrom</strong>
                </td>
            </tr>
            <tr>
                <td colspan="6">
                    <span>Customer Name:</span>
                    <strong>@Model.CustomerName</strong>
                    <span>Date to be Collected:</span>
                    <strong>@Model.DateTo</strong>
                </td>
            </tr>
            <tr>
                <th>Invoice Date</th>
                <th>Invoice Number</th>
                <th>Trans Code</th>
                <th>Open Amount</th>
                <th>Freight Cost</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Contents)
            {
                <tr>
                    <td>@item.InvoiceDate2</td>
                    <td>@item.InvoiceNumber</td>
                    <td>@item.InvoiceType</td>
                    <td class="right-text">@item.InvoiceAmount</td>
                    <td class="right-text">@item.FreightCharge</td>
                    <td class="right-text">@item.Balance</td>
                </tr>
            }
            <tr>
                <th colspan="3" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalInvoiceAmount</nobr></th>
                <th class="right-text"><nobr>@Model.TotalFreightCost</nobr></th>
                <th class="right-text"><nobr>@Model.TotalBalance</nobr></th>
            </tr>
            <tr>
                <td colspan="6" class="signatory">
                    <div>
                        <span>
                            Authorized Signature
                        </span>
                        <span>
                            Received By
                        </span>
                    </div>
                </td>
            </tr>
        </tbody>
        <tfoot>
        </tfoot>
    </table>
    <p id="last-element-in-pub"> </p>
@* 
    <script src="https://unpkg.com/pagedjs/dist/paged.polyfill.js"></script> *@
    <script type="text/javascript">
        window.print();
        window.onafterprint = function () {
            setTimeout(function () {
                window.close();
            }, 100);
        };
    </script>
</body>
</html>