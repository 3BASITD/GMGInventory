@model IEnumerable<ReceptacleVM>

@{
    ViewData["Title"] = "Receptacles";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-receptacle">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PackNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Destination)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DeliveryDate)
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Packed Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Packed Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        // Load Select2 for Customer
        $("#filter-customer").select2({
            tags: true,
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            },
            dropdownParent: $("#filterModal")
        });

        $(".btnFilter").on("click", function () {
            receptacleDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        // Load List on DataTable
        var receptacleDT = $('.table-receptacle').on('preXhr.dt', function (e, settings, data) {
            //showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                data: function (data) {
                    var customerId = $("#filter-customer").val();
                    if (customerId) {
                        if ($("#filter-customer").select2("data")[0].name) {
                            data.CustomerId = customerId;
                        } else {
                            data.CustomerId = 0;
                            data.CustomerKeyword = customerId;
                        }
                    }
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "soNumber", name: "SONumber" },
                { data: "packNumber", name: "PackNumber" },
                { data: "customer", name: "Customer" },
                {
                    data: function (data, type, dataToSet) {
                        return data.destination == null ? "N/A" : data.destination;
                    },
                    name: "Destination"
                },
                { data: "deliveryDate", name: "DeliveryDate" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: [[1, "desc"]]
        });

        // Load functions upon DataTable load
        receptacleDT.on("draw", function () {
            //hideLoader();
            //$(".customer-name").text($("#filter-customer").select2("data")[0].name ?? "All");
        });
    </script>
    }