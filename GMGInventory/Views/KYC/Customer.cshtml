@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var kyc_details = @Html.Raw(Json.Serialize(Model));
        
        // Load customer data for select2
        $("#kyc-customer").select2({
            //minimumInputLength: 1,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2Simple", "Customer")",
                data: function (params) {
                    let base = $.fn.select2.defaults.defaults.ajax.data(params);
                    return Object.assign(base, {
                        ActiveOnly: false
                    });
                }
            }
        });

        $("#kyc-customer").on("select2:select", function () {
            window.location = window.location.origin + "/KYC/Customer/" + $("#kyc-customer").val();
        });
        
        if(kyc_details.customerId != 0 && kyc_details.customerName != "Invalid Customer") {
            var formChanged = false;

            var customerOption = new Option(kyc_details.customerCode, kyc_details.customerId, true, true);
            $("#kyc-customer").append(customerOption).trigger('change');

            $(document).on("change input", ".modify-checker", function () {
                if($(this).is(":radio")) {
                    $("input[name='" + this.name + "']").siblings("label").first().addClass("modified");
                } else {
                    $(this).addClass("modified");
                }
                formChanged = true;
            });

            $(".modify-checker-s2").on("select2:select", function () {
                $("#select2-" + $(this).attr("id") + "-container").addClass("modified");
                formChanged = true;
            });

            window.addEventListener("beforeunload", function (e) {
                if (!formChanged)
                     return;

                e.preventDefault();
                e.returnValue = "";
            });
            
            var checklistFields = [
                "birForm2303",
                "mayorBusinessPermit",
                "secDtiCertificate",
                "latestAuditedFinancialStatement",
                "incorporationArticleByLaws",
                "secretaryCertificate",
                "companyPortfolio",
                "signatoriesIdentificationCard",
                "sampleSalesInvoiceOfficialReceipt"
            ];

            var countChecklist = checklistFields.filter(s => kyc_details[s] != null).length;
            //if (countChecklist > 0) {
                $(".checklist-counter").removeClass("empty");
            // } else {
            //     $(".checklist-counter").addClass("empty");
            // }
            $(".checklist-counter-no").text(checklistFields.length - countChecklist);
            $(".checklist-counter-yes").text(countChecklist);

            $(document).on("change blur", ".date-requirement", function () {
                $(this).val($(this).val());
                if ($(this).val() != "") {
                    $("#" + this.id + "-yes").prop("checked", true);
                    $("#" + this.id + "-no").prop("checked", false);
                }
                
                var count = $("#checklist input[type=datetime-local]:filled").length;
                //if (count > 0) {
                    $(".checklist-counter").removeClass("empty");
                // } else {
                //     $(".checklist-counter").addClass("empty");
                // }
                $(".checklist-counter-no").text(checklistFields.length - count);
                $(".checklist-counter-yes").text(count);
            });

            $(document).on("change", ".date-not-required", function () {
                if ($(this).prop("checked")) {
                    $("#" + this.id.replace("-no", "")).val("");
                }
            });

            // Load Select2 Credit Term
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "CreditTerm")",
                success: function (data, status, xhr) {
                    $("#kyc-credit-term").select2({
                        ajax: null, //already fetched outside
                        data: data
                    });
                }
            });

            if (kyc_details.creditTermId) {
                var creditTermOption = new Option(kyc_details.creditTerm, kyc_details.creditTermId, true, true);
                $("#kyc-credit-term").append(creditTermOption).trigger('change');
            }

            var action_type = "";

            $("#form-save button[type=submit]").on("click", function () {
                action_type = $(this).data("action");
            });
            
            var validateSave = $("#form-save").validate({
                ignore: [],
                rules: {
                    Remarks: { minlength: 10, maxlength: 250 },
                    NameOfCompany: { required: true, maxlength: 50 },
                    RegisteredAddress: { required: true, maxlength: 300 },
                    OperatingAddress: { required: true, maxlength: 300 },
                    WarehouseAddress: { maxlength: 300 },
                    OperatingHours: { maxlength: 50 },
                    Website: { maxlength: 250 },
                    EmailAddress: { required: true, maxlength: 250 },
                    ContactNumber: { required: true, maxlength: 50 },
                    //OrganizationType: {},
                    SecDtiNumber: { required: true, maxlength: 50 },
                    BirTinNumber: { required: true, maxlength: 50 },
                    //VATStatus: {},
                    BusinessNature: { required: true, maxlength: 100 },
                    ProductServiceOffered: { required: true, maxlength: 100 },
                    CreditLineAmount: { required: true, range: [0, 1999999.99] },
                    CreditTerm: { required: true },
                    BIRForm23033: { required: function () { return $("#kyc-bir-form-yes").prop("checked") == true; } },
                    MayorBusinessPermit: { required: function () { return $("#kyc-business-permit-yes").prop("checked") == true; } },
                    SecDtiCertificate: { required: function () { return $("#kyc-secdti-certificate-yes").prop("checked") == true; } },
                    LatestAuditedFinancialStatement: { required: function () { return $("#kyc-audit-statement-yes").prop("checked") == true; } },
                    IncorporationArticleByLaws: { required: function () { return $("#kyc-article-bylaw-yes").prop("checked") == true; } },
                    SecretaryCertificate: { required: function () { return $("#kyc-secretary-certificate-yes").prop("checked") == true; } },
                    CompanyPortfolio: { required: function () { return $("#kyc-portfolio-yes").prop("checked") == true; } },
                    SignatoriesIdentificationCard: { required: function () { return $("#kyc-id-signatories-yes").prop("checked") == true; } },
                    SampleSalesInvoiceOfficialReceipt: { required: function () { return $("#kyc-sample-sior-yes").prop("checked") == true; } },
                    PrivacyConsent: { required: function () { return $("#kyc-consent-yes").prop("checked") == true; } }
                },
                messages: {
                    Remarks: { minlength: "Remarks must atleast 10 characters", maxlength: "Remarks must not exceed 250 characters" },
                    NameOfCompany: { required: "Please enter name of company", maxlength: "Name of company must not exceed 50 characters" },
                    RegisteredAddress: { required: "Please enter registered address", maxlength: "Registered address must not exceed 300 characters" },
                    OperatingAddress: { required: "Please enter operating address", maxlength: "Operating address must not exceed 300 characters" },
                    WarehouseAddress: { maxlength: "Warehouse address must not exceed 300 characters" },
                    OperatingHours: { maxlength: "Operating hours must not exceed 50 characters" },
                    Website: { maxlength: "Website / social media must not exceed 250 characters" },
                    EmailAddress: { required: "Please enter email address", maxlength: "Email address must not exceed 250 characters" },
                    ContactNumber: { required: "Please enter contact number", maxlength: "Contact number must not exceed 50 characters" },
                    //OrganizationType: {},
                    SecDtiNumber: { required: "Please enter sec / dti number", maxlength: "sec / dti number must not exceed 50 characters" },
                    BirTinNumber: { required: "Please enter bir tin number", maxlength: "bit tin number must not exceed 50 characters" },
                    //VATStatus: {},
                    BusinessNature: { required: "Please enter business nature", maxlength: "Business nature must not exceed 100 characters" },
                    ProductServiceOffered: { required: "Please enter product / service offered", maxlength: "Product / service offered must not exceed 100 characters" },
                    CreditLineAmount: { required: "Please enter credit line amount", range: "Credit line amount must be between 0-1999999.99" },
                    CreditTerm: { required: "Please select a credit term" },
                    BIRForm23033: { required: "Please enter expiration date of submitted bir form 2303" },
                    MayorBusinessPermit: { required: "Please enter expiration date of submitted mayor's / business permit" },
                    SecDtiCertificate: { required: "Please enter expiration date of submitted sec / dti certificate of registration" },
                    LatestAuditedFinancialStatement: { required: "Please enter expiration date of submitted latest audited financial statement" },
                    IncorporationArticleByLaws: { required: "Please enter expiration date of submitted articles of incorporation / by laws" },
                    SecretaryCertificate: { required: "Please enter expiration date of submitted secretary's certificate" },
                    CompanyPortfolio: { required: "Please enter expiration date of submitted company profile / portfolio" },
                    SignatoriesIdentificationCard: { required: "Please enter expiration date of submitted valid identification card of the signatories" },
                    SampleSalesInvoiceOfficialReceipt: { required: "Please enter expiration date of submitted sales invoice / official receipt" },
                    PrivacyConsent: { required: "Please enter the date of data privacy consent" }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    
                    var countSignatory = signatoryDT.page.info().recordsTotal;
                    if (action_type == "Submitted" && countSignatory == 0) {
                        toastr.error("Please add at least 1 Key Personnel & Authorized Signatory before continuing with the submission", "Error");
                    } else {
                        DoSave();
                    }
                }
            });

            function DoSave() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveDetails")",
                    data: {
                        customerId: kyc_details.customerId,
                        Remarks: $("#kyc-remarks").val(),
                        NameOfCompany: $("#kyc-company").val(),
                        RegisteredAddress: $("#kyc-registered-address").val(),
                        OperatingAddress: $("#kyc-operating-address").val(),
                        WarehouseAddress: $("#kyc-warehouse-address").val(),
                        OperatingHours: $("#kyc-operating-hours").val(),
                        Website: $("#kyc-website").val(),
                        EmailAddress: $("#kyc-email").val(),
                        ContactNumber: $("#kyc-contact-number").val(),
                        OrganizationType: $("#kyc-organization-type-corporation").prop("checked") ? 3
                                        : $("#kyc-organization-type-partnership").prop("checked") ? 2
                                        : 1,
                        SecDtiNumber: $("#kyc-secdti-number").val(),
                        BirTinNumber: $("#kyc-birtin-number").val(),
                        VatStatus: $("#kyc-vat-status-registered").prop("checked"),
                        BusinessNature: $("#kyc-business-nature").val(),
                        ProductServiceOffered: $("#kyc-product-service").val(),
                        CreditLineAmount: $("#kyc-credit-amount").val(),
                        CreditTermId: $("#kyc-credit-term").val(),
                        BIRForm2303: $("#kyc-bir-form").val(),
                        MayorBusinessPermit: $("#kyc-business-permit").val(),
                        SecDtiCertificate: $("#kyc-secdti-certificate").val(),
                        LatestAuditedFinancialStatement: $("#kyc-audit-statement").val(),
                        IncorporationArticleByLaws: $("#kyc-article-bylaw").val(),
                        SecretaryCertificate: $("#kyc-secretary-certificate").val(),
                        CompanyPortfolio: $("#kyc-portfolio").val(),
                        SignatoriesIdentificationCard: $("#kyc-id-signatories").val(),
                        SampleSalesInvoiceOfficialReceipt: $("#kyc-sample-sior").val(),
                        PrivacyConsent: $("#kyc-consent").val(),
                        Status: action_type || "Draft"
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            if (action_type == "" || action_type == "Draft") {
                                toastr.success(data.message, "Success");
                                formChanged = false;
                                $(".modified").removeClass("modified");
                            } else {
                                window.location.reload();
                            }
                        }
                    }
                });
            }

            if (user_access.canApproveDisapprove)
            {
                $(document).on("click", ".btn-approve", function() {
                    swal({
                        title: "Approve KYC",
                        text: "Continue to approve this KYC?",
                        icon: "success",
                        buttons: true,
                        successMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            $.ajax({
                                url: "@Url.Action("ApproveDetails")",
                                type: "POST",
                                data: {
                                    CustomerId: kyc_details.customerId
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        window.location.reload();
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
                
                $(document).on("click", ".btn-disapprove", function() {
                    swal({
                        title: "Disapprove KYC",
                        text: "Continue to disapprove this KYC?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true,
                        content: {
                            element: "input",
                            attributes: {
                                placeholder: "Reason for Disapproving",
                                type: "text"
                            }
                        }
                    }).then((confirm) => {
                        if (confirm != null) {
                            $.ajax({
                                url: "@Url.Action("DisapproveDetails")",
                                type: "POST",
                                data: {
                                    CustomerId: kyc_details.customerId,
                                    Reason: confirm
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        window.location.reload();
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
            }

            if (user_access.canEdit)
            {
                $(document).on("click", ".btn-edit", function() {
                    swal({
                        title: "Edit KYC",
                        text: "This will revert the status to Draft to enable editing. Do you want to continue editing this KYC?",
                        icon: "success",
                        buttons: true,
                        successMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            $.ajax({
                                url: "@Url.Action("EditDetails")",
                                type: "POST",
                                data: {
                                    CustomerId: kyc_details.customerId
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        window.location.reload();
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
            }
        
            var signatoryDT = $('.table-signatories').DataTable({
                ajax: {
                    url: "@Url.Action("GetKYCSignatoriesDT")",
                    type: "POST",
                    data: function (data) {
                        data.CustomerId = kyc_details.customerId;
                    },
                    beforeSend: function (jqXHR, settings) {
                        settings.isDataTableRequest = true;
                    }
                },
                processing: true,
                language: {
                    processing: "<div class='dt-loader'>Processing table, please wait...</div>"
                },
                serverSide: true,
                filter: false,
                responsive: true,
                autoWidth: false,
                lengthChange: false,
                info: false,
                paging: false,
                columns: [
                    { data: "name", name: "Name" },
                    { data: "designation", name: "Designation" },
                    { data: "mobileNumber", name: "MobileNumber" },
                    { data: "emailAddress", name: "EmailAddress" },
                    {
                        orderable: false,
                        data: function (data, type, dataToSet) {
                            var actions = '<div class="btn-group" role="group">';
                            if (user_access.canEdit) {
                                actions += '<button type="button" class="btn btn-primary btn-xs btn-edit-signatory" data-microtip-title="Edit Key Personnel & Authorized Signatory" data-microtip-position="top" role="tooltip"><span class="fas fa-edit"></span></button>';
                            }
                            if (user_access.canDelete) {
                                actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-signatory" data-microtip-title="Delete Key Personnel & Authorized Signatory" data-microtip-position="top" role="tooltip"><span class="fas fa-trash-alt"></span></button>';
                            }
                            return actions + "</div>";
                        },
                        visible: kyc_details.status == "Draft"
                    }
                ],
                order: [[0, "asc"]]
            }).on("draw", function () {
                var count = signatoryDT.page.info().recordsTotal;

                if (count > 0) {
                    $(".signatory-counter").removeClass("empty");
                } else {
                    $(".signatory-counter").addClass("empty");
                }
                $(".signatory-counter").text(count);

                var disableAdd = count >= 5;
                $(".btn-add-signatory").toggleClass("ui-state-disabled", disableAdd);
                if (disableAdd) {
                    $(".btn-add-signatory").attr({
                        "data-microtip-title": "Add\nReached maximum allowed record",
                        "data-microtip-position": "left",
                        "role": "tooltip",
                         "disabled": "disabled"
                    });
                } else {
                    $(".btn-add-signatory").removeAttr("data-microtip-title data-microtip-position role disabled");
                }
            });

            var clientDT = $(".table-client").DataTable({
                ajax: {
                    url: "@Url.Action("GetKYCClientsDT")",
                    type: "POST",
                    data: function (data) {
                        data.CustomerId = kyc_details.customerId;
                    },
                    beforeSend: function (jqXHR, settings) {
                        settings.isDataTableRequest = true;
                    }
                },
                processing: true,
                language: {
                    processing: "<div class='dt-loader'>Processing table, please wait...</div>"
                },
                serverSide: true,
                filter: false,
                responsive: true,
                autoWidth: false,
                lengthChange: false,
                info: false,
                paging: false,
                columns: [
                    { data: "name", name: "Name" },
                    {
                        data: function (data, type, dataToSet) {
                            return data.contactPerson || '<span class="text-muted">N/A</span>';
                        },
                        name: "ContactPerson"
                    },
                    {
                        data: function (data, type, dataToSet) {
                            return data.contactNumber || '<span class="text-muted">N/A</span>';
                        },
                        name: "ContactNumber"
                    },
                    {
                        data: function (data, type, dataToSet) {
                            return data.salesVolume || '<span class="text-muted">N/A</span>';
                        },
                        name: "SalesVolume"
                    },
                    {
                        orderable: false,
                        data: function (data, type, dataToSet) {
                            var actions = '<div class="btn-group" role="group">';
                            if (user_access.canEdit) {
                                actions += '<button type="button" class="btn btn-primary btn-xs btn-edit-client" data-microtip-title="Edit Major Client" data-microtip-position="top" role="tooltip"><span class="fas fa-edit"></span></button>';
                            }
                            if (user_access.canDelete) {
                                actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-client" data-microtip-title="Delete Major Client" data-microtip-position="top" role="tooltip"><span class="fas fa-trash-alt"></span></button>';
                            }
                            return actions + "</div>";
                        },
                        visible: kyc_details.status == "Draft"
                    }
                ],
                order: [[0, "asc"]]
            }).on("draw", function () {
                var count = clientDT.page.info().recordsTotal;

                if (count > 0) {
                    $(".client-counter").removeClass("empty");
                } else {
                    $(".client-counter").addClass("empty");
                }
                $(".client-counter").text(count);

                var disableAdd = count >= 5;
                 $(".btn-add-client").toggleClass("ui-state-disabled", disableAdd);
                 if (disableAdd) {
                     $(".btn-add-client").attr({
                         "data-microtip-title": "Add\nReached maximum allowed record",
                         "data-microtip-position": "left",
                         "role": "tooltip",
                         "disabled": "disabled"
                     });
                 } else {
                     $(".btn-add-client").removeAttr("data-microtip-title data-microtip-position role disabled");
                 }
            });

            var bankDT = $(".table-bank").DataTable({
                ajax: {
                    url: "@Url.Action("GetKYCBanksDT")",
                    type: "POST",
                    data: function (data) {
                        data.CustomerId = kyc_details.customerId;
                    },
                    beforeSend: function (jqXHR, settings) {
                        settings.isDataTableRequest = true;
                    }
                },
                processing: true,
                language: {
                    processing: "<div class='dt-loader'>Processing table, please wait...</div>"
                },
                serverSide: true,
                filter: false,
                responsive: true,
                autoWidth: false,
                lengthChange: false,
                info: false,
                paging: false,
                columns: [
                    { data: "name", name: "Name" },
                    { data: "branch", name: "Branch" },
                    { data: "accountNumber", name: "AccountNumber" },
                    { data: "contactNumber", name: "ContactNumber" },
                    {
                        orderable: false,
                        data: function (data, type, dataToSet) {
                            var actions = '<div class="btn-group" role="group">';
                            if (user_access.canEdit) {
                                actions += '<button type="button" class="btn btn-primary btn-xs btn-edit-bank" data-microtip-title="Edit Bank Reference" data-microtip-position="top" role="tooltip"><span class="fas fa-edit"></span></button>';
                            }
                            if (user_access.canDelete) {
                                actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-bank" data-microtip-title="Delete Bank Reference" data-microtip-position="top" role="tooltip"><span class="fas fa-trash-alt"></span></button>';
                            }
                            return actions + "</div>";
                        },
                        visible: kyc_details.status == "Draft"
                    }
                ],
                order: [[0, "asc"]]
            }).on("draw", function () {
                var count = bankDT.page.info().recordsTotal;

                if (count > 0) {
                    $(".bank-counter").removeClass("empty");
                } else {
                    $(".bank-counter").addClass("empty");
                }
                $(".bank-counter").text(count);

                var disableAdd = count >= 5;
                 $(".btn-add-bank").toggleClass("ui-state-disabled", disableAdd);
                 if (disableAdd) {
                     $(".btn-add-bank").attr({
                         "data-microtip-title": "Add\nReached maximum allowed record",
                         "data-microtip-position": "left",
                         "role": "tooltip",
                         "disabled": "disabled"
                     });
                 } else {
                     $(".btn-add-bank").removeAttr("data-microtip-title data-microtip-position role disabled");
                 }
            });

            if (user_access.canAdd || user_access.canEdit) {
                // signatory
                $(document).on("click", ".btn-add-signatory", function () {
                    $("#signatory-name").data("Id", "");
                    $("#signatory-name").val("");
                    $("#signatory-designation").val("");
                    $("#signatory-mobile").val("");
                    $("#signatory-email").val("");

                    $("#signatoryModal").modal("show");
                });

                $(document).on("click", ".btn-edit-signatory", function () {
                    var data = signatoryDT.row($(this).closest("tr")).data();

                    $("#signatory-name").data("Id", data.id);
                    $("#signatory-name").val(data.name);
                    $("#signatory-designation").val(data.designation);
                    $("#signatory-mobile").val(data.mobileNumber);
                    $("#signatory-email").val(data.emailAddress);

                    $("#signatoryModal").modal("show");
                });
            
                var validateSaveSignatory = $("#signatoryForm").validate({
                    rules: {
                        Name: { required: true, maxlength: 100 },
                        Designation: { required: true, maxlength: 50 },
                        MobileNumber: { required: true, maxlength: 50 },
                        EmailAddress: { required: true, maxlength: 50, email: true }
                    },
                    messages: {
                        Name: { required: "Please enter name", maxlength: "Name must not exceed 100 characters" },
                        Designation: { required: "Please enter designation", maxlength: "Designation must not exceed 50 characters" },
                        MobileNumber: { required: "Please enter mobile number", maxlength: "Mobile number must not exceed 50 characters" },
                        EmailAddress: { required: "Please enter email address", maxlength: "Email address must not exceed 50 characters", email: "Email is not a valid format" }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoSaveSignatory();
                    }
                });

                function DoSaveSignatory() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("SaveSignatory")",
                        data: {
                            Id: $("#signatory-name").data("Id"),
                            KYCId: kyc_details.id,
                            Name: $("#signatory-name").val(),
                            Designation: $("#signatory-designation").val(),
                            MobileNumber: $("#signatory-mobile").val(),
                            EmailAddress: $("#signatory-email").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#signatoryModal").modal("hide");
                                signatoryDT.ajax.reload();
                            }
                        }
                    });
                }
                // end signatory

                
                // client
                $(document).on("click", ".btn-add-client", function () {
                    $("#client-name").data("Id", "");
                    $("#client-name").val("");
                    $("#client-person").val("");
                    $("#client-number").val("");
                    $("#client-sales").val("");

                    $("#clientModal").modal("show");
                });

                $(document).on("click", ".btn-edit-client", function () {
                    var data = clientDT.row($(this).closest("tr")).data();

                    $("#client-name").data("Id", data.id);
                    $("#client-name").val(data.name);
                    $("#client-person").val(data.contactPerson);
                    $("#client-number").val(data.contactNumber);
                    $("#client-sales").val(data.salesVolumeD);

                    $("#clientModal").modal("show");
                });
            
                var validateSaveClient = $("#clientForm").validate({
                    rules: {
                        Name: { required: true, maxlength: 50 },
                        ContactPerson: { maxlength: 50 },
                        ContactNumber: { maxlength: 50 },
                        SalesVolume: { range: [0, 1999999.99] }
                    },
                    messages: {
                        Name: { required: "Please enter name", maxlength: "Name must not exceed 50 characters" },
                        ContactPerson: { maxlength: "Contact person must not exceed 50 characters" },
                        ContactNumber: { maxlength: "Contact number must not exceed 50 characters" },
                        SalesVolume: { range: "Sales volume must be between 0-1999999.99" }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoSaveClient();
                    }
                });

                function DoSaveClient() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("SaveClient")",
                        data: {
                            Id: $("#client-name").data("Id"),
                            KYCId: kyc_details.id,
                            Name: $("#client-name").val(),
                            ContactPerson: $("#client-person").val(),
                            ContactNumber: $("#client-number").val(),
                            SalesVolumeD: $("#client-sales").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#clientModal").modal("hide");
                                clientDT.ajax.reload();
                            }
                        }
                    });
                }
                // end client

                
                // bank
                $(document).on("click", ".btn-add-bank", function () {
                    $("#bank-name").data("Id", "");
                    $("#bank-name").val("");
                    $("#bank-branch").val("");
                    $("#bank-account").val("");
                    $("#bank-number").val("");

                    $("#bankModal").modal("show");
                });

                $(document).on("click", ".btn-edit-bank", function () {
                    var data = bankDT.row($(this).closest("tr")).data();

                    $("#bank-name").data("Id", data.id);
                    $("#bank-name").val(data.name);
                    $("#bank-branch").val(data.branch);
                    $("#bank-account").val(data.accountNumber);
                    $("#bank-number").val(data.contactNumber);

                    $("#bankModal").modal("show");
                });
            
                var validateSaveBank = $("#bankForm").validate({
                    rules: {
                        Name: { required: true, maxlength: 50 },
                        Branch: { required: true, maxlength: 50 },
                        AccountNumber: { required: true, maxlength: 50 },
                        ContactNumber: { required: true, maxlength: 50 }
                    },
                    messages: {
                        Name: { required: "Please enter name", maxlength: "Name must not exceed 50 characters" },
                        Branch: { required: "Please enter branch", maxlength: "Branch must not exceed 50 characters" },
                        AccountNumber: { required: "Please enter account number", maxlength: "Account number must not exceed 50 characters" },
                        ContactNumber: { required: "Please enter contact number", maxlength: "Contact number must not exceed 50 characters" }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoSaveBank();
                    }
                });

                function DoSaveBank() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("SaveBank")",
                        data: {
                            Id: $("#bank-name").data("Id"),
                            KYCId: kyc_details.id,
                            Name: $("#bank-name").val(),
                            Branch: $("#bank-branch").val(),
                            AccountNumber: $("#bank-account").val(),
                            ContactNumber: $("#bank-number").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#bankModal").modal("hide");
                                bankDT.ajax.reload();
                            }
                        }
                    });
                }
                // end client
            }

            if (user_access.canDelete) {
                // signatory
                $(document).on("click", ".btn-remove-signatory", function () {
                    var data = signatoryDT.row($(this).closest("tr")).data();

                    swal({
                        title: "Delete Key Personnel & Authorized Signatory",
                        text: "Continue to delete this ket personnel & authorized signatory?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm != null) {
                            $.ajax({
                                url: "@Url.Action("DeleteSignatory")",
                                type: "POST",
                                data: {
                                    SignatoryId: data.id,
                                    KYCId: kyc_details.id
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        toastr.success(data.message, "Success");
                                        signatoryDT.ajax.reload();
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
                // end signatory
                
                // client
                $(document).on("click", ".btn-remove-client", function () {
                    var data = clientDT.row($(this).closest("tr")).data();

                    swal({
                        title: "Delete Major Client",
                        text: "Continue to delete this major client?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm != null) {
                            $.ajax({
                                url: "@Url.Action("DeleteClient")",
                                type: "POST",
                                data: {
                                    ClientId: data.id,
                                    KYCId: kyc_details.id
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        toastr.success(data.message, "Success");
                                        clientDT.ajax.reload();
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
                // end client
                
                // bank
                $(document).on("click", ".btn-remove-bank", function () {
                    var data = bankDT.row($(this).closest("tr")).data();

                    swal({
                        title: "Delete Bank Reference",
                        text: "Continue to delete this bank reference?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm != null) {
                            $.ajax({
                                url: "@Url.Action("DeleteBank")",
                                type: "POST",
                                data: {
                                    BankId: data.id,
                                    KYCId: kyc_details.id
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        toastr.success(data.message, "Success");
                                        bankDT.ajax.reload();
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
                // end bank
            }
        }
    </script>
}