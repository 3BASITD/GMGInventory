@model KYCVM

@{
    ViewData["Title"] = "KYC Details";
    ViewData["TitleDetails"] = $"[{Model.CustomerCode}]";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="KYC" asp-action="Index">KYCs</a></li>
}

<div class="alert alert-info" role="alert">
    <span class="fas fa-exclamation-triangle mr-3"></span>You are using a v4 enhancement feature. This message will be removed once v4 is completed and made available as a fully paid version.
</div>

<form id="form-save">
    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right ml-2" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
                @if (userAccess.CanEdit && (Model.Status == "Approved" || Model.Status == "Disapproved"))
                {
                    <button type="button" class="btn btn-primary btn-sm float-right btn-edit ml-2">
                        <span class="fas fa-edit"></span>Edit
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                            data-microtip-title="Edit&#10;@(Model.Status != "Approved" && Model.Status != "Disapproved" ? "Only approved / disapproved kyc can be editted" : "Edit access is required")"
                            data-microtip-position="bottom-left"
                            role="tooltip">
                        <span class="fas fa-edit mr-0"></span>
                    </button>
                }
                @if (userAccess.CanApproveDisapprove && Model.Status == "Submitted")
                {
                    <button type="button" class="btn btn-success btn-sm float-right btn-approve ml-2">
                        <span class="fas fa-check"></span>Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm float-right btn-disapprove ml-2">
                        <span class="fas fa-times"></span>Disapprove
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-success btn-sm float-right ml-2 ui-state-disabled"
                            data-microtip-title="Approve&#10;@(Model.Status != "Submitted" ? "Only submitted kyc can be approved" : "Approve / Disapprove access is required")"
                            data-microtip-position="bottom-left"
                            role="tooltip">
                        <span class="fas fa-check mr-0"></span>
                    </button>
                    <button type="button"
                            class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled"
                            data-microtip-title="Disapprove&#10;@(Model.Status != "Submitted" ? "Only submitted kyc can be disapproved" : "Approve / Disapprove access is required")"
                            data-microtip-position="bottom-left"
                            role="tooltip">
                        <span class="fas fa-times mr-0"></span>
                    </button>
                }
                @if (userAccess.CanAdd && Model.Status == "Draft")
                {
                    <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                        <span class="fas fa-paper-plane"></span> Submit for Approval
                    </button>
                    <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                        <span class="fas fa-save"></span>Save as Draft
                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                            data-microtip-title="Submit for Approval&#10;@(Model.Status != "Draft" ? "Only draft kyc can be submitted" : "Add access is required")"
                            data-microtip-position="bottom-left"
                            role="tooltip">
                        <span class="fas fa-paper-plane mr-0"></span>
                    </button>
                    <button type="submit"
                            class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled"
                            data-microtip-title="Save as Draft&#10;@(Model.Status != "Draft" ? "Only draft kyc can be saved as draft" : "Add access is required")"
                            data-microtip-position="bottom-left"
                            role="tooltip">
                        <span class="fas fa-save mr-0"></span>
                    </button>
                }
            </div>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
            {
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-danger text-sm" role="alert">
                            <strong>Reason of Disapproval:</strong>
                            @(string.IsNullOrWhiteSpace(Model.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                        </div>
                    </div>
                </div>
            }
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            Customer Code
                        </span>
                        <select name="Customer" id="kyc-customer" class="form-control form-control-sm s2-bold"></select>
                    </p>
                </div>

                @if (Model.CustomerId == 0)
                {
                    <div class="col-12 col-md-8 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                &nbsp;
                            </span>
                            <span class="d-block form-gayahin text-info">
                                Please select a customer first to configure their KYC
                            </span>
                        </p>
                    </div>
                }
                else if (Model.CustomerName == "Invalid Customer")
                {
                    <div class="col-12 col-md-8 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                &nbsp;
                            </span>
                            <span class="d-block form-gayahin text-info">
                                Please select a customer first to configure their KYC. Previously selected customer is invalid.
                            </span>
                        </p>
                    </div>
                }
                else
                {
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                Customer Name
                            </span>
                            <b class="d-block form-gayahin">
                                <a href="@Url.Action("Details", "Customer")/@Model.CustomerId" class="link-info" target="_blank">@Model.CustomerName</a>
                            </b>
                        </p>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                Status
                            </span>
                            <b class="d-block form-gayahin">
@Model.Status @(Model.Status == "Draft" && !string.IsNullOrWhiteSpace(Model.ApprovedBy) ? Html.Raw("<span class='text-muted fw-normal'>(Reverted from Approved)</span>")
              : Model.Status == "Draft" && !string.IsNullOrWhiteSpace(Model.DisapprovedBy) ? Html.Raw("<span class='text-muted fw-normal'>(Reverted from Disapproved)</span>")
              : "")
                            </b>
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ModifiedDate))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Date Last Modified @Model.DisapprovedReason
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.ModifiedDate
                                </b>
                            </p>
                        </div>
                    }
                
                    @if (!string.IsNullOrWhiteSpace(Model.ModifiedBy))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Last Modified By
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.ModifiedBy
                                </b>
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SubmittedDate))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Date Submitted
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.SubmittedDate
                                </b>
                            </p>
                        </div>
                    }
                
                    @if (!string.IsNullOrWhiteSpace(Model.SubmittedBy))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Submitted By
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.SubmittedBy
                                </b>
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ApprovedDate))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Date Approved
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.ApprovedDate
                                </b>
                            </p>
                        </div>
                    }
                
                    @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Approved By
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.ApprovedBy
                                </b>
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.DisapprovedDate))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Date Disapproved
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.DisapprovedDate
                                </b>
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                    {
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <span class="text-muted">
                                    Disapproved By
                                </span>
                                <b class="d-block form-gayahin">
                                    @Model.DisapprovedBy
                                </b>
                            </p>
                        </div>
                    }

                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                Remarks
                            </span>
                            @if (Model.Status == "Draft")
                            {
                                <input type="text" name="Remarks" id="kyc-remarks" class="form-control form-control-sm modify-checker" />
                            }
                            else
                            {
                                <b class="d-block form-gayahin">
                                    @(string.IsNullOrWhiteSpace(Model.Remarks) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.Remarks)
                                </b>
                            }
                        </p>
                    </div>
                }
            </div>
            @if (Model.CustomerId != 0 && Model.CustomerName != "Invalid Customer")
            {
                <div class="row">
                    <div class="col-12">
                        <div class="card card-danger card-tabs mt-2">
                            <div class="card-header p-0 pt-1 pl-2 pr-2">
                                <ul class="nav nav-tabs nav-fill nav-item" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile">Company Profile & Contact Information</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" data-bs-target="#legalTax">Legal & Tax Status</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link position-relative" data-bs-toggle="tab" data-bs-target="#personnel">
                                            Key Personnel & Authorized Signatories
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info empty signatory-counter">
                                                0
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" data-bs-target="#businessCredit">Business Operation & Credit Data</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link position-relative" data-bs-toggle="tab" data-bs-target="#clients">
                                            Major Clients
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info empty client-counter">
                                                0
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link position-relative" data-bs-toggle="tab" data-bs-target="#banks">
                                            Bank References
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info empty bank-counter">
                                                0
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link position-relative" data-bs-toggle="tab" data-bs-target="#checklist">
                                            Documentation Checklist
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill p-0 overflow-hidden empty checklist-counter">
                                                <span class="bg-danger px-1 checklist-counter-no" style="line-height:1.5">0</span>
                                                <span class="bg-success px-1 checklist-counter-yes" style="line-height:1.5">0</span>
                                            </span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" data-bs-target="#privacy">Privacy Consent</a>
                                    </li>
                                </ul>
                            </div>
                            <div class="card-body">
                                <div class="tab-content" id="kycTabContent">
                                    <div class="tab-pane fade show active" id="profile">
                                        <div class="row">
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Name of Company</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="NameOfCompany" id="kyc-company" class="form-control form-control-sm modify-checker" value="@Model.NameOfCompany" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.NameOfCompany) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.NameOfCompany)
                                                    </b>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Registered Address</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="RegisteredAddress" id="kyc-registered-address" class="form-control form-control-sm modify-checker" value="@Model.RegisteredAddress" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.RegisteredAddress) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.RegisteredAddress)
                                                    </b>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Operating Address</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="OperatingAddress" id="kyc-operating-address" class="form-control form-control-sm modify-checker" value="@Model.OperatingAddress" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.OperatingAddress) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.OperatingAddress)
                                                    </b>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Plant / Warehouse Address</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="WarehouseAddress" id="kyc-warehouse-address" class="form-control form-control-sm modify-checker" value="@Model.WarehouseAddress" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.WarehouseAddress) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.WarehouseAddress)
                                                    </b>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Operating Hours</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="OperatingHours" id="kyc-operating-hours" class="form-control form-control-sm modify-checker" value="@Model.OperatingHours" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.OperatingHours) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.OperatingHours)
                                                    </b>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Website / Social Media Profile</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="Website" id="kyc-website" class="form-control form-control-sm modify-checker" value="@Model.Website" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.Website) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.Website)
                                                    </b>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Email Address</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="EmailAddress" id="kyc-email" class="form-control form-control-sm modify-checker" value="@Model.EmailAddress" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.EmailAddress) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.EmailAddress)
                                                    </b>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Contact Number</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="ContactNumber" id="kyc-contact-number" class="form-control form-control-sm modify-checker" value="@Model.ContactNumber" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.ContactNumber) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.ContactNumber)
                                                    </b>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="tab-pane fade" id="legalTax">
                                        <div class="row">
                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">Organization Type</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <div class="btn-group btn-group-sm w-100" role="group">
                                                        <input type="radio" class="btn-check kyc-organization-type modify-checker" name="OrganizationType"
                                                               id="kyc-organization-type-sole" value="1" @(Model.OrganizationTypeD == 1 ? "checked" : "")>
                                                        <label class="btn btn-outline-primary" for="kyc-organization-type-sole">Sole Proprietorship</label>

                                                        <input type="radio" class="btn-check kyc-organization-type modify-checker" name="OrganizationType"
                                                               id="kyc-organization-type-partnership" value="2" @(Model.OrganizationTypeD == 2 ? "checked" : "")>
                                                        <label class="btn btn-outline-primary" for="kyc-organization-type-partnership">Partnership</label>

                                                        <input type="radio" class="btn-check kyc-organization-type modify-checker" name="OrganizationType"
                                                               id="kyc-organization-type-corporation" value="3" @(Model.OrganizationTypeD == 3 ? "checked" : "")>
                                                        <label class="btn btn-outline-primary" for="kyc-organization-type-corporation">Corporation</label>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.OrganizationType) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.OrganizationType)
                                                    </b>
                                                }
                                            </div>

                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">SEC / DTI Number</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="SecDtiNumber" id="kyc-secdti-number" class="form-control form-control-sm modify-checker" value="@Model.SecDtiNumber" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.SecDtiNumber) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.SecDtiNumber)
                                                    </b>
                                                }
                                            </div>

                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">BIR TIN</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <input type="text" name="BirTinNumber" id="kyc-birtin-number" class="form-control form-control-sm modify-checker" value="@Model.BirTinNumber" />
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.BirTinNumber) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.BirTinNumber)
                                                    </b>
                                                }
                                            </div>

                                            <div class="col-12 col-md-4 mb-2">
                                                <label class="form-label fw-normal text-muted mb-0">VAT Status</label>
                                                @if (Model.Status == "Draft")
                                                {
                                                    <div class="btn-group btn-group-sm w-100" role="group">
                                                        <input type="radio" class="btn-check kyc-vat-status modify-checker" name="VATStatus"
                                                               id="kyc-vat-status-registered" value="VAT Registered" @(Model.VatStatusD ? "checked" : "")>
                                                        <label class="btn btn-outline-primary" for="kyc-vat-status-registered">VAT Registered</label>

                                                        <input type="radio" class="btn-check kyc-vat-status modify-checker" name="VATStatus"
                                                               id="kyc-vat-status-none" value="Non-VAT" @(Model.VatStatusD ? "" : "checked")>
                                                        <label class="btn btn-outline-primary" for="kyc-vat-status-none">Non-VAT</label>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <b class="d-block form-gayahin">
                                                        @(string.IsNullOrWhiteSpace(Model.VatStatus) ? Html.Raw("<span class='text-muted'>N/A</span>") : Model.VatStatus)
                                                    </b>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="tab-pane fade" id="personnel">
                                        <div class="d-flex justify-content-end mb-2">
                                            @if (Model.Status == "Draft")
                                            {
                                                @if (userAccess.CanAdd)
                                                {
                                                    <button type="button" class="btn btn-primary btn-sm float-right btn-add-signatory ml-1">
                                                        <span class="fas fa-plus"></span> Add
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-primary btn-sm float-right ml-1 ui-state-disabled"
                                                            data-microtip-title="Add&#10;Add access is required"
                                                            data-microtip-position="bottom-left"
                                                            role="tooltip">
                                                        <span class="fas fa-plus mr-0"></span>
                                                    </button>
                                                }
                                            }
                                        </div>
                                        <table class="table table-head-fixed table-striped table-hover table-signatories">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Designation</th>
                                                    <th>Mobile Number</th>
                                                    <th>Email Address</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>

                                    <div class="tab-pane fade" id="businessCredit">
                                        <div class="row">
                                            <div class="col-12 col-md-4 mb-2">
