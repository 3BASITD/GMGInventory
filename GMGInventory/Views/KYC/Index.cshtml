<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-kyc">
            <thead>
                <tr>
                    <th>Customer Code</th>
                    <th>Customer Name</th>
                    <th>Latest KYC Action By</th>
                    <th>Latest KYC Action Date</th>
                    <th>KYC Status</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var kycDT = $('.table-kyc').DataTable({
            ajax: {
                url: "@Url.Action("GetKYCsDT")",
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Customer/Details/" + data.customerId + "' class='link-info' target='_blank'>" + data.customerCode + "</a>";
                    },
                    name: "CustomerCode" },
                { data: "customerName", name: "CustomerName" },
                {
                    data: function (data, type, dataToSet) {
                        return data.latestActionBy || '<span class="text-muted">N/A</span>';
                    }, 
                    name: "LatestActionBy" },
                {
                    data: function (data, type, dataToSet) {
                        return data.latestActionDate || '<span class="text-muted">N/A</span>';
                    },
                    name: "LatestActionDate" },
                { 
                    data: function (data, type, dataToSet) {
                        return data.status || '<span class="text-muted">KYC not yet created. View Details to create</span>';
                    },
                    name: "Status", 
                    responsivePriority: 2 },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Customer")/' + data.customerId + '" data-microtip-title="View Details" data-microtip-position="left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: [[3, "desc"]]
        }).on("draw", function () {
        });
    </script>
}