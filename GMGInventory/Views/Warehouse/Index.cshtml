@model IEnumerable<WarehouseViewVM>

@{
    ViewData["Title"] = "Warehouse";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                <span class="fas fa-plus"></span> New Warehouse
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ContactPerson)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ContactNumber)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null)
                {
                    <tr><td colspan="5"><p class="text-center m-0">This record is empty</p></td></tr>
                }
                else
                {
                    @foreach (var warehouse in Model)
                    {
                        <tr>
                            <td>@warehouse.Code</td>
                            <td>@warehouse.Name</td>
                            <td>@warehouse.ContactPerson</td>
                            <td>@warehouse.ContactNumber</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a class="btn btn-info btn-xs" asp-action="Details" asp-route-id="@warehouse.Id" data-microtip-title="View Details" data-microtip-position="top-left" role="tooltip">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    @if (warehouse.IsActive)
                                    {
                                        <a class="btn btn-warning btn-xs" asp-action="Edit" asp-route-id="@warehouse.Id" data-microtip-title="Edit Details" data-microtip-position="top-left" role="tooltip">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <button data-id="@warehouse.Id" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete / Deactivate Item" data-microtip-position="top-left" role="tooltip">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button data-id="@warehouse.Id" class="btn btn-success btn-xs reactivateBtn" type="button" data-microtip-title="Reactivate Item" data-microtip-position="top-left" role="tooltip">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<form id="deleteWarehouseForm" asp-action="Delete">
    <input type="hidden" id="deleteWarehouseId" name="Id" />
</form>

<form id="reactivateWarehouseForm" asp-action="Reactivate">
    <input type="hidden" id="reactivateWarehouseId" name="Id" />
</form>

@section Scripts {
    <script>
        $('.table').DataTable({
            order: [[0, "desc"]]
        });

        $('.deleteBtn').click(function(e) {
            swal({
                title: "Delete / Deactivate Warehouse",
                text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                icon: "warning",
                buttons: true,
                dangerMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#deleteWarehouseId').val(id);
                    $('#deleteWarehouseForm').submit();
                }
            });
        });

        $('.reactivateBtn').click(function(e) {
            swal({
                title: "Reactivate Warehouse",
                text: "Are you sure you want to reactivate this record?",
                icon: "info",
                buttons: true,
                infoMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#reactivateWarehouseId').val(id);
                    $('#reactivateWarehouseForm').submit();
                }
            });
        });
    </script>
}