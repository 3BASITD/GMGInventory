@model WarehouseVM

@{
    ViewData["Title"] = "Warehouse Details";
    ViewData["TitleDetails"] = $"[{Model.Code}]";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Warehouse" asp-action="Index">Warehouses</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Code)
                    </span>
                    <b class="d-block">
                        @Model.Code
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block">
                        @Model.Name
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.IsActive)
                    </span>
                    <b class="d-block">
                        @if (Model.IsActive == true)
                        {
                            <span class="fas fa-check text-success"></span>
                        }
                        else
                        {
                            <span class="fas fa-times text-danger"></span>
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.IsMain)
                    </span>
                    <b class="d-block">
                        @if (Model.IsMain == true)
                        {
                            <span class="fas fa-check text-success"></span>
                        }
                        else
                        {
                            <span class="fas fa-times text-danger"></span>
                        }
                    </b>
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Address)
                    </span>
                    <b class="d-block">
                        @if (string.IsNullOrWhiteSpace(Model.Address))
                        {
                            <span class="text-muted">N/A</span>
                        }
                        else
                        {
                            @Model.Address
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactPerson)
                    </span>
                    <b class="d-block">
                        @if (string.IsNullOrWhiteSpace(Model.ContactPerson))
                        {
                            <span class="text-muted">N/A</span>
                        }
                        else
                        {
                            @Model.ContactPerson
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactNumber)
                    </span>
                    <b class="d-block">
                        @if (string.IsNullOrWhiteSpace(Model.ContactNumber))
                        {
                            <span class="text-muted">N/A</span>
                        }
                        else
                        {
                            @Model.ContactNumber
                        }
                    </b>
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block">
                        @Model.UserCreated
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block">
                        @Model.DateCreated
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserModified)
                    </span>
                    <b class="d-block">
                        @if (string.IsNullOrWhiteSpace(Model.UserModified))
                        {
                            <span class="text-muted">N/A</span>
                        }
                        else
                        {
                            @Model.UserModified
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateModified)
                    </span>
                    <b class="d-block">
                        @if (string.IsNullOrWhiteSpace(Model.DateModified))
                        {
                            <span class="text-muted">N/A</span>
                        }
                        else
                        {
                            @Model.DateModified
                        }
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-danger card-tabs">
                    <div class="card-header p-0 pt-1 pl-2">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="nav-items-tab" data-toggle="pill" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-items"
                                   aria-controls="nav-items" aria-selected="true">
                                    Item Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-transfer-tab" data-toggle="pill" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-transfer"
                                   aria-controls="nav-transfer" aria-selected="true">
                                    Item Transfer History
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-items" role="tabpanel"
                                 aria-labelledby="nav-items-tab">
                                <table class="table table-head-fixed table-striped table-hover table-warehouse-items">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Retail Price</th>
                                            <th>Net Price</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-transfer" role="tabpanel" aria-labelledby="nav-transfer-tab">
                                <table class="table table-head-fixed table-striped table-hover table-transfer">
                                    <thead>
                                        <tr>
                                            <th>Source</th>
                                            <th>Destination</th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Quantity</th>
                                            <th>Transfer Date</th>
                                            <th>Created By</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var warehouse_data = @Html.Raw(Json.Serialize(Model));

        $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
            var selectedTab = e.currentTarget.dataset.bsTarget;
            if (selectedTab == "#nav-items") itemDT.ajax.reload();
            if (selectedTab == "#nav-transfer") transferDT.ajax.reload();
        });

        var itemDT = $('.table-warehouse-items').on('preXhr.dt', function (e, settings, data) {
            //showBatchLoader("items");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson", "Item")",
                type: "POST",
                data: function (data) {
                    data.WarehouseId = warehouse_data.id
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "retailPrice", name: "RetailPrice", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" }
            ],
            order: [[0, "asc"]]
        });

        itemDT.on("draw", function () {
            //hideBatchLoader("items");
        });

        var transferDT = $('.table-transfer').on('preXhr.dt', function (e, settings, data) {
            //showBatchLoader("transfer");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetWarehouseTransferJson", "Transfer")",
                data: function (data) {
                    data.warehouseId = warehouse_data.id
                },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "source", name: "Source" },
                { data: "destination", name: "Destination" },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "transferDate", name: "TransferDate" },
                { data: "createdBy", name: "CreatedBy" }
            ],
            order: [[6, "desc"]]
        });

        transferDT.on("draw", function () {
            //hideBatchLoader("transfer");
        });
    </script>
}