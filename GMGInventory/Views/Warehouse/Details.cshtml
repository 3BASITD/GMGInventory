@model WarehouseViewVM

@{
    ViewData["Title"] = "Warehouse Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Warehouse" asp-action="Index">Warehouses</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                @if (Model?.IsActive == true)
            {
                <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Edit" asp-route-id="@Model?.Id">
                    <span class="fas fa-edit"></span> Edit Warehouse
                </a>
            }
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Code)
                    </span>
                    <b class="d-block">
                        @Model?.Code
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block">
                        @Model?.Name
                    </b>
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AddressLine1)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.AddressLine1) ? "-" : Model?.AddressLine1)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AddressLine2)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.AddressLine2) ? "-" : Model?.AddressLine2)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactPerson)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.ContactPerson) ? "-" : Model?.ContactPerson)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactNumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.ContactNumber) ? "-" : Model?.ContactNumber)
                    </b>
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block">
                        @Model?.UserCreated
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block">
                        @Model?.DateCreated
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserModified)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.UserModified) ? "-" : Model?.UserModified)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateModified)
                    </span>
                    <b class="d-block">
                        @(Model?.DateModified ?? "-")
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-danger card-tabs">
                    <div class="card-header p-0 pt-1 pl-2">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="nav-items-tab" data-toggle="pill" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-items"
                                   aria-controls="nav-items" aria-selected="true">
                                    Item Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-transfer-tab" data-toggle="pill" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-transfer"
                                   aria-controls="nav-transfer" aria-selected="true">
                                    Item Transfer History
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-items" role="tabpanel"
                                 aria-labelledby="nav-items-tab">
                                <table class="table table-head-fixed table-striped table-hover table-warehouse-items">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Retail Price</th>
                                            <th>Net Price</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-transfer" role="tabpanel" aria-labelledby="nav-transfer-tab">...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var itemTable = $('.table-warehouse-items').on('preXhr.dt', function(e, settings, data) {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fa fa-cog fa-spin"
            });
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson", "Item")",
                type: "POST",
                data: function(data) {
                    data.WarehouseId = @Model?.Id;
                },
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "retailPrice", name: "RetailPrice", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" }
            ],
            order: [[0, "asc"]]
        });

        itemTable.on("draw", function() {
            $.LoadingOverlay("hide");

            $('.dataTables_filter input').unbind();
            $('.dataTables_filter input').keyup(function(e) {
                if (e.keyCode == 13) {
                    dataTable.search($(this).val()).draw();
                }
            });
        });
    </script>
}