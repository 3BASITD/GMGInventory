@section Scripts {
    <script>
        var task_user_access = @Html.Raw(Json.Serialize(taskUserAccess));
        var comment_user_access = @Html.Raw(Json.Serialize(commentUserAccess));
        var issue_user_access = @Html.Raw(Json.Serialize(issueUserAccess));
        var task_data = @Json.Serialize(Model);

        const severityOptions = [
            { id: "TRIVIAL", text: "TRIVIAL", emoji: "⬜", desc: "Cosmetic issue, typo, small UI glitch" },
            { id: "LOW", text: "LOW", emoji: "🟩", desc: "Minor problem, doesn’t affect functionality" },
            { id: "MEDIUM", text: "MEDIUM", emoji: "🟨", desc: "Noticeable issue, workaround exists" },
            { id: "HIGH", text: "HIGH", emoji: "🟧", desc: "Major feature broken, serious impact" },
            { id: "CRITICAL", text: "CRITICAL", emoji: "🟥", desc: "System crash, data loss, blocking release" }
        ];

        if (issue_user_access.canAdd) {
            $('#add-issue-severity').select2({
                ajax: null,
                data: severityOptions,
                minimumResultsForSearch: -1,
                templateResult: function (repo) {
                    if (repo.loading) return repo.text;
                    return $(
                        "<span class='me-1'>" + repo.emoji + "</span>" +
                        "<strong>" + repo.text + "</strong>" +
                        "<em class='fw-light ms-1'> - " + repo.desc + "</em>"
                    );
                },
                templateSelection: function (repo) {
                    return repo.emoji + " " + repo.text;
                },
                dropdownParent: $("#addIssueModal")
            });
        }

        if (issue_user_access.canEdit) {
            $('#edit-issue-severity').select2({
                ajax: null,
                data: severityOptions,
                minimumResultsForSearch: -1,
                templateResult: function (repo) {
                    if (repo.loading) return repo.text;
                    return $(
                        "<span class='me-1'>" + repo.emoji + "</span>" +
                        "<strong>" + repo.text + "</strong>" +
                        "<em class='fw-light ms-1'> - " + repo.desc + "</em>"
                    );
                },
                templateSelection: function (repo) {
                    return repo.emoji + " " + repo.text;
                },
                dropdownParent: $("#editIssueModal")
            });
        }

        const trackerEditor = (selector, entity, height, placeholder) => ({
            placeholder: placeholder,
            height: height,
            toolbar: [
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['height', ['height']],
                ['insert', task_user_access.canUploadDownload || comment_user_access.canUploadDownload || issue_user_access.canUploadDownload
                         ? ['link', 'picture', 'table', 'hr']
                         : ['link', 'table', 'hr']],
                ['view', ['fullscreen', 'codeview']],
            ],
            callbacks: {
                onImageUpload: function (files) {
                    if(task_user_access.canUploadDownload || comment_user_access.canUploadDownload || issue_user_access.canUploadDownload)
                        [...files].forEach(file => uploadImage(selector, file, entity));
                },
                onMediaDelete: function ($target) {
                    $target.remove();
                }
            }
        });

        if(task_user_access.canUploadDownload || comment_user_access.canUploadDownload || issue_user_access.canUploadDownload) {
            function uploadImage(selector, file, entity) {
                let data = new FormData();
                data.append("File", file);
                data.append("Entity", entity);

                $.ajax({
                    url: '@Url.Action("UploadImage", "Tracker")',
                    type: "POST",
                    data: data,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.status === "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            $(selector).summernote('insertImage',
                                '/images/DevTask/' + data.newRow,
                                function ($image) {
                                    $image.css('width', $image.width() * 0.25);
                                }
                            );
                        }
                    }
                });
            }
        }

        if (comment_user_access.canAdd)
            $('#add-comment-content').summernote(trackerEditor('#add-comment-content', "Comment", 300, ""));
        if (comment_user_access.canEdit)
            $('#edit-comment-content').summernote(trackerEditor('#edit-comment-content', "Comment", 300, ""));
        if (issue_user_access.canAdd) {
            $('#add-issue-description').summernote(trackerEditor('#add-issue-description', "Issue", 150, "Behaves like this\n\nInstead of like this"));
            $('#add-issue-replication').summernote(trackerEditor('#add-issue-replication', "Issue", 150, "Step 1\nStep 2\nStep 3\n\nSteps until issue appears"));
        }
        if (issue_user_access.canEdit) {
            $('#edit-issue-description').summernote(trackerEditor('#edit-issue-description', "Issue", 150, "Behaves like this\n\nInstead of like this"));
            $('#edit-issue-replication').summernote(trackerEditor('#edit-issue-replication', "Issue", 150, "Step 1\nStep 2\nStep 3\n\nSteps until issue appears"));
        }

        function JSRenderActionButton(label, emoji, btnClass, canAct, tooltipCanAct, tooltipCantAct, onclick) {
            var button = $(`<button type="button" class="btn btn-sm ${btnClass}"></button>`);

            if (!canAct) {
                button.addClass("ui-state-disabled");
                button.attr("data-microtip-title", tooltipCantAct);
                button.attr("data-microtip-position", "top-left");
                button.attr("role", "tooltip");
            } else {
                button.removeClass("ui-state-disabled");
                if (tooltipCanAct) {
                    button.attr("data-microtip-title", tooltipCanAct);
                    button.attr("data-microtip-position", "top-left");
                    button.attr("role", "tooltip");
                } else {
                    button.removeAttr("data-microtip-title");
                    button.removeAttr("data-microtip-position");
                    button.removeAttr("role");
                }
                if (onclick) {
                    button.on("click", onclick);
                }
            }

            button.html(`<span class="emoji">${emoji}</span> ${label}`);
            return button;
        }


        function LoadDetails() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DetailsJson", "Tracker")',
                data: {
                    Id: task_data.id
                },
                success: function (data) {
                    $(".card-for-task").removeClass("card-primary card-warning card-danger card-info card-success card-default");

                    const $tools = $(".details-tools-container");

                    $tools.html("");

                    if (data.status.toLowerCase() == "open") {
                        $(".card-for-task").addClass("card-default");
                        // if (data.modifyExpiration) {
                        //     $tools.append(JSRenderActionButton("Edit", "✏️", "btn-info ml-2", task_user_access.canEdit, "Button expires in " + data.modifyExpiration, "Edit access is required.", null));
                        //     $tools.append(JSRenderActionButton("Delete", "🗑️", "btn-danger ml-2", task_user_access.canDelete, "Button expires in " + data.modifyExpiration, "Delete access is required.", null));
                        // }
                        $tools.append(JSRenderActionButton("Edit", "✏️", "btn-info ml-2", task_user_access.canEdit, null, "Edit access is required.", null));
                        $tools.append(JSRenderActionButton("Delete", "🗑️", "btn-danger ml-2", task_user_access.canDelete, null, "Delete access is required.", null));
                        $tools.append(JSRenderActionButton("Start Doing", "🔄", "btn-primary ml-2", task_user_access.canEdit, null, "Edit access is required.", () => StartTask()));
                    } else if (data.status.toLowerCase() == "doing") {
                        $(".card-for-task").addClass("card-primary");
                        $tools.append(JSRenderActionButton("Deploy for Testing", "🧪", "btn-warning ml-2", task_user_access.canEdit, null, "Edit access is required.", () => TestTask()));
                    } else if (data.status.toLowerCase() == "testing") {
                        $(".card-for-task").addClass("card-warning");
                        $tools.append(JSRenderActionButton("Accept", "✅", "btn-success ml-2", task_user_access.canApproveDisapprove &&  data.isAssignee == false, null, "Approve / Disapprove access is required and should not be the Assignee.", () => AcceptTask()));
                        $tools.append(JSRenderActionButton("Reject", "❌", "btn-danger ml-2", task_user_access.canApproveDisapprove &&  data.isAssignee == false, null, "Approve / Disapprove access is required and should not be the Assignee.", () => RejectTask()));
                    } else if (data.status.toLowerCase() == "incomplete") {
                        $(".card-for-task").addClass("card-danger");
                        $tools.append(JSRenderActionButton("Fix", "🔧", "btn-primary ml-2", task_user_access.canEdit, null, "Edit access is required.", () => FixTask()));
                    } else if (data.status.toLowerCase() == "for production") {
                        $(".card-for-task").addClass("card-info");
                        $tools.append(JSRenderActionButton("Deploy in Production", "🔧", "btn-primary ml-2", task_user_access.canEdit, null, "Edit access is required.", () => ProdTask()));
                    } else if (data.status.toLowerCase() == "on production") {
                        $(".card-for-task").addClass("card-success");
                    }

                    $tools.append(`
                    <a href="/Tracker/Details/${data.nextTaskId}" class="btn btn-light text-dark btn-sm float-right ml-2">
                        <span class="emoji">⏵</span>
                    </a>
                    <a href="/Tracker/Details/${data.previousTaskId}" class="btn btn-light text-dark btn-sm float-right ml-2">
                        <span class="emoji">⏴</span>
                    </a>
                    <a href="@Url.Action("Index", "Tracker")" class="btn btn-light text-dark btn-sm float-right ml-2">
                        <span class="emoji">🔙</span> Back to List
                    </a>`);

                    $("#details-function").html(data.function);
                    $("#details-behavior").html(data.behavior);
                    $("#details-access").html(data.accessControl);
                    $("#details-status").html(data.status);
                    $("#details-priority").html(data.priority.toLowerCase() == "high" ? '<span class="emoji">🟧</span> HIGH'
                                              : data.priority.toLowerCase() == "medium" ? '<span class="emoji">🟨</span> MEDIUM'
                                              : '<span class="emoji">🟩</span> LOW');
                    $("#details-assignee").html(data.assignee);
                    $("#details-created-by").html(data.createdBy);
                    $("#details-created-date").html(data.dateCreated);

                    if(data.modifiedBy) {
                        $("#details-modified-by").html(data.modifiedBy);
                        $(".detail-modified-by-display").removeClass("d-none");
                    } else {
                        $(".detail-modified-by-display").addClass("d-none");
                    }
                    if(data.dateModified) {
                        $("#details-modified-date").html(data.dateModified)
                        $(".detail-modified-date-display").removeClass("d-none");
                    } else {
                        $(".detail-modified-date-display").addClass("d-none");
                    }
                    if(data.approvedBy) {
                        $("#details-approved-by").html(data.approvedBy);
                        $(".detail-approved-by-display").removeClass("d-none");
                    } else {
                        $(".detail-approved-by-display").addClass("d-none");
                    }
                    if(data.dateApproved) {
                        $("#details-approved-date").html(data.dateApproved)
                        $(".detail-approved-date-display").removeClass("d-none");
                    } else {
                        $(".detail-approved-date-display").addClass("d-none");
                    }
                    if(data.disapproveReason) {
                        $("#details-reason").html(data.disapproveReason);
                        $(".details-display-reason").removeClass("d-none");
                    } else {
                        $(".details-display-reason").addClass("d-none");
                    }
                    if(data.disapprovedBy) {
                        $("#details-disapproved-by").html(data.disapprovedBy);
                        $(".detail-disapproved-by-display").removeClass("d-none");
                    } else {
                        $(".detail-disapproved-by-display").addClass("d-none");
                    }
                    if(data.dateDisapproved) {
                        $("#details-disapproved-date").html(data.dateDisapproved)
                        $(".detail-disapproved-date-display").removeClass("d-none");
                    } else {
                        $(".detail-disapproved-date-display").addClass("d-none");
                    }
                }
            });
        }

        function UpdateTask(options) {
            swal({
                title: options.title,
                text: options.text,
                icon: "info",
                content: options.content || null,
                buttons: true
            }).then((confirm) => {
                if (!confirm) return;

                let extraData = {};
                if (options.requiresReason) {
                    let reason = $('#task-rejection').summernote('code');
                    if (!reason || reason === "<p><br></p>") {
                        swal("Error", "Please enter reason of rejection", "error");
                        return;
                    }
                    extraData.DisapproveReason = reason;
                }
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("UpdateTask", "Tracker")',
                    data: {
                        Id: task_data.id,
                        Module: task_data.module,
                        Summary: task_data.summary,
                        Function: task_data.function,
                        Behavior: task_data.behavior,
                        AccessControl: task_data.accessControl,
                        Status: options.status,
                        Priority: task_data.priority,
                        Assignee: task_data.assigneeId,
                        DueDate: task_data.dueDateD,
                        ...extraData
                    },
                    success: function (data) {
                        if (data.status === "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            LoadDetails();
                            LoadHistories();
                            $("#editModal").modal("hide");
                        }
                    }
                });
            });
        }

        if (task_user_access.canEdit) {
            function StartTask() {
                UpdateTask({
                    title: "Task Start Doing",
                    text: "Start doing this task",
                    status: "DOING"
                });
            }

            function TestTask() {
                UpdateTask({
                    title: "Task Test",
                    text: "Mark this task as deployed on Test Instance",
                    status: "TESTING"
                });
            }

            function AcceptTask() {
                UpdateTask({
                    title: "Task Accept",
                    text: "Accept the Task to deploy on Production.",
                    status: "FOR PRODUCTION"
                });
            }

            function RejectTask() {
                var content = document.createElement("div");
                var textarea = document.createElement("textarea");
                textarea.id = "task-rejection";
                content.appendChild(textarea);

                UpdateTask({
                    title: "Task Reject",
                    text: "Reject the Task to deploy on Production.",
                    status: "INCOMPLETE",
                    content: content,
                    requiresReason: true
                });

                setTimeout(() => {
                    $('#task-rejection').summernote({
                        placeholder: "Reason of Rejection",
                        height: 100,
                        toolbar: [
                            ['font', ['bold', 'italic', 'underline', 'clear']],
                            ['fontsize', ['fontsize']],
                            ['para', ['ul', 'ol', 'paragraph']],
                            ['insert', ['link']],
                            ['view', ['fullscreen', 'codeview']]
                        ],
                        callbacks: {
                            onInit: function () {
                                $('#task-rejection').next('.note-editor')
                                                    .find('.note-editable')
                                                    .css('text-align', 'left');
                            }
                        }
                    });
                }, 200);
            }

            function FixTask() {
                UpdateTask({
                    title: "Task Fix",
                    text: "Start fixing the rejected part",
                    status: "DOING"
                });
            }

            function ProdTask() {
                UpdateTask({
                    title: "Task Production",
                    text: "Task is deployed into Production",
                    status: "ON PRODUCTION"
                });
            }
        }

        function LoadHistories() {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetHistories", "Tracker")',
                data: {
                    TaskId: task_data.id
                },
                success: function (data) {
                    $(".history-container").html("");
                        $.each(data, function (i, v) {
                            $(".history-container").append(`
                                            <div class="timeline-item mb-3 position-relative">
                                                <div class="timeline-marker bg-black"></div>
                                                <div class="ms-5">
                                                    <p class="mb-1">${v.description}</p>
                                                    <p class="mb-0 text-muted small">${v.createdBy} performed this action on ${v.dateCreated}</p>
                                                </div>
                                            </div>`);
                        });
                }
            });
        }

        if (comment_user_access.canView) {
            function LoadComments() {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetComments", "Tracker")',
                    data: {
                        TaskId: task_data.id
                    },
                    success: function (data) {
                        $(".comment-container").html("");
                        $(".comment-counter").text(data.length);
                        if(data.length > 0){
                            $.each(data, function (i, v) {
                                const $card = $(`
                                                    <div class="card card-default">
                                                        <div class="card-header">
                                                            <div class="card-tools"></div>
                                                        </div>
                                                        <div class="card-body">
                                                            <div class="row mb-2">
                                                                <div class="col-12">
                                                                    ${v.content}
                                                                </div>
                                                            </div>

                                                            <div class="mt-3 d-flex gap-2">
                                                            </div>
                                                        </div>

                                                        <div class="card-footer text-muted small">
                                                            <div class="row">
                                                                ${ (v.modifiedBy || v.dateModified) ? `
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">👤</span>Created By: ${v.createdBy}</p>
                                                                    <p class="mb-1"><span class="emoji">📅</span>Date Created: ${v.dateCreated}</p>
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">✏️</span>Modified By: ${v.modifiedBy}</p>
                                                                    <p class="mb-1"><span class="emoji">📅</span>Date Modified: ${v.dateModified}</p>
                                                                </div>`
                                                                : `
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">👤</span>Created By: ${v.createdBy}</p>
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">📅</span>Date Created: ${v.dateCreated}</p>
                                                                </div>`
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>`);

                                const $tools = $card.find('.card-tools');
                                if (v.modifyExpiration) {
                                    $tools.append(JSRenderActionButton("Edit", "✏️", "btn-info ml-2", comment_user_access.canEdit, "Edit Comment.\nButton will expire in " + v.modifyExpiration, "Edit access is required.", () => ShowEditComment(v)));
                                    $tools.append(JSRenderActionButton("Delete", "🗑️", "btn-danger ml-2", comment_user_access.canDelete, "Delete Comment.\nButton will expire in " + v.modifyExpiration, "Delete access is required.", () => DeleteComment(v)));
                                } else {
                                    $tools.closest(".card-header").remove();
                                }

                                $(".comment-container").append($card);
                            });
                            $(".comment-counter").removeClass("d-none");
                        }
                        else
                        {
                            $(".comment-container").append('<em class="text-center text-muted">No comment(s) yet</em>');
                            $(".comment-counter").addClass("d-none");
                        }
                    }
                });
            }
        }

        if (comment_user_access.canAdd) {
            function ShowAddComment() {
                $("#addCommentModal").modal("show");
            }

            function AddComment() {
                var content = $("#add-comment-content").val();
                var error_msg = "";

                if(!content) error_msg += "<li>Please enter a Comment</li>";
                else if(content.length < 20) error_msg += "<li>Comment must be atleast 20 characters.</li>";

                if(error_msg) {
                    toastr.warning("<ul class='mb-0'>" + error_msg + "</ul>", "Form Validation");
                } else {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("AddComment", "Tracker")',
                        data: {
                            TaskId: task_data.id,
                            Content: $("#add-comment-content").val()
                        },
                        success: function (data) {
                            if (data.status == "Success") {
                                $("#addCommentModal").modal("hide");
                                $("#add-comment-content").summernote('code', '');
                                LoadHistories();
                                LoadComments();
                                toastr.success(data.message, data.status);
                            } else {
                                toastr.error(data.message, data.status);
                            }
                        }
                    });
                }
            }
        }

        if(comment_user_access.canEdit) {
            function ShowEditComment(comment) {
                $("#editCommentModal").modal("show");
                $("#edit-comment-content").data("Id", comment.id);
                $("#edit-comment-content").summernote("code", comment.content);
            }

            function EditComment() {
                var content = $("#edit-comment-content").val();
                var error_msg = "";

                if(!content) error_msg += "<li>Please enter a Comment</li>";
                else if(content.length < 20) error_msg += "<li>Comment must be atleast 20 characters.</li>";

                if(error_msg) {
                    toastr.warning("<ul class='mb-0'>" + error_msg + "</ul>", "Form Validation");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("UpdateComment", "Tracker")",
                        data: {
                            Id: $("#edit-comment-content").data("Id"),
                            TaskId: task_data.id,
                            Content: $("#edit-comment-content").summernote("code")
                        },
                        success: function (data) {
                            if (data.status == "Success") {
                                $("#editCommentModal").modal("hide");
                                $("#edit-comment-content").summernote("code", "");
                                LoadHistories();
                                LoadComments();
                                toastr.success(data.message, data.status);
                            } else {
                                toastr.error(data.message, data.status);
                            }
                        }
                    });
                }
            }
        }

        if (comment_user_access.canDelete) {
            function DeleteComment(comment) {
                swal({
                    title: "Delete Comment",
                    text: "Are you sure you want to delete this record? Deletion is only allowed from the time of creation up to 1 hour.",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("DeleteComment", "Tracker")",
                            type: "POST",
                            data: {
                                Id: comment.id,
                                TaskId: task_data.id
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    LoadHistories();
                                    LoadComments();
                                    toastr.success(data.message, data.status);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            }
        }

        if (issue_user_access.canView) {
            function LoadIssues() {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetIssues", "Tracker")',
                    data: {
                        TaskId: task_data.id
                    },
                    success: function (data) {
                        $(".issue-container").html("");
                        $(".issue-counter").text(data.filter(x => x.status.toLowerCase() != "fixed").length);
                        if(data.length > 0){
                            $.each(data, function (i, v) {
                                const priorityMap = {
                                    critical: '🟥 CRITICAL',
                                    high: '🟧 HIGH',
                                    medium: '🟨 MEDIUM',
                                    low: '🟩 LOW'
                                };

                                const severity = priorityMap[v.priority?.toLowerCase()] || '⬜ TRIVIAL';

                                const $card = $(`
                                    <div class="card card-default">
                                        <div class="card-header">
                                            <span class="card-title">${v.summary}</span>
                                            <div class="card-tools"></div>
                                        </div>
                                        <div class="card-body">
                                            <div class="row mb-2">
                                                <div class="col-md-6"><strong>Status:</strong> ${v.status}</div>
                                                <div class="col-md-6"><strong>Severity:</strong> <span class="emoji">${severity.split(' ')[0]}</span> ${severity.split(' ')[1]}</div>
                                            </div>
                                            <div class="mb-2"><span class="text-muted">Description</span><div>${v.description}</div></div>
                                            <div class="mb-2"><span class="text-muted">Steps to Replicate</span><div>${v.replication}</div></div>
                                            <div class="mb-2"><span class="text-muted">Solution</span><div>${v.resolution || '<p class="text-muted">Not yet provided</p>'}</div></div>
                                            <div class="mt-3 d-flex gap-2"></div>
                                        </div>
                                        <div class="card-footer text-muted small">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <p class="mb-1"><span class="emoji">👤</span>Created By: ${v.createdBy}</p>
                                                    <p class="mb-1"><span class="emoji">📅</span>Date Created: ${v.dateCreated}</p>
                                                </div>
                                                ${ (v.modifiedBy || v.dateModified) ? `
                                                <div class="col-md-4">
                                                    <p class="mb-1"><span class="emoji">✏️</span>Modified By: ${v.modifiedBy}</p>
                                                    <p class="mb-1"><span class="emoji">📅</span>Date Modified: ${v.dateModified}</p>
                                                </div>`
                                                : ``
                                                }
                                                <div class="col-md-4">
                                                    <p class="mb-1"><span class="emoji">✅</span>Fixed By: ${v.fixedBy || '<span class="text-muted">Not yet fixed</span>'}</p>
                                                    <p class="mb-1"><span class="emoji">📅</span>Date Fixed: ${v.dateFixed || '<span class="text-muted">Not yet fixed</span>'}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `);

                                const $tools = $card.find('.card-tools');
                                const status = v.status.toLowerCase();
                                if (status === 'reopened') {
                                    $tools.append(JSRenderActionButton("Start Doing", "🔄", "btn-primary ml-2", issue_user_access.canEdit, null, "Edit access is required.", () => StartIssue(v)));
                                } else if (status === 'open') {
                                    $tools.append(JSRenderActionButton("Start Doing", "🔄", "btn-primary ml-2", issue_user_access.canEdit, null, "Edit access is required.", () => StartIssue(v)));
                                    if (v.modifyExpiration) {
                                        $tools.append(JSRenderActionButton("Edit", "✏️", "btn-info ml-2", issue_user_access.canEdit, "Edit Comment.\nButton is only available for task with Open status.\nButton will expire in " + v.modifyExpiration, "Edit access is required.", () => ShowEditIssue(v)));
                                        $tools.append(JSRenderActionButton("Delete", "🗑️", "btn-danger ml-2", issue_user_access.canDelete, "Delete Comment.\nButton is only available for task with Open status.\nButton will expire in " + v.modifyExpiration, "Delete access is required.", () => DeleteIssue(v)));
                                    }
                                } else if (status === 'doing') {
                                    $tools.append(JSRenderActionButton("Mark as Fixed", "✅", "btn-success ml-2", issue_user_access.canEdit, null, "Edit access is required.", () => FixedIssue(v)));
                                } else if (status === 'fixed') {
                                    $tools.append(JSRenderActionButton("Reopen", "🔄", "btn-warning ml-2", issue_user_access.canEdit, null, "Edit access is required.", () => ReopenIssue(v)));
                                }

                                $(".issue-container").append($card);
                            });

                            $(".issue-counter").removeClass("d-none");
                        }
                        else
                        {
                            $(".issue-container").append('<em class="text-center text-muted">No issue(s) found</em>');
                            $(".issue-counter").addClass("d-none");
                        }
                    }
                });
            }
        }

        if(issue_user_access.canAdd) {
            function ShowAddIssue() {
                $("#addIssueModal").modal("show");
            }

            function AddIssue() {
                var summary = $("#add-issue-summary").val();
                var description = $($('#add-issue-description').summernote('code')).text();
                var replication = $($('#add-issue-replication').summernote('code')).text();
                var error_msg = "";

                if(!summary) error_msg += "<li>Please enter Summary</li>";
                else if(summary.length > 100) error_msg += "<li>Summary must not exceed 100 characters.</li>";
                if(!description) error_msg += "<li>Please enter a message in Description</li>";
                else if(description.length < 20) error_msg += "<li>Description must be atleasst 20 characters.</li>";
                if(!replication) error_msg += "<li>Please enter a message in Replication</li>";
                else if(replication.length < 20) error_msg += "<li>Replication must be atleasst 20 characters.</li>";

                if(error_msg) {
                    toastr.warning("<ul class='mb-0'>" + error_msg + "</ul>", "Form Validation");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("AddIssue", "Tracker")",
                        data: {
                            TaskId: task_data.id,
                            Summary: $("#add-issue-summary").val(),
                            Description: $('#add-issue-description').summernote('code'),
                            Replication: $("#add-issue-replication").summernote('code'),
                            Severity: $("#add-issue-severity").val(),
                            Status: "OPEN",
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                LoadHistories();
                                LoadIssues();
                                $("#addIssueModal").modal("hide");
                            }
                        }
                    });
                }
            }
        }

        if (issue_user_access.canEdit) {
            function ShowEditIssue(issue) {
                $("#editIssueModal").modal("show");
                $("#edit-issue-summary").data("Id", issue.id);
                $("#edit-issue-summary").val(issue.summary);
                $("#edit-issue-description").summernote("code", issue.description);
                $("#edit-issue-replication").summernote("code", issue.replication);
                $("#edit-issue-severity").val(issue.severity).trigger("change");
            }

            function EditIssue() {
                var description = $($('#edit-issue-description').summernote('code')).text();
                var replication = $($('#edit-issue-replication').summernote('code')).text();
                var error_msg = "";

                if(!description) error_msg += "<li>Please enter a message in Description</li>";
                else if(description.length < 20) error_msg += "<li>Description must be atleasst 20 characters.</li>";
                if(!replication) error_msg += "<li>Please enter a message in Replication</li>";
                else if(replication.length < 20) error_msg += "<li>Replication must be atleasst 20 characters.</li>";

                if(error_msg) {
                    toastr.warning("<ul class='mb-0'>" + error_msg + "</ul>", "Form Validation");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("UpdateIssue", "Tracker")",
                        data: {
                            Id: $("#edit-issue-summary").data("Id"),
                            TaskId: task_data.id,
                            Description: $('#edit-issue-description').summernote('code'),
                            Replication: $("#edit-issue-replication").summernote('code'),
                            Severity: $("#edit-issue-severity").val(),
                            Status: "OPEN",
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                LoadHistories();
                                LoadIssues();
                                $("#editIssueModal").modal("hide");
                            }
                        }
                    });
                }
            }

            function StartIssue(issue) {
                swal({
                    title: "Issue Start Doing",
                    text: "Start doing this issue",
                    icon: "info",
                    buttons: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("UpdateIssue", "Tracker")",
                            type: "POST",
                            data: {
                                Id: issue.id,
                                Summary: issue.summary,
                                TaskId: task_data.id,
                                Description: issue.description,
                                Replication: issue.replication,
                                Severity: issue.severity,
                                Status: "DOING"
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    LoadHistories();
                                    LoadIssues();
                                    toastr.success(data.message, data.status);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            }

            function FixedIssue(issue) {
                var content = document.createElement("div");

                var textarea = document.createElement("textarea");
                textarea.id = "issue-fixed-resolution";
                // textarea.className = "swal-content__textarea";
                content.appendChild(textarea);

                var inputDate = document.createElement("input");
                inputDate.type = "date";
                inputDate.id = "issue-fixed-date";
                inputDate.className = "swal-content__input";
                inputDate.style.marginTop = "15px";
                inputDate.value = DateForInput(new Date());
                content.appendChild(inputDate);

                swal({
                    title: "Issue Fix",
                    text: "Mark this issue as Fixed.",
                    icon: "info",
                    content: content,
                    buttons: true
                }).then((confirm) => {
                    if (confirm) {
                        var text = $($('#issue-fixed-resolution').summernote('code')).text();
                        var date = document.getElementById("issue-fixed-date").value;

                        if (!text || text === "<p><br></p>" || !date) {
                            swal("Error", "Please enter both fields", "error");
                            return;
                        }

                        $.ajax({
                            url: "@Url.Action("UpdateIssue", "Tracker")",
                            type: "POST",
                            data: {
                                Id: issue.id,
                                TaskId: task_data.id,
                                Summary: issue.summary,
                                Description: issue.description,
                                Replication: issue.replication,
                                Severity: issue.severity,
                                Resolution: text,
                                DateFixed: date,
                                Status: "FIXED"
                            },
                            success: function (data) {
                                if (data.status == "Success") {
                                    LoadHistories();
                                    LoadIssues();
                                    toastr.success(data.message, data.status);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });

                setTimeout(() => {
                    $('#issue-fixed-resolution').summernote({
                        placeholder: "Resolution",
                        height: 100,
                        toolbar: [
                            ['font', ['bold', 'italic', 'underline', 'clear']],
                            ['fontsize', ['fontsize']],
                            ['para', ['ul', 'ol', 'paragraph']],
                            ['insert', ['link']],
                            ['view', ['fullscreen', 'codeview']]
                        ],
                        callbacks: {
                            onInit: function() {
                                $('#issue-fixed-resolution').next('.note-editor')
                                                            .find('.note-editable')
                                                            .css('text-align', 'left');
                            }
                        }
                    });
                }, 200);
            }


            function ReopenIssue(issue) {
                swal({
                    title: "Issue Reopen",
                    text: "Mark this issue as Reopened Issue.",
                    icon: "info",
                    buttons: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("UpdateIssue", "Tracker")",
                            type: "POST",
                            data: {
                                Id: issue.id,
                                TaskId: task_data.id,
                                Summary: issue.summary,
                                Description: issue.description,
                                Replication: issue.replication,
                                Severity: issue.severity,
                                Resolution: null,
                                DateFixed: null,
                                Status: "REOPENED"
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    LoadHistories();
                                    LoadIssues();
                                    toastr.success(data.message, data.status);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            }
        }

        if (issue_user_access.canDelete) {
            function DeleteIssue(issue) {
                swal({
                    title: "Delete Issue",
                    text: "Are you sure you want to delete this record? Deletion is only allowed from the time of creation up to 24 hours.",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("DeleteIssue", "Tracker")",
                            type: "POST",
                            data: {
                                Id: issue.id,
                                TaskId: task_data.id
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    LoadHistories();
                                    LoadIssues();
                                    toastr.success(data.message, data.status);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            }
        }
    </script>
}
