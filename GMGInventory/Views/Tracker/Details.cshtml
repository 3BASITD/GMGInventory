@using Microsoft.AspNetCore.Html
@model TaskDetailsVM

@{
    ViewData["Title"] = "Task";
    var taskUserAccess = (ViewsAccessVM)ViewData["TaskUserAccess"]!;
    var commentUserAccess = (ViewsAccessVM)ViewData["CommentUserAccess"]!;
    var issueUserAccess = (ViewsAccessVM)ViewData["IssueUserAccess"]!;
}

@functions {
    public IHtmlContent RenderActionButton(string label, string emoji, string btnClass, bool canAct, string? tooltipCanAct, string tooltipCantAct, string? onclick)
    {
        var button = new TagBuilder("button");
        button.Attributes["type"] = "button";
        button.AddCssClass($"btn btn-sm {btnClass}");


        if (!canAct)
        {
            button.AddCssClass("ui-state-disabled");
            button.Attributes["data-microtip-title"] = tooltipCantAct;
            button.Attributes["data-microtip-position"] = "top-left";
            button.Attributes["role"] = "tooltip";
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(tooltipCanAct))
            {
                button.Attributes["data-microtip-title"] = tooltipCanAct;
                button.Attributes["data-microtip-position"] = "top-left";
                button.Attributes["role"] = "tooltip";
            }
            if (!string.IsNullOrWhiteSpace(onclick))
            {
                button.Attributes["onclick"] = onclick;
            }
        }

        button.InnerHtml.AppendHtml($"<span class=\"emoji\">{emoji}</span> {label}");
        return button;
    }
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Tracker" asp-action="Index">Task Tracker</a></li>
}

<div class="card @(Model.Status.Equals("doing", StringComparison.OrdinalIgnoreCase) ? "card-primary"
                                : Model.Status.Equals("testing", StringComparison.OrdinalIgnoreCase) ? "card-warning"
                                : Model.Status.Equals("incomplete", StringComparison.OrdinalIgnoreCase) ? "card-danger"
                                : Model.Status.Equals("for production", StringComparison.OrdinalIgnoreCase) ? "card-info"
                                : Model.Status.Equals("on production", StringComparison.OrdinalIgnoreCase) ? "card-success"
                                : "card-default") card-for-task">
    <div class="card-header">
        <span class="card-title">
            <span class="h4">@Model.Number</span>
            <span class="emoji">📋</span>
            <span class="text-muted">&#91;@Model.Module&#93;</span> <strong>@Model.Summary</strong>
        </span>
        <div class="card-tools details-tools-container">
            @if (Model.Status.Equals("open", StringComparison.OrdinalIgnoreCase))
            {
                @* @if (!string.IsNullOrWhiteSpace(Model.ModifyExpiration))
                {
                    @RenderActionButton("Edit", "✏️", "btn-info ml-2", taskUserAccess.CanEdit, "Button expires in " + Model.ModifyExpiration, "Edit access is required.", "EditTask()")
                    @RenderActionButton("Delete", "🗑️", "btn-danger ml-2", taskUserAccess.CanDelete, "Button expires in " + Model.ModifyExpiration, "Delete access is required.", "DeleteTask()")
                } *@
                @RenderActionButton("Start Doing", "🔄", "btn-primary ml-2", taskUserAccess.CanEdit, null, "Edit access is required.", "StartTask()")
            }
            else if (Model.Status.Equals("doing", StringComparison.OrdinalIgnoreCase))
            {
                @RenderActionButton("Deploy for Testing", "🧪", "btn-warning  ml-2", taskUserAccess.CanEdit, null, "Edit access is required.", "TestTask()")
            }
            else if (Model.Status.Equals("testing", StringComparison.OrdinalIgnoreCase))
            {
                @RenderActionButton("Accept", "✅", "btn-success  ml-2", taskUserAccess.CanApproveDisapprove && Model.IsAssignee == false, null, "Approve / Disapprove access is required and should not be the Assignee.", "AcceptTask()")
                @RenderActionButton("Reject", "❌", "btn-danger  ml-2", taskUserAccess.CanApproveDisapprove && Model.IsAssignee == false, null, "Approve / Disapprove access is required and should not be the Assignee.", "RejectTask()")
            }
            else if (Model.Status.Equals("incomplete", StringComparison.OrdinalIgnoreCase))
            {
                @RenderActionButton("Fix", "🔧", "btn-primary  ml-2", taskUserAccess.CanEdit, null, "Edit access is required.", "FixTask()")
            }
            else if (Model.Status.Equals("for production", StringComparison.OrdinalIgnoreCase))
            {
                @RenderActionButton("Deploy in Production", "🔧", "btn-primary  ml-2", taskUserAccess.CanEdit, null, "Edit access is required.", "ProdTask()")
            }
            <a class="btn btn-light text-dark btn-sm float-right ml-2" asp-controller="Tracker" asp-action="Details" asp-route-id="@Model.NextTaskId">
                <span class="emoji">⏵</span>
            </a>
            <a class="btn btn-light text-dark btn-sm float-right ml-2" asp-controller="Tracker" asp-action="Details" asp-route-id="@Model.PreviousTaskId">
                <span class="emoji">⏴</span>
            </a>
            <a class="btn btn-light text-dark btn-sm float-right ml-2" asp-action="Index">
                <span class="emoji">🔙</span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-lg-8">
                <div class="card card-default">
                    <div class="card-body">
                        <div class="container">
                            <div class="row mb-2 details-display-reason @(string.IsNullOrWhiteSpace(Model.DisapproveReason) ? "d-none" : "")">
                                <div class="col-12">
                                    <div class="alert alert-danger" role="alert">
                                        <strong>Reason of Disapproval</strong>
                                        <div id="details-reason">
                                            @Html.Raw(Model.DisapproveReason)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2 pb-2 border-bottom">
                                <div class="col-12">
                                    <span class="text-muted">Function</span>
                                    <div id="details-function">
                                        @Html.Raw(Model.Function)
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2 pb-2 border-bottom">
                                <div class="col-12">
                                    <span class="text-muted">Behavior</span>
                                    <div id="details-behavior">
                                        @Html.Raw(Model.Behavior)
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-12">
                                    <span class="text-muted">Access Control</span>
                                    <div id="details-access">
                                        @Html.Raw(Model.AccessControl)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card card-info">
                    <div class="card-header">
                        <ul class="nav nav-tabs card-header-tabs">
                            <li class="nav-item">
                                <a class="nav-link px-3 active" id="nav-history-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-history"
                                   aria-controls="nav-history" aria-selected="true">
                                    <span class="emoji">🕓</span>History
                                </a>
                            </li>
                            @if (commentUserAccess.CanView)
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" id="nav-comment-tab" role="tab"
                                       data-bs-toggle="tab" data-bs-target="#nav-comment"
                                       aria-controls="nav-comment" aria-selected="true">
                                        <span class="emoji">💬</span>Comment
                                        <span class="comment-counter badge rounded-pill bg-invert ml-2 px-2@(Model.CommentCount == 0 ? " d-none" : "")">@Model.CommentCount</span>
                                    </a>
                                </li>
                            }
                            @if (issueUserAccess.CanView)
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" id="nav-issue-tab" role="tab"
                                       data-bs-toggle="tab" data-bs-target="#nav-issue"
                                       aria-controls="nav-issue" aria-selected="true">
                                        <span class="emoji">🐞</span>Issue
                                        <span class="issue-counter badge rounded-pill bg-danger ml-2 px-2@(Model.IssueCount == 0 ? " d-none" : "")">@Model.IssueCount</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-history" role="tabpanel"
                                 aria-labelledby="nav-history-tab">
                                <div class="container history-container timeline py-2">
                                    @foreach (var History in Model.Histories)
                                    {
                                        <div class="timeline-item mb-3 position-relative">
                                            <div class="timeline-marker bg-gradient-gray"></div>
                                            <div class="ms-5">
                                                <p class="mb-1">@History.Description</p>
                                                <p class="mb-0 text-muted small">@History.CreatedBy performed this action on @History.DateCreated</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (commentUserAccess.CanView)
                            {
                                <div class="tab-pane fade" id="nav-comment" role="tabpanel" aria-labelledby="nav-comment-tab">
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-12">
                                                @RenderActionButton("New Comment", "📩", "btn-secondary w-100", commentUserAccess.CanAdd, null, "Add access is required.", "ShowAddComment()")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="container comment-container pt-3">
                                        @if (Model.Comments.Count() > 0)
                                        {
                                            @foreach (var Comment in Model.Comments)
                                            {
                                                <div class="card card-default">
                                                    @if (!string.IsNullOrWhiteSpace(Comment.ModifyExpiration))
                                                    {
                                                        <div class="card-header">
                                                            <div class="card-tools">
                                                                @RenderActionButton("Edit", "✏️", "btn-info ml-2", commentUserAccess.CanEdit, "Button expires in " + Comment.ModifyExpiration, "Edit access is required.", "ShowEditComment(" + Json.Serialize(Comment) + ")")
                                                                @RenderActionButton("Delete", "🗑️", "btn-danger ml-2", commentUserAccess.CanDelete, "Button expires in " + Comment.ModifyExpiration, "Delete access is required.", "DeleteComment(" + Json.Serialize(Comment) + ")")
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="card-body">
                                                        <div class="row mb-2">
                                                            <div class="col-12">
                                                                @Html.Raw(Comment.Content)
                                                            </div>
                                                        </div>

                                                        <div class="mt-3 d-flex gap-2">
                                                        </div>
                                                    </div>

                                                    <div class="card-footer text-muted small">
                                                        <div class="row">
                                                            @if (!string.IsNullOrWhiteSpace(Comment.ModifiedBy) || Comment.DateModifiedD != null)
                                                            {
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">👤</span>Created By: @Comment.CreatedBy</p>
                                                                    <p class="mb-1"><span class="emoji">📅</span>Date Created: @Comment.DateCreated</p>
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">✏️</span>Modified By: @Comment.ModifiedBy</p>
                                                                    <p class="mb-1"><span class="emoji">📅</span>Date Modified: @Comment.DateModified</p>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">👤</span>Created By: @Comment.CreatedBy</p>
                                                                </div>
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">📅</span>Date Created: @Comment.DateCreated</p>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <em class="text-center text-muted">No comment(s) yet</em>
                                        }
                                    </div>
                                </div>
                            }
                            @if (issueUserAccess.CanView)
                            {
                                <div class="tab-pane fade" id="nav-issue" role="tabpanel" aria-labelledby="nav-issue-tab">
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-12">
                                                @RenderActionButton("New Issue", "📛", "btn-secondary w-100", issueUserAccess.CanAdd, null, "Add access is required.", "ShowAddIssue()")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="container issue-container py-2">
                                        @if (Model.Issues.Count() > 0)
                                        {
                                            @foreach (var Issue in Model.Issues)
                                            {
                                                <div class="card card-default">
                                                    <div class="card-header">
                                                        <span class="card-title">@Issue.Summary</span>
                                                        <div class="card-tools">
                                                            @if (Issue.Status.Equals("reopened", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                @RenderActionButton("Start Doing", "🔄", "btn-primary ml-2", issueUserAccess.CanEdit, null, "Edit access is required.", "StartIssue(" + Json.Serialize(Issue) + ")")
                                                            }
                                                            else if (Issue.Status.Equals("open", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                @RenderActionButton("Start Doing", "🔄", "btn-primary ml-2", issueUserAccess.CanEdit, null, "Edit access is required.", "StartIssue(" + Json.Serialize(Issue) + ")")
                                                                if (!string.IsNullOrWhiteSpace(Issue.ModifyExpiration))
                                                                {
                                                                    @RenderActionButton("Edit", "✏️", "btn-info ml-2", issueUserAccess.CanEdit, "Button expires in " + Issue.ModifyExpiration, "Edit access is required.", "ShowEditIssue(" + Json.Serialize(Issue) + ")")
                                                                    @RenderActionButton("Delete", "🗑️", "btn-danger ml-2", issueUserAccess.CanDelete, "Button expires in " + Issue.ModifyExpiration, "Delete access is required.", "DeleteIssue(" + Json.Serialize(Issue) + ")")
                                                                }
                                                            }
                                                            else if (Issue.Status.Equals("doing", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                @RenderActionButton("Mark as Fixed", "✅", "btn-success ml-2", issueUserAccess.CanEdit, null, "Edit access is required.", "FixedIssue(" + Json.Serialize(Issue) + ")")
                                                            }
                                                            else if (Issue.Status.Equals("fixed", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                @RenderActionButton("Reopen", "🔄", "btn-warning ml-2", issueUserAccess.CanEdit, null, "Edit access is required.", "ReopenIssue(" + Json.Serialize(Issue) + ")")
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="card-body">
                                                        <div class="row mb-2">
                                                            <div class="col-md-6">
                                                                <strong>Status:</strong> @Issue.Status
                                                            </div>
                                                            <div class="col-md-6">
                                                                <strong>Severity:</strong>
                                                                @if (Model.Priority.ToLower() == "critical")
                                                                {
                                                                    <span class="emoji">🟥</span>
                                                                    <text>CRITICAL</text>
                                                                }
                                                                else if (Model.Priority.ToLower() == "high")
                                                                {
                                                                    <span class="emoji">🟧</span>
                                                                    <text>HIGH</text>
                                                                }
                                                                else if (Model.Priority.ToLower() == "medium")
                                                                {
                                                                    <span class="emoji">🟨</span>
                                                                    <text>MEDIUM</text>
                                                                }
                                                                else if (Model.Priority.ToLower() == "medium")
                                                                {
                                                                    <span class="emoji">🟩</span>
                                                                    <text>LOW</text>
                                                                }
                                                                else
                                                                {
                                                                    <span class="emoji">⬜</span>
                                                                    <text>TRIVIAL</text>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="mb-2">
                                                            <span class="text-muted">Description</span>
                                                            <div>
                                                                @Html.Raw(Issue.Description)
                                                            </div>
                                                        </div>
                                                        <div class="mb-2">
                                                            <span class="text-muted">Steps to Replicate</span>
                                                            <div>
                                                                @Html.Raw(Issue.Replication)
                                                            </div>
                                                        </div>
                                                        <div class="mb-2">
                                                            <span class="text-muted">Solution</span>
                                                            <div>
                                                                @if (string.IsNullOrWhiteSpace(Issue.Resolution))
                                                                {
                                                                    <p class="text-muted">Not yet provided</p>
                                                                }
                                                                else
                                                                {
                                                                    @Html.Raw(Issue.Resolution)
                                                                }
                                                            </div>
                                                        </div>

                                                        <div class="mt-3 d-flex gap-2">
                                                        </div>
                                                    </div>

                                                    <div class="card-footer text-muted small">
                                                        <div class="row">
                                                            <div class="col-md-4">
                                                                <p class="mb-1"><span class="emoji">👤</span>Created By: @Issue.CreatedBy</p>
                                                                <p class="mb-1"><span class="emoji">📅</span>Date Created: @Issue.DateCreated</p>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(Issue.ModifiedBy) || Issue.DateModifiedD != null)
                                                            {
                                                                <div class="col-md-4">
                                                                    <p class="mb-1"><span class="emoji">✏️</span>Modified By: @Issue.ModifiedBy</p>
                                                                    <p class="mb-1"><span class="emoji">📅</span>Date Modified: @Issue.DateModified</p>
                                                                </div>
                                                            }
                                                            <div class="col-md-4">
                                                                <p class="mb-1">
                                                                    <span class="emoji">✅</span>Fixed By:
                                                                    @if (string.IsNullOrWhiteSpace(Issue.FixedBy))
                                                                    {
                                                                        @Html.Raw("<span class=\"text-muted\">Not yet fixed</span>")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.Raw(Issue.FixedBy)
                                                                    }
                                                                </p>
                                                                <p class="mb-1">
                                                                    <span class="emoji">📅</span>Date Fixed:
                                                                    @if (Issue.DateFixedD == null)
                                                                    {
                                                                        @Html.Raw("<span class=\"text-muted\">Not yet fixed</span>")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.Raw(Issue.DateFixed)
                                                                    }
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <em class="text-center text-muted">No issue(s) found</em>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card card-default">
                    <div class="card-body">
                        <div class="container">
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted">Status</div>
                                <div id="details-status" class="col-sm-7">
                                    @Model.Status
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted">Priority</div>
                                <div id="details-priority" class="col-sm-7">
                                    @if (Model.Priority.ToLower() == "high")
                                    {
                                        <span class="emoji">🟧</span>
                                        <text>HIGH</text>
                                    }
                                    else if (Model.Priority.ToLower() == "medium")
                                    {
                                        <span class="emoji">🟨</span>
                                        <text>MEDIUM</text>
                                    }
                                    else
                                    {
                                        <span class="emoji">🟩</span>
                                        <text>LOW</text>
                                    }
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted">Assignee</div>
                                <div id="details-assignee" class="col-sm-7">@Model.Assignee</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted">Created By</div>
                                <div id="details-created-by" class="col-sm-7">@Model.CreatedBy</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted">Date Created</div>
                                <div id="details-created-date" class="col-sm-7">@Model.DateCreated</div>
                            </div>
                            <div class="row detail-modified-by-display mb-2 @(string.IsNullOrWhiteSpace(Model.ModifiedBy) ? "d-none" : "")">
                                <div class="col-sm-5 text-muted">Modified By</div>
                                <div id="details-modified-by" class="col-sm-7">@Model.ModifiedBy</div>
                            </div>
                            <div class="row detail-modified-date-display mb-2 @(string.IsNullOrWhiteSpace(Model.DateModified) ? "d-none" : "")">
                                <div class="col-sm-5 text-muted">Date Modified</div>
                                <div id="details-modified-date" class="col-sm-7">@Model.DateModified</div>
                            </div>
                            <div class="row detail-approved-by-display mb-2 @(string.IsNullOrWhiteSpace(Model.ApprovedBy) ? "d-none" : "")">
                                <div class="col-sm-5 text-muted">Tested & Approved By</div>
                                <div id="details-approved-by" class="col-sm-7">@Model.ApprovedBy</div>
                            </div>
                            <div class="row detail-approved-date-display mb-2 @(string.IsNullOrWhiteSpace(Model.DateApproved) ? "d-none" : "")">
                                <div class="col-sm-5 text-muted">Date Approved</div>
                                <div id="details-approved-date" class="col-sm-7">@Model.DateApproved</div>
                            </div>
                            <div class="row detail-disapproved-by-display mb-2 @(string.IsNullOrWhiteSpace(Model.DisapprovedBy) ? "d-none" : "")">
                                <div class="col-sm-5 text-muted">Tested & Disapproved By</div>
                                <div id="details-disapproved-by" class="col-sm-7">@Model.DisapprovedBy</div>
                            </div>
                            <div class="row detail-disapproved-date-display mb-2 @(string.IsNullOrWhiteSpace(Model.DateDisapproved) ? "d-none" : "")">
                                <div class="col-sm-5 text-muted">Date Disapproved</div>
                                <div id="details-disapproved-date" class="col-sm-7">@Model.DateDisapproved</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (commentUserAccess.CanAdd)
{
    <div class="modal fade" id="addCommentModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Comment</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="add-comment-content" class="form-label mb-0">Comment</label>
                                <textarea id="add-comment-content"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="AddComment()">
                        <span class="emoji">📩</span> Send
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="emoji">❌</span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (commentUserAccess.CanEdit)
{
    <div class="modal fade" id="editCommentModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Comment</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="edit-comment-content" class="form-label mb-0">Comment</label>
                                <textarea id="edit-comment-content"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="EditComment()">
                        <span class="emoji">✏️</span> Update
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="emoji">❌</span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (issueUserAccess.CanAdd)
{
    <div class="modal fade" id="addIssueModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
