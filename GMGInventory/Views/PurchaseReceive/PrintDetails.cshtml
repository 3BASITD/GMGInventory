@model PurchaseReceiveDetailsVM

@{
    Layout = "";
    var title = "Purchase Receiving Report";
    var items = ViewData["Items"] as List<PurchaseReceiveLineItemVM> ?? new List<PurchaseReceiveLineItemVM>();
    var userAccessBasic = (ViewsAccessVM)ViewData["UserAccessBasic"]!;
    var colcount = userAccessBasic.CanView ? 5 : 7;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <table class="formatted">
        <thead>
            <tr>
                <td colspan="@colcount" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col center w-150px">
                            @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                            {
                                <img src="~/images/BAS-02.png" class="logo" />
                            }
                            else
                            {
                                <img src="~/images/GMG-01.png" class="logo" />
                            }
                        </div>
                        <div class="sub-col center w-60pc p-50">
                            <span class="title">Document Classification:</span>
                            <span class="desc">
                                @title.ToUpper()
                                @if (Model.Status.ToLower() != "approved")
                                {
                                    @("(" + Model.Status + ")")
                                }
                            </span>
                        </div>
                        <div class="sub-col center w-40pc">
                            <span class="title">Date Receive:</span>
                            <span class="desc">@Model.ReceiveDate</span>
                            <hr />
                            <span class="title">Receiving No.:</span>
                            <span class="desc">@Model.DocumentNumber</span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="@colcount" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col w-50pc">
                            <div class="label">
                                <span>Supplier Name:</span>
                                <strong class="detail">@Model.Supplier</strong>
                            </div>
                            <div class="label">
                                <span>Ref. PO Number:</span>
                                <strong class="detail">@Model.PONumber</strong>
                            </div>
                            <div class="label">
                                <span>Warehouse:</span>
                                <strong class="detail">@Model.Warehouse</strong>
                            </div>
                        </div>
                        <div class="sub-col w-50pc">
                            <div class="label">
                                <span>Delivery Receipt #:</span>
                                <strong class="detail">@Model.DRNumber</strong>
                            </div>
                            <div class="label">
                                <span>Sales Invoice #:</span>
                                <strong class="detail">@Model.SINumber</strong>
                            </div>
                            <div class="label">
                                <span>Remarks:</span>
                                <strong class="detail">@Model.Remarks</strong>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <th style="min-width: 10px;">#</th>
                <th style="min-width: 50px;">PART NUMBER</th>
                <th>PARTICULARS</th>
                <th style="min-width: 50px;">QTY</th>
                <th style="min-width: 25px;">UOM</th>
                @if (!userAccessBasic.CanView)
                {
                    <th style="min-width: 50px;">UNIT PRICE</th>
                    <th style="min-width: 50px;">TOTAL AMOUNT</th>
                }

            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    <td>@item.ItemPartNumber</td>
                    <td>@item.ItemDescription</td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td>@item.UnitCode</td>
                    @if (!userAccessBasic.CanView)
                    {
                        <td class="right-text"><nobr>@item.UnitCost</nobr></td>
                        <td class="right-text"><nobr>@item.TotalAmount</nobr></td>
                    }
                </tr>
            }
            @{
                var itemCount = items.Count;
                var lastLineNumber = items.OrderByDescending(s => s.LineNumber).Select(s => s.LineNumber).First();
            }
            <tr>
                <td class="center-text" style="min-width: 10px;">@(lastLineNumber + 1)</td>
                <td></td>
                <td>* * NOTHING FOLLOWS * *</td>
                <td></td>
                <td></td>
                @if (!userAccessBasic.CanView)
                {
                    <td></td>
                    <td></td>
                }
            </tr>
            @if (itemCount < 23)
            {
                for (var ctr = 2; ctr <= 23 - itemCount; ctr++)
                {
                    <tr>
                        <td class="center-text" style="min-width: 10px;">@(lastLineNumber + ctr)</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        @if (!userAccessBasic.CanView)
                        {
                            <td></td>
                            <td></td>
                        }
                    </tr>
                }
            }
            <tr>
                <td colspan="5" class="bb-0 br-0"></td>
                 @if (!userAccessBasic.CanView)
                {
                    <td class="br-0 bb-0 bl-0">TOTAL AMOUNT</td>
                    <td class="right-text bb-0 bl-0"><strong>@items.Sum(s => s.TotalAmountD)</strong></td>
                }
            </tr>
            <tr>
                <td colspan="7">
                    <br />
                    <br />
                    <div class="two-column">
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.UserCreated</dd>
                                <dt>Prepared By</dt>
                            </dl>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.ApprovedBy</dd>
                                    <dt>Approved By</dt>
                                </dl>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.DisapprovedBy</dd>
                                    <dt>Disapproved By</dt>
                                </dl>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>