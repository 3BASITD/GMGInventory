@model PurchaseReceiveDetailsVM

@{
    Layout = "";
    var title = "Purchase Receive";
    var items = ViewData["Items"] as List<PurchaseReceiveLineItemVM> ?? new List<PurchaseReceiveLineItemVM>();

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3 class="center-text">@title</h3>
    <table class="table-header">
        <tr>
            <th>@Html.DisplayNameFor(model => model.DocumentNumber)</th>
            <td>@Model.DocumentNumber</td>
            <th>@Html.DisplayNameFor(model => model.UserCreated)</th>
            <td>@Model.UserCreated</td>
        </tr>
       
    </table>
    <table class="table-items no-border">
        <thead>
            <tr>
                <th class="min-width-50">
                    #
                </th>
                <th>
                    @Html.DisplayNameFor(_ => items[0].ItemCode)
                </th>
                <th>
                    @Html.DisplayNameFor(_ => items[0].ItemDescription)
                </th>
               
                <th>
                    @Html.DisplayNameFor(_ => items[0].Quantity)
                </th>
                <th>
                    @Html.DisplayNameFor(_ => items[0].UnitCode)
                </th>
                <th>
                    @Html.DisplayNameFor(_ => items[0].UnitCost)
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                var totalquantity = 0;
                foreach (var item in items)
                {
                    <tr>
                        <td class="min-width-50"><nobr>@item.LineNumber</nobr></td>
                        <td>@item.ItemCode</td>
                        <td>@item.ItemDescription</td>
                        <td class="right-text"><nobr>@item.Quantity</nobr></td>
                        <td>@item.UnitCode</td>
                        <td>@item.UnitCost</td>
                    </tr>
                    totalquantity += item.QuantityD;
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <th></th>
                <th></th>
                <th></th>
                <th class="right-text"><nobr>@totalquantity</nobr></th>
                <th class="left-text">Total</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
    <table class="table-header">
        <tr>
            <th colspan="3">@Html.DisplayNameFor(model => model.Remarks)</th>
        </tr>
        <tr>
            <td>@Model.DocumentNumber</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.UserCreated)</th>
            <th>@Html.DisplayNameFor(model => model.ApprovedBy)</th>
        </tr>
        <tr>
            <td>@Model.UserCreated</td>
            <td>@Model.ApprovedBy</td>
        </tr>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>