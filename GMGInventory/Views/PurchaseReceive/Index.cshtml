@model IEnumerable<PurchaseReceiveVM>

@{
    ViewData["Title"] = "Purchase Receive";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
    var hashMicroUserAccess = (ViewsAccessVM)ViewData["HashMicroUserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (hashMicroUserAccess.CanUploadDownload)
            {
                <button class="btn btn-light text-dark btn-sm float-right ml-2" onclick="MoveAllToHashMicro()">
                    <span class="fas fa-upload"></span> Move All to HashMicro
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Move All to HashMicro&#10;Upload Hash Micro access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-upload mr-0"></span>
                </button>
            }
            @if (userAccess.CanAdd)
            {
                <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Create">
                    <span class="fas fa-plus"></span> New Purchase Receive
                </a>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="New Purchase Receive&#10;Add access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-plus mr-0"></span>
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right ml-2 btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Download&#10;Download access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-download mr-0"></span>
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-receive">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Supplier)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Term)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Warehouse)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ReceiveDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Remarks)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-supplier" class="form-label mb-0">Supplier</label>
                            <select id="filter-supplier" style="width:100%"></select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-warehouse" class="form-label mb-0">Warehouse</label>
                            <select id="filter-warehouse" style="width:100%"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Receive Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="form-label mb-0">Receive Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@if (hashMicroUserAccess.CanUploadDownload)
{
    <div class="modal fade" id="viewHMModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">HashMicro Transfer Details</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-4">Document Number</dt>
                        <dd class="col-sm-8 hashmicro-document-number"></dd>
                        <dt class="col-sm-4">Move Id</dt>
                        <dd class="col-sm-8 hashmicro-move-id"></dd>
                        <dt class="col-sm-4">Move Name</dt>
                        <dd class="col-sm-8 hashmicro-move-name"></dd>
                        <dt class="col-sm-4">Status upon Moving</dt>
                        <dd class="col-sm-8 hashmicro-move-status"></dd>
                        <dt class="col-sm-4">Moved By</dt>
                        <dd class="col-sm-8 hashmicro-move-by"></dd>
                        <dt class="col-sm-4">Date Moved</dt>
                        <dd class="col-sm-8 hashmicro-move-date"></dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="viewAllHMModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Moving All to HashMicro Details</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row hashmicro-moving-info">
                    </div>
                    <table class="table table-head-fixed table-striped table-hover table-moveall">
                        <thead>
                            <tr>
                                <th>Purchase Receiving</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var hashmicro_user_access = @Html.Raw(Json.Serialize(hashMicroUserAccess));
        
        var date_today = new Date();
        var date_month_ago = new Date();
        date_month_ago.setMonth(date_month_ago.getMonth() - 1);

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);
        
        // Load Select2 for Supplier
        $("#filter-supplier").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Supplier")"
            },
            dropdownParent: $('#filterModal')
        });

        // $.ajax({
        //     type: "POST",
        //     url: "@Url.Action("GetOptions", "Supplier")",
        //     beforeSend: function (xhr, error) {
        //         showBatchLoader("supplier");
        //     },
        //     success: function (data, status, xhr) {
        //         $("#filter-supplier").select2({
        //             ajax: null, //already fetched outside
        //             minimumInputLength: -1,
        //             allowClear: true,
        //             placeholder: "ALL",
        //             templateResult: function (repo) {
        //                 if (repo.loading) {
        //                     return repo.text;
        //                 }
        //                 return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
        //             },
        //             data: data
        //         });
        //     },
        //     complete: function (xhr, status) {
        //         $("#filter-supplier").val(null).trigger("change");
        //         hideBatchLoader("supplier");
        //     }
        // });
        
        // Load Select2 for Warehouse
        $("#filter-warehouse").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Warehouse")"
            },
            dropdownParent: $('#filterModal'),
            minimumResultsForSearch: -1
        });

        // $.ajax({
        //     type: "POST",
        //     url: "@Url.Action("GetOptions", "Warehouse")",
        //     beforeSend: function (xhr, error) {
        //         showBatchLoader("warehouse");
        //     },
        //     success: function (data, status, xhr) {
        //         $("#filter-warehouse").select2({
        //             ajax: null, //already fetched outside
        //             minimumInputLength: -1,
        //             allowClear: true,
        //             placeholder: "ALL",
        //             templateResult: function (repo) {
        //                 if (repo.loading) {
        //                     return repo.text;
        //                 }
        //                 return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
        //             },
        //             data: data
        //         });
        //     },
        //     complete: function (xhr, status) {
        //         $("#filter-warehouse").val(null).trigger("change");
        //         hideBatchLoader("warehouse");
        //     }
        // });
        
        // Load Select2 for Status
        $("#filter-status").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return repo.text;
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "PurchaseStatus")"
            },
            dropdownParent: $('#filterModal'),
            minimumResultsForSearch: -1
        });

        // // Load status for select2
        // $.ajax({
        //     type: "POST",
        //     url: "@Url.Action("GetOptions", "PurchaseStatus")",
        //     beforeSend: function (xhr, error) {
        //         showBatchLoader("status");
        //     },
        //     success: function (data, status, xhr) {
        //         $("#filter-status").select2({
        //             ajax: null, //already fetched outside
        //             minimumResultsForSearch: -1,
        //             allowClear: true,
        //             placeholder: "ALL",
        //             data: data
        //         });
        //     },
        //     complete: function (xhr, status) {
        //         $("#filter-status").val(null).trigger("change");
        //         hideBatchLoader("status");
        //     }
        // });

        $(".btnFilter").on("click", function () {
            receiveDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            receiveDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        };

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            receiveDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[6, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            SupplierId: "",
            Supplier: "",
            WarehouseId: "",
            Warehouse: "",
            DateFrom: DateForInput(date_month_ago),
            DateTo: DateForInput(date_today),
            FiledBy: "everyone",
            StatusId: "",
            Status: ""
        };

        function checkDTChanged() {
            if(!receiveDT) return false;
            
            return JSON.stringify(receiveDT.order()) != JSON.stringify(defaultDTState.order) ||
                   receiveDT.page.info().start != defaultDTState.page ||
                   receiveDT.page.len() != defaultDTState.length ||
                   (receiveDT.search() || "") != defaultDTState.search.search ||
                   ($('#filter-supplier').val() ?? "") != defaultDTState.SupplierId ||
                   ($('#filter-warehouse').val() ?? "") != defaultDTState.WarehouseId ||
                   ($("#filter-from").val() ?? "") != defaultDTState.DateFrom ||
                   ($("#filter-to").val() ?? "") != defaultDTState.DateTo ||
                   ($("#filter-status").val() ?? "") != defaultDTState.StatusId;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
        }

        function resetToDefaultDTFilter() {
            $("#filter-supplier").val(defaultDTState.SupplierId).trigger('change');
            $("#filter-warehouse").val(defaultDTState.WarehouseId).trigger('change');
            $("#filter-from").val(defaultDTState.DateFrom);
            $("#filter-to").val(defaultDTState.DateTo);
            $("#filter-status").val(defaultDTState.StatusId).trigger('change');
            
            localStorage.removeItem(dt_storage);

            if (receiveDT) {
                receiveDT.state.clear();
                receiveDT.order(defaultDTState.order);
                receiveDT.page(defaultDTState.page);
                receiveDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        var receiveDT = $('.table-receive').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.SupplierId = $('#filter-supplier').val();
                data.Supplier = $('#filter-supplier option:selected').text();
                data.WarehouseId = $('#filter-warehouse').val();
                data.Warehouse = $('#filter-warehouse option:selected').text();
                data.DateFrom = $("#filter-from").val();
                data.DateTo = $("#filter-to").val();
                data.StatusId = $("#filter-status").val();
                data.Status = $('#filter-status option:selected').text();
            },
            stateLoadParams: function (settings, data) {
                if (data.SupplierId) {
                    var supplierOption = new Option(data.Supplier, data.SupplierId, true, true);
                    $(supplierOption).data('data', {
                        id: data.SupplierId,
                        text: data.Supplier
                    });
                    $("#filter-supplier").append(supplierOption).trigger('change');
                }
                if (data.WarehouseId) {
                    var warehouseOption = new Option(data.Warehouse, data.WarehouseId, true, true);
                    $(warehouseOption).data('data', {
                        id: data.WarehouseId,
                        text: data.Warehouse
                    });
                    $("#filter-warehouse").append(warehouseOption).trigger('change');
                }
                $("#filter-from").val(data.DateFrom);
                $("#filter-to").val(data.DateTo);
                if (data.StatusId) {
                    var statusOption = new Option(data.Status, data.StatusId, true, true);
                    $(statusOption).data('data', {
                        id: data.StatusId,
                        text: data.Status
                    });
                    $("#filter-status").append(statusOption).trigger('change');
                }
            },
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
                data: function (data) {
                    var supplierId = $('#filter-supplier').val();
                    if (supplierId) data.SupplierId = supplierId;
                    
                    var warehouseId = $('#filter-warehouse').val();
                    if (warehouseId) data.WarehouseId = warehouseId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    data.StatusId = $("#filter-status").val();
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "documentNumber", name: "DocumentNumber" },
                { 
                    data: function (data, type, dataToSet) {
                        return "<a href='/Supplier/Details/" + data.supplierId + "' class='link-info' target='_blank'>" + data.supplier + "</a>";
                    },
                    name: "Supplier"
                },
                { data: "term", name: "Term" },
                { 
                    data: function (data, type, dataToSet) {
                        return "<a href='/PurchaseOrder/Details/" + data.poId + "' class='link-info' target='_blank'>" + data.poNumber + "</a>-[" + data.poStatus + "]";
                    },
                    name: "PONumber"
                },
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Warehouse/Details/" + data.warehouseId + "' class='link-info' target='_blank'>" + data.warehouse + "</a>";
                    },
                    name: "Warehouse"
                },
                { data: "status", name: "Status" },
                { data: "receiveDate", name: "ReceiveDate" },
                {
                    data: function (data, type, dataToSet) {
                        return data.remarks || "<span class='text-muted'>N/A</span>";
                    },
                    name: "Remarks"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        if (hashmicro_user_access.canUploadDownload && (data.status.toLowerCase() == "draft" || data.status.toLowerCase() == "submitted" || data.status.toLowerCase() == "approved")) {
                            if(data.hashMicroMoveId) {
                                actions += '<button type="button" class="btn btn-secondary btn-xs" onclick="ViewHashMicro(this)" data-microtip-title="Already on HashMicro" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-cloud"></span></button>';
                            } else {
                                actions += '<button type="button" class="btn  btn-light text-dark btn-xs" onclick="MoveToHashMicro(this)" data-microtip-title="Move to HashMicro" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-upload"></span></button>';
                            }
                        }
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order,
            createdRow: function (row, data, dataIndex) {
                if (data.status.toLowerCase() == 'resubmitted') {
                    $(row).addClass('table-danger');
                    $(row).find("td").addClass('text-muted');
                } else if (data.status.toLowerCase() == 'disapproved') {
                    $(row).addClass('table-danger');
                    $(row).find('td:eq(5)').addClass('text-danger');
                } else if (data.status.toLowerCase() == 'approved') {
                    $(row).addClass('table-success');
                    $(row).find('td:eq(5)').addClass('text-success');
                }
            }
        });

        receiveDT.on("draw", function () {
            checkDefaultFilter();
        });

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-supplier").val()) { urlQuery.push("SupplierId=" + $("#filter-supplier").val()); }
                if ($("#filter-warehouse").val()) { urlQuery.push("WarehouseId=" + $("#filter-warehouse").val()); }
                if ($("#filter-status").val()) { urlQuery.push("StatusId=" + $("#filter-status").val()); }

                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());


                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }

        if (hashmicro_user_access.canUploadDownload) {
            function ViewHashMicro(preceiving) {
                var row = $(preceiving).parents("tr");
                var rowData = receiveDT.row(row).data();

                $(".hashmicro-document-number").html(rowData.documentNumber || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-id").html(rowData.hashMicroMoveId || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-name").html(rowData.hashMicroMoveName || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-status").html(rowData.hashMicroMoveStatus || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-by").html(rowData.hashMicroMoveBy || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-date").html(rowData.hashMicroMoveDate || '<span class="text-muted">Missing data</span>');

                $("#viewHMModal").modal("show");
            }

            function MoveAllToHashMicro() {
                var json = receiveDT.ajax.json();

                swal({
                    title: "Move All to HashMicro",
                    text: "This action will transfer all approved records to HashMicro. The process may take some time, depending on the number of records to be moved. Are you sure you want to proceed?",
                    content: {
                        element: "div",
                        attributes: {
                            innerHTML: `
                                Total Approved (within Filter Date): <strong>${json.totalQuantity}</strong><br/>
                                <strong>Total Approved (within Filter Date, Not yet moved): ${json.totalQuantity2}</strong><br/>
                                Filter Date From <strong>${formatDateEn(new Date($("#filter-from").val()))}</strong><br/>
                                Filter Date To <strong>${formatDateEn(new Date($("#filter-to").val()))}</strong><br/>
                                `
                        }
                    },
                    icon: "warning",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("MoveAllToHashMicro", "PurchaseReceive")",
                            type: "POST",
                            data: {
                                DateFrom: $("#filter-from").val(),
                                DateTo: $("#filter-to").val()
                            },
                            loaderMessage: "Please wait while this completes.<br><small class=\"text-muted\">Reloading the page will stop the process, so some records may be saved while others are not.</small>",
                            success: function (data, status, xhr) {
                                var success_ctr = 0;
                                $("table.table-moveall tbody").html("");
                                $.each(data, function (i, v) {
                                    $("table.table-moveall tbody").append(`<tr><td>${v.newRow}</td><td>${v.message}</td></tr>`);
                                    success_ctr++;
                                });
                                if(success_ctr > 0) {
                                    receiveDT.ajax.reload();
                                } else {
                                    $("table.table-moveall tbody").append(`<tr><td colspan="2" class="text-center text-muted"><em>Nothing was moved</em></td></tr>`);
                                }
                                $("#viewAllHMModal").modal("show");
                            }
                        });
                    }
                });
            }

            function MoveToHashMicro(preceiving) {
                var row = $(preceiving).parents("tr");
                var rowData = receiveDT.row(row).data();

                var msg = (rowData.status.toLowerCase() == "draft"
                              ? "Product receiving is currently on <strong>Draft</strong> and "
                              : rowData.status.toLowerCase() == "submitted"
                                  ? "Product receiving is currently <strong>Submitted</strong> and "
                                  : ""
                          ) + "Moving to HashMicro can only be done once. Are you sure you want to continue?";
                swal({
                    title: "Move to HashMicro",
                    content: {
                        element: "div",
                        attributes: {
                            style: "color: black;",
                            innerHTML: (rowData.status.toLowerCase() == "draft" ? "Product receiving is currently on <strong>Draft</strong> and " 
                                      : rowData.status.toLowerCase() == "submitted" ? "Product receiving is currently <strong>Submitted</strong> and "
                                      : "") + "Moving to HashMicro can only be done once. Are you sure you want to continue?"
                        }
                    },
                    icon: "warning",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("MoveToHashMicro", "PurchaseReceive")",
                            type: "POST",
                            data: {
                                Id: rowData.id,
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    receiveDT.ajax.reload();
                                    toastr.success(data.message, data.status);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            }
        }
    </script>
}