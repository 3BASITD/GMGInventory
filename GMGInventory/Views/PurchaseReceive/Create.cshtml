                            data: { PurchaseOrderId: $(this).val() },
                            success: function (data, status, xhr) {
                                if (data == "MR") {
                                    $(".add-code-container").toggle(false);
                                    $(".add-unit2-container").toggle(true);
                                }
                                else {
                                    $(".add-code-container").toggle(true);
                                    $(".add-unit2-container").toggle(false);
                                }
                            }
                        });
                    });
                } 
            });
        }

