@{
    if (TempData["PurchaseReceivingId"] != null)
    {
        ViewData["Title"] = "Resubmit Purchase Receive";
    }
    else
    {

        ViewData["Title"] = "New Purchase Receive";
    }
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseReceive" asp-action="Index">Purchase Receives</a></li>
}

<div class="card card-default">
    <form id="form-receive">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                    <span class="fas fa-paper-plane"></span> @(TempData["PurchaseReceiveId"] != null ? "Resubmit" : "Submit")
                </button>
                <input type="hidden" id="action-type" name="ActionType" value="">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                  <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-docNumber" class="form-label mb-0">Document Number</label>
                        <input type="text" id="receive-docNumber" name="DocumentNumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-poNumber" class="form-label mb-0">Purchase Order</label>
                        <select id="receive-poNumber" name="PurchaseOrder" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-deliveryReceiptNumber" class="form-label mb-0">Delivery Receipt Number</label>
                        <input type="text" id="receive-dRNumber" name="DeliveryReceiptNumber" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-sINumber" class="form-label mb-0">Sales Invoice Number</label>
                        <input type="text" id="receive-sINumber" name="SalesInvoiceNumber" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-supplier" class="form-label mb-0">Supplier</label>
                        <select id="receive-supplier" name="Supplier" style="width: 100%"></select>
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-warehouse" class="form-label mb-0">Warehouse</label>
                        <select id="receive-warehouse" name="Warehouse" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-term" class="form-label mb-0">Term</label>
                        <select id="receive-term" name="Term" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-discount1" class="form-label mb-0">Discount 1</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" max="100" id="receive-discount1" name="Discount1" class="form-control form-control-sm" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-discount2" class="form-label mb-0">Discount 2</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" max="100" id="receive-discount2" name="Discount2" class="form-control form-control-sm" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="date-received" class="form-label mb-0">Date Received</label>
                        <input type="date" id="date-received" name="DateReceived" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="receive-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
         

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Purchase Receive Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Item Code</th>
                                        <th>Item Description</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Cost</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th></th>
                                        <th class="total-cost">0</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Purchase Receive Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Purchase Receive Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6 add-code-container">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Item Code</label>
                                <select id="add-code" name="Code" style="width: 100%;">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-name-container">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Item Description</label>
                                <input type="text" id="add-name" name="Name" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 add-quantity-container">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" step="1" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-unit2-container">
                            <div class="form-group">
                                <label for="add-unit2" class="form-label mb-0">Unit</label>
                                <div>
                                    <select id="add-unit2" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                          <div class="col-12 col-sm-6 add-unit-container">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-cost">
                            <div class="form-group">
                                <label for="add-cost" class="form-label mb-0">Unit Cost</label>
                                <input type="number" min="0" max="1999999" step="1" id="add-cost" name="UnitCost" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

