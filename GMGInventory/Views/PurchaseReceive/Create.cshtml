@{
    if (TempData["PurchaseReceivingId"] != null)
    {
        ViewData["Title"] = "Resubmit Purchase Receive";
    }
    else
    {

        ViewData["Title"] = "New Purchase Receive";
    }
    var userAccessBasic = (ViewsAccessVM)ViewData["UserAccessBasic"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseReceive" asp-action="Index">Purchase Receives</a></li>
}

<div class="card card-default">
    <form id="form-receive">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                    <span class="fas fa-paper-plane"></span> @(TempData["PurchaseReceiveId"] != null ? "Resubmit" : "Submit")
                </button>
                <input type="hidden" id="action-type" name="ActionType" value="">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                  <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-docNumber" class="form-label mb-0">Document Number</label>
                        <input type="text" id="receive-docNumber" name="DocumentNumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6 ">
                    <div class="form-group">
                        <label for="receive-poNumber" class="form-label mb-0">Purchase Order</label>
                        <select id="receive-poNumber" name="PurchaseOrder" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-deliveryReceiptNumber" class="form-label mb-0">Delivery Receipt Number</label>
                        <input type="text" id="receive-dRNumber" name="DeliveryReceiptNumber" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-sINumber" class="form-label mb-0">Sales Invoice Number</label>
                        <input type="text" id="receive-sINumber" name="SalesInvoiceNumber" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-supplier" class="form-label mb-0">Supplier</label>
                        <input type="text" id="receive-supplier" name="Supplier" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-warehouse" class="form-label mb-0">Warehouse</label>
                        <input type="text" id="receive-warehouse" name="Warehouse" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-term" class="form-label mb-0">Term</label>
                        <input type="text" id="receive-term" name="Term" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-currency" class="form-label mb-0">Currency</label>
                        <input type="text" id="receive-currency" name="Currency" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-currencyRate" class="form-label mb-0">Currency Rate</label>
                        <input type="text" id="receive-currencyRate" name="Term" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-discount1" class="form-label mb-0">Discount 1</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" max="100" id="receive-discount1" name="Discount1" class="form-control form-control-sm" readonly="readonly" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-discount2" class="form-label mb-0">Discount 2</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" max="100" id="receive-discount2" name="Discount2" class="form-control form-control-sm" readonly="readonly" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-discount3" class="form-label mb-0">Discount 3</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" max="100" id="receive-discount3" name="Discount3" class="form-control form-control-sm" readonly="readonly" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-isVATIncluded" class="form-label mb-0">Is VAT Included</label>
                        <input type="text" id="receive-isVATIncluded" name="Term" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="date-received" class="form-label mb-0">Date Received</label>
                        <input type="date" id="date-received" name="DateReceived" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="receive-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
         

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Purchase Receive Item(s)</span>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Item Code</th>
                                        <th>Item Description</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Cost</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th></th>
                                        <th></th>
                                        <th class="total-amount">0.00</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@if (TempData["PurchaseReceivingId"] != null)
{
    <input type="hidden" id="resubmitPRId" value="@TempData["PurchaseReceivingId"]" />
}

@section Scripts {
    <script>
        var user_accessBasic = @Html.Raw(Json.Serialize(userAccessBasic));
        $("#date-received").val(DateForInput(new Date()));

        if ($("#resubmitPRId").length) {
            $("#receive-poNumber").prop('disabled', true);

            // for resubmitting a disapproved sales order
            $.ajax({
                type: "post",
                url: "@Url.Action("DetailsJson")",
                data: {
                    id: $("#resubmitPRId").val()
                },
                success: function (data, status, xhr) {
                    $("#receive-docNumber").val(data.documentNumber);
                    $("#receive-poNumber").val(data.poNumber);
                    $("#receive-supplier").val(data.supplier);
                    $("#receive-warehouse").val(data.warehouse);
                    $("#receive-term").val(data.term);
                    $("#receive-currency").val(data.currency);
                    $("#receive-currencyRate").val(data.currencyRate);
                    $("#receive-discount1").val(data.discount1);
                    $("#receive-discount2").val(data.discount2);
                    $("#receive-discount3").val(data.discount3);
                    $("#receive-isVATIncluded").val(data.isVATIncluded);

                    loadPONumberOptions(data.poId);
                },
                complete: function (xhr, status) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetItemListJson")",
                        data: {
                            purchaseReceiveId: $("#resubmitPRId").val()
                        },
                        success: function (data, status, xhr) {
                            $.each(data, function (i, v) {
                                itemDT.row.add(v).draw();
                            });
                        }
                    });
                }
            });
        } else {
            $("#receive-poNumber").prop('disabled', false);
            loadDocumentNumber();
            loadPONumberOptions(-1);
        }

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        return '<input type="checkbox" class="to-receive" ' + (data.toReceive == true ? 'checked="checked"' : '') +
                                     (data.toReceiveQuantityD == 0 ? 'disabled' : '') + ' />';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "-";
                        } else {
                            return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="bottom-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemDescription", name: "ItemDescription", className: "form-cell" },

                {
                    data: function (data, type, dataToSet) {
                        if (data.toReceive == true) {
                            if (data.quantityD > data.toReceiveQuantityD) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Can not exceed ' + data.toReceiveQuantityD + ' remaining order quantity.</label>';
                            } else if (data.quantityD == 0) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Nothing to receive.</label>';
                            } else {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                            }
                        } else {
                            return data.quantity;
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                { data: "unitCost", name: "UnitCost", className: "form-cell", visible: user_accessBasic.canView ? false : true },
                { 
                    data: "totalAmount",
                    name: "TotalAmount",
                    className: "form-cell",
                    render: function (data, type, row) {
                        if (type === 'display') {
                            return $("#receive-currency").val().split("/")[0].trim() + '&nbsp;' + data;
                        }

                        return data;
                    },
                    visible: user_accessBasic.canView ? false : true
                }
            ],
            order: [[1, "asc"]],
            createdRow: function (row, data, dataIndex) {
                if (data.toReceive == false) {
                    $(row).addClass('text-muted');
                }
            },
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalInteger(api, 4);
                columnDTTotalDecimal(api, 7, $("#receive-currency").val().split("/")[0].trim() + '&nbsp;');
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".quantity").off("change").on("change", function () {
                var row = itemDT.row($(this).closest('tr'));
                var rowData = row.data();

                var lineNumber = rowData.lineNumber;

                var quantityValue = parseFloat($(row.node()).find(".quantity").val()) || 0;

                var totalValue = quantityValue * rowData.unitCostD;

                rowData.quantity = FormatStringInteger(quantityValue);
                rowData.quantityD = quantityValue;
                rowData.totalAmount = FormatStringDecimal(totalValue);
                rowData.totalAmountD = totalValue;

                row.data(rowData).draw(false);

                setTimeout(function () {
                    var restoredRow = $(itemDT.row(function (idx, data) {
                        return data.lineNumber === lineNumber;
                    }).node());
                    if (restoredRow) {
                        var restoredInput = $(restoredRow).find(".quantity");

                        if (restoredInput.length)
                            restoredInput.focus();
                    }
                }, 0);
            });

            $(".to-receive").off("change").on("change", function () {
                var tr = $(this).closest('tr');
                var row = itemDT.row(tr);
                var rowData = row.data();

                if ($(this).prop("checked")) {

                    rowData.toReceive = true;
                    tr.removeClass("text-muted");

                    var quantityValue = rowData.toReceiveQuantityD;
                    var totalValue = quantityValue * rowData.unitCostD;

                    rowData.quantity = FormatStringInteger(quantityValue);
                    rowData.quantityD = quantityValue;

                    rowData.totalAmount = FormatStringDecimal(totalValue);
                    rowData.totalAmountD = totalValue;

                } else {
                    rowData.quantity = FormatStringInteger(0);
                    rowData.quantityD = 0;
                    rowData.totalAmount = FormatStringDecimal(0);
                    rowData.totalAmountD = 0;

                    rowData.toReceive = false;
                    tr.addClass("text-muted");
                }
                row.data(rowData).draw(false);
            });
        });

        function loadDocumentNumber() {
            if ($("#resubmitPOId").length == 0) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetNewDocumentNumber")",
                    success: function (data, status, xhr) {
                        $("#receive-docNumber").val(data);
                    }
                });
            }
        }

        function loadPONumberOptions(selectedOrder) {
            // Load Select2 Purchase Order
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseOrderOptions")",
                data: {
                    SelectedId:  selectedOrder
                },
                success: function (data, status, xhr) {
                    $("#receive-poNumber").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        minimumInputLength: -1,
                        placeholder: "<empty>"
                    }).off("select2:select").on("select2:select", function () {
                        loadPODetails();
                    }).off("select2:unselecting").on("select2:unselecting", function () {
                        $("#receive-supplier").val("");
                        $("#receive-warehouse").val("");
                        $("#receive-term").val("");
                        $("#receive-currency").val("");
                        $("#receive-currencyRate").val("0");
                        $("#receive-discount1").val("0");
                        $("#receive-discount2").val("0");
                        $("#receive-discount3").val("0");
                        $("#receive-isVATIncluded").val("");

                        $("#add-orderItem").val("").trigger("change");

                        itemDT.clear().draw();
                    });
                    if (selectedOrder == -1) {
                        $("#receive-poNumber").val(null).trigger('change');
                    } else {
                        loadPODetails();
                    }
                } 
            });
        }
     
        function loadPODetails() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("DetailsJson", "PurchaseOrder")",
                data: {
                    Id: $("#receive-poNumber").val()
                },
                success: function (data, status, xhr) {
                    $("#receive-supplier").val(data.supplier);
                    $("#receive-warehouse").val(data.deliveryAddress);
                    $("#receive-term").val(data.term);
                    $("#receive-currency").val(data.currency);
                    $("#receive-currencyRate").val(data.currencyRate);
                    $("#receive-discount1").val(data.discount1);
                    $("#receive-discount2").val(data.discount2);
                    $("#receive-discount3").val(data.discount3);
                    $("#receive-isVATIncluded").val(data.isVATIncluded);
                },
                complete: function (xhr, status) {
                    loadRRItems();
                }
            });
        }

        function GetItemsToReceive() {
            var item_to_receive = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));

                if (row_data.toReceive == true)
                       item_to_receive.push(row_data);
            });

            return item_to_receive;
        }

        function loadRRItems() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetItemsFromPOListJson")",
                data: {
                    purchaseOrderId: $("#receive-poNumber").val()
                },
                beforeSend: function (xhr, settings) {
                    itemDT.clear();
                },
                success: function (data, status, xhr) {
                    $.each(data, function (i, v) {
                        itemDT.row.add({
                            toReceive: false,
                            lineNumber: v.lineNumber,
                            orderItemId: v.orderItemId,
                            itemCode: v.itemCode,
                            itemId: v.itemId,
                            itemDescription: v.itemDescription,
                            purchaseReceivingId: v.purchaseReceivingId,
                            quantity: FormatStringInteger(0), 
                            quantityD: 0,  
                            toReceiveQuantity: v.toReceiveQuantity,
                            toReceiveQuantityD: v.toReceiveQuantityD,
                            unitCode: v.unitCode,
                            unitId: v.unitId,
                            unitCost: v.unitCost,
                            unitCostD: v.unitCostD,
                            totalAmount: FormatStringDecimal(0),
                            totalAmountD: 0
                        });
                    });
                },
                complete: function (xhr, status) {
                    itemDT.draw();
                }
            });
        }

        $("#form-receive button[type=submit]").on("click", function () {
            $("#action-type").val($(this).data("action"));
        });

        // Validation for Create
        var validateCreate = $("#form-receive").validate({
            rules: {
                DeliveryReceiptNumber: {
                    required: true,
                    maxlength: 100
                },
                SalesInvoiceNumber: {
                    required: true,
                    maxlength: 100
                },
                DateReceived: {
                    required: true
                },
                Remarks: {
                    maxlength: 500
                }
            },
            messages: {
                DeliveryReceiptNumber: {
                    required: "Please enter Delivery Receipt Number.",
                    maxlength: "Delivery Receipt Number can not exceed 100 characters."
                }, 
                SalesInvoiceNumber: {
                    required: "Please enter Sales Invoice Number.",
                    maxlength: "Sales Invoice Number can not exceed 100 characters."
                },
                DateReceived: {
                    required: "Please enter the date of receive."
                },
                Remarks: {
                    maxlength: "Remarks can not exceed 500 characters."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveReceive();
            }
        });

        function SaveReceive() {
            var items = itemDT.data();
            if (items.filter(s => s.toReceive == true).length == 0) {
                toastr.warning("No item to receive. Add an item to the list to continue", "Warning");
            } else if (items.filter(s => s.toReceive == true && parseInt(s.quantity) == 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't receive an item with 0 quantity", "Warning");
            } else if (items.filter(s => s.toReceive == true && parseInt(s.quantity) > parseInt(s.toReceiveQuantityD)).length > 0) {
                toastr.warning("Some items exceed purchase order quantity. Can't receive an item that exceeds purchase order quantity", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddJson")",
                    data: {
                        DocumentNumber: $("#receive-docNumber").val(),
                        PurchaseOrderId: $("#receive-poNumber").val(),
                        DeliveryReceiptNumber: $("#receive-dRNumber").val(),
                        SalesInvoiceNumber: $("#receive-sINumber").val(),
                        DateReceived: $("#date-received").val(),
                        Status: $("#action-type").val(),
                        Remarks: $("#receive-remarks").val(),
                        ResubmitId: $("#resubmitPRId").val(),
                        Items: GetItemsToReceive()

                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
}
