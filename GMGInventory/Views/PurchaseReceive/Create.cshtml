@{
    if (TempData["PurchaseReceivingId"] != null)
    {
        ViewData["Title"] = "Resubmit Purchase Receive";
    }
    else
    {

        ViewData["Title"] = "New Purchase Receive";
    }
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseReceive" asp-action="Index">Purchase Receives</a></li>
}

<div class="card card-default">
    <form id="form-receive">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                    <span class="fas fa-paper-plane"></span> @(TempData["PurchaseReceiveId"] != null ? "Resubmit" : "Submit")
                </button>
                <input type="hidden" id="action-type" name="ActionType" value="">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                  <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-docNumber" class="form-label mb-0">Document Number</label>
                        <input type="text" id="receive-docNumber" name="DocumentNumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6 ">
                    <div class="form-group">
                        <label for="receive-poNumber" class="form-label mb-0">Purchase Order</label>
                        <select id="receive-poNumber" name="PurchaseOrder" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-deliveryReceiptNumber" class="form-label mb-0">Delivery Receipt Number</label>
                        <input type="text" id="receive-dRNumber" name="DeliveryReceiptNumber" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-sINumber" class="form-label mb-0">Sales Invoice Number</label>
                        <input type="text" id="receive-sINumber" name="SalesInvoiceNumber" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-supplier" class="form-label mb-0">Supplier</label>
                        <input type="text" id="receive-supplier" name="Supplier" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-warehouse" class="form-label mb-0">Warehouse</label>
                        <input type="text" id="receive-warehouse" name="Warehouse" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-term" class="form-label mb-0">Term</label>
                        <input type="text" id="receive-term" name="Term" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-term" class="form-label mb-0">Currency</label>
                        <input type="text" id="receive-currency" name="Currency" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-currencyRate" class="form-label mb-0">Currency Rate</label>
                        <input type="text" id="receive-currencyRate" name="Term" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-discount1" class="form-label mb-0">Discount 1</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" max="100" id="receive-discount1" name="Discount1" class="form-control form-control-sm" readonly="readonly" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-discount2" class="form-label mb-0">Discount 2</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" max="100" id="receive-discount2" name="Discount2" class="form-control form-control-sm" readonly="readonly" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="date-received" class="form-label mb-0">Date Received</label>
                        <input type="date" id="date-received" name="DateReceived" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="receive-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="receive-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
         

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Purchase Receive Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Item Code</th>
                                        <th>Item Description</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Cost</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th></th>
                                        <th class="total-cost">0</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Purchase Receive Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Purchase Receive Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6 add-code-container">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Item</label>
                                <select id="add-code" name="Code" style="width: 100%;">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-name-container">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Item Description</label>
                                <input type="text" id="add-name" name="Name" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 add-quantity-container">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" step="1" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-unit2-container">
                            <div class="form-group">
                                <label for="add-unit2" class="form-label mb-0">Unit</label>
                                <div>
                                    <select id="add-unit2" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                          <div class="col-12 col-sm-6 add-unit-container">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-cost">
                            <div class="form-group">
                                <label for="add-cost" class="form-label mb-0">Unit Cost</label>
                                <input type="number" min="0" max="1999999" step="1" id="add-cost" name="UnitCost" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["PurchaseReceivingId"] != null)
{
    <input type="hidden" id="resubmitPRId" value="@TempData["PurchaseReceivingId"]" />
}

@section Scripts {
    <script>
       
        if ($("#resubmitPRId").length) {
            $("#receive-poNumber").prop('disabled', true);

            // for resubmitting a disapproved sales order
            $.ajax({
                type: "post",
                url: "@Url.Action("DetailsJson")",
                data: {
                    id: $("#resubmitPRId").val()
                },
                success: function (data, status, xhr) {
                    $("#receive-docNumber").val(data.documentNumber);
                    $("#receive-poNumber").val(data.poNumber);
                    $("#receive-supplier").val(data.supplier);
                    $("#receive-warehouse").val(data.warehouse);
                    $("#receive-term").val(data.term);

                    $("#receive-currency").val(data.currency);
                    $("#receive-currencyRate").val(data.currencyRate);

                    //  $("#receive-supplier").data("Id", data.supplierId);
                    // $("#receive-term").data("Id", data.termId);
                    //   $("#receive-warehouse").data("Id", data.warehouseId);


                    $("#receive-discount1").val(data.discount1);
                    $("#receive-discount2").val(data.discount2);

                    loadPONumberOptions(data.poId);
                },
                complete: function (xhr, status) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetItemListJson")",
                        data: {
                            purchaseReceiveId: $("#resubmitPRId").val()
                        },
                        success: function (data, status, xhr) {
                            $.each(data, function (i, v) {
                                itemDT.row.add(v).draw();
                            });
                        }
                    });
                }
            });
        } else {
            $("#receive-poNumber").prop('disabled', false);
            loadDocumentNumber();
            loadPONumberOptions(-1);
        }

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top" role="tooltip"><i class="fas fa-minus"></i></button>';
                        actions += '<button type="button" class="btn btn-info btn-xs btn-up-item" data-microtip-title="Move Up Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-up"></i></button>';
                        actions += '<button type="button" class="btn btn-info btn-xs btn-down-item" data-microtip-title="Move Down Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-down"></i></button>';
                        return actions + '</div>';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "-";
                        } else {
                            return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemDescription", name: "ItemDescription", className: "form-cell" },

                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                 {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" step="1" value="' + data.unitCost + '" class="form-control form-control-sm unitCost" style="width: 100%;" />';
                    },
                    name: "UnitCost",
                    className: "form-cell text-end"
                },
            ],
            order: [[1, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalInteger(api, 4);
                columnDTTotalInteger(api, 6);
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".btn-remove-item").on("click", function () {
                itemDT.row($(this).parents('tr')).remove().draw();
            });

            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var rowData = this.data();
                if (rowData.lineNumber == 1)
                    $(this.node()).find(".btn-up-item").hide();
                else
                    $(this.node()).find(".btn-up-item").show();

                if (rowData.lineNumber == Math.max.apply(Math, itemDT.column(1).data().toArray()))
                    $(this.node()).find(".btn-down-item").hide();
                else
                    $(this.node()).find(".btn-down-item").show();
            });

            $(".btn-up-item").off("click").on("click", function () {
                var row = $(this).parents('tr');
                var rowData = itemDT.row(row).data();

                var currentLineNumber = rowData.lineNumber;
                var newLineNumber = currentLineNumber - 1;

                var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                    return itemDT.row(index).data().lineNumber === newLineNumber;
                });

                if (targetRowIndex != undefined) {
                    var targetRowData = itemDT.row(targetRowIndex).data();
                    targetRowData.lineNumber = currentLineNumber;
                    itemDT.row(targetRowIndex).data(targetRowData);
                }

                rowData.lineNumber = newLineNumber;
                itemDT.row(row).data(rowData);

                itemDT.draw();
            });

            $(".btn-down-item").off("click").on("click", function () {
                var row = $(this).parents('tr');
                var rowData = itemDT.row(row).data();
                var currentLineNumber = rowData.lineNumber;
                var newLineNumber = currentLineNumber + 1;

                var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                    return itemDT.row(index).data().lineNumber == newLineNumber;
                });

                if (targetRowIndex != undefined) {
                    var targetRowData = itemDT.row(targetRowIndex).data();
                    targetRowData.lineNumber = currentLineNumber;
                    itemDT.row(targetRowIndex).data(targetRowData);
                }

                rowData.lineNumber = newLineNumber;
                itemDT.row(row).data(rowData);

                itemDT.draw();
            });

            ComputeTotalQuantity();
            ComputeTotalCost();

            $(".quantity").on("input", function () {
                ComputeTotalQuantity();
            });
            $(".unitCost").on("input", function () {
                ComputeTotalCost();
            });
        });

        function loadDocumentNumber() {
            if ($("#resubmitPOId").length == 0) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetNewDocumentNumber")",
                    success: function (data, status, xhr) {
                        $("#receive-docNumber").val(data);
                    }
                });
            }
        }

        function loadPONumberOptions(selectedOrder) {
            // Load Select2 Purchase Order
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseOrderOptions", "PurchaseReceive")",
                data: {
                    SelectedId:  selectedOrder
                },
                success: function (data, status, xhr) {
                    $("#receive-poNumber").select2({
                        data: data,
                        minimumInputLength: -1,
                        placeholder: "<empty>"
                    }).off("select2:select").on("select2:select", function () {
                        GetPurchaseRequestType();
                        loadPODetails();
                        loadAllItemsOptions(selectedOrder);
                    }).off("select2:unselecting").on("select2:unselecting", function () {
                        $("#receive-supplier").val("");
                        $("#receive-warehouse").val("");
                        $("#receive-term").val("");
                        $("#receive-currency").val("");
                        $("#receive-currencyRate").val("0");
                        $("#receive-discount1").val("0");
                        $("#receive-discount2").val("0");

                        //  $("#receive-supplier").removeData("Id");
                        //   $("#receive-warehouse").removeData("Id");
                        //$("#receive-term").removeData("Id");

                        $("#add-code").val("").trigger("change");
                        itemDT.clear().draw();
                    }).val(selectedOrder).trigger('change');
                } 
            });
        }

        function GetPurchaseRequestType() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseRequestType", "PurchaseRequest")",
                data: { PurchaseOrderId: $("#receive-poNumber").val() },
                success: function (data, status, xhr) {
                    if (data == "MR") {
                        $(".add-code-container").toggle(false);
                        $(".add-unit2-container").toggle(true);
                    }
                    else {
                        $(".add-code-container").toggle(true);
                        $(".add-unit2-container").toggle(false);
                    }
                }
            });
        }

        // Load purchase receiving for select2
        function loadPODetails() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("DetailsJson", "PurchaseOrder")",
                data: {
                    Id: $("#receive-poNumber").val()
                },
                success: function (data, status, xhr) {
                    $("#receive-supplier").val(data.supplier);
                    $("#receive-warehouse").val(data.deliveryAddress);
                    $("#receive-term").val(data.term);
                    $("#receive-currency").val(data.currency);
                    $("#receive-currencyRate").val(data.currencyRate);

                    $("#receive-discount1").val(data.discount1);
                    $("#receive-discount2").val(data.discount2);
                    // $("#receive-supplier").data("Id", data.supplierId);
                    //  $("#receive-warehouse").data("Id", data.deliveryAddressId);
                    //  $("#receive-term").data("Id", data.termId);

                },
                complete: function (xhr, status) {
                   // loadRRItems();
                }
            });
        }

       // loadAllItemsOptions();
        function loadAllItemsOptions(selectedOrder) {
            if ($.fn.select2 && $("#add-code").hasClass("select2-hidden-accessible")) {
                $("#add-code").select2("destroy");
                $("#add-code").empty();
            } 
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseOrderItemOptions")", 
                data: {
                    SelectedId: function () {
                        return $("#receive-poNumber").val(); 
                    }
                },
                success: function (data, status, xhr) {
                    $("#add-code").select2({
                        data: data,
                        minimumResultsForSearch: -1,
                        placeholder: "<empty>",
                        allowClear: true,
                        language: {
                            noResults: function () {
                                return "No items found";
                            }
                        },
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                        },
                        dropdownParent: $("#addModal")
                    }).on("select2:select", function () {
                        var selected = $(this).select2("data")[0];
                        // $("#add-code").val(selected.itemCode);
                        // $("#add-part").val(selected.partNumber);
                        // $("#add-quantity").val(selected.unorderedQuantity);
                        // $("#add-quantity").data("max", selected.unorderedQuantity);
                        // $("#add-unit").val(selected.unit);
                        // $("#add-unit").data("Id", selected.unitId);
                        // $("#add-unit-cost").val(0);
                        // $("#add-total-amount").val("0.00");
                    }).on("select2:unselecting", function () {
                        // $("#add-code").val("");
                        // $("#add-quantity").val(0);
                        // $("#add-quantity").data("max", 0);
                        // $("#add-unit").val("");
                        // $("#add-unit").data("Id", -1);
                        // $("#add-unit-cost").val("0.00");
                        // $("#add-total-amount").val("0.00");
                    });
                },
                complete: AssignItemEvent

            });

        } 

        function AssignItemEvent(jqXHR, textStatus) {
            $("#add-code").off("select2:select").on("select2:select", function () {
                $("#add-name").val($("#add-code").select2("data")[0].name);
                $("#add-unit").val($("#add-code").select2("data")[0].unit);
                $("#add-unit").data("Id", $("#add-code").select2("data")[0].unitId);
            });

            $("#add-code").off("select2:unselecting").on("select2:unselecting", function (e) {
                $("#add-name").val("");
                $("#add-unit").val("");
                $("#add-unit").data("Id", "");
            });
        }

        // Load unit for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Unit")",
            success: function (data, status, xhr) {
                $("#add-unit2").select2({
                    data: data,
                    minimumResultsForSearch: -1,
                    placeholder: "<empty>",
                    dropdownParent: $("#addModal")
                }).on("change", function () {
                    $("#add-unit").val($("#add-unit2").select2("data")[0].text);
                    $("#add-unit").data("Id", $("#add-unit2").select2("data")[0].id);
                });
            }
        });

        $(".createBtn").on("click", clearItemForm);

        function clearItemForm() {
            $("#add-code").val("").trigger("change");
            $("#add-name").val("");
            $("#add-quantity").val("0");
            $("#add-cost").val("0");
            $("#add-unit").val("");
            $("#add-unit").data("Id", "");
        }

        function ComputeTotalQuantity() {
            total_quantity = 0;

            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });

            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }
         function ComputeTotalCost() {
            total_cost = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_cost += parseInt($(this.node()).find(".unitCost").val());
            });

            $(".total-cost").html(FormatStringInteger(total_cost));
        }

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            rules: {
                Name: {
                    maxlength: 100
                },
                Quantity: {
                    required: true,
                    number: true,
                    isNotZero: true
                },
                UnitCost: {
                    required: true,
                    number: true,
                    isNotZero: true
                }
            },
            messages: {
                Name: {
                    maxlength: "Description must not exceed 100 characters."
                },
                Quantity: {
                    required: "Please enter quantity.",
                    number: "Please enter a valid number.",
                    isNotZero: "Can not receive an item with 0 quantity."
                },
                UnitCost: {
                    required: "Please enter unit cost.",
                    number: "Please enter a valid number.",
                    isNotZero: "Can not receive an item with 0 cost."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.itemDescription == $("#add-name").val()) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if ($("#add-code").val() == "" && $("#add-name").val() == "") {
                toastr.warning("Must choose item code or input item description", "Required");
            }
           else if (rowIndexes.length > 0) {
                toastr.warning($("#add-code").select2("data")[0].text + " has already been added", "Duplicate");
            } else {
                itemDT.row.add({
                    itemCode: $("#add-code").select2("data")[0].text,
                    itemDescription: $("#add-name").val(),
                    itemId: $("#add-code").select2("data")[0].id,
                    lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                    purchaseReceivingId: 0,
                    quantity: FormatStringInteger($("#add-quantity").val()),
                    quantityD: $("#add-quantity").val() || 0,
                    unitCode: $("#add-unit").val(),
                    unitId: $("#add-unit").data("Id"),
                    unitCost: FormatStringInteger($("#add-cost").val()),
                    unitCostD: $("#add-cost").val() || 0,
                }).draw();
                clearItemForm();

                toastr.success("Added " + $("#add-code").select2("data")[0].text + " on Purchase Receive Item(s)", "Success");
            }
        }

        function GetItemsToReceive() {
            var item_to_receive = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));
                item_to_receive.push(row_data);
            });
            return item_to_receive;
        }

        $("#form-receive button[type=submit]").on("click", function () {
            $("#action-type").val($(this).data("action"));
        });

        // Validation for Create
        var validateCreate = $("#form-receive").validate({
            rules: {
                DeliveryReceiptNumber: {
                    required: true,
                    maxlength: 100
                },
                SalesInvoiceNumber: {
                    required: true,
                    maxlength: 100
                },
                DateReceived: {
                    required: true
                },
                Remarks: {
                    required: true,
                    maxlength: 100
                }
            },
            messages: {
                DeliveryReceiptNumber: {
                    required: "Please enter Delivery Receipt Number.",
                    maxlength: "Delivery Receipt Number can not exceed 100 characters."
                }, 
                SalesInvoiceNumber: {
                    required: "Please enter Sales Invoice Number.",
                    maxlength: "Sales Invoice Number can not exceed 100 characters."
                },
                DateReceived: {
                    required: "Please enter the date of receive."
                },
                Remarks: {
                    required: "Please enter a remarks",
                    maxlength: "Remarks can not exceed 100 characters."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveReceive();
            }
        });

        function SaveReceive() {
            var items = itemDT.data();
            if (items.length == 0) {
                toastr.warning("No item to receive. Add an item to the list to continue", "Warning");
            } else if (items.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't receive an item with 0 quantity", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddJson")",
                    data: {
                        DocumentNumber: $("#receive-docNumber").val(),
                        PurchaseOrderId: $("#receive-poNumber").val(),
                        DeliveryReceiptNumber: $("#receive-dRNumber").val(),
                        SalesInvoiceNumber: $("#receive-sINumber").val(),
                        DateReceived: $("#date-received").val(),
                        Status: $("#action-type").val(),
                        Remarks: $("#receive-remarks").val(),
                        ResubmitId: $("#resubmitPRId").val(),
                        Items: GetItemsToReceive()

                        //  SupplierId: $("#receive-supplier").val(),
                        //  TermId: $("#receive-term").val(),
                        //  WarehouseId: $("#receive-warehouse").val(),
                        //  Discount1: $("#receive-discount1").val(),
                        //  Discount2: $("#receive-discount2").val(),
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
}
