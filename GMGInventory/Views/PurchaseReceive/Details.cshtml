@model PurchaseReceiveDetailsVM
@{
    ViewData["Title"] = "Purchase Receiving Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
    var userAccessBasic = (ViewsAccessVM)ViewData["UserAccessBasic"]!;
    var hashMicroUserAccess = (ViewsAccessVM)ViewData["HashMicroUserAccess"]!;

    var status = Model.Status.ToLowerInvariant();

    bool isHashMicroMoved = Model.HashMicroMoveId != null;
    bool isDraft = status == "draft";
    bool isSubmitted = status == "submitted";
    bool isApproved = status == "approved";
    bool isDisapproved = status == "disapproved";

    bool canHashMicroSync = hashMicroUserAccess.CanUploadDownload && (isDraft || isSubmitted || isApproved);
    bool canAdd = userAccess.CanAdd;
    bool canPrint = userAccess.CanPrint;
    bool canDelete = userAccess.CanDelete && isDraft && !isHashMicroMoved;
    bool canEdit = userAccess.CanEdit && isDraft;
    bool canApproveDisapprove = userAccess.CanApproveDisapprove && isSubmitted;

    bool canRecreate = isDisapproved &&
                       !string.IsNullOrWhiteSpace(Model.DisapprovedBy) &&
                       Model.ResubmitId == null &&
                       canAdd;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseReceiving" asp-action="Index">Purchase Receivings</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (canHashMicroSync)
            {
                @if (isHashMicroMoved)
                {
                    <button type="button" class="btn btn-light text-dark btn-sm float-right ml-2" onclick="ViewHashMicro()" data-microtip-title="Already on HashMicro" data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-cloud mr-0"></span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-light text-dark btn-sm float-right ml-2" onclick="MoveToHashMicro()">
                        <span class="fas fa-upload"></span> Move to HashMicro
                    </button>
                }
            }
            else
            {
                <button type="button"
                        class="btn btn-light text-dark btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Move to HashMicro&#10;@(isDraft || isSubmitted || isApproved ? "Upload Hash Micro access is required" : "Only draft / submitted / approved receiving can be moved")"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-upload mr-0"></span>
                </button>
            }
            @if (canPrint)
            {
                <div class="dropdown float-right ml-2">
                    <button class="btn btn-info btn-sm dropdown-toggle" type="button" id="dropdownMenuPrint" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="fas fa-print"></span> Print
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuPrint">
                        <li><a class="dropdown-item btn-details-print" data-company="GMG">Use GMG Logo</a></li>
                        <li><a class="dropdown-item btn-details-print" data-company="BAS">Use BAS Logo</a></li>
                    </ul>
                </div>
            }
            else
            {
                <button type="button"
                        class="btn btn-info btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Print&#10;Print access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-print mr-0"></span>
                </button>
            }
            @if (canDelete)
            {
                <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-delete">
                    <span class="fas fa-trash"></span> Delete
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Delete&#10;@(isHashMicroMoved ? "Record already copied to HashMicro. Delete cannot proceed" : isDraft ? "Delete access is required" : "Only draft receiving can be deleted")"
                        data-microtip-position="bottom" role="tooltip">
                    <span class="fas fa-trash mr-0"></span>
                </button>
            }
            @if (canEdit)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 btn-details-save">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="button" class="btn btn-primary btn-sm float-right ml-2 btn-details-submit">
                    <span class="fas fa-paper-plane"></span> Submit
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Save as Draft&#10;@(isDraft ? "Edit access is required" : "Only draft receiving can be saved as draft")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-save mr-0"></span>
                </button>
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Submit&#10;@(isDraft ? "Edit access is required" : "Only draft receiving can be submitted")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-paper-plane mr-0"></span>
                </button>
            }
            @if (canApproveDisapprove)
            {
                <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-disapprove">
                    <span class="fas fa-times"></span> Disapprove
                </button>
                <button type="button" class="btn btn-success btn-sm float-right ml-2 btn-details-approve">
                    <span class="fas fa-check"></span> Approve
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Disapprove&#10;@(isSubmitted ? "Approve / Disapprove access is required" : "Only submitted receiving can be disapproved")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-times mr-0"></span>
                </button>
                <button type="button"
                        class="btn btn-success btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Approve&#10;@(isSubmitted ? "Approve / Disapprove access is required" : "Only submitted receiving can be approved")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-check mr-0"></span>
                </button>
            }
            @if (canRecreate)
            {
                <a href="@Url.Action("Create")/@Model.Id" class="btn btn-primary btn-sm float-right ml-2">
                    <span class="fas fa-edit"></span> Update to Resubmit
                </a>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title=" Update to Resubmit&#10;@(Model.ResubmitId != null ? "Receiving already been resubmitted" : canAdd ? "Only disapproved receiving can be resubmitted" : "Add access is required")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-edit mr-0"></span>
                </button>
            }
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy) || Model.ResubmitFromId != null)
        {
            <div class="row">
                @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                {
                    <div class="col-12">
                        <div class="alert alert-danger text-sm" role="alert">
                            <strong>Reason of Disapproval:</strong>
                            @(string.IsNullOrWhiteSpace(Model.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                        </div>
                    </div>
                }
                @if (Model.ResubmitId != null || Model.ResubmitFromId != null)
                {
                    <div class="col-12">
                        <div class="alert alert-info text-sm" role="alert">
                            <strong>Resubmit Details:</strong>
                            @if (Model.ResubmitId != null)
                            {
                                <div>This has been resubmitted. You can view the new one <a href="@Url.Action("Details", "PurchaseReceive", new { Id = Model.ResubmitId })" class="alert-link">here</a>.</div>
                            }
                            @if (Model.ResubmitFromId != null)
                            {
                                <div>This is a resubmission. You can view the previous one <a href="@Url.Action("Details", "PurchaseReceive", new { Id = Model.ResubmitFromId })" class="alert-link">here</a>.</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </span>
                    <b class="d-block">
                        @Model.DocumentNumber
                    </b>
                </p>
            </div>

            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PONumber)
                    </span>
                    <b class="d-block" id="receive-poNumber">
                        @Model.PONumber
                    </b>
                </p>
            </div>

            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ReceiveDate)
                    </span>
                    <b class="d-block">
                        @Model.ReceiveDate
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SINumber)
                    </span>
                    <b class="d-block" id="receive-siNumber">
                        @Model.SINumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DRNumber)
                    </span>
                    <b class="d-block" id="receive-drNumber">
                        @Model.DRNumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Warehouse)
                    </span>
                    <b class="d-block">
                        @Model.Warehouse
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model.Remarks) ? Html.Raw("<span class='fw-normal text-muted'>N/A</span>") : Model.Remarks)
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedBy)
                        </span>
                        <b class="d-block">
                            @Model.ApprovedBy
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DisapprovedBy)
                        </span>
                        <b class="d-block">
                            @Model.DisapprovedBy
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Status)
                    </span>
                    <b class="d-block" id="receive-status">
                        @Model.Status
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block">
                        @Model.UserCreated
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block">
                        @Model.DateCreated
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.UserModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserModified)
                        </span>
                        <b class="d-block">
                            @Model.UserModified
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DateModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block">
                            @Model.DateModified
                        </b>
                    </p>
                </div>
            }
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Purchase Receiving Item(s)</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>#</th>
                                    <th>Item Code</th>
                                    <th>Item Description</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Unit Cost</th>
                                    <th>Total Amount</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th class="text-end">Total</th>
                                    <th class="total-quantity">0</th>
                                    <th></th>
                                    <th></th>
                                    <th class="total-amount">0.00</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (hashMicroUserAccess.CanUploadDownload)
{
    <div class="modal fade" id="viewHMModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">HashMicro Transfer Details</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-4">Document Number</dt>
                        <dd class="col-sm-8">@(Model.DocumentNumber ?? "<span class=\"text-muted\">Missing data</span>")</dd>
                        <dt class="col-sm-4">Move Id</dt>
                        <dd class="col-sm-8">@(Model.HashMicroMoveId?.ToString() ?? "<span class=\"text-muted\">Missing data</span>")</dd>
                        <dt class="col-sm-4">Move Name</dt>
                        <dd class="col-sm-8">@(Model.HashMicroMoveName ?? "<span class=\"text-muted\">Missing data</span>")</dd>
                        <dt class="col-sm-4">Status upon Moving</dt>
                        <dd class="col-sm-8">@(Model.HashMicroMoveStatus ?? "<span class=\"text-muted\">Missing data</span>")</dd>
                        <dt class="col-sm-4">Moved By</dt>
                        <dd class="col-sm-8">@(Model.HashMicroMoveBy ?? "<span class=\"text-muted\">Missing data</span>")</dd>
                        <dt class="col-sm-4">Date Moved</dt>
                        <dd class="col-sm-8">@(Model.HashMicroMoveDate ?? "<span class=\"text-muted\">Missing data</span>")</dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var user_accessBasic = @Html.Raw(Json.Serialize(userAccessBasic));
        var hashmicro_user_access = @Html.Raw(Json.Serialize(hashMicroUserAccess));
        var ro_data = @Json.Serialize(Model);

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemListJson")",
                data: { purchaseReceiveId: ro_data.id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        if (user_access.canEdit && ro_data.status.toLowerCase() == "draft") {
                            return '<input type="checkbox" class="to-receive" ' + (data.toReceive == true ? 'checked="checked"' : '') +
                                                 (data.toReceiveQuantityD == 0 ? 'disabled' : '') + ' />';
                        } else {
                            return '';
                        }
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                { data: "itemCode", name: "ItemCode", className: "form-cell" },
                { data: "itemDescription", name: "ItemDescription", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (ro_data.status.toLowerCase() == "draft" && data.toReceive == true) {
                            if (data.quantityD > data.toReceiveQuantityD) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Can not exceed ' + data.toReceiveQuantity + ' receiving quantity.</label>';
                            } else if (data.quantityD == 0) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Nothing to receive.</label>';
                            } else {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                            }
                        } else {
                            return data.quantity;
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                { data: "unitCost", name: "UnitCost", className: "form-cell", visible: user_accessBasic.canView ? false : true },
                {
                    data: "totalAmount",
                    name: "TotalAmount",
                    className: "form-cell",
                    render: function (data, type, row) {
                        if (type === 'display') {
                            return ro_data.currency.split("/")[0].trim() + '&nbsp;' + data;
                        }

                        return data;
                    },
                    visible: user_accessBasic.canView ? false : true
                }

            ],
            order: [[1, "asc"]],
            createdRow: function (row, data, dataIndex) {
                if (data.toReceive == false) {
                    $(row).addClass('text-muted');
                }
            },
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalInteger(api, 4);
                columnDTTotalDecimal(api, 7, ro_data.currency.split("/")[0].trim() + '&nbsp;');
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");


            if (user_access.canEdit) {
                $(".quantity").off("change").on("change", function () {
                    var row = itemDT.row($(this).closest('tr'));
                    var rowData = row.data();

                    var lineNumber = rowData.lineNumber;

                    var quantityValue = parseFloat($(row.node()).find(".quantity").val()) || 0;

                    var totalValue = quantityValue * rowData.unitCostD;

                    rowData.quantity = FormatStringInteger(quantityValue);
                    rowData.quantityD = quantityValue;
                    rowData.totalAmount = FormatStringDecimal(totalValue);
                    rowData.totalAmountD = totalValue;

                    row.data(rowData).draw(false);

                    setTimeout(function () {
                        var restoredRow = $(itemDT.row(function (idx, data) {
                            return data.lineNumber === lineNumber;
                        }).node());
                        if (restoredRow) {
                            var restoredInput = $(restoredRow).find(".quantity");

                            if (restoredInput.length)
                                restoredInput.focus();
                        }
                    }, 0);
                });

                $(".to-receive").off("change").on("change", function () {
                    var tr = $(this).closest('tr');
                    var row = itemDT.row(tr);
                    var rowData = row.data();

                    if ($(this).prop("checked")) {

                        rowData.toReceive = true;
                        tr.removeClass("text-muted");

                        var quantityValue = rowData.toReceiveQuantityD;
                        var totalValue = quantityValue * rowData.unitCostD;

                        rowData.quantity = FormatStringInteger(quantityValue);
                        rowData.quantityD = quantityValue;

                        rowData.totalAmount = FormatStringDecimal(totalValue);
                        rowData.totalAmountD = totalValue;

                    } else {
                        rowData.quantity = FormatStringInteger(0);
                        rowData.quantityD = 0;
                        rowData.totalAmount = FormatStringDecimal(0);
                        rowData.totalAmountD = 0;

                        rowData.toReceive = false;
                        tr.addClass("text-muted");
                    }
                    row.data(rowData).draw(false);
                });
            }
        });

        if (user_access.canAdd) {
            $(".btn-details-save").on("click", function () {
                SaveReceive("DRAFT");
            });

            $(".btn-details-submit").on("click", function () {
                SaveReceive("SUBMITTED");
            });
        }

        function SaveReceive(status) {
            var items = itemDT.data();
            if (items.filter(s => s.toReceive == true).length == 0) {
                toastr.warning("No item to receive. Select an item on the list to continue", "Warning");
            } else if (items.filter(s => s.toReceive == true && parseInt(s.quantity) == 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't receive an item with 0 quantity", "Warning");
            } else if (items.filter(s => s.toReceive == true && parseInt(s.quantity) > parseInt(s.toReceiveQuantityD)).length > 0) {
                toastr.warning("Some items exceed purchase order quantity. Can't receive an item that exceeds to receive quantity.", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveItemsJson")",
                    data: {
                        Id: ro_data.id,
                        status: status,
                        items: GetItemsToReceive()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Success") {
                            window.location.reload();
                        } else {
                            toastr.error(data.message, data.status);
                        }
                    }
                });
            }
        }

        function GetItemsToReceive() {
            var item_to_receive = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));

                if (row_data.toReceive == true)
                    item_to_receive.push(row_data);
            });
            return item_to_receive;
        }

        if (user_access.canApproveDisapprove) {
            $('.btn-details-approve').click(function (e) {
                swal({
                    title: "Approve Purchase Receiving",
                    text: "Continue to approve this purchase receiving?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("ApproveJson")",
                            type: "POST",
                            data: { Id: ro_data.id },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });

            $('.btn-details-disapprove').click(function (e) {
                swal({
                    title: "Disapprove Purchase Receiving",
                    text: "Continue to disapprove this purchase receiving?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                    content: {
                        element: "input",
                        attributes: {
                            placeholder: "Reason for Disapproving",
                            type: "text"
                        }
                    }
                }).then((confirm) => {
                    if (confirm !== null) {
                        $.ajax({
                            url: "@Url.Action("DisapproveJson")",
                            type: "POST",
                            data: {
                                Id: ro_data.id,
                                reason: confirm
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });
        }

        if (user_access.canDelete) {
            $(".btn-details-delete").on("click", function () {
                swal({
                    title: "Delete Purchase Receiving",
                    text: "Continue to delete this purchase receiving?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm != null) {
                        $.ajax({
                            url: "@Url.Action("DeleteJson")",
                            type: "POST",
                            data: { Id: ro_data.id },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                var print_company = $(this).data("company");
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintDetails")/' + ro_data.id + '?Company=' + print_company, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }

        if (hashmicro_user_access.canUploadDownload) {
            function ViewHashMicro() {
                $("#viewHMModal").modal("show");
            }

            function MoveToHashMicro() {
                swal({
                    title: "Move to HashMicro",
                    content: {
                        element: "div",
                        attributes: {
                            innerHTML: (ro_data.status.toLowerCase() == "draft" ? "Sales invoice is currently on <strong>Draft</strong> and " : "") + "Moving to HashMicro can only be done once. Are you sure you want to continue?"
                        }
                    },
                    icon: "warning",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("MoveToHashMicro", "PurchaseReceive")",
                            type: "POST",
                            data: {
                                Id: ro_data.id,
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                    toastr.success(data.message, data.status);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            }
        }
    </script>
}
