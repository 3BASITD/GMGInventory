@model SalesReturnDetailPVM

@{
    Layout = "";
    var title = "Sales Return Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    @*<h3>@title</h3>*@
    <table class="table-header w100">
        @*        <tr>
        <th>Sales Return Number</th>
        <td>@Model?.Details.SRNumber</td>`
        <th>Return Date</th>
        <td>@Model?.Details.ReturnDate</td>
        </tr>
        <tr>
        <th>Customer Code</th>
        <td>@Model?.Details.CustomerCode</td>
        <th>Return By</th>
        <td>@Model?.Details.ReturnBy</td>
        </tr>
        <tr>
        <th>Customer Name</th>
        <td>@Model?.Details.CustomerName</td>
        <th>Remarks</th>
        <td>@(string.IsNullOrEmpty(Model?.Details.Remarks.Trim()) ? "-" : Model.Details.Remarks)</td>
        </tr>*@
        <tr>
            <td></td>
            <td></td>
            <td class="right-text">No. @Model?.Details.SRNumber</td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            <td><br /><br /></td>
        </tr>
        <tr>
            <td><nobr>Customer Code: @Model?.Details.CustomerCode</nobr></td>
            <td><nobr>Customer Name: @Model?.Details.CustomerName</nobr></td>
            <td class="right-text"><nobr>Date: @Model?.Details.ReturnDate</nobr></td>
        </tr>
    </table>
    <table class="table-items no-border">
        <thead>
            <tr>
                @*<th>Defective</th>*@
                <th>Qty</th>
                <th>Unit</th>
                <th>Item Code</th>
                <th>Item Desc</th>
                <th>Reference No</th>
                <th>Price</th>
                <th>D1</th>
                <th>D2</th>
                <th>Extended Amt</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Contents)
            {
                <tr>
                    @*<td><nobr>@(item.IsDefective ? "✔" : "🞮")</nobr></td>*@
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td class="center-text"><nobr>@item.Unit</nobr></td>
                    <td class="center-text">@item.ItemCode</td>
                    <td class="center-text">@item.ItemName</td>
                    <td class="center-text">@item.ReferenceNumber</td>
                    <td class="right-text"><nobr>@item.SellingPrice</nobr></td>
                    <td class="right-text"><nobr>@item.Discount1</nobr></td>
                    <td class="right-text"><nobr>@item.Discount2</nobr></td>
                    <td class="right-text"><nobr>@item.GrossPrice</nobr></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th class="right-text"><nobr>@Model.TotalQuantity</nobr></th>
                <th colspan="7" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalGrossPrice</nobr></th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = window.close;
</script>
</html>