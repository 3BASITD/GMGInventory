@model SalesReturnDetailPVM

@{
    Layout = "";
    var title = "Sales Return Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <table class="table-header w100">
        <tr>
            <th>Sales Return Number</th>
            <td>@Model?.Details.SRNumber</td>`  
            <th>Return Date</th>
            <td>@Model?.Details.ReturnDate</td>
        </tr>
        <tr>
            <th>Customer Code</th>
            <td>@Model?.Details.CustomerCode</td>
            <th>Return By</th>
            <td>@Model?.Details.ReturnBy</td>
        </tr>
        <tr>
            <th>Customer Name</th>
            <td>@Model?.Details.CustomerName</td>
            <th>Remarks</th>
            <td>@(string.IsNullOrEmpty(Model?.Details.Remarks.Trim()) ? "-" : Model.Details.Remarks)</td>
        </tr>
    </table>
    <table class="table-items">
        <thead>
            <tr>
        @*<th>Defective</th>*@
        <th>Item Code</th>
        <th>Item Name</th>
        <th>Quantity</th>
        <th>Unit</th>
        <th>Selling Price</th>
        <th>Discount 1</th>
        <th>Discount 2</th>
        <th>Gross Price</th>
                <th>Reference Number</th>
            </tr>
    </thead>
        <tbody>
            @foreach (var item in Model.Contents)
            {
                <tr>
                    @*<td><nobr>@(item.IsDefective ? "✔" : "🞮")</nobr></td>*@
                    <td>@item.ItemCode</td>
                    <td>@item.ItemName</td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td class="right-text"><nobr>@item.Unit</nobr></td>
                    <td class="right-text"><nobr>@item.SellingPrice</nobr></td>
                    <td class="right-text"><nobr>@item.Discount1</nobr></td>
                    <td class="right-text"><nobr>@item.Discount2</nobr></td>
                    <td class="right-text"><nobr>@item.GrossPrice</nobr></td>
                    <td>@item.ReferenceNumber</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalQuantity</nobr></th>
                <th colspan="4"></th>
                <th class="right-text"><nobr>@Model.TotalGrossPrice</nobr></th>
                <th></th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = window.close;
</script>
</html>