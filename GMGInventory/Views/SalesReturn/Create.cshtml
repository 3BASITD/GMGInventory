@{
    ViewData["Title"] = "New Sales Return";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesReturn" asp-action="Index">Sales Returns</a></li>
}

    <div class="card card-default">
        <form id="form-return">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-primary btn-sm float-right btn-save ml-2">
                    <span class="fas fa-save"></span> Save
                </button>
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-customer-code" class="form-label mb-0">Customer Code</label>
                        <select id="return-customer-code" name="Customer" style="width: 100%;">
                            <option></option>
                        </select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-customer-name" class="form-label mb-0">Customer Name</label>
                        <input type="text" id="return-customer-name" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-customer-address" class="form-label mb-0">Customer Address</label>
                        <input type="text" id="return-customer-address" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="return-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="return-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Sales Return Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right btn-tbr ml-2" data-microtip-title="(To Be Returned) Add Item selection from All Items" data-microtip-position="top-left" role="tooltip">
                                    <span class="fas fa-plus"></span> TBR
                                </button>
                                <button type="button" class="btn btn-primary btn-sm float-right btn-invoice ml-2" data-microtip-title="Add Item selection from Invoice" data-microtip-position="top-left" role="tooltip">
                                    <span class="fas fa-file-invoice-dollar"></span> Invoice
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-return">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Defective</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Quantity to Return</th>
                                        <th>Unit Price</th>
                                        <th>Discount 1</th>
                                        <th>Discount 2</th>
                                        <th>Extended Price</th>
                                        <th>Reference Number</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="4">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th colspan="3"></th>
                                        <th class="total-gross-price">0</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </form>
    </div>

    <!-- Item Invoice Modal -->
    <div class="modal fade" id="invoiceModal" role="dialog" aria-labelledby="invoiceModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Invoice Item(s)</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-md-4 col-sm-6">
                            <p class="text-sm">
                                <label for="invoice-invoice" class="text-muted fw-normal mb-0">Invoice</label>
                                <select id="invoice-invoice" style="width: 100%;">
                                    <option></option>
                                </select>
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <table class="table table-striped table-hover table-return-items">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Quantity</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Selling Price</th>
                                        <th>Discount 1</th>
                                        <th>Discount 2</th>
                                        <th>Extended Price</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TBR Modal -->
    <div class="modal fade" id="tbrModal" role="dialog" aria-labelledby="tbrModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Return Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <form autocomplete="off" id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-code" class="control-label mb-0 d-block">Code</label>
                                <select id="item-code" name="Code" style="width: 100%;">
                                    <option></option>
                                </select>
                                <span data-valmsg-for="item-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-name" class="control-label mb-0 d-block">Name</label>
                                <input type="text" id="item-name" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-unit-price" class="control-label mb-0 d-block">Unit Price</label>
                                <input type="number" min="0" max="1999999.99" step="0.01" id="item-unit-price" class="form-control form-control-sm" />
                                <span data-valmsg-for="item-unit-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-quantity" class="control-label mb-0 d-block">Quantity</label>
                                <input type="number" min="0" max="1999999" step="1" name="Quantity" id="item-quantity" class="form-control form-control-sm" />
                                <span data-valmsg-for="item-quantity" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-discount1" class="control-label mb-0 d-block">Discount 1</label>
                                <input type="number" min="0" max="1999999.99" step="0.01" id="item-discount1" class="form-control form-control-sm" />
                                <span data-valmsg-for="item-discount1" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-discount2" class="control-label mb-0 d-block">Discount 2</label>
                                <input type="number" min="0" max="1999999.99" step="0.01" id="item-discount2" class="form-control form-control-sm" />
                                <span data-valmsg-for="item-discount2" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-gross-price" class="control-label mb-0 d-block">Gross Price</label>
                                <input type="number" id="item-gross-price" step="0.01" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="item-extended-price" class="control-label mb-0 d-block">Extended Price</label>
                                <input type="number" id="item-extended-price" step="0.01" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Close
                    </button>
                </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        $("#return-customer-code").select2({
            minimumInputLength: 1,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });

        $("#return-customer-code").on("select2:select", function () {
            $("#return-customer-name").val($(this).select2("data")[0].name);
            $("#return-customer-address").val($(this).select2("data")[0].address);


            $("#invoice-invoice").html("").select2({
                minimumInputLength: 1,
                placeholder: '<empty>',
                ajax: {
                    url: "@Url.Action("GetInvoiceByCustomer", "SalesInvoice")",
                    dataType: 'json',
                    type: "POST",
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1,
                            customer: $("#return-customer-code").select2("data")[0].id
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true
                },
                dropdownParent: $("#invoiceModal")
            });

            $("#invoice-invoice").on("select2:select", function () {
                invoiceDT.ajax.reload();
            });
        });

        $(".btn-invoice").on("click", function () {
            if ($("#return-customer-code").val() == "") {
                toastr.warning("Please select customer first");
            } else {
                $("#invoice-invoice").html("");
                invoiceDT.ajax.reload();
                $("#invoiceModal").modal("show");
            }
        });

        $(".btn-tbr").on("click", function () {
            if ($("#return-customer-code").val() == "") {
                toastr.warning("Please select customer first");
            } else {
                $("#item-code").val("").trigger("change");
                ResetTBR();
                $("#tbrModal").modal("show");
            }
        });

        // Load item for select2
        $("#item-code").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#tbrModal")
        });

        $("#item-code").on("select2:select", function () {
            $("#item-name").val($("#item-code").select2("data")[0].name);
            var netprice = $("#item-code").select2("data")[0].netPriceD;
            var retailprice = $("#item-code").select2("data")[0].retailPriceD;
            $("#item-unit-price").val(Math.max(netprice, retailprice));
            $("#item-quantity").val("0.00");
            $("#item-discount1").val("0.00");
            $("#item-discount2").val("0.00");
            ComputeTBR();
        });

        $("#item-code").on("select2:unselecting", ResetTBR);

        function ResetTBR() {
            $("#item-name").val("");
            $("#item-unit-price").val("0.00");
            $("#item-quantity").val("0");
            $("#item-discount1").val("0.00");
            $("#item-discount2").val("0.00");
            $("#item-gross-price").val("0.00");
            $("#item-extended-price").val("0.00");
        }

        $("#item-unit-price, #item-quantity, #item-discount1, #item-discount2").on("change", ComputeTBR);

        function ComputeTBR() {
            var unitprice = parseFloat($("#item-unit-price").val());
            var quantity = parseFloat($("#item-quantity").val());
            var discount1 = parseFloat($("#item-discount1").val());
            var discount2 = parseFloat($("#item-discount2").val());

            $("#item-gross-price").val((Math.round(unitprice * quantity * 100) / 100).toFixed(2));
            $("#item-extended-price").val((Math.round((unitprice * ((100 - discount1 - discount2) / 100)) * quantity * 100) / 100).toFixed(2));
        }

        // Validation for Item
        var validateCreate = $("#form-item").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Code: { required: true },
                Quantity: { required: true }
            },
            messages: {
                Code: { required: "Please select customer" },
                Quantity: { required: "Cannot return 0 quantity" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var item = {
                discount1: $("#item-discount1").val(),
                discount1D: parseFloat($("#item-discount1").val()),
                discount2: $("#item-discount2").val(),
                discount2D: parseFloat($("#item-discount2").val()),
                grossPrice: $("#item-extended-price").val(),
                grossPriceD: parseFloat($("#item-extended-price").val()),
                //id: 0, // no invoice id
                itemCode: $("#item-code").select2("data")[0].text,
                itemId: $("#item-code").select2("data")[0].id,
                itemName: $("#item-name").val(),
                netPrice: $("#item-gross-price").val(),
                netPriceD: parseFloat($("#item-gross-price").val()),
                quantity: parseInt($("#item-quantity").val()),
                referenceNumber: "TBR"
            };
            
            returnDT.row.add(item).draw();
            $("#item-code").val("").trigger("change");
            ResetTBR();
        }

        var invoiceDT = $('.table-return-items').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson", "SalesInvoice")",
                data: function (data) {
                    data.invoiceId = $("#invoice-invoice").hasClass("select2-hidden-accessible")
                        && $("#invoice-invoice").select2("data").length > 0
                        ? $("#invoice-invoice").select2("data")[0].id
                        : 0
                },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-success btn-xs btn-add-item" data-microtip-title="Add Item" data-microtip-position="right" role="tooltip"><i class="fas fa-plus"></i></button>';
                        return actions;
                    }
                },
                { data: "quantity", name: "Quantity", className: "text-end form-cell" },
                { data: "itemCode", name: "ItemCode", className: "form-cell" },
                { data: "itemName", name: "ItemName", className: "form-cell" },
                { data: "netPrice", name: "NetPrice", className: "text-end form-cell" },
                { data: "discount1", name: "Discount1", className: "text-end form-cell" },
                { data: "discount2", name: "Discount2", className: "text-end form-cell" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end form-cell" }
            ],
            order: [[0, "asc"]]
        });

        invoiceDT.on("draw", function () {
            $(".table-invoice th").removeClass("form-cell");
            hideLoader();

            $(".btn-add-item").on("click", function () {
                var rowdata = invoiceDT.row($(this).parents('tr')).data();
                if (rowdata) {
                    returnDT.row.add(rowdata).draw();
                    invoiceDT.row($(this).parents('tr')).remove().draw();
                    toastr.success("Added " + rowdata.itemCode + " on Return Item(s)");
                }
            });
        });

        var returnDT = $('.table-return').DataTable({
            data: [],
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="left" role="tooltip"><i class="fas fa-minus"></i></button>';
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="checkbox" class="isdefective" />';
                    },
                    className: "form-cell text-end"
                },
                { data: "itemCode", className: "form-cell" },
                { data: "itemName", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="' + data.quantity + '" value="1" class="form-control form-control-sm quantity" style="width: 100%;" />';
                    },
                    className: "form-cell text-end"
                },
                { data: "netPrice", className: "form-cell text-end sellingprice" },
                { data: "discount1", className: "form-cell text-end discount1" },
                { data: "discount2", className: "form-cell text-end discount2" },
                { data: "grossPrice", className: "form-cell text-end grossprice" },
                { data: "referenceNumber", className: "form-cell" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                
                columnDTTotalInteger(api, 4);
                columnDTTotalDecimal(api, 8);
            }
        });

        returnDT.on("draw", function () {
            $(".table-return .btn-remove-item").on("click", function () {
                returnDT.row($(this).parents('tr')).remove().draw();
            });

            $(".table-return thead th").removeClass("form-cell");
            $(".table-return thead th").removeClass("text-end");
            
            $(".quantity").on("input", function () {
                var quantity = parseInt($(this).parents("tr").find(".quantity").val());
                var rowdata = returnDT.row($(this).parents('tr')).data();
                var selling_price = rowdata.netPriceD;
                var discount1 = rowdata.discount1D;
                var discount2 = rowdata.discount2D;

                var gross_price = FormatStringDecimal(Round2Decimal(quantity * (((100 - discount1 - discount2) * selling_price) / 100)));
                $(this).parents("tr").find(".grossprice").html(gross_price);

                ComputeTotalQuantity();
                ComputeTotalGrossPrice();
            });
        });

        function ComputeTotalQuantity() {
            total_quantity = 0;
            returnDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        function ComputeTotalGrossPrice() {
            total_gross_price = 0;
            returnDT.rows().every( function ( rowIdx, tableLoop, rowLoop ) {
                total_gross_price += parseFloat($(this.node()).find(".grossprice").html().replace(",",""));
            } );
            $(".total-gross-price").html(FormatStringDecimal(total_gross_price));
        }

        returnDT.clear().draw();

        function GetItemsToReturn() {
            var item_to_return = [];
            returnDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                var row_isdefective = $(this.node()).find(".isdefective").prop("checked");
                item_to_return.push({
                    item: row_data.itemId,
                    quantity: row_quantity,
                    invoice: row_data.id,
                    sellingPrice: row_data.netPriceD,
                    discount1: row_data.discount1D,
                    discount2: row_data.discount2D,
                    isDefective: row_isdefective
                });
            });
            return item_to_return;
        }

        // Validation for Save
        var validateCreate = $("#form-return").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Customer: { required: true },
                Remarks: { maxlength: 250 }
            },
            messages: {
                CustomerCode: { required: "Please select customer" },
                AgentCode: { maxlength: "Remarks must not exceed 50 characters." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveReturn();
            }
        });

        function SaveReturn() {
            var itemsToReturn = GetItemsToReturn();
            if (itemsToReturn.length == 0) {
                toastr.warning("No item to return. Add an item to the list to continue");
            } else if (itemsToReturn.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't return an item with 0 quantity");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveJson")",
                    data: {
                        Customer: $("#return-customer-code").select2("data")[0].id,
                        Remarks: $("#return-remarks").val(),
                        Items: itemsToReturn
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
    }
