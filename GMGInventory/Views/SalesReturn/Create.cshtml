@{
    ViewData["Title"] = "New Sales Return";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesReturn" asp-action="Index">Sales Returns</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right btn-post ml-2">
                <span class="fas fa-save"></span> Save
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <label for="return-customer-code" class="form-label mb-0">Customer Code</label>
                    <select id="return-customer-code" style="width: 100%;">
                        <option></option>
                    </select>
                </p>
                <p class="text-sm">
                    <label for="return-customer-name" class="form-label mb-0">Customer Name</label>
                    <input type="text" id="return-customer-name" class="form-control form-control-sm" readonly="readonly" />
                </p>
                <p class="text-sm">
                    <label for="return-customer-address" class="form-label mb-0">Customer Address</label>
                    <input type="text" id="return-customer-address" class="form-control form-control-sm" readonly="readonly" />
                </p>
            </div>
        </div>
        <div class="card card-default">
            <div class="card-header">
                <span class="card-title">Sales Return Item(s)</span>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm float-right btn-tbr ml-2" data-microtip-title="(To Be Returned) Add Item selection from All Items" data-microtip-position="left" role="tooltip">
                        <span class="fas fa-plus"></span> TBR
                    </button>
                    <button type="button" class="btn btn-primary btn-sm float-right btn-invoice ml-2" data-bs-toggle="modal" data-bs-target="#invoiceModal" data-microtip-title="Add Item selection from Invoice" data-microtip-position="left" role="tooltip">
                        <span class="fas fa-file-invoice-dollar"></span> Invoice
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-head-fixed table-striped table-hover table-return">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Defective</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Quantity to Return</th>
                            <th>Unit Price</th>
                            <th>Discount 1</th>
                            <th>Discount 2</th>
                            <th>Gross Price</th>
                            <th>Reference Number</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Item Invoice Modal -->
<div class="modal fade" id="invoiceModal" role="dialog" aria-labelledby="invoiceModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Invoice Item(s)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <label for="invoice-invoice" class="text-muted fw-normal mb-0">Invoice</label>
                            <select id="invoice-invoice" style="width: 100%;">
                                <option></option>
                            </select>
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-4 col-sm-6">
                        <table class="table table-striped table-hover table-return-items">
                            <thead>
                                <tr>
                                    <th>Quantity</th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Quantity Ordered</th>
                                    <th>Quantity to Return</th>
                                    <th>Selling Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Gross Price</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary btn-save">
                        <span class="fas fa-plus"></span> Add Item
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- History Return Modal -->
<div class="modal fade" id="historyModal" role="dialog" aria-labelledby="historyModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Purchase Return</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <table class="table table-striped table-hover table-return-history">
                            <thead>
                                <tr>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Quantity</th>
                                    <th>Return By</th>
                                    <th>Return Date</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-history-print">
                    <span class="fas fa-print"></span> Print
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#return-customer-code").select2({
            minimumInputLength: 1,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });

        $("#return-customer-code").on("select2:select", function () {
            $("#return-customer-name").val($(this).select2("data")[0].name);
            $("#return-customer-address").val($(this).select2("data")[0].address);
        });

        $("#return-customer-code").on("select2:unselecting", function (e) {
            $("#return-customer-name").val("");
            $("#return-customer-address").val("");
        });

        var itemDT = $('.table-replenish').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson", "PurchaseOrder")",
                data: function (data) {
                    data.purchaseOrderId = $("#po-number").val()
                },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "itemCode", name: "ItemCode", className: "form-cell" },
                { data: "itemName", name: "ItemName", className: "form-cell" },
                { data: "quantity", name: "Quantity", className: "text-end form-cell" },
                { data: "unitPrice", name: "UnitPrice", className: "text-end form-cell" },
                { data: "netPrice", name: "NetPrice", className: "text-end form-cell" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<input type="number" value="0" min="0" max="' + data.quantity + '" class="form-control form-control-sm" style="width: 100%;" />';
                        return actions + "";
                    }
                }
            ],
            order: [[0, "asc"]]
        });

        itemDT.on("draw", function () {
            $(".table-replenish th").removeClass("form-cell");
            hideLoader();
        });

        var returnDT = $('.table-return-items').DataTable({
            data: [],
            filter: false,
            paging: false,
            info: false,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="left" role="tooltip"><i class="fas fa-minus"></i></button>';
                        return actions;
                    }
                },
                { data: "code" },
                { data: "name" },
                { data: "quantity" }
            ]
        });

        returnDT.on("draw", function () {
            $(".table-return-items .btn-remove-item").on("click", function () {
                returnDT.row($(this).parents('tr')).remove().draw();
            })
        });

        $(".btn-post").on("click", function () {
            if ($("#po-number").val() == "") {
                toastr.warning("Please select PO Number first");
            } else {
                var item_to_return = [];
                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    var row_input = parseInt($(this.node()).find("input").val());
                    if (row_input > 0) {
                        item_to_return.push({
                            id: row_data.id,
                            code: row_data.itemCode,
                            name: row_data.itemName,
                            quantity: row_input
                        });
                    }
                });
                if (item_to_return.length) {
                    returnDT.clear().draw();
                    $.each(item_to_return, function (i, item) {
                        returnDT.row.add(item).draw();
                    });
                    $("#save-po-number").val($("#po-number").text());
                    $("#save-remarks").val("");
                    $("#saveModal").modal("show");
                } else {
                    toastr.warning("No change in quantity. Nothing to return");
                }
            }
        });

        $(".btn-save").on("click", function () {
            if (returnDT.rows().count() > 0) {
                var item_to_return = [];
                returnDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    item_to_return.push({
                        POItemId: row_data.id,
                        Quantity: row_data.quantity
                    });
                });
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveJson", "PurchaseReturn")",
                    data: {
                        PurchaseOrderId: $("#po-number").val(),
                        Remarks: $("#save-remarks").val(),
                        Items: item_to_return
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#saveModal").modal("hide");
                            itemDT.ajax.reload();
                        }
                    }
                });
            } else {
                toastr.warning("Seems like the list of items to return have been cleared out.");
            }
        });

        var historyDT;
        $(".btn-history").on("click", function () {
            if ($("#po-number").val() == "") {
                toastr.warning("Please select PO Number first");
            } else {
                if ($.fn.DataTable.isDataTable('.table-return-history')) {
                    historyDT.destroy();
                    $('.table-return-history tbody').empty();
                }
                historyDT = $('.table-return-history').on('preXhr.dt', function (e, settings, data) {
                    showLoader();
                }).DataTable({
                    ajax: {
                        url: "@Url.Action("GetListJson", "PurchaseReturn")",
                        data: function (data) {
                            data.purchaseOrderId = $("#po-number").val()
                        },
                        dataSrc: function (json) {
                            return JSON.parse(JSON.stringify(json));
                        },
                        type: "POST",
                    },
                    filter: true,
                    responsive: true,
                    autoWidth: false,
                    columns: [
                        { data: "itemCode", name: "ItemCode", className: "form-cell" },
                        { data: "itemName", name: "ItemName", className: "form-cell" },
                        { data: "quantity", name: "Quantity", className: "text-end form-cell" },
                        { data: "returnBy", name: "ReturnBy", className: "form-cell" },
                        { data: "returnDate", name: "ReturnDate", className: "form-cell" },
                        { data: "remarks", name: "Remarks", className: "form-cell" }
                    ],
                    order: [[4, "desc"]]
                });

                historyDT.on("draw", function () {
                    hideLoader();
                });
            }
        });

        $(".btn-history-print").on("click", function () {
            var history_html = '<h3>Purchase Return History</h3>';
            history_html += '<table class="table-header">';
            history_html += '<tr><th>PO Number</th><td>' + $("#po-number").select2("data")[0].text + '</td></tr>';
            history_html += '<tr><th>Supplier</th><td>' + $(".selected-supplier").html() + '</td></tr>';
            history_html += '<tr><th>Order By</th><td>' + $(".selected-order-by").html() + '</td></tr>';
            history_html += '<tr><th>Order Date</th><td>' + $(".selected-order-date").html() + '</td></tr>';
            history_html += '</table>';

            history_html += '<table class="table-items">';
            history_html += '<tr>';
            history_html += '<th>Item Code</th>';
            history_html += '<th>Item Name</th>';
            history_html += '<th>Quantity</th>';
            history_html += '<th>Return By</th>';
            history_html += '<th>Return Date</th>';
            history_html += '<th>Remarks</th>';
            history_html += '</th>';
            historyDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                history_html += '<tr>';
                history_html += '<td>' + row_data.itemCode + '</td>';
                history_html += '<td>' + row_data.itemName + '</td>';
                history_html += '<td>' + row_data.quantity + '</td>';
                history_html += '<td>' + row_data.returnBy + '</td>';
                history_html += '<td>' + row_data.returnDate + '</td>';
                history_html += '<td>' + row_data.remarks + '</td>';
                history_html += '</tr>';
            });
            history_html += '</table>';
            $("#for-print").html(history_html);
            $("#for-print").printThis({
                importCSS: false,
                loadCSS: "/css/print.css",
                pageTitle: "GMG Inventory"
            });
        });
    </script>
    }
