@model SalesReturnVM

@{
    ViewData["Title"] = "Sales Return Details";
    ViewData["TitleDetails"] = $"[{Model.SRNumber}]";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesReturn" asp-action="Index">Sales Returns</a></li>
}

<div class="card card-default">
    <form id="form-return">
        <div class="card-header">
            <span class="card-title po-title">@ViewData["Title"]</span>
            <div class="card-tools">
                @if (userAccess.CanEdit)
                {
                    <button type="submit" class="btn btn-primary btn-sm float-right ml-2" value="update">
                        <span class="fas fa-save"></span> Update
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-save"></span> Update
                    </button>
                }

                @if (userAccess.CanPrint)
                {
                    <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                        <span class="fas fa-print"></span> Print
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-info btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Print access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-print"></span> Print
                    </button>
                }
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4">
                    <p class="text-sm">
                        @if (userAccess.CanEdit)
                        {
                            <label for="return-number" class="form-label text-muted fw-normal mb-0">@Html.DisplayNameFor(model => model.SRNumber)</label>
                            <input type="text" id="return-number" name="ReturnNumber" class="form-control form-control-sm" value="@Model.SRNumber" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.SRNumber)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model.SRNumber
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.SONumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @(string.IsNullOrWhiteSpace(Model.SONumber) ? "N/A" : Model.SONumber)
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @if (userAccess.CanEdit)
                        {
                            <label for="return-date" class="form-label text-muted fw-normal mb-0">@Html.DisplayNameFor(model => model.ReturnDate)</label>
                            <input type="date" id="return-date" name="ReturnDate" class="form-control form-control-sm" value="@Model.ReturnDate3" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.ReturnDate)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model.ReturnDate
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerCode)
                        </span>
                        <b class="d-block form-gayahin">
                            @(string.IsNullOrWhiteSpace(Model.CustomerCode) ? "N/A" : Model.CustomerCode)
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerName)
                        </span>
                        <b class="d-block form-gayahin">
                            @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "N/A" : Model.CustomerName)
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerAddress)
                        </span>
                        <b class="d-block form-gayahin">
                            @(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "N/A" : Model.CustomerAddress)
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @if (userAccess.CanEdit)
                        {
                            <label for="return-remarks" class="form-label text-muted fw-normal mb-0">@Html.DisplayNameFor(model => model.Remarks)</label>
                            <input type="text" id="return-remarks" name="Remarks" class="form-control form-control-sm" value="@Model.Remarks" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.Remarks)
                            </span>
                            <b class="d-block form-gayahin">
                                @(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserCreated)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model.UserCreated
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateCreated)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model.DateCreated
                        </b>
                    </p>
                </div>
                @if (Model.UserModified != null)
                {
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.UserModified)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model.UserModified
                            </b>
                        </p>
                    </div>
                }
                @if (Model.DateModified != null)
                {
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.DateModified)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model.DateModified
                            </b>
                        </p>
                    </div>
                }
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Return Item(s)</span>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th>Reason of Return</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Price</th>
                                        <th>Discount 1</th>
                                        <th>Discount 2</th>
                                        <th>Gross Price</th>
                                        <th>Reference Number</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th class="total-gross-price">0.00</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var return_details = @Html.Raw(Json.Serialize(Model));

        $("#return-customer").select2({
            minimumInputLength: 1,
            placeholder: return_details.customerCode,
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " +
                         (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : "") +
                         (repo.disabledReason ? "<br /><small class='text-danger'>" + repo.disabledReason + "</small>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            }
        });

        $("#return-customer").on("select2:select", function () {
            $("#return-customer-name").val($(this).select2("data")[0].name);
        });

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            //showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { 
                    salesReturnId: return_details.id
                },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "reasonOfReturn", name: "ReasonOfReturn" },
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Item/Details/" + data.itemId + "' class='link-info' target='_blank'>" + data.itemCode + "</a>";
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "unit", name: "Unit" },
                { data: "sellingPrice", name: "SellingPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" },
                { data: "referenceNumber", name: "ReferenceNumber" },
            ],
            order: [[0, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 3);
                columnDTTotalDecimal(api, 8);
            }
        });

        itemDT.on("draw", function () {
            //hideLoader();

            $(".table-item thead th").removeClass("text-end");
        });

        // Validation for Save
        var validateCreate = $("#form-return").validate({
            rules: {
                ReturnNumber: { required: true, maxlength: 50 },
                ReturnDate: { required: true },
                Remarks: { maxlength: 500 }
            },
            messages: {
                ReturnNumber: { required: "Please enter Sales Return Number", maxlength: "Sales Return Number must not exceed 50 characters" },
                ReturnDate: { required: "Please select the Return Date" },
                Remarks: { maxlength: "Sales Return must not exceed 500 characters" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();

                SaveReturn();
            }
        });

        function SaveReturn() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("SaveJson")",
                data: {
                    Id: return_details.id,
                    ReturnNumber: $("#return-number").val(),
                    SalesOrder: return_details.soId,
                    ReturnDate: $("#return-date").val(),
                    Remarks: $("#return-remarks").val()
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                    }
                }
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                if ($("#return-number").val() != return_details.srNumber
                    || $("#return-customer").val() != ''
                    || $("#return-date").val() != return_details.returnDate3
                    || $("#return-remarks").val() != return_details.remarks) {
                    $("#form-return").submit();
                }
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintDetails")/' + return_details.id, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
}