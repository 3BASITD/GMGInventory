@model ReceivingPVM

@{
    Layout = "";
    var title = "Receiving Listing";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Brand</strong>
        <span>@Model.Brand</span>
        <br />
        <strong>Date From</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Date To</strong>
        <span>@Model.DateTo</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>Brand</th>
                <th>Item Type</th>
                <th>Item Code</th>
                <th>Item Name</th>
                <th>Part Number</th>
                <th>Unit</th>
                <th>Document Number</th>
                <th>Date</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Receivings)
            {
                <tr>
                    <td><nobr>@item.Brand</nobr></td>
                    <td><nobr>@item.ItemType</nobr></td>
                    <td>@item.ItemCode</td>
                    <td>@item.ItemName</td>
                    <td>@item.PartNumber</td>
                    <td><nobr>@item.Unit</nobr></td>
                    <td><nobr>@item.DocumentNumber</nobr></td>
                    <td><nobr>@item.Date</nobr></td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="8" class="right-text">Total</th>
                <th class="right-text">@Model.TotalQuantity</th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>