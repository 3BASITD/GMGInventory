@model ReceivingSupplierPVM

@{
    Layout = "";
    var title = "Receiving Listing by Supplier";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Supplier</strong>
        <span>@Model.Supplier</span>
        <br />
        <strong>Date From</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Date To</strong>
        <span>@Model.DateTo</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().Supplier)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().Date)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().DocumentNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().Item)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().Quantity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().Unit)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().UnitCost)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReceivingSuppliers.First().Amount)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ReceivingSuppliers)
            {
                <tr>
                    <td><nobr>@item.Supplier</nobr></td>
                    <td><nobr>@item.Date</nobr></td>
                    <td>@item.DocumentNumber</td>
                    <td>@item.Item</td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td><nobr>@item.Unit</nobr></td>
                    <td class="right-text"><nobr>@item.UnitCost</nobr></td>
                    <td class="right-text"><nobr>@item.Amount</nobr></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="7" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalAmount</nobr></th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>