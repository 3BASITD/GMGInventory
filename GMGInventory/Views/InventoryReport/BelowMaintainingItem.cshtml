@model IEnumerable<BelowMaintainingRVM>

@{
    ViewData["Title"] = "Items Below Maintaining Quantity";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
        @if (userAccess.CanPrint)
        {
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
        }
        @if (userAccess.CanUploadDownload)
        {
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
        }
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-quantity">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.MaintainingQuantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.QuantityOnHand)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end">Total</th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item" class="form-label mb-0">Item Code</label>
                            <select id="filter-item" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-name" class="form-label mb-0">Item Name</label>
                            <input type="text" id="filter-item-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Item
        $("#filter-item").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: 'All',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                        : "") +
                    "<br />" +
                    "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                delay: 500,
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-item").on("select2:select", function () {
            $("#filter-item-name").val($(this).select2("data")[0].name);
        });

        $("#filter-item").on("select2:unselecting", function (e) {
            $("#filter-item-name").val("");
        });

        // Load Select2 for Brand
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Brand")",
            success: function (data, status, xhr) {
                $("#filter-brand").select2({
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        // Load List on DataTable
        var quantityDT = $('.table-quantity').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetBelowMaintainingDT")",
                type: "POST",
                data: function (data) {
                    var itemId = $("#filter-item").val();
                    var brandId = $("#filter-brand").val();

                    if (itemId) data.Item = itemId;
                    if (brandId) data.Brand = brandId;
                }
            },
            processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "brand", name: "Brand" },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                { data: "partNumber", name: "PartNumber" },
                { data: "unit", name: "Unit" },
                { data: "maintainingQuantity", name: "MaintainingQuantity", className: "text-end" },
                { data: "quantityOnHand", name: "QuantityOnHand", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = quantityDT.ajax.json();
                var api = this.api(), data;

                $(api.column(5).footer()).html(FormatStringDecimal(json.totalQuantity));
                $(api.column(6).footer()).html(FormatStringDecimal(json.totalQuantity2));
            },
            order: [[0, "desc"]]
        });

        // Load functions upon DataTable load
        quantityDT.on("draw", function () {
            hideLoader();

            $(".table-quantity thead th").removeClass("text-end");
        });

        $(".btnFilter").on("click", function () {
            quantityDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
                if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
                window.location = "@Url.Action("DownloadBelowMaintaining")?" + urlQuery.join("&");
            });
        }
        if (user_access.canPrint) {
            $(".printBtn").on("click", function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                var urlQuery = [];
                if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
                if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintBelowMaintaining")?' + urlQuery.join("&"), '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
    }