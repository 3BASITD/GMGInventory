@model IEnumerable<StockStatusRVM>

@{
    ViewData["Title"] = "Stock Status";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
        @if (userAccess.CanPrint)
        {
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
        }
        @if (userAccess.CanUploadDownload)
        {
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
        }
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-stock">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.QuantityOnHand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UnitCost)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalCost)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="6" class="text-end">Total</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item" class="form-label mb-0">Item Code</label>
                            <select id="filter-item" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-name" class="form-label mb-0">Item Name</label>
                            <input type="text" id="filter-item-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-warehouse" class="form-label mb-0">Warehouse</label>
                            <select id="filter-warehouse" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Item
        $("#filter-item").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                        : "") +
                    "<br />" +
                    "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-item").on("select2:select", function () {
            $("#filter-item-name").val($(this).select2("data")[0].name);
        });

        $("#filter-item").on("select2:unselecting", function (e) {
            $("#filter-item-name").val("");
        });

        // Load Select2 for Brand
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Brand")",
            success: function (data, status, xhr) {
                $("#filter-brand").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "ALL"
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        // Load Select2 for Warehouse
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Warehouse")",
            success: function (data, status, xhr) {
                $("#filter-warehouse").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "ALL"
                    },
                    minimumResultsForSearch: -1,
                    templateResult: function (repo) {
                        if (repo.loading) {
                            return repo.text;
                        }
                        return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            stockDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            stockDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            ItemId: "",
            ItemCode: "",
            ItemName: "",
            BrandId: "",
            Brand: "",
            WarehouseId: "",
            Warehouse: ""
        };

        function checkDTChanged() {
            if(!stockDT) return false;
            
            return JSON.stringify(stockDT.order()) != JSON.stringify(defaultDTState.order) ||
                   stockDT.page.info().start != defaultDTState.page ||
                   stockDT.page.len() != defaultDTState.length ||
                   (stockDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-item").val() != defaultDTState.ItemId ||
                   $("#filter-brand").val() != defaultDTState.BrandId ||
                   $("#filter-warehouse").val() != defaultDTState.WarehouseId;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            $('#filter-item').val(defaultDTState.ItemId).trigger('change');
            $('#filter-brand').val(defaultDTState.BrandId).trigger('change');
            $('#filter-warehouse').val(defaultDTState.WarehouseId).trigger('change');
            
            localStorage.removeItem(dt_storage);

            if (stockDT) {
                stockDT.state.clear();
                stockDT.order(defaultDTState.order);
                stockDT.page(defaultDTState.page);
                stockDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        // Load List on DataTable
        var stockDT = $('.table-stock').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.ItemId = $('#filter-item').val();
                data.ItemCode = $('#filter-item option:selected').text();
                data.ItemName = $('#filter-item-name').val();
                data.BrandId = $('#filter-brand').val();
                data.Brand = $('#filter-brand option:selected').text();
                data.WarehouseId = $('#filter-warehouse').val();
                data.Warehouse = $('#filter-warehouse option:selected').text();
            },
            stateLoadParams: function (settings, data) {
                if (data.ItemId) {
                    var itemOption = new Option(data.ItemCode, data.ItemId, true, true);
                    $(itemOption).data('data', {
                        id: data.ItemId,
                        text: data.ItemCode,
                        name: data.ItemName
                    });
                    $("#filter-item").append(itemOption).trigger('change');
                    $("#filter-item-name").val(data.ItemName);
                }
                if (data.BrandId) {
                    var brandOption = new Option(data.Brand, data.BrandId, true, true);
                    $("#filter-brand").append(brandOption).trigger('change');
                }
                if (data.Warehouse) {
                    var warehouseOption = new Option(data.Warehouse, data.WarehouseId, true, true);
                    $("#filter-warehouse").append(warehouseOption).trigger('change');
                }
            },
            ajax: {
                url: "@Url.Action("GetStockStatusDT")",
                type: "POST",
                data: function (data) {
                    var brandId = $("#filter-brand").val();
                    var itemId = $("#filter-item").val();
                    var warehouseId = $("#filter-warehouse").val();

                    if (brandId) data.Brand = brandId;
                    if (itemId) data.Item = itemId;
                    if (warehouseId) data.Warehouse = warehouseId;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "brand", name: "Brand" },
                { data: "itemType", name: "ItemType" },
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Item/Details/" + data.itemId + "' class='link-info' target='_blank'>" + data.itemCode + "</a>";
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "partNumber", name: "PartNumber" },
                { data: "unit", name: "Unit" },
                { data: "quantityOnHand", name: "QuantityOnHand", className: "text-end" },
                { data: "unitCost", name: "UnitCost", className: "text-end" },
                { data: "totalCost", name: "TotalCost", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = stockDT.ajax.json();
                var api = this.api(), data;

                $(api.column(6).footer()).html(FormatStringInteger(json.totalQuantity));
                $(api.column(8).footer()).html(FormatStringDecimal(json.TotalAmount));
            },
            order: defaultDTState.order
        }).on("draw", function () {
            checkDefaultFilter();
            $(".table-stock thead th").removeClass("text-end");
        });

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
                if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
                if ($("#filter-warehouse").val()) { urlQuery.push("Warehouse=" + $("#filter-warehouse").val()); }
                window.location = "@Url.Action("DownloadStockStatus")?" + urlQuery.join("&");
            });
        }
        if (user_access.canPrint) {
            $(".printBtn").on("click", function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                var urlQuery = [];
                if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
                if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
                if ($("#filter-warehouse").val()) { urlQuery.push("Warehouse=" + $("#filter-warehouse").val()); }
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintStockStatus")?' + urlQuery.join("&"), '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
    }