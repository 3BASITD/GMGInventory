@model InvoiceDetailsVM

@{
    ViewData["Title"] = "Sales Invoice";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesInvoice" asp-action="Index">Sales Invoice</a></li>
}

    <div class="card card-default">
        <form id="form-invoice">
            <div class="card-header">
                <span class="card-title">@ViewData["Title"]</span>
                <div class="card-tools">
                    <button type="submit" class="btn btn-primary btn-sm float-right ml-2">
                        <span class="fas fa-paper-plane"></span> Submit
                    </button>
                    <a class="btn btn-light btn-sm float-right" asp-action="Index">
                        <span class="fas fa-arrow-left"></span> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 col-md-4 col-sm-6">
                        <div class="form-group">
                            <label for="invoice-pack-number" class="form-label mb-0">Pack Number</label>
                            <select id="invoice-pack-number" class="s2-bold s2ph-bold s2ph-dark" name="PackNumber" style="width: 100%"></select>
                            <span data-valmsg-for="invoice-pack-number" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-4 col-sm-6">
                        <div class="form-group">
                            <label for="invoice-control-number" class="form-label mb-0">BIR Invoice Number</label>
                            <input type="text" id="invoice-control-number" name="ControlNumber" class="form-control form-control-sm" />
                            <span data-valmsg-for="invoice-control-number" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <div class="form-group">
                            <label for="invoice-invoice-type" class="form-label mb-0">Invoice Type</label>
                            <select id="invoice-invoice-type" class="form-control form-control-sm"></select>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <div class="form-group">
                            <label for="invoice-remarks" class="form-label mb-0">Remarks</label>
                            <input type="text" id="invoice-remarks" class="form-control form-control-sm" />
                            <span data-valmsg-for="invoice-remarks" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">@Html.DisplayNameFor(model => model.CustomerName)</span>
                            <b class="d-block">@Model?.CustomerName</b>
                        </p>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">@Html.DisplayNameFor(model => model.CustomerCode)</span>
                            <b class="d-block">@Model?.CustomerCode</b>
                        </p>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">@Html.DisplayNameFor(model => model.CustomerAddress)</span>
                            <b class="d-block">@Model?.CustomerAddress</b>
                        </p>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">@Html.DisplayNameFor(model => model.SONumber)</span>
                            <b class="d-block">@Model?.SONumber</b>
                        </p>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">@Html.DisplayNameFor(model => model.PaymentTerms)</span>
                            <b class="d-block">@Model?.PaymentTerms</b>
                        </p>
                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">@Html.DisplayNameFor(model => model.Agent)</span>
                            <b class="d-block">@Model?.Agent</b>
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <span class="card-title">Invoiced Item(s)</span>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                        <span class="fas fa-plus"></span> Add Invoiced Item
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <table class="table table-head-fixed table-striped table-hover table-item">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Quantity</th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Gross Price</th>
                                            <th>Discount 1</th>
                                            <th>Discount 2</th>
                                            <th>Extended Price</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>Total</th>
                                            <th class="total-quantity">0</th>
                                            <th colspan="5"></th>
                                            <th class="total-extended">0.00</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Invoice Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <table class="table table-head-fixed table-striped table-hover table-pack">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Selling Price</th>
                                    <th>Packed Quantity</th>
                                    <th>Gross Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Extended Price</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Close
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        $("#invoice-pack-number").select2({
            minimumInputLength: 1,
            placeholder: '@Model?.PackNumber',
            ajax: {
                url: "@Url.Action("GetOptions", "Pack")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });

        $("#pack-so-number").on("select2:select", function () {
            window.location = "@Url.Action("Create", "Pack", new { id = "" })/" + $("#pack-so-number").val();
        });

        // Load invoice type data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetInvoiceTypeOptions")",
            success: function (data, status, xhr) {
                $("#invoice-invoice-type").select2({
                    data: data,
                    minimumResultsForSearch: -1
                });
            }
        });

        function clearItemForm() {
            $("#add-code").val("").trigger("change");
            $("#add-name").val("");
            $("#add-net-price").val("0.00");
            $("#add-retail-price").val("0.00");
            $("#add-quantity").val("0");
            $("#add-unit").val("");
            $("#add-selling-price").val("0.00");
            $("#add-discount1").val("0.00");
            $("#add-discount2").val("0.00");
            $("#add-gross-price").val("0.00");
        }

        $(".createBtn").on("click", clearItemForm);

        var packDT = $('.table-pack').DataTable({
            ajax: {
                url: "@Url.Action("GetItemsWithPriceJson", "Pack")",
                data: { packId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-success btn-xs btn-add-item" data-microtip-title="Add Item" data-microtip-position="left" role="tooltip"><i class="fas fa-plus"></i></button>';
                        return actions;
                    }
                },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                { data: "sellingPrice", name: "SellingPrice", className: "text-end" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "extendedPrice", name: "ExtendedPrice", className: "text-end" }
            ]
        });

        packDT.on("draw", function () {
            $(".table-item thead th").removeClass("text-end");

            $(".btn-add-item").on("click", function () {
                var rowdata = packDT.row($(this).parents('tr')).data();
                itemDT.row.add(rowdata).draw();
                packDT.row($(this).parents('tr')).remove().draw();
                toastr.success("Added " + rowdata.itemCode + " on Invoice Item");
            });
        });

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="left" role="tooltip"><i class="fas fa-minus"></i></button>';
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" value="' + data.quantity + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "itemCode", name: "ItemCode", className: "form-cell" },
                { data: "itemName", name: "ItemName", className: "form-cell" },
                { data: "sellingPrice", name: "SellingPrice", className: "form-cell text-end" },
                { data: "discount1", name: "Discount1", className: "form-cell text-end" },
                { data: "discount2", name: "Discount2", className: "form-cell text-end" },
                { data: "extendedPrice", name: "ExtendedPrice", className: "form-cell text-end extendedprice" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 1);
                columnDTTotalDecimal(api, 7);
            }
        });

        itemDT.on("draw", function () {
            $(".table-item th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".btn-remove-item").on("click", function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                packDT.row.add(rowdata).draw();
                itemDT.row($(this).parents('tr')).remove().draw();
                toastr.warning("Removed " + rowdata.itemCode + " on Invoice Item");
                ComputeTotalQuantity();
                ComputeTotalExtendedPrice();
            });

            $(".quantity").on("input", function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                var quantity = parseInt($(this).parents("tr").find(".quantity").val());
                var selling_price = rowdata.sellingPriceD;
                var discount1 = rowdata.discount1D;
                var discount2 = rowdata.discount2D;

                var extended_price = FormatStringDecimal(Round2Decimal(quantity * (((100 - discount1 - discount2) * selling_price) / 100)));
                $(this).parents("tr").find(".extendedprice").html(extended_price);
                ComputeTotalQuantity();
                ComputeTotalExtendedPrice();
            });
        });

        function ComputeTotalQuantity() {
            total_quantity = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        function ComputeTotalExtendedPrice() {
            total_extended_price = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_extended_price += parseFloat($(this.node()).find(".extendedprice").html().replace(",", ""));
            });
            $(".total-extended").html(FormatStringDecimal(total_extended_price));
        }

        itemDT.clear().draw();

        function GetItemsToInvoice() {
            var item_to_invoice = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                item_to_invoice.push({
                    item: row_data.itemId,
                    quantity: row_quantity
                });
            });
            return item_to_invoice;
        }

        // Validation for Create
        var validateCreate = $("#form-invoice").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                ControlNumber: { required: true, maxlength: 50 },
                AgentCode: { maxlength: 250 }
            },
            messages: {
                ControlNumber: { required: "Please enter BIR Invoice Number", maxlength: "BIR Invoice Number must not exceed 50 characters." },
                Remarks: { maxlength: "BIR Invoice Number must not exceed 250 characters." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveInvoice();
            }
        });

        function SaveInvoice() {
            var itemsToInvoice = GetItemsToInvoice();
            if (itemsToInvoice.length == 0) {
                toastr.warning("No item to invoice. Add an item to the list to continue");
            } else if (itemsToInvoice.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't invoice an item with 0 quantity");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveJson")",
                    data: {
                        PackId: @Model?.PackNumber,
                        BIRInvoiceNumber: $("#invoice-control-number").val(),
                        InvoiceType: $("#invoice-invoice-type").val(),
                        Remarks: $("#invoice-remarks").val(),
                        Items: itemsToInvoice
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            //toastr.success(data.message, "Success");
                            //toastr.warning("Page will redirect to details", 'Page Redirect', {
                            //    timeOut: 3000,
                            //    onHidden: function () {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                            //    },
                            //    progressBar: true
                            //});
                        }
                    }
                });
            }
        }
    </script>
        }
