    document.addEventListener("DOMContentLoaded", function () {
        const nameCell = document.querySelector(".si-customer-name");
        const withNewLine = document.querySelector(".table-customer-with-newline");
        const withoutNewLine = document.querySelector(".table-customer-without-newline");
        if (nameCell && withNewLine && withoutNewLine && nameCell.scrollHeight < 30 && nameCell.clientHeight < 30) {
            withNewLine.style.display = "none";
            withoutNewLine.style.display = "";
        } else {
            withNewLine.style.display = "";
            withoutNewLine.style.display = "none";
        }
    });

    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>