@model InvoiceDetailsWithItemsVM

@{
    Layout = "";
    var title = "Sales Invoice";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/printreceipt.css" asp-append-version="true" />
    <style>
        * {
            font-size: 15px;


        }



    </style>
</head>
<body>
    @if (Model.InvoiceType == "Sales Invoice")
    {
        <!-- SALES INVOICE -->
        @* var topMargin = 24; *@

        var company = TempData["CompanyTemplate"]?.ToString() ?? "BAS";
        var topMargin = TempData["MarginTop"]?.ToString() ?? "24";
        var itemHeight = company == "3BAS" ? "310" : "350";//280
        var headerItemSpace = company == "3BAS" ? "5" : "0";//50
        var maxItems = company == "3BAS" ? 8 : 17;

        var itemdetailsHeight = company == "3BAS" ? "0" : "65";
       

        if (company == "3BAS") topMargin = "94";//124

        @* if (TempData["CompanyTemplate"]?.ToString() == "BAS")
        {
            topMargin = 24;
        }
        else
        {
            topMargin = 44;
        } *@
        <div style="height: @(topMargin)px;">.</div>
        <div style="padding-left:40px; padding-right: 25px;">
            <table style="font-size:16px;">
                <tbody>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 125px;"></td>
                        <td></td>
                        <td style="width: 75px;"></td>
                        <td style="width: 100px;"></td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 125px;"></td>
                        <td></td>
                        <td colspan="2" style="padding-top:@(company == "3BAS" ? 0 : 25)px !important">@Model.InvoiceDateD.ToString("MMMM dd, yyyy")</td>
                    </tr>
                    <tr>
                        <td colspan="4"></td>
                        <td style="width: 100px;">@(company != "3BAS" ? Model.PaymentTerms : "")</td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 125px;"></td>
                        <td colspan="2" style="padding-top: @(company == "3BAS" ? 0 : 5)px;">@Model.CustomerName</td>
                        <td style="width: 100px; padding-top: 4px;">@Model.Agent</td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td colspan="3" style="padding: 3px;">@(Model.TIN == "0" || string.IsNullOrWhiteSpace(Model.TIN) ? "N/A" : Model.TIN)</td>
                        <td style="width: 100px; padding-top: 4px;">@Model.SONumber</td>
                    </tr>
                    <tr>
                        <td style="width: 50px;padding-left:70px;padding-top:10px"></td>
                        <td style="width: 50px;padding-left: 100px"></td>
                        <td style="width: 50px;padding-top:3px;">@(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "N/A" : Model.CustomerAddress)</td>
                        <td></td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 50px;padding-left: 100px;padding-top:5px;">@(company == "3BAS" ? Model.PaymentTerms : "")</td>
                        <td style="width: 50px;"></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 50px;"></td>
                        <td></td>
                        <td></td>
                    </tr>
@*                     <tr>
                        <td style="width: 50px;padding-left: 100px;padding-top:15px;"></td>
                        <td style="width: 50px;"></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        
                        <td></td>
                    </tr> *@
                    

                </tbody>
            </table>
            <div style="height: @(itemHeight)px;">
                <table style="margin-top: @(headerItemSpace)px;">
                    <tbody>
                        <tr>
                            <td style="width: 90px;margin-left: 0px; "></td>
                            <td></td>
                            <td style="width: 75px;"></td>
                            <td style="width: 90px;"></td>
                            <td style="width: 115px;"></td>
                        </tr>
                        @{
                            int rowctr = 0, otherQuantity = 0;
                            decimal otherGrossPrice = 0;
                            string promo = "Free";
                            @foreach (var item in Model.Items)
                            {
                                if (item.Discount1D != 0 || item.Discount2D != 0) promo = "DSC";
                                rowctr++;
                                if (rowctr < maxItems || Model.Items.Count == maxItems)
                                {

                                    <tr>
                                        <td class="auto-font-size" style="width: 60px;margin-left:0px !important">@item.PartNumber</td>
                                        <td class="auto-font-size" style="padding-left: 0px;width: 75px;">@item.ItemName</td>
                                        <td style="width: 75px;">@item.Quantity @item.Unit </td>
                                        <td style="width: 90px;" class="currency">@(item.IsPromo == true ? promo : item.NetPrice)</td>
                                        <td style="width: 115px;" class="currency">@item.GrossPriceNoDiscount</td>

                                    </tr>
                                }
                                else
                                {
                                    otherQuantity += item.QuantityD;
                                    otherGrossPrice += item.GrossPriceNoDiscountD;
                                }
                            }

                            @if (otherQuantity > 0)
                            {
                                <tr>
                                    <td style="width: 90px;"></td>
                                    <td>+@(Model.Items.Count - (maxItems - 1)) more item(s)</td>
                                    <td style="width: 75px;">@otherQuantity</td>
                                    <td style="width: 90px;"></td>
                                    <td style="width: 115px;" class="currency">@string.Format("{0:#,##0.00}", otherGrossPrice)</td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td style="width: 90px;"></td>
                                    <td>*** NOTHING FOLLOWS ***</td>
                                    <td style="width: 75px;"></td>
                                    <td style="width: 90px;"></td>
                                    <td style="width: 115px;"></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <table style="margin-top:@(itemdetailsHeight)px">
                <tbody >
                    <tr>
                        <td colspan="4" class="currency">Total:</td>
                        <td style="width: 115px;" class="currency">@Model.Total</td>
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency">LESS @Model.DiscountPercent:</td>
                        <td style="width: 115px;" class="currency">@Model.DiscountAmount</td>
                        @*<td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.LessVat</td> <!-- Less VAT --> *@
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.Total</td> 
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.AmountNetVat</td> <!--Amount Net Vat-->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        @*<td colspan="4" class="currency">@(@Model.DiscountPercentD == 0 ? "" : "DSC")</td>
                        <td style="width: 115px;" class="currency">@Model.DiscountAmount</td>  <!--Discounted Amount--> *@
                        <td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency">
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                         <td style="width: 115px;" class="currency">
                        @* <td style="width: 115px;" class="currency">@Model.WithHoldingTaxD</td> <!-- Withholding Tax --> *@
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.AddVatD</td> <!-- Added Vat -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                        @* <td style="width: 115px;" class="currency">@Model.TotalAmoutDueD</td> <!-- Total Amount Due --> *@
                        <td style="width: 115px;" class="currency">@Model.Total</td>
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency"></td> <!-- Less: Discount -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency"></td> <!-- SC/PWD/... -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="currency"></td>
                        <td style="width: 115px;" class="currency"></td> <!-- Less Withholding Tax -->
                        <td style="width: 10px;"></td>
                    </tr>
                   @*  <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.VATAmount</td> <!-- Add: VAT -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.DiscountedTotal</td> <!-- TOTAL AMOUNT DUE -->
                        <td style="width: 10px;"></td>
                    </tr> *@
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- DELIVERY RECEIPT -->
        <span style="font-size: 20px;">@Model.SONumber</span>
        <table class="for-dr" style="padding-top: 0px;">
            <tbody>
                <tr>
                    <td style="width: 100px;"></td> <!-- INDENT -->
                    <td class="auto-font-size">@Model.CustomerName</td>
                    <td style="width: 40px;"></td> <!-- INDENT -->
                    <td style="width: 180px;padding-top:2px;">@Model.InvoiceDateD.ToString("MM/dd/yy")</td>
                </tr>
                <tr>
                    <td style="width: 100px;"></td> <!-- INDENT -->
                    <td class="auto-font-size" style="padding-top: 0px;">@(string.IsNullOrEmpty(Model.CustomerAddress) ? "N/A" : Model.CustomerAddress)</td>
                    <td style="width: 40px;"></td> <!-- INDENT -->
                    <td style="width: 180px;" style="padding-top: 0px;">@(string.IsNullOrWhiteSpace(Model.PaymentTerms) ? "N/A" : Model.PaymentTerms)</td>
                </tr>
                <tr>
                    <td style="width: 100px;"></td> <!-- INDENT -->
                    <td></td>
                    <td style="width: 40px;"></td> <!-- INDENT -->
                    <td style="width: 180px;" class="auto-font-size">@Model.Agent</td>
                </tr>
            </tbody>
        </table>
        @*<table style="margin-top: 26px;">*@
        <div style="min-height:315px;margin-top: 10px;">
            <table class="for-dr">
                <tbody>
                    <tr>
                        <td style="width: 40px !important;"></td>
                        <td style="width: 40px !important;"></td>
                        <td style="width: 150px !important;"></td>
                        <td style="width: 75px"></td>
                        <td></td>
                        <td style="width: 75px !important;" class="currency"></td>
                        <td style="width: 75px !important;" class="currency"></td>
                    </tr>
                    @{
                        int rowctr = 0, otherQuantity = 0;
                        decimal otherGrossPrice = 0;
                        string promo = "Free";
                        @foreach (var item in Model.Items)
                        {
                            if (item.Discount1D != 0 || item.Discount2D != 0) promo = "Discounted";
                                

                            rowctr++;
                            if (rowctr < 12 || Model.Items.Count == 12)
                            {
                                <tr>
                                    <td style="width: 40px;">@item.Quantity</td>
                                    <td style="width: 40px;">@item.Unit</td>
                                    <td class="auto-font-size" style="width: 150px;">@item.PartNumber</td>
                                    <td class="auto-font-size" colspan="2">@item.ItemName</td>
                                    <td style="width: 75px;" class="currency">@(item.IsPromo == true ? promo : item.NetPrice)</td>
                                    <td style="width: 75px;" class="currency"> @(item.IsPromo == true ? (promo == "Discounted" ? item.GrossPrice : "") : item.GrossPriceNoDiscount)</td>
                                </tr>
                            }
                            else
                            {
                                otherQuantity += item.QuantityD;
                                otherGrossPrice += item.GrossPriceNoDiscountD;
                            }
                        }

                        @if (otherQuantity > 0)
                        {
                            <tr>
                                <td style="width: 75px;">@otherQuantity</td>
                                <td colspan="4">+@(Model.Items.Count - 11) more item(s)</td>
                                <td style="width: 75px;" class="currency">@string.Format("{0:#,##0.00}", otherGrossPrice)</td>
                            </tr>
                        }
                        @* else
                    {
                        for (int rem = 0; rem <= 11 - Model.Items.Count; rem++)
                        {
                            <tr>
                                <td style="width: 75px;"></td>
                                <td style="width: 50px;"></td>
                                <td style="width: 75px;"></td>
                                <td></td>
                                <td style="width: 80px;" class="currency"></td>
                                <td style="width: 125px;" class="currency"></td>
                            </tr>
                        }
                    } *@
                    }
                </tbody>
            </table>
        </div>
        <table class="for-dr">
            <tbody>
                <tr>
                    <td style="width: 120px;" class="currency">Subtotal:</td>
                    <td style="width: 125px;" class="currency">@Model.VATExclusive</td>
                    <td>&nbsp;</td>
                    <td style="width: 120px;" class="currency">Total:</td>
                    <td style="width: 125px;" class="currency">@Model.Total</td>
                </tr>
                <tr>
                    <td style="width: 120px;" class="currency">12% VAT:</td>
                    <td style="width: 125px;" class="currency">@Model.VATAmount</td>
                    <td>&nbsp;</td>
                    <td style="width: 120px;" class="currency">LESS @Model.DiscountPercent:</td>
                    <td style="width: 125px;" class="currency">@Model.DiscountAmount</td>
                </tr>
                <tr>
                    <td style="width: 120px;" class="currency">Total Amount:</td>
                    <td style="width: 125px;" class="currency">@Model.DiscountedTotal</td>
                    <td>&nbsp;</td>
                    <td style="width: 120px;" class="currency"></td>
                    <td style="width: 125px;" class="currency">@Model.DiscountedTotal</td>
                </tr>
            </tbody>
        </table>
    }
</body>
<script type="text/javascript">
@*     document.addEventListener('DOMContentLoaded', () => {
        const DEFAULT_HEIGHT = 26;

        document.querySelectorAll('.auto-font-size').forEach(el => {
            let size = parseInt(getComputedStyle(el).fontSize, 10);

            let measureTarget = el;
