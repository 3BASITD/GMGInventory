@model InvoiceDetailsWithItemsVM

@{
    Layout = "";
    var title = "Sales Invoice";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/printreceipt.css" asp-append-version="true" />
    <style>
        * {
            font-size: 15px;
        }
    </style>
</head>
<body>
    @if (Model.InvoiceType == "Sales Invoice")
    {
        <!-- SALES INVOICE -->
        var topMargin = 24;

        @* if (TempData["CompanyTemplate"]?.ToString() == "BAS")
        {
            topMargin = 24;
        }
        else
        {
            topMargin = 44;
        } *@
        <div style="height: @(topMargin)px;">.</div>
        <div style="padding-left:40px; padding-right: 25px;">
            <table style="font-size:16px;">
                <tbody>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 125px;"></td>
                        <td></td>
                        <td style="width: 75px;"></td>
                        <td style="width: 100px;"></td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 125px;"></td>
                        <td></td>
                        <td colspan="2">@Model.InvoiceDateD.ToString("MMMM dd, yyyy")</td>
                    </tr>
                    <tr>
                        <td colspan="4"></td>
                        <td style="width: 100px;padding-top: 8px;">@Model.PaymentTerms</td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 125px;"></td>
                        <td colspan="2" style="padding: 3px;">@Model.CustomerName</td>
                        <td style="width: 100px; padding-top: 4px;">@Model.Agent</td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td colspan="3" style="padding: 3px;">@(Model.TIN == "0" || string.IsNullOrWhiteSpace(Model.TIN) ? "N/A" : Model.TIN)</td>
                        <td style="width: 100px; padding-top: 4px;">@Model.SONumber</td>
                    </tr>
                    <tr>
                        <td style="width: 50px;"></td>
                        <td style="width: 125px;"></td>
                        <td colspan="3" style="padding-top: 4px;">@(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "N/A" : Model.CustomerAddress)</td>
                    </tr>
                </tbody>
            </table>
            <div style="height: 380px;">
                <table style="margin-top: 50px;">
                    <tbody>
                        <tr>
                            <td style="width: 90px;"></td>
                            <td></td>
                            <td style="width: 75px;"></td>
                            <td style="width: 90px;"></td>
                            <td style="width: 115px;"></td>
                        </tr>
                        @{
                            int rowctr = 0, otherQuantity = 0;
                            decimal otherGrossPrice = 0;
                            @foreach (var item in Model.Items)
                            {
                                rowctr++;
                                if (rowctr < 17 || Model.Items.Count == 17)
                                {
                                    <tr>
                                        <td class="auto-font-size" style="width: 90px; padding-right: 5px;">@item.PartNumber</td>
                                        <td class="auto-font-size" style="padding-right: 10px;">@item.ItemName</td>
                                        <td style="width: 75px;">@item.Quantity @item.Unit</td>
                                        <td style="width: 90px;" class="currency">@item.NetPrice</td>
                                        <td style="width: 115px;" class="currency">@item.GrossPriceNoDiscount</td>
                                    </tr>
                                }
                                else
                                {
                                    otherQuantity += item.QuantityD;
                                    otherGrossPrice += item.GrossPriceNoDiscountD;
                                }
                            }

                            @if (otherQuantity > 0)
                            {
                                <tr>
                                    <td style="width: 90px;"></td>
                                    <td>+@(Model.Items.Count - 16) more item(s)</td>
                                    <td style="width: 75px;">@otherQuantity</td>
                                    <td style="width: 90px;"></td>
                                    <td style="width: 115px;" class="currency">@string.Format("{0:#,##0.00}", otherGrossPrice)</td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td style="width: 90px;"></td>
                                    <td>*** NOTHING FOLLOWS ***</td>
                                    <td style="width: 75px;"></td>
                                    <td style="width: 90px;"></td>
                                    <td style="width: 115px;"></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <table>
                <tbody>
                    <tr>
                        <td colspan="5" class="currency">Total:</td>
                        <td style="width: 115px;" class="currency">@Model.Total</td>
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency">LESS @Model.DiscountPercent:</td>
                        <td style="width: 115px;" class="currency">@Model.DiscountAmount</td>
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.DiscountedTotal</td> <!-- Total Sales(VAT Inclusive) -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.VATExclusive</td> <!--Less: VAT -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency"></td> <!-- Amount: Net of VAT -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency"></td> <!-- Less: Discount -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency"></td> <!-- SC/PWD/... -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency"></td> <!-- Less Withholding Tax -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.VATAmount</td> <!-- Add: VAT -->
                        <td style="width: 10px;"></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="currency"></td>
                        <td style="width: 115px;" class="currency">@Model.DiscountedTotal</td> <!-- TOTAL AMOUNT DUE -->
                        <td style="width: 10px;"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- DELIVERY RECEIPT -->
        <span style="font-size: 20px;">@Model.SONumber</span>
        <table class="for-dr" style="margin-top: 15px;">
            <tbody>
                <tr>
                    <td style="width: 100px;"></td> <!-- INDENT -->
                    <td class="auto-font-size">@Model.CustomerName</td>
                    <td style="width: 40px;"></td> <!-- INDENT -->
                    <td style="width: 180px;">@Model.InvoiceDateD.ToString("MM/dd/yy")</td>
                </tr>
                <tr>
                    <td style="width: 100px;"></td> <!-- INDENT -->
                    <td class="auto-font-size">@(string.IsNullOrEmpty(Model.CustomerAddress) ? "N/A" : Model.CustomerAddress)</td>
                    <td style="width: 40px;"></td> <!-- INDENT -->
                    <td style="width: 180px;">@(string.IsNullOrWhiteSpace(Model.PaymentTerms) ? "N/A" : Model.PaymentTerms)</td>
                </tr>
                <tr>
                    <td style="width: 100px;"></td> <!-- INDENT -->
                    <td></td>
                    <td style="width: 40px;"></td> <!-- INDENT -->
                    <td style="width: 180px;" class="auto-font-size">@Model.Agent</td>
                </tr>
            </tbody>
        </table>
        @*<table style="margin-top: 26px;">*@
        <div style="min-height:315px;margin-top: 10px;">
            <table class="for-dr">
                <tbody>
                    <tr>
                        <td style="width: 40px !important;"></td>
                        <td style="width: 40px !important;"></td>
                        <td style="width: 150px !important;"></td>
                        <td style="width: 75px"></td>
                        <td></td>
                        <td style="width: 75px !important;" class="currency"></td>
                        <td style="width: 75px !important;" class="currency"></td>
                    </tr>
                    @{
                        int rowctr = 0, otherQuantity = 0;
                        decimal otherGrossPrice = 0;
                        @foreach (var item in Model.Items)
                        {
                            rowctr++;
                            if (rowctr < 12 || Model.Items.Count == 12)
                            {
                                <tr>
                                    <td style="width: 40px;">@item.Quantity</td>
                                    <td style="width: 40px;">@item.Unit</td>
                                    <td class="auto-font-size" style="width: 150px;">@item.PartNumber</td>
                                    <td class="auto-font-size" colspan="2">@item.ItemName</td>
                                    <td style="width: 75px;" class="currency">@item.NetPrice</td>
                                    <td style="width: 75px;" class="currency">@item.GrossPriceNoDiscount</td>
                                </tr>
                            }
                            else
                            {
                                otherQuantity += item.QuantityD;
                                otherGrossPrice += item.GrossPriceNoDiscountD;
                            }
                        }

                        @if (otherQuantity > 0)
                        {
                            <tr>
                                <td style="width: 75px;">@otherQuantity</td>
                                <td colspan="4">+@(Model.Items.Count - 11) more item(s)</td>
                                <td style="width: 75px;" class="currency">@string.Format("{0:#,##0.00}", otherGrossPrice)</td>
                            </tr>
                        }
                        @* else
                    {
                        for (int rem = 0; rem <= 11 - Model.Items.Count; rem++)
                        {
                            <tr>
                                <td style="width: 75px;"></td>
                                <td style="width: 50px;"></td>
                                <td style="width: 75px;"></td>
                                <td></td>
                                <td style="width: 80px;" class="currency"></td>
                                <td style="width: 125px;" class="currency"></td>
                            </tr>
                        }
                    } *@
                    }
                </tbody>
            </table>
        </div>
        <table class="for-dr">
            <tbody>
                <tr>
                    <td style="width: 120px;" class="currency">Subtotal:</td>
                    <td style="width: 125px;" class="currency">@Model.VATExclusive</td>
                    <td>&nbsp;</td>
                    <td style="width: 120px;" class="currency">Total:</td>
                    <td style="width: 125px;" class="currency">@Model.Total</td>
                </tr>
                <tr>
                    <td style="width: 120px;" class="currency">12% VAT:</td>
                    <td style="width: 125px;" class="currency">@Model.VATAmount</td>
                    <td>&nbsp;</td>
                    <td style="width: 120px;" class="currency">LESS @Model.DiscountPercent:</td>
                    <td style="width: 125px;" class="currency">@Model.DiscountAmount</td>
                </tr>
                <tr>
                    <td style="width: 120px;" class="currency">Total Amount:</td>
                    <td style="width: 125px;" class="currency">@Model.DiscountedTotal</td>
                    <td>&nbsp;</td>
                    <td style="width: 120px;" class="currency"></td>
                    <td style="width: 125px;" class="currency">@Model.DiscountedTotal</td>
                </tr>
            </tbody>
        </table>
    }
</body>
<script type="text/javascript">
@*     document.addEventListener('DOMContentLoaded', () => {
        const DEFAULT_HEIGHT = 26;

        document.querySelectorAll('.auto-font-size').forEach(el => {
            let size = parseInt(getComputedStyle(el).fontSize, 10);

            let measureTarget = el;
