                //measureTarget.style.display = 'inline-block';
                measureTarget.style.overflowWrap = 'break-word';
                measureTarget.style.paddingRight = '10px';
                el.innerHTML = '';
                el.appendChild(measureTarget);
            }

            while (measureTarget.offsetHeight > DEFAULT_HEIGHT && size > 9) {
