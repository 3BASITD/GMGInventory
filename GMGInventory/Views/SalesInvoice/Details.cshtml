@model InvoiceDetailsVM

@{
    ViewData["Title"] = "Sales Invoice Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesInvoice" asp-action="Index">Sales Invoice</a></li>
}

<div class="card card-default">
    <form id="form-invoice">
        <div class="card-header">
            <span class="card-title po-title">@ViewData["Title"]</span>
            <div class="card-tools">
                @if (Model!.Status != "Cancelled")
                {
                    <button type="submit" class="btn btn-danger btn-sm float-right ml-2" value="delete">
                        <span class="fas fa-trash"></span> Cancel
                    </button>
                    @if (Model!.CurrentUsersDraft == true)
                    {
                        @if (userAccess.CanAdd)
                        {
                            <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" value="save">
                                <span class="fas fa-save"></span> Save as Draft
                            </button>
                            <button type="submit" class="btn btn-primary btn-sm float-right ml-2" value="post">
                                <span class="fas fa-paper-plane"></span> Post
                            </button>
                        }
                    }
                    else
                    {
                        @if (userAccess.CanEdit)
                        {
                            <button type="submit" class="btn btn-primary btn-sm float-right ml-2" value="update">
                                <span class="fas fa-save"></span> Update
                            </button>
                        }
                    }
                    @if (userAccess.CanPrint)
                    {
                        <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                            <span class="fas fa-print"></span> Print
                        </button>
                    }
                }
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            @*old layout sequence at the buttom*@
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceNumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.InvoiceNumber
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PackNumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.PackNumber
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @*@if (Model?.Status == "Draft")
                        {*@
                        @if (Model!.Status != "Cancelled") 
                        {
                            <label for="invoice-date" class="form-label fw-normal mb-0">@Html.DisplayNameFor(model => model.InvoiceDate1)</label>
                            <input type="date" id="invoice-date" class="form-control form-control-sm" value="@(Model?.InvoiceDate3)" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.InvoiceDate1)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.InvoiceDate1
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @*@if (Model?.Status == "Draft")
                        {*@
                        @if (Model!.Status != "Cancelled")
                        {
                            <label for="invoice-control-number" class="form-label fw-normal mb-0">BIR Invoice Number</label>
                            <input type="text" id="invoice-control-number" name="ControlNumber" class="form-control form-control-sm" value="@Model?.ControlNumber" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.ControlNumber)
                            </span>
                            <b class="d-block">
                                @Model?.ControlNumber
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @*@if (Model?.Status == "Draft")
                        {*@
                        @if (Model!.Status != "Cancelled") 
                        {
                            <label for="invoice-invoice-type" class="form-label fw-normal mb-0">@Html.DisplayNameFor(model => model.InvoiceType)</label>
                            <select id="invoice-invoice-type" class="form-control form-control-sm s2-bold s2ph-bold s2ph-dark"></select>
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.InvoiceType)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.InvoiceType
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @*@if (Model?.Status == "Draft")
                        {*@
                        @if (Model!.Status != "Cancelled")
                        {
                            <label for="invoice-remarks" class="form-label fw-normal mb-0">@Html.DisplayNameFor(model => model.Remarks)</label>
                            <input type="text" id="invoice-remarks" class="form-control form-control-sm" value="@(Model?.Remarks == "-" ? "" : Model?.Remarks)" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.Remarks)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.Remarks
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerCode)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.CustomerCode
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerName)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.CustomerName
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerAddress)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.CustomerAddress
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.SONumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.SONumber
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PONumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.PONumber
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PaymentTerms)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.PaymentTerms
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @*@if (Model?.Status == "Draft")
                        {*@
                        @if (Model!.Status != "Cancelled")
                        {
                            <label for="invoice-agent" class="form-label fw-normal mb-0">@Html.DisplayNameFor(model => model.Agent)</label>
                            <select id="invoice-agent" class="form-control form-control-sm s2-bold s2ph-bold s2ph-dark"></select>
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.Agent)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.Agent
                            </b>
                        }
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceBy)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.InvoiceBy
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateCreated)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.DateCreated
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Status)
                        </span>
                        <b class="d-block form-gayahin invoice-status">
                            @Model?.Status
                        </b>
                        <input type="hidden" id="invoice-status" value="@Model?.Status" />
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Invoice Item(s)</span>
                            @if (Model!.Status == "Draft")
                            {
                                @if (userAccess.CanAdd)
                                {
                                    <div class="card-tools">
                                        <button type="button" class="btn btn-primary btn-sm float-right btn-create ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                            <span class="fas fa-plus"></span> Add Invoice Item
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Quantity</th>
                                        <th>Gross Price</th>
                                        <th>Discount 1</th>
                                        <th>Discount 2</th>
                                        <th>Extended Price</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th colspan="3"></th>
                                        <th class="total-extended">0.00</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@if (userAccess.CanAdd)
{
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Invoice Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <table class="table table-head-fixed table-striped table-hover table-pack">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Selling Price</th>
                                    <th>Packed Quantity</th>
                                    <th>Gross Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Extended Price</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Close
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load agent data for select2
        $("#invoice-agent").select2({
            //minimumInputLength: 1,
            placeholder: '@Model.Agent',
            templateSelection: function (item) {
                if (item.name) {
                    return item.name;
                }
                return item.text;
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Agent")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });

        // Load invoice type data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetInvoiceTypeOptions")",
            success: function (data, status, xhr) {
                $("#invoice-invoice-type").select2({
                    data: data,
                    minimumResultsForSearch: -1
                });
            },
            complete: function (xhr, status) {
                $("#invoice-invoice-type").val(@Model?.InvoiceTypeId);
                $("#invoice-invoice-type").data("current-invoice-type", @Model?.InvoiceTypeId);
                $("#invoice-invoice-type").trigger("change");
            }
        });
        $("#invoice-control-number").data("current-control-number", "@Model?.ControlNumber");
        $("#invoice-remarks").data("current-remarks", "@(Model?.Remarks == "-" ? "" : Model?.Remarks)");


        var packDT = $('.table-pack').DataTable({
            ajax: {
                url: "@Url.Action("GetItemsWithPriceJson", "Pack")",
                data: { packId: @Model?.PackNumber },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (user_access.canAdd) {
                            actions += '<button type="button" class="btn btn-success btn-xs btn-add-item" data-microtip-title="Add Item" data-microtip-position="top-left" role="tooltip"><i class="fas fa-plus"></i></button>';
                        }
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "sellingPrice", name: "SellingPrice", className: "text-end" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "extendedPrice", name: "ExtendedPrice", className: "text-end" }
            ],
            order: [[1, "asc"]]
        });

        packDT.on("draw", function () {
            $(".table-item thead th").removeClass("text-end");

            $(".btn-add-item").off("click").on("click", function () {
                var rowdata = packDT.row($(this).parents('tr')).data();
                if (itemDT.rows().data().length == 0 && packDT.rows().data().length > 1) {
                    toastr.info("You added an item with " + rowdata.sellingPriceType + " Selling Price, " + rowdata.discount1 + "% Discount 1, and " + rowdata.discount2 + "% Discount 2. You can add more with the same information only. To change required information, you need to clear the list.", "Info");
                }
                var forInvoice = {
                    id: rowdata.id,
                    itemId: rowdata.itemId,
                    itemCode: rowdata.itemCode,
                    itemName: rowdata.itemName,
                    quantity: rowdata.quantity,
                    quantityOfPack: rowdata.quantity,
                    unit: "",
                    netPrice: rowdata.grossPrice,
                    netPriceD: rowdata.grossPriceD,
                    sellingPriceType: rowdata.sellingPriceType,
                    discount1: rowdata.discount1,
                    discount1D: rowdata.discount1D,
                    discount2: rowdata.discount2,
                    discount2D: rowdata.discount2D,
                    grossPrice: rowdata.extendedPrice,
                    grossPriceD: rowdata.extendedPriceD,
                    grossPriceNoDiscount: "0",
                    grossPriceNoDiscountD: 0
                };
                if (itemDT.rows().data().length != 0) {
                    var firstItem = itemDT.row(0).data();
                    if (firstItem.sellingPriceType != forInvoice.sellingPriceType || firstItem.discount1 != forInvoice.discount1 || firstItem.discount2 != forInvoice.discount2) {
                        toastr.error("You can only add an item with the same data of the first added item. " + firstItem.sellingPriceType + " Selling Price, " + firstItem.discount1 + "% Discount 1, and " + firstItem.discount2 + "% Discount 2", "Error");
                    } else {
                        itemDT.row.add(forInvoice).draw();
                        packDT.row($(this).parents('tr')).remove().draw();
                        toastr.success("Added " + forInvoice.itemCode + " on Invoice Item(s)", "Success");
                    }
                } else {
                    itemDT.row.add(forInvoice).draw();
                    packDT.row($(this).parents('tr')).remove().draw();
                    toastr.success("Added " + forInvoice.itemCode + " on Invoice Item(s)", "Success");
                }
            });
        });

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { invoiceId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (user_access.canEdit) {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top-right" role="tooltip"><i class="fas fa-minus"></i></button>';
                        }
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemName", name: "ItemName", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#invoice-status").val() == "Draft")
                        {
                            return '<input type="number" min="1" max="' + data.quantityOfPack + '" value="' + data.quantity + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                        } else {
                            return '<input type="hidden" value="' + data.quantity + '" class="quantity" />' + data.quantity
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "netPrice", name: "NetPrice", className: "form-cell text-end" },
                { data: "discount1", name: "Discount1", className: "form-cell text-end" },
                { data: "discount2", name: "Discount2", className: "form-cell text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "form-cell text-end extendedprice" }
            ],
            order: [[1, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 3);
                columnDTTotalDecimal(api, 7);
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            itemDT.column(0).visible($("#invoice-status").val() == "Draft");

            $(".table-item th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".btn-remove-item").on("click", function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                var forPack = {
                    id: rowdata.id,
                    boxNumber: 0,
                    itemId: rowdata.itemId,
                    itemCode: rowdata.itemCode,
                    itemName: rowdata.itemName,
                    quantity: rowdata.quantityOfPack,
                    sellingPrice: rowdata.netPrice,
                    sellingPriceD: rowdata.netPriceD,
                    sellingPriceType: rowdata.sellingPriceType,
                    grossPrice: rowdata.netPrice,
                    grossPriceD: rowdata.netPriceD,
                    discount1: rowdata.discount1,
                    discount1D: rowdata.discount1D,
                    discount2: rowdata.discount2,
                    discount2D: rowdata.discount2D,
                    extendedPrice: rowdata.grossPrice,
                    extendedPriceD: rowdata.grossPriceD
                }
                packDT.row.add(forPack).draw();
                itemDT.row($(this).parents('tr')).remove().draw();
                toastr.warning("Removed " + forPack.itemCode + " on Invoice Item", "Warning");
                ComputeTotalQuantity();
                ComputeTotalExtendedPrice();
            });

            $(".quantity").on("input", function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                var quantity = parseInt($(this).parents("tr").find(".quantity").val());
                var selling_price = rowdata.netPriceD;
                var discount1 = rowdata.discount1D;
                var discount2 = rowdata.discount2D;
                var extended_price = FormatStringDecimal(Round2Decimal(quantity * (((100 - discount1 - discount2) * selling_price) / 100)));
                $(this).parents("tr").find(".extendedprice").html(extended_price);
                ComputeTotalQuantity();
                ComputeTotalExtendedPrice();
            });
        });

        function ComputeTotalQuantity() {
            total_quantity = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        function ComputeTotalExtendedPrice() {
            total_extended_price = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_extended_price += parseFloat($(this.node()).find(".extendedprice").html().replace(",", ""));
            });
            $(".total-extended").html(FormatStringDecimal(total_extended_price));
        }

        $(".btn-create").on("click", function () {
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                packDT.rows(function (idx, data, node) {
                    return data.itemId == row_data.itemId;
                }).remove().draw();
            });
        });

        $("#form-invoice button[type='submit']").on("click", function () {
            $("#invoice-status").data("saving-as", $(this).val());
        });

        // Validation for Save
        var validateCreate = $("#form-invoice").validate({
            rules: {
                ControlNumber: { required: true, maxlength: 50 },
                AgentCode: { maxlength: 250 }
            },
            messages: {
                ControlNumber: { required: "Please enter BIR Invoice Number", maxlength: "BIR Invoice Number must not exceed 50 characters." },
                Remarks: { maxlength: "BIR Invoice Number must not exceed 250 characters." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                if ($("#invoice-status").data("saving-as") == "delete") {
                    swal({
                        title: "Cancel Invoice",
                        text: "Are you sure you want to cancel this record?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            SaveInvoice(true);
                        }
                    });
                } else {
                    SaveInvoice(true);
                }
            }
        });

        function GetItemsToInvoice() {
            var item_to_invoice = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                item_to_invoice.push({
                    item: row_data.itemId,
                    quantity: row_quantity
                });
            });
            return item_to_invoice;
        }

        function SaveInvoice(showmessage) {
            var itemsToInvoice = GetItemsToInvoice();
            if (itemsToInvoice.length == 0) {
                toastr.warning("No item to invoice. Add an item to the list to continue", "Warning");
            } else if (itemsToInvoice.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't invoice an item with 0 quantity", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateJson")",
                    data: {
                        Id: @Model?.Id,
                        BIRInvoiceNumber: $("#invoice-control-number").val(),
                        InvoiceType: $("#invoice-invoice-type").val(),
                        InvoiceDate: $("#invoice-date").val(),
                        Agent: $("#invoice-agent").val(),
                        Remarks: $("#invoice-remarks").val(),
                        SavingAs: $("#invoice-status").data("saving-as"),
                        Items: itemsToInvoice
                    },
                    success: function (data, status, xhr) {
                        if (showmessage) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                if (data.newRow == -2) {
                                    window.location.reload();
                                } else if (data.newRow == -3) {
                                    window.location = "@Url.Action("Index")";
                                }
                            }
                        }
                    }
                });
            }
        }
        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                var invoice_type_changed = $("#invoice-invoice-type").val() != $("#invoice-invoice-type").data("current-invoice-type");
                var control_number_changed = $("#invoice-control-number").val() != $("#invoice-control-number").data("current-control-number");
                var remarks_changed = $("#invoice-remarks").val() != $("#invoice-remarks").data("current-remarks");

                if (invoice_type_changed || control_number_changed || remarks_changed) {
                    if (invoice_type_changed) { $("#invoice-invoice-type").data("current-invoice-type", $("#invoice-invoice-type").val()); }
                    if (control_number_changed) { $("#invoice-control-number").data("current-control-number", $("#invoice-control-number").val()); }
                    if (remarks_changed) { $("#invoice-remarks").data("current-remarks", $("#invoice-remarks").val()); }

                    //SaveInvoice(control_number_changed || remarks_changed);

                    toastr.warning("Changes neeed saving when printing", "Warning");
                } else {
                    $.LoadingOverlay("show", {
                        image: "",
                        fontawesome: "fas fa-print"
                    });
                    setTimeout(function () {
                        let win = window.open('@Url.Action("PrintReceipt")/' + @Model?.Id, '');
                        var wintimer = setInterval(function () {
                            if (win.closed) {
                                clearInterval(wintimer);
                                hideLoader();
                            }
                        }, 100);
                    }, 500);
                }
            });
        }
    </script>
}
