@model InvoiceDetailsVM

@{
    ViewData["Title"] = "Sales Invoice Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesInvoice" asp-action="Index">Sales Invoice</a></li>
}

<div class="card card-default">
    <form id="form-invoice">
        <div class="card-header">
            <span class="card-title po-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                    <span class="fas fa-print"></span> Print
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2">
                    <span class="fas fa-save"></span> Save
                </button>
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceNumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.InvoiceNumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerCode)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.CustomerCode
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerName)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.CustomerName
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerAddress)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.CustomerAddress
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Agent)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.Agent
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        @*<span class="text-muted">
                        @Html.DisplayNameFor(model => model.ControlNumber)
                        </span>
                        <b class="d-block">
                        @Model?.ControlNumber
                        </b>*@
                        <label for="invoice-control-number" class="form-label fw-normal mb-0">BIR Invoice Number</label>
                        <input type="text" id="invoice-control-number" name="ControlNumber" class="form-control form-control-sm" value="@Model?.ControlNumber" />
                        <span data-valmsg-for="invoice-control-number" data-valmsg-replace="true" class="text-danger"></span>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PaymentTerms)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.PaymentTerms
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.SONumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.SONumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PONumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.PONumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PackNumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.PackNumber
                        </b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Status)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.Status
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceDate)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.InvoiceDate
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceBy)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.InvoiceBy
                        </b>
                    </p>
                    <p class="text-sm">
                        @*<span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                        </span>
                        <b class="d-block form-gayahin">
                        @Model?.Remarks
                        </b>*@
                        <label for="invoice-remarks" class="form-label fw-normal mb-0">Remarks</label>
                        <input type="text" id="invoice-remarks" class="form-control form-control-sm" value="@(Model?.Remarks == "-" ? "" : Model?.Remarks)" />
                        <span data-valmsg-for="invoice-remarks" data-valmsg-replace="true" class="text-danger"></span>
                    </p>
                    <p class="text-sm">
                        @* <span class="text-muted">
                        @Html.DisplayNameFor(model => model.InvoiceType)
                        </span>
                        <b class="d-block form-gayahin">
                        @Model?.InvoiceType
                        </b>*@
                        <label for="invoice-invoice-type" class="form-label fw-normal mb-0">Invoice Type</label>
                        <select id="invoice-invoice-type" class="form-control form-control-sm s2-bold s2ph-bold s2ph-dark"></select>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Pack Item(s)</span>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Quantity</th>
                                        <th>Gross Price</th>
                                        <th>Discount 1</th>
                                        <th>Discount 2</th>
                                        <th>Extended Price</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th>Total</th>
                                        <th>0</th>
                                        <th colspan="3"></th>
                                        <th>0.00</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Load invoice type data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetInvoiceTypeOptions")",
            success: function (data, status, xhr) {
                $("#invoice-invoice-type").select2({
                    data: data,
                    minimumResultsForSearch: -1
                });
            },
            complete: function (xhr, status) {
                $("#invoice-invoice-type").val(@Model?.InvoiceTypeId);
                $("#invoice-invoice-type").data("current-invoice-type", @Model?.InvoiceTypeId);
                $("#invoice-invoice-type").trigger("change");
            }
        });
        $("#invoice-control-number").data("current-control-number", "@Model?.ControlNumber");
        $("#invoice-remarks").data("current-remarks", "@(Model?.Remarks == "-" ? "" : Model?.Remarks)");

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { invoiceId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" }
            ],
            order: [[0, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                var numVal = function (i) {
                    switch (typeof i) {
                        case 'string': return elemVal(i);
                        case 'number': return i;
                        default: return 0;
                    }
                };
                var elemVal = function (i) {
                    if (i.includes("input"))
                        return $(i).val() * 1;
                    else
                        return i.replace(/[\$,]/g, '') * 1;
                }
                var totalQuantity = api.column(2).data().reduce(function (a, b) { return numVal(a) + numVal(b); }, 0);
                var totalGrossPrice = api.column(6).data().reduce(function (a, b) { return numVal(a) + numVal(b); }, 0);

                $(api.column(2).footer()).html(FormatStringInteger(totalQuantity));
                $(api.column(6).footer()).html(FormatStringDecimal(totalGrossPrice));
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("text-end");
        });

        // Validation for Save
        var validateCreate = $("#form-invoice").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                ControlNumber: { required: true, maxlength: 50 },
                AgentCode: { maxlength: 250 }
            },
            messages: {
                ControlNumber: { required: "Please enter BIR Invoice Number", maxlength: "BIR Invoice Number must not exceed 50 characters." },
                Remarks: { maxlength: "BIR Invoice Number must not exceed 250 characters." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveInvoice(true);
            },
            showErrors: validateShowErrors
        });

        function SaveInvoice(showmessage) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("UpdateJson")",
                data: {
                    Id: @Model?.Id,
                    BIRInvoiceNumber: $("#invoice-control-number").val(),
                    InvoiceType: $("#invoice-invoice-type").val(),
                    Remarks: $("#invoice-remarks").val()
                },
                error: jQueryCommonError,
                success: function (data, status, xhr) {
                    if (showmessage) {
                        if (data.status == "Error") {
                            toastrNoDuplicate(data.message, "Error", "error");
                        } else {
                            toastrNoDuplicate(data.message, "Success", "success");
                        }
                    }
                }
            });
        }

        $(".btn-details-print").on("click", function () {
            var invoice_type_changed = $("#invoice-invoice-type").val() != $("#invoice-invoice-type").data("current-invoice-type");
            var control_number_changed = $("#invoice-control-number").val() != $("#invoice-control-number").data("current-control-number");
            var remarks_changed = $("#invoice-remarks").val() != $("#invoice-remarks").data("current-remarks");

            if (invoice_type_changed || control_number_changed || remarks_changed) {
                if (invoice_type_changed) { $("#invoice-invoice-type").data("current-invoice-type", $("#invoice-invoice-type").val()); }
                if (control_number_changed) { $("#invoice-control-number").data("current-control-number", $("#invoice-control-number").val()); }
                if (remarks_changed) { $("#invoice-remarks").data("current-remarks", $("#invoice-remarks").val()); }

                SaveInvoice(control_number_changed || remarks_changed);
            }

            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintReceipt")/' + @Model?.Id, '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });

