@model InvoiceDetailsVM

@{
    ViewData["Title"] = "Sales Invoice Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesInvoice" asp-action="Index">Sales Invoice</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title po-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                    <span class="fas fa-print"></span> Print
                </button>
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceNumber)
                        </span>
                        <b class="d-block">
                            @Model?.InvoiceNumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerCode)
                        </span>
                        <b class="d-block">
                            @Model?.CustomerCode
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerName)
                        </span>
                        <b class="d-block">
                            @Model?.CustomerName
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerAddress)
                        </span>
                        <b class="d-block">
                            @Model?.CustomerAddress
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Agent)
                        </span>
                        <b class="d-block">
                            @Model?.Agent
                        </b>
                    </p>
                </div>
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ControlNumber)
                        </span>
                        <b class="d-block">
                            @Model?.ControlNumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PaymentTerms)
                        </span>
                        <b class="d-block">
                            @Model?.PaymentTerms
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.SONumber)
                        </span>
                        <b class="d-block">
                            @Model?.SONumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PONumber)
                        </span>
                        <b class="d-block">
                            @Model?.PONumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PackNumber)
                        </span>
                        <b class="d-block">
                            @Model?.PackNumber
                        </b>
                    </p>
                </div>
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Status)
                        </span>
                        <b class="d-block">
                            @Model?.Status
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceDate)
                        </span>
                        <b class="d-block">
                            @Model?.InvoiceDate
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceBy)
                        </span>
                        <b class="d-block">
                            @Model?.InvoiceBy
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Remarks)
                        </span>
                        <b class="d-block">
                            @Model?.Remarks
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.InvoiceType)
                        </span>
                        <b class="d-block">
                            @Model?.InvoiceType
                        </b>
                    </p>
                </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Pack Item(s)</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Quantity</th>
                                    <th>Net Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Gross Price</th>
                                </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th>Total</th>
                                        <th>0</th>
                                        <th colspan="3"></th>
                                        <th>0.00</th>
                                    </tr>
                                </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { invoiceId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" }
            ],
            order: [[0, "asc"]],
                    footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                var numVal = function (i) {
                    switch (typeof i) {
                        case 'string': return elemVal(i);
                        case 'number': return i;
                        default: return 0;
                    }
                };
                var elemVal = function (i) {
                    if (i.includes("input"))
                        return $(i).val() * 1;
                    else
                        return i.replace(/[\$,]/g, '') * 1;
                }
                var totalQuantity = api.column(2).data().reduce(function (a, b) { return numVal(a) + numVal(b); }, 0);
                var totalGrossPrice = api.column(6).data().reduce(function (a, b) { return numVal(a) + numVal(b); }, 0);
                
                $(api.column(2).footer()).html(FormatStringInteger(totalQuantity));
                $(api.column(6).footer()).html(FormatStringDecimal(totalGrossPrice));
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("text-end");
        });

        $(".btn-details-print").on("click", function () {
            var html = '<h3>Sales Invoice Details</h3>';
            html += '<table class="table-header w100">';
            html += '<tr>';

            html += '<th>@Html.DisplayNameFor(model => model.InvoiceNumber)</th><td>@Model?.InvoiceNumber</td>';
            html += '<th>@Html.DisplayNameFor(model => model.ControlNumber)</th><td>@Model?.ControlNumber</td>';
            html += '<th>@Html.DisplayNameFor(model => model.Status)</th><td>@Model?.Status</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.CustomerCode)</th><td>@Model?.CustomerCode</td>';
            html += '<th>@Html.DisplayNameFor(model => model.PaymentTerms)</th><td>@Model?.PaymentTerms</td>';
            html += '<th>@Html.DisplayNameFor(model => model.InvoiceDate)</th><td>@Model?.InvoiceDate</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.CustomerName)</th><td>@Model?.CustomerName</td>';
            html += '<th>@Html.DisplayNameFor(model => model.SONumber)</th><td>@Model?.SONumber</td>';
            html += '<th>@Html.DisplayNameFor(model => model.InvoiceBy)</th><td>@Model?.InvoiceBy</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.CustomerAddress)</th><td>@Model?.CustomerAddress</td > ';
            html += '<th>@Html.DisplayNameFor(model => model.PONumber)</th><td>@Model?.PONumber</td > ';
            html += '<th>@Html.DisplayNameFor(model => model.Remarks)</th><td>@Model?.Remarks</td > ';
                html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.Agent)</th><td>@Model?.Agent</td > ';
            html += '<th>@Html.DisplayNameFor(model => model.PackNumber)</th><td>@Model?.PackNumber</td > ';
            html += '<th>@Html.DisplayNameFor(model => model.InvoiceType)</th><td>@Model?.InvoiceType</td > ';
                html += '</tr>';
            html += '</table>';

            html += '<table class="table-items">';
            html += '<tr>';
            html += '<thead>';
            html += '<th>Item Code</th>';
            html += '<th>Item Name</th>';
            html += '<th>Quantity</th>';
            html += '<th>Net Price</th>';
            html += '<th>Discount 1</th>';
            html += '<th>Discount 2</th>';
            html += '<th>Gross Price</th>';
            html += '</thead>';
            html += '</tr>';
            var totalQuantity = 0, totalGrossPrice = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                html += '<tr>';
                html += '<td>' + row_data.itemCode + '</td>';
                html += '<td>' + row_data.itemName + '</td>';
                html += '<td class="right-text">' + row_data.quantity + '</td>';
                html += '<td class="right-text">' + row_data.netPrice + '</td>';
                html += '<td class="right-text">' + row_data.discount1 + '</td>';
                html += '<td class="right-text">' + row_data.discount2 + '</td>';
                html += '<td class="right-text">' + row_data.grossPrice + '</td>';
                html += '</tr>';
                
                totalQuantity += parseInt(row_data.quantity);
                totalGrossPrice += parseFloat(row_data.grossPriceD);
            });
            html += '<tr>';
            html += '<tfoot>';
            html += '<th colspan="2" class="right-text">Total</th>';
            html += '<th class="right-text">' + FormatStringInteger(totalQuantity) + '</th>';
            html += '<th colspan="3"></th>';
            html += '<th class="right-text">' + FormatStringDecimal(totalGrossPrice) + '</th>';
            html += '</tfoot>';
            html += '</tr>';
            html += '</table>';
            $("#for-print").html(html);
            $("#for-print").printThis({
                importCSS: false,
                loadCSS: "/css/print.css",
                pageTitle: "GMG Inventory",
                beforePrint: function () {
                    $.LoadingOverlay("show", {
                        image: "",
                        fontawesome: "fas fa-print"
                    });
                },
                afterPrint: function () {
                    hideLoader();
                }
            });
        });
    </script>
}