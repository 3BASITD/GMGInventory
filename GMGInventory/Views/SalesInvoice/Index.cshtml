@model IEnumerable<InvoiceVM>

@{
    ViewData["Title"] = "Sales Invoice";
    var hashMicroUserAccess = (ViewsAccessVM)ViewData["HashMicroUserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (hashMicroUserAccess.CanUploadDownload)
            {
                <button class="btn btn-dark text-light btn-sm float-right ml-2" onclick="MoveAllMarkedToHashMicro()">
                    <span class="fas fa-upload"></span> Move All Marked to HashMicro
                </button>
                <button class="btn btn-light text-dark btn-sm float-right ml-2" onclick="MoveAllToHashMicro()">
                    <span class="fas fa-upload"></span> Move All to HashMicro
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Move All to HashMicro&#10;Upload Hash Micro access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-upload mr-0"></span>
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right ml-2 btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-invoice">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.BIRInvoiceNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PackNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Priority)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="control-label mb-0">Status</label>
                            <select id="filter-status" class="form-control form-control-sm">
                                <option value="">All</option>
                                <option value="Draft">My Drafts</option>
                                <option value="Posted">Posted</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Invoice Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Invoice Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@if (hashMicroUserAccess.CanUploadDownload)
{
    <div class="modal fade" id="viewHMModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">HashMicro Transfer Details</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-4">Invoice Number</dt>
                        <dd class="col-sm-8 hashmicro-invoice-number"></dd>
                        <dt class="col-sm-4">Move Id</dt>
                        <dd class="col-sm-8 hashmicro-move-id"></dd>
                        <dt class="col-sm-4">Move Name</dt>
                        <dd class="col-sm-8 hashmicro-move-name"></dd>
                        <dt class="col-sm-4">Status upon Moving</dt>
                        <dd class="col-sm-8 hashmicro-move-status"></dd>
                        <dt class="col-sm-4">Moved By</dt>
                        <dd class="col-sm-8 hashmicro-move-by"></dd>
                        <dt class="col-sm-4">Date Moved</dt>
                        <dd class="col-sm-8 hashmicro-move-date"></dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="viewAllHMModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Moving All to HashMicro Details</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row hashmicro-moving-info">
                    </div>
                    <table class="table table-head-fixed table-striped table-hover table-moveall">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="markedHMModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Move Marked Invoice(s) to HashMicro</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <label class="text-md mb-3">Move <span class="marked-count"></span> marked invoice(s) to HashMicro. Are you sure you want to continue?</label>
                    <table class="table-marked" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Invoice Number</th>
                                <th>Invoice Date</th>
                                <th>Status</th>
                                <th class="text-end">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="MoveMarked()"><span class="fas fa-upload"></span> Move All Marked</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var hashmicro_user_access = @Html.Raw(Json.Serialize(hashMicroUserAccess));
        
        var moveState = {};
        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            if (Object.keys(moveState).length == 0) {
                DoApplyFilter();
            } else {
                swal({
                    title: "Selection Resets on Filter",
                    text: "Some invoice are already marked to move; applying a filter will clear the marked invoice. Are you sure you want to continue?",
                    icon: "info",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        moveState = {};
                        DoApplyFilter();
                    }
                });
            }
        }

        function DoApplyFilter() {
            $("#filterModal").modal("hide");
            invoiceDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            if (Object.keys(moveState).length == 0) {
                DoResetFilter();
            } else {
                swal({
                    title: "Selection Resets on Filter",
                    text: "Some invoice are already marked to move; applying a filter will clear the marked invoice. Are you sure you want to continue?",
                    icon: "info",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        moveState = {};
                        DoResetFilter();
                    }
                });
            }
        }

        function DoResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            invoiceDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo()),
            StatusId: ""
        };

        function checkDTChanged() {
            if(!invoiceDT) return false;
            
            return JSON.stringify(invoiceDT.order()) != JSON.stringify(defaultDTState.order) ||
                   invoiceDT.page.info().start != defaultDTState.page ||
                   invoiceDT.page.len() != defaultDTState.length ||
                   (invoiceDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo ||
                   $('#filter-status').val() != defaultDTState.StatusId;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);

            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            $('#filter-status').val(defaultDTState.StatusId);
            
            if (invoiceDT) {
                invoiceDT.state.clear();
                invoiceDT.order(defaultDTState.order);
                invoiceDT.page(defaultDTState.page);
                invoiceDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        // Load List on DataTable
        var invoiceDT = $('.table-invoice').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $("#filter-from").val();
                data.DateTo = $("#filter-to").val();
                data.StatusId = $("#filter-status").val();
            },
            stateLoadParams: function (settings, data) {
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
                $('#filter-status').val(data.StatusId);
            },
            ajax: {
                url: "@Url.Action("GetListJson")",
                data: function (data) {
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    data.StatusCode = $("#filter-status").val();
                },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "birInvoiceNumber", name: "BIRInvoiceNumber" },
                { data: "invoiceType", name: "InvoiceType" },
                { 
                    data: function (data, type, dataToSet) {
                        return "<a href='/Pack/Details/" + data.packNumber + "' class='link-info' target='_blank'>" + data.packNumber + "</a>";
                    },
                    name: "PackNumber"
                },
                { 
                    data: function (data, type, dataToSet) {
                        return "<a href='/Customer/Details/" + data.customerId + "' class='link-info' target='_blank'>" + data.customer + "</a>";
                    },
                    name: "Customer"
                },
                { data: "priority", name: "Priority" },
                {
                    data: "soNumber",
                    data: function (data, type, dataToSet) {
                        return "<a href='/SalesOrder/Details/" + data.salesOrderId + "' class='link-info' target='_blank'>" + data.soNumber + "</a>";
                    },
                    name: "SONumber"
                },
                { data: "totalAmount", name: "TotalAmount", class: "text-end" },
                { data: "status", name: "Status" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        if (hashmicro_user_access.canUploadDownload && (data.status.toLowerCase() == "draft" || data.status.toLowerCase() == "invoiced")) {
                            if(data.hashMicroMoveId) {
                                actions += '<button type="button" class="btn btn-secondary btn-xs" onclick="ViewHashMicro(this)" data-microtip-title="Already on HashMicro" data-microtip-position="left" role="tooltip"><span class="fas fa-cloud"></span></button>';
                            } else {
                                actions += '<button type="button" class="btn btn-light text-dark btn-xs" onclick="MoveToHashMicro(this)" data-microtip-title="Move to HashMicro" data-microtip-position="left" role="tooltip"><span class="fas fa-upload"></span></button>';
                                if(moveState[data.id]) {
                                    actions += '<button type="button" class="btn btn-dark text-light btn-xs" onclick="MarkToHashMicro(this)" data-microtip-title="Unmark to Move to HashMicro" data-microtip-position="left" role="tooltip"><span class="fas fa-check-square"></span></button>';
                                } else {
                                    actions += '<button type="button" class="btn btn-light text-dark btn-xs checked" onclick="MarkToHashMicro(this)" data-microtip-title="Mark to Move to HashMicro" data-microtip-position="left" role="tooltip"><span class="fas fa-square"></span></button>';
                                }
                            }
                        }
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order
        });

        // Load functions upon DataTable load
        invoiceDT.on("draw", function () {
            $(".table-invoice th").removeClass("text-end");
            checkDefaultFilter();
        });

        if (hashmicro_user_access.canUploadDownload) {
            function ViewHashMicro(invoice) {
                var row = $(invoice).parents("tr");
                var rowData = invoiceDT.row(row).data();

                $(".hashmicro-invoice-number").html(rowData.invoiceNumber || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-id").html(rowData.hashMicroMoveId || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-name").html(rowData.hashMicroMoveName || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-status").html(rowData.hashMicroMoveStatus || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-by").html(rowData.hashMicroMoveBy || '<span class="text-muted">Missing data</span>');
                $(".hashmicro-move-date").html(rowData.hashMicroMoveDate || '<span class="text-muted">Missing data</span>');

                $("#viewHMModal").modal("show");
            }

            function MoveAllToHashMicro() {
                var json = invoiceDT.ajax.json();

                swal({
                    title: "Move All to HashMicro",
                    text: "This action will transfer all invoiced records to HashMicro. The process may take some time, depending on the number of records to be moved. Are you sure you want to proceed?",
                    content: {
                        element: "div",
                        attributes: {
                            innerHTML: `
                                Total Invoiced (within Filter Date): <strong>${json.totalQuantity}</strong><br/>
                                <strong>Total Invoiced (within Filter Date, Not yet moved): ${json.totalQuantity2}</strong><br/>
                                Filter Date From <strong>${formatDateEn(new Date($("#filter-from").val()))}</strong><br/>
                                Filter Date To <strong>${formatDateEn(new Date($("#filter-to").val()))}</strong><br/>
                                `
                        }
                    },
                    icon: "warning",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("MoveAllToHashMicro", "SalesInvoice")",
                            type: "POST",
                            data: {
                                DateFrom: $("#filter-from").val(),
                                DateTo: $("#filter-to").val()
                            },
                            loaderMessage: "Please wait while this completes.<br><small class=\"text-muted\">Reloading the page will stop the process, so some records may be saved while others are not.</small>",
                            success: function (data, status, xhr) {
                                var success_ctr = 0;
                                $("table.table-moveall tbody").html("");
                                $.each(data, function (i, v) {
                                    var jsonstr = JSON.parse(v.newRow);
                                    $("table.table-moveall tbody").append(`<tr><td>Invoice Number: ${v.jsonstr.InvoiceNumber}<br />Move Name: ${v.jsonstr.HashMicroMoveName}</td><td>${v.message}</td></tr>`);
                                    success_ctr++;
                                });
                                if(success_ctr > 0) {
                                    invoiceDT.ajax.reload();
                                } else {
                                    $("table.table-moveall tbody").append(`<tr><td colspan="2" class="text-center text-muted"><em>Nothing was moved</em></td></tr>`);
                                }
                                $("#viewAllHMModal").modal("show");
                            }
                        });
                    }
                });
            }

            function MoveToHashMicro(invoice) {
                var tr = $(invoice).parents("tr");
                var row = invoiceDT.row(tr);
                var rowData = row.data();

                swal({
                    title: "Move to HashMicro",
                    //text: (rowData.status.toLowerCase() == "draft" ? "Sales invoice is currently on <strong>Draft</strong> and " : "") + "Moving to HashMicro can only be done once. Are you sure you want to continue?",
                    content: {
                        element: "div",
                        attributes: {
                            style: "color: black;",
                            innerHTML: (rowData.status.toLowerCase() == "draft" ? "Sales invoice is currently on <strong>Draft</strong> and " : "") + "Moving to HashMicro can only be done once. Are you sure you want to continue?"
                        }
                    },
                    icon: "warning",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("MoveToHashMicro", "SalesInvoice")",
                            type: "POST",
                            data: {
                                Id: rowData.id,
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    var jsonstr = JSON.parse(v.newRow);
                                    rowData.hashMicroMoveId = jsonstr.HashMicroMoveId;
                                    rowData.hashMicroMoveName = jsonstr.HashMicroMoveName;
                                    rowData.hashMicroMoveStatus = jsonstr.HashMicroMoveStatus;
                                    rowData.hashMicroMoveBy = jsonstr.HashMicroMoveBy;
                                    rowData.hashMicroMoveDate = jsonstr.HashMicroMoveDate;
                                    
                                    row.data(rowData).draw(false);
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            }

            function MarkToHashMicro(elem) {
                var tr = $(elem).closest('tr');
                var row = invoiceDT.row(tr);
                var rowData = row.data();

                var isChecked = $(elem).hasClass("checked");
                if (isChecked) {
                    moveState[rowData.id] = {
                        invoiceDate: rowData.invoiceDate,
                        invoiceNumber: rowData.invoiceNumber,
                        status: rowData.status,
                        totalAmount: rowData.totalAmount
                    };
                } else {
                    delete moveState[rowData.id];
                }
            
                row.invalidate();
            }

            function MoveAllMarkedToHashMicro() {
                if (Object.keys(moveState).length == 0) {
                    swal({
                        title: "Move Marked Invoice(s) to HashMicro",
                        text: "Please mark at least one invoice to move to HashMicro before continuing",
                        icon: "warning",
                        button: "OK"
                    });
                } else {
                    var markedHtml = "";
                    Object.keys(moveState).forEach(function (ms) {
                        var markedData = moveState[ms];
                        markedHtml += `<tr>
                                           <td>${markedData.invoiceNumber}</td>
                                           <td>${markedData.invoiceDate}</td>
                                           <td>${markedData.status}</td>
                                           <td class='text-end'>${markedData.totalAmount}</td>
                                       </tr>`;
                    });
                    $(".marked-count").text(Object.keys(moveState).length);
                    $(".table-marked tbody").html(markedHtml);
                    $("#markedHMModal").modal("show");
                }
            }

            function MoveMarked() {
                $("#markedHMModal").modal("hide");
                $.ajax({
                    url: "@Url.Action("MoveSelectedToHashMicro", "SalesInvoice")",
                    type: "POST",
                    data: {
                        Ids: Object.keys(moveState)
                    },
                    loaderMessage: "Please wait while this completes.<br><small class=\"text-muted\">Reloading the page will stop the process, so some records may be saved while others are not.</small>",
                    success: function (data, status, xhr) {
                        var success_ctr = 0;
                        $("table.table-moveall tbody").html("");
                        $.each(data, function (i, v) {
                            var jsonstr = JSON.parse(v.newRow);
                            $("table.table-moveall tbody").append(`<tr><td>Invoice Number: ${v.jsonstr.InvoiceNumber}<br />Move Name: ${v.jsonstr.HashMicroMoveName}</td><td>${v.message}</td></tr>`);
                            success_ctr++;
                        });
                        if(success_ctr > 0) {
                            invoiceDT.ajax.reload();
                        } else {
                            $("table.table-moveall tbody").append(`<tr><td colspan="2" class="text-center text-muted"><em>Nothing was moved</em></td></tr>`);
                        }
                        $("#viewAllHMModal").modal("show");
                    }
                });
            }
        }
    </script>
}