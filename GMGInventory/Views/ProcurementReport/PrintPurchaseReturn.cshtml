@model PurchaseReturnPVM

@{
    Layout = "";
    var title = "Purchase Return";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Period Covered: </strong>
        <span>@Model.DateFrom - @Model.DateTo</span>
        <br />
        <strong>Doc No: </strong>
        <span>@Model.DocNo</span>
        <br />
        <strong>Date Printed: </strong>
        <span>@Model.DatePrinted</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().ReturnDate)
                </th>
                @if (Model.GroupBy != "documentNumber")
                {
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().DocumentNumber)
                    </th>
                }
                @if (Model.GroupBy != "supplier")
                {
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().Supplier)
                    </th>
                }
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Item)
                </th>
                @if (Model.GroupBy != "itemDescription")
                {
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().ItemDescription)
                    </th>
                }
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Quantity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Unit)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().UnitCost)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().TotalAmount)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().ReturnQuantity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().ReturnTotalAmount)
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.GroupBy != null)
            {
                @foreach (var grp in Model.Contents.GroupBy(x => Model.GroupBy == "itemDescription" ? x.ItemDescription :
               Model.GroupBy == "supplier" ? x.Supplier :
               Model.GroupBy == "documentNumber" ? x.DocumentNumber : x.ReturnDate))
                {

                    <tr>
                        <td><nobr>@grp.Key</nobr></td>
                    </tr>
                    @foreach (var item in Model.Contents.Where(x => Model.GroupBy == "itemDescription" ? x.ItemDescription == grp.FirstOrDefault()!.ItemDescription :
                   Model.GroupBy == "supplier" ? x.Supplier == grp.FirstOrDefault()!.Supplier :
                   Model.GroupBy == "documentNumber" ? x.DocumentNumber == grp.FirstOrDefault()!.DocumentNumber :
                   x.ReturnDate == grp.FirstOrDefault()!.ReturnDate))
                    {
                        <tr>
                            <td><nobr>@item.ReturnDate</nobr></td>
                            @if (Model.GroupBy != "documentNumber")
                            {
                                <td>@item.DocumentNumber</td>
                            }
                            @if (Model.GroupBy != "supplier")
                            {
                                <td>@item.Supplier</td>
                            }
                            <td>@item.Item</td>
                            @if (Model.GroupBy != "itemDescription")
                            {
                                <td>@item.ItemDescription</td>
                            }
                            <td>@item.Quantity</td>
                            <td>@item.Unit</td>
                            <td>@item.UnitCost</td>
                            <td>@item.TotalAmount</td>
                            <td>@item.ReturnQuantity</td>
                            <td>@item.ReturnTotalAmount</td>
                        </tr>
                    }
                }
            }
            else
            {
                @foreach (var item in Model.Contents)
                {
                    <tr>
                        <td><nobr>@item.ReturnDate</nobr></td>
                        <td>@item.DocumentNumber</td>
                        <td>@item.Supplier</td>
                        <td>@item.Item</td>
                        <td>@item.ItemDescription</td>
                        <td>@item.Quantity</td>
                        <td>@item.Unit</td>
                        <td>@item.UnitCost</td>
                        <td>@item.TotalAmount</td>
                        <td>@item.ReturnQuantity</td>
                        <td>@item.ReturnTotalAmount</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                @if (Model.GroupBy != null)
                {
                    <th colspan="7" class="right-text">Total</th>
                }
                else
                {
                    <th colspan="8" class="right-text">Total</th>
                }
                <th class="right-text"><nobr>@Model.TotalAmount</nobr></th>
                <th></th>
                <th class="right-text"><nobr>@Model.TotalAmount2</nobr></th>
            </tr>
        </tfoot>
    </table>
</body>
</html>
<script type="text/javascript">
    window.print();
    window.onafterprint = window.close;
</script>