@model IEnumerable<PurchaseOrderRVM>

@{
    ViewData["Title"] = "Purchase Order";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                    <span class="fas fa-print"></span> Print
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-purchaseOrder">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Supplier)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Item)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemDescription)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.UnitCost)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UnservedQuantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UnservedAmount)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="7" class="text-end">Total</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-supplier" class="form-label mb-0">Supplier</label>
                            <select id="filter-supplier" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item" class="form-label mb-0">Item</label>
                            <select id="filter-item" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    @*  <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-unservedQty" class="control-label mb-0">Unserved Quantity</label>
                            <input type="number" min="0" value="0" id="filter-unservedQty" class="form-control form-control-sm" />
                        </div>
                    </div> *@
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%" class="form-select form-select-sm">
                                <option>All</option>
                                <option>Approved</option>
                                <option>Disapproved</option>
                                <option>Submitted</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label class="control-label mb-0 d-block" for="filter-unserved"> Unserved? </label>
                            <input class="form-check-input" type="checkbox" id="filter-unserved">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="groupby" class="form-label mb-0">Group By</label>
                            <select id="groupby" style="width:100%" class="form-select form-select-sm">
                                <option value="">None</option>
                                <option value="supplier">Supplier</option>
                                <option value="itemDescription">Item</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setFullYear(dt_from.getFullYear() + 1);
                    //dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setFullYear(dt_to.getFullYear() - 1);
                //dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        // Load Select2 for Supplier
        $("#filter-supplier").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: 'All',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? ("<em class='fw-light'> - " + repo.name + "</em>") : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Supplier")",
                dataType: 'json',
                type: "POST",
                delay: 500,
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#filterModal")
        });

        // Load Select2 for Item
        $("#filter-item").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: 'All',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                        : "") +
                    "<br />" +
                        "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                delay: 500,
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#filterModal")
        });

        // Load List on DataTable
        var purchaseOrderDT = $('.table-purchaseOrder').on('preXhr.dt', function (e, settings, data) {
            showLoader();
            }).DataTable({
                ajax: {
                    url: "@Url.Action("GetPurchaseOrderDT")",
                    type: "POST",
                    data: function (data) {
                        var itemId = $("#filter-item").val();
                        if (itemId) {
                            if (isNaN(itemId)) {
                                data.Item = 0;
                                data.ItemKeyword = itemId;
                            } else {
                                data.Item = itemId;
                            }
                        }

                        var supplierId = $("#filter-supplier").val();
                        if (supplierId) data.Supplier = supplierId;

                        data.DateFrom = $("#filter-from").val();
                        data.DateTo = $("#filter-to").val();
                        data.Unserved = $('#filter-unserved').is(':checked');
                        data.Status = $('#filter-status').val();
                    }
                },
                processing: true,
                serverSide: true,
                filter: true,
                responsive: true,
                autoWidth: false,
                search: {
                    return: true,
                },
                columns: [
                    { data: "orderDate", name: "orderDate" },
                    { data: "documentNumber", name: "documentNumber" },
                    { data: "supplier", name: "supplier" },
                    { data: "item", name: "item" },
                    { data: "itemDescription", name: "itemDescription" },
                    { data: "quantity", name: "quantity", className: "text-end" },
                    { data: "unit", name: "unit" },
                    { data: "unitCost", name: "unitCost", className: "text-end" },
                    { data: "unservedQuantity", name: "unservedQuantity", className: "text-end" },
                    { data: "unservedAmount", name: "unservedAmount", className: "text-end" }

                ],

                footerCallback: function (row, data, start, end, display) {
                    var json = purchaseOrderDT.ajax.json();
                    var api = this.api(), data;

                    $(api.column(7).footer()).html(FormatStringDecimal(json.totalAmount));
                    $(api.column(9).footer()).html(FormatStringDecimal(json.totalAmount2));
                },
                order: [[0, "desc"]],
                rowGroup: {
                    dataSrc: ''
                }
            });

        // Load functions upon DataTable load
            purchaseOrderDT.on("draw", function () {
                hideLoader();

                $(".table-purchaseOrder thead th").removeClass("text-end");
            });

            purchaseOrderDT.rowGroup().disable().draw();

            $(".btnFilter").on("click", function () {
                var groupBy = $("#groupby").val();
                if (groupBy == '') {
                    purchaseOrderDT.columns().visible(true);
                    purchaseOrderDT.rowGroup().disable().draw();
                }
                else {
                    var colIndex = purchaseOrderDT.column(groupBy + ':name').index();
                    purchaseOrderDT.columns().visible(true);
                    purchaseOrderDT.column(colIndex).visible(false);

                    purchaseOrderDT.rowGroup().enable().draw();
                    purchaseOrderDT.rowGroup().dataSrc(groupBy);
                }

                purchaseOrderDT.ajax.reload();

                $("#filterModal").modal("hide");
            });

            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());
                 urlQuery.push("Unserved=" + $('#filter-unserved').is(':checked'));
                 urlQuery.push("Status=" + $("#filter-status").val());

                if ($("#filter-supplier").val()) { urlQuery.push("Supplier=" + $("#filter-supplier").val()); }
                if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
                if ($("#groupby").val()) { urlQuery.push("GroupBy=" + $("#groupby").val()); }

                window.location = "@Url.Action("DownloadPurchaseOrder")?" + urlQuery.join("&");
            });

            $(".printBtn").on("click", function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                var urlQuery = [];
                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());
                urlQuery.push("Status=" + $("#filter-status").val());
                urlQuery.push("Unserved=" + $('#filter-unserved').is(':checked'));

                if ($("#filter-supplier").val()) { urlQuery.push("Supplier=" + $("#filter-supplier").val()); }
                if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
                if ($("#groupby").val()) { urlQuery.push("GroupBy=" + $("#groupby").val()); }

                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintPurchaseOrder")?' + urlQuery.join("&"), '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
    </script>
}