@model IEnumerable<PurchaseReceivingRVM>

@{
    ViewData["Title"] = "Purchase Receiving";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                    <span class="fas fa-print"></span> Print
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter 
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-purchaseReceiving">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.ReturnDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Supplier)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Item)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemDescription)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.UnitCost)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                      <th>
                        @Html.DisplayNameFor(model => model.UnservedQuantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UnservedAmount)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="8" class="text-end">Total</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-supplier" class="form-label mb-0">Supplier</label>
                            <select id="filter-supplier" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item" class="form-label mb-0">Item</label>
                            <select id="filter-item" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%" class="form-select form-select-sm">
                                <option>All</option>
                                <option>Approved</option>
                                <option>Disapproved</option>
                                <option>Submitted</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="groupby" class="form-label mb-0">Group By</label>
                            <select id="groupby" style="width:100%" class="form-select form-select-sm">
                                <option value="">None</option>
                                <option value="supplier">Supplier</option>
                                <option value="itemDescription">Item</option>
                                <option value="documentNumber">Purchase Order</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        // Load Select2 for Supplier
        $("#filter-supplier").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? ("<em class='fw-light'> - " + repo.name + "</em>") : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Supplier")"
            },
            dropdownParent: $("#filterModal")
        });

        // Load Select2 for Item
        $("#filter-item").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                        : "") +
                    "<br />" +
                    "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")"
            },
            dropdownParent: $("#filterModal")
        });

        
            var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
            var dt_duration = 3600000; // 1 hour

            function ApplyFilter() {
                $("#filterModal").modal("hide");
                LoadGroupHeader = true;

                purchaseReceivingDT.ajax.reload(() => {
                    var saved = localStorage.getItem(dt_storage);
                    if (saved) {
                        var parsed = JSON.parse(saved);
                        var expiry = parsed.timestamp + dt_duration;
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                    }
                    checkDefaultFilter();
                });
            }

            function ResetFilter() {
                $("#filterModal").modal("hide");
                resetToDefaultDTFilter();
                purchaseReceivingDT.ajax.reload(() => {
                    checkDefaultFilter();
                });
            }

            var defaultDTState = {
                order: [[0, "desc"]],
                page: 0,
                length: 10,
                search: { search: "" },
                SupplierId: "",
                Supplier: "",
                ItemId: "",
                Item: "",
                Status: "All",
                GroupBy: "",
                Preset: "L7D",
                DateFrom: DateForInput(getFilterDefaultDateFrom()),
                DateTo: DateForInput(getFilterDefaultDateTo())
            };

            function checkDTChanged() {
                if (!purchaseReceivingDT) return false;

                return JSON.stringify(purchaseReceivingDT.order()) != JSON.stringify(defaultDTState.order) ||
                    purchaseReceivingDT.page.info().start != defaultDTState.page ||
                    purchaseReceivingDT.page.len() != defaultDTState.length ||
                    (purchaseReceivingDT.search() || "") != defaultDTState.search.search ||
                    $("#filter-supplier").val() != defaultDTState.SupplierId ||
                    $("#filter-item").val() != defaultDTState.ItemId ||
                    $("#filter-status").val() != defaultDTState.Status ||
                    $("#groupby").val() != defaultDTState.GroupBy ||
                    $("#filter-preset").val() != defaultDTState.Preset ||
                    $('#filter-from').val() != defaultDTState.DateFrom ||
                    $('#filter-to').val() != defaultDTState.DateTo;
            }

            function checkDefaultFilter() {
                $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
                $(".btnReset").toggle(checkDTChanged());
                if (!checkDTChanged()) {
                    $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
                }
            }

            function resetToDefaultDTFilter() {
                $('#filter-supplier').val(defaultDTState.SupplierId).trigger('change');
                $('#filter-item').val(defaultDTState.ItemId).trigger('change');
                $('#filter-status').val(defaultDTState.Status);
                $('#groupby').val(defaultDTState.GroupBy);
                $('#filter-preset').val(defaultDTState.Preset);
                applyFilterPreset(defaultDTState.Preset);

                localStorage.removeItem(dt_storage);

                if (purchaseReceivingDT) {
                    purchaseReceivingDT.state.clear();
                    purchaseReceivingDT.order(defaultDTState.order);
                    purchaseReceivingDT.page(defaultDTState.page);
                    purchaseReceivingDT.search(defaultDTState.search.search);
                }

                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
                LoadGroupHeader = true;
            }

            var LoadGroupHeader = false;
        // Load List on DataTable
        var purchaseReceivingDT = $('.table-purchaseReceiving').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function(settings, data) {
                data.SupplierId = $('#filter-supplier').val();
                data.Supplier = $('#filter-supplier option:selected').text();
                data.ItemId = $('#filter-item').val();
                data.Item = $('#filter-item option:selected').text();
                data.Status = $('#filter-status').val();
                data.GroupBy = $('#groupby').val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function(settings, data) {
                if (data.SupplierId) {
                    var supplierOption = new Option(data.Supplier, data.SupplierId, true, true);
                    $("#filter-supplier").append(supplierOption).trigger('change');
                }
                if (data.ItemId) {
                    var itemOption = new Option(data.Item, data.ItemId, true, true);
                    $("#filter-item").append(itemOption).trigger('change');
                }
                $("#filter-status").val(data.Status);
                $("#groupby").val(data.GroupBy);
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
                LoadGroupHeader = true;
            },
            ajax: {
                url: "@Url.Action("GetPurchaseReceivingDT")",
                type: "POST",
                data: function (data) {
                    var itemId = $("#filter-item").val();
                    if (itemId) {
                        if (isNaN(itemId)) {
                            data.Item = 0;
                            data.ItemKeyword = itemId;
                        } else {
                            data.Item = itemId;
                        }
                    }

                    var supplierId = $("#filter-supplier").val();
                    if (supplierId) data.Supplier = supplierId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    data.Status = $('#filter-status').val();
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "returnDate", name: "returnDate" },
                {
                    data: function(data, type, dataToSet) {
                        return "<a href='/PurchaseReceive/Details/" + data.receivingId + "' class='link-info' target='_blank'>" + data.documentNumber + "</a>";
                    },
                    name: "documentNumber"
                },
                {
                    data: function(data, type, dataToSet) {
                        return "<a href='/Supplier/Details/" + data.supplierId + "' class='link-info' target='_blank'>" + data.supplier + "</a>";
                    },
                    name: "supplier"
                },
                {
                    data: function(data, type, dataToSet) {
                        return "<a href='/Item/Details/" + data.itemId + "' class='link-info' target='_blank'>" + data.item + "</a>";
                    },
                    name: "item"
                },
                { data: "itemDescription", name: "itemDescription" },
                { data: "quantity", name: "quantity" },
                { data: "unit", name: "unit" },
                { data: "unitCost", name: "unitCost", className: "text-end" },
                { data: "totalAmount", name: "totalAmount", className: "text-end" },
                { data: "unservedQuantity", name: "unservedQuantity", className: "text-end" },
                { data: "unservedAmount", name: "unservedAmount", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = purchaseReceivingDT.ajax.json();
                var api = this.api(), data;

                $(api.column(8).footer()).html(FormatStringDecimal(json.totalAmount));
                $(api.column(10).footer()).html(FormatStringDecimal(json.totalAmount2));
            },
            order: defaultDTState.order,
            rowGroup: {
                dataSrc: ''
            }
        }).on("draw", function() {
            checkDefaultFilter();
            $(".table-purchaseReceiving thead th").removeClass("text-end");

            if (LoadGroupHeader) {
                var groupBy = $("#groupby").val();
                if (groupBy == '') {
                    purchaseReceivingDT.columns().visible(true);
                    purchaseReceivingDT.rowGroup().disable().draw();
                } else {
                    var colIndex = purchaseReceivingDT.column(groupBy + ':name').index();
                    purchaseReceivingDT.columns().visible(true);
                    purchaseReceivingDT.column(colIndex).visible(false);

                    purchaseReceivingDT.rowGroup().enable().draw();
                    purchaseReceivingDT.rowGroup().dataSrc(groupBy);
                }
                LoadGroupHeader = false;
            }
        });

        purchaseReceivingDT.rowGroup().disable().draw();

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            urlQuery.push("Status=" + $("#filter-status").val());

            if ($("#filter-supplier").val()) { urlQuery.push("Supplier=" + $("#filter-supplier").val()); }
            if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
            if ($("#groupby").val()) { urlQuery.push("GroupBy=" + $("#groupby").val()); }

            window.location = "@Url.Action("DownloadPurchaseReceiving")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            urlQuery.push("Status=" + $("#filter-status").val());

            if ($("#filter-supplier").val()) { urlQuery.push("Supplier=" + $("#filter-supplier").val()); }
            if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
            if ($("#groupby").val()) { urlQuery.push("GroupBy=" + $("#groupby").val()); }

            setTimeout(function () {
                let win = window.open('@Url.Action("PrintPurchaseReceiving")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
}