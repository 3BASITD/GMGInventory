@model IEnumerable<UserInformationVM>

@{
    ViewData["Title"] = "Users";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                <span class="fas fa-plus"></span> New User
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.FirstName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.LastName)
                    </th>
                    <th class="defaultSort asc">
                        @Html.DisplayNameFor(model => model.Nickname)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Nickname</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="fas fa-check text-success"></span>
                            }
                            else
                            {
                                <span class="fas fa-times text-danger"></span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-info btn-xs" asp-action="Details" asp-route-id="@item.UserId" data-bs-toggle="tooltip" title="View Details">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            @if (item.IsActive)
                            {
                                <a class="btn btn-warning btn-xs" asp-action="Edit" asp-route-id="@item.UserId" data-bs-toggle="tooltip" title="Edit Details">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <a class="btn btn-secondary btn-xs" asp-action="Password" asp-route-id="@item.UserId" data-bs-toggle="tooltip" title="Reset Password">
                                    <i class="fas fa-key"></i>
                                </a>
                                <button data-id="@item.UserId" class="btn btn-danger btn-xs deleteBtn" type="button" data-bs-toggle="tooltip" title="Delete / Deactivate User">
                                    <i class="far fa-trash-alt"></i>
                                </button>
                            }
                            else
                            {
                                <button data-id="@item.UserId" class="btn btn-success btn-xs reactivateBtn" type="button" data-bs-toggle="tooltip" title="Reactivate User">
                                    <i class="fas fa-check"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form id="deleteUserForm" asp-action="Delete">
    <input type="hidden" id="deleteUserId" name="Id" />
</form>

<form id="reactivateUserForm" asp-action="Reactivate">
    <input type="hidden" id="reactivateUserId" name="Id" />
</form>

@section Scripts {
    <script>
        $('.table').DataTable({
            columnDefs: [
                { orderable: false, targets: -1 },
            ],
            order: [[2, "asc"]]
        });

        $('.deleteBtn').click(function(e) {
            swal({
                title: "Delete / Deactivate User",
                text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                icon: "warning",
                buttons: true,
                dangerMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#deleteUserId').val(id);
                    $('#deleteUserForm').submit();
                }
            });
        });

        $('.reactivateBtn').click(function(e) {
            swal({
                title: "Reactivate User",
                text: "Are you sure you want to reactivate this record?",
                icon: "info",
                buttons: true,
                infoMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#reactivateUserId').val(id);
                    $('#reactivateUserForm').submit();
                }
            });
        });


    </script>
}