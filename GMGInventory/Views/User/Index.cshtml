@model IEnumerable<UserInformationVM>

@{
    ViewData["Title"] = "Users";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                    <span class="fas fa-plus"></span> New User
                </a>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-user">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.FirstName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.LastName)
                    </th>
                    <th class="defaultSort asc">
                        @Html.DisplayNameFor(model => model.Nickname)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Role)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserModified)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateModified)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null)
                {
                    <tr><td colspan="5"><p class="text-center m-0">This record is empty</p></td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Nickname</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="fas fa-check text-success"></span>
                                }
                                else
                                {
                                    <span class="fas fa-times text-danger"></span>
                                }
                            </td>
                            <td>@item.Role</td>
                            <td>@item.UserCreated</td>
                            <td>@item.DateCreatedS</td>
                            <td>@item.UserModified</td>
                            <td>@item.DateModifiedS</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a class="btn btn-info btn-xs" asp-action="Details" asp-route-id="@item.UserId" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip">
                                        <span class="fas fa-info-circle"></span>
                                    </a>
                                    @if (item.IsActive)
                                    {
                                        @if (userAccess.CanEdit)
                                        {
                                            <a class="btn btn-warning btn-xs" asp-action="Edit" asp-route-id="@item.UserId" data-microtip-title="Edit Details" data-microtip-position="bottom-left" role="tooltip">
                                                <span class="fas fa-pencil-alt"></span>
                                            </a>
                                            <a class="btn btn-secondary btn-xs" asp-action="Password" asp-route-id="@item.UserId" data-microtip-title="Reset Password" data-microtip-position="bottom-left" role="tooltip">
                                                <span class="fas fa-key"></span>
                                            </a>
                                        }
                                        @if (userAccess.CanDelete)
                                        {
                                            <button data-id="@item.UserId" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete / Deactivate User" data-microtip-position="bottom-left" role="tooltip">
                                                <span class="far fa-trash-alt"></span>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        @if (userAccess.CanAdd || userAccess.CanEdit)
                                        {
                                            <button data-id="@item.UserId" class="btn btn-success btn-xs reactivateBtn" type="button" data-microtip-title="Reactivate User" data-microtip-position="bottom-left" role="tooltip">
                                                <span class="fas fa-check"></span>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (userAccess.CanDelete)
{
    <form id="deleteUserForm" asp-action="Delete">
        <input type="hidden" id="deleteUserId" name="Id" />
    </form>
}

@if (userAccess.CanAdd || userAccess.CanEdit)
{
    <form id="reactivateUserForm" asp-action="Reactivate">
        <input type="hidden" id="reactivateUserId" name="Id" />
    </form>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        var userDT = $('.table-user').DataTable({
            columnDefs: [
                { orderable: false, targets: -1 },
            ],
            order: [[2, "asc"]]
        });

        loadButton();
        userDT.on("draw", loadButton);

        function loadButton() {
            if (user_access.canDelete) {
                $('.deleteBtn').off("click").on("click", function (e) {
                    swal({
                        title: "Delete / Deactivate User",
                        text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteUserId').val(id);
                            $('#deleteUserForm').submit();
                        }
                    });
                });
            }

            if (user_access.canAdd || user_access.canEdit) {
                $('.reactivateBtn').off("click").on("click", function (e) {
                    swal({
                        title: "Reactivate User",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#reactivateUserId').val(id);
                            $('#reactivateUserForm').submit();
                        }
                    });
                });
            }
        }
    </script>
}