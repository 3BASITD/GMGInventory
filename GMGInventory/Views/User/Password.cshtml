@using GMGInventory.Common.Constants
@model UserResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="User" asp-action="Index">Users</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right mr-2" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <form asp-action="Password">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="Username" class="control-label mb-0"></label>
                            <input asp-for="Username" class="form-control form-control-sm" readonly />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="NewPassword" class="control-label mb-0"></label>
                            <input asp-for="NewPassword" class="form-control form-control-sm" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ConfirmPassword" class="control-label mb-0"></label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-sm" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <input type="hidden" name="Id" value="@Model.Id" />
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="card-tools">
                    <button type="submit" class="btn btn-primary btn-sm float-right">
                        <span class="fas fa-save"></span> Save
                    </button>
                </div>
            </div>
        </form>
    </div>

    @section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
