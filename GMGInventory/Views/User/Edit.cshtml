@using GMGInventory.Common.Constants
@model UserInformationForUpdateVM

@{
    ViewData["Title"] = "Update User";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="User" asp-action="Index">Users</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light btn-sm float-right mr-2" asp-action="Details" asp-route-id="@Model?.UserId">
                <span class="fas fa-window-close"></span> Cancel
            </a>
            <a class="btn btn-light btn-sm float-right mr-2" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <form asp-action="Edit">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Username" class="control-label mb-0"></label>
                        <input asp-for="Username" class="form-control form-control-sm" readonly />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FirstName" class="control-label mb-0"></label>
                        <input asp-for="FirstName" class="form-control form-control-sm" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="LastName" class="control-label mb-0"></label>
                        <input asp-for="LastName" class="form-control form-control-sm" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Nickname" class="control-label mb-0"></label>
                        <input asp-for="Nickname" class="form-control form-control-sm" />
                        <span asp-validation-for="Nickname" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Role" class="control-label mb-0"></label>
                        <select asp-for="Role" class="form-control form-control-sm"></select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="card-tools">
                <button type="submit" class="btn btn-primary btn-sm float-right">
                    <span class="fas fa-save"></span> Save
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetRolesOptions", "Access")",
            data: { includeId: "@Model!.RoleId" },
            success: function (data, status, xhr) {
                $("#Role").select2({
                    data: data
                });
            }
        });
    </script>
}
