@model AreaVM

@{
    ViewData["Title"] = "Edit Area";
}


@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Area" asp-action="Index">Areas</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right mr-2" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <form asp-action="Edit">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="Code" class="control-label mb-0"></label>
                            <input asp-for="Code" class="form-control form-control-sm" readonly />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Name" class="control-label mb-0"></label>
                            <input asp-for="Name" class="form-control form-control-sm" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CommissionRate" class="control-label mb-0"></label>
                            <div class="input-group input-group-sm">
                                 <input asp-for="CommissionRate" class="form-control form-control-sm" type="number" %/>
                                 <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="CommissionRate" class="text-danger"></span>
                        </div>
@*
                         <div class="col-md-3">
                            <div class="form-group">
                                <label for="edit-commission" class="form-label mb-0">Commission Rate</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="edit-commission" name="CommissionRate" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="edit-commission" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>*@
                         <div class="form-group">
                            <label asp-for="RegionId" class="control-label mb-0"></label>
                            <select asp-for="RegionId" asp-items="Model?.Regions" class="form-control select2option">
                            </select>
                            <span asp-validation-for="RegionId" class="text-danger"></span>
                        </div>
                        <input type="hidden" asp-for="Id" />
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="card-tools">
                    <button type="submit" class="btn btn-primary btn-sm float-right">
                        <span class="fas fa-save"></span> Save
                    </button>
                </div>
            </div>
        </form>
    </div>

    @section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
