@model IEnumerable<HomeImageVM>

@{
    ViewData["Title"] = "Home Image";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <button type="button" class="btn btn-primary btn-sm float-right createBtn" data-bs-toggle="modal" data-bs-target="#addModal">
                    <span class="fas fa-plus"></span> Add Home Image
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-image">
            <thead>
                <tr>
                    <th>
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.File)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DisplayOrder)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DisplayTime)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserModified)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateModified)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (userAccess.CanAdd)
{
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Home Image</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="formImage">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <div class="temp-carousel">
                                        <div id="add-image2-preview">
                                            <img id="home-image-selected" src="~/images/21x9.png" class="w-100" alt="Image">
                                        </div>
                                        <div class="caption d-none d-md-block">
                                            <h5 class="carousel-caption-title"></h5>
                                            <p class="carousel-caption-description"></p>
                                        </div>
                                    </div>
                                    <div class="input-group mt-3">
                                        <div class="custom-file">
                                            <input type="file" id="home-image" class="custom-file-input" name="FileImage" accept="image/*" onchange="imagePreview(this, 'add-image2-preview', 'w-100', 'home-image-selected')" />
                                            <label class="custom-file-label" for="home-image">Choose image</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="add-title" class="form-label mb-0">Title</label>
                                    <input type="text" id="add-title" name="Title" class="form-control form-control-sm" placeholder="none" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="add-description" class="form-label mb-0">Description</label>
                                    <input type="text" id="add-description" name="Description" class="form-control form-control-sm" placeholder="none" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="add-time" class="form-label mb-0">Display Time</label>
                                    <input type="number" min="5" max="3600" step="1" id="add-time" name="Time" class="form-control form-control-sm" placeholder="How long to display before sliding to next image (in seconds)" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-add">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        var imageDT = $('.table-image').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (user_access.canEdit && data.displayOrder != 0) {
                            actions += '<button type="button" class="btn btn-info btn-xs btn-up-image" data-microtip-title="Move Up" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-up"></i></button>';
                            actions += '<button type="button" class="btn btn-info btn-xs btn-down-image" data-microtip-title="Move Down" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-down"></i></button>';
                        }
                        return actions + '</div>';
                    },
                    className: "form-cell"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<img src="/images/HomeImages/' + data.file + '" alt="' + data.file + '" style="height:40px;">';
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.title == null ? "none" : data.title;
                    },
                    name: "Title",
                    className: "form-cell"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.description == null ? "none" : data.description;
                    },
                    name: "Description",
                    className: "form-cell"
                },
                {
                    data: function (data, type, dataToSet) {
                        var dateExpiry = new Date(data.dateModified);
                        dateExpiry.setDate(dateExpiry.getDate() + 7);

                        return data.displayOrder == 0 ? "deleted (expires on: " + formatDateEn(dateExpiry) + ")" : data.displayOrder;
                    },
                    name: "DisplayOrder",
                    className: "form-cell"
                },
                { data: "displayTime", name: "DisplayTime", className: "form-cell" },
                { data: "userCreated", name: "UserCreated", className: "form-cell" },
                { data: "dateCreated", name: "DateCreated", className: "form-cell" },
                { data: "userModified", name: "UserModified", className: "form-cell" },
                { data: "dateModified", name: "DateModified", className: "form-cell" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        //actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                        if (user_access.canDelete && data.displayOrder != 0) {
                            actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete Image" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                        }
                        return actions + "</div>";
                    }
                }
            ],
            order: [[4, "asc"]],
            rowCallback: function (row, data) {
                if (data.displayOrder == 0) {
                    $(row).find("td").addClass('text-muted fw-lighter');
                    $(row).find("img").addClass('opacity-50');
                }
            }
        });

        imageDT.on("draw", function () {
            hideLoader();

            $(".table-image thead th").removeClass("form-cell");
            $(".table-image thead th").removeClass("text-end");

            imageDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var rowData = this.data();
                if (rowData.displayOrder == 1)
                    $(this.node()).find(".btn-up-image").hide();
                else
                    $(this.node()).find(".btn-up-image").show();

                if (rowData.displayOrder == Math.max.apply(Math, imageDT.column(4).data().toArray().filter(value => !isNaN(value) && value !== null && value !== "")))
                    $(this.node()).find(".btn-down-image").hide();
                else
                    $(this.node()).find(".btn-down-image").show();
            });

            if (user_access.canDelete) {
                $('.deleteBtn').off("click").on("click", function () {
                    swal({
                        title: "Delete Image",
                        text: "Are you sure you want to delete this record?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var row_data = imageDT.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("DeleteImage")",
                                type: "POST",
                                data: { ImageId: row_data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        imageDT.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
            }

            if (user_access.canEdit) {
                $('.btn-up-image').off("click").on("click", function () {
                    var row_data = imageDT.row($(this).parents('tr')).data();
                    $.ajax({
                        url: "@Url.Action("MoveUpImage")",
                        type: "POST",
                        data: { ImageId: row_data.id },
                        success: function (data, status, xhr) {
                            if (data.status == "Success") {
                                imageDT.ajax.reload();
                            } else {
                                toastr.error(data.message, data.status);
                            }
                        }
                    });
                });

                $('.btn-down-image').off("click").on("click", function () {
                    var row_data = imageDT.row($(this).parents('tr')).data();
                    $.ajax({
                        url: "@Url.Action("MoveDownImage")",
                        type: "POST",
                        data: { ImageId: row_data.id },
                        success: function (data, status, xhr) {
                            if (data.status == "Success") {
                                imageDT.ajax.reload();
                            } else {
                                toastr.error(data.message, data.status);
                            }
                        }
                    });
                });
            }
        });

        if (user_access.canAdd) {
            $(".createBtn").on("click", function () {
                $("#home-image-selected").attr("src", "/images/21x9.png");
                $(".carousel-caption-title").text("");
                $(".carousel-caption-description").text("");
                $("label.custom-file-label[for='home-image']").text("Select image");
                $("#home-image").val("");
                $("#add-title").val("");
                $("#add-description").val("");
                $("#add-time").val(0);
            });

            $("#add-title").on("keyup", function () {
                $(".carousel-caption-title").text($(this).val());
            });

            $("#add-description").on("keyup", function () {
                $(".carousel-caption-description").text($(this).val());
            });

            function imagePreview(that, previewerId, className, idName) {
                var cls = className || "";
                var id = idName || "";
                let files = that.files;
                document.getElementById(previewerId).innerHTML = '';

                for (let i = 0; i < files.length; i++) {
                    let imager = document.createElement("img");
                    imager.src = URL.createObjectURL(files[i]);
                    imager.classList.add("w-100");
                    imager.classList.add("mt-2");
                    imager.classList.add("mb-2");

                    var classNames = cls.split(" ");
                    classNames.forEach((classN) => {
                        imager.classList.add(classN);
                    });

                    imager.setAttribute("id", id);
                    document.getElementById(previewerId).append(imager);
                }
            }

            $("#home-image").on("change", function () {
                if ($("#home-image").val() == "") {
                    $("label.custom-file-label[for='home-image']").text("Select image");
                } else {
                    $("label.custom-file-label[for='home-image']").text($("#home-image").val().split("\\").slice(-1));
                }
            });

            // Validation for Add Modal
            var validateEdit = $("#formImage").validate({
                rules: {
                    FileImage: { required: true },
                    Title: { maxlength: 25 },
                    Description: { maxlength: 150 },
                    Time: { required: true, number: true, min: 5, max: 3600 }
                },
                messages: {
                    FileImage: { required: "Please select an image." },
                    Title: { maxlength: "Title must not exceed 25 characters." },
                    Description: { maxlength: "Title must not exceed 150 characters." },
                    Time: { required: "Please enter how long the image to display before sliding to next image.", number: "Please enter a valid number.", min: "Only allowed duration is atleast 5 seconds", max: "Only allowed duration is at max 1 hour or 3600 seconds" }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoSubmit();
                }
            });

            function DoSubmit() {
                var formData = new FormData();
                formData.append("Id", 0);
                formData.append("File", $("#home-image")[0].files[0]);
                formData.append("Title", $("#add-title").val());
                formData.append("Description", $("#add-description").val());
                formData.append("DisplayTime", $("#add-time").val());

                $.ajax({
                    url: "@Url.Action("AddImage")",
                    type: "POST",
                    data: formData,
                    async: false,
                    cache: false,
                    contentType: false,
                    enctype: "multipart/form-data",
                    processData: false,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            $("#addModal").modal("hide");
                            imageDT.ajax.reload();

                            toastr.success(data.message, "Success");
                        }
                    }
                });
            };
        }
    </script>
}
