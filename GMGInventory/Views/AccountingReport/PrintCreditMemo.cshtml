@model CreditDebitMemoPVM

@{
    Layout = "";
    var title = "Credit Memo";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Customer</strong>
        <span>@Model.Customer</span>
        <br />
        <strong>Date From</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Date To</strong>
        <span>@Model.DateTo</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Memos.First().MemoDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Memos.First().MemoNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Memos.First().Customer)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Memos.First().Amount)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Memos)
            {
                <tr>
                    <td><nobr>@item.MemoDate</nobr></td>
                    <td><nobr>@item.MemoNumber</nobr></td>
                    <td>@item.Customer</td>
                    <td class="right-text"><nobr>@item.Amount</nobr></td>
                </tr>
            }
        </tbody>
        @if (Model.Customer != "All")
        {
            <tfoot>
                <tr>
                <th colspan="3" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalAmount</nobr></th>
            </tr>
        </tfoot>
        }
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = window.close;
</script>
</html>