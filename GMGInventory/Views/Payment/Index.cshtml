@model IEnumerable<PaymentVM>

@{
    ViewData["Title"] = "Payment";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-payment">
            <thead>
                <tr>
                  
                    <th>
                        @Html.DisplayNameFor(model => model.CRNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SOANo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalInvoiceAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AmountPaid)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OverPayment)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TransactionDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedBy)
                    </th>
                     <th>
                        @Html.DisplayNameFor(model => model.Remarks)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>



@section Scripts {
    <script>
        // Load List on DataTable
        var dataTable = $('.table-payment').on('preXhr.dt', function(e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson", "Payment")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            columns: [
                { data: "crNumber", name: "CRNumber" },
                { data: "soaNo", name: "SOANo" },
                { data: "customerName", name: "CustomerName" },
                { data: "totalInvoiceAmount", name: "TotalInvoiceAmount" },
                { data: "amountPaid", name: "AmountPaid" },
                { data: "overPayment", name: "OverPayment" },
                { data: "transactionDate", name: "TransactionDate" },
                { data: "createdBy", name: "CreatedBy" },
                { data: "remarks", name: "Remarks" },
                {
                    orderable: false,
                    data: function(data, type, dataToSet) {
                      var actions = '';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                        return actions;
                    }
                }
                
            ]
        });

        // load functions upon datatable load
        dataTable.on("draw", function () {
            hideLoader();

            DatatablesSearchOnEnter('.table-payment', dataTable);
        });

       


   

    </script>
    }