@model PaymentVM

@{
    ViewData["Title"] = "Payment Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Payment" asp-action="Index">Payments</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
             @*   @if (Model?.IsActive == true)
            {
                <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Edit" asp-route-id="@Model?.Id">
                    <span class="fas fa-edit"></span> Edit Warehouse
                </a>
            }*@
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SOANo)
                    </span>
                    <b class="d-block">
                        @Model?.SOANo
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CRNumber)
                    </span>
                    <b class="d-block">
                        @Model?.CRNumber
                    </b>
                </p>
                 <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerName
                    </b>
                </p>
                 <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @Model?.Remarks
                    </b>
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OverPayment)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.OverPayment) ? "-" : Model?.OverPayment)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Tax)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Tax) ? "-" : Model?.Tax)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Discount)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Discount) ? "-" : Model?.Discount)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CashAmount)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.CashAmount) ? "-" : Model?.CashAmount)
                    </b>
                </p>
            </div>
            <div class="col-md-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.TKT)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.TKT) ? "-" : Model?.TKT)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CashAdvanced)
                    </span>
                   </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.CashAdvanced) ? "-" : Model?.CashAdvanced)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Offset)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Offset) ? "-" : Model?.Offset)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.BackLoad)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.BackLoad) ? "-" : Model?.BackLoad)
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-danger card-tabs">
                    <div class="card-header p-0 pt-1 pl-2">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-check">
                                <a class="nav-link active" id="nav-checks-tab" data-toggle="pill" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-checks"
                                   aria-controls="nav-checks" aria-selected="true">
                                    Checks
                                </a>
                            </li>
                            <li class="nav-invoice">
                                <a class="nav-link" id="nav-invoice-tab" data-toggle="pill" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-invoice"
                                   aria-controls="nav-invoice" aria-selected="true">
                                    Invoices
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-checks" role="tabpanel"
                                 aria-labelledby="nav-checks-tab">
                                <table class="table table-head-fixed table-striped table-hover table-payment-checks">
                                    <thead>
                                        <tr>
                                            <th>Bank Name</th>
                                            <th>Bank Branch</th>
                                            <th>Check Number</th>
                                            <th>Check Amount</th>
                                            <th>Check Date</th>                                      
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                             <div class="tab-pane fade show" id="nav-invoice" role="tabpanel"
                                 aria-labelledby="nav-invoice-tab">
                                <table class="table table-head-fixed table-striped table-hover table-payment-invoice">
                                    <thead>
                                        <tr>
                                            
                                            <th>Invoice No</th>
                                            <th>Invoice Date</th>
                                            <th>Invoice Type</th>
                                            <th>Invoice Amount</th>
                                            <th>Balance Amount</th>
                                            <th>Pack No</th>
                                            <th>Sales Order No</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                    

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var itemTableChecks = $('.table-payment-checks').on('preXhr.dt', function(e, settings, data) {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fa fa-cog fa-spin"
            });
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJsonDetails", "Payment")",
                type: "POST",
                data: function(data) {
                    data.CustomerPaymentId = @Model?.Id;
                },
            },
            responsive: true,
            autoWidth: false,
            serverSide: true,
            filter: true,
            columns: [
                { data: "bankName", name: "BankName" },
                { data: "bankBranch", name: "BankBranch" },
                { data: "checkNo", name: "CheckNo" },
                { data: "checkAmount", name: "CheckAmount" },
                { data: "checkDate", name: "CheckDate" }
               
            ]
        });

        itemTableChecks.on("draw", function() {
            $.LoadingOverlay("hide");
        });


        var itemTableInvoice = $('.table-payment-invoice').on('preXhr.dt', function(e, settings, data) {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fa fa-cog fa-spin"
            });
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJsonDetails", "Payment")",
                type: "POST",
                data: function(data) {
                    data.CustomerPaymentId = @Model?.Id;
                },
            },
            responsive: true,
            autoWidth: false,
            serverSide: true,
            filter: true,
            columns: [
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "invoiceType", name: "InvoiceType" },
                { data: "invoiceAmount", name: "InvoiceAmount" },
                { data: "balanceAmount", name: "BalanceAmount" },
                { data: "packNo", name: "PackNo" },
                { data: "salesOrderNo", name: "SalesOrderNo" }
            ]
        });

        itemTableInvoice.on("draw", function() {
            $.LoadingOverlay("hide");
        });



    </script>
}