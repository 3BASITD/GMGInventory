@{
    ViewData["Title"] = "Barcotech Sync Status";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-logs">
            <thead>
                <tr>
                    <th>
                        Module Name
                    </th>
                    <th>
                        Primary Key
                    </th>
                    <th>
                        Sync Status
                    </th>
                    <th>
                        Remarks
                    </th>
                    <th>
                        Date Performed
                    </th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Load List on DataTable
        var dtLogs = $('.table-logs').on('preXhr.dt', function(e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "moduleName", name: "ModuleName" },
                { data: "primaryKey", name: "PrimaryKey" },
                { data: "syncStatus", name: "SyncStatus" },
                {
                    data: function(data, type, dataToSet) {
                        if(data.syncStatus.toLowerCase() != "success") {
                            return data.remarks.split("||").join("<br />");
                        } else {
                            var splitRemarks = data.remarks.split("||");
                            var id = "";
                            var name = "";
                            if(splitRemarks.length == 2) {
                                var [id,name] = splitRemarks;
                                var module = data.moduleName.toLowerCase();
                                
                                if(module == "receiving")
                                    return `<a href='/PurchaseReceive/Details/${id}' class='text-info' target='_blank'>${name}</a>`;
                                if(module == "outbound")
                                    return `<a href='/SalesOrder/Details/${id}' class='text-info' target='_blank'>${name}</a>`;
                                if(module == "return")
                                    return `<a href='/SalesReturn/Details/${id}' class='text-info' target='_blank'>${name}</a>`;
                                if(module == "transfer")
                                    return `<a href='/Transfer/Details/${id}' class='text-info' target='_blank'>View</a>`;
                            }
                            return data.remarks;
                        }
                        return formatValues(data.primaryKey);
                    },
                    name: "PrimaryKey"
                },
                { data: "datePerformed", name: "DatePerformed" }
            ],
            order: [[4, "desc"]]
        });

        dtLogs.on("draw", function() {
            hideLoader();
        });
    </script>
}