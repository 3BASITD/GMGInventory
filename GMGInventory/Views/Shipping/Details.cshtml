@model ShippingVM

@{
    ViewData["Title"] = "Shipping Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Shipping" asp-action="Index">Shipping List</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <div class="dropdown float-right ml-2">
                    <button class="btn btn-info btn-sm dropdown-toggle" type="button" id="dropdownMenuPrint" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="fas fa-print"></span> Print
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuPrint">
                        <li><a class="dropdown-item btn-details-print" data-company="GMG">Use GMG Logo</a></li>
                        <li><a class="dropdown-item btn-details-print" data-company="BAS">Use BAS Logo</a></li>
                    </ul>
                </div>
            }
            <a class="btn btn-light btn-sm float-right" asp-action="Index" )">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>

        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SONumber)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.SONumber
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.CustomerName
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerAddress)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.CustomerAddress
                    </b>
                </p>
            </div>
       
        </div>
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PairedInvoices)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.PairedInvoices
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        Number of boxes,crates,roll etc
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Packaging
                    </b>
                </p>
            </div>
      
        </div>
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6 ">
                <div class="form-group">
                    <label for="shipping-freight" class="text-muted fw-normal mb-0"> Freight </label>

                    <select id="shipping-freight" style="width: 100%" class="form-select form-select-sm font-weight-bold">
                        <option value="prepaid">Prepaid</option>
                        <option value="collect">Collect</option>
                        <option value="cod">C.O.D</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <div class="form-group">
                    <label for="shipping-desc" class="text-muted fw-normal mb-0">Description Of Article</label>
                    <input type="text" id="shipping-desc" class="form-control form-control-sm font-weight-bold" value="SPARE/PARTS" />
                </div>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <div class="form-group">
                    <label for="shipping-value" class="text-muted fw-normal mb-0">Value</label>
                    <input type="number" step="0.01" min="0" id="shipping-value" class="form-control form-control-sm font-weight-bold" />
                </div>
            </div>
        </div>
    
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Packed Item(s)</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th>Package Number</th>
                                    <th>Package Type</th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                          @*   <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th class="total-quantity">0</th>
                                </tr>
                            </tfoot> *@
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { salesOrderId: @Model?.SalesOrderId },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            paging: false,
            searching: false,
            search: {
                return: true,
            },
            columns: [
                { data: "boxNumber", name: "BoxNumber", visible: false },
                { data: "packTypeName", name: "PackTypeName", visible: false },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="bottom-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "quantity", name: "Quantity", className: "text-end" }
            ],
            // footerCallback: function (row, data, start, end, display) {
            //     var api = this.api(), data;
            //     columnDTTotalInteger(api, 5);
            // },
            order: [[2, "asc"]],
            orderFixed: [[0, 'asc'], [1, 'asc']],
            rowGroup: {
                startRender: function (rows, group) {
                    return $('<tr/>')
                        .append('<td colspan="3"><strong>Package ' + group + '</strong></td>');
                },
                endRender: function (rows, group) {
                    return $('<tr/>')
                        .append('<td colspan="2" class="text-end">Total Quantity for <strong>Package ' + group + '</strong></td>')
                        .append('<td class="text-end">' + rows.data().pluck("quantity").reduce(function (a, b) { return parseInt(a) + parseInt(b); }, 0) + '</td>');
                },
                dataSrc: function (row) {
                    var boxNo = parseInt(row.boxNumber) + 1;
                    $('#boxNo').val(parseInt(row.boxNumber) + 1);

                    return "#" + row.boxNumber + " (" + row.packTypeName + ")";
                }
            }
        });

        itemDT.on("draw", function () {
            hideLoader();
        });

        $(".btn-details-print").on("click", function () {
            var print_company = $(this).data("company");
            var print_desc = $('#shipping-desc').val();
            var print_freight = $('#shipping-freight').val();
            var print_value = $('#shipping-value').val();


            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            setTimeout(function () {
                var urlQuery = [];
                urlQuery.push("Id=" + @Model?.SalesOrderId);
                urlQuery.push("Company=" + print_company);
                urlQuery.push("Desc=" + print_desc);
                urlQuery.push("Freight=" + print_freight);
                urlQuery.push("Value=" + print_value);

                let win = window.open('@Url.Action("PrintDetails")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });

    </script>
}