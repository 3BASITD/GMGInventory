@model ShippingPVM

@{
    Layout = "";
    var title = "Shipping Report";
    // var items = ViewData["Items"] as List<ShippingVM> ?? new List<ShippingVM>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <table class="formatted">
        <tr>
            <td rowspan="2" class="center-text">
                @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                {
                    <img src="~/images/BAS-02.png" class="logo" />
                }
                else
                {
                    <img src="~/images/GMG-01.png" class="logo" />
                }
            </td>
            <td rowspan="2"  style="width: 90%;">
                <div class="column center-text">
                    <dl>
                        <dd>BINA'S AUTO SUPPLY INC</dd>
                        <dt>1034 KUSANG LOOB  STA. CRUZ MANILA</dt>
                        <dt>CONTACT NO: 712-9260 / 0920-909-2787</dt>
                        <dd>SHIPPING LIST</dd>
                    </dl>
                </div>
            </td>
        </tr>
    
    </table>

    <br />
    <p> Received from BINA'S AUTO SUPPLY  the following Goods for shipment and delivery consignee name below: </p>
    <br />

    <table>
        <tr>
            <td colspan="7">
                <table>
                    <thead>
                        <tr>
                            <th style="min-width: 50px;">Quantity</th>
                            <th style="min-width: 25px;">UOM</th>
                            <th>DESCRIPTION OF ARTICLE</th>
                            <th style="min-width: 25px;">VALUE</th>
                            <th class="right-text" style="min-width: 25px;">FREIGHT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td></td>
                            <td class="center-text">@Model.DescriptionOfArticle</td>
                            <td class="right-text">@Model.Value</td>
                            <td></td>
                        </tr>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="center-text"><nobr>@item.Quantity</nobr></td>
                                <td class="center-text"><nobr>@item.UOM</nobr></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </td>
            <td colspan="1">
                <table>
                    <tbody>
                        <tr><td class="right-text">  <strong> @(Model.Freight == "prepaid" ? "/ " : "")  Prepaid </strong> </td> </tr>
                        <tr><td class="right-text"> <strong> @(Model.Freight == "collect" ? "/ " : "") Collect </strong>  </td></tr>
                        <tr><td class="right-text">  <strong>@(Model.Freight == "cod" ? "/ " : "") C.O.D </strong></td>  </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
   

    <br />

    <table>
        <tr>
            <td>
                <dl>
                    <dt><strong>TOTAL:</strong> </dt>
                    <dt><strong>INVOICE NO./PO NO:</strong> @Model.Details!.PairedInvoices</dt>
                    <dt><strong>CONSIGNEE:</strong> @Model.Details!.CustomerName</dt>
                    <dt><strong>ADDRESS:</strong> @Model.Details!.CustomerAddress</dt>
                    <dt><strong>CONTACT NO:</strong> @Model.Details!.CustomerContactNo </dt>
                </dl>
            </td>
            <td>
                <dl>
                    <dt><strong>FORWARDER/SHIPPING CO/TRUCKING CO:</strong> @Model.Details!.Forwarder</dt>
                    <br />
                    <br />
@* 
                    <dt></dt>
                    <dt></dt> *@
                    <dt><strong>RECEIVED BY:</strong> </dt>
                </dl>
            </td>
        </tr>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>