@model PurchaseRequestDetailedVM

@{
    Layout = "";
    var title = "Purchase Request";
    var items = ViewData["Items"] as List<PurchaseRequestLineItemVM> ?? new List<PurchaseRequestLineItemVM>();

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <table class="formatted">
        <tr>
            <td colspan="2" rowspan="2" class="center-text">
                @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                {
                    <img src="~/images/BAS-02.png" class="logo" />
                }
                else
                {
                    <img src="~/images/GMG-01.png" class="logo" />
                }
            </td>
            <td colspan="2" rowspan="2">
                <dl>
                    <dt>Document Classification:</dt>
                    <dd>@title.ToUpper()</dd>
                    @if (Model.Status.ToLower() != "approved")
                    {
                        <dd>@("(" + Model.Status + ")")</dd>
                    }
                </dl>
            </td>
            <td colspan="3">
                <dl>
                    <dt>PR Date:</dt>
                    <dd>@Model.RequestDate</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td colspan="3">
                <dl>
                    <dt>PR No.:</dt>
                    <dd>@Model.DocumentNumber</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td colspan="7">
                <div class="label">
                    <span>Type of Request:</span>
                    <strong class="detail">@Model.Type</strong>
                </div>
                <div class="label">
                    <span>Purpose:</span>
                    <strong class="detail">@Model.Purpose</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Region))
                {
                    <div class="label">
                        <span>Region:</span>
                        <strong class="detail">@Model.Region</strong>
                    </div>
                }
            </td>
        </tr>
        <tr>
            <th style="min-width: 10px;">#</th>
            <th style="min-width: 50px;">PART NUMBER</th>
            <th>ITEM DESCRIPTION</th>
            <th style="min-width: 50px;">QTY</th>
            <th style="min-width: 25px;">UOM</th>
            <th style="min-width: 50px;">SOH</th>
            <th style="min-width: 50px;">REF.SO#</th>
        </tr>
        @for (var a = 1; a <= 19; a++)
        {
            var item = items.Where(s => s.LineNumber == a).FirstOrDefault();
            if (item != null)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    <td>@item.ItemPartNumber</td>
                    <td>@item.ItemDescription</td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td>@item.UnitCode</td>
                    <td class="right-text"><nobr>@item.StockOnHand</nobr></td>
                    <td><nobr>@(string.IsNullOrWhiteSpace(item.SalesOrderNumber) ? "-" : item.SalesOrderNumber)</nobr></td>
                </tr>
            }
            else
            {
                <tr>
                    <td class="center-text" style="min-width: 10px;"><nobr>@a</nobr></td>
                    <td></td>
                    <td>@(items.Count() + 1 == a ? "* * NOTHING FOLLOWS * *" : "")</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            }
        }
        <tr>
            <td class="center-text" style="min-width: 10px;"><nobr>20</nobr></td>
            @{
                var twenties = items.Count(s => s.LineNumber >= 20);
            }
            @if (twenties == 0)
            {
                <td></td>
                <td>@(items.Count() == 19 ? "* * NOTHING FOLLOWS * *" : "")</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            }
            else if (twenties == 1)
            {
                var item = items.Where(s => s.LineNumber == 20).First();
                <td style="min-width: 50px;">@item.ItemPartNumber</td>
                <td>@item.ItemDescription</td>
                <td class="right-text" style="min-width: 50px;"><nobr>@item.Quantity</nobr></td>
                <td style="min-width: 20px;">@item.UnitCode</td>
                <td class="right-text" style="min-width: 50px;"><nobr>@item.StockOnHand</nobr></td>
                <td style="min-width: 50px;"><nobr>@(string.IsNullOrWhiteSpace(item.SalesOrderNumber) ? "-" : item.SalesOrderNumber)</nobr></td>
            }
            else
            {
                var item = items.Where(s => s.LineNumber >= 20).ToList();
                <td></td>
                <td>@(item.Count) more item(s)</td>
                <td class="right-text">@item.Sum(s => s.QuantityD)</td>
                <td></td>
                <td></td>
                <td></td>
            }
        </tr>
        <tr>
            <td colspan="7">
                <dl>
                    <dt>Remarks:</dt>
                    <dd>@Model.Remarks</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td colspan="7">
                <br />
                <br />
                <div class="two-column">
                    <div class="column center-text">
                        <dl>
                            <dd>@Model.UserCreated</dd>
                            <dt>Prepared By</dt>
                        </dl>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy1) || !string.IsNullOrWhiteSpace(Model.ApprovedBy2))
                    {
                        <div class="column center-text">
                            <dl>
                                @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy1))
                                {
                                    <dd>@Model.ApprovedBy1</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy2))
                                {
                                    <dd>@Model.ApprovedBy2</dd>
                                }
                                <dt>Approved By</dt>
                            </dl>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                    {
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.DisapprovedBy</dd>
                                <dt>Disapproved By</dt>
                            </dl>
                        </div>
                    }
                </div>
            </td>
        </tr>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>