@model PurchaseRequestDetailedVM

@{
    Layout = "";
    var title = "Purchase Request";
    var items = ViewData["Items"] as List<PurchaseRequestLineItemVM> ?? new List<PurchaseRequestLineItemVM>();

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    @{
        var cspan = 5;
        if (Model.Type.ToLower() == "automotive" && Model.Purpose.ToLower() == "stocking")
        {
            cspan = 6;
        }
        else if (Model.Type.ToLower() == "automotive" && Model.Purpose.ToLower() == "rush order")
        {
            cspan = 7;
        }
    }
    <table class="formatted">
        <thead>
            <tr>
                <td colspan="@cspan" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col center w-150px">
                            @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                            {
                                <img src="~/images/BAS-02.png" class="logo" />
                            }
                            else
                            {
                                <img src="~/images/GMG-01.png" class="logo" />
                            }
                        </div>
                        <div class="sub-col center w-60pc p-50">
                            <span class="title">Document Classification:</span>
                            <span class="desc">
                                @title.ToUpper()
                                @if (Model.Status.ToLower() != "approved")
                                {
                                    @("(" + Model.Status + ")")
                                }
                            </span>
                        </div>
                        <div class="sub-col center w-40pc">
                            <span class="title">PR Date:</span>
                            <span class="desc">@Model.RequestDate</span>
                            <hr />
                            <span class="title">PR No.:</span>
                            <span class="desc">@Model.DocumentNumber</span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="@cspan" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col w-50pc">
                            <div class="label">
                                <span>Type of Request:</span>
                                <strong class="detail">@Model.Type</strong>
                            </div>
                            <div class="label">
                                <span>Purpose:</span>
                                <strong class="detail">@Model.Purpose</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.Region))
                            {
                                <div class="label">
                                    <span>Region:</span>
                                    <strong class="detail">@Model.Region</strong>
                                </div>
                            }
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <th style="min-width: 10px;">#</th>
                @if (Model.Type.ToLower() == "automotive")
                {
                    <th style="min-width: 50px;">PART NUMBER</th>
                }
                @if (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "office supplies")
                {
                    <th style="min-width: 50px;">ITEM CODE</th>
                }
                <th>ITEM DESCRIPTION</th>
                <th style="min-width: 50px;">QTY</th>
                <th style="min-width: 25px;">UOM</th>
                @if (Model.Type.ToLower() == "automotive")
                {
                    <th style="min-width: 50px;">SOH</th>
                }
                @if (Model.Type.ToLower() == "maintenance & repair" || (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "one-time purchase"))
                {
                    <th>PURPOSE</th>
                }
                @if (Model.Type.ToLower() == "automotive" && Model.Purpose.ToLower() == "rush order")
                {
                    <th style="min-width: 50px;">REF.SO#</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    @if (Model.Type.ToLower() == "automotive")
                    {
                        <td class="center-text">@item.ItemPartNumber</td>
                    }
                    @if (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "office supplies")
                    {
                        <td class="center-text">@item.ItemCode</td>
                    }
                    <td>@item.ItemDescription</td>
                    <td class="center-text"><nobr>@item.Quantity</nobr></td>
                    <td class="center-text">@item.UnitCode</td>
                    @if (Model.Type.ToLower() == "automotive")
                    {
                        <td class="center-text"><nobr>@item.StockOnHand</nobr></td>
                    }
                    @if (Model.Type.ToLower() == "maintenance & repair" || (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "one-time purchase"))
                    {
                        <td class="center-text">@item.Purpose</td>
                    }
                    @if (Model.Type.ToLower() == "automotive" && Model.Purpose.ToLower() == "rush order")
                    {
                        <td class="center-text"><nobr>@(string.IsNullOrWhiteSpace(item.SalesOrderNumber) ? "-" : item.SalesOrderNumber)</nobr></td>
                    }
                </tr>
            }
            @{
                var itemCount = items.Count;
                var lastLineNumber = items.OrderByDescending(s => s.LineNumber).Select(s => s.LineNumber).First();
            }
            <tr>
                <td class="center-text" style="min-width: 10px;">@(lastLineNumber + 1)</td>
                @if (Model.Type.ToLower() == "automotive")
                {
                    <td></td>
                }
                @if (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "office supplies")
                {
                    <td></td>
                }
                <td class="center-text">* * NOTHING FOLLOWS * *</td>
                <td></td>
                <td></td>
                @if (Model.Type.ToLower() == "automotive")
                {
                    <td></td>
                }
                @if (Model.Type.ToLower() == "maintenance & repair" || (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "one-time purchase"))
                {
                    <td></td>
                }
                @if (Model.Type.ToLower() == "automotive" && Model.Purpose.ToLower() == "rush order")
                {
                    <td></td>
                }
            </tr>
            @if (itemCount < 20)
            {
                for (var ctr = 2; ctr <= 20 - itemCount; ctr++)
                {
                    <tr>
                        <td class="center-text" style="min-width: 10px;">@(lastLineNumber + ctr)</td>
                        @if (Model.Type.ToLower() == "automotive")
                        {
                            <td></td>
                        }
                        @if (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "office supplies")
                        {
                            <td></td>
                        }
                        <td></td>
                        <td></td>
                        <td></td>
                        @if (Model.Type.ToLower() == "automotive")
                        {
                            <td></td>
                        }
                        @if (Model.Type.ToLower() == "maintenance & repair" || (Model.Type.ToLower() == "non-automotive" && Model.Purpose.ToLower() == "one-time purchase"))
                        {
                            <td></td>
                        }
                        @if (Model.Type.ToLower() == "automotive" && Model.Purpose.ToLower() == "rush order")
                        {
                            <td></td>
                        }
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan=@cspan>
                    <dl>
                        @if (Model.Type.ToLower() == "maintenance & repair")
                        {
                            <dt> INITIAL DIAGNOSIS:</dt>
                        }
                        else
                        {
                            <dt> REMARKS:</dt>
                        }
                        <dd>@Model.Remarks</dd>
                    </dl>
                </td>
            </tr>
            <tr>
                <td colspan=@cspan class="bb-0">
                    <br />
                    <br />
                    <div class="two-column">
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.UserCreated</dd>
                                <dt>Prepared By:</dt>
                            </dl>
                        </div>
                        @* @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy1) || !string.IsNullOrWhiteSpace(Model.ApprovedBy2))
                        {
                            <div class="column center-text">
                                <dl>
                                    @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy1))
                                    {
                                        <dd>@Model.ApprovedBy1</dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy2))
                                    {
                                        <dd>@Model.ApprovedBy2</dd>
                                    }
                                    <dt>Approved By:</dt>
                                </dl>
                            </div>
                        } *@
                        @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy1))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.ApprovedBy1</dd>
                                    <dt>Approved By:</dt>
                                </dl>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.DisapprovedBy</dd>
                                    <dt>Disapproved By:</dt>
                                </dl>
                            </div>
                        }
                    </div>
                </td>
            </tr>
            <tr class="text-center">
                <td colspan=@cspan class="bt-0">
                    <p class="footer center-text"> Bina's Auto Supply | 1034 Kusang Loob St. Brgy. 330 Zone 033 Sta. Cruz, Manila | Tel. No.8731-3923,8741-5537/39 </p>
                </td>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>