@model IEnumerable<PurchaseRequestVM>

@{
    ViewData["Title"] = "Purchase Requests";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Create">
                    <span class="fas fa-plus"></span> New Purchase Request
                </a>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="New Purchase Request&#10;Add access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-plus mr-0"></span>
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right ml-2 btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Download&#10;Download access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-download mr-0"></span>
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-request">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Type)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Purpose)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Region)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RequestDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Remarks)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-type" class="form-label mb-0">Type</label>
                            <select id="filter-type" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 filter-purpose-container">
                        <div class="form-group">
                            <label for="filter-purpose" class="form-label mb-0">Purpose</label>
                            <select id="filter-purpose" style="width:100%"></select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" style="width:100%"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Request Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="form-label mb-0">Request Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%"></select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-filedby" class="form-label mb-0">Filed By</label>
                            <select id="filter-filedby" class="form-select form-select-sm">
                                <option value="everyone">Everyone</option>
                                <option value="me">Only by Me</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        
        var date_today = new Date();
        var date_month_ago = new Date();
        date_month_ago.setMonth(date_month_ago.getMonth() - 1);

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);
        
        // Load Select2 for Type
        $("#filter-type").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.code + "</strong> " + (repo.text !== repo.code ? "<em class='fw-light'> - " + repo.text + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetTypeOptions2")"
            },
            dropdownParent: $("#filterModal"),
            minimumResultsForSearch: -1
        });

        $("#filter-type").on("select2:select", function () {
            $("#filter-purpose").val(null).trigger("change");
        });

        $("#filter-type").on("select2:unselecting", function (e) {
            $("#filter-purpose").val(null).trigger("change");
        });
        
        // Load Select2 for Purpose
        $("#filter-purpose").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.code + "</strong> " + (repo.text !== repo.code ? "<em class='fw-light'> - " + repo.text + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetPurposeOptions2")",
                data: function (params) {
                    let base = $.fn.select2.defaults.defaults.ajax.data(params);
                    return Object.assign(base, {
                        TypeId: $("#filter-type").val()
                    });
                }
            },
            dropdownParent: $("#filterModal"),
            minimumResultsForSearch: -1
        });
        
        // Load Select2 for Region
        $("#filter-region").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Region")"
            },
            dropdownParent: $('#filterModal'),
            minimumResultsForSearch: -1
        });
        
        // Load Select2 for Status
        $("#filter-status").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return repo.text;
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "PurchaseStatus")"
            },
            dropdownParent: $('#filterModal'),
            minimumResultsForSearch: -1
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            requestDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        };

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            requestDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[5, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            TypeId: "",
            Type: "",
            PurposeId: "",
            Purpose: "",
            RegionId: "",
            Region: "",
            DateFrom: DateForInput(date_month_ago),
            DateTo: DateForInput(date_today),
            FiledBy: "everyone",
            StatusId: "",
            Status: ""
        };

        function checkDTChanged() {
            if(!requestDT) return false;
            
            return JSON.stringify(requestDT.order()) != JSON.stringify(defaultDTState.order) ||
                   requestDT.page.info().start != defaultDTState.page ||
                   requestDT.page.len() != defaultDTState.length ||
                   (requestDT.search() || "") != defaultDTState.search.search ||
                   ($('#filter-type').val() ?? "") != defaultDTState.TypeId ||
                   ($('#filter-purpose').val() ?? "") != defaultDTState.PurposeId ||
                   ($('#filter-region').val() ?? "") != defaultDTState.RegionId ||
                   ($("#filter-from").val() ?? "") != defaultDTState.DateFrom ||
                   ($("#filter-to").val() ?? "") != defaultDTState.DateTo ||
                   ($('#filter-filedby').val() ?? "") != defaultDTState.FiledBy ||
                   ($("#filter-status").val() ?? "") != defaultDTState.StatusId;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
        }

        function resetToDefaultDTFilter() {
            $("#filter-type").val(defaultDTState.TypeId).trigger('change');
            $("#filter-purpose").val(defaultDTState.PurposeId).trigger('change');
            $("#filter-region").val(defaultDTState.RegionId).trigger('change');
            $("#filter-from").val(defaultDTState.DateFrom);
            $("#filter-to").val(defaultDTState.DateTo);
            $("#filter-filedby").val(defaultDTState.FiledBy);
            $("#filter-status").val(defaultDTState.StatusId).trigger('change');
            
            localStorage.removeItem(dt_storage);

            if (requestDT) {
                requestDT.state.clear();
                requestDT.order(defaultDTState.order);
                requestDT.page(defaultDTState.page);
                requestDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        var requestDT = $('.table-request').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                if (checkDTChanged()) {
                    var now = new Date().getTime();
                    var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                    localStorage.setItem(dt_storage, JSON.stringify(dtState));
                } else {
                    localStorage.removeItem(dt_storage);
                }
            },
            stateLoadCallback: function(settings) {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.TypeId = $('#filter-type').val();
                data.Type = $('#filter-type option:selected').text();
                data.PurposeId = $('#filter-purpose').val();
                data.Purpose = $('#filter-purpose option:selected').text();
                data.RegionId = $('#filter-region').val();
                data.Region = $('#filter-region option:selected').text();
                data.FiledBy = $('#filter-filedby').val();
                data.DateFrom = $("#filter-from").val();
                data.DateTo = $("#filter-to").val();
                data.StatusId = $("#filter-status").val();
                data.Status = $('#filter-status option:selected').text();
            },
            stateLoadParams: function (settings, data) {
                if (data.TypeId) {
                    var typeOption = new Option(data.Type, data.TypeId, true, true);
                    $(typeOption).data('data', {
                        id: data.TypeId,
                        text: data.Type
                    });
                    $("#filter-type").append(typeOption).trigger('change');
                }
                if (data.PurposeId) {
                    var purposeOption = new Option(data.Purpose, data.PurposeId, true, true);
                    $(purposeOption).data('data', {
                        id: data.PurposeId,
                        text: data.Purpose
                    });
                    $("#filter-purpose").append(purposeOption).trigger('change');
                }
                if (data.RegionId) {
                    var regionOption = new Option(data.Region, data.RegionId, true, true);
                    $(regionOption).data('data', {
                        id: data.RegionId,
                        text: data.Region
                    });
                    $("#filter-region").append(regionOption).trigger('change');
                }
                $("#filter-from").val(data.DateFrom);
                $("#filter-to").val(data.DateTo);
                $("#filter-filedby").val(data.FiledBy).trigger('change');
                if (data.StatusId) {
                    var statusOption = new Option(data.Status, data.StatusId, true, true);
                    $(statusOption).data('data', {
                        id: data.StatusId,
                        text: data.Status
                    });
                    $("#filter-status").append(statusOption).trigger('change');
                }
            },
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
                data: function (data) {
                    var typeId = $('#filter-type').val();
                    if (typeId) data.TypeId = typeId;

                    var purposeId = $('#filter-purpose').val();
                    if (purposeId) data.PurposeId = purposeId;
                    
                    var regionId = $('#filter-region').val();
                    if (regionId) data.RegionId = regionId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();

                    var statusId = $("#filter-status").val();
                    if (statusId) data.StatusId = statusId;

                    var filedBy = $('#filter-filedby').val();
                    if (filedBy) data.FiledBy = filedBy;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Loading table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "documentNumber", name: "DocumentNumber" },
                { data: "type", name: "Type" },
                { data: "purpose", name: "Purpose" },
                { data: "region", name: "Region" },
                { data: "status", name: "Status" },
                { data: "requestDate", name: "RequestDate" },
                {
                    data: function (data, type, dataToSet) {
                        return data.remarks || "<span class='text-muted'>N/A</span>";
                    },
                    name: "Remarks"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order,
            createdRow: function (row, data, dataIndex) {
                if (data.status.toLowerCase() == 'resubmitted') {
                    $(row).addClass('table-danger');
                    $(row).find("td").addClass('text-muted');
                } else if (data.status.toLowerCase() == 'disapproved') {
                    $(row).addClass('table-danger');
                    $(row).find('td:eq(4)').addClass('text-danger');
                } else if (data.status.toLowerCase() == 'approved') {
                    $(row).addClass('table-success');
                    $(row).find('td:eq(4)').addClass('text-success');
                }
            }
        });

        requestDT.on("draw", function () {
            checkDefaultFilter();
        });

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-type").val()) { urlQuery.push("TypeId=" + $("#filter-type").val()); }
                if ($("#filter-purpose").val()) { urlQuery.push("PurposeId=" + $("#filter-purpose").val()); }
                if ($("#filter-region").val()) { urlQuery.push("RegionId=" + $("#filter-region").val()); }
                if ($("#filter-status").val()) { urlQuery.push("StatusId=" + $("#filter-status").val()); }

                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());


                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }
    </script>
}