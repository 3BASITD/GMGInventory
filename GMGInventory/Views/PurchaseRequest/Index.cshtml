                if (!data.some(x => x.id === "" || x.id === null)) {
                    data.unshift({ id: "", text: "" });
                }
                $("#filter-type").select2(
                    $.extend(true, {}, select2FilterConfig, { 
                        data: data 
                    })
                ).on("change", function () {
                    loadPurposeOptions();
                });
            },
            complete: function (xhr, status) {
                loadPurposeOptions();
                hideBatchLoader("type");
                //loadedSelectOptions.TypeDoneLoading = true;
            }
        });

        // Load request purpose data for select2
        function loadPurposeOptions() {
            if ($("#filter-purpose").attr("data-select2-id")) {
                $("#filter-purpose").select2("destroy");
                $("#filter-purpose").empty();
            }
            var typeText = $("#filter-type").select2("data")[0]?.text.toLowerCase() || "";
