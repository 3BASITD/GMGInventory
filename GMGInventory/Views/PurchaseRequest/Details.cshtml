            function clearItemForm() {
                // if(itemDT.rows().data().length > 0) {
                //     $("#add-so-number").val(itemDT.rows().data()[0].salesOrderId).trigger("change");
                //     //$("#add-so-number").prop("disabled", true);
                // } else {
                //     $("#add-so-number").val("").trigger("change");
                //     //$("#add-so-number").prop("disabled", false);
                // }
                $("#add-code").val("").trigger("change");
                $("#add-part").val("");
                $("#add-name").val("");
                $("#add-quantity").val("0");
                $("#add-quantity").attr("data-max-quantity", "1999999");
                $("#add-have-stock").prop("checked", false);
                $("#add-stock").val("0");
                $("#add-unit").val("");
                $("#add-unit2").val("").trigger("change");
                $("#add-unit").data("Id", "");
                $("#add-purpose").val("");
            }

            function ComputeTotalQuantity() {
                total_quantity = 0;
                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if (pr_status.toLowerCase() == "draft") {
                        total_quantity += parseInt($(this.node()).find(".quantity").val());
                    } else {
                        total_quantity += this.data().quantityD;
                    }
                });
                $(".total-quantity").html(FormatStringInteger(total_quantity));
            }

            function GetItemsToRequest() {
                var item_to_request = [];
                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                    row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));
                    row_data.stockOnHandD = parseInt($(this.node()).find(".stock").val());
                    row_data.stockOnHand = FormatStringInteger(parseInt($(this.node()).find(".stock").val()));
                    item_to_request.push(row_data);
                });
                return item_to_request;
            }

            // Validation for Add Item Modal
            var validateAdd = $("#form-item").validate({
                rules: {
                    SONumber: {
                        required: function () { return checkIfRequired("SONumber"); }
                    },
                    Code: {
                        required: function () { return checkIfRequired("Code"); }
                    },
                    Name: {
                        required: function () { return checkIfRequired("Name"); },
                        maxlength: 250
                    },
                    // Stock: {
                    //     number: true
                    // },
                    Quantity: {
                        required: function () { return checkIfRequired("Quantity"); },
                        number: true,
                        isNotZero: true,
                        // max: function () {
                        //     const maxValue = parseFloat($("#add-quantity").attr("data-max-quantity")) || 0;
                        //     return maxValue;
                        // }
                    },
                    Purpose: {
                        required: function () { return checkIfRequired("Purpose"); },
                        maxlength: 100
                    }
                },
                messages: {
                    SONumber: {
                        required: "Please select a SO Number."
                    },
                    Code: {
                        required: "Please select an Item."
                    },
                    Name: {
                        required: "Please enter the name of item.",
                        maxlength: "Name must not exceed 250 characters."
                    },
                    // Stock: {
                    //     number: "Please enter a valid number."
                    // },
                    Quantity: {
                        required: "Please enter a quantity.",
                        number: "Please enter a valid number.",
                        isNotZero: "Can not request an item with 0 quantity.",
                        // max: function () {
                        //     const maxValue = parseFloat($("#add-quantity").attr("data-max-quantity")) || 0;
                        //     return "Cannot exceed " + maxValue + " unserved quantity.";
                        // }
                    },
                    Purpose: {
                        required: "Please enter the purpose.",
                        maxlength: "Purpose must not exceed 100 characters."
                    }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    AddItem();
                }
            });

            function AddItem() {
                var rowIndexes = [];
                itemDT.rows(function (idx, data, node) {
                        if (data.itemDescription == $("#add-name").val() && data.salesOrderNumber == $("#add-so-number").select2("data")[0].text) {
                        rowIndexes.push(idx);
                    }
                    return false;
                });
                if (rowIndexes.length > 0) {
                    var soMatch = data.salesOrderNumber != "" && data.salesOrderNumber == $("#add-so-number").select2("data")[0].text ? " of " + data.salesOrderNumber : "";
                    toastr.error($("#add-name").val() + soMatch + " has already been added", "Duplicate");
                } else {
                    itemDT.row.add({
                        customer: $("#add-so-customer").val(),
                        haveStock: $("#add-have-stock").prop("checked"),
                        itemCode: $("#add-code").select2("data")[0].text,
                        itemDescription: $("#add-name").val(),
                        itemPartNumber: $("#add-part").val(),
                        itemId: $("#add-code").select2("data")[0].id,
                        lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                        poNumber: $("#add-so-number").select2("data")[0].purchaseOrder,
                        purchaseRequestId: 0,
                        purpose: $("#add-purpose").val(),
                        quantity: FormatStringInteger($("#add-quantity").val()),
                        quantityD: $("#add-quantity").val() || 0,
                        maxQuantityD: $("#add-quantity").attr("data-max-quantity") || 1999999,
                        salesOrderId: $("#add-so-number").select2("data")[0].id,
                        salesOrderNumber: $("#add-so-number").select2("data")[0].text,
                        stockOnHand: FormatStringInteger($("#add-stock").val()),
                        stockOnHandD: $("#add-stock").val() || 0,
                        unitCode: $("#add-unit").val(),
                        unitId: $("#add-unit").data("Id")
                    }).draw();

                    toastr.success("Added " + $("#add-name").val() + " on Purchase Request Item(s)", "Success");

                    clearItemForm();
                }
            }

            function AddSOItem() {
                var rowsToAdd = soDT.rows().data().toArray().filter(function(row) {
                    return row.toRequest == true;
                });

                var duplicateRows = [];
                var zeroRows = [];
                var invalidQuantityRows = [];
                var successRows = [];
                rowsToAdd.forEach(function (row) {
                    var soRow = {
                        customer: $("#addso-customer").val(),
                        haveStock: row.inventoryCountD > 0,
                        itemCode: row.itemCode,
                        itemDescription: row.itemName,
                        itemPartNumber: row.partNumber,
                        itemId: row.itemId,
                        lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                        poNumber: $("#add-so-number").select2("data")[0].purchaseOrder,
                        purchaseRequestId: 0,
                        purpose: "",
                        quantity: FormatStringInteger(row.requestQuantityD),
                        quantityD: row.requestQuantityD,
                        maxQuantityD: row.remainingQuantityD,
                        salesOrderId: $("#addso-so-number").select2("data")[0].id,
                        salesOrderNumber: $("#addso-so-number").select2("data")[0].text,
                        stockOnHand: row.inventoryCount,
                        stockOnHandD: row.inventoryCountD,
                        unitCode: row.unit,
                        unitId: row.unitId
                    };

                    var exists = itemDT.rows().data().toArray().some(function(r) {
                        return r.salesOrderId == soRow.salesOrderId && r.itemId == soRow.itemId;
                    });

                    if (exists){
                        duplicateRows.push(soRow.itemDescription + " of " + soRow.salesOrderNumber);
                    } else if (soRow.quantityD == 0) {
                        zeroRows.push(soRow.itemDescription);
                    } else if (soRow.quantityD < 0) {
                        invalidQuantityRows.push(soRow.itemDescription);
                    } else {
                        itemDT.row.add(soRow);
                        successRows.push(soRow.itemDescription);
                    }
                });

                if (duplicateRows.length)
                    toastr.warning("<ul><li>" + duplicateRows.join("</li><li>") + "</li></ul>", "DUPLICATE: The following item(s) are already added");
                if (zeroRows.length)
                    toastr.error("<ul><li>" + zeroRows.join("</li><li>") + "</li></ul>", "ERROR: The following item(s) have 0 quantity");
                if (invalidQuantityRows.length)
                    toastr.error("<ul><li>" + invalidQuantityRows.join("</li><li>") + "</li></ul>", "ERROR: The following item(s) have invalid quantity");
                if (successRows.length)
                    toastr.success("<ul><li>" + successRows.join("</li><li>") + "</li></ul>", "SUCCESS: The following item(s) have successfully added on Purchase Request Item(s)");

                itemDT.draw();
            }

            $(".btn-details-save").on("click", function () {
                SaveRequest("Draft");
            });

            $(".btn-details-submit").on("click", function () {
                SaveRequest("Submitted");
            });

            function SaveRequest(status) {
                var items = itemDT.data();
                if (items.length == 0) {
                    toastr.warning("No item to request. Add an item to the list to continue", "Warning");
                } else if (items.filter(s => parseInt(s.quantityD) == 0).length > 0) {
                    toastr.warning("Some items have 0 quantity. Can't request an item with 0 quantity", "Warning");
                } else if (items.filter(s => parseInt(s.quantityD) > parseInt(s.maxQuantityD)).length > 0) {
                    //toastr.warning("Some items have invalid quantity.", "Warning");
                    swal({
                        title: "Purchase Request Quantity",
                        text: "Some of the quantity has exceeded unserved quantity. Continue to " + (status == "Submitted" ? "submit" : "save") + " this purchase request?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm != null) {
                            DoSaveRequest(status);
                        }
                    });
                } else {
                    DoSaveRequest(status);
                }
            }

            function DoSaveRequest(status) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveItemsJson")",
                    data: {
                        Id: request_data.id,
                        status: status,
                        items: GetItemsToRequest()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Success") {
                            window.location.reload();
                        } else {
                            toastr.error(data.message, data.status);
                        }
                    }
                });
            }
        }

        if (user_access.canApproveDisapprove) {
            $('.btn-details-approve').click(function (e) {
                var btnapproverNumber = $(this).data("approver-number");
                swal({
                    title: "Approve Purchase Request",
                    text: "Continue to approve this purchase request?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("ApproveJson")",
                            type: "POST",
                            data: {
                                Id: request_data.id,
                                approverNumber: btnapproverNumber
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });

            $('.btn-details-disapprove').click(function (e) {
                swal({
                    title: "Disapprove Purchase Request",
                    text: "Continue to disapprove this purchase request?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                    content: {
                        element: "input",
                        attributes: {
                            placeholder: "Reason for Disapproving",
                            type: "text"
                        }
                    }
                }).then((confirm) => {
                    if (confirm != null) {
                        $.ajax({
                            url: "@Url.Action("DisapproveJson")",
                            type: "POST",
                            data: {
                                Id: request_data.id,
                                reason: confirm
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });
        }

        if (user_access.canDelete) {
            $(".btn-details-delete").on("click", function () {
                swal({
                    title: "Delete Purchase Request",
                    text: "Continue to delete this purchase request?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm != null) {
                        $.ajax({
                            url: "@Url.Action("DeleteJson")",
                            type: "POST",
                            data: { Id: request_data.id },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                var print_company = $(this).data("company");
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintDetails")/' + request_data.id + '?Company=' + print_company, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
}
