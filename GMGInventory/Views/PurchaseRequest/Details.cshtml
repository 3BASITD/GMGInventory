@model PurchaseRequestDetailedVM

@{
    ViewData["Title"] = "Purchase Request Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseRequest" asp-action="Index">Purchase Requests</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <div class="dropdown float-right ml-2">
                    <button class="btn btn-info btn-sm dropdown-toggle" type="button" id="dropdownMenuPrint" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="fas fa-print"></span> Print
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuPrint">
                        <li><a class="dropdown-item btn-details-print" data-company="GMG">Use GMG Logo</a></li>
                        <li><a class="dropdown-item btn-details-print" data-company="BAS">Use BAS Logo</a></li>
                    </ul>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-info btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Print access is required." data-microtip-position="bottom-left" role="tooltip">
                    <span class="fas fa-print"></span> Print
                </button>
            }
            @if (Model.Status.ToLower() == "draft")
            {
                @if (userAccess.CanEdit)
                {
                    <button type="button" class="btn btn-secondary btn-sm float-right ml-2 btn-details-save">
                        <span class="fas fa-save"></span> Save as Draft
                    </button>
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2 btn-details-submit">
                        <span class="fas fa-paper-plane"></span> Submit
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-save"></span> Save as Draft
                    </button>
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-paper-plane"></span> Submit
                    </button>
                }
            }
            else if (Model.Status.ToLower() == "submitted"
            && (string.IsNullOrWhiteSpace(Model.ApprovedBy1)
            || (string.IsNullOrWhiteSpace(Model.ApprovedBy2) && Model.Type.ToLower() == "non-automotive")))
            {
                @if (userAccess.CanApproveDisapprove)
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 btn-details-approve">
                        <span class="fas fa-check"></span> Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-disapprove">
                        <span class="fas fa-times"></span> Disapprove
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Approve / Disapprove access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-check"></span> Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-times"></span> Disapprove
                    </button>
                }
            }
            else if (Model.Status.ToLower() == "disapproved"
            && !string.IsNullOrWhiteSpace(Model.DisapprovedBy)
            && Model.ResubmitId == null)
            {
                @if (userAccess.CanAdd)
                {
                    <a href="@Url.Action("Create")/@Model.Id" class="btn btn-primary btn-sm float-right ml-2">
                        <span class="fas fa-edit"></span> Update to Resubmit
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Add access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-edit"></span> Update to Resubmit
                    </button>
                }
            }
            @* else if (Model.Status.ToLower() == "approved")
            {
                <a href="@Url.Action("Create", "PurchaseOrder")/@Model.Id" class="btn btn-primary btn-sm float-right ml-2">
                    <span class="fas fa-box-open"></span> Start Order
                </a>
            } *@
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy) || Model.ResubmitFromId != null)
        {
            <div class="row">
                @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                {
                    <div class="col-12">
                        <div class="alert alert-danger text-sm" role="alert">
                            <strong>Reason of Disapproval:</strong>
                            @(string.IsNullOrWhiteSpace(Model.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                        </div>
                    </div>
                }
                @if (Model.ResubmitId != null || Model.ResubmitFromId != null)
                {
                    <div class="col-12">
                        <div class="alert alert-info text-sm" role="alert">
                            <strong>Resubmit Details:</strong>
                            @if (Model.ResubmitId != null)
                            {
                                <div>This has been resubmitted. You can view the new one <a href="@Url.Action("Details", "PurchaseRequest", new {Id = Model.ResubmitId})" class="alert-link">here</a>.</div>
                            }
                            @if (Model.ResubmitFromId != null)
                            {
                                <div>This is a resubmission. You can view the previous one <a href="@Url.Action("Details", "PurchaseRequest", new {Id = Model.ResubmitFromId})" class="alert-link">here</a>.</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </span>
                    <b class="d-block">
                        @Model.DocumentNumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Type)
                    </span>
                    <b class="d-block">
                        @Model.Type
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Purpose)
                    </span>
                    <b class="d-block">
                        @Model.Purpose
                    </b>
                </p>
            </div>
            @if (Model.Type.ToLower() == "automotive" && Model.Purpose.ToLower() == "rush order")
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Region)
                        </span>
                        <b class="d-block">
                            @Model.Region
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.RequestDate)
                    </span>
                    <b class="d-block">
                        @Model.RequestDate
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model.Remarks) ? "N/A" : Model.Remarks)
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy1))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedBy1)
                        </span>
                        <b class="d-block">
                            @Model.ApprovedBy1
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy2))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedBy2)
                        </span>
                        <b class="d-block">
                            @Model.ApprovedBy2
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DisapprovedBy)
                        </span>
                        <b class="d-block">
                            @Model.DisapprovedBy
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Status)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model.Status
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model.UserCreated
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model.DateCreated
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.UserModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserModified)
                        </span>
                        <b class="d-block">
                            @Model.UserModified
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DateModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block">
                            @Model.DateModified
                        </b>
                    </p>
                </div>
            }
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Purchase Request Item(s)</span>
                        @if (Model.Status.ToLower() == "draft" && userAccess.CanAdd)
                        {
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Item
                                </button>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>#</th>
                                    <th>SO Number</th>
                                    <th>PO Number</th>
                                    <th>Customer</th>
                                    <th>Item Code</th>
                                    <th>Part Number</th>
                                    <th>Item Name</th>
                                    <th>Stock on Hand</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Purpose</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th class="total-quantity">0</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="po-status" value="@Model.Status" />

@if (userAccess.CanAdd)
{
    <!-- Purchase Request Item Modal -->
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Purchase Request Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12 col-sm-6 add-so-number-container">
                                <div class="form-group">
                                    <label for="add-so-number" class="form-label mb-0">SO Number</label>
                                    <select id="add-so-number" name="SONumber" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-so-number-container">
                                <div class="form-group">
                                    <label for="add-so-customer" class="form-label mb-0">Customer</label>
                                    <input type="text" id="add-so-customer" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-code-container">
                                <div class="form-group">
                                    <label for="add-code" class="form-label mb-0">Item Code</label>
                                    <select id="add-code" name="Code" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-part-container">
                                <div class="form-group">
                                    <label for="add-part" class="form-label mb-0">Part Number</label>
                                    <input type="text" id="add-part" name="PartNumber" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-name-container">
                                <div class="form-group">
                                    <label for="add-name" class="form-label mb-0">Item Name</label>
                                    <input type="text" id="add-name" name="Name" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-stock-container">
                                <div class="form-group">
                                    <label for="add-stock" class="form-label mb-0">Stock on Hand</label>
                                    <input type="number" min="0" max="1999999" step="1" id="add-stock" name="Stock" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-quantity-container">
                                <div class="form-group">
                                    <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                    <input type="number" min="0" max="1999999" data-max-quantity="2999999" step="1" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                    <label class="text-warning text-xs fw-lighter fst-italic m-0 add-quantity-warning"></label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-unit-container">
                                <div class="form-group">
                                    <label for="add-unit" class="form-label mb-0">Unit</label>
                                    <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-unit2-container">
                                <div class="form-group">
                                    <label for="add-unit2" class="form-label mb-0">Unit</label>
                                    <div>
                                        <select id="add-unit2" style="width: 100%;">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 add-purpose-container">
                                <div class="form-group">
                                    <label for="add-purpose" class="form-label mb-0">Purpose</label>
                                    <input type="text" id="add-purpose" name="Purpose" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-add">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var request_data = @Html.Raw(Json.Serialize(Model));
        var pr_status = request_data.status;
        var request_type = request_data.type;
        var request_purpose = request_type.toLowerCase() == "maintenance & repair" ? "" : request_data.purpose;

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemListJson")",
                data: { purchaseRequestId: request_data.id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (user_access.canEdit && pr_status.toLowerCase() == "draft") {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top" role="tooltip"><span class="fas fa-minus"></span></button>';
                            actions += '<button type="button" class="btn btn-info btn-xs btn-up-item" data-microtip-title="Move Up Item" data-microtip-position="top" role="tooltip"><span class="fas fa-arrow-up"></span></button>';
                            actions += '<button type="button" class="btn btn-info btn-xs btn-down-item" data-microtip-title="Move Down Item" data-microtip-position="top" role="tooltip"><span class="fas fa-arrow-down"></span></button>';
                        }
                        return actions + '</div>';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                { data: "salesOrderNumber", name: "SalesOrderNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.poNumber == null) {
                            return "<em class='text-muted'>N/A</em>";
                        } else {
                            return data.poNumber;
                        }
                    },
                    name: "PONumber",
                    className: "form-cell" },
                { data: "customer", name: "Customer", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "-";
                        } else {
                            return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="bottom-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><span class="fas fa-info-circle text-info"></span></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemPartNumber", name: "ItemPartNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (pr_status.toLowerCase() == "draft" && request_type.toLowerCase() == "non-automotive" && request_purpose.toLowerCase() == "one-time purchase") {
                            if (data.itemDescription == "") {
                                return '<textarea class="form-control form-control-sm expandable-textarea description is-invalid" style="width: 100%;">' + data.itemDescription + '</textarea><label class="text-danger text-xs fw-lighter fst-italic m-0">Item description is required.</label>';
                            } else if (data.itemDescription.length > 100) {
                                return '<textarea class="form-control form-control-sm expandable-textarea description is-invalid" style="width: 100%;">' + data.itemDescription + '</textarea><label class="text-danger text-xs fw-lighter fst-italic m-0">Item description must not exceed 100 characters.</label>';
                            } else {
                                return '<textarea class="form-control form-control-sm expandable-textarea description" style="width: 100%;">' + data.itemDescription + '</textarea>';
                            }
                        } else {
                            return data.itemDescription;
                        }
                    },
                    name: "ItemDescription",
                    className: "form-cell"
                },
                { data: "stockOnHand", name: "StockOnHand", className: "form-cell text-end" },
                {
                    data: function (data, type, dataToSet) {
                        if (user_access.canEdit && pr_status.toLowerCase() == "draft") {
                            var soMax = checkIfRequired("SONumber") ? data.maxQuantityD : 1999999;
                            if (data.quantityD > soMax) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-warning" style="width: 100%;" /><label class="text-warning text-xs fw-lighter fst-italic m-0">Requesting higher than ' + soMax + ' unserved quantity.</label>';
                            } else if (data.quantityD == 0) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Nothing to request.</label>';
                            } else {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                            }
                        } else {
                            return data.quantity;
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end a"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                { data: "purpose", name: "Purpose", className: "form-cell" }
            ],
            order: [[1, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 9);
            }
        });

        itemDT.on("draw", function () {
            updateColumnVisibility();

            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            if (pr_status.toLowerCase() == "draft" && request_type.toLowerCase() == "non-automotive" && request_purpose.toLowerCase() == "one-time purchase") {
                $(".description").off("change").on("change", function () {
                    var row = itemDT.row($(this).closest('tr'));
                    var rowData = row.data();

                    rowData.itemDescription = $(row.node()).find(".description").val();

                    row.data(rowData).draw(false);
                });
            }

            if(checkIfRequired("SONumber") && itemDT.rows().data().length > 0) {
                var selectedOption = new Option(itemDT.rows().data()[0].salesOrderNumber, itemDT.rows().data()[0].salesOrderId, true, true);
                $("#add-so-number").append(selectedOption).trigger('change');
                $("#add-so-customer").val(itemDT.rows().data()[0].customer);
                console.log(itemDT.rows().data()[0].customer)
            }

            $(".quantity").off("change").on("change", function () {
                var row = itemDT.row($(this).closest('tr'));
                var rowData = row.data();

                var quantityValue = parseFloat($(row.node()).find(".quantity").val()) || 0;
                rowData.quantity = FormatStringInteger(quantityValue);
                rowData.quantityD = quantityValue;

                row.data(rowData).draw(false);
            });

            if (user_access.canAdd) {
                $(".btn-remove-item").off("click").on("click", function () {
                    itemDT.row($(this).parents('tr')).remove().draw();
                });

                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var rowData = this.data();
                    if (rowData.lineNumber == 1)
                        $(this.node()).find(".btn-up-item").hide();
                    else
                        $(this.node()).find(".btn-up-item").show();

                    if (rowData.lineNumber == Math.max.apply(Math, itemDT.column(1).data().toArray()))
                        $(this.node()).find(".btn-down-item").hide();
                    else
                        $(this.node()).find(".btn-down-item").show();
                });

                $(".btn-up-item").off("click").on("click", function () {
                    var row = $(this).parents('tr');
                    var rowData = itemDT.row(row).data();

                    var currentLineNumber = rowData.lineNumber;
                    var newLineNumber = currentLineNumber - 1;

                    var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                        return itemDT.row(index).data().lineNumber == newLineNumber;
                    });

                    if (targetRowIndex != undefined) {
                        var targetRowData = itemDT.row(targetRowIndex).data();
                        targetRowData.lineNumber = currentLineNumber;
                        itemDT.row(targetRowIndex).data(targetRowData);
                    }

                    rowData.lineNumber = newLineNumber;
                    itemDT.row(row).data(rowData);

                    itemDT.order([1, 'asc']).draw();
                });

                $(".btn-down-item").off("click").on("click", function () {
                    var row = $(this).parents('tr');
                    var rowData = itemDT.row(row).data();
                    var currentLineNumber = rowData.lineNumber;
                    var newLineNumber = currentLineNumber + 1;

                    var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                        return itemDT.row(index).data().lineNumber == newLineNumber;
                    });

                    if (targetRowIndex != undefined) {
                        var targetRowData = itemDT.row(targetRowIndex).data();
                        targetRowData.lineNumber = currentLineNumber;
                        itemDT.row(targetRowIndex).data(targetRowData);
                    }

                    rowData.lineNumber = newLineNumber;
                    itemDT.row(row).data(rowData);

                    itemDT.order([1, 'asc']).draw();
                });

                ComputeTotalQuantity();
                $(".quantity").on("input", function () {
                    ComputeTotalQuantity();
                });
            }
        });

        var columnVisibilityMap = {
            "automotive_rush order": [true, true, true, true, true, true, true, true, true, false],
            "automotive_stocking": [false, false, false, true, true, true, true, true, true, false],
            "non-automotive_office supplies": [false, false, false, true, false, true, true, true, true, false],
            "non-automotive_one-time purchase": [false, false, false, false, false, true, false, true, true, true],
            "maintenance & repair_": [false, false, false, false, false, true, false, true, true, true]
        };

        function updateColumnVisibility() {
            var key = (request_type + "_" + request_purpose).toLowerCase();

            if (columnVisibilityMap[key]) {
                columnVisibilityMap[key].forEach(function (visible, index) {
                    itemDT.column(index + 2).visible(visible);
                });

                $(".add-so-number-container").toggle(columnVisibilityMap[key][0]);
                if (columnVisibilityMap[key][3]) {
                    $(".add-code-container").toggle(true);
                    $("#add-name").prop("readonly", true);
                    $(".add-unit-container").toggle(true);
                    $(".add-unit2-container").toggle(false);
                } else {
                    $(".add-code-container").toggle(false);
                    $("#add-name").prop("readonly", false);
                    $(".add-unit-container").toggle(false);
                    $(".add-unit2-container").toggle(true);
                }
                $(".add-part-container").toggle(columnVisibilityMap[key][4]);
                $(".add-name-container").toggle(columnVisibilityMap[key][5]);
                $(".add-stock-container").toggle(columnVisibilityMap[key][6]);
                // $(".add-quantity-container").toggle(columnVisibilityMap[key][7]);
                // $(".add-unit-container").toggle(columnVisibilityMap[key][8]);
                $(".add-purpose-container").toggle(columnVisibilityMap[key][9]);
            }
        }

        function checkIfRequired(name) {
            var key = (request_type + "_" + request_purpose).toLowerCase();
            if (name == "SONumber") return columnVisibilityMap[key][0];
            else if (name == "Code") return columnVisibilityMap[key][3];
            else if (name == "Name") return columnVisibilityMap[key][5];
            else if (name == "Quantity") return columnVisibilityMap[key][7];
            else if (name == "Purpose") return columnVisibilityMap[key][9];
            else return false;
        }

        if (user_access.canAdd) {
            loadAllItemsOptions();
            function loadAllItemsOptions() {
                if ($.fn.select2 && $("#add-code").hasClass("select2-hidden-accessible")) {
                    $("#add-code").select2("destroy");
                    $("#add-code").empty();
                }
                // Load item for select2
                $("#add-code").select2({
                    minimumInputLength: -1,
                    allowClear: true,
                    placeholder: "<empty>",
                    templateResult: function (repo) {
                        if (repo.loading) {
                            return repo.text;
                            }
                        return $(
                            "<strong>" + repo.text + "</strong> " +
                            (repo.text != repo.name
                                ? "<em class='fw-light'> - " + repo.name + "</em>"
                                : "") +
                            "<br />" +
                            "<small class='text-muted'>" +
                            (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                            (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                            "Unserved Quantity: " + repo.quantity + " " + repo.unit + "<br />" +
                            "</small>");
                    },
                    ajax: {
                        url: "@Url.Action("GetOptions", "Item")",
                        data: function (params) {
                            let base = $.fn.select2.defaults.defaults.ajax.data(params);
                            return Object.assign(base, {
                                SalesOrderId: $("#add-so-number").val()
                            });
                        },
                        complete: AssignItemEvent
                    },
                    dropdownParent: $("#addModal")
                });
            }

            function loadSOItemsOptions() {
                $("#add-so-customer").val($("#add-so-number").select2("data")[0].customerName);
                $("#add-code").val(null).trigger("change");
                $("#add-part").val("");
                $("#add-name").val("");
                $("#add-stock").val(0);
                $("#add-quantity").val(0);
                $("#add-quantity").attr("data-max-quantity", "1999999");
                $(".add-quantity-warning").toggle(false);
                $(".add-quantity-warning").text("");
                $("#add-unit").val("");

                if ($.fn.select2 && $("#add-code").hasClass("select2-hidden-accessible")) {
                    $("#add-code").select2("destroy");
                    $("#add-code").empty();
                }
                // Load item for select2
                $("#add-code").select2({
                    minimumInputLength: -1,
                    allowClear: true,
                    placeholder: "<empty>",
                    templateResult: function (repo) {
                        if (repo.loading) {
                            return repo.text;
                        }
                        return $(
                            "<strong>" + repo.text + "</strong> " +
                            (repo.text != repo.name
                                ? "<em class='fw-light'> - " + repo.name + "</em>"
                                : "") +
                            "<br />" +
                            "<small>" +
                            "Unserved Quantity: " + repo.quantity + " " + repo.unit + "<br />" +
                            "</small>");
                    },
                    ajax: {
                        url: "@Url.Action("GetUnservedOptions", "Item")",
                        data: function (params) {
                            let base = $.fn.select2.defaults.defaults.ajax.data(params);
                            return Object.assign(base, {
                                SalesOrderId: $("#add-so-number").val()
                            });
                        },
                        complete: AssignItemEvent
                    },
                    dropdownParent: $("#addModal")
                });
            }

            function AssignItemEvent(jqXHR, textStatus) {
                $("#add-code").off("select2:select").on("select2:select", function () {
                    $("#add-part").val($("#add-code").select2("data")[0].partNumber);
                    $("#add-name").val($("#add-code").select2("data")[0].name);
                    $("#add-unit").val($("#add-code").select2("data")[0].unit);
                    $("#add-unit").data("Id", $("#add-code").select2("data")[0].unitId);
                    $("#add-stock").val($("#add-code").select2("data")[0].inventoryCount);
                    if (checkIfRequired("SONumber")) {
                        $("#add-quantity").val($("#add-code").select2("data")[0].quantityD);
                        $("#add-quantity").attr("data-max-quantity", $("#add-code").select2("data")[0].quantityD);
                    } else {
                        $("#add-quantity").val("0");
                        $("#add-quantity").attr("data-max-quantity", "1999999");
                    }
                    $("#add-code-error").html("");
                });

                $("#add-code").off("select2:unselecting").on("select2:unselecting", function (e) {
                    $("#add-part").val("");
                    $("#add-name").val("");
                    $("#add-unit").val("");
                    $("#add-unit").data("Id", "");
                    $(".add-stocks").text("0");
                    $("#add-quantity").val("0");
                    $("#add-quantity").attr("data-max-quantity", "1999999");
                    $(".add-quantity-warning").toggle(false);
                    $(".add-quantity-warning").text("");
                    $("#add-gross-price").val("0.00");
                });
            }

            $("#add-quantity").on("change", function() {
                var quantity = parseInt($(this).val());
                var max_quantity = parseInt($(this).attr("data-max-quantity"));
                console.log(quantity + " " + max_quantity)
                if(quantity > max_quantity) {
                    $(".add-quantity-warning").toggle(true);
                    $(".add-quantity-warning").text("Requesting higher than " + max_quantity + " unserved quantity.");
                } else {
                    $(".add-quantity-warning").toggle(false);
                    $(".add-quantity-warning").text("");
                }
            });

            // Load so for select2
            $("#add-so-number").select2({
                minimumInputLength: -1,
                allowClear: true,
                placeholder: "<empty>",
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $(`
                        <strong>${repo.text}</strong><br />
                        <small>Customer: ${repo.customerName}</small><br />
                        <small>Purchase Order: ${repo.purchaseOrder || "<em class='text-muted'>N/A</em>"}</small>`);
                },
                ajax: {
                    url: "@Url.Action("GetSalesOrderUnservedOnlyOptions", "SalesOrder")",
                    data: function (params) {
                        let base = $.fn.select2.defaults.defaults.ajax.data(params);
                        return Object.assign(base, {
                            regionId: request_data.regionId
                        });
                    }
                },
                dropdownParent: $("#addModal")
            });

            $("#add-so-number").on("select2:select", loadSOItemsOptions);

            // Load unit for select2
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Unit")",
                success: function (data, status, xhr) {
                    $("#add-unit2").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        minimumResultsForSearch: -1,
                        placeholder: "<empty>",
                        dropdownParent: $("#addModal")
                    }).on("change", function () {
                        $("#add-unit").val($("#add-unit2").select2("data")[0].text);
                        $("#add-unit").data("Id", $("#add-unit2").select2("data")[0].id);
                    });
                }
            });

            $(".createBtn").on("click", clearItemForm);

            function clearItemForm() {
                // if(itemDT.rows().data().length > 0) {
                //     $("#add-so-number").val(itemDT.rows().data()[0].salesOrderId).trigger("change");
                //     //$("#add-so-number").prop("disabled", true);
                // } else {
                //     $("#add-so-number").val("").trigger("change");
                //     //$("#add-so-number").prop("disabled", false);
                // }
                //$("#add-so-customer").val("");
                $("#add-code").val("").trigger("change");
                $("#add-part").val("");
                $("#add-name").val("");
                $("#add-quantity").val("0");
                $("#add-quantity").attr("data-max-quantity", "1999999");
                $("#add-stock").val("0");
                $("#add-unit").val("");
                $("#add-unit2").val("").trigger("change");
                $("#add-unit").data("Id", "");
                $("#add-purpose").val("");
            }

            function ComputeTotalQuantity() {
                total_quantity = 0;
                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if (pr_status.toLowerCase() == "draft") {
                        total_quantity += parseInt($(this.node()).find(".quantity").val());
                    } else {
                        total_quantity += this.data().quantityD;
                    }
                });
                $(".total-quantity").html(FormatStringInteger(total_quantity));
            }

            function GetItemsToRequest() {
                var item_to_request = [];
                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                    row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));
                    row_data.stockOnHandD = parseInt($(this.node()).find(".stock").val());
                    row_data.stockOnHand = FormatStringInteger(parseInt($(this.node()).find(".stock").val()));
                    item_to_request.push(row_data);
                });
                return item_to_request;
            }

            // Validation for Add Item Modal
            var validateAdd = $("#form-item").validate({
                rules: {
                    SONumber: {
                        required: function () { return checkIfRequired("SONumber"); }
                    },
                    Code: {
                        required: function () { return checkIfRequired("Code"); }
                    },
                    Name: {
                        required: function () { return checkIfRequired("Name"); },
                        maxlength: 250
                    },
                    // Stock: {
                    //     number: true
                    // },
                    Quantity: {
                        required: function () { return checkIfRequired("Quantity"); },
                        number: true,
                        isNotZero: true,
                        // max: function () {
                        //     const maxValue = parseFloat($("#add-quantity").attr("data-max-quantity")) || 0;
                        //     return maxValue;
                        // }
                    },
                    Purpose: {
                        required: function () { return checkIfRequired("Purpose"); },
                        maxlength: 100
                    }
                },
                messages: {
                    SONumber: {
                        required: "Please select a SO Number."
                    },
                    Code: {
                        required: "Please select an Item."
                    },
                    Name: {
                        required: "Please enter the name of item.",
                        maxlength: "Name must not exceed 250 characters."
                    },
                    // Stock: {
                    //     number: "Please enter a valid number."
                    // },
                    Quantity: {
                        required: "Please enter a quantity.",
                        number: "Please enter a valid number.",
                        isNotZero: "Can not request an item with 0 quantity.",
                        // max: function () {
                        //     const maxValue = parseFloat($("#add-quantity").attr("data-max-quantity")) || 0;
                        //     return "Cannot exceed " + maxValue + " unserved quantity.";
                        // }
                    },
                    Purpose: {
                        required: "Please enter the purpose.",
                        maxlength: "Purpose must not exceed 100 characters."
                    }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    AddItem();
                }
            });

            function AddItem() {
                var rowIndexes = [];
                itemDT.rows(function (idx, data, node) {
                        if (data.itemDescription == $("#add-name").val() && data.salesOrderNumber == $("#add-so-number").select2("data")[0].text) {
                        rowIndexes.push(idx);
                    }
                    return false;
                });
                if (rowIndexes.length > 0) {
                    var soMatch = data.salesOrderNumber != "" && data.salesOrderNumber == $("#add-so-number").select2("data")[0].text ? " of " + data.salesOrderNumber : "";
                    toastr.warning($("#add-name").val() + soMatch + " has already been added", "Duplicate");
                } else {
                    itemDT.row.add({
                        customer: $("#add-so-customer").val(),
                        itemCode: $("#add-code").select2("data")[0].text,
                        itemDescription: $("#add-name").val(),
                        itemPartNumber: $("#add-part").val(),
                        itemId: $("#add-code").select2("data")[0].id,
                        lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                        poNumber: $("#add-so-number").select2("data")[0].purchaseOrder,
                        purchaseRequestId: 0,
                        purpose: $("#add-purpose").val(),
                        quantity: FormatStringInteger($("#add-quantity").val()),
                        quantityD: $("#add-quantity").val() || 0,
                        maxQuantityD: $("#add-quantity").attr("data-max-quantity") || 1999999,
                        salesOrderId: $("#add-so-number").select2("data")[0].id,
                        salesOrderNumber: $("#add-so-number").select2("data")[0].text,
                        stockOnHand: FormatStringInteger($("#add-stock").val()),
                        stockOnHandD: $("#add-stock").val() || 0,
                        unitCode: $("#add-unit").val(),
                        unitId: $("#add-unit").data("Id")
                    }).draw();

                    toastr.success("Added " + $("#add-name").val() + " on Purchase Request Item(s)", "Success");

                    clearItemForm();
                }
            }

            $(".btn-details-save").on("click", function () {
                SaveRequest("Draft");
            });

            $(".btn-details-submit").on("click", function () {
                SaveRequest("Submitted");
            });

            function SaveRequest(status) {
                var items = itemDT.data();
                if (items.length == 0) {
                    toastr.warning("No item to request. Add an item to the list to continue", "Warning");
                } else if (items.filter(s => parseInt(s.quantityD) == 0).length > 0) {
                    toastr.warning("Some items have 0 quantity. Can't request an item with 0 quantity", "Warning");
                } else if (items.filter(s => parseInt(s.quantityD) > parseInt(s.maxQuantityD)).length > 0) {
                    //toastr.warning("Some items have invalid quantity.", "Warning");
                    swal({
                        title: "Purchase Request Quantity",
                        text: "Some of the quantity has exceeded unserved quantity. Continue to " + (status == "Submitted" ? "submit" : "save") + " this purchase request?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm != null) {
                            DoSaveRequest(status);
                        }
                    });
                } else {
                    DoSaveRequest(status);
                }
            }

            function DoSaveRequest(status) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveItemsJson")",
                    data: {
                        Id: request_data.id,
                        status: status,
                        items: GetItemsToRequest()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Success") {
                            window.location.reload();
                        } else {
                            toastr.error(data.message, data.status);
                        }
                    }
                });
            }
        }

        if (user_access.canApproveDisapprove) {
            $('.btn-details-approve').click(function (e) {
                swal({
                    title: "Approve Purchase Request",
                    text: "Continue to approve this purchase request?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("ApproveJson")",
                            type: "POST",
                            data: { Id: request_data.id },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });

            $('.btn-details-disapprove').click(function (e) {
                swal({
                    title: "Disapprove Purchase Request",
                    text: "Continue to disapprove this purchase request?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                    content: {
                        element: "input",
                        attributes: {
                            placeholder: "Reason for Disapproving",
                            type: "text"
                        }
                    }
                }).then((confirm) => {
                    if (confirm != null) {
                        $.ajax({
                            url: "@Url.Action("DisapproveJson")",
                            type: "POST",
                            data: {
                                Id: request_data.id,
                                reason: confirm
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                var print_company = $(this).data("company");
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintDetails")/' + request_data.id + '?Company=' + print_company, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
}
