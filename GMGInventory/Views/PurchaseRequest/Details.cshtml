                    </div>
                    <div class="col-12 col-md-4 col-sm-6">
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.ApprovedBy2)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy2))
                            {
                                <b class="d-block">@Model.ApprovedBy2</b>
                            }
                            else
                            {
                                <em class="d-block">Waiting</em>
                            }
                        </p>
                    </div>
                }
            }
            else
            { *@
            @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy1))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedBy1)
                        </span>
                        <b class="d-block">
                            @Model.ApprovedBy1
                        </b>
                    </p>
                </div>
            }
            @* } *@
            @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DisapprovedBy)
                        </span>
                        <b class="d-block">
                            @Model.DisapprovedBy
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Status)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model.Status
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model.UserCreated
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
