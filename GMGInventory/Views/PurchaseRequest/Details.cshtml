            function SORowSelectAll() {
                var isChecked = $(".sochkclassorderall").prop("checked");
                soDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    $(this.node()).find(".sochkclassorder").prop("checked", isChecked);

                    var data = this.data();
                    data.toRequest = isChecked;
                    data.requestQuantityD = 0;
                    this.data(data).draw(false);
                });
            }

            function SORowSelect(elem) {
                var tr = $(elem).closest('tr');
                var row = soDT.row(tr);
                var rowData = row.data();

                rowData.toRequest = $(elem).prop("checked");
                rowData.requestQuantityD = 0;

                row.data(rowData).draw(false);

                var rows_checked = 0;
                soDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if ($(this.node()).find(".sochkclassorder").prop("checked")) {
                        rows_checked++;
                    }
                });

                if (rows_checked == soDT.rows().count()) {
                    $(".sochkclassorderall").prop("checked", true);
                    $(".sochkclassorderall").prop("indeterminate", false);
                } else if (rows_checked == 0) {
                    $(".sochkclassorderall").prop("checked", false);
                    $(".sochkclassorderall").prop("indeterminate", false);
                } else {
                    $(".sochkclassorderall").prop("checked", false);
                    $(".sochkclassorderall").prop("indeterminate", true);
