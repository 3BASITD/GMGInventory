                    $("#add-unit").val("");
                    $("#add-unit").data("Id", "");
                    $(".add-stocks").text("0");
                    $("#add-quantity").val("0");
                    $("#add-quantity").attr("data-max-quantity", "1999999");
                    $(".add-quantity-warning").toggle(false);
                    $(".add-quantity-warning").text("");
                    $("#add-gross-price").val("0.00");
