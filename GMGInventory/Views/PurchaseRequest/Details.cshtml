@model PurchaseRequestDetailedVM

@{
    ViewData["Title"] = "Purchase Request Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
    var userAccessAutomotive = (ViewsAccessVM)ViewData["UserAccessAutomotive"]!;
    var userAccessNonAutomotive = (ViewsAccessVM)ViewData["UserAccessNonAutomotive"]!;

    var status = Model.Status.ToLowerInvariant();
    var type = Model.Type.ToLowerInvariant();

    bool isDraft = status == "draft";
    bool isSubmitted = status == "submitted";
    bool isDisapproved = status == "disapproved";

    bool isNonAutomotive = type == "non-automotive";
    bool isAutomotive = type == "automotive";

    bool canAdd = userAccess.CanAdd;
    bool canPrint = userAccess.CanPrint;
    bool canDelete = userAccess.CanDelete && isDraft;
    bool canEdit = userAccess.CanEdit && isDraft;
    bool canApproveDisapprove = (
                                    (isNonAutomotive && userAccessNonAutomotive.CanApproveDisapprove) ||
                                    (isAutomotive && userAccessAutomotive.CanApproveDisapprove) ||
                                    (!isNonAutomotive && !isAutomotive && userAccess.CanApproveDisapprove)
                                ) && isSubmitted;

    bool canRecreate = isDisapproved &&
                       !string.IsNullOrWhiteSpace(Model.DisapprovedBy) &&
                       Model.ResubmitId == null &&
                       canAdd;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseRequest" asp-action="Index">Purchase Requests</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (canPrint)
            {
                <div class="dropdown float-right ml-2">
                    <button class="btn btn-info btn-sm dropdown-toggle" type="button" id="dropdownMenuPrint" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="fas fa-print"></span> Print
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuPrint">
                        <li><a class="dropdown-item btn-details-print" data-company="GMG">Use GMG Logo</a></li>
                        <li><a class="dropdown-item btn-details-print" data-company="BAS">Use BAS Logo</a></li>
                    </ul>
                </div>
            }
            else
            {
                <button type="button"
                        class="btn btn-info btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Print&#10;Print access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-print mr-0"></span>
                </button>
            }
            @if (canDelete)
            {
                <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-delete">
                    <span class="fas fa-trash"></span> Delete
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Delete&#10;@(isDraft ? "Delete access is required" : "Only draft request can be deleted")"
                        data-microtip-position="bottom" role="tooltip">
                    <span class="fas fa-trash mr-0"></span>
                </button>
            }
            @if (canEdit)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 btn-details-save">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="button" class="btn btn-primary btn-sm float-right ml-2 btn-details-submit">
                    <span class="fas fa-paper-plane"></span> Submit
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Save as Draft&#10;@(isDraft ? "Edit access is required" : "Only draft request can be saved as draft")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-save mr-0"></span>
                </button>
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Submit&#10;@(isDraft ? "Edit access is required" : "Only draft request can be submitted")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-paper-plane mr-0"></span>
                </button>
            }
            @if (canApproveDisapprove)
            {
                <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-disapprove">
                    <span class="fas fa-times"></span> Disapprove
                </button>
                <button type="button" class="btn btn-success btn-sm float-right ml-2 btn-details-approve">
                    <span class="fas fa-check"></span> Approve
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Disapprove&#10;@(isSubmitted ? "Approve / Disapprove access is required" : "Only submitted request can be disapproved")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-times mr-0"></span>
                </button>
                <button type="button"
                        class="btn btn-success btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Approve&#10;@(isSubmitted ? "Approve / Disapprove access is required" : "Only submitted request can be approved")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-check mr-0"></span>
                </button>
            }
            @if (canRecreate)
            {
                <a href="@Url.Action("Create")/@Model.Id" class="btn btn-primary btn-sm float-right ml-2">
                    <span class="fas fa-edit"></span> Update to Resubmit
                </a>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title=" Update to Resubmit&#10;@(Model.ResubmitId != null ? "Request already been resubmitted" : canAdd ? "Only disapproved request can be resubmitted" : "Add access is required")"
                        data-microtip-position="bottom"
                        role="tooltip">
                    <span class="fas fa-edit mr-0"></span>
                </button>
            }
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy) || Model.ResubmitFromId != null)
        {
            <div class="row">
                @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                {
                    <div class="col-12">
                        <div class="alert alert-danger text-sm" role="alert">
                            <strong>Reason of Disapproval:</strong>
                            @(string.IsNullOrWhiteSpace(Model.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                        </div>
                    </div>
                }
                @if (Model.ResubmitId != null || Model.ResubmitFromId != null)
                {
                    <div class="col-12">
                        <div class="alert alert-info text-sm" role="alert">
                            <strong>Resubmit Details:</strong>
                            @if (Model.ResubmitId != null)
                            {
                                <div>This has been resubmitted. You can view the new one <a href="@Url.Action("Details", "PurchaseRequest", new { Id = Model.ResubmitId })" class="alert-link">here</a>.</div>
                            }
                            @if (Model.ResubmitFromId != null)
                            {
                                <div>This is a resubmission. You can view the previous one <a href="@Url.Action("Details", "PurchaseRequest", new { Id = Model.ResubmitFromId })" class="alert-link">here</a>.</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </span>
                    <b class="d-block">
                        @Model.DocumentNumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
