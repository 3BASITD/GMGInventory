                                    return '<input type="number" min="0" max="1999999" step="1" value="' + data.requestQuantityD + '" class="form-control form-control-sm soquantity" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Cannot request an item with 0 quantity</label>';
