@model PurchaseOrderDetailsVM

@{
    ViewData["Title"] = "Replenishment Details " + (Model.Status == "Draft" ? " (Draft)" : "");
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Replenish" asp-action="Index">Replenish Orders</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title po-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="button" onclick="SaveReplenish('Replenish')" class="btn btn-primary btn-sm float-right ml-2 btn-details-replenish">
                    <span class="fas fa-sync"></span> Replenish Item
                </button>
                <button type="button" onclick="SaveReplenish('Draft')" class="btn btn-secondary btn-sm float-right ml-2 btn-details-draft">
                    <span class="fab fa-firstdraft"></span> Save as Draft
                </button>
                <button type="button" class="btn btn-primary btn-sm float-right ml-2 btn-details-print">
                    <span class="fas fa-print"></span> Print
                </button>
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Supplier)
                        </span>
                        <b class="d-block">
                            @Model?.Supplier
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Address1)
                        </span>
                        <b class="d-block">
                            @(string.IsNullOrEmpty(Model?.Address1.Trim()) ? "-" : Model.Address1)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Address2)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.Address2.Trim()) ? "-" : Model.Address2)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Destination)
                    </span>
                    <b class="d-block">
                        @Model?.Destination
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </span>
                    <b class="d-block">
                        @Model?.OrderDate
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Currency)
                    </span>
                    <b class="d-block">
                        @Model?.Currency
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CurrencyRate)
                    </span>
                    <b class="d-block">
                        @Model?.CurrencyRate
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OrderBy)
                    </span>
                    <b class="d-block">
                        @Model?.OrderBy
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PONumber)
                    </span>
                    <b class="d-block">
                        @Model?.PONumber
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ReferenceNumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.ReferenceNumber?.Trim()) ? "-" : Model.ReferenceNumber)
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Replenish Item(s)</span>
                        <div class="card-tools">
                            <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                <span class="fas fa-plus"></span> Add Replenish Item
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Unit Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Net Price</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th>Total</th>
                                    <th class="total-quantity">0</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th class="total-net-price">0.00</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="po-status" value="@Model?.Status" />

<!-- Save Replenish Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Replenish Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Code</label>
                                <div>
                                    <select id="add-code" name="Code" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                                <span data-valmsg-for="add-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Name</label>
                                <input type="text" id="add-name" name="Name" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="add-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                <span data-valmsg-for="add-quantity" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit-price" class="form-label mb-0">Unit Price</label>
                                <input type="number" step="0.01" min="0" max="1999999.99" id="add-unit-price" name="UnitPrice" class="form-control form-control-sm" />
                                <span data-valmsg-for="add-unit-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount1" class="form-label mb-0">Discount 1</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount1" name="Discount1" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="add-discount1" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount2" class="form-label mb-0">Discount 2</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount2" name="Discount2" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="add-discount2" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-net-price" class="form-label mb-0">Net Price</label>
                                <input type="number" id="add-net-price" name="NetPrice" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="add-net-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load item for select2
        $("#add-code").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#addModal")
        });

        $("#add-code").on("select2:select", function () {
            $("#add-name").val($("#add-code").select2("data")[0].name);
            $("#add-unit").val($("#add-code").select2("data")[0].unit);
            $("#add-code-error").html("");
        });

        $("#add-code").on("select2:unselecting", function (e) {
            $("#add-name").val("");
            $("#add-unit").val("");
        });

        $("#add-quantity, #add-unit-price, #add-discount1, #add-discount2").on("input", function () {
            var quantity = parseFloat($("#add-quantity").val());
            var unit_price = parseFloat($("#add-unit-price").val());
            var discount1 = parseFloat($("#add-discount1").val());
            var discount2 = parseFloat($("#add-discount2").val());

            $("#add-net-price").val(Round2Decimal(quantity * (((100 - discount1 - discount2) * unit_price) / 100)));
        });

        function clearItemForm() {
            $("#add-code").val("").trigger("change");
            $("#add-name").val("");
            $("#add-quantity").val("0");
            $("#add-unit").val("");
            $("#add-unit-price").val("0");
            $("#add-discount1").val("0");
            $("#add-discount2").val("0");
            $("#add-net-price").val("0");
        }

        $(".createBtn").on("click", clearItemForm);

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Code: { required: true },
                Quantity: { required: true, isNotZero: true },
                UnitPrice: { required: true }
            },
            messages: {
                Code: { required: "Please select item to replenish." },
                Quantity: { required: "Please enter a quantity", isNotZero: "Can not replenish an item with 0 quantity" },
                UnitPrice: { required: "Please enter the unit cost" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.id === $("#add-code").select2("data")[0].id) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastr.warning("Can't add duplicate item");
            } else {
                itemDT.row.add({
                    id: $("#add-code").select2("data")[0].id,
                    itemCode: $("#add-code").select2("data")[0].text,
                    itemName: $("#add-code").select2("data")[0].name,
                    quantity: $("#add-quantity").val() || 0,
                    unit: $("#add-code").select2("data")[0].unit,
                    unitPrice: Round2Decimal($("#add-unit-price").val() || 0),
                    unitPriceD: $("#add-unit-price").val() || 0,
                    discount1: Round2Decimal($("#add-discount1").val() || 0),
                    discount1D: $("#add-discount1").val() || 0,
                    discount2: Round2Decimal($("#add-discount2").val() || 0),
                    discount2D: $("#add-discount2").val() || 0,
                    netPrice: Round2Decimal($("#add-net-price").val() || 0),
                    netPriceD: $("#add-net-price").val() || 0
                }).draw();
                clearItemForm();
            }
        }

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
                showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { purchaseOrderId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="left" role="tooltip"><i class="fas fa-minus"></i></button>';
                        return actions;
                    }
                },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val() == "Draft") {
                            return '<input type="number" min="0" max="1999999" value="' + data.quantity + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                        } else {
                            return data.quantity
                        }
                    },
                    name: "Quantity",
                    className: "text-end"
                },
                { data: "unit", name: "Unit" },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val() == "Draft") {
                            return '<input type="number" min="0" step="0.01" max="1999999.99" value="' + Round2Decimal(data.unitPriceD) + '" class="form-control form-control-sm unitprice" style="width: 100%;" />';
                        } else {
                            return data.unitPrice
                        }
                    },
                    name: "UnitPrice",
                    className: "text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val() == "Draft") {
                            return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + Round2Decimal(data.discount1D) + '" class="form-control form-control-sm discount1" /><span class="input-group-text">%</span></div>';
                        } else {
                            return data.discount1
                        }
                    },
                    name: "Discount1",
                    className: "text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val() == "Draft") {
                            return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + Round2Decimal(data.discount2D) + '" class="form-control form-control-sm discount2" /><span class="input-group-text">%</span></div>';
                        } else {
                            return data.discount2
                        }
                    },
                    name: "Discount2",
                    className: "text-end"
                },
                { data: "netPrice", name: "NetPrice", className: "form-cell text-end netprice" }
            ],
            order: [[0, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                var numVal = function (i) {
                    return typeof i === 'string' ? i.replace(/[\$,]/g, '') * 1 : typeof i === 'number' ? i : 0;
                };
                var totalQuantity = api.column(3).data().reduce(function (a, b) { return numVal(a) + numVal(b); }, 0);
                var totalNetPrice = api.column(8).data().reduce(function (a, b) { return numVal(a) + numVal(b); }, 0);

                $(api.column(3).footer()).html(FormatStringInteger(totalQuantity));
                $(api.column(8).footer()).html(FormatStringDecimal(totalNetPrice));
            }
        });

        LoadDraft();
        function LoadDraft() {
            if ($("#po-status").val() == "Draft") {
                $(".btn-details-replenish").show();
                $(".btn-details-draft").show();
                $(".btn-details-print").hide();

                $(".createBtn").show();

                itemDT.column(0).visible(true);
            } else {
                $(".btn-details-replenish").hide();
                $(".btn-details-draft").hide();
                $(".btn-details-print").show();

                $(".createBtn").hide();

                itemDT.column(0).visible(false);

                $(".po-title").text($(".po-title").text().replace(" (Draft)", ""));
                $(".breadcrumb-item.active").text($(".breadcrumb-item.active").text().replace(" (Draft)", ""));
            }
            itemDT.ajax.reload();
        }

        itemDT.on("draw", function () {
            hideLoader();

            DatatablesSearchOnEnter('.table-item', itemDT);

            $(".btn-remove-item").on("click", function () {
                itemDT.row($(this).parents('tr')).remove().draw();
            });
            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");
            $(".table-item th").removeClass("netprice");

            if ($("#po-status").val() == "Draft") {
                ComputeTotalQuantity();
            }

            $(".quantity, .unitprice, .discount1, .discount2").on("input", function () {
                var quantity = parseInt($(this).parents("tr").find(".quantity").val());
                var unit_price = parseFloat($(this).parents("tr").find(".unitprice").val());
                var discount1 = parseFloat($(this).parents("tr").find(".discount1").val());
                var discount2 = parseFloat($(this).parents("tr").find(".discount2").val());

                var net_price = FormatStringDecimal(Round2Decimal(quantity * (((100 - discount1 - discount2) * unit_price) / 100)));
                $(this).parents("tr").find(".netprice").html(net_price);
                ComputeTotalQuantity();
                ComputeTotalNetPrice();
            });
        });

        function ComputeTotalQuantity() {
            quantities = $(".table-item").find(".quantity");
            total_quantity = 0;
            console.log("Quantity:");
            console.log(quantities);
            $.each(quantities, function () {
                console.log($(this).val());
                total_quantity += parseInt($(this).val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        function ComputeTotalNetPrice() {
            net_prices = $(".table-item").find(".netprice");
            total_net_price = 0;
            console.log("NetPrice:");
            console.log(net_prices);
            $.each(net_prices, function () {
                console.log($(this).html());
                total_net_price += parseFloat($(this).html());
            });
            $(".total-net-price").html(FormatStringDecimal(total_net_price));
        }

        function GetItemsToReplenish() {
            var item_to_replenish = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                var row_unitprice = parseFloat($(this.node()).find(".unitprice").val());
                var row_discount1 = parseFloat($(this.node()).find(".discount1").val());
                var row_discount2 = parseFloat($(this.node()).find(".discount2").val());
                item_to_replenish.push({
                    item: row_data.id,
                    quantity: row_quantity,
                    unitPrice: row_unitprice,
                    discount1: row_discount1,
                    discount2: row_discount2
                });
            });
            return item_to_replenish;
        }

        function SaveReplenish(submitter) {
            var itemsToReplenish = GetItemsToReplenish();
            if (itemsToReplenish.length == 0) {
                toastr.warning("No item to replenish. Add an item to the list to continue");
            } else if (itemsToReplenish.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't replenish an item with 0 quantity");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveJson")",
                    data: {
                        type: submitter,
                        Id: @Model?.Id,
                        Items: itemsToReplenish
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#po-status").val(submitter);
                            LoadDraft();
                        }
                    }
                });
            }
        }

        $(".btn-details-print").on("click", function () {
            var html = '<h3>Replenishment Details</h3>';
            html += '<table class="table-header w100">';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.Supplier)</th><td>@Model?.Supplier</td>';
            html += '<th>@Html.DisplayNameFor(model => model.OrderDate)</th><td>@Model?.OrderDate</td>';
            html += '<th>@Html.DisplayNameFor(model => model.OrderBy)</th><td>@Model?.OrderBy</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.Address1)</th><td>@(string.IsNullOrEmpty(Model?.Address1.Trim()) ? "-" : Model.Address1)</td>';
            html += '<th>@Html.DisplayNameFor(model => model.Currency)</th><td>@Model?.Currency</td>';
            html += '<th>@Html.DisplayNameFor(model => model.PONumber)</th><td>@Model?.PONumber</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.Address2)</th><td>@(string.IsNullOrEmpty(Model?.Address2.Trim()) ? "-" : Model.Address2)</td>';
            html += '<th>@Html.DisplayNameFor(model => model.CurrencyRate)</th><td>@Model?.CurrencyRate</td>';
            html += '<th>@Html.DisplayNameFor(model => model.ReferenceNumber)</th><td>@Model?.ReferenceNumber</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.Destination)</th><td>@Model?.Destination</td > ';
            html += '</tr>';
            html += '</table>';

            html += '<table class="table-items">';
            html += '<tr>';
            html += '<thead>';
            html += '<th>Item Code</th>';
            html += '<th>Item Name</th>';
            html += '<th>Quantity</th>';
            html += '<th>Unit</th>';
            html += '<th>Unit Price</th>';
            html += '<th>Discount 1</th>';
            html += '<th>Discount 2</th>';
            html += '<th>Net Price</th>';
            html += '</thead>';
            html += '</tr>';
            var totalQuantity = 0, totalNetPrice = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                html += '<tr>';
                html += '<td>' + row_data.itemCode + '</td>';
                html += '<td>' + row_data.itemName + '</td>';
                html += '<td class="right-text">' + row_data.quantity + '</td>';
                html += '<td>' + row_data.unit + '</td>';
                html += '<td class="right-text">' + row_data.unitPrice + '</td>';
                html += '<td class="right-text">' + row_data.discount1 + '</td>';
                html += '<td class="right-text">' + row_data.discount2 + '</td>';
                html += '<td class="right-text">' + row_data.netPrice + '</td>';
                html += '</tr>';

                totalQuantity += parseInt(row_data.quantity);
                totalNetPrice += parseFloat(row_data.netPriceD);
            });
            html += '<tr>';
            html += '<tfoot>';
            html += '<th colspan="2" class="right-text">Total</th>';
            html += '<th class="right-text">' + FormatStringInteger(totalQuantity) + '</th>';
            html += '<th colspan="4"></th>';
            html += '<th class="right-text">' + FormatStringDecimal(totalNetPrice) + '</th>';
            html += '</tfoot>';
            html += '</tr>';
            html += '</table>';
            $("#for-print").html(html);
            $("#for-print").printThis({
                importCSS: false,
                loadCSS: "/css/print.css",
                pageTitle: "GMG Inventory",
                beforePrint: function () {
                    $.LoadingOverlay("show", {
                        image: "",
                        fontawesome: "fas fa-print"
                    });
                },
                afterPrint: function () {
                    hideLoader();
                }
            });
        });
    </script>
}