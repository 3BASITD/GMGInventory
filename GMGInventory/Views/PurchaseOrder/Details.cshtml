@model PurchaseOrderNewDetailedVM

@{
    ViewData["Title"] = "Purchase Order Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseOrder" asp-action="Index">Purchase Orders</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                    <span class="fas fa-print"></span> Print
                </button>
            }
            @if (Model.Status == "Draft")
            {
                @if (userAccess.CanEdit)
                {
                    <button type="button" class="btn btn-secondary btn-sm float-right ml-2 btn-details-save">
                        <span class="fas fa-save"></span> Save as Draft
                    </button>
                }
                @if (userAccess.CanAdd)
                {
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2 btn-details-submit">
                        <span class="fas fa-paper-plane"></span> Submit
                    </button>
                }
            }
            else if (Model.Status == "Submitted"
            && string.IsNullOrWhiteSpace(Model.ApprovedBy))
            {
                @if (userAccess.CanApproveDisapprove)
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 btn-details-approve">
                        <span class="fas fa-check"></span> Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-disapprove">
                        <span class="fas fa-times"></span> Disapprove
                    </button>
                }
            }
            else if (Model.Status == "Disapproved"
            && !string.IsNullOrWhiteSpace(Model?.DisapprovedBy)
            && Model?.ResubmitId == null)
            {
                @if (userAccess.CanAdd)
                {
                    <a href="@Url.Action("Create")/@Model?.Id" class="btn btn-primary btn-sm float-right ml-2">
                        <span class="fas fa-edit"></span> Update to Resubmit
                    </a>
                }
            }
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) || Model?.ResubmitFromId != null)
        {
            <div class="row">
                @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy))
                {
                    <div class="col-12">
                        <div class="alert alert-danger text-sm" role="alert">
                            <strong>Reason of Disapproval:</strong>
                            @(string.IsNullOrWhiteSpace(Model?.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                        </div>
                    </div>
                }
                @if (Model?.ResubmitId != null || Model?.ResubmitFromId != null)
                {
                    <div class="col-12">
                        <div class="alert alert-info text-sm" role="alert">
                            <strong>Resubmit Details:</strong>
                            @if (Model?.ResubmitId != null)
                            {
                                <div>This has been resubmitted. <a href="@Url.Action("Details", "PurchaseOrder", new {Id = Model?.ResubmitId})" class="alert-link">View new details</a>.</div>
                            }
                            @if (Model?.ResubmitFromId != null)
                            {
                                <div>This is a resubmission. <a href="@Url.Action("Details", "PurchaseOrder", new {Id = Model?.ResubmitFromId})" class="alert-link">View previous details</a>.</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </span>
                    <b class="d-block">
                        @Model?.DocumentNumber
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Type)
                    </span>
                    <b class="d-block">
                        @Model?.Type
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Supplier)
                    </span>
                    <b class="d-block">
                        @Model?.Supplier
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Term)
                    </span>
                    <b class="d-block">
                        @Model?.Term
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Currency)
                    </span>
                    <b class="d-block">
                        @Model?.Currency
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CurrencyRate)
                    </span>
                    <b class="d-block">
                        @Model?.CurrencyRate
                    </b>
                </p>
            </div>
            @if (Model?.Type == "Non-Automotive" || Model?.Type == "Local Purchase Order" || Model?.Type == "International Purchase Order")
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DeliveryMode)
                        </span>
                        <b class="d-block">
                            @Model?.DeliveryMode
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DeliveryAddress)
                    </span>
                    <b class="d-block">
                        @Model?.DeliveryAddress
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </span>
                    <b class="d-block">
                        @Model?.OrderDate
                    </b>
                </p>
            </div>
            @if (Model?.Type == "Local Purchase Order" || Model?.Type == "International Purchase Order")
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Reference)
                        </span>
                        <b class="d-block">
                            @(Model?.Reference ?? "-")
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @Model?.Remarks
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedBy)
                        </span>
                        <b class="d-block">
                            @Model?.ApprovedBy
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DisapprovedBy)
                        </span>
                        <b class="d-block">
                            @Model?.DisapprovedBy
                        </b>
                    </p>
                </div>
            }
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Status)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model?.Status
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model?.UserCreated
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block" id="request-status">
                        @Model?.DateCreated
                    </b>
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model?.UserModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserModified)
                        </span>
                        <b class="d-block">
                            @Model?.UserModified
                        </b>
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.DateModified))
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block">
                            @Model?.DateModified
                        </b>
                    </p>
                </div>
            }
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Purchase Request Item(s)</span>
                        @if (Model!.Status == "Draft" && userAccess.CanAdd)
                        {
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Item
                                </button>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>#</th>
                                    <th>Purchase Request Ref#</th>
                                    <th>Item Code</th>
                                    <th>Part Number</th>
                                    <th>Item Description</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Unit Cost</th>
                                    <th>Total Amount</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th>Total</th>
                                    <th class="total-quantity">0</th>
                                    <th></th>
                                    <th></th>
                                    <th class="total-amount">0</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (userAccess.CanAdd)
{
    <!-- Purchase Order Item Modal -->
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Purchase Order Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12 col-sm-6 add-so-number-container">
                                <div class="form-group">
                                    <label for="add-pr-number" class="form-label mb-0">Purchase Request Ref#</label>
                                    <select id="add-pr-number" name="PRNumber" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-code-container">
                                <div class="form-group">
                                    <label for="add-code" class="form-label mb-0">Item Code</label>
                                    <input type="text" id="add-code" name="Code" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-part-container">
                                <div class="form-group">
                                    <label for="add-part" class="form-label mb-0">Part Number</label>
                                    <input type="text" id="add-part" name="PartNumber" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-name-container">
                                <div class="form-group">
                                    <label for="add-name" class="form-label mb-0">Item Name</label>
                                    <select id="add-name" name="Name" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-quantity-container">
                                <div class="form-group">
                                    <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                    <input type="number" min="0" max="1999999" step="1" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-unit-container">
                                <div class="form-group">
                                    <label for="add-unit" class="form-label mb-0">Unit</label>
                                    <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-unit-cost-container">
                                <div class="form-group">
                                    <label for="add-unit-cost" class="form-label mb-0">Unit Cost</label>
                                    <input type="number" step="0.01" id="add-unit-cost" name="UnitCost" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 add-total-amount-container">
                                <div class="form-group">
                                    <label for="add-total-amount" class="form-label mb-0">Total Amount</label>
                                    <input type="text" id="add-total-amount" name="TotalAmount" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-add">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var po_status = @Json.Serialize(Model?.Status);
        var order_type = @Json.Serialize(Model?.Type);
        var order_type_id = @Json.Serialize(Model?.TypeId);

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemListJson")",
                data: { purchaseOrderId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (po_status == "Draft") {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top" role="tooltip"><i class="fas fa-minus"></i></button>';
                            actions += '<button type="button" class="btn btn-info btn-xs btn-up-item" data-microtip-title="Move Up Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-up"></i></button>';
                            actions += '<button type="button" class="btn btn-info btn-xs btn-down-item" data-microtip-title="Move Down Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-down"></i></button>';
                        }
                        return actions + '</div>';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                { data: "purchaseRequestNumber", name: "PurchaseRequestNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "-";
                        } else {
                            return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemPartNumber == null || data.itemPartNumber.trim() == "" ? "-" : data.itemPartNumber;
                    },
                    name: "ItemPartNumber",
                    className: "form-cell"
                },
                { data: "itemDescription", name: "ItemDescription", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (po_status == "Draft") {
                            if (data.quantityD > data.unorderedQuantityD) {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Can not exceed ' + data.unorderedQuantity + ' unordered quantity.</label>';
                            } else {
                                return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                            }
                        } else {
                            return data.quantity;
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (po_status == "Draft") {
                            return '<input type="number" min="0" max="1999999" step="0.01" value="' + data.unitCostD + '" class="form-control form-control-sm cost" style="width: 100%;" />';
                        } else {
                            return data.unitCost;
                        }
                    },
                    name: "UnitCost",
                    className: "form-cell text-end"
                },
                { data: "totalAmount", name: "TotalAmount", className: "form-cell" }
            ],
            order: [[1, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 6);
                columnDTTotalDecimal(api, 9);
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            if (user_access.canAdd) {
                $(".btn-remove-item").off("click").on("click", function () {
                    itemDT.row($(this).parents('tr')).remove().draw();
                });

                itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var rowData = this.data();
                    if (rowData.lineNumber == 1)
                        $(this.node()).find(".btn-up-item").hide();
                    else
                        $(this.node()).find(".btn-up-item").show();

                    if (rowData.lineNumber == Math.max.apply(Math, itemDT.column(1).data().toArray()))
                        $(this.node()).find(".btn-down-item").hide();
                    else
                        $(this.node()).find(".btn-down-item").show();
                });

                $(".btn-up-item").off("click").on("click", function () {
                    var row = $(this).parents('tr');
                    var rowData = itemDT.row(row).data();

                    var currentLineNumber = rowData.lineNumber;
                    var newLineNumber = currentLineNumber - 1;

                    var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                        return itemDT.row(index).data().lineNumber === newLineNumber;
                    });

                    if (targetRowIndex != undefined) {
                        var targetRowData = itemDT.row(targetRowIndex).data();
                        targetRowData.lineNumber = currentLineNumber;
                        itemDT.row(targetRowIndex).data(targetRowData);
                    }

                    rowData.lineNumber = newLineNumber;
                    itemDT.row(row).data(rowData);

                    itemDT.draw();
                });

                $(".btn-down-item").off("click").on("click", function () {
                    var row = $(this).parents('tr');
                    var rowData = itemDT.row(row).data();
                    var currentLineNumber = rowData.lineNumber;
                    var newLineNumber = currentLineNumber + 1;

                    var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                        return itemDT.row(index).data().lineNumber == newLineNumber;
                    });

                    if (targetRowIndex != undefined) {
                        var targetRowData = itemDT.row(targetRowIndex).data();
                        targetRowData.lineNumber = currentLineNumber;
                        itemDT.row(targetRowIndex).data(targetRowData);
                    }

                    rowData.lineNumber = newLineNumber;
                    itemDT.row(row).data(rowData);

                    itemDT.draw();
                });

                $(".quantity, .cost").off("change").on("change", function () {
                    var row = itemDT.row($(this).closest('tr'));
                    var rowData = row.data();

                    var quantityValue = parseFloat($(row.node()).find(".quantity").val()) || 0;
                    var costValue = parseFloat($(row.node()).find(".cost").val()) || 0;

                    var totalValue = quantityValue * costValue;

                    rowData.quantity = FormatStringInteger(quantityValue);
                    rowData.quantityD = quantityValue;
                    rowData.unitCost = FormatStringDecimal(costValue);
                    rowData.unitCostD = costValue;
                    rowData.totalAmount = FormatStringDecimal(totalValue);
                    rowData.totalAmountD = totalValue;

                    row.data(rowData).draw(false);
                });
            }
        });

        if (user_access.canAdd) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseRequestOptions")",
                data: {
                    OrderTypeId: order_type_id
                },
                success: function (data, status, xhr) {
                    $("#add-pr-number").select2({
                        data: data,
                        minimumInputLength: -1,
                        placeholder: "<empty>",
                        language: {
                            noResults: function () {
                                return "No request found";
                            }
                        },
                        dropdownParent: $("#addModal")
                    }).on("select2:select", function () {
                        loadAllItemsOptions();
                    });
                }
            });

            loadAllItemsOptions();
            function loadAllItemsOptions() {
                if ($.fn.select2 && $("#add-name").hasClass("select2-hidden-accessible")) {
                    $("#add-name").select2("destroy");
                    $("#add-name").empty();
                }
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetPurchaseRequestItemOptions")",
                    data: {
                        RequestId: function () {
                            return $("#add-pr-number").val();
                        }
                    },
                    success: function (data, status, xhr) {
                        $("#add-name").select2({
                            data: data,
                            minimumResultsForSearch: -1,
                            placeholder: "<empty>",
                            allowClear: true,
                            language: {
                                noResults: function () {
                                    return "No unserved items found";
                                }
                            },
                            templateResult: function (repo) {
                                if (repo.loading) {
                                    return repo.text;
                                }
                                return $(
                                    "<strong>" + repo.text + "</strong><br />" +
                                    "<small>" +
                                    "Requested Quantity: " + repo.quantity + " " + repo.unit + "<br />" +
                                    "Unordered Quantity: " + repo.unorderedQuantity + " " + repo.unit +
                                    "</small>"
                                );
                            },
                            dropdownParent: $("#addModal")
                        }).on("select2:select", function () {
                            var selected = $(this).select2("data")[0];
                            $("#add-code").val(selected.itemCode);
                            $("#add-part").val(selected.partNumber);
                            $("#add-quantity").val(selected.unorderedQuantity);
                            $("#add-quantity").data("max", selected.unorderedQuantity);
                            $("#add-unit").val(selected.unit);
                            $("#add-unit").data("Id", selected.unitId);
                            $("#add-unit-cost").val(0);
                            $("#add-total-amount").val("0.00");
                        }).on("select2:unselecting", function () {
                            $("#add-code").val("");
                            $("#add-part").val("");
                            $("#add-quantity").val(0);
                            $("#add-quantity").data("max", 0);
                            $("#add-unit").val("");
                            $("#add-unit").data("Id", -1);
                            $("#add-unit-cost").val("0.00");
                            $("#add-total-amount").val("0.00");
                        });
                    },
                    complete: function (xhr, status) {
                        $("#add-name").val("").trigger("change");
                    }
                });
            }

            $("#add-quantity").on("change keyup", recomputeAddForm);
            $("#add-unit-cost").on("change keyup", recomputeAddForm);
            function recomputeAddForm() {
                var quantity = $("#add-quantity").val() || 0;
                var cost = $("#add-unit-cost").val() || 0;

                $("#add-total-amount").val(FormatStringDecimal(quantity * cost));
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Unit")",
                success: function (data, status, xhr) {
                    $("#add-unit2").select2({
                        data: data,
                        minimumResultsForSearch: -1,
                        placeholder: "<empty>",
                        dropdownParent: $("#addModal")
                    }).on("change", function () {
                        $("#add-unit").val($("#add-unit2").select2("data")[0].text);
                        $("#add-unit").data("Id", $("#add-unit2").select2("data")[0].id);
                    });
                }
            });

            $(".createBtn").on("click", clearItemForm);

            function clearItemForm() {
                $("#add-pr-number").val(null).trigger("change");
                $("#add-code").val("");
                $("#add-part").val("");
                $("#add-name").html("");
                $("#add-quantity").val("0");
                $("#add-unit").val("");
                $("#add-unit").data("Id", "");
                $("#add-unit-cost").val("0.00");
                $("#add-total-amount").val("0.00");
            }

            // Validation for Add Item Modal
            var validateAdd = $("#form-item").validate({
                rules: {
                    PRNumber: {
                        required: true// function () { return checkIfRequired("SONumber"); }
                    },
                    Name: {
                        required: true,// function () { return checkIfRequired("Name"); },
                        maxlength: 100
                    },
                    Quantity: {
                        required: true,// function () { return checkIfRequired("Quantity"); },
                        number: true,
                        isNotZero: true,
                        max: function () {
                            return $("#add-quantity").data("max");
                        }
                    },
                    UnitCost: {
                        required: true,// function () { return checkIfRequired("Purpose"); },
                        number: true
                    }
                },
                messages: {
                    PRNumber: {
                        required: "Please select a Purchase Request Reference Number."
                    },
                    Name: {
                        required: "Please select an Item.",
                        maxlength: "Name must not exceed 100 characters."
                    },
                    Quantity: {
                        required: "Please enter a quantity.",
                        number: "Please enter a valid number.",
                        isNotZero: "Can not request an item with 0 quantity."
                    },
                    UnitCost: {
                        required: "Please enter the unit cost.",
                        number: "Please enter a valid number."
                    }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    AddItem();
                }
            });

            function AddItem() {
                var rowIndexes = [];
                itemDT.rows(function (idx, data, node) {
                    if (data.itemDescription == $("#add-name").select2("data")[0].text) {
                        rowIndexes.push(idx);
                    }
                    return false;
                });
                if (rowIndexes.length > 0) {
                    toastr.warning($("#add-name").select2("data")[0].text + " has already been added", "Duplicate");
                } else {
                    itemDT.row.add({
                        purchaseOrderId: 0,
                        lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                        purchaseRequestId: $("#add-pr-number").select2("data")[0].id,
                        purchaseRequestNumber: $("#add-pr-number").select2("data")[0].text,
                        itemId: $("#add-name").select2("data")[0].itemId,
                        itemCode: $("#add-name").select2("data")[0].itemCode,
                        itemPartNumber: $("#add-name").select2("data")[0].partNumber,
                        itemDescription: $("#add-name").select2("data")[0].text,
                        quantity: FormatStringInteger($("#add-quantity").val()),
                        quantityD: $("#add-quantity").val() || 0,
                        unorderedQuantity: FormatStringInteger($("#add-quantity").data("max")),
                        unorderedQuantityD: $("#add-quantity").data("max") || 0,
                        unitId: $("#add-unit").data("Id"),
                        unitCode: $("#add-unit").val(),
                        unitCost: FormatStringDecimal($("#add-unit-cost").val()),
                        unitCostD: $("#add-unit-cost").val() || 0,
                        totalAmount: FormatStringDecimal($("#add-total-amount").val()),
                        totalAmountD: $("#add-total-amount").val() || 0
                    }).draw();

                    toastr.success("Added " + $("#add-name").select2("data")[0].text + " on Purchase Order Item(s)", "Success");
                    clearItemForm();
                }
            }

            $(".btn-details-save").on("click", function () {
                SaveRequest("Draft");
            });

            $(".btn-details-submit").on("click", function () {
                SaveRequest("Submitted");
            });

            function SaveRequest(status) {
                var items = itemDT.data();
                if (items.length == 0) {
                    toastr.warning("No item to request. Add an item to the list to continue", "Warning");
                } else if (items.filter(s => parseInt(s.quantity) === 0).length > 0) {
                    toastr.warning("Some items have 0 quantity. Can't request an item with 0 quantity", "Warning");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("SaveItemsJson")",
                        data: {
                            Id: @Model?.Id,
                            status: status,
                            items: itemDT.rows().data().toArray()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Success") {
                                window.location.reload();
                            } else {
                                toastr.error(data.message, data.status);
                            }
                        }
                    });
                }
            }
        }

        if (user_access.canApproveDisapprove) {
            $('.btn-details-approve').click(function (e) {
                swal({
                    title: "Approve Purchase Order",
                    text: "Continue to approve this purchase order?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("ApproveJson")",
                            type: "POST",
                            data: { Id: @Model!.Id },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });

            $('.btn-details-disapprove').click(function (e) {
                swal({
                    title: "Disapprove Purchase Order",
                    text: "Continue to disapprove this purchase order?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                    content: {
                        element: "input",
                        attributes: {
                            placeholder: "Reason for Disapproving",
                            type: "text"
                        }
                    }
                }).then((confirm) => {
                    if (confirm !== null) {
                        $.ajax({
                            url: "@Url.Action("DisapproveJson")",
                            type: "POST",
                            data: {
                                Id: @Model!.Id,
                                reason: confirm
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    window.location.reload();
                                } else {
                                    toastr.error(data.message, data.status);
                                }
                            }
                        });
                    }
                });
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintDetails")/' + @Model?.Id, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
}
