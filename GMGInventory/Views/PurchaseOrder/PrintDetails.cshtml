@model PurchaseOrderNewDetailedVM

@{
    Layout = "";
    var title = "Purchase Order";
    var items = ViewData["Items"] as List<PurchaseOrderLineItemVM> ?? new List<PurchaseOrderLineItemVM>();

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <table class="formatted">
        <tr>
            <td rowspan="2" class="center-text" style="width: 100px;">
                @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                {
                    <img src="~/images/BAS-02.png" class="logo" />
                }
                else
                {
                    <img src="~/images/GMG-01.png" class="logo" />
                }
            </td>
            <td rowspan="2" style="width: 60%;">
                <dl>
                    <dt>Document Classification:</dt>
                    <dd>@title.ToUpper()</dd>
                    @if (Model.Status.ToLower() != "approved")
                    {
                        <dd>@("(" + Model.Status + ")")</dd>
                    }
                </dl>
            </td>
            <td style="width: 40%;">
                <dl>
                    <dt>PO Date:</dt>
                    <dd>@Model.OrderDate</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td>
                <dl>
                    <dt>PO No.:</dt>
                    <dd>@Model.DocumentNumber</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td colspan="3">
                <div class="two-column">
                    <div class="column">
                        <strong>Supplier Details</strong>
                        <div class="label">
                            <span>Name:</span>
                            <strong class="detail">@Model.Supplier</strong>
                        </div>
                        <div class="label">
                            <span>Contact Person:</span>
                            <strong class="detail">@(string.IsNullOrWhiteSpace(Model.SupplierContactPerson) ? "N/A" : Model.SupplierContactPerson)</strong>
                        </div>
                        <div class="label">
                            <span>Contact Number:</span>
                            <strong class="detail">@(string.IsNullOrWhiteSpace(Model.SupplierContactNumber) ? "N/A" : Model.SupplierContactNumber)</strong>
                        </div>
                        <div class="label">
                            <span>Address:</span>
                            <strong class="detail">@(string.IsNullOrWhiteSpace(Model.SupplierAddress) ? "N/A" : Model.SupplierAddress)</strong>
                        </div>
                        @*<div class="label">
                        <span>Email Address:</span>
                        <strong class="detail">?</strong>
                        </div>*@
                        <div class="label">
                            <span>Payment Terms:</span>
                            <strong class="detail">@Model.Term</strong>
                        </div>
                    </div>
                    <div class="column">
                        <strong>Delivery Details</strong>
                        <div class="label">
                            <span>Ship To:</span>
                            <strong class="detail">@Model.DeliveryName</strong>
                        </div>
                        <div class="label">
                            <span>Contact Person:</span>
                            <strong class="detail">@(string.IsNullOrWhiteSpace(Model.DeliveryContactPerson) ? "N/A" : Model.DeliveryContactPerson)</strong>
                        </div>
                        <div class="label">
                            <span>Contact Number:</span>
                            <strong class="detail">@(string.IsNullOrWhiteSpace(Model.DeliveryContactNumber) ? "N/A" : Model.DeliveryContactNumber)</strong>
                        </div>
                        <div class="label">
                            <span>Address:</span>
                            <strong class="detail">@(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "N/A" : Model.DeliveryAddress)</strong>
                        </div>
                        <div class="label">
                            <span>Receiving Time:</span>
                            <strong class="detail">@Model.TimeReceived</strong>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
    <table class="formatted">
        <thead>
            <tr>
                <th style="min-width: 10px;">#</th>
                @if (Model.Type.ToLower() != "non-automotive")
                {
                    <th style="min-width: 50px;">PART NUMBER</th>
                }
                <th>ITEM DESCRIPTION</th>
                <th style="min-width: 50px;">QTY</th>
                <th style="min-width: 50px;">UOM</th>
                <th style="min-width: 100px;">UNIT PRICE</th>
                <th style="min-width: 100px;">TOTAL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    @if (Model.Type.ToLower() != "non-automotive")
                    {
                        <td>@item.ItemPartNumber</td>
                    }
                    <td>@item.ItemDescription</td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td>@item.UnitCode</td>
                    <td class="right-text"><nobr>@item.UnitCost</nobr></td>
                    <td class="right-text"><nobr>@item.TotalAmount</nobr></td>
                </tr>
            }
            @{
                var itemCount = items.Count;
                var lastLineNumber = items.OrderByDescending(s => s.LineNumber).Select(s => s.LineNumber).First();
            }
            <tr>
                <td class="center-text" style="min-width: 10px;">@(lastLineNumber + 1)</td>
                @if (Model.Type.ToLower() != "non-automotive")
                {
                    <td></td>
                }
                <td>* * NOTHING FOLLOWS * *</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            @if (itemCount < 15)
            {
                for (var ctr = 2; ctr <= 15 - itemCount; ctr++)
                {
                    <tr>
                        <td class="center-text" style="min-width: 10px;">@(lastLineNumber + ctr)</td>
                        @if (Model.Type.ToLower() != "non-automotive")
                        {
                            <td></td>
                        }
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                }
            }
            <tr>
                <td colspan="4" class="bb-0 br-0" style="vertical-align:top; padding:0px;">
                    <table class="formatted">
                        <tbody>
                            <tr>
                                <td class="bb-0 bl-0 bt-0" colspan="4"></td>
                            </tr>
                            <tr>
                                <td class="bl-0 bb-0" colspan="2">PURCHASE REQUEST NUMBER:</td>
                                <td class="bl-0 bb-0" colspan="2">@Model.PurchaseRequestNumber</td>
                            </tr>

                            <tr>
                                <td class="bl-0 bb-0" colspan="2">DATE PO SENT:</td>
                                <td class="bl-0 bb-0" colspan="2">@Model.DateModified</td>
                            </tr>

                            <tr>
                                <td class="bl-0 bb-0" colspan="2">DATE RECEIVED:</td>
                                <td class="bl-0 bb-0" colspan="2">@Model.DateReceived</td>
                            </tr>
                            <tr>
                                <td class="bl-0" colspan="4" rowspan="2">
                                    <dl>
                                        <dt>Remarks:</dt>
                                        <dd>@Model.Remarks</dd>
                                    </dl>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>

                <td class="bl-0 bb-0 bt-0 br-0"></td>
                <td class="bb-0 bl-0" colspan="2" style="vertical-align:top; padding:0px">
                    <table class="formatted">
                        <tbody>

                            @{
                                var totalD = items.Sum(s => s.TotalAmountD);
                                var total = Model.Currency + " " + string.Format("{0:#,##0.00}", totalD);

                                var discounted1D = totalD * Model.Discount1D / 100;
                                var discounted1 = Model.Currency + " " + string.Format("{0:#,##0.00}", discounted1D);

                                totalD = totalD - discounted1D;

                                var discounted2D = totalD * Model.Discount2D / 100;
                                var discounted2 = Model.Currency + " " + string.Format("{0:#,##0.00}", discounted2D);
                                totalD = totalD - discounted2D;

                                var discounted3D = totalD * Model.Discount3D / 100;
                                var discounted3 = Model.Currency + " " + string.Format("{0:#,##0.00}", discounted3D);
                                totalD = totalD - discounted3D;

                                var vatD = totalD - (totalD / (decimal)(1.12));
                                var vat = string.Format("{0:#,##0.00}", vatD);
                                var total2 = Model.Currency + " " + string.Format("{0:#,##0.00}", totalD);
                            }

                            <tr>
                                <td class="br-0 bt-0 bb-0 bl-0 ">TOTAL PURCHASE   </td>
                                <td class="right-text br-0 bb-0 bt-0 bl-0"><strong>  @total </strong></td>
                            </tr>

                            @if (Model.Type.ToLower() != "maintenance & repair")
                            {
                                <tr>
                                    <td class="b-0"> @(Model.Type.ToLower() != "maintenance & repair" ? "DISCOUNT 1 %" : "")</td>
                                    <td class="right-text  br-0  bt-0 bb-0 bl-0">@(Model.Type.ToLower() != "maintenance & repair" ? Model.Discount1 + "%" : "")</td>
                                </tr>
                                <tr>
                                    <td class="b-0">  @(Model.Type.ToLower() != "maintenance & repair" ? "DISCOUNT AMOUNT" : "")</td>
                                    <td class="right-text  br-0  bt-0 bb-0 bl-0">@(Model.Type.ToLower() != "maintenance & repair" ? discounted1 : "") </td>
                                </tr>

                            }

                            @if (Model.Type.ToLower() == "local purchase order")
                            {
                                if (Model.Discount2D > 0)
                                {
                                    <tr>
                                        <td class="b-0"> @(Model.Type.ToLower() == "local purchase order" ? "Discount 2 %" : "")</td>
                                        <td class="right-text br-0  bt-0 bb-0 bl-0">@(Model.Type.ToLower() == "local purchase order" ? Model.Discount2 + "%" : "")</td>
                                    </tr>
                                    <tr>
                                        <td class="b-0">DISCOUNT AMOUNT</td>
                                        <td class="right-text br-0  bt-0 bb-0 bl-0">@discounted2</td>
                                    </tr>
                                }
                                if (Model.Discount3D > 0)
                                {

                                    <tr>
                                        <td class="b-0"> @(Model.Type.ToLower() == "local purchase order" ? "Discount 3 %" : "")</td>
                                        <td class="right-text br-0  bt-0 bb-0 bl-0">@(Model.Type.ToLower() == "local purchase order" ? Model.Discount3 + "%" : "")</td>
                                    </tr>

                                    <tr>
                                        <td class="b-0">DISCOUNT AMOUNT</td>
                                        <td class="right-text br-0  bt-0 bb-0 bl-0">@discounted3</td>
                                    </tr>
                                }
                            }

                            @if (Model.IsVATIncluded == "Yes")
                            {
                                <tr>
                                    <td class="bt-0 br-0 bl-0">VAT AMOUNT</td>
                                    <td class="right-text br-0  bt-0 bl-0">@vat</td>
                                </tr>
                            }
                            <tr>
                                <td class="br-0 bl-0 bb-0"><strong> TOTAL AMOUNT </strong></td>
                                <td class="right-text br-0  bl-0 bb-0"><strong>@total2</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </td>
           </tr>
            <tr>
                <td colspan="7" class="bt-0 bb-0">
                    <br />
                    <br />
                    <div class="two-column">
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.UserCreated</dd>
                                <dt>Prepared By</dt>
                            </dl>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.ApprovedBy</dd>
                                    <dt>Approved By</dt>
                                </dl>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.DisapprovedBy</dd>
                                    <dt>Disapproved By</dt>
                                </dl>
                            </div>
                        }
                    </div>
                </td>
            </tr>
            <tr class="text-center">
                <td colspan="7" class="bt-0">
                    <p class="footer center-text"> Bina's Auto Supply | 1034 Kusang Loob St. Brgy. 330 Zone 033 Sta. Cruz, Manila | Tel. No.8731-3923,8741-5537/39 </p>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>