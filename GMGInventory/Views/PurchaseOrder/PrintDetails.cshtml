@model PurchaseOrderNewDetailedVM

@{
    Layout = "";
    var title = "Purchase Order";
    var items = ViewData["Items"] as List<PurchaseOrderLineItemVM> ?? new List<PurchaseOrderLineItemVM>();
    var colcount = Model.Type.ToLower() != "non-automotive" ? 7 : 6;

    var companyLogo = TempData.Peek("CompanyLogo")?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <table class="formatted">
        <thead>
            <tr>
                <td colspan="@colcount" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col center w-150px">
                        @if (companyLogo == "BAS" && (Model.WarehouseName == "CETACIO" || Model.WarehouseName == "SEVERINO" || Model.WarehouseName == "PASIG2"))
                        {
                            <img src="~/images/BAS-02.png" class="logo" />
                        }
                        else if (companyLogo == "BAS" && Model.WarehouseName == "PASIG1")
                        {
                            <img src="~/images/3BAS.png" class="logo" />
                        }
                        else
                        {
                            <img src="~/images/GMG-01.png" class="logo" />
                        }
                        </div>
                        <div class="sub-col center w-60pc p-50">
                            <span class="title">Document Classification:</span>
                            <span class="desc">
                                @title.ToUpper()
                                @if (Model.Status.ToLower() != "approved")
                                {
                                    @("(" + Model.Status + ")")
                                }
                            </span>
                        </div>
                        <div class="sub-col center w-40pc">
                            <span class="title">PO Date:</span>
                            <span class="desc">@Model.OrderDate</span>
                            <hr />
                            <span class="title">PO No.:</span>
                            <span class="desc">@Model.DocumentNumber</span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="@colcount" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col w-50pc">
                            <strong>Supplier Details</strong>
                            <div class="label">
                                <span>Name:</span>
                                <strong class="detail">@Model.Supplier</strong>
                            </div>
                            <div class="label">
                                <span>Contact Person:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.SupplierContactPerson) ? "N/A" : Model.SupplierContactPerson)</strong>
                            </div>
                            <div class="label">
                                <span>Contact Number:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.SupplierContactNumber) ? "N/A" : Model.SupplierContactNumber)</strong>
                            </div>
                            <div class="label">
                                <span>Address:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.SupplierAddress) ? "N/A" : Model.SupplierAddress)</strong>
                            </div>
                            <div class="label">
                                <span>Payment Terms:</span>
                                <strong class="detail">@Model.Term</strong>
                            </div>
                        </div>
                        <div class="sub-col w-50pc">
                            <strong>Delivery Details</strong>
                            <div class="label">
                                <span>Ship To:</span>
                                <strong class="detail">@Model.DeliveryName</strong>
                            </div>
                            <div class="label">
                                <span>Mode:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.DeliveryMode) ? "N/A" : Model.DeliveryMode)</strong>
                            </div>
                            <div class="label">
                                <span>Contact Person:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.DeliveryContactPerson) ? "N/A" : Model.DeliveryContactPerson)</strong>
                            </div>
                            <div class="label">
                                <span>Contact Number:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.DeliveryContactNumber) ? "N/A" : Model.DeliveryContactNumber)</strong>
                            </div>
                            <div class="label">
                                <span>Address:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "N/A" : Model.DeliveryAddress)</strong>
                            </div>
                            <div class="label">
                                <span>Receiving Time:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.TimeReceived) ? "N/A" : Model.TimeReceived)</strong>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <th style="min-width: 10px;">#</th>
                @if (Model.Type.ToLower() != "non-automotive")
                {
                    <th style="min-width: 50px;">PART NUMBER</th>
                }
                <th>ITEM DESCRIPTION</th>
                <th style="min-width: 50px;">QTY</th>
                <th style="min-width: 50px;">UOM</th>
                <th style="min-width: 100px;">UNIT PRICE</th>
                <th style="min-width: 100px;">TOTAL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    @if (Model.Type.ToLower() != "non-automotive")
                    {
                        <td>@item.ItemPartNumber</td>
                    }
                    <td>@item.ItemDescription</td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td>@item.UnitCode</td>
                    <td class="right-text"><nobr>@item.UnitCost</nobr></td>
                    <td class="right-text"><nobr>@item.TotalAmount</nobr></td>
                </tr>
            }
            @{
                var itemCount = items.Count;
                var lastLineNumber = items.OrderByDescending(s => s.LineNumber).Select(s => s.LineNumber).First();
            }
            <tr>
                <td class="center-text" style="min-width: 10px;">@(lastLineNumber + 1)</td>
                @if (Model.Type.ToLower() != "non-automotive")
                {
                    <td></td>
                }
                <td colspan="5">* * NOTHING FOLLOWS * *</td>
            </tr>
            @if (itemCount < 15)
            {
                for (var ctr = 2; ctr <= 15 - itemCount; ctr++)
                {
                    <tr>
                        <td class="center-text" style="min-width: 10px;">@(lastLineNumber + ctr)</td>
                        @if (Model.Type.ToLower() != "non-automotive")
                        {
                            <td></td>
                        }
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2">PURCHASE REQUEST NUMBER:</td>
                <td colspan="2">@Model.PurchaseRequestNumber</td>
                <td rowspan="4"></td>
                @{
                    var currency = Model.Currency.Split('/')[0].Trim();
                    var totalD = items.Sum(s => s.TotalAmountD);
                    var total = currency + " " + string.Format("{0:#,##0.00}", totalD);

                    var discounted1D = totalD * Model.Discount1D / 100;
                    var discounted1 = currency + " " + string.Format("{0:#,##0.00}", discounted1D);

                    totalD = totalD - discounted1D;

                    var discounted2D = totalD * Model.Discount2D / 100;
                    var discounted2 = currency + " " + string.Format("{0:#,##0.00}", discounted2D);
                    totalD = totalD - discounted2D;

                    var discounted3D = totalD * Model.Discount3D / 100;
                    var discounted3 = currency + " " + string.Format("{0:#,##0.00}", discounted3D);
                    totalD = totalD - discounted3D;

                    var vatD = totalD * (decimal)(0.12);
                    var vat = string.Format("{0:#,##0.00}", vatD);
                    var total2 = currency + " " + string.Format("{0:#,##0.00}", totalD);
                }
                <td rowspan="4" style="vertical-align: top;">
                    <span class="sub-col w-50pc d-ib">TOTAL PURCHASE</span>
                    <strong class="sub-col w-50pc d-ib right">@total</strong>

                    @if (Model.Type.ToLower() != "maintenance & repair")
                    {
                        <span class="sub-col w-50pc d-ib">@(Model.Type.ToLower() != "maintenance & repair" ? "DISCOUNT 1 %" : "")</span>
                        <strong class="sub-col w-50pc d-ib right">@(Model.Type.ToLower() != "maintenance & repair" ? Model.Discount1 + "%" : "")</strong>

                        <span class="sub-col w-50pc d-ib">@(Model.Type.ToLower() != "maintenance & repair" ? "DISCOUNT AMOUNT" : "")</span>
                        <strong class="sub-col w-50pc d-ib right">@(Model.Type.ToLower() != "maintenance & repair" ? discounted1 : "")</strong>
                    }

                    @if (Model.Type.ToLower() == "local purchase order")
                    {
                        if (Model.Discount2D > 0)
                        {
                            <span class="sub-col w-50pc d-ib">@(Model.Type.ToLower() == "local purchase order" ? "Discount 2 %" : "")</span>
                            <strong class="sub-col w-50pc d-ib right">@(Model.Type.ToLower() == "local purchase order" ? Model.Discount2 + "%" : "")</strong>

                            <span class="sub-col w-50pc d-ib">DISCOUNT AMOUNT</span>
                            <strong class="sub-col w-50pc d-ib right">@discounted2</strong>
                        }
                        if (Model.Discount3D > 0)
                        {
                            <span class="sub-col w-50pc d-ib">@(Model.Type.ToLower() == "local purchase order" ? "Discount 3 %" : "")</span>
                            <strong class="sub-col w-50pc d-ib right">@(Model.Type.ToLower() == "local purchase order" ? Model.Discount3 + "%" : "")</strong>

                            <span class="sub-col w-50pc d-ib">DISCOUNT AMOUNT</span>
                            <strong class="sub-col w-50pc d-ib right">@discounted3</strong>
                        }
                    }

                    @if (Model.IsVATIncluded == "Yes")
                    {
                        <span class="sub-col w-50pc d-ib">VAT AMOUNT</span>
                        <strong class="sub-col w-50pc d-ib right">@vat</strong>
                    }
                    <hr class="sum" />
                    <span class="sub-col w-50pc d-ib">TOTAL AMOUNT</span>
                    <strong class="sub-col w-50pc d-ib right">@total2</strong>
                </td>
            </tr>
            <tr>
                <td colspan="2">DATE PO SENT:</td>
                <td colspan="2">@Model.DateModified</td>
            </tr>
            <tr>
                <td colspan="2">DATE RECEIVED:</td>
                <td colspan="2">@(string.IsNullOrWhiteSpace(Model.DateReceived) ? "N/A" : Model.DateReceived)</td>
            </tr>
            <tr>
                <td colspan="4">
                    <span style="display:block;">Remarks:</span>
                    <span>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "N/A" : Model.Remarks)</span>
                </td>
            </tr>
            <tr>
                <td colspan="@colcount">
                    <br />
                    <br />
                    <div class="two-column">
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.UserCreated</dd>
                                <dt>Prepared By</dt>
                            </dl>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.ApprovedBy</dd>
                                    <dt>Approved By</dt>
                                </dl>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.DisapprovedBy</dd>
                                    <dt>Disapproved By</dt>
                                </dl>
                            </div>
                        }
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="@colcount">
                    @if(Model.WarehouseName == "CETACIO" || Model.WarehouseName == "SEVERINO" || Model.WarehouseName == "PASIG2")
                    {
                        <p class="footer center-text"> Bina's Auto Supply Inc. | 1034 Kusang Loob St. Brgy. 330 Zone 033 Sta. Cruz, Manila | Tel. No.8731-3923,8741-5537/39 </p>
                    }
                    else if(Model.WarehouseName == "PASIG1")
                    {
                        <p class="footer center-text"> 3BAS Tigers INC. | 538 Manila Mahogany Compound, M.R.R St. Manggahan, Pasig City | Tel. No.N/A </p>
                    }
                </td>
            </tr>
        </tfoot>
    </table>
</body>
</html>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>