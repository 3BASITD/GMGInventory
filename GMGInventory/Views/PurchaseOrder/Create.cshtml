@{
    if (TempData["PurchaseOrderId"] != null)
    {
        ViewData["Title"] = "Resubmit Purchase Order";
    }
    else
    {

        ViewData["Title"] = "New Purchase Order";
    }
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseOrder" asp-action="Index">Purchase Orders</a></li>
}

<div class="card card-default">
    <form id="form-order">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                    <span class="fas fa-paper-plane"></span> @(TempData["PurchaseOrderId"] != null ? "Resubmit" : "Submit")
                </button>
                <input type="hidden" id="action-type" name="ActionType" value="">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-document-number" class="form-label mb-0">Document Number</label>
                        <input type="text" id="order-document-number" name="DocumentNumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-type" class="form-label mb-0">Type</label>
                        <select id="order-type" name="Type" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-supplier" class="form-label mb-0">Supplier</label>
                        <select id="order-supplier" name="Supplier" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-terms" class="form-label mb-0">Terms</label>
                        <select id="order-terms" name="Terms" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-currency" class="form-label mb-0">Currency</label>
                        <select id="order-currency" name="Currency" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-currency-rate" class="form-label mb-0">Currency Rate</label>
                        <input type="number" step="0.001" id="order-currency-rate" name="CurrencyRate" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6 order-mode-container">
                    <div class="form-group">
                        <label for="order-mode" class="form-label mb-0">Mode of Delivery</label>
                        <select id="order-mode" name="DeliveryMode" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-delivery-address" class="form-label mb-0">Delivery Address</label>
                        <select id="order-delivery-address" name="DeliveryAddress" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-date-ordered" class="form-label mb-0">Date Ordered</label>
                        <input type="date" id="order-date-ordered" name="OrderDate" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6 order-reference-container">
                    <div class="form-group">
                        <label for="order-reference" class="form-label mb-0">Canvas Summary Reference</label>
                        <input type="text" id="order-reference" name="Reference" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="order-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Purchase Order Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Purchase Request Ref#</th>
                                        <th>Item Code</th>
                                        <th>Part Number</th>
                                        <th>Item Description</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Cost</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th>Total</th>
                                        <th class="total-quantity">0</th>
                                        <th></th>
                                        <th></th>
                                        <th class="total-total">0</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Purchase Order Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Purchase Order Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6 add-so-number-container">
                            <div class="form-group">
                                <label for="add-pr-number" class="form-label mb-0">Purchase Request Ref#</label>
                                <select id="add-pr-number" name="PRNumber" style="width: 100%;">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-code-container">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Item Code</label>
                                <input type="text" id="add-code" name="Code" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-part-container">
                            <div class="form-group">
                                <label for="add-part" class="form-label mb-0">Part Number</label>
                                <input type="text" id="add-part" name="PartNumber" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-name-container">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Item Name</label>
                                <select id="add-name" name="Name" style="width: 100%;">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-quantity-container">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" step="1" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-unit-container">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-unit-cost-container">
                            <div class="form-group">
                                <label for="add-unit-cost" class="form-label mb-0">Unit Cost</label>
                                <input type="text" id="add-unit-cost" name="UnitCost" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-total-amount-container">
                            <div class="form-group">
                                <label for="add-total-amount" class="form-label mb-0">Total Amount</label>
                                <input type="text" id="add-total-amount" name="TotalAmount" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["PurchaseOrderId"] != null)
{
    <input type="hidden" id="resubmitPOId" value="@TempData["PurchaseOrderId"]" />
}

@section Scripts {
    <script>
        var currentType = -1;
        if ($("#resubmitPOId").length) {
            // for resubmitting a disapproved sales order
            $.ajax({
                type: "post",
                url: "@Url.Action("DetailsJson")",
                data: {
                    id: $("#resubmitPOId").val()
                },
                success: function (data, status, xhr) {
                    currentType = data.typeId;
                    loadTypeOptions(currentType);
                    $("#request-purpose-definition").val(data.purposeId == null ? data.purpose : "");
                    $("#request-region").val(data.regionId).trigger("change");
                    $("#request-date-requested").val(data.requestDate3);
                    $("#request-remarks").val(data.remarks);
                },
                complete: function (xhr, status) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetItemListJson")",
                        data: {
                            purchaseOrderId: $("#resubmitPOId").val()
                        },
                        success: function (data, status, xhr) {
                            $.each(data, function (i, v) {
                                itemDT.row.add(v).draw();
                            });
                        }
                    });
                }
            });
        } else {
            loadTypeOptions(currentType);
        }

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top" role="tooltip"><i class="fas fa-minus"></i></button>';
                        actions += '<button type="button" class="btn btn-info btn-xs btn-up-item" data-microtip-title="Move Up Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-up"></i></button>';
                        actions += '<button type="button" class="btn btn-info btn-xs btn-down-item" data-microtip-title="Move Down Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-down"></i></button>';
                        return actions + '</div>';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                { data: "salesOrderNumber", name: "SalesOrderNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "-";
                        } else {
                            return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemPartNumber", name: "ItemPartNumber", className: "form-cell" },
                { data: "itemDescription", name: "ItemDescription", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" step="1" value="' + data.stockOnHandD + '" class="form-control form-control-sm stock" style="width: 100%;" />';
                    },
                    name: "StockOnHand",
                    className: "form-cell text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                { data: "purpose", name: "Purpose", className: "form-cell" }
            ],
            order: [[1, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 7);
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".btn-remove-item").on("click", function () {
                itemDT.row($(this).parents('tr')).remove().draw();
            });

            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var rowData = this.data();
                if (rowData.lineNumber == 1)
                    $(this.node()).find(".btn-up-item").hide();
                else
                    $(this.node()).find(".btn-up-item").show();

                if (rowData.lineNumber == Math.max.apply(Math, itemDT.column(1).data().toArray()))
                    $(this.node()).find(".btn-down-item").hide();
                else
                    $(this.node()).find(".btn-down-item").show();
            });

            $(".btn-up-item").off("click").on("click", function () {
                var row = $(this).parents('tr');
                var rowData = itemDT.row(row).data();

                var currentLineNumber = rowData.lineNumber;
                var newLineNumber = currentLineNumber - 1;

                var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                    return itemDT.row(index).data().lineNumber === newLineNumber;
                });

                if (targetRowIndex != undefined) {
                    var targetRowData = itemDT.row(targetRowIndex).data();
                    targetRowData.lineNumber = currentLineNumber;
                    itemDT.row(targetRowIndex).data(targetRowData);
                }

                rowData.lineNumber = newLineNumber;
                itemDT.row(row).data(rowData);

                itemDT.draw();
            });

            $(".btn-down-item").off("click").on("click", function () {
                var row = $(this).parents('tr');
                var rowData = itemDT.row(row).data();
                var currentLineNumber = rowData.lineNumber;
                var newLineNumber = currentLineNumber + 1;

                var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                    return itemDT.row(index).data().lineNumber == newLineNumber;
                });

                if (targetRowIndex != undefined) {
                    var targetRowData = itemDT.row(targetRowIndex).data();
                    targetRowData.lineNumber = currentLineNumber;
                    itemDT.row(targetRowIndex).data(targetRowData);
                }

                rowData.lineNumber = newLineNumber;
                itemDT.row(row).data(rowData);

                itemDT.draw();
            });

            ComputeTotalQuantity();
            $(".quantity").on("input", function () {
                ComputeTotalQuantity();
            });
        });

        // Load order type data for select2
        function loadTypeOptions(selectedType) {
            $("#order-type").off("change");
            $("#order-type").empty().trigger('change');
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetTypeOptions")",
                data: {
                    SelectedId: selectedType
                },
                success: function (data, status, xhr) {
                    $("#order-type").select2({
                        data: data,
                        minimumResultsForSearch: -1
                    }).on("change", function () {
                        loadDocumentNumber();
                        changingType();
                    });
                },
                complete: function (xhr, status) {
                    loadDocumentNumber();
                    changingType();
                }
            });
        }

        function loadDocumentNumber() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetNewDocumentNumber")",
                data: {
                    TypeId: $("#order-type").val()
                },
                success: function (data, status, xhr) {
                    $("#order-document-number").val(data);
                }
            });
        }

        function changingType() {
            var selectedType = $("#order-type").val();
            if (itemDT.data().length > 0 && selectedType != currentType) {
                swal({
                    title: "Items not empty",
                    text: "Changing the selected Order Type will clear the added items. Do you want to continue?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        swal.close();
                        itemDT.clear().draw();
                        currentType = selectedType;
                    } else {
                        $("#order-type").val(currentType).trigger("change");
                    }
                });
            } else {
                currentType = selectedType;
            }

            var defaultOption = $("#order-mode").find('option').eq(0).val();
            $("#order-mode").val(defaultOption).trigger('change');
            $("#order-reference").val("");

            var typeText = $("#order-type").select2("data")[0]?.text || "";
            if (typeText == "Non-Automotive") {
                $(".order-mode-container").toggle(true);
                $(".order-reference-container").toggle(false);
                itemDT.column(4).visible(false);
                itemDT.column(5).visible(true);
            } else if (typeText == "Local Purchase Order" || typeText == "International Purchase Order") {
                $(".order-mode-container").toggle(true);
                $(".order-reference-container").toggle(true);
                itemDT.column(4).visible(true);
                itemDT.column(5).visible(false);
            } else if (typeText == "Maintenance & Repair") {
                var deliveryOption = $("#order-mode").find('option').filter(function () {
                    return $(this).text().toUpperCase() === "DELIVERY";
                }).first();

                if (deliveryOption.length) {
                    $("#order-mode").val(deliveryOption.val()).trigger('change');
                }
                $(".order-mode-container").toggle(false);
                $(".order-reference-container").toggle(false);
                itemDT.column(4).visible(false);
                itemDT.column(5).visible(false);
            }
            updateColumnVisibility();
            loadAllItemsOptions();

            loadPurchaseRequestOptions();
        }

        var columnVisibilityMap = {
            "Automotive_Rush Order": [true, true, true, true, true, true, true, false],
            "Automotive_Stocking": [false, true, true, true, true, true, true, false],
            "Non-Automotive_Office Supplies": [false, true, false, true, true, true, true, false],
            "Non-Automotive_One-Time Purchase": [false, false, false, true, false, true, true, true],
            "Maintenance & Repair_": [false, false, false, true, false, true, true, true]
        };

        function updateColumnVisibility() {
            var key = $("#order-type").select2("data")[0]?.text || "";

            if (columnVisibilityMap[key]) {
                columnVisibilityMap[key].forEach(function (visible, index) {
                    itemDT.column(index + 2).visible(visible);
                });

                $(".add-so-number-container").toggle(columnVisibilityMap[key][0]);
                if (columnVisibilityMap[key][1]) {
                    $(".add-code-container").toggle(true);
                    $("#add-name").prop("readonly", true);
                    $(".add-unit-container").toggle(true);
                    $(".add-unit2-container").toggle(false);
                } else {
                    $(".add-code-container").toggle(false);
                    $("#add-name").prop("readonly", false);
                    $(".add-unit-container").toggle(false);
                    $(".add-unit2-container").toggle(true);
                }
                $(".add-part-container").toggle(columnVisibilityMap[key][2]);
                $(".add-name-container").toggle(columnVisibilityMap[key][3]);
                $(".add-stock-container").toggle(columnVisibilityMap[key][4]);
                // $(".add-quantity-container").toggle(columnVisibilityMap[key][5]);
                // $(".add-unit-container").toggle(columnVisibilityMap[key][6]);
                $(".add-purpose-container").toggle(columnVisibilityMap[key][7]);
            }
        }

        // function checkIfRequired(name) {
        //     var key = $("#request-type").select2("data")[0]?.text || "";

        //     if (name == "SONumber") return columnVisibilityMap[key][0];
        //     else if (name == "Code") return columnVisibilityMap[key][1];
        //     else if (name == "Name") return columnVisibilityMap[key][3];
        //     else if (name == "Quantity") return columnVisibilityMap[key][5];
        //     else if (name == "Purpose") return columnVisibilityMap[key][6];
        //     else return false;
        // }

        // Load supplier for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Supplier")",
            success: function (data, status, xhr) {
                $("#order-supplier").select2({
                    minimumInputLength: -1,
                    placeholder: "<empty>",
                    templateResult: function (repo) {
                        if (repo.loading) {
                            return repo.text;
                        }
                        return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                    },
                    data: data
                });
            }
        });

        // Load terms for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CreditTerm")",
            success: function (data, status, xhr) {
                $("#order-terms").select2({
                    minimumResultsForSearch: -1,
                    placeholder: "<empty>",
                    data: data
                });
            }
        });

        // Load currency for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetCurrencyOptions", "ReplenishInventory")",
            success: function (data, status, xhr) {
                $("#order-currency").select2({
                    minimumResultsForSearch: -1,
                    placeholder: "<empty>",
                    data: data
                });
                $("#order-currency-rate").val($("#order-currency").select2("data")[0].rate);
                $("#order-currency").on("select2:select", function () {
                    $("#order-currency-rate").val($("#order-currency").select2("data")[0].rate);
                });
            }
        });

        // Load delivery mode for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetDeliveryModeOptions")",
            success: function (data, status, xhr) {
                $("#order-mode").select2({
                    minimumResultsForSearch: -1,
                    placeholder: "<empty>",
                    data: data
                });
            }
        });

        // Load delivery address data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Warehouse")",
            success: function (data, status, xhr) {
                $("#order-delivery-address").select2({
                    data: data,
                    minimumResultsForSearch: -1,
                    templateResult: function (repo) {
                        if (repo.loading) {
                            return repo.text;
                        }
                        return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                    },
                });
            }
        });

        function loadPurchaseRequestOptions() {
            if ($.fn.select2 && $("#add-pr-number").hasClass("select2-hidden-accessible")) {
                $("#add-pr-number").select2("destroy");
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseRequestOptions")",
                data: {
                    RequestTypeId: function() {
                        return $("#order-type").select2("data")[0].requestTypeId;
                    }//,
                    //SelectedId: ???
                },
                success: function (data, status, xhr) {
                    $("#add-pr-number").select2({
                        data: data,
                        minimumInputLength: -1,
                        placeholder: "<empty>",
                        language: {
                            noResults: function () {
                                return "No request found";
                            }
                        },
                        dropdownParent: $("#addModal")
                    }).on("select2:select", function () {
                        loadAllItemsOptions();
                    });
                }
            });
        }

        loadAllItemsOptions();
        function loadAllItemsOptions() {
            if ($.fn.select2 && $("#add-name").hasClass("select2-hidden-accessible")) {
                $("#add-name").select2("destroy");
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseRequestItemOptions")",
                data: {
                    RequestId: function () {
                        return $("#add-pr-number").val();
                    }
                },
                success: function (data, status, xhr) {
                    $("#add-name").select2({
                        data: data,
                        minimumResultsForSearch: -1,
                        placeholder: "<empty>",
                        language: {
                            noResults: function () {
                                return "No unserved items found";
                            }
                        },
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $(
                                "<strong>" + repo.text + "</strong><br />" +
                                "<small class='text-muted'>" +
                                "Request Quantity: " + repo.quantity + "<br />" +
                                "Served Quantity: " + repo.served + "<br />" +
                                "Unserved Quantity: " + (repo.quantity - repo.served) +
                                "</small>"
                            );
                        },
                        dropdownParent: $("#addModal")
                    }).on("select2:select", function() {
                        $("#add-code").val($(this).select2("data")[0].itemCode);
                        $("#add-part").val($(this).select2("data")[0].partNumber);
                    });
                }
            });
        }

        function loadSOItemsOptions() {
            $("#add-code").val(null).trigger("change");
            $("#add-part").val("");
            $("#add-name").val("");
            $("#add-stock").val(0);
            $("#add-quantity").val(0);
            $("#add-unit").val("");

            if ($.fn.select2 && $("#add-code").hasClass("select2-hidden-accessible")) {
                $("#add-code").select2("destroy");
            }
            // Load item for select2
            $("#add-code").select2({
                minimumInputLength: -1,
                allowClear: true,
                placeholder: "<empty>",
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    if (repo.quantity == 0) {
                        return $("<span style='color: #ccc;'><strong>" + repo.text + "</strong> " +
                            (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : "") +
                            "</span>");
                    } else {
                        return $("<strong>" + repo.text + "</strong> " +
                            (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                    }
                },
                ajax: {
                    url: "@Url.Action("GetUnservedOptions", "Item")",
                    dataType: 'json',
                    type: "POST",
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1,
                            SalesOrderId: $("#add-so-number").val()
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true,
                    complete: AssignItemEvent
                },
                dropdownParent: $("#addModal")
            });
        }

        function AssignItemEvent(jqXHR, textStatus) {
            $("#add-code").off("select2:select").on("select2:select", function () {
                $("#add-part").val($("#add-code").select2("data")[0].partNumber);
                $("#add-name").val($("#add-code").select2("data")[0].name);
                $("#add-unit").val($("#add-code").select2("data")[0].unit);
                $("#add-unit").data("Id", $("#add-code").select2("data")[0].unitId);
                $("#add-stock").val($("#add-code").select2("data")[0].inventoryCount);
                $("#add-code-error").html("");
            });

            $("#add-code").off("select2:unselecting").on("select2:unselecting", function (e) {
                $("#add-part").val("");
                $("#add-name").val("");
                $("#add-unit").val("");
                $("#add-unit").data("Id", "");
                $(".add-stocks").text("0");
                $("#add-gross-price").val("0.00");
            });
        }

        // Load so for select2
        $("#add-so-number").select2({
            minimumInputLength: -1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                return repo.text;
            },
            ajax: {
                url: "@Url.Action("GetSalesOrderOptions", "SalesOrder")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#addModal")
        });

        $("#add-so-number").on("select2:select", loadSOItemsOptions);

        // Load unit for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Unit")",
            success: function (data, status, xhr) {
                $("#add-unit2").select2({
                    data: data,
                    minimumResultsForSearch: -1,
                    placeholder: "<empty>",
                    dropdownParent: $("#addModal")
                }).on("change", function () {
                    $("#add-unit").val($("#add-unit2").select2("data")[0].text);
                    $("#add-unit").data("Id", $("#add-unit2").select2("data")[0].id);
                });
            }
        });

        $(".createBtn").on("click", clearItemForm);

        function clearItemForm() {
            $("#add-so-number").val("").trigger("change");
            $("#add-code").val("").trigger("change");
            $("#add-part").val("");
            $("#add-name").val("");
            $("#add-quantity").val("0");
            $("#add-stock").val("0");
            $("#add-unit").val("");
            $("#add-unit").data("Id", "");
            $("#add-purpose").val("");
        }

        function ComputeTotalQuantity() {
            total_quantity = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            rules: {
                SONumber: {
                    required: true// function () { return checkIfRequired("SONumber"); }
                },
                Code: {
                    required: true// function () { return checkIfRequired("Code"); }
                },
                Name: {
                    required: true,// function () { return checkIfRequired("Name"); },
                    maxlength: 100
                },
                Stock: {
                    number: true
                },
                Quantity: {
                    required: true,// function () { return checkIfRequired("Quantity"); },
                    number: true,
                    isNotZero: true
                },
                Purpose: {
                    required: true,// function () { return checkIfRequired("Purpose"); },
                    maxlength: 100
                }
            },
            messages: {
                SONumber: {
                    required: "Please select a SO Number."
                },
                Code: {
                    required: "Please select an Item."
                },
                Name: {
                    required: "Please enter the name of item.",
                    maxlength: "Name must not exceed 100 characters."
                },
                Stock: {
                    number: "Please enter a valid number."
                },
                Quantity: {
                    required: "Please enter a quantity.",
                    number: "Please enter a valid number.",
                    isNotZero: "Can not request an item with 0 quantity."
                },
                Purpose: {
                    required: "Please enter the purpose.",
                    maxlength: "Purpose must not exceed 100 characters."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.itemDescription == $("#add-name").val()) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastr.warning($("#add-code").select2("data")[0].text + " has already been added", "Duplicate");
            } else {
                itemDT.row.add({
                    itemCode: $("#add-code").select2("data")[0].text,
                    itemDescription: $("#add-name").val(),
                    itemPartNumber: $("#add-part").val(),
                    itemId: $("#add-code").select2("data")[0].id,
                    lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                    purchaseRequestId: 0,
                    purpose: $("#add-purpose").val(),
                    quantity: FormatStringInteger($("#add-quantity").val()),
                    quantityD: $("#add-quantity").val() || 0,
                    salesOrderId: $("#add-so-number").select2("data")[0].id,
                    salesOrderNumber: $("#add-so-number").select2("data")[0].text,
                    stockOnHand: FormatStringInteger($("#add-stock").val()),
                    stockOnHandD: $("#add-stock").val() || 0,
                    unitCode: $("#add-unit").val(),
                    unitId: $("#add-unit").data("Id")
                }).draw();
                clearItemForm();

                toastr.success("Added " + $("#add-code").select2("data")[0].text + " on Purchase Request Item(s)", "Success");
            }
        }

        function GetItemsToRequest() {
            var item_to_request = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));
                row_data.stockOnHandD = parseInt($(this.node()).find(".stock").val());
                row_data.stockOnHand = FormatStringInteger(parseInt($(this.node()).find(".stock").val()));
                item_to_request.push(row_data);
            });
            return item_to_request;
        }

        $("#form-request button[type=submit]").on("click", function () {
            $("#action-type").val($(this).data("action"));
        });

        // Validation for Create
        var validateCreate = $("#form-request").validate({
            rules: {
                Type: {
                    required: true
                },
                Purpose: {
                    required: function () {
                        return $("#request-type").select2("data")[0]?.text != "Maintenance & Repair";
                    }
                },
                PurposeDefinition: {
                    required: function () {
                        return $("#request-type").select2("data")[0]?.text == "Maintenance & Repair";
                    },
                    maxlength: 250
                },
                Region: {
                    required: function () {
                        return $("#request-type").select2("data")[0]?.text == "Automotive"
                            && $("#request-purpose").select2("data")[0]?.text == "Rush Order";
                    }
                },
                DateRequested: {
                    required: true
                },
                Remarks: {
                    required: true,
                    maxlength: 100
                }
            },
            messages: {
                Type: {
                    required: "Please select a type."
                },
                Purpose: {
                    required: "Please select a purpose."
                },
                PurposeDefinition: {
                    required: "Please enter a purpose.",
                    maxlength: "Purpose can not exceed 250 characters."
                },
                Region: {
                    required: "Please select a region."
                },
                DateRequested: {
                    required: "Please enter the date of request."
                },
                Remarks: {
                    required: "Please enter a remarks",
                    maxlength: "Remarks can not exceed 100 characters."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveRequest();
            }
        });

        function GetItemsToRequest() {
            var item_to_request = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                row_data.quantityD = parseInt($(this.node()).find(".quantity").val());
                row_data.quantity = FormatStringInteger(parseInt($(this.node()).find(".quantity").val()));
                row_data.stockOnHandD = parseInt($(this.node()).find(".stock").val());
                row_data.stockOnHand = FormatStringInteger(parseInt($(this.node()).find(".stock").val()));
                item_to_request.push(row_data);
            });
            return item_to_request;
        }

        function SaveRequest() {
            var items = itemDT.data();
            if (items.length == 0) {
                toastr.warning("No item to request. Add an item to the list to continue", "Warning");
            } else if (items.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't request an item with 0 quantity", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddJson")",
                    data: {
                        TypeId: $("#request-type").val(),
                        PurposeId: $("#request-purpose").val(),
                        PurposeDefinition: $("#request-purpose-definition").val(),
                        RegionId: $("#request-region").val(),
                        DateRequested: $("#request-date-requested").val(),
                        Remarks: $("#request-remarks").val(),
                        Status: $("#action-type").val(),
                        ResubmitId: $("#resubmitPRId").val(),
                        Items: GetItemsToRequest()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
}
