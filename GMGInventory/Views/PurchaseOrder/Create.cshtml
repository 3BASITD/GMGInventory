@{
    ViewData["Title"] = "New Replenish Order";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseOrder" asp-action="Index">Replenish Orders</a></li>
}

<div class="card card-default">
    <form id="form-replenish">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" value="Replenish">
                    <span class="fas fa-sync"></span> Replenish Item
                </button>
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" value="Draft">
                    <span class="fab fa-firstdraft"></span> Save as Draft
                </button>
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="replenish-supplier" class="form-label mb-0">Supplier</label>
                        <select id="replenish-supplier" name="Supplier" style="width: 100%"></select>
                        <span data-valmsg-for="replenish-source" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="replenish-address1" class="form-label mb-0">Address Line 1</label>
                        <input type="text" id="replenish-address1" name="Address1" class="form-control form-control-sm" readonly="readonly" />
                        <span data-valmsg-for="replenish-address1" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="replenish-address2" class="form-label mb-0">Address Line 2</label>
                        <input type="text" id="replenish-address2" name="Address2" class="form-control form-control-sm" readonly="readonly" />
                        <span data-valmsg-for="replenish-address2" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="replenish-destination" class="form-label mb-0">Destination Warehouse</label>
                        <select id="replenish-destination" name="Destination" style="width: 100%"></select>
                        <span data-valmsg-for="replenish-destination" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="replenish-date" class="form-label mb-0">Replenish Date</label>
                        <input type="date" id="replenish-date" name="ReplenishDate" class="form-control form-control-sm" />
                        <span data-valmsg-for="replenish-date" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="replenish-currency" class="form-label mb-0">Currency</label>
                        <select id="replenish-currency" name="Currency" style="width: 100%"></select>
                        <span data-valmsg-for="replenish-currency" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="replenish-currency-rate" class="form-label mb-0">Currency Rate</label>
                        <input type="number" id="replenish-currency-rate" name="CurrencyRate" step="0.01" min="0" max="1999999" class="form-control form-control-sm" />
                        <span data-valmsg-for="replenish-currency-rate" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="replenish-reference-number" class="form-label mb-0">Reference Number</label>
                        <input type="text" id="replenish-reference-number" name="ReferenceNumber" class="form-control form-control-sm" />
                        <span data-valmsg-for="replenish-reference-number" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Replenish Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Replenish Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Price</th>
                                        <th>Discount 1</th>
                                        <th>Discount 2</th>
                                        <th>Discount 3</th>
                                        <th>Net Price</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="3" class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th colspan="5"></th>
                                        <th class="total-net-price">0.00</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Save Replenish Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Replenish Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Code</label>
                                <div>
                                    <select id="add-code" name="Code" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                                <span data-valmsg-for="add-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Name</label>
                                <input type="text" id="add-name" name="Name" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="add-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                <span data-valmsg-for="add-quantity" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit-price" class="form-label mb-0">Unit Price</label>
                                <input type="number" step="0.01" min="0" max="1999999.99" id="add-unit-price" name="UnitPrice" class="form-control form-control-sm" />
                                <span data-valmsg-for="add-unit-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount1" class="form-label mb-0">Discount 1</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount1" name="Discount1" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="add-discount1" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount2" class="form-label mb-0">Discount 2</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount2" name="Discount2" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="add-discount2" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount3" class="form-label mb-0">Discount 3</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount3" name="Discount3" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="add-discount3" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-net-price" class="form-label mb-0">Net Price</label>
                                <input type="number" id="add-net-price" name="NetPrice" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="add-net-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load supplier data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Supplier")",
            success: function (data, status, xhr) {
                $("#replenish-supplier").select2({
                    data: data
                });
                $("#replenish-address1").val($("#replenish-supplier").select2("data")[0].address1);
                $("#replenish-address2").val($("#replenish-supplier").select2("data")[0].address2);
            }
        });

        $("#replenish-supplier").on("select2:select", function () {
            $("#replenish-address1").val($("#replenish-supplier").select2("data")[0].address1);
            $("#replenish-address2").val($("#replenish-supplier").select2("data")[0].address2);
        });

        // Load destination data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Warehouse")",
            success: function (data, status, xhr) {
                $("#replenish-destination").select2({
                    data: data
                });
            }
        });

        // Load currency data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetCurrencyOptions")",
            success: function (data, status, xhr) {
                $("#replenish-currency").select2({
                    data: data
                });
                $("#replenish-currency-rate").val($("#replenish-currency").select2("data")[0].rate);
                $("#replenish-currency").on("select2:select", function () {
                    $("#replenish-currency-rate").val($("#replenish-currency").select2("data")[0].rate);
                });
            }
        });

        // Load item for select2
        $("#add-code").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#addModal")
        });

        $("#add-code").on("select2:select", function () {
            $("#add-name").val($("#add-code").select2("data")[0].name);
            $("#add-unit").val($("#add-code").select2("data")[0].unit);
            $("#add-code-error").html("");
        });

        $("#add-code").on("select2:unselecting", function (e) {
            $("#add-name").val("");
            $("#add-unit").val("");
        });

        $("#add-quantity, #add-unit-price, #add-discount1, #add-discount2, #add-discount3").on("input", function () {
            var quantity = parseFloat($("#add-quantity").val());
            var unit_price = parseFloat($("#add-unit-price").val());
            var discount1 = parseFloat($("#add-discount1").val());
            var discount2 = parseFloat($("#add-discount2").val());
            var discount3 = parseFloat($("#add-discount3").val());

            var discounted1 = DeductDiscount(unit_price, discount1);
            var discounted2 = DeductDiscount(discounted1, discount2);
            var discounted3 = DeductDiscount(discounted2, discount3);
            //$("#add-net-price").val(Round2Decimal(quantity * (((100 - discount1 - discount2 - discount3) * unit_price) / 100)));
            $("#add-net-price").val(Round2Decimal(quantity * discounted3));
        });

        function clearItemForm() {
            $("#add-code").val("").trigger("change");
            $("#add-name").val("");
            $("#add-quantity").val("0");
            $("#add-unit").val("");
            $("#add-unit-price").val("0");
            $("#add-discount1").val("0");
            $("#add-discount2").val("0");
            $("#add-discount3").val("0");
            $("#add-net-price").val("0");
        }

        $(".createBtn").on("click", clearItemForm);

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Code: { required: true },
                Quantity: { required: true, isNotZero: true },
                UnitPrice: { required: true }
            },
            messages: {
                Code: { required: "Please select item to replenish." },
                Quantity: { required: "Please enter a quantity", isNotZero: "Can not replenish an item with 0 quantity" },
                UnitPrice: { required: "Please enter the unit cost" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            },
            showErrors: validateShowErrors
        });

        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.id === $("#add-code").select2("data")[0].id) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastrNoDuplicate($("#add-code").select2("data")[0].text + " has already been added", "Duplicate", "warning");
            } else {
                itemDT.row.add({
                    id: $("#add-code").select2("data")[0].id,
                    code: $("#add-code").select2("data")[0].text,
                    name: $("#add-code").select2("data")[0].name,
                    quantity: $("#add-quantity").val() || 0,
                    unit: $("#add-code").select2("data")[0].unit,
                    unitPrice: Round2Decimal($("#add-unit-price").val() || 0),
                    discount1: Round2Decimal($("#add-discount1").val() || 0),
                    discount2: Round2Decimal($("#add-discount2").val() || 0),
                    discount3: Round2Decimal($("#add-discount3").val() || 0),
                    netPrice: Round2Decimal($("#add-net-price").val() || 0),
                }).draw();
                clearItemForm();
            }
        }

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top-left" role="tooltip"><i class="fas fa-minus"></i></button>';
                        return actions;
                    }
                },
                { data: "code", name: "Code", className: "form-cell" },
                { data: "name", name: "Name", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" value="' + data.quantity + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                    },
                    name: "Quantity",
                    className: "text-end"
                },
                { data: "unit", name: "Name", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" step="0.01" max="1999999.99" value="' + data.unitPrice + '" class="form-control form-control-sm unitprice" style="width: 100%;" />';
                    },
                    name: "UnitPrice"
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + data.discount1 + '" class="form-control form-control-sm discount1" /><span class="input-group-text">%</span></div>';
                    },
                    name: "Discount1"
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + data.discount2 + '" class="form-control form-control-sm discount2" /><span class="input-group-text">%</span></div>';
                    },
                    name: "Discount2"
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + data.discount3 + '" class="form-control form-control-sm discount3" /><span class="input-group-text">%</span></div>';
                    },
                    name: "Discount3"
                },
                {
                    data: "netPrice",
                    name: "NetPrice",
                    className: "form-cell text-end netprice"
                }
            ]
        });

        itemDT.on("draw", function () {
            $(".btn-remove-item").on("click", function () {
                itemDT.row($(this).parents('tr')).remove().draw();
            });
            $(".table-item th").removeClass("form-cell");
            //$(".table-item th").removeClass("text-end");

            $(".quantity, .unitprice, .discount1, .discount2, .discount3").on("input", function () {
                var quantity = parseInt($(this).parents("tr").find(".quantity").val());
                var unit_price = parseFloat($(this).parents("tr").find(".unitprice").val());
                var discount1 = parseFloat($(this).parents("tr").find(".discount1").val());
                var discount2 = parseFloat($(this).parents("tr").find(".discount2").val());
                var discount3 = parseFloat($(this).parents("tr").find(".discount3").val());

                var discounted1 = DeductDiscount(unit_price, discount1);
                var discounted2 = DeductDiscount(discounted1, discount2);
                var discounted3 = DeductDiscount(discounted2, discount3);
                //var net_price = FormatStringDecimal(Round2Decimal(quantity * (((100 - discount1 - discount2 - discount3) * unit_price) / 100)));
                var net_price = FormatStringDecimal(Round2Decimal(quantity * discounted3));
                $(this).parents("tr").find(".netprice").html(net_price);
                ComputeTotalQuantity();
                ComputeTotalNetPrice();
            });

            ComputeTotalQuantity();
            ComputeTotalNetPrice();
        });

        function ComputeTotalQuantity() {
            total_quantity = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        function ComputeTotalNetPrice() {
            total_net_prices = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_net_prices += parseFloat($(this.node()).find(".netprice").html().replace(",", ""));
            });
            $(".total-net-price").html(FormatStringDecimal(total_net_prices));
        }

        itemDT.clear().draw();

        function GetItemsToReplenish() {
            var item_to_replenish = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                var row_unitprice = parseFloat($(this.node()).find(".unitprice").val());
                var row_discount1 = parseFloat($(this.node()).find(".discount1").val());
                var row_discount2 = parseFloat($(this.node()).find(".discount2").val());
                var row_discount3 = parseFloat($(this.node()).find(".discount3").val());
                item_to_replenish.push({
                    item: row_data.id,
                    quantity: row_quantity,
                    unitPrice: row_unitprice,
                    discount1: row_discount1,
                    discount2: row_discount2,
                    discount3: row_discount3
                });
            });
            return item_to_replenish;
        }

        // Validation for Create
        var validateCreate = $("#form-replenish").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                ReplenishDate: { required: true },
                CurrencyRate: { required: true, isNotZero: true },
                ReferenceNumber: { maxlength: 100 }

            },
            messages: {
                ReplenishDate: { required: "Please enter date of replenish." },
                Quantity: { required: "Please enter a currency rate", isNotZero: "Currency rate cannot be 0" },
                ReferenceNumber: { maxlength: "Reference number must not exceed 100 characters." }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveReplenish(event.originalEvent.submitter.value);
            },
            showErrors: validateShowErrors
        });

        function SaveReplenish(submitter) {
            var itemsToReplenish = GetItemsToReplenish();
            if (itemsToReplenish.length == 0) {
                toastrNoDuplicate("No item to replenish. Add an item to the list to continue", "Warning", "warning");
            } else if (itemsToReplenish.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastrNoDuplicate("Some items have 0 quantity. Can't replenish an item with 0 quantity", "Warning", "warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveJson")",
                    data: {
                        type: submitter,
                        Supplier: $("#replenish-supplier").val(),
                        Destination: $("#replenish-destination").val(),
                        ReplenishDate: $("#replenish-date").val(),
                        Currency: $("#replenish-currency").val(),
                        CurrencyRate: $("#replenish-currency-rate").val(),
                        ReferenceNumber: $("#replenish-reference-number").val(),
                        Items: itemsToReplenish
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastrNoDuplicate(data.message, "Error", "error");
                        } else {
                            //toastrNoDuplicate(data.message, "Success", "success");
                            //toastrNoDuplicate("Page will redirect to details", "Warning", "warning");
                            //toastr.warning("Page will redirect to details", 'Page Redirect', {
                            //    timeOut: 3000,
                            //    onHidden: function () {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                            //    },
                            //    progressBar: true
