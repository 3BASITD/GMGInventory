@{
    if (TempData["PurchaseOrderId"] != null)
    {
        ViewData["Title"] = "Resubmit Purchase Order";
    }
    else
    {

        ViewData["Title"] = "New Purchase Order";
    }
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="PurchaseOrder" asp-action="Index">Purchase Orders</a></li>
}

<div class="card card-default">
    <form id="form-order">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                    <span class="fas fa-paper-plane"></span> @(TempData["PurchaseOrderId"] != null ? "Resubmit" : "Submit")
                </button>
                <input type="hidden" id="action-type" name="ActionType" value="">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-document-number" class="form-label mb-0">Document Number</label>
                        <input type="text" id="order-document-number" name="DocumentNumber" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-type" class="form-label mb-0">Type</label>
                        <select id="order-type" name="Type" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6 order-purpose-container">
                    <div class="form-group">
                        <label for="order-purpose" class="form-label mb-0">Request Purpose</label>
                        <select id="order-purpose" name="Purpose" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6 order-region-container">
                    <div class="form-group">
                        <label for="order-region" class="form-label mb-0">Region</label>
                        <select id="order-region" name="Region" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-supplier" class="form-label mb-0">Supplier</label>
                        <select id="order-supplier" name="Supplier" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-terms" class="form-label mb-0">Terms</label>
                        <select id="order-terms" name="Terms" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-currency" class="form-label mb-0">Currency</label>
                        <input type="text" id="order-currency" name="Currency" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-currency-rate" class="form-label mb-0">Currency Rate</label>
                        <input type="text" id="order-currency-rate" name="CurrencyRate" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6 order-mode-container">
                    <div class="form-group">
                        <label for="order-mode" class="form-label mb-0">Delivery Mode</label>
                        <select id="order-mode" name="DeliveryMode" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-delivery-address" class="form-label mb-0">Delivery Address</label>
                        <select id="order-delivery-address" name="DeliveryAddress" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-date-ordered" class="form-label mb-0">Date Ordered</label>
                        <input type="date" id="order-date-ordered" name="OrderDate" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6 order-reference-container">
                    <div class="form-group">
                        <label for="order-reference" class="form-label mb-0">Canvas Summary Reference</label>
                        <input type="text" id="order-reference" name="Reference" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="order-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="order-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Purchase Order Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Purchase Request Ref#</th>
                                        <th>Item Code</th>
                                        <th>Part Number</th>
                                        <th>Item Description</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Unit Cost</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th>Total</th>
                                        <th class="total-quantity">0</th>
                                        <th></th>
                                        <th></th>
                                        <th class="total-amount">0</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Purchase Order Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Purchase Order Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6 add-so-number-container">
                            <div class="form-group">
                                <label for="add-pr-number" class="form-label mb-0">Purchase Request Ref#</label>
                                <select id="add-pr-number" name="PRNumber" style="width: 100%;">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-code-container">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Item Code</label>
                                <input type="text" id="add-code" name="Code" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-part-container">
                            <div class="form-group">
                                <label for="add-part" class="form-label mb-0">Part Number</label>
                                <input type="text" id="add-part" name="PartNumber" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-name-container">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Item Name</label>
                                <select id="add-name" name="Name" style="width: 100%;">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-quantity-container">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" step="1" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-unit-container">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-unit-cost-container">
                            <div class="form-group">
                                <label for="add-unit-cost" class="form-label mb-0">Unit Cost</label>
                                <input type="number" step="0.01" id="add-unit-cost" name="UnitCost" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 add-total-amount-container">
                            <div class="form-group">
                                <label for="add-total-amount" class="form-label mb-0">Total Amount</label>
                                <input type="text" id="add-total-amount" name="TotalAmount" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["PurchaseOrderId"] != null)
{
    <input type="hidden" id="resubmitPOId" value="@TempData["PurchaseOrderId"]" />
}

@section Scripts {
    <script>
        $("#order-date-ordered").val(DateForInput(new Date()));

        var currentType = null;
        var currentPurpose = null;
        var currentRegion = null;
        if ($("#resubmitPOId").length) {
            // for resubmitting a disapproved sales order
            $.ajax({
                type: "post",
                url: "@Url.Action("DetailsJson")",
                data: {
                    id: $("#resubmitPOId").val()
                },
                success: function (data, status, xhr) {
                    $("#order-document-number").val(data.documentNumber);
                    currentType = data.typeId;
                    currentPurpose = data.purposeId;
                    currentRegion = data.regionId;
                    loadTypeOptions(currentType, currentPurpose);
                    $("#order-type").prop("disabled", true);
                    $("#order-region").val(data.regionId).trigger("change");
                    $("#order-currency").val(data.currency);
                    $("#order-currency-rate").val(data.currencyRate);
                    $("#order-date-ordered").val(data.orderDate3);
                    $("#order-remarks").val(data.remarks);
                    loadSupplier(data.supplierId);
                    loadCreditTerm(data.termId);
                    loadDeliveryMode(data.deliveryModeId);
                    loadDeliveryAddress(data.deliveryAddressId);
                },
                complete: function (xhr, status) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetItemListJson")",
                        data: {
                            purchaseOrderId: $("#resubmitPOId").val()
                        },
                        success: function (data, status, xhr) {
                            $.each(data, function (i, v) {
                                itemDT.row.add(v).draw();
                            });
                        }
                    });
                }
            });
        } else {
            loadTypeOptions(currentType, currentPurpose);
            loadSupplier(null);
            loadCreditTerm(null);
            loadDeliveryMode(null);
            loadDeliveryAddress(null);
        }

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top" role="tooltip"><i class="fas fa-minus"></i></button>';
                        actions += '<button type="button" class="btn btn-info btn-xs btn-up-item" data-microtip-title="Move Up Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-up"></i></button>';
                        actions += '<button type="button" class="btn btn-info btn-xs btn-down-item" data-microtip-title="Move Down Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-down"></i></button>';
                        return actions + '</div>';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                { data: "purchaseRequestNumber", name: "PurchaseRequestNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.itemId == null || data.itemCode == null) {
                            return "-";
                        } else {
                            return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemPartNumber", name: "ItemPartNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        var typeText = $("#order-type").select2("data")[0]?.text.toLowerCase() || "";
                        var purposeText = $("#order-purpose").select2("data")[0]?.text.toLowerCase() || "";
                        if (typeText == "non-automotive" && purposeText == "one-time purchase") {
                            if (data.itemDescription == "") {
                                return '<textarea class="form-control form-control-sm expandable-textarea description is-invalid" style="width: 100%;">' + data.itemDescription + '</textarea><label class="text-danger text-xs fw-lighter fst-italic m-0">Item description is required.</label>';
                            } else if (data.itemDescription.length > 100) {
                                return '<textarea class="form-control form-control-sm expandable-textarea description is-invalid" style="width: 100%;">' + data.itemDescription + '</textarea><label class="text-danger text-xs fw-lighter fst-italic m-0">Item description must not exceed 100 characters.</label>';
                            } else {
                                return '<textarea class="form-control form-control-sm expandable-textarea description" style="width: 100%;">' + data.itemDescription + '</textarea>';
                            }
                        } else {
                            return data.itemDescription;
                        }
                    },
                    name: "ItemDescription",
                    className: "form-cell"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.quantityD > data.unorderedQuantityD) {
                            return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity is-invalid" style="width: 100%;" /><label class="text-danger text-xs fw-lighter fst-italic m-0">Can not exceed ' + data.unorderedQuantity + ' unordered quantity.</label>';
                        } else {
                            return '<input type="number" min="0" max="1999999" step="1" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unitCode", name: "UnitCode", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" step="0.01" value="' + data.unitCostD + '" class="form-control form-control-sm cost" style="width: 100%;" />';
                    },
                    name: "UnitCost",
                    className: "form-cell text-end"
                },
                { data: "totalAmount", name: "TotalAmount", className: "form-cell" }
            ],
            order: [[1, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 6);
                columnDTTotalDecimal(api, 9);
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".btn-remove-item").on("click", function () {
                itemDT.row($(this).parents('tr')).remove().draw();
            });

            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var rowData = this.data();
                if (rowData.lineNumber == 1)
                    $(this.node()).find(".btn-up-item").hide();
                else
                    $(this.node()).find(".btn-up-item").show();

                if (rowData.lineNumber == Math.max.apply(Math, itemDT.column(1).data().toArray()))
                    $(this.node()).find(".btn-down-item").hide();
                else
                    $(this.node()).find(".btn-down-item").show();
            });

            $(".btn-up-item").off("click").on("click", function () {
                var row = $(this).parents('tr');
                var rowData = itemDT.row(row).data();

                var currentLineNumber = rowData.lineNumber;
                var newLineNumber = currentLineNumber - 1;

                var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                    return itemDT.row(index).data().lineNumber == newLineNumber;
                });

                if (targetRowIndex != undefined) {
                    var targetRowData = itemDT.row(targetRowIndex).data();
                    targetRowData.lineNumber = currentLineNumber;
                    itemDT.row(targetRowIndex).data(targetRowData);
                }

                rowData.lineNumber = newLineNumber;
                itemDT.row(row).data(rowData);

                itemDT.draw();
            });

            $(".btn-down-item").off("click").on("click", function () {
                var row = $(this).parents('tr');
                var rowData = itemDT.row(row).data();
                var currentLineNumber = rowData.lineNumber;
                var newLineNumber = currentLineNumber + 1;

                var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                    return itemDT.row(index).data().lineNumber == newLineNumber;
                });

                if (targetRowIndex != undefined) {
                    var targetRowData = itemDT.row(targetRowIndex).data();
                    targetRowData.lineNumber = currentLineNumber;
                    itemDT.row(targetRowIndex).data(targetRowData);
                }

                rowData.lineNumber = newLineNumber;
                itemDT.row(row).data(rowData);

                itemDT.draw();
            });

            var typeText = $("#order-type").select2("data")[0]?.text.toLowerCase() || "";
            var purposeText = $("#order-purpose").select2("data")[0]?.text.toLowerCase() || "";
            if (typeText == "non-automotive" && purposeText == "one-time purchase") {
                $(".description").off("change").on("change", function () {
                    var row = itemDT.row($(this).closest('tr'));
                    var rowData = row.data();

                    rowData.itemDescription = $(row.node()).find(".description").val();

                    row.data(rowData).draw(false);
                });
            }

            $(".quantity, .cost").off("change").on("change", function () {
                var row = itemDT.row($(this).closest('tr'));
                var rowData = row.data();

                var columnClass = $(this).hasClass("quantity") ? "quantity" : "cost";
                var lineNumber = rowData.lineNumber;

                var quantityValue = parseFloat($(row.node()).find(".quantity").val()) || 0;
                var costValue = parseFloat($(row.node()).find(".cost").val()) || 0;

                var totalValue = quantityValue * costValue;

                rowData.quantity = FormatStringInteger(quantityValue);
                rowData.quantityD = quantityValue;
                rowData.unitCost = FormatStringDecimal(costValue);
                rowData.unitCostD = costValue;
                rowData.totalAmount = FormatStringDecimal(totalValue);
                rowData.totalAmountD = totalValue;

                row.data(rowData).draw(false);

                setTimeout(function () {
                    var restoredRow = $(itemDT.row(function (idx, data) {
                        return data.lineNumber == lineNumber;
                    }).node());
                    if (restoredRow) {
                        var restoredInput = $(restoredRow).find("." + columnClass);

                        if (restoredInput.length)
                            restoredInput.focus();
                    }
                }, 0);
            });
        });

        // Load order type data for select2
        function loadTypeOptions(selectedType, selectedPurpose) {
            if ($.fn.select2 && $("#order-type").hasClass("select2-hidden-accessible")) {
                $("#order-type").select2("destroy");
                $("#order-type").empty();
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetTypeOptions")",
                data: {
                    SelectedId: selectedType
                },
                success: function (data, status, xhr) {
                    $("#order-type").select2({
                        data: data,
                        minimumResultsForSearch: -1
                    }).on("select2:select", function () {
                        loadDocumentNumber();
                        var typeText = $("#order-type").select2("data")[0]?.text.toLowerCase() || "";
                        if (typeText != "maintenance & repair") {
                            $(".order-purpose-container").toggle(true);
                            loadPurposeOptions($("#order-type").select2("data")[0].requestTypeId, selectedPurpose);
                        } else {
                            $(".order-purpose-container").toggle(false);
                            $("#order-purpose").val(null).trigger("change");
                        }
                    });
                },
                complete: function (xhr, status) {
                    loadDocumentNumber();
                    var typeText = $("#order-type").select2("data")[0]?.text.toLowerCase() || "";
                    if (typeText != "maintenance & repair") {
                        $(".order-purpose-container").toggle(true);
                        loadPurposeOptions($("#order-type").select2("data")[0].requestTypeId, selectedPurpose);
                    } else {
                        $(".order-purpose-container").toggle(false);
                        $("#order-purpose").val(null).trigger("change");
                    }
                }
            });
        }

        // Load request purpose data for select2
        function loadPurposeOptions(selectedType, selectedPurpose) {
            $("#order-purpose").off("change");
            $("#order-purpose").empty().trigger('change');
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurposeOptions", "PurchaseRequest")",
                data: {
                    TypeId: selectedType,
                    SelectedId: selectedPurpose
                },
                success: function (data) {
                    $("#order-purpose").select2({
                        data: data,
                        minimumResultsForSearch: -1
                    }).on("change", function () {
                        changingTypePurposeOrRegion();
                    });
                },
                complete: function (xhr, status) {
                    changingTypePurposeOrRegion();
                }
            });
        }

        function loadDocumentNumber() {
            if ($("#resubmitPOId").length == 0) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetNewDocumentNumber")",
                    data: {
                        TypeId: $("#order-type").val()
                    },
                    success: function (data, status, xhr) {
                        $("#order-document-number").val(data);
                    }
                });
            }
        }


        // Load region data for select2
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Region")",
                success: function (data, status, xhr) {
                    $("#order-region").select2({
                        data: data,
                        minimumResultsForSearch: -1
                    }).on("change", function () {
                        changingTypePurposeOrRegion();
                    });
                }
            });

        function changingTypePurposeOrRegion() {
            var selectedType = $("#order-type").val();
            var selectedPurpose = $("#order-purpose").val();

            var typeText = $("#order-type").select2("data")[0]?.text.toLowerCase() || "";
            var purposeText = $("#order-purpose").select2("data")[0]?.text.toLowerCase() || "";
            var selectedRegion = typeText == "local purchase order" && purposeText == "rush order" ? $("#order-region").val() : null;
            if (itemDT.data().length > 0 && (selectedType != currentType || selectedPurpose != currentPurpose || selectedRegion != currentRegion)) {
                var changed = selectedType != currentType ? "Order Type"
                            : selectedPurpose != currentPurpose ? "Order Purpose"
                            : selectedRegion != currentRegion ? "Region"
                            : "Order Type / Purpose / Region";
                swal({
                    title: "Items not empty",
                    text: "Changing the selected " + changed + " will clear the added items. Do you want to continue?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        swal.close();
                        itemDT.clear().draw();
                        currentType = selectedType;
                        currentPurpose = selectedPurpose;
                        currentRegion = selectedRegion;
                    } else {
                        $("#order-type").val(currentType).trigger("change");
                        $("#order-purpose").val(currentPurpose).trigger("change");
                        $("#order-region").val(currentRegion).trigger("change");
                    }
                });
            } else {
                currentType = selectedType;
                currentPurpose = selectedPurpose;
                currentRegion = selectedRegion;
            }

            var defaultOption = $("#order-mode").find('option').eq(0).val();
            $("#order-mode").val(defaultOption).trigger('change');
            $("#order-reference").val("");

            if (typeText == "non-automotive") {
                $(".order-mode-container").toggle(true);
                $(".order-reference-container").toggle(false);
                itemDT.column(3).visible(true);
                itemDT.column(4).visible(false);
                $(".order-region-container").toggle(false);
            } else if (typeText == "local purchase order" || typeText == "international purchase order") {
                $(".order-mode-container").toggle(true);
                $(".order-reference-container").toggle(true);
                itemDT.column(3).visible(false);
                itemDT.column(4).visible(true);
                if (typeText == "local purchase order" && purposeText == "rush order") {
                    $(".order-region-container").toggle(true);
                } else {
                    $(".order-region-container").toggle(false);
                }
            } else if (typeText == "maintenance & repair") {
                var deliveryOption = $("#order-mode").find('option').filter(function () {
                    return $(this).text().toLowerCase() == "delivery";
                }).first();

                if (deliveryOption.length) {
                    $("#order-mode").val(deliveryOption.val()).trigger('change');
                }
                $(".order-mode-container").toggle(false);
                $(".order-reference-container").toggle(false);
                itemDT.column(3).visible(false);
                itemDT.column(4).visible(false);
                $(".order-region-container").toggle(false);
            }

            loadSupplier();
            loadPurchaseRequestOptions();
        }

        // Load supplier for select2
        function loadSupplier(selectedSupplier) {
            if ($.fn.select2 && $("#order-supplier").hasClass("select2-hidden-accessible")) {
                $("#order-supplier").select2("destroy");
                $("#order-supplier").empty();
            }

            var isLocal = null, isForeign = null;
            if ($.fn.select2 && $("#order-type").hasClass("select2-hidden-accessible")) {
                var typeText = $("#order-type").select2("data")[0]?.text.toLowerCase() || "";
                isLocal = typeText.includes("purchase order") == false ? null : typeText != "international purchase order";
                isForeign = typeText.includes("purchase order") == false ? null : typeText != "local purchase order";
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Supplier")",
                data: {
                    IncludeId: selectedSupplier,
                    IsLocal: isLocal,
                    IsForeign: isForeign
                },
                success: function (data, status, xhr) {
                    $("#order-supplier").select2({
                        minimumInputLength: -1,
                        placeholder: "<empty>",
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                        },
                        data: data
                    }).on("select2:select", function () {
                        var selectedSupplier = $("#order-supplier").select2("data")[0];
                        $("#order-currency").val(selectedSupplier.currency);
                        $("#order-currency-rate").val(selectedSupplier.currencyRate);
                    });
                    if ($("#order-supplier").val() != null) {
                        var selectedSupplier = $("#order-supplier").select2("data")[0];
                        $("#order-currency").val(selectedSupplier.currency);
                        $("#order-currency-rate").val(selectedSupplier.currencyRate);
                    }
                }
            });
        }

        // Load terms for select2
        function loadCreditTerm(selectedTerm) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "CreditTerm")",
                data: {
                    IncludeId: selectedTerm
                },
                success: function (data, status, xhr) {
                    $("#order-terms").select2({
                        minimumResultsForSearch: -1,
                        placeholder: "<empty>",
                        data: data
                    });
                }
            });
        }

        // Load delivery mode for select2
        function loadDeliveryMode(selectedMode) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetDeliveryModeOptions")",
                data: {
                    SelectedId: selectedMode
                },
                success: function (data, status, xhr) {
                    $("#order-mode").select2({
                        minimumResultsForSearch: -1,
                        placeholder: "<empty>",
                        data: data
                    });
                }
            });
        }

        // Load delivery address data for select2
        function loadDeliveryAddress(selectedWarehouse) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Warehouse")",
                data: {
                    IncludeId: selectedWarehouse
                },
                success: function (data, status, xhr) {
                    $("#order-delivery-address").select2({
                        data: data,
                        minimumResultsForSearch: -1,
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
                        },
                    });
                }
            });
        }

        function loadPurchaseRequestOptions() {
            if ($.fn.select2 && $("#add-pr-number").hasClass("select2-hidden-accessible")) {
                $("#add-pr-number").select2("destroy");
                $("#add-pr-number").empty();
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseRequestOptions")",
                data: {
                    RequestTypeId: function () {
                        return $("#order-type").select2("data")[0].requestTypeId;
                    },
                    RequestPurposeId: function () {
                        return $("#order-purpose").val();
                    },
                    RegionId: function () {
                        var typeText = $("#order-type").select2("data")[0]?.text.toLowerCase() || "";
                        var purposeText = $("#order-purpose").select2("data")[0]?.text.toLowerCase() || "";
                        var selectedRegion = typeText == "local purchase order" && purposeText == "rush order" ? $("#order-region").val() : null;
                        return selectedRegion;
                    }//,
                    //SelectedId: ???
                },
                success: function (data, status, xhr) {
                    $("#add-pr-number").select2({
                        data: data,
                        minimumInputLength: -1,
                        placeholder: "<empty>",
                        language: {
                            noResults: function () {
                                return "No available request found";
                            }
                        },
                        dropdownParent: $("#addModal")
                    }).on("select2:select", function () {
                        loadAllItemsOptions();
                    });
                    loadAllItemsOptions();
                }
            });
        }

        function loadAllItemsOptions() {
            if ($.fn.select2 && $("#add-name").hasClass("select2-hidden-accessible")) {
                $("#add-name").select2("destroy");
                $("#add-name").empty();
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetPurchaseRequestItemOptions")",
                data: {
                    RequestId: function () {
                        return $("#add-pr-number").val();
                    }
                },
                success: function (data, status, xhr) {
                    $("#add-name").select2({
                        data: data,
                        //minimumResultsForSearch: -1,
                        placeholder: "<empty>",
                        allowClear: true,
                        language: {
                            noResults: function () {
                                return "No unordered items found";
                            }
                        },
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $(
                                "<strong>" +
                                (repo.itemCode != null ? repo.itemCode + " - " : "") +
                                repo.text + "</strong><br />" +
                                "<small>" +
                                "Requested Quantity: " + repo.quantity + " " + repo.unit + "<br />" +
                                "Unordered Quantity: " + repo.unorderedQuantity + " " + repo.unit +
                                "</small>"
                            );
                        },
                        dropdownParent: $("#addModal"),
                        matcher: function (params, data) {
                            if ($.trim(params.term) === '') {
                                return data;
                            }

                            if (!data.text) {
                                return null;
                            }

                            // Convert search term to lowercase for case-insensitive matching
                            var term = params.term.toLowerCase();
                            var text = data.text.toLowerCase();
                            var itemCode = data.itemCode ? data.itemCode.toLowerCase() : '';

                            // Check if search term exists in either text or itemCode
                            if (text.includes(term) || itemCode.includes(term)) {
                                return data;
                            }

                            return null;
                        }
                    }).off("select2:select").on("select2:select", function () {
                        var selected = $(this).select2("data")[0];
                        $("#add-code").val(selected.itemCode);
                        $("#add-part").val(selected.partNumber);
                        $("#add-quantity").val(selected.unorderedQuantity);
                        $("#add-quantity").data("max", selected.unorderedQuantity);
                        $("#add-unit").val(selected.unit);
                        $("#add-unit").data("Id", selected.unitId);
                        $("#add-unit-cost").val(0);
                        $("#add-total-amount").val("0.00");
                    }).off("select2:unselecting").on("select2:unselecting", function () {
                        $("#add-code").val("");
                        $("#add-part").val("");
                        $("#add-quantity").val(0);
                        $("#add-quantity").data("max", 0);
                        $("#add-unit").val("");
                        $("#add-unit").data("Id", -1);
                        $("#add-unit-cost").val("0.00");
                        $("#add-total-amount").val("0.00");
                    });
                },
                complete: function (xhr, status) {
                    $("#add-name").val("").trigger("change");
                }
            });
        }

        $("#add-quantity").on("change keyup", recomputeAddForm);
        $("#add-unit-cost").on("change keyup", recomputeAddForm);
        function recomputeAddForm() {
            var quantity = $("#add-quantity").val() || 0;
            var cost = $("#add-unit-cost").val() || 0;

            $("#add-total-amount").val(FormatStringDecimal(quantity * cost));
        }


        // Load unit for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Unit")",
            success: function (data, status, xhr) {
                $("#add-unit2").select2({
                    data: data,
                    minimumResultsForSearch: -1,
                    placeholder: "<empty>",
                    dropdownParent: $("#addModal")
                }).on("change", function () {
                    $("#add-unit").val($("#add-unit2").select2("data")[0].text);
                    $("#add-unit").data("Id", $("#add-unit2").select2("data")[0].id);
                });
            }
        });

        $(".createBtn").on("click", clearItemForm);

        function clearItemForm() {
            $("#add-code").val("");
            $("#add-part").val("");
            $("#add-name").val("").trigger("change");
            $("#add-quantity").val("0");
            $("#add-unit").val("");
            $("#add-unit2").val("").trigger("change");
            $("#add-unit").data("Id", "");
            $("#add-unit-cost").val("0.00");
            $("#add-total-amount").val("0.00");
        }

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            rules: {
                PRNumber: {
                    required: true
                },
                Name: {
                    required: true,
                    maxlength: 100
                },
                Quantity: {
                    required: true,
                    number: true,
                    isNotZero: true,
                    max: function () {
                        return $("#add-quantity").data("max");
                    }
                },
                UnitCost: {
                    required: true,
                    number: true
                }
            },
            messages: {
                PRNumber: {
                    required: "Please select a Purchase Request Reference Number."
                },
                Name: {
                    required: "Please select an Item.",
                    maxlength: "Name must not exceed 100 characters."
                },
                Quantity: {
                    required: "Please enter a quantity.",
                    number: "Please enter a valid number.",
                    isNotZero: "Can not request an item with 0 quantity.",
                    max: function () {
                        return "Can not exceed " + $("#add-quantity").data("max") + " unordered quantity.";
                    }
                },
                UnitCost: {
                    required: "Please enter the unit cost.",
                    number: "Please enter a valid number."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.itemDescription == $("#add-name").select2("data")[0].text) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastr.warning($("#add-name").select2("data")[0].text + " has already been added", "Duplicate");
            } else {
                itemDT.row.add({
                    purchaseOrderId: 0,
                    lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                    purchaseRequestId: $("#add-pr-number").select2("data")[0].id,
                    purchaseRequestNumber: $("#add-pr-number").select2("data")[0].text,
                    requestItemId: $("#add-name").select2("data")[0].id,
                    itemId: $("#add-name").select2("data")[0].itemId,
                    itemCode: $("#add-name").select2("data")[0].itemCode,
                    itemPartNumber: $("#add-name").select2("data")[0].partNumber,
                    itemDescription: $("#add-name").select2("data")[0].text,
                    quantity: FormatStringInteger($("#add-quantity").val()),
                    quantityD: $("#add-quantity").val() || 0,
                    unorderedQuantity: FormatStringInteger($("#add-quantity").data("max")),
                    unorderedQuantityD: $("#add-quantity").data("max") || 0,
                    unitId: $("#add-unit").data("Id"),
                    unitCode: $("#add-unit").val(),
                    unitCost: FormatStringDecimal($("#add-unit-cost").val()),
                    unitCostD: $("#add-unit-cost").val() || 0,
                    totalAmount: FormatStringDecimal($("#add-total-amount").val()),
                    totalAmountD: $("#add-total-amount").val() || 0
                }).draw();

                toastr.success("Added " + $("#add-name").select2("data")[0].text + " on Purchase Order Item(s)", "Success");
                clearItemForm();
            }
        }

        $("#form-order button[type=submit]").on("click", function () {
            $("#action-type").val($(this).data("action"));
        });

        // Validation for Create
        var validateCreate = $("#form-order").validate({
            rules: {
                Type: {
                    required: true
                },
                Supplier: {
                    required: true
                },
                Terms: {
                    required: true
                },
                Currency: {
                    required: true
                },
                CurrencyRate: {
                    required: true
                },
                DeliveryMode: {
                    required: function () {
                        return $("#order-type").select2("data")[0]?.text.toLowerCase() != "maintenance & repair";
                    }
                },
                DeliveryAddress: {
                    required: true
                },
                OrderDate: {
                    required: true
                },
                Reference: {
                    required: function () {
                        return $("#order-type").select2("data")[0]?.text.toLowerCase() == "local purchase order"
                            || $("#order-type").select2("data")[0]?.text.toLowerCase() == "international purchase order";
                    },
                    maxlength: 50
                },
                Remarks: {
                    maxlength: 250
                }
            },
            messages: {
                Type: {
                    required: "Please select a type."
                },
                Supplier: {
                    required: "Please select the supplier."
                },
                Terms: {
                    required: "Please select the term."
                },
                Currency: {
                    required: "Please select a currency."
                },
                CurrencyRate: {
                    required: "Please enter the currency rate."
                },
                DeliveryMode: {
                    required: "Please select the delivery mode."
                },
                DeliveryAddress: {
                    required: "Please select the delivery address."
                },
                OrderDate: {
                    required: "Please enter the date of order."
                },
                Reference: {
                    required: "Please enter the canvas summary reference.",
                    maxlength: "Canvas summary reference can not exceed 50 characters."
                },
                Remarks: {
                    maxlength: "Remarks can not exceed 250 characters."
                }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveOrder();
            }
        });

        function SaveOrder() {
            var items = itemDT.data();
            if (items.length == 0) {
                toastr.warning("No item to order. Add an item to the list to continue", "Warning");
            } else if (items.filter(s => parseInt(s.quantity) == 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't order an item with 0 quantity", "Warning");
            } else if (itemDT.rows().nodes().to$().find('.is-invalid').length) {
                toastr.warning("Some items have invalid inputs. Please fix it first", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddJson")",
                    data: {
                        TypeId: $("#order-type").val(),
                        SupplierId: $("#order-supplier").val(),
                        TermsId: $("#order-terms").val(),
                        DeliveryModeId: $("#order-mode").val(),
                        DeliveryAddressId: $("#order-delivery-address").val(),
                        DateOrdered: $("#order-date-ordered").val(),
                        Reference: $("#order-reference").val(),
                        Remarks: $("#order-remarks").val(),
                        Status: $("#action-type").val(),
                        ResubmitId: $("#resubmitPOId").val(),
                        Items: itemDT.rows().data().toArray()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
}
