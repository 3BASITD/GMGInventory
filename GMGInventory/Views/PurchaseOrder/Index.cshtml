@model IEnumerable<PurchaseOrderNewVM>

@{
    ViewData["Title"] = "Purchase Order";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Create">
                    <span class="fas fa-plus"></span> New Purchase Order
                </a>
            }
            <button class="btn btn-secondary btn-sm float-right ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-order">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Type)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Supplier)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Term)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DeliveryMode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-type" class="form-label mb-0">Type</label>
                            <select id="filter-type" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-mode" class="form-label mb-0">Delivery Mode</label>
                            <select id="filter-mode" style="width:100%"></select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-supplier" class="form-label mb-0">Supplier</label>
                            <select id="filter-supplier" style="width:100%"></select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Order Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="form-label mb-0">Order Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%"></select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        $.ajax({
            type: "POST",
            url: "@Url.Action("GetTypeOptions")",
            beforeSend: function (xhr, error) {
                showBatchLoader("type");
            },
            success: function (data, status, xhr) {
                $("#filter-type").select2({
                            minimumResultsForSearch: -1,
                    allowClear: true,
                    placeholder: "ALL",
                    data: data
                }).on("select2:select", function () {
                    loadSupplier();
                });
            },
            complete: function (xhr, status) {
                $("#filter-type").val(null).trigger("change");
                loadSupplier();
                hideBatchLoader("type");
            }
        });

        $.ajax({
            type: "POST",
            url: "@Url.Action("GetDeliveryModeOptions")",
            beforeSend: function (xhr, error) {
                showBatchLoader("mode");
            },
            success: function (data, status, xhr) {
                $("#filter-mode").select2({
                    minimumResultsForSearch: -1,
                    allowClear: true,
                    placeholder: "ALL",
                    data: data
                });
            },
            complete: function (xhr, status) {
                $("#filter-mode").val(null).trigger("change");
                hideBatchLoader("mode");
            }
        });

        // Load supplier for select2
        function loadSupplier() {
            if ($.fn.select2 && $("#filter-supplier").hasClass("select2-hidden-accessible")) {
                $("#filter-supplier").select2("destroy");
                $("#filter-supplier").empty();
            }

            var isLocal = null, isForeign = null;
            if ($.fn.select2 && $("#filter-type").hasClass("select2-hidden-accessible")) {
                var typeText = $("#filter-type").select2("data")[0]?.text.toLowerCase() || "";
                isLocal = typeText.includes("purchase order") == false ? null : typeText != "international purchase order";
                isForeign = typeText.includes("purchase order") == false ? null : typeText != "local purchase order";
            }
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Supplier")",
                data: {
                    IsLocal: isLocal,
                    IsForeign: isForeign
                },
                beforeSend: function (xhr, error) {
                    showBatchLoader("supplier");
                },
                success: function (data, status, xhr) {
                    $("#filter-supplier").select2({
                        minimumInputLength: -1,
                        allowClear: true,
                        placeholder: "ALL",
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> " + (repo.text != repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                        },
                        data: data
                    });
                },
                complete: function (xhr, status) {
                    $("#filter-supplier").val(null).trigger("change");
                    hideBatchLoader("supplier");
                }
            });
        }

        // Load status for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "PurchaseStatus")",
            beforeSend: function (xhr, error) {
                showBatchLoader("status");
            },
            success: function (data, status, xhr) {
                $("#filter-status").select2({
                    minimumResultsForSearch: -1,
                    allowClear: true,
                    placeholder: "ALL",
                    data: data
                });
            },
            complete: function (xhr, status) {
                $("#filter-status").val(null).trigger("change");
                hideBatchLoader("status");
            }
        });

        $(".btnFilter").on("click", function () {
            orderDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        var orderDT = $('.table-order').on('preXhr.dt', function (e, settings, data) {
            showBatchLoader("orderdt");
        }).DataTable({
        //         stateSave: true,
        //         stateSaveParams: function (settings, data) {
        //     data.customFilters = {
        //         selectVal: $('#yourSelect').val(),
        //         inputVal: $('#yourInput').val()
        //     };
        // },
        // stateLoadParams: function (settings, data) {
        //     if (data.customFilters) {
        //         $('#yourSelect').val(data.customFilters.selectVal).trigger('change');
        //         $('#yourInput').val(data.customFilters.inputVal);
        //     }
        // },
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
                data: function (data) {
                    data.TypeId = $("#filter-type").val();
                    data.ModeId = $("#filter-mode").val();
                    data.SupplierId = $("#filter-supplier").val();
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    data.StatusId = $("#filter-status").val();
                }
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "documentNumber", name: "DocumentNumber" },
                { data: "type", name: "Type" },
                { data: "supplier", name: "Supplier" },
                { data: "term", name: "Term" },
                { data: "deliveryMode", name: "DeliveryMode" },
                { data: "status", name: "Status" },
                { data: "orderDate", name: "OrderDate" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                        if (data.status.toLowerCase() == "draft" && data.orderBy == $("#current-user-nickname").val()) {
                            if (user_access.canDelete) {
                                actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete Draft" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                            }
                        }
                        return actions + "</div>";
                    }
                }
            ],
            order: [[6, "desc"]],
            createdRow: function (row, data, dataIndex) {
                if (data.status.toLowerCase() == 'resubmitted') {
                    $(row).addClass('text-muted');
                } else if (data.status.toLowerCase() == 'disapproved') {
                    $(row).addClass('table-danger');
                    $(row).find('td:eq(5)').addClass('text-danger');
                } else if (data.status.toLowerCase() == 'approved') {
                    $(row).addClass('table-success');
                    $(row).find('td:eq(5)').addClass('text-success');
                }
            }
        });

        orderDT.on("draw", function () {
            hideBatchLoader("orderdt");
        });

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-type").val()) { urlQuery.push("TypeId=" + $("#filter-type").val()); }
                if ($("#filter-mode").val()) { urlQuery.push("ModeId=" + $("#filter-mode").val()); }
                if ($("#filter-supplier").val()) { urlQuery.push("SupplierId=" + $("#filter-supplier").val()); }
                if ($("#filter-status").val()) { urlQuery.push("StatusId=" + $("#filter-status").val()); }

                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());


                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }
    </script>
}