@model IEnumerable<PurchaseOrderVM>

@{
    ViewData["Title"] = "Replenish Orders";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                <span class="fas fa-plus"></span> New Replenish Order
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-replenish">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Supplier)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderBy)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Destination)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var replenishDT = $('.table-replenish').on('preXhr.dt', function (e, settings, data) {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fa fa-cog fa-spin"
            });
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "supplier", name: "Supplier" },
                { data: "poNumber", name: "PONumber" },
                { data: "orderDate", name: "OrderDate" },
                { data: "orderBy", name: "OrderBy" },
                { data: "destination", name: "Destination" },
                { data: "totalAmount", name: "TotalAmount", className: "text-end" },
                { data: "status", name: "Status" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-bs-toggle="tooltip" title="View Details"><i class="fas fa-info-circle"></i></a>';
                        if (data.status == "Draft" && data.orderBy == $("#current-user-nickname").val()) {
                            actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-bs-toggle="tooltip" title="Delete Draft"><i class="far fa-trash-alt"></i></button>';
                        }
                        return actions + "</div>";
                    }
                }
            ],
            order: [[2, "desc"]]
        });

        replenishDT.on("draw", function () {
            reloadToolTip();

            $('.dataTables_filter input').unbind();
            $('.dataTables_filter input').keyup(function (e) {
                if (e.keyCode == 13) {
                    replenishDT.search($(this).val()).draw();
                }
            });

            $.LoadingOverlay("hide");

            $('.deleteBtn').click(function (e) {
                swal({
                    title: "Delete Draft",
                    text: "Are you sure you want to delete this draft record?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("DeleteDraftJson")",
                            data: {
                                Id: $(this).data("id")
                            },
                            error: jQueryCommonError,
                            success: function (data, status, xhr) {
                                if (data.status == "Error") {
                                    toastr.error(data.message, "Error");
                                } else {
                                    toastr.success(data.message, "Success");
                                    replenishDT.ajax.reload();
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}