@model IEnumerable<ReportManagementCheckRegisterRVM>

@{
    ViewData["Title"] = "Check Register by Date";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-register">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.CheckDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.BankDetails)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CheckNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CheckAmount)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="3"></th>
                    <th>Total </th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="filter-from" class="form-label mb-0">Date From</label>
                    <input type="date" id="filter-from" class="form-control form-control-sm" />
                </div>
                <div class="form-group">
                    <label for="filter-to" class="control-label mb-0">Date To</label>
                    <input type="date" id="filter-to" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        // Load List on DataTable
        var registerDT = $('.table-register').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetCheckRegisterByDateDT")",
                type: "POST",
                data: function (data) {
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                }
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "checkDate", name: "CheckDate" },
                { data: "customer", name: "Customer" },
                { data: "bankDetails", name: "BankDetails" },
                { data: "checkNumber", name: "CheckNumber" },
                { data: "checkAmount", name: "CheckAmount", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = registerDT.ajax.json();
                var api = this.api(), data;

                $(api.column(4).footer()).html(FormatStringDecimal(json.totalAmount));
            },
            order: [[0, "asc"]]
        });

        // Load functions upon DataTable load
        registerDT.on("draw", function () {
            hideLoader();

            DatatablesSearchOnEnter('.table-register', registerDT);

            $(".table-register thead th").removeClass("text-end");
        });

        $(".btnFilter").on("click", function () {
            registerDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            window.location = "@Url.Action("DownloadCheckRegisterByDate")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetCheckRegisterByDate")",
                data: {
                    DateFrom: $("#filter-from").val(),
                    DateTo: $("#filter-to").val()
                },
                beforeSend: function (xhr, settings) {
                    $.LoadingOverlay("show", {
                        image: "",
                        fontawesome: "fas fa-print"
                    });
                },
                error: jQueryCommonError,
                success: function (data, status, xhr) {
                    var html = '<h3>Check Register by Date</h3>';
                    html += '<p>';
                    html += '<strong>Date From</strong>&nbsp;&nbsp;' + formatDateEn(new Date($("#filter-from").val())) + '<br />';
                    html += '<strong>Date To</strong>&nbsp;&nbsp;' + formatDateEn(new Date($("#filter-to").val()));
                    html += '</p>';

                    html += '<table class="table-items">';
                    html += '<thead>';
                    html += '<tr>';
                    html += '<th>Check Date</th>';
                    html += '<th>Customer</th>';
                    html += '<th>Bank Details</th>';
                    html += '<th>Check Number</th>';
                    html += '<th>Check Amount</th>';
                    html += '</tr>';
                    html += '</thead>';

                    html += '<tbody>';
                    var totalAmount = 0;
                    $.each(data, function (i, item) {
                        html += '<tr>';
                        html += '<td>' + item.checkDate + '</td>';
                        html += '<td>' + item.customer + '</td>';
                        html += '<td>' + item.bankDetails + '</td>';
                        html += '<td>' + item.checkNumber + '</td>';
                        html += '<td class="right-text">' + item.checkAmount + '</td>';
                        html += '</tr>';

                        totalAmount += parseFloat(item.checkAmountD);
                    });
                    html += '</tbody>';

                    html += '<tfoot>';
                    html += '<tr>';
                    html += '<th colspan="4" class="right-text">Total</th>';
                    html += '<th class="right-text">' + FormatStringDecimal(totalAmount) + '</th>';
                    html += '</tr>';
                    html += '</tfoot>';
                    html += '</table>';

                    $("#for-print").html(html);
                },
                complete: function (xhr, status) {
                    printout("#for-print", {
                        pageTitle: "GMG Inventory",
                        importCSS: false,
                        loadCSS: "/css/print.css"
                    });
                    hideLoader();
                    $("#for-print").html("");
                }
            });

        });
    </script>
    }