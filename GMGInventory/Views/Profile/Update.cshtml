@using GMGInventory.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> userManager

@model UserInformationVM

@{
    ViewData["Title"] = "Update Profile";
    var activeUser = userManager.FindByNameAsync(User.Identity?.Name).Result;
}


@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="Index">Profile</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right mr-2" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to Profile
                </a>
            </div>
        </div>
        <form asp-action="Update" method="post">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="FirstName" class="control-label mb-0"></label>
                            <input asp-for="FirstName" class="form-control form-control-sm" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="LastName" class="control-label mb-0"></label>
                            <input asp-for="LastName" class="form-control form-control-sm" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Nickname" class="control-label mb-0"></label>
                            <input asp-for="Nickname" class="form-control form-control-sm" />
                            <span asp-validation-for="Nickname" class="text-danger"></span>
                        </div>
                        <input type="hidden" asp-for="Id" value="@activeUser.Id"/>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="card-tools">
                    <button type="submit" class="btn btn-primary btn-sm float-right">
                        <span class="fas fa-save"></span> Save
                    </button>
                </div>
            </div>
        </form>
    </div>

    @section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }