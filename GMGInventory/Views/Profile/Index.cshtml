@using GMGInventory.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> userManager

@model List<AuditLog>

@{
    ViewData["Title"] = "Profile";
    var activeUser = userManager.FindByNameAsync(User.Identity?.Name ?? "").Result;
    var isNewIcon = activeUser.IsNavIconPlain == false;
}

@if (TempData["message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["message"]

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="row">
    <div class="col-6">
        @if (activeUser == null)
        {
            <div class="card card-default">
                <div class="card-header">
                    <span class="card-title">Invalid User</span>
                </div>
                <div class="card-body">
                    You may try reloading the page, or logging out and logging back in. If the issue still persists, your account may be invalid. Please check your username and password and try again. If the problem continues, contact the administrator for further assistance.
                </div>
            </div>
        }
        else
        {
            <div class="card card-default">
                <div class="card-header">
                    <span class="card-title">
                        @if (isNewIcon)
                        {
                            <span class="emoji">👤</span>
                        }
                         @ViewData["Title"]
                    </span>
                    @if (activeUser.IsActive)
                    {
                        <div class="card-tools">
                            <a class="btn btn-secondary btn-sm float-right" asp-action="Password">

                                @if (isNewIcon)
                                {
                                    <span class="emoji">📝</span>
                                }
                                else
                                {

                                    <span class="fas fa-edit"></span>
                                }
                                Change Password
                            </a>
                            <a class="btn btn-primary btn-sm float-right mr-2" asp-action="Update">
                                @if (isNewIcon)
                                {
                                    <span class="emoji">🔑</span>
                                }
                                else
                                {

                                    <span class="fas fa-edit"></span>
                                }
                                Update Information
                            </a>
                        </div>
                    }
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">
                            First Name
                        </dt>
                        <dd class="col-sm-7">
                            @(activeUser.FirstName ?? "-")
                        </dd>
                        <dt class="col-sm-5">
                            Last Name
                        </dt>
                        <dd class="col-sm-7">
                            @(activeUser.LastName ?? "-")
                        </dd>
                        <dt class="col-sm-5">
                            Nickname
                        </dt>
                        <dd class="col-sm-7">
                            @activeUser.Nickname
                        </dd>
                        <dt class="col-sm-5">
                            Account Creation
                        </dt>
                        <dd class="col-sm-7">
                            @activeUser.DateCreated
                        </dd>
                    </dl>
                </div>
            </div>
            @if (activeUser.IsActive)
            {
                <div class="card card-default">
                    <div class="card-header">
                        <span class="card-title">
                            @if (isNewIcon)
                            {
                                <span class="emoji">🎨</span>
                            }
                             Theme
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="container">
                            <div class="row">
                                <div class="col-sm-6 text-center">
                                    <form id="themeForm" asp-action="ChangeTheme">
                                        <input type="hidden" name="Id" value="@activeUser.Id" />
                                        <input type="checkbox" id="themeCheckbox" name="IsDarkMode"
                                               value="@(activeUser.IsDarkMode ? "off" : "on")" @(activeUser.IsDarkMode ? "checked" : "")
                                               data-toggle="toggle" data-width="150" data-height="35"
                                               data-on="Dark Mode" data-onstyle="danger"
                                               data-off="Light Mode" data-offstyle="info" />
                                    </form>
                                </div>
                                <div class="col-sm-6 text-center">
                                    <form id="navIconForm" asp-action="ChangeNavIcon">
                                        <input type="hidden" name="Id" value="@activeUser.Id" />
                                        <input type="checkbox" id="navIconCheckbox" name="IsNavIconPlain"
                                               value="@(activeUser.IsNavIconPlain == false ? "on" : "off")" @(activeUser.IsNavIconPlain == false ? "" : "checked")
                                               data-toggle="toggle" data-width="150" data-height="35"
                                               data-on="Plain Icon" data-onstyle="secondary"
                                               data-off="Colored Emoji" data-offstyle="info" />
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            
            <div class="card card-warning">
                <div class="card-header">
                    <span class="card-title">
                        <span class="emoji" aria-hidden="true">&#9881;&#65039;</span> Development Tracker
                    </span>
                </div>
                <div class="card-body">
                    <p>
                        This section is provided to give visibility into the ongoing development of the system.
                    </p>
                    <ul>
                        <li><span class="emoji">📋</span> <strong>View and manage tasks</strong> – see which tasks are open, in progress, or finished.</li>
                        <li><span class="emoji">🐞</span> <strong>Report errors on a task</strong> – if something isn’t working, log the problem and link it to the right task.</li>
                        <li><span class="emoji">💬</span> <strong>Add comments</strong> – share notes, questions, or feedback on any task.</li>
                        <li><span class="emoji">📊</span> <strong>Follow progress updates</strong> – track how tasks, fixes, and discussions are moving forward.</li>
                        <li><span class="emoji">🖼️</span> <strong>Attach images</strong> – upload screenshots or photos to explain issues or ideas more clearly.</li>
                    </ul>
                    <div class="text-center mt-3">
                        <a class="btn btn-info" asp-action="Index" asp-controller="Tracker">
                            <span class="emoji">📋</span> Go to Development Tracker
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="col-6">
        <div class="card card-default">
            <div class="card-header">
                <span class="card-title">
                    @if (isNewIcon)
                    {
                        <span class="emoji">🔑</span>
                    }
                     List of Access
                </span>
            </div>
            <div class="card-body">
                <table class="table table-head-fixed table-striped table-hover table-access">
                    <thead>
                        <tr>
                            <th>Page Group</th>
                            <th>
                                <span data-microtip-title="Order Number" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">📚</span>
                                    } else
                                    {
                                        <span class="fas fa-layer-group"></span>
                                    }
                                </span>
                            </th>
                            <th>Name</th>
                            <th>
                                <span data-microtip-title="Can View" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">👁️</span>
                                    }
                                    else
                                    {
                                        <span class="fas fa-eye"></span>
                                    }
                                </span>
                            </th>
                            <th>
                                <span data-microtip-title="Can Add" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">➕</span>
                                    }
                                    else
                                    {
                                        <span class="fas fa-plus"></span>
                                    }
                                </span>
                            </th>
                            <th>
                                <span data-microtip-title="Can Edit" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">✏️</span>
                                    }
                                    else
                                    {
                                        <span class="fas fa-edit"></span>
                                    }
                                </span>
                            </th>
                            <th>
                                <span data-microtip-title="Can Delete" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">🗑️</span>
                                    }
                                    else
                                    {
                                        <span class="fas fa-trash-alt"></span>
                                    }
                                </span>
                            </th>
                            <th>
                                <span data-microtip-title="Can Approve / Disapprove" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">👍</span>
                                    }
                                    else
                                    {
                                        <span class="fas fa-thumbs-up"></span>
                                    }
                                </span>
                            </th>
                            <th>
                                <span data-microtip-title="Can Upload&#13; / Download" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">📤📥</span>
                                    }
                                    else
                                    {
                                        <span class="fas fa-file-download"></span>
                                    }
                                </span>
                            </th>
                            <th>
                                <span data-microtip-title="Can Print" data-microtip-position="bottom" role="tooltip">
                                    @if (isNewIcon)
                                    {
                                        <span class="emoji">🖨️</span>
                                    }
                                    else
                                    {
                                        <span class="fas fa-print"></span>
                                    }
                                </span>
                            </th>
                        </tr>

                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card card-default">
            <div class="card-header">
                <span class="card-title">
                    @if (isNewIcon)
                    {
                        <span class="emoji">🕒</span>
                    }
                     Audit Logs (Latest 100)
                </span>
            </div>
            <div class="card-body">
                <table class="table table-head-fixed table-striped table-hover table-logs">
                    <thead>
                        <tr>
                            <th>Date Time</th>
                            <th>Action Type</th>
                            <th>Table Name</th>
                            <th>Primary Key</th>
                            <th>Old Values</th>
                            <th>New Values</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null)
                        {
                            <tr><td colspan="5"><p class="text-center m-0">This record is empty</p></td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DateTime.ToString("yyyy/MM/dd hh:mm:ss tt")</td>
                                    <td>@item.Type</td>
                                    <td>@item.TableName</td>
                                    <td><pre>@item.PrimaryKey</pre></td>
                                    <td>
                                        <pre>@item.OldValues.Replace("{", "").Replace("}", "").Replace(",\"", ",\n\"")</pre>
                                    </td>
                                    <td>
                                        <pre>@item.NewValues.Replace("{", "").Replace("}", "").Replace(",\"", ",\n\"")</pre>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card card-default">
            <div class="card-header">
                <span class="card-title">
                    @if (isNewIcon)
                    {
                        <span class="emoji">⛃</span>
                    }
                    Browser's Local Storage
                </span>
                <div class="card-tools">
                    <button class="btn btn-danger btn-sm float-right btn-filter btn-clear-local-storage">
                        <span class="fas fa-times"></span> Clear All
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-head-fixed table-striped table-hover table-local-storage">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Source</th>
                            <th>Content</th>
                            <th>Expiration</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var iconWithAccess = "<i class=\"fas fa-check text-success\"></i>";
        var iconWithoutAccess = "<i class=\"fas fa-times text-danger\"></i>";
        var iconNoAccess = "<i class=\"text-muted\">-</i>";

        var accessDT = $('.table-access').on('preXhr.dt', function (e, settings, data) {
            //showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetUserAccessesDT", "Access")",
                type: "POST",
                data: function (data) {
                    data.userId = "@(activeUser?.Id ?? "")";
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Loading table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    data: "pageGroupId", name: "PageGroupId", visible: false
                },
                {
                    data: "orderNumber", name: "OrderNumber"
                },
                {
                    data: function (data, type, dataToSet) {
                        return "<nobr>" + data.name + "</nobr>";
                    }, name: "Name"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.hasView)
                            return data.canView ? iconWithAccess : iconWithoutAccess;
                        return iconNoAccess;
                    },
                    name: "CanView"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.hasAdd)
                            return data.canAdd ? iconWithAccess : iconWithoutAccess;
                        return iconNoAccess;
                    },
                    name: "CanAdd"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.hasEdit)
                            return data.canEdit ? iconWithAccess : iconWithoutAccess;
                        return iconNoAccess;
                    },
                    name: "CanEdit"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.hasDelete)
                            return data.canDelete ? iconWithAccess : iconWithoutAccess;
                        return iconNoAccess;
                    },
                    name: "CanDelete"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.hasApproveDisapprove)
                            return data.canApproveDisapprove ? iconWithAccess : iconWithoutAccess;
                        return iconNoAccess;
                    },
                    name: "CanApproveDisapprove"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.hasUploadDownload)
                            return data.canUploadDownload ? iconWithAccess : iconWithoutAccess;
                        return iconNoAccess;
                    },
                    name: "CanUploadDownload"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.hasPrint)
                            return data.canPrint ? iconWithAccess : iconWithoutAccess;
                        return iconNoAccess;
                    },
                    name: "CanPrint"
                }
            ],
            order: [[1, "asc"]],
            rowGroup: {
                dataSrc: "pageGroup"
            }
        });

        accessDT.on("draw", function () {
            //hideLoader();
        });

        $('.table-logs').DataTable({
            order: [[0, "desc"]]
        });

        $("#themeCheckbox").on("change", function (e) {
            $("#themeForm").submit();
        });

        $("#navIconCheckbox").on("change", function (e) {
            $("#navIconForm").submit();
        });

        storageDT = $('.table-local-storage').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "name", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<a href="' + window.location.origin + '' + data.path + '" class="link-info" target="_blank">' + data.path + '</a>';
                    },
                    className: "form-cell" 
                },
                {
                    data: function (data, type, dataToSet) {
                        return "<pre>" + data.content + "</pre>";
                    },
                    className: "form-cell" 
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.expiration || "<span class='fw-normal text-muted'>N/A</span>";
                    },
                    className: "form-cell"
                }
            ],
            order: [[3, "asc"]]
        });

        // storageDT.on("draw", function () {
        //     loadLocalStorageDT();
        // });
        loadLocalStorageDT()
        function loadLocalStorageDT() {
            Object.keys(localStorage).forEach(key => {
                if (key.startsWith('BAS_DT')) {
                    var local = JSON.parse(localStorage.getItem(key));
                    var removeKeys = ["time", "start", "length", "order", "search", "columns", "childRows", "select"];

                    var row = {
                        name: key,
                        path: local.pathname,
                        content: JSON.stringify(Object.fromEntries(
                                     Object.entries(local.data).filter(([k, v]) => 
                                        !removeKeys.includes(k) &&
                                        v != null &&
                                        v != "" &&
                                        v != undefined
                                 )), null, 3),
                        expiration: local.timestamp && local.duration ? (new Date(local.timestamp + local.duration)).toLocaleString() : null
                    };
                    storageDT.row.add(row).draw();
                }
            });
        }

        $(".btn-clear-local-storage").on("click", function () {
            swal({
                title: "Clean Local Storage",
                text: "Are you sure you want to clear saved settings for tables that have state saving enabled?",
                icon: "info",
                buttons: true
            }).then((confirm) => {
                if (confirm) {
                    storageDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                        var row_data = this.data();
                        localStorage.removeItem(row_data.name);
                        this.remove();
                    });
                    storageDT.draw(false);
                }
            });
        });
    </script>
}