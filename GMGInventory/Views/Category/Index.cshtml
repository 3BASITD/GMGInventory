@model IEnumerable<GenericAuditVM>

@{
    ViewData["Title"] = "Categories";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                <span class="fas fa-plus"></span> New Category
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserModified)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateModified)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="fas fa-check text-success"></span>
                            }
                            else
                            {
                                <span class="fas fa-times text-danger"></span>
                            }
                        </td>
                        <td>@item.UserCreated</td>
                        <td>@item.DateCreated</td>
                        <td>@item.UserModified</td>
                        <td>@item.DateModified</td>
                        <td>
                            <a class="btn btn-info btn-xs" asp-action="Details" asp-route-id="@item.Id" data-bs-toggle="tooltip" title="View Details">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            @if (item.IsActive)
                            {
                                <a class="btn btn-warning btn-xs" asp-action="Edit" asp-route-id="@item.Id" data-bs-toggle="tooltip" title="Edit Details">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <button data-id="@item.Id" class="btn btn-danger btn-xs deleteBtn" type="button" data-bs-toggle="tooltip" title="Delete / Deactivate Category">
                                    <i class="far fa-trash-alt"></i>
                                </button>
                            }
                            else
                            {
                                <button data-id="@item.Id" class="btn btn-success btn-xs reactivateBtn" type="button" data-bs-toggle="tooltip" title="Reactivate Category">
                                    <i class="fas fa-check"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form id="deleteCategoryForm" asp-action="Delete">
    <input type="hidden" id="deleteCategoryId" name="Id" />
</form>

<form id="reactivateCategoryForm" asp-action="Reactivate">
    <input type="hidden" id="reactivateCategoryId" name="Id" />
</form>

@section Scripts {
    <script>
        $('.deleteBtn').click(function(e) {
            swal({
                title: "Delete / Deactivate Category",
                text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                icon: "warning",
                buttons: true,
                dangerMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#deleteCategoryId').val(id);
                    $('#deleteCategoryForm').submit();
                }
            });
        });

        $('.reactivateBtn').click(function(e) {
            swal({
                title: "Reactivate Category",
                text: "Are you sure you want to reactivate this record?",
                icon: "info",
                buttons: true,
                infoMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#reactivateCategoryId').val(id);
                    $('#reactivateCategoryForm').submit();
                }
            });
        });
    </script>
}