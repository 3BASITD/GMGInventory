@model PackDetailsVM

@{
    ViewData["Title"] = "Start Packing";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Pack" asp-action="Index">Pack Listing</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="button" class="btn btn-primary btn-sm float-right ml-2" onclick="SavePack()">
                    <span class="fas fa-paper-plane"></span> Submit
                </button>
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="pack-so-number" class="form-label mb-0">Sales Order Number</label>
                        <select id="pack-so-number" class="s2-bold s2ph-bold s2ph-dark" name="SONumber" style="width: 100%"></select>
                        <span data-valmsg-for="pack-so-number" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">@Html.DisplayNameFor(model => model.CustomerCode)</span>
                        <b class="d-block">@Model?.CustomerCode</b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">@Html.DisplayNameFor(model => model.CustomerName)</span>
                        <b class="d-block">@Model?.CustomerName</b>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">@Html.DisplayNameFor(model => model.SalesOrderDate)</span>
                        <b class="d-block">@Model?.SalesOrderDate</b>
                    </p>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">@Html.DisplayNameFor(model => model.Forwarder)</span>
                        <b class="d-block">@Model?.Forwarder</b>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Packed Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Packed Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Box Number</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="4">Total</th>
                                        <th class="total-quantity">0</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Save Packed Item Modal -->
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Packed Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-head-fixed table-striped table-hover table-order">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Item Code</th>
                                <th>Item Name</th>
                                <th>Selling Price</th>
                                <th>Discount 1</th>
                                <th>Discount 2</th>
                                <th>Ordered Quantity</th>
                                <th>Inventory Quantity</th>
                                <th>Gross Price</th>
                                <th>Packed Quantity</th>
                                <th>Remaining Quantity</th>
                                <th>Extended Price</th>
                            </tr>
                        </thead>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        $("#pack-so-number").select2({
            minimumInputLength: 1,
            placeholder: '@Model?.SONumber',
            ajax: {
                url: "@Url.Action("GetSalesOrderOptions", "SalesOrder")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });

        $("#pack-so-number").on("select2:select", function () {
            window.location = "@Url.Action("Create", "Pack", new { id = "" })/" + $("#pack-so-number").val();
        });

        var orderDT = $('.table-order').DataTable({
            ajax: {
                url: "@Url.Action("GetItemsForPackJson", "SalesOrder")",
                data: { salesOrderId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-success btn-xs btn-add-item" data-microtip-title="Add Item" data-microtip-position="top-right" role="tooltip"><i class="fas fa-plus"></i></button>';
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "sellingPrice", name: "SellingPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "inventoryCount", name: "InventoryCount", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                { data: "packedQuantity", name: "PackedQuantity", className: "text-end" },
                { data: "remainingQuantity", name: "RemainingQuantity", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" }
            ]
        });

        orderDT.on("draw", function () {
            $(".table-order thead th").removeClass("text-end");

            $(".btn-add-item").on("click", function () {
                var rowdata = orderDT.row($(this).parents('tr')).data();
                itemDT.row.add(rowdata).draw();
                orderDT.row($(this).parents('tr')).remove().draw();
                toastrNoDuplicate("Added " + rowdata.itemCode + " on Packed Item(s)", "Success", "success");
            });
        });

        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top-right" role="tooltip"><i class="fas fa-minus"></i></button>';
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="' + data.quantity + '" value="1" class="form-control form-control-sm box-number" style="width: 100%;" />';
                    },
                    name: "BoxNumber",
                    className: "form-cell text-end"
                },
                { data: "itemCode", name: "ItemCode", className: "form-cell" },
                { data: "itemName", name: "ItemName", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="1999999" value="' + Math.max(0, data.quantity - data.packedQuantity) + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                    },
                    //name: "PackedQuantity",
                    className: "form-cell text-end"
                }
            ],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 4);
            }
        });

        itemDT.on("draw", function () {
            $(".btn-remove-item").on("click", function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                orderDT.row.add(rowdata).draw();
                itemDT.row($(this).parents('tr')).remove().draw();
                toastrNoDuplicate("Removed " + rowdata.itemCode + " on Packed Item(s)", "Warning", "warning");
            });

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".quantity").on("input", function () {
                ComputeTotalQuantity();
            });
        });

        function ComputeTotalQuantity() {
            total_quantity = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        itemDT.clear().draw();

        function GetItemsToPack() {
            var item_to_pack = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_box_number = parseInt($(this.node()).find(".box-number").val());
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                item_to_pack.push({
                    boxNumber: row_box_number,
                    item: row_data.itemId,
                    quantity: row_quantity,
                });
            });
            return item_to_pack;
        }

        function SavePack() {
            var itemsToPack = GetItemsToPack();
            if (itemsToPack.length == 0) {
                toastrNoDuplicate("No item to pack. Add an item to the list to continue", "Warning", "warning");
            } else if (itemsToPack.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastrNoDuplicate("Some items have 0 quantity. Can't pack an item with 0 quantity", "Warning", "warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveJson")",
                    data: {
                        SONumber: @Model?.Id,
                        Items: itemsToPack
                    },
                    error: jQueryCommonError,
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastrNoDuplicate(data.message, "Error", "error");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
        }
