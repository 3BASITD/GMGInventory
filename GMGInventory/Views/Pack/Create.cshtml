@model PackDetailsVM

@{
    ViewData["Title"] = "Start Packing";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
    var pageName = (string)ViewData["PageName"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Pack" asp-action="Index">Pack Listing</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-secondary btn-sm float-right ml-2" onclick="SavePack('save')">
                <span class="fas fa-save"></span> Save as Draft
            </button>
            <button type="button" class="btn btn-primary btn-sm float-right ml-2" onclick="SavePack('post')">
                <span class="fas fa-paper-plane"></span> Post
            </button>
            <a class="btn btn-light btn-sm float-right" asp-action="Index" asp-controller="@(pageName == "SalesOrder" ? "SalesOrder" : "Pack")">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <div class="form-group">
                    <label for="pack-so-number" class="form-label mb-0">Sales Order Number</label>
                    <select id="pack-so-number" class="s2-bold s2ph-bold s2ph-dark" name="SONumber" style="width: 100%"></select>
                    <span data-valmsg-for="pack-so-number" data-valmsg-replace="true" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">@Html.DisplayNameFor(model => model.CustomerCode)</span>
                    <b class="d-block">@Model?.CustomerCode</b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">@Html.DisplayNameFor(model => model.CustomerName)</span>
                    <b class="d-block">@Model?.CustomerName</b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">@Html.DisplayNameFor(model => model.SalesOrderDate)</span>
                    <b class="d-block">@Model?.SalesOrderDate</b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">@Html.DisplayNameFor(model => model.Forwarder)</span>
                    <b class="d-block">@Model?.Forwarder</b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Packed Item(s)</span>
                        <div class="card-tools">
                            <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                <span class="fas fa-plus"></span> Add Packed Item
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Package Number</th>
                                    <th>Package Type</th>
                                    <th>Item Code</th>                                 
                                    <th>Item Part Number</th>
                                    <th>Item Name</th>
                                    <th>Bin Location</th>
                                    <th>Extended Price</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th colspan="8" class="text-end">Total</th>
                                    <th class="total-quantity">0</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Save Packed Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Packed Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-4">
                        <label for="add-box" col-form-label pt-0" style="margin-bottom: 5px;">Package Number</label>
                        <input type="number" min="1" max="1999999" class="form-control form-control-sm" id="add-box" />
                        <label class="fw-normal text-info add-new-box" for="add-box" style="position: absolute; right: 34px; float: right; z-index: 99; top: 30px;">(NEW PACKAGE)</label>
                    </div>
                    <div class="col-12 col-sm-4">
                        <label for="add-type" col-form-label pt-0" style="margin-bottom: 5px;">Package Type</label>
                        <select id="add-type" style="width: 100%;">
                        </select>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-check form-switch pl-0">
                            <input class="form-check-input mr-1" type="checkbox" id="add-partial">
                            <label class="form-check-label" for="add-partial">Partial Quantity</label>
                        </div>
                        <input type="number" min="1" max="1999999" class="form-control form-control-sm" id="add-quantity" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 table-responsive">
                        <table class="table  table-striped table-hover table-order">
                            <thead>
                                <tr>
                                    <th>
                                        <input class="chkclassorderall" type="checkbox" />
                                    </th>
                                    <th>Item Code</th>
                                    <th>Part Number</th>
                                    <th>Item Name</th>
                                    <th>Selling Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Ordered Quantity</th>
                                    <th>Inventory Quantity</th>
                                    <th>Gross Price</th>
                                    <th>Packed Quantity</th>
                                    <th>Remaining Quantity</th>
                                    <th>Extended Price</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="form-check form-switch mt-2" style="position: absolute; left: 0;">
                    <input class="form-check-input mr-2" type="checkbox" id="hide-completed">
                    <label class="form-check-label" for="hide-completed">Hide Completed Items</label>
                </div>
                <button type="button" class="btn btn-primary btn-add-item">
                    <span class="fas fa-plus"></span> Add
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Cancel
                </button>
            </div>
        </div>
    </div>
</div>


<input type="hidden" id="salesOrderId" value="@ViewData["SOId"]" />

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        $("#pack-so-number").select2({
            minimumInputLength: 1,
            placeholder: '@Model?.SONumber',
            ajax: {
                url: "@Url.Action("GetSalesOrderOptions", "SalesOrder")"
            }
        });

        $("#pack-so-number").on("select2:select", function () {
            window.location = "@Url.Action("Create", "Pack", new { id = "" })/" + $("#pack-so-number").val() + "?page=Pack";
        });



        // Load Select2 Pack Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetPackTypeOptions")",
            success: function (data, status, xhr) {
                $("#add-type").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#addModal")
                });
            }
        });

        var orderDT = $('.table-order').DataTable({
            ajax: {
                url: '@Url.Action("GetItemsJson", "SalesOrder")',
                data: { salesOrderId: $("#salesOrderId").val() },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            serverSide: false,
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            info: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.inventoryCountD > 0 && data.remainingQuantityD > 0) {
                            if ($("#add-partial").prop("checked")) {
                                actions += '<input class="chkclassorder" type="radio" value="' + data.invoiceId + '" name="orderitemchk" />';
                            } else {
                                actions += '<input class="chkclassorder" type="checkbox" value="' + data.invoiceId + '" name="orderitemchk" />';
                            }
                        }
                        if(data.inventoryCountD == 0 && data.remainingQuantityD > 0) {
                            //actions += '<strong data-microtip-title="Empty inventory, nothing to pack" data-microtip-position="right" role="tooltip"><span class="fas fa-exclamation"></span></strong>';
                            actions += '<strong class="text-danger" data-microtip-title="Empty inventory, nothing to pack" data-microtip-position="right" role="tooltip">0 Stocks</strong>';
                        }
                        if (actions == '') {
                            actions += '<strong class="text-success" data-microtip-title="All order already been packed" data-microtip-position="right" role="tooltip">Completed</strong>';
                        }
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/Item/Details/" + data.itemId + "' class='link-info' target='_blank'>" + data.itemCode + "</a>";
                    },
                    name: "ItemCode"
                },
                { data: "itemPartNumber", name: "ItemPartNumber" },
                { data: "itemName", name: "ItemName" },
                { data: "sellingPrice", name: "SellingPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "inventoryCount", name: "InventoryCount", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                { data: "packedQuantity", name: "PackedQuantity", className: "text-end" },
                { data: "remainingQuantity", name: "RemainingQuantity", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" }
            ],
            order: [[1, "asc"]],
            // createdRow: function (row, data, dataIndex) {
            //     if (data.remainingQuantityD == 0) {
            //         $(row).addClass("text-muted");
            //         if($("#hide-completed").prop("checked")) {
            //             $(row).hide();
            //         } else {
            //             $(row).show();
            //         }
            //     } else if (data.inventoryCountD == 0 && data.remainingQuantityD > 0) {
            //         $(row).addClass("text-danger");
            //     }
            // }
            drawCallback: function (settings) {
                var api = this.api();
                api.rows().every(function () {
                    var data = this.data();
                    var row = this.node();

                    if (data.remainingQuantityD == 0) {
                        $(row).addClass("text-muted");
                        if ($("#hide-completed").prop("checked")) {
                            $(row).hide();
                        } else {
                            $(row).show();
                        }
                    } else if (data.inventoryCountD == 0 && data.remainingQuantityD > 0) {
                        $(row).addClass("text-danger");
                    } else {
                        $(row).removeClass("text-muted text-danger").show(); // reset styles
                    }
                });
            }
        });

        orderDT.on("draw", function () {
            $(".table-order thead th").removeClass("text-end");
            dtCheckboxes();
        });

        $("#hide-completed").on("change", function() {
            orderDT.draw();
        });

        $(".btn-add-item").on("click", function () {
            if ($("#add-box").val() == 0) {
                toastr.warning("Please enter package number", "Required field &lt;Package Number&gt;");
                $("#add-box").addClass("text-danger");
                $('span[data-valmsg-for="add-box"]').text("Please enter package number");
            } else if ($("#add-quantity").val() == 0 && $("#add-partial").prop("checked")) {
                toastr.warning("Please enter quantity", "Required field &lt;Quantity&gt;");
                $("#add-quantity").addClass("text-danger");
                $('span[data-valmsg-for="add-quantity"]').text("Please enter collector receipt");
            } else {
                var hasItemToAdd = false;

                var successItem = [], warningItem = [];
                var alertMessage = "";
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    var itemchk = $(this.node()).find(".chkclassorder");
                    if (itemchk.prop("checked")) {
                        if (row_data.inventoryCountD > 0) {
                            if ($("#add-partial").prop("checked") && row_data.remainingQuantityD < parseInt($("#add-quantity").val())) {
                                $("#add-quantity").val(parseInt(row_data.remainingQuantityD));
                                alertMessage = "Partial Quantity exceed the Remaining Quantity. Auto adjusted";
                            } else if (row_data.inventoryCountD < row_data.quantityD) {
                                alertMessage = "Ordered Quantity exceed the Inventory Quantity. Packing available quantity";
                            }

                            var quantityToPack = 0;
                            if ($("#add-partial").prop("checked")) {
                                quantityToPack = parseInt($("#add-quantity").val());
                            } else if (row_data.inventoryCountD < row_data.remainingQuantityD) {
                                quantityToPack = row_data.inventoryCountD;
                            } else {
                                quantityToPack = row_data.remainingQuantityD;
                            }


                            row_data.inventoryCountD = parseInt(row_data.inventoryCountD) - quantityToPack;
                            row_data.inventoryCount = FormatStringInteger(row_data.inventoryCountD);
                            row_data.packedQuantityD = parseInt(row_data.packedQuantityD) + quantityToPack;
                            row_data.packedQuantity = FormatStringInteger(row_data.packedQuantityD);
                            row_data.remainingQuantityD = parseInt(row_data.remainingQuantityD) - quantityToPack;
                            row_data.remainingQuantity = FormatStringInteger(row_data.remainingQuantityD);
                            row_data.grossPrice = FormatStringInteger(row_data.grossPriceD);

                            var toItem = {
                                id: row_data.id,
                                boxNumber: parseInt($("#add-box").val()),
                                packType: $("#add-type").val(),
                                packTypeName: $("#add-type").select2("data")[0].text,
                                itemId: row_data.itemId,
                                itemCode: row_data.itemCode,
                                itemPartNumber: row_data.itemPartNumber,
                                itemName: row_data.itemName,
                                binLocation: "",
                                quantity: quantityToPack,
                                extendedPriceD: row_data.grossPriceD
                            };

                            hasItemToAdd = true;
                            itemDT.row.add(toItem).draw();
                            successItem.push(row_data.itemCode);

                            this.data(row_data);
                            if (row_data.remainingQuantityD == 0) {
                                $(this.node()).addClass("text-muted");
                            } else if (row_data.inventoryCountD == 0 && row_data.remainingQuantityD > 0) {
                                $(this.node()).addClass("text-danger");
                            }
                        } else {
                            warningItem.push(row_data.itemCode);
                        }
                    }
                });
                if (successItem.length > 0) {
                    toastr.success("Added " + successItem.join(", ") + " on Packed Item(s)", "Success");

                    assignNewPackageNumber();
                }
                if (alertMessage != "") {
                    toastr.info(alertMessage, "Inventory Quantity");
                }
                if (warningItem.length > 0) {
                    toastr.warning(warningItem.join(", ") + " has 0 inventory quantity", "Inventory Quantity");
                }

                if (hasItemToAdd) {
                    $('#add-box').get(0).value++;
                }
                $(".chkclassorderall").prop("checked", false);
                $(".chkclassorderall").prop("indeterminate", false);
            }
        });

        $("#add-box").on("change", function () {
            if ($("#add-box").val() == 0) {
                toastr.warning("Please enter package number", "Required field &lt;Package Number&gt;");
                $("#add-box").addClass("text-danger");
                $('span[data-valmsg-for="add-box"]').text("Please enter package number");
            } else {
                $("#add-box").removeClass("text-danger");
                $('span[data-valmsg-for="add-box"]').text("");
            }
        });

        $("#add-quantity").on("change", function () {
            if ($("#add-quantity").val() == 0 && $("#add-partial").prop("checked")) {
                toastr.warning("Please enter quantity", "Required field &lt;Quantity&gt;");
                $("#add-quantity").addClass("text-danger");
                $('span[data-valmsg-for="add-quantity"]').text("Please enter collector receipt");
            } else {
                $("#add-quantity").removeClass("text-danger");
                $('span[data-valmsg-for="add-quantity"]').text("");
            }
        });

        function initBinLocationSelect2($select, itemCode) {
            if ($select.hasClass("select2-hidden-accessible")) {
                return; // already initialized
            }

            $select.select2({
                placeholder: 'Select Bin Location',
                allowClear: true,
                width: '100%',
                ajax: {
                    url: '@Url.Action("GetBinLocation", "Item")',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return {
                            search: itemCode
                        };
                    },
                    processResults: function(data, params) {
                        params.search = params.search;
                        return {
                            results: data.items, // adjust to match your controller's JSON shape
                            pagination: { more: data.more }
                        };
                    },
                    cache: true
                }
            });
        }


        var itemDT = $('.table-item').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (user_access.canEdit) {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top-right" role="tooltip"><span class="fas fa-minus"></span></button>';
                        }
                        return actions;
                    }
                },
                { data: "boxNumber", name: "BoxNumber", visible: false },
                { data: "packTypeName", name: "PackTypeName", visible: false },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemPartNumber", name: "ItemPartNumber" },
                { data: "itemName", name: "ItemName" },
                {
                    data: function(data, type, dataToSet) {
                        return '<select class="form-control form-control-sm binlocation" name="BinLocation" style="width: 100%"></select>';
                    },
                    name: "Bin Location",
                    className: "form-cell text-end"
                },
                { data: "extendedPriceD", name: "ExtendedPriceD" },
                {data: function (data, type, dataToSet) {
                       
                    return '<input type="number" min="0" max="1999999" value="' + data.quantity + '" class="form-control form-control-sm quantity" style="width: 100%;" />';

                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                }
            ],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 5);
            },
            order: [[3, "asc"]],
            orderFixed: [[1, 'asc'], [2, 'asc']],
            rowGroup: {
                startRender: function (rows, group) {
                    return $('<tr/>')
                        .append('<td colspan="7"><strong>Package ' + group + '</strong></td>');
                },
                endRender: function (rows, group) {
                    return $('<tr/>')
                        .append('<td></td>')
                        .append('<td colspan="5" class="text-end">Total Quantity for <strong>Package ' + group + '</strong></td>')
                        .append('<td class="text-end">' + rows.data().pluck("quantity").reduce(function (a, b) { return parseInt(a) + parseInt(b); }, 0) + '</td>');
                },
                dataSrc: function (row) {
                    return "#" + row.boxNumber + " (" + row.packTypeName + ")";
                }
            }
        });

        itemDT.on("draw", function () {
            $(".btn-remove-item").off("click").on("click",  function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                var quantityToPack = parseInt(rowdata.quantity);
                var deletedBoxNumber = rowdata.boxNumber;
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    if (row_data.id == rowdata.id) {
                        row_data.remainingQuantityD = parseInt(row_data.remainingQuantityD) + quantityToPack;
                        row_data.remainingQuantity = FormatStringInteger(row_data.remainingQuantityD);
                        row_data.packedQuantityD = parseInt(row_data.packedQuantityD) - quantityToPack;
                        row_data.packedQuantity = FormatStringInteger(row_data.packedQuantityD);
                        row_data.inventoryCountD = parseInt(row_data.inventoryCountD) + quantityToPack;
                        row_data.inventoryCount = FormatStringInteger(row_data.inventoryCountD);

                        this.data(row_data);
                        if (row_data.remainingQuantityD == 0) {
                            $(this.node()).addClass("text-muted");
                        } else {
                            $(this.node()).removeClass("text-muted");
                        }
                        if (row_data.inventoryCountD == 0 && row_data.remainingQuantityD > 0) {
                            $(this.node()).addClass("text-danger");
                        } else {
                            $(this.node()).removeClass("text-danger");
                        }
                    }
                });

                dtCheckboxes();
                itemDT.row($(this).parents('tr')).remove().draw();

                var sameBoxNumber = itemDT.rows(function(idx, data, node) {
                    return data.boxNumber === deletedBoxNumber;
                })[0].length;

                if (!sameBoxNumber) {
                    var lastBox = 0;
                    itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                        var row_data = this.data();
                        if (row_data.boxNumber > deletedBoxNumber) {
                            row_data.boxNumber = parseInt(row_data.boxNumber) - 1;
                            this.data(row_data);
                        }
                        lastBox = row_data.boxNumber;
                    });
                    itemDT.draw(false);
                    $("#add-box").val(parseInt(lastBox) + 1);
                }

                toastr.warning("Removed " + rowdata.itemCode + " on Packed Item(s)", "Warning");
            });

            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");

            $(".quantity").off("input").on("input", function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                var $qtyInput = $(this).parents("tr").find(".quantity");
                //var quantityToPack = parseInt($(this).parents("tr").find(".quantity").val());//parseInt(rowdata.quantity);

                // NEW quantity user typed
                var newQty = parseInt($(this).parents("tr").find(".quantity").val()) || 0;

                // OLD quantity stored in the row object
                var oldQty = parseInt(rowdata.quantity) || 0;

                var delta = newQty - oldQty;
                // Update the row’s stored quantity so that next input compares correctly
                rowdata.quantity = newQty;


                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();

                    if (row_data.id == rowdata.id) {

                        if((parseInt(row_data.remainingQuantityD) - delta) >= 0)  {

                           
                            row_data.remainingQuantityD = parseInt(row_data.remainingQuantityD) - delta;
                            row_data.remainingQuantity = FormatStringInteger(row_data.remainingQuantityD);
                            row_data.packedQuantityD = parseInt(row_data.packedQuantityD) + delta;
                            row_data.packedQuantity = FormatStringInteger(row_data.packedQuantityD);
                            row_data.inventoryCountD = parseInt(row_data.inventoryCountD) - delta;
                            row_data.inventoryCount = FormatStringInteger(row_data.inventoryCountD);
                        

                           
                        
                        }
                        else{
                                var correctedQty = oldQty;

                                rowdata.quantity = correctedQty;

                                // avoid infinite loop
                                $qtyInput.off("input");
                                $qtyInput.val(correctedQty);
                                $qtyInput.on("input", arguments.callee);


                                toastr.warning("Partial Quantity exceed the Remaining Quantity.", "Warning");
                        }



                         this.data(row_data);
                            if (row_data.remainingQuantityD == 0) {
                                $(this.node()).addClass("text-muted");
                            } else {
                                $(this.node()).removeClass("text-muted");
                            }
                            if (row_data.inventoryCountD == 0 && row_data.remainingQuantityD > 0) {
                                $(this.node()).addClass("text-danger");
                            } else {
                                $(this.node()).removeClass("text-danger");
                            }
                                            
                    }
                });

                dtCheckboxes();
                itemDT.draw();
                

            });

            $(".binlocation").each(function() {
                var $select = $(this);
                var rowData = itemDT.row($select.closest("tr")).data();
                if (rowData) {
                    initBinLocationSelect2($select, rowData.itemCode);

                    // restore previously selected bin location after a redraw
                    if (rowData.binLocation) {
                        var $option = new Option(rowData.binLocationText || rowData.binLocation, rowData.binLocation, true, true);
                        $select.append($option).trigger('change');
                    }
                }
            });

            $(".binlocation").off("select2:select select2:clear").on("select2:select select2:clear", function(e) {
                var $row = $(this).closest("tr");
                var rowdata = itemDT.row($row).data();
                if (!rowdata) return;

                var selected = $(this).select2("data")[0];

                rowdata.binLocation = $(this).val() || "";
                rowdata.binLocationText = selected ? selected.text : "";
            });
        });

        $(".createBtn").on("click", function() {
            assignNewPackageNumber();
            $("#add-box").val($("#add-box").attr("max"));
        });

        function assignNewPackageNumber() {
            var packageNumbers = itemDT.rows().data().toArray().map(row => parseInt(row.boxNumber));
            var nextPackageNumber = packageNumbers.length == 0 ? 1 : (Math.max(...packageNumbers) + 1);

            $("#add-box").attr("max", nextPackageNumber);
            $(".add-new-box").slideDown();
        }

        $("#add-box").on("change", function() {
            var max = parseInt($(this).attr('max'));
            var value = parseInt($(this).val());
            if (value == max) {
                $(".add-new-box").slideDown();
            } else {
                $(".add-new-box").slideUp();
            }
        });

        $("#add-box").on("blur", function() {
            var max = parseInt($(this).attr('max'));
            var value = parseInt($(this).val());
            if (!isNaN(value) && value > max) {
                $(this).val(max);
                $(".add-new-box").slideDown();
            }
        });

        $("#add-quantity").hide();
        $("#add-partial").on("change", function () {
            if ($(this).prop("checked")) {
                $("#add-quantity").val(1);
                $("#add-quantity").show();
                $("#add-quantity").focus();
                $(".chkclassorder").attr("type", "radio");
                $(".chkclassorderall").hide();
            } else {
                $("#add-quantity").val("");
                $("#add-quantity").hide();
                $(".chkclassorder").attr("type", "checkbox");
                $(".chkclassorderall").show();
            }
            $(".chkclassorder").prop("checked", false);
            $(".chkclassorderall").prop("checked", false);
            $(".chkclassorderall").prop("indeterminate", false);
        });

        dtCheckboxes();
        function dtCheckboxes() {
            $(".chkclassorderall").off("change").on("change", function () {
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    $(this.node()).find(".chkclassorder").prop("checked", $(".chkclassorderall").prop("checked"));
                });
            });

            $(".chkclassorder").off("change").on("change", function () {
                var rows_checked = 0;
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if ($(this.node()).find(".chkclassorder").prop("checked")) {
                        rows_checked++;
                    }
                });

                if (rows_checked == 0) {
                    $(".chkclassorderall").prop("checked", false);
                    $(".chkclassorderall").prop("indeterminate", false);
                } else if (rows_checked == orderDT.rows().count()) {
                    $(".chkclassorderall").prop("checked", true);
                    $(".chkclassorderall").prop("indeterminate", false);
                } else if (rows_checked == 0) {
                    $(".chkclassorderall").prop("checked", false);
                    $(".chkclassorderall").prop("indeterminate", false);
                } else {
                    $(".chkclassorderall").prop("checked", false);
                    $(".chkclassorderall").prop("indeterminate", true);
                }
            });
        }

        itemDT.clear().draw();

        function GetItemsToPack() {
            var item_to_pack = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                item_to_pack.push({
                    boxNumber: row_data.boxNumber,
                    packTypeId: row_data.packType,
                    itemId: row_data.itemId,
                    binLocation: row_data.binLocationText,
                    quantity: row_data.quantity,
                    extendedPriceD: row_data.extendedPriceD
                });
            });
            return item_to_pack;
        }


        

        function SavePack(savingAs) {
            var itemsToPack = GetItemsToPack();
            if (itemsToPack.length == 0) {
                toastr.warning("No item to pack. Add an item to the list to continue", "Warning");
                //} else if (itemsToPack.filter(s => parseInt(s.quantity) > parseInt(s.served_quantity)).length > 0) {
                //    toastr.warning("Some items have exceeded the served quantity. Please update the served quantity on sales order", "Warning");
            } else if (itemsToPack.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't pack an item with 0 quantity", "Warning");
            } else if (itemsToPack.filter(s => !s.binLocation).length > 0) {
                toastr.warning("Some items are missing a bin location. Please select one for each item", "Warning");

                itemDT.rows().every(function() {
                    var row_data = this.data();
                    var $select = $(this.node()).find(".binlocation");
                    if (!row_data.binLocation) {
                        $select.next(".select2-container").find(".select2-selection").addClass("border-danger");
                    } else {
                        $select.next(".select2-container").find(".select2-selection").removeClass("border-danger");
                    }
                });
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveJson")",
                    data: {
                        SalesOrderId: $("#salesOrderId").val(),
                        Items: itemsToPack,
                        SavingAs: savingAs
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else if (data.status == "Error2") {
                            toastr.error(data.message, "Cannot proceed, Insufficient stock(s) for item(s):");
                        } else {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                        }
                    }
                });
            }
        }
    </script>
}
