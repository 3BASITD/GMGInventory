@model PackDetailsVM

@{
    ViewData["Title"] = "Package Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Pack" asp-action="Index">Pack Listing</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanPrint)
            {
                <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                    <span class="fas fa-print"></span> Print
                </button>
            }
            @if (this.User.IsInRole(Roles.InvoicingClerk) || this.User.IsInRole(Roles.SystemAdmin))
            {
                @if (Model.Status == "Posted")
                {
                    <a href="@Url.Action("Create", "SalesInvoice")/@Model?.Id" class="btn btn-primary btn-sm float-right ml-2">
                        <span class="fas fa-file-invoice"></span> Start Invoice
                    </a>
                }
                @if (Model?.Status == "Draft")
                {
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2" onclick="DeletePack()">
                        <span class="fas fa-trash"></span> Delete
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm float-right ml-2" onclick="SavePack('save')">
                        <span class="fas fa-save"></span> Save as Draft
                    </button>
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2" onclick="SavePack('post')">
                        <span class="fas fa-paper-plane"></span> Post
                    </button>
                }@*
                else
                {
                <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                <span class="fas fa-print"></span> Print
                </button>
                }*@
            }
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Id)
                    </span>
                    <b class="d-block">
                        @Model?.Id
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerCode)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerCode
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Forwarder)
                    </span>
                    <b class="d-block">
                        @Model?.Forwarder
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SONumber)
                    </span>
                    <b class="d-block">
                        @Model?.SONumber
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SalesOrderDate)
                    </span>
                    <b class="d-block">
                        @Model?.SalesOrderDate
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PackDate)
                    </span>
                    <b class="d-block">
                        @Model?.PackDate
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PackBy)
                    </span>
                    <b class="d-block">
                        @Model?.PackBy
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Status)
                    </span>
                    <b class="d-block">
                        @Model?.Status
                    </b>
                    <input type="hidden" id="pack-status" value="@Model?.Status" />
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Pack Item(s)</span>
                        @if (Model?.Status == "Draft")
                        {
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Packed Item
                                </button>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Package Number</th>
                                    <th>Package Type</th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th colspan="5" class="text-end">Total</th>
                                    <th>0</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Save Packed Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Packed Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-4">
                        <label for="add-box" col-form-label pt-0" style="margin-bottom: 5px;">Package Number</label>
                        <input type="number" min="1" max="1999999" class="form-control form-control-sm" id="add-box" value="1" />
                        <span data-valmsg-for="add-box" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-sm-4">
                        <label for="add-type" col-form-label pt-0" style="margin-bottom: 5px;">Package Type</label>
                        <select id="add-type" style="width: 100%;">
                        </select>
                        <span data-valmsg-for="add-type" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-check form-switch pl-0">
                            <input class="form-check-input mr-1" type="checkbox" id="add-partial">
                            <label class="form-check-label" for="add-partial">Partial Quantity</label>
                        </div>
                        <input type="number" min="1" max="1999999" class="form-control form-control-sm" id="add-quantity" />
                        <span data-valmsg-for="add-quantity" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <table class="table table-head-fixed table-striped table-hover table-order">
                            <thead>
                                <tr>
                                    <th>
                                        <input class="chkclassorderall" type="checkbox" />
                                    </th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Selling Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Ordered Quantity</th>
                                    <th>Inventory Quantity</th>
                                    <th>Gross Price</th>
                                    <th>Packed Quantity</th>
                                    <th>Remaining Quantity</th>
                                    <th>Extended Price</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-add-item">
                    <span class="fas fa-plus"></span> Add
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Cancel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load Select2 Pack Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetPackTypeOptions")",
            success: function (data, status, xhr) {
                $("#add-type").select2({
                    data: data,
                    dropdownParent: $("#addModal")
                });
            }
        });

        var orderDT = $('.table-order').DataTable({
            ajax: {
                url: "@Url.Action("GetItemsForPackJson", "SalesOrder")",
                data: {
                    salesOrderId: @Model?.SalesOrderId
                                                },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            searching: false,
            paging: false,
            info: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.remainingQuantity > 0) {
                            //actions += '<button type="button" class="btn btn-success btn-xs btn-add-item" data-microtip-title="Add Item" data-microtip-position="top-right" role="tooltip"><i class="fas fa-plus"></i></button>';
                            if (user_access.canEdit) {
                                if ($("#add-partial").prop("checked")) {
                                    actions += '<input class="chkclassorder" type="radio" value="' + data.invoiceId + '" name="orderitemchk" />';
                                } else {
                                    actions += '<input class="chkclassorder" type="checkbox" value="' + data.invoiceId + '" name="orderitemchk" />';
                                }
                            }
                        }
                        return actions;
                    }
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "sellingPrice", name: "SellingPrice", className: "text-end" },
                { data: "discount1", name: "Discount1", className: "text-end" },
                { data: "discount2", name: "Discount2", className: "text-end" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "inventoryCount", name: "InventoryCount", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                { data: "packedQuantity", name: "PackedQuantity", className: "text-end" },
                { data: "remainingQuantity", name: "RemainingQuantity", className: "text-end" },
                { data: "grossPrice", name: "GrossPrice", className: "text-end" }
            ],
            order: [[1, "asc"]],
            createdRow: function (row, data, dataIndex) {
                if (data.remainingQuantity == 0) {
                    $(row).addClass("text-muted");
                }
            }
        });

        orderDT.on("draw", function () {
            $(".table-order thead th").removeClass("text-end");
            dtCheckboxes();
        });

        $(".btn-add-item").off("click").on("click", function () {
            if ($("#add-box").val() == 0) {
                toastr.warning("Please enter package number", "Required field &lt;Package Number&gt;");
                $("#add-box").addClass("text-danger");
                $('span[data-valmsg-for="add-box"]').text("Please enter package number");
            } else if ($("#add-quantity").val() == 0 && $("#add-partial").prop("checked")) {
                toastr.warning("Please enter quantity", "Required field &lt;Quantity&gt;");
                $("#add-quantity").addClass("text-danger");
                $('span[data-valmsg-for="add-quantity"]').text("Please enter collector receipt");
            } else {
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    var itemchk = $(this.node()).find(".chkclassorder");
                    if (itemchk.prop("checked")) {
                        if (parseInt(row_data.remainingQuantity) > 0) {
                            if (parseInt(row_data.remainingQuantity) < parseInt($("#add-quantity").val())) {
                                $("#add-quantity").val(parseInt(row_data.remainingQuantity));
                                toastr.info("Partial Quantity exceed the Remaining Quantity. Auto adjusted", "Remaining Quantity");
                            }
                            var quantityToPack = 0;
                            if ($("#add-partial").prop("checked")) {
                                quantityToPack = parseInt($("#add-quantity").val());
                                row_data.remainingQuantity = parseInt(row_data.remainingQuantity) - parseInt($("#add-quantity").val());
                                row_data.packedQuantity = parseInt(row_data.packedQuantity) + parseInt($("#add-quantity").val());
                            } else {
                                quantityToPack = parseInt(row_data.remainingQuantity);
                                row_data.packedQuantity = parseInt(row_data.remainingQuantity) + parseInt(row_data.packedQuantity);
                                row_data.remainingQuantity = 0;
                            }
                            var toItem = {
                                id: row_data.id,
                                salesOrderLineItemId: row_data.id,
                                boxNumber: $("#add-box").val(),
                                packType: $("#add-type").val(),
                                packTypeName: $("#add-type").select2("data")[0].text,
                                itemId: row_data.itemId,
                                itemCode: row_data.itemCode,
                                itemName: row_data.itemName,
                                quantity: quantityToPack
                            };
                            itemDT.row.add(toItem).draw();
                            toastr.success("Added " + row_data.itemCode + " on Packed Item(s)", "Success");

                            this.data(row_data);
                            if (row_data.remainingQuantity == 0) {
                                $(this.node()).addClass("text-muted");
                            }
                        } else {
                            toastr.warning(row_data.itemName + " has 0 remaining quantity", "Remaining Quantity");
                        }
                    }
                });
                $(".chkclassorderall").prop("checked", false);
                $(".chkclassorderall").prop("indeterminate", false);
            }
        });

        $("#add-box").on("change", function () {
            if ($("#add-box").val() == 0) {
                toastr.warning("Please enter package number", "Required field &lt;Package Number&gt;");
                $("#add-box").addClass("text-danger");
                $('span[data-valmsg-for="add-box"]').text("Please enter package number");
            } else {
                $("#add-box").removeClass("text-danger");
                $('span[data-valmsg-for="add-box"]').text("");
            }
        });

        $("#add-quantity").on("change", function () {
            if ($("#add-quantity").val() == 0 && $("#add-partial").prop("checked")) {
                toastr.warning("Please enter quantity", "Required field &lt;Quantity&gt;");
                $("#add-quantity").addClass("text-danger");
                $('span[data-valmsg-for="add-quantity"]').text("Please enter collector receipt");
            } else {
                $("#add-quantity").removeClass("text-danger");
                $('span[data-valmsg-for="add-quantity"]').text("");
            }
        });

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { packId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            paging: false,
            searching: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if ($("#pack-status").val() == "Draft" && user_access.canEdit) { 
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top-right" role="tooltip"><i class="fas fa-minus"></i></button>';
                        }
                        return actions;
                    }
                },
                { data: "boxNumber", name: "BoxNumber", visible: false },
                { data: "packTypeName", name: "PackTypeName", visible: false },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode"
                },
                { data: "itemName", name: "ItemName" },
                { data: "quantity", name: "Quantity", className: "text-end" }
            ],
            order: [[0, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalInteger(api, 5);
            },
            order: [[3, "asc"]],
            orderFixed: [[1, 'asc'], [2, 'asc']],
            rowGroup: {
                startRender: function (rows, group) {
                    return $('<tr/>')
                        .append('<td colspan="4"><strong>Package ' + group + '</strong></td>');
                },
                endRender: function (rows, group) {
                    return $('<tr/>')
                        .append('<td colspan="3" class="text-end">Total Quantity for <strong>Package ' + group + '</strong></td>')
                        .append('<td class="text-end">' + rows.data().pluck("quantity").reduce(function (a, b) { return parseInt(a) + parseInt(b); }, 0) + '</td>');
                },
                dataSrc: function (row) {
                    return "#" + row.boxNumber + " (" + row.packTypeName + ")";
                }
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".btn-remove-item").off("click").on("click", function () {
                var rowdata = itemDT.row($(this).parents('tr')).data();
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    var row_data = this.data();
                    if (row_data.id == rowdata.salesOrderLineItemId) {
                        row_data.remainingQuantity = parseInt(row_data.remainingQuantity) + parseInt(rowdata.quantity);
                        row_data.packedQuantity = parseInt(row_data.packedQuantity) - parseInt(rowdata.quantity);
                        this.data(row_data);
                        if (row_data.remainingQuantity == 0) {
                            $(this.node()).addClass("text-muted");
                        } else {
                            $(this.node()).removeClass("text-muted");
                        }
                    }
                });

                dtCheckboxes();
                itemDT.row($(this).parents('tr')).remove().draw();
                toastr.warning("Removed " + rowdata.itemCode + " on Packed Item(s)", "Warning");
            });

            $(".table-item thead th").removeClass("text-end");

            $(".quantity").on("input", function () {
                CheckQuantityServed();
                ComputeTotalQuantity();
            });
        });

        $("#add-quantity").hide();
        $("#add-partial").on("change", function () {
            if ($(this).prop("checked")) {
                $("#add-quantity").val(1);
                $("#add-quantity").show();
                $("#add-quantity").focus();
                $(".chkclassorder").attr("type", "radio");
                $(".chkclassorderall").hide();
            } else {
                $("#add-quantity").val("");
                $("#add-quantity").hide();
                $(".chkclassorder").attr("type", "checkbox");
                $(".chkclassorderall").show();
            }
            $(".chkclassorder").prop("checked", false);
            $(".chkclassorderall").prop("checked", false);
            $(".chkclassorderall").prop("indeterminate", false);
        });

        dtCheckboxes();
        function dtCheckboxes() {
            $(".chkclassorderall").off("change").on("change", function () {
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    $(this.node()).find(".chkclassorder").prop("checked", $(".chkclassorderall").prop("checked"));
                });
            });

            $(".chkclassorder").off("change").on("change", function () {
                var rows_checked = 0;
                orderDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                    if ($(this.node()).find(".chkclassorder").prop("checked")) {
                        rows_checked++;
                    }
                });

                if (rows_checked == 0) {
                    $(".chkclassorderall").prop("checked", false);
                    $(".chkclassorderall").prop("indeterminate", false);
                } else if (rows_checked == orderDT.rows().count()) {
                    $(".chkclassorderall").prop("checked", true);
                    $(".chkclassorderall").prop("indeterminate", false);
                } else if (rows_checked == 0) {
                    $(".chkclassorderall").prop("checked", false);
                    $(".chkclassorderall").prop("indeterminate", false);
                } else {
                    $(".chkclassorderall").prop("checked", false);
                    $(".chkclassorderall").prop("indeterminate", true);
                }
            });
        }

        function GetItemsToPack() {
            var item_to_pack = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                item_to_pack.push({
                    boxNumber: row_data.boxNumber,
                    packType: row_data.packType,
                    item: row_data.itemId,
                    quantity: row_data.quantity,
                });
            });
            return item_to_pack;
        }

        function DeletePack() {
            swal({
                title: "Delete Pack",
                text: "Are you sure you want to delete this record?",
                icon: "error",
                buttons: true,
                dangerMode: true
            }).then((confirm) => {
                if (confirm) {
                    SavePack("delete");
                }
            });
        }

        function SavePack(savingAs) {
            var itemsToPack = GetItemsToPack();
            if (itemsToPack.length == 0) {
                toastr.warning("No item to pack. Add an item to the list to continue", "Warning");
                //} else if (itemsToPack.filter(s => parseInt(s.quantity) > parseInt(s.served_quantity)).length > 0) {
                //    toastr.warning("Some items have exceeded the served quantity. Please update the served quantity on sales order", "Warning");
            } else if (itemsToPack.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't pack an item with 0 quantity", "Warning");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateJson")",
                    data: {
                        Id: @Model?.Id,
                        SalesOrderId: @Model?.SalesOrderId,
                        Items: itemsToPack,
                        SavingAs: savingAs
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            if (data.newRow == -2) {
                                window.location = "@Url.Action("Index")";
                            } else {
                                window.location.reload();
                            }
                        }
                    }
                });
            }
        }

        $(".btn-details-print").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintDetails")/' + @Model?.Id, '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
}