@model PackDetailsVM

@{
    ViewData["Title"] = "Package Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Pack" asp-action="Index">Pack Listing</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title po-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                    <span class="fas fa-print"></span> Print
                </button>
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Id)
                        </span>
                        <b class="d-block">
                            @Model?.Id
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerCode)
                        </span>
                        <b class="d-block">
                            @Model?.CustomerCode
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerName)
                        </span>
                        <b class="d-block">
                            @Model?.CustomerName
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DeliveryType)
                        </span>
                        <b class="d-block">
                            @Model?.DeliveryType
                        </b>
                    </p>
                </div>
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.SONumber)
                        </span>
                        <b class="d-block">
                            @Model?.SONumber
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.SalesOrderDate)
                        </span>
                        <b class="d-block">
                            @Model?.SalesOrderDate
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PackDate)
                        </span>
                        <b class="d-block">
                            @Model?.PackDate
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PackBy)
                        </span>
                        <b class="d-block">
                            @Model?.PackBy
                        </b>
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Pack Item(s)</span>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th>Box Number</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="2"></th>
                                        <th>Total</th>
                                        <th>0</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { packId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "boxNumber", name: "BoxNumber" },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                { data: "quantity", name: "Quantity", className: "text-end" }
            ],
            order: [[0, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;
                columnDTTotalInteger(api, 3);
            }
        });

        itemDT.on("draw", function () {
            hideLoader();

            $(".table-item thead th").removeClass("text-end");
        });

        $(".btn-details-print").on("click", function () {
            var html = '<h3>Pack Details</h3>';
            html += '<table class="table-header w100">';
            html += '<tr>';

            html += '<th>@Html.DisplayNameFor(model => model.Id)</th><td>@Model?.Id</td>';
            html += '<th>@Html.DisplayNameFor(model => model.SONumber)</th><td>@Model?.SONumber</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.CustomerCode)</th><td>@Model?.CustomerCode</td>';
            html += '<th>@Html.DisplayNameFor(model => model.SalesOrderDate)</th><td>@Model?.SalesOrderDate</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.CustomerName)</th><td>@Model?.CustomerName</td>';
            html += '<th>@Html.DisplayNameFor(model => model.PackDate)</th><td>@Model?.PackDate</td>';
            html += '</tr>';
            html += '<tr>';
            html += '<th>@Html.DisplayNameFor(model => model.DeliveryType)</th><td>@Model?.DeliveryType</td > ';
            html += '<th>@Html.DisplayNameFor(model => model.PackBy)</th><td>@Model?.PackBy</td > ';
            html += '</tr>';
            html += '</table>';

            html += '<table class="table-items">';
            html += '<tr>';
            html += '<thead>';
            html += '<th>Box Number</th>';
            html += '<th>Item Code</th>';
            html += '<th>Item Name</th>';
            html += '<th>Quantity</th>';
            html += '</thead>';
            html += '</tr>';
            var totalQuantity = 0, totalNetPrice = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                html += '<tr>';
                html += '<td>' + row_data.boxNumber + '</td>';
                html += '<td>' + row_data.itemCode + '</td>';
                html += '<td>' + row_data.itemName + '</td>';
                html += '<td class="right-text">' + row_data.quantity + '</td>';
                html += '</tr>';

                totalQuantity += parseInt(row_data.quantity);
            });
            html += '<tr>';
            html += '<tfoot>';
            html += '<th colspan="3" class="right-text">Total</th>';
            html += '<th class="right-text">' + FormatStringInteger(totalQuantity) + '</th>';
            html += '</tfoot>';
            html += '</tr>';
            html += '</table>';
            $("#for-print").html(html);
            $("#for-print").printThis({
                importCSS: false,
                loadCSS: "/css/print.css",
                pageTitle: "GMG Inventory",
                beforePrint: function () {
                    $.LoadingOverlay("show", {
                        image: "",
                        fontawesome: "fas fa-print"
                    });
                },
                afterPrint: function () {
                    hideLoader();
                }
            });
        });
    </script>
}