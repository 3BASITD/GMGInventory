@model ItemViewVM

@{
    ViewData["Title"] = "Item Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Item" asp-action="Index">Items</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @*    @if (Model?.IsActive == true)
            {
            <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Edit" asp-route-id="@Model?.Id">
            <span class="fas fa-edit"></span> Edit Item
            </a>
            }*@
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-4">
                <p class="text-sm">
                    <label for="item-code" class="text-muted fw-normal mb-0">
                        @Html.DisplayNameFor(model => model.Code)
                    </label>
                    <select id="item-code" class="s2-bold s2ph-bold s2ph-dark" style="width: 100%;">
                    </select>
                    @*<span class="text-muted">
                    @Html.DisplayNameFor(model => model.Code)
                    </span>
                    <b class="d-block">
                    @Model?.Code
                    </b>*@
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Name
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </span>
                    <b class="d-block form-gayahin">
                        @(string.IsNullOrWhiteSpace(Model?.PartNumber) ? "-" : Model.PartNumber)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.InterchangeNumber)
                    </span>
                    <b class="d-block form-gayahin">
                        @(string.IsNullOrWhiteSpace(Model?.InterchangeNumber) ? "-" : Model.InterchangeNumber)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ModelNumber)
                    </span>
                    <b class="d-block form-gayahin">
                        @(string.IsNullOrWhiteSpace(Model?.ModelNumber) ? "-" : Model.ModelNumber)
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Category)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Category
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ItemType)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.ItemType
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Brand)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Brand
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.BeginningCost)
                    </span>
                    <b class="d-block form-gayahin">
                        @(string.IsNullOrWhiteSpace(Model?.BeginningCost) ? "N/A" : Model.BeginningCost)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        Location Codes
                    </span>
                    <div style="display:flex">
                        <b class="d-block form-gayahin">
                            @(string.IsNullOrWhiteSpace(Model?.LocationCodes) ? "N/A" : Model?.LocationCodes)
                        </b>
                        <button class="btn btn-warning btn-xs locationCodeBtn ml-2" data-bs-toggle="modal" data-bs-target="#addLocationCodeModal" data-microtip-title="Edit Location Codes"><i class="fas fa-pencil-alt"></i></button>
                    </div>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UnitCode)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.UnitCode
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Size)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Size
                    </b>
                </p>
                @if(userAccess.CanView) {
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.RetailPrice
                    </b>
                </p>
                }
                @if(userAccess.CanView) {
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.NetPrice
                    </b>
                </p>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-danger card-tabs">
                    <div class="card-header p-0 pt-1 pl-2 pr-2">
                        <ul class="nav nav-tabs nav-fill nav-item" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="nav-warehouse-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-warehouse"
                                   aria-controls="nav-warehouse" aria-selected="true">
                                    @*<br />*@Warehouse Details
                                </a>
                            </li>
                @if(userAccess.CanView) {
                            <li class="nav-item">
                                <a class="nav-link" id="nav-purchase-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-purchase"
                                   aria-controls="nav-purchase" aria-selected="true">
                                    Cost@*<br />*@ History
                                </a>
                            </li>
                }
                            <li class="nav-item">
                                <a class="nav-link" id="nav-sales-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-sales"
                                   aria-controls="nav-sales" aria-selected="true">
                                    Sales Order@*<br />*@ Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-count-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-count"
                                   aria-controls="nav-count" aria-selected="true">
                                    Physical Count@*<br />*@ Adjustment
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-conversion-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-conversion"
                                   aria-controls="nav-conversion" aria-selected="true">
                                    @*<br />*@Conversion Details
                                </a>
                            </li>
                @if(userAccess.CanView) {
                            <li class="nav-item">
                                <a class="nav-link" id="nav-price-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-price"
                                   aria-controls="nav-price" aria-selected="true">
                                    @*<br />*@Price History
                                </a>
                            </li>
                }
                            <li class="nav-item">
                                <a class="nav-link" id="nav-transfer-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-transfer"
                                   aria-controls="nav-transfer" aria-selected="true">
                                    Warehouse Transfer@*<br />*@ History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-return-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-return"
                                   aria-controls="nav-return" aria-selected="true">
                                    Sales Return@*<br />*@ History
                                </a>
                            </li>
                           
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-warehouse" role="tabpanel"
                                 aria-labelledby="nav-warehouse-tab">
                                <table class="table table-head-fixed table-striped table-hover table-warehouse">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Quantity</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            @if (userAccess.CanView)
                            {
                                <div class="tab-pane fade" id="nav-purchase" role="tabpanel" aria-labelledby="nav-purchase-tab">
                                    <table class="table table-head-fixed table-striped table-hover table-purchase">
                                    <thead>
                                        <tr>
                                            <th>PO Number</th>
                                            <th>Warehouse</th>
                                            <th>Supplier</th>
                                            <th>Quantity</th>
                                            <th>Unit Cost</th>
                                            <th>Total Cost</th>
                                            <th>Conversion Factor</th>
                                            <th>Converted Total Cost</th>
                                            <th>Replenish Date</th>
                                            <th>Replenish By</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>}
                            <div class="tab-pane fade" id="nav-sales" role="tabpanel" aria-labelledby="nav-sales-tab">
                                <table class="table table-head-fixed table-striped table-hover table-sales">
                                    <thead>
                                        <tr>
                                            <th>SO Number</th>
                                            <th>Customer</th>
                                            <th>Unit Price</th>
                                            <th>Quantity</th>
                                            <th>Packed Quantity</th>
                                            <th>Unserved Quantity</th>
                                            <th>Discount 1</th>
                                            <th>Discount 2</th>
                                            <th>Agent</th>
                                            <th>Created Date</th>
                                            <th>Created By</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-count" role="tabpanel" aria-labelledby="nav-count-tab">
                                <table class="table table-head-fixed table-striped table-hover table-count">
                                    <thead>
                                        <tr>
                                            <th>Warehouse</th>
                                            <th>Quantity From</th>
                                            <th>Quantity To</th>
                                            <th>Quantity Adjusted</th>
                                            <th>Adjustment Date</th>
                                            <th>Adjustment By</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade show" id="nav-conversion" role="tabpanel"
                                 aria-labelledby="nav-conversion-tab">
                                <div class="card-tools">
                                    <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2 mb-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                        <span class="fas fa-plus"></span> Add Item
                                    </button>
                                </div>
                                <table class="table table-head-fixed table-striped table-hover table-conversion">
                         
                                </table>
                            </div>
                            @if (userAccess.CanView)
                            {
                                <div class="tab-pane fade" id="nav-price" role="tabpanel" aria-labelledby="nav-price-tab">
                                    <table class="table table-head-fixed table-striped table-hover table-price">
                                        <thead>
                                            <tr>
                                                <th>Retail Price</th>
                                                <th>Net Price</th>
                                                <th>Update Date</th>
                                                <th>Update By</th>
                                            </tr>
                                        </thead>
                                    </table>
                                </div>
                            }
                            <div class="tab-pane fade" id="nav-transfer" role="tabpanel" aria-labelledby="nav-transfer-tab">
                                <table class="table table-head-fixed table-striped table-hover table-transfer">
                                    <thead>
                                        <tr>
                                            <th>Transfer Number</th>
                                            <th>Source</th>
                                            <th>Destination</th>
                                            <th>Quantity</th>
                                            <th>Transfer Date</th>
                                            <th>Transfer By</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-return" role="tabpanel" aria-labelledby="nav-return-tab">
                                <table class="table table-head-fixed table-striped table-hover table-return">
                                    <thead>
                                        <tr>
                                            <th>SR Number</th>
                                            <th>Item Code</th>
                                            <th>Item Name</th>
                                            <th>Quantity</th>
                                            <th>Customer</th>
                                            <th>Return Date</th>
                                            <th>Return By</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (userAccess.CanAdd)
{
    <!-- Add Item Conversion Modal -->
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Item Conversion</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12 col-sm-12">
                                <div class="form-group">
                                    <input type="hidden" id="add-orderNo" />

                                    <label for="add-option" class="form-label mb-0">Option</label>
                                    <div>
                                        <select class="form-control form-control-sm" id="add-option" name="Option" style="width: 100%;">
                                            <option>Conversion</option>
                                            <option>Item</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="divConversion">
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                        <input type="number" min="0" max="1999999" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="add-unit" class="form-label mb-0">Unit</label>
                                        <select name="Unit" id="add-unit" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="add-equivalent-quantity" class="form-label mb-0">Equivalent Quantity per Unit</label>
                                        <input type="number" min="0" max="1999999" id="add-equivalent-quantity" name="EquivalentQuantity" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="add-equivalent-unit" class="form-label mb-0">Equivalent Unit</label>
                                        <select name="EquivalentUnit" id="add-equivalent-unit" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="divItem">
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="add-item-quantity" class="form-label mb-0">Quantity</label>
                                        <input type="number" min="0" max="1999999" id="add-item-quantity" name="Quantity" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="add-item" class="form-label mb-0">Item</label>
                                        <select id="add-item" name="Item" style="width:100%">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-add">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (userAccess.CanEdit)
{
    <!-- Edit Item Conversion Modal -->
    <div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Item Conversion</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="editForm">
                    <div class="modal-body">
                        <div class="divConversion">
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <input type="hidden" id="edit-id" />
                                        <input type="hidden" id="edit-orderNo" />

                                        <label for="edit-quantity" class="form-label mb-0">Quantity</label>
                                        <input type="number" min="0" max="1999999" id="edit-quantity" name="Quantity" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="edit-unit" class="form-label mb-0">Unit</label>
                                        <select name="Unit" id="edit-unit" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="edit-equivalent-quantity" class="form-label mb-0">Equivalent Quantity per Unit</label>
                                        <input type="number" min="0" max="1999999" id="edit-equivalent-quantity" name="EquivalentQuantity" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="edit-equivalent-unit" class="form-label mb-0">Equivalent Unit</label>
                                        <select name="EquivalentUnit" id="edit-equivalent-unit" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="divItem">
                            <div class="row">
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="edit-item-quantity" class="form-label mb-0">Quantity</label>
                                        <input type="number" min="0" max="1999999" id="edit-item-quantity" name="Quantity" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="form-group">
                                        <label for="edit-item" class="form-label mb-0">Item</label>
                                        <input type="hidden" id="edit-item-hidden" />
                                        <select id="edit-item" name="SubItemId" style="width:100%">
                                            <option></option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-edit"></span> Update
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade" id="addLocationCodeModal" role="dialog" aria-labelledby="addLocationCodeModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Location Code(s)</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <button id="addLocationBtn" type="button" class="btn btn-primary btn-sm float-right ml-2" data-bs-toggle="modal" data-bs-target="#addLocationModal">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <table class="table table-head-fixed table-striped table-hover table-location">
                            <thead>
                                <tr>
                                    <th> Code</th>
                                    <th> Name</th>
                                    <th style="width:40px"></th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" id="btnCloseLocation">
                            <span class="fas fa-times"></span> Close
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade" id="addLocationModal" role="dialog" aria-labelledby="addLocationModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Item Location Code</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="createItemLocationForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="create-location" class="control-label mb-0 d-block">Location</label>

                                    <select name="LocationCode" id="create-location" class="form-control" style="width: 100%">
                                    </select>
                                   
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (userAccess.CanDelete)
{
    <form id="deleteConversionForm" asp-action="DeleteConversion">
        <input type="hidden" id="deleteConversionId" name="Id" />
    </form>

    <form id="deleteLocationForm" asp-action="DeleteItemLocation">
        <input type="hidden" id="deleteLocationId" name="Id" />
    </form>
}

<!-- Edit Quantity Modal -->
<div class="modal fade" id="quantityModal" role="dialog" aria-labelledby="quantityModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Adjust Physical Count</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="quantityForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="quantity-warehouse" class="control-label mb-0 d-block">Warehouse</label>
                                <input type="text" name="Warehouse" id="quantity-warehouse" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                            <div class="form-group">
                                <label for="quantity-current" class="control-label mb-0 d-block">Current Quantity</label>
                                <input type="number" step="1" max="1999999" name="Current" id="quantity-current" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                            <div class="form-group">
                                <label for="quantity-new" class="control-label mb-0 d-block">New Quantity</label>
                                <input type="number" step="1" max="1999999" name="New" id="quantity-new" class="form-control form-control-sm" />
                            </div>
                            <div class="form-group">
                                <label for="quantity-remarks" class="control-label mb-0 d-block">Remarks</label>
                                <textarea rows="2" name="Remarks" id="quantity-remarks" class="form-control form-control-sm">
                                </textarea>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" id="quantity-id" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-edit"></span> Adjust
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 Unit
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Unit")",
            success: function (data, status, xhr) {
                $("#add-unit").select2({
                    data: data,
                    dropdownParent: $("#addModal")
                });
                $("#edit-unit").select2({
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "<empty>"
                    },
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Equivalent Unit
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Unit")",
            success: function (data, status, xhr) {
                $("#add-equivalent-unit").select2({
                    data: data,
                    dropdownParent: $("#addModal")
                });
                $("#edit-equivalent-unit").select2({
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "<empty>"
                    },
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load item for select2
        $("#add-item").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                        : "") +
                    "<br />" +
                    "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                delay: 500,
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#addModal")
        });

      

        $("#item-code").select2({
            minimumInputLength: 1,
            placeholder: '@Model?.Code',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                        : "") +
                    "<br />" +
                    "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                delay: 500,
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            }
        });

        $("#edit-item").on("select2:select", function () {
            $("#edit-item-hidden").val($(this).select2("data")[0].id);
        });


        $("#item-code").on("select2:select", function () {
            window.location = window.location.href.replace("@Model?.Id", $("#item-code").val());
        });

        $("#add-option").on("change", function () {
            clearItemForm();
            if ($(this).val() == "Item") {
                $(".divItem").show();
                $(".divConversion").hide();
            }
            else {
                getLastConversion();

                $(".divItem").hide();
                $(".divConversion").show();
            }
        });

     

        function clearItemForm() {
            $("#add-quantity").val("0");
            $("#add-equivalent-quantity").val("0");
            $("#add-equivalent-unit").val("").trigger("change");
            $("#add-unit").val("").trigger("change");

            $("#add-item").val("").trigger("change");
            $("#add-item-quantity").val("0");
        }

        function getLastConversion() { 
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetItemConversionVM", "Item")",
                data: { itemId: @Model?.Id },
                success: function (data) {
                    if (data != null) {
                        document.getElementById("add-option").setAttribute("disabled", "disabled");
                        if (data.equivalentUnitId != null) {
                            $(".divConversion").show();
                            $(".divItem").hide();

                            $("#add-unit").val(data.equivalentUnitId).trigger("change");
                            $("#add-orderNo").val(data.orderNo);

                            // Load Select2 EquivalentUnit on Add
                            if ($("#add-unit").attr("data-select2-id")) {
                                $("#add-unit").select2("destroy");
                                $("#add-unit").empty();
                            }
                            $.ajax({
                                type: "POST",
                                url: "@Url.Action("GetOptions", "Unit")",
                                data: { includeId: data.equivalentUnitId },
                                success: function (data, status, xhr) {
                                    $("#add-unit").select2({
                                        data: data,
                                        allowClear: true,
                                        placeholder: {
                                            id: "",
                                            text: "<empty>"
                                        },
                                        dropdownParent: $('#editModal')
                                    });
                                }
                            });
                        }

                        
                        if(data.subItemId != null){
                            $(".divItem").show();
                            $(".divConversion").hide();
                            $("#add-orderNo").val(1);
                        }
                    }
                    else {
                        $("#add-orderNo").val(1);
                    }
                }
            });
        }

        $('.nav-item a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
            var selectedTab = e.currentTarget.dataset.bsTarget;
            if (selectedTab == "#nav-conversion") conversionDT.ajax.reload();
            if (selectedTab == "#nav-warehouse") warehouseDT.ajax.reload();
            if (selectedTab == "#nav-purchase") purchaseDT.ajax.reload();
            if (selectedTab == "#nav-sales") salesDT.ajax.reload();
            if (selectedTab == "#nav-count") countDT.ajax.reload();
            if (selectedTab == "#nav-price") priceDT.ajax.reload();
            if (selectedTab == "#nav-transfer") transferDT.ajax.reload();
            if (selectedTab == "#nav-return") returnDT.ajax.reload();
        });

        
        // Item Location
        var locationDT = $('.table-location').on('preXhr.dt', function (e, settings, data) {
              showBatchLoader("location");
        }).DataTable({
            ajax: {
                 url: "@Url.Action("GetLocationListJson")",
                type: "POST",
                data: function (data) {
                        data.Id = @Model?.Id;
                 },
            },
            serverSide: true,
            filter: false,
            responsive: true,
            autoWidth: false,
            search: {
                return: false,
            },
            columns: [
                 { data: "locationCode", name: "Code" },
                 { data: "locationName", name: "Name" },
                 {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a data-id="' + data.id + '" class="btn btn-danger btn-xs deleteLocationBtn" data-microtip-title="Delete Location" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></a>';
                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions + "</div>";
                    }
                }
            ],
            order: [[0, "asc"]]
             }).on("draw.dt", function () {
                    hideBatchLoader("location");

            if (user_access.canAdd) {
             // Actions upon Display Create Modal

                $("#btnCloseLocation").click(function (e) {
                  $('#product-options').modal('hide');
                  location.reload();
                });

                $("#addLocationBtn").click(function (e) {
                   $('#create-location').val(null).empty();

                     // Load Select2 Location Code
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetOptions2", "LocationCode")",
                        data: { itemId: @Model?.Id },
                        success: function (data, status, xhr) {
                            $("#create-location").select2({
                                data: data,
                                allowClear: true,
                                placeholder: {
                                    id: "",
                                    text: "<empty>"
                                },
                                dropdownParent: $('#addLocationModal')
                            });
                        }
                    });
            });

            // Validation for Create Modal
            var validateCreate = $("#createItemLocationForm").validate({
                rules: {
                     LocationCode: { required: true }
                },
                messages: {
                    LocationCode: { required: "Please select location code" },
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoCreateLocation();
                }
            });

            // Send Create to Controller
            function DoCreateLocation() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("CreateItemLocationJson")",
                    data: {
                        ItemId: @Model?.Id,
                        LocationCodeId: $("#create-location").val()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#addLocationModal").modal("hide");
                            locationDT.ajax.reload();
                        }
                    }
                });
            }
        }

            if (user_access.canDelete) {
                // Actions upon Display Edit Quantity Modal
                $(".deleteLocationBtn").click(function (e) {
                    var data = locationDT.row($(this).parents('tr')).data();
                    swal({
                             title: "Delete Item Location",
                              text:  "Are you sure you want to delete this record?",
                             icon: "warning",
                             buttons: true,
                             dangerMode: true
                         }).then((confirm) => {
                             if (confirm) {
                                 var btn = $(this);
                                 var id = btn.data("id");
                                 $('#deleteLocationId').val(id);
                                 $('#deleteLocationForm').submit();
                             }
                         });
                });
            }
         });
        
        

        //Conversion Details
        var conversionDT = $('.table-conversion').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetConversionListJson")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                },
            },
            serverSide: true,
            filter: false,
            ordering: false,
            searching: false,
            responsive: true,
            autoWidth: false,
            paging: true,
            search: {
                return: true,
            },
            columns: [
                { data: "subItemCode", title: "Item" },
                { data: "quantity", title: "Quantity" },
                { data: "unitName", title: "Unit" },
                { data: "equivalentQuantity", title: "Equivalent Quantity" },
                { data: "equivalentUnitName", title: "Equivalent Unit" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (user_access.canEdit) {
                            actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                        }
                        if (user_access.canDelete) {
                            actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                        }

                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions + "</div>";
                    }
                }
            ],
            order: [[0, "asc"]]
        });

        // Load functions upon DataTable load
        conversionDT.on("draw", function () {
            var data = conversionDT.row(0).data();

            if (data != null && data.subItemId != null) {
                for (var i = 2; i < 5; i++) {
                    conversionDT.column(i).visible(false, false);
                }
                conversionDT.column(0).visible(true, true);
            } else {
                var data = conversionDT.row(0).data();
                if (data != null && data.subItemId == null) {
                    conversionDT.column(0).visible(false, false);
                }
            }

            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete Conversion",
                        text: data != null && data.subItemId != null ? "Are you sure you want to delete this record?" : "If there's succeeding conversions, all of it will be deleted as well. Are you sure you want to proceed?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteConversionId').val(id);
                            $('#deleteConversionForm').submit();
                        }
                    });
                });
            }
          
            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = conversionDT.row($(this).parents('tr')).data();
                    $("#edit-id").val(data.id);
                    $("#edit-quantity").val(data.quantity);
                    $("#edit-equivalent-quantity").val(data.equivalentQuantity);
                    $("#edit-unit").val(data.unitId).trigger("change");
                    $("#edit-equivalent-unit").val(data.equivalentUnitId).trigger("change");
                    $("#edit-orderNo").val(data.orderNo);

                    var data = conversionDT.row($(this).parents('tr')).data();

                    if (data != null && data.subItemId != null) {
                        $(".divItem").show();
                        $(".divConversion").hide();

                        // Load item for select2
                        $("#edit-item").select2({
                            minimumInputLength: 1,
                            allowClear: true,
                            placeholder: '<empty>',
                            templateResult: function (repo) {
                                if (repo.loading) {
                                    return repo.text;
                                }
                                return $(
                                    "<strong>" + repo.text + "</strong> " +
                                    (repo.text != repo.name
                                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                                        : "") +
                                    "<br />" +
                                    "<small class='text-muted'>" +
                                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                                    "</small>");
                            },
                            ajax: {
                                url: "@Url.Action("GetOptions", "Item")",
                                dataType: 'json',
                                type: "POST",
                                delay: 500,
                                data: function (params) {
                                    return {
                                        search: params.term,
                                        page: params.page || 1
                                    };
                                },
                                processResults: function (data, params) {
                                    params.page = params.page || 1;
                                    return {
                                        results: data.items,
                                        pagination: {
                                            more: (params.page * 50) < data.total_count
                                        }
                                    };
                                },
                                cache: true
                            },
                            dropdownParent: $("#editModal")
                        });

                        $("#edit-item-quantity").val(data.quantity);
                        $("#edit-item-hidden").val(data.subItemId);
                    }
                    else {
                        $(".divItem").hide();
                        $(".divConversion").show();
                    }
                });

                // Validation for Edit Modal
                var validateEdit = $("#editForm").validate({
                    rules: {
                        Unit: { required: true },
                      //  EquivalentUnit: { required: true },
                        Quantity: { required: true, isNotZero: true },
                       // EquivalentQuantity: { required: true, isNotZero: true }
                    },
                    messages: {
                        Quantity: { required: "Please enter a quantity", isNotZero: "Can not add an item with 0 quantity" },
                       // EquivalentQuantity: { required: "Please enter a quantity", isNotZero: "Can not add an item with 0 quantity" },
                        Unit: { required: "Please select item to add." },
                       // EquivalentUnit: { required: "Please select item to add." }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoEdit();
                    }
                });


                // Send Edit to Controller
                function DoEdit() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("EditConversionJson")",
                        data: {
                            Id: $("#edit-id").val(),
                            SubItemId: $("#edit-item").val(),  
                            ItemId: @Model?.Id,
                            Quantity: $("#edit-item-hidden").val() != "" ? $("#edit-item-quantity").val() : $("#edit-quantity").val(),
                            UnitId: $("#edit-unit").val(),
                            EquivalentQuantity: $("#edit-equivalent-quantity").val(),
                            EquivalentUnitId: $("#edit-equivalent-unit").val(),
                            OrderNo: $("#edit-orderNo").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#editModal").modal("hide");
                                if($("#edit-orderNo").val() == 1)
                                {
                                    window.location.reload();
                                }
                                else
                                {
                                 conversionDT.ajax.reload();
                                }
                                 hideLoader();
                            }
                        }
                    });
                }
            }

            if (user_access.canAdd) {
                $(".createBtn").on('click', function () {
                    clearItemForm();
                  //  document.getElementById("add-unit").removeAttribute("disabled", "disabled");

                    if (data != null && data.subItemId != null) {
                        $(".divItem").show();
                        $(".divConversion").hide();

                        $("#add-option").val('Item');
                        document.getElementById("add-option").setAttribute("disabled", "disabled");
                    }
                    else {
                        $(".divConversion").show();
                        $(".divItem").hide();
                        $("#add-option").val('Conversion');

                        // if (data.subItemId == null || data.equivalentUnitId != null) {
                        //     debugger;
                        //    // document.getElementById("add-unit").setAttribute("disabled", "disabled"); 
                        // }

                        getLastConversion();
                    }

                });

                // Validation for Add Item Modal
                var validateAdd = $("#form-item").validate({
                    rules: {
                        Unit: { required: true },
                      //  EquivalentUnit: { required: true },
                        Quantity: { required: true, isNotZero: true },
                      //  EquivalentQuantity: { required: true, isNotZero: true }
                    },
                    messages: {
                        Quantity: { required: "Please enter a quantity", isNotZero: "Can not add an item with 0 quantity" },
                     //   EquivalentQuantity: { required: "Please enter a quantity", isNotZero: "Can not add an item with 0 quantity" },
                        Unit: { required: "Please select item to add." },
                      //  EquivalentUnit: { required: "Please select item to add." }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoCreate();
                    }
                });
                // Send Create to Controller
                function DoCreate() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("CreateItemConversionJson")",
                        data: {
                            ItemId: @Model?.Id,
                            Quantity: $("#add-item").val() == "" ? $("#add-quantity").val() : $("#add-item-quantity").val(),
                            UnitId: $("#add-unit").val(),
                            EquivalentQuantity: $("#add-item").val() == "" ? $("#add-equivalent-quantity").val() : null,
                            EquivalentUnitId: $("#add-equivalent-unit").val(),
                            OrderNo: $("#add-orderNo").val(),
                            SubItemId: $("#add-item").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#addModal").modal("hide");

                                if ($("#add-item").val() != "") { 
                                    for (var i = 2; i < 5; i++) {
                                        conversionDT.column(i).visible(false, false);
                                    }
                                    conversionDT.column(0).visible(true, true);
                                }
                                else {  
                                    conversionDT.column(0).visible(false, false);
                                }

                                conversionDT.ajax.reload();
                                hideLoader();
                            }
                        },
                        complete: function (xhr, status) {
                            $(".save-overlay").hideOverlay();
                        }
                    });
                }
            }

            hideLoader();
        });


        // Warehouse Details
        var warehouseDT = $('.table-warehouse').on('preXhr.dt', function (e, settings, data) {
            showBatchLoader("warehouse");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetWarehousesJson")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                }
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                            if (user_access.canEdit) {
                                actions += '<div data-microtip-title="Adjust Quantity" data-microtip-position="top-left" role="tooltip" class="d-inline-block"><button class="btn btn-warning btn-xs quantityBtn" data-bs-toggle="modal" data-bs-target="#quantityModal"><i class="fas fa-pencil-alt"></i></button></div>';
                            }
                        return actions;
                    }
                }
            ],
            order: [[0, "asc"]]
        }).on("draw.dt", function () {

            hideBatchLoader("warehouse");

            if (user_access.canEdit) {
                // Actions upon Display Edit Quantity Modal
                $(".quantityBtn").click(function (e) {
                    var data = warehouseDT.row($(this).parents('tr')).data();
                    validateEdit.hideThese(validateEdit.errors());
                    $("#quantity-warehouse").val(data.name);
                    $("#quantity-current").val(data.quantity);
                    $("#quantity-new").val(data.quantity);
                    $("#quantity-remarks").val("");
                    $("#quantity-id").val(data.id);
                });

                // Validation for Edit Quantity Modal
                var validateEdit = $("#quantityForm").validate({
                    rules: {
                        New: {
                            required: true,
                            notEqualTo: "#quantity-current"
                        },
                        Remarks: { maxlength: 500 }
                    },
                    messages: {
                        New: {
                            required: "Please enter new quantity.",
                            notEqualTo: "Equal quantity. No change will be done."
                        },
                        Remarks: { maxlength: "Remarks must not exceed 500 characters." }
                    },
                    submitHandler: function (form) {
                        DoQuantity();
                        return false;
                    }
                });

                // Send Quantity to Controller
                function DoQuantity() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("EditDetailQuantity")",
                        data: {
                            Id: $("#quantity-id").val(),
                            Quantity: $("#quantity-new").val(),
                            Remarks: $("#quantity-remarks").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                if($("#quantity-new").val() < 0) {
                                    toastr.info("New quantity saved was below 0", "Information");
                                }
                                toastr.success(data.message, "Success");
                                $("#quantityModal").modal("hide");
                                warehouseDT.ajax.reload();
                            }
                        }
                    });
                }
            }
        });

        if (user_access.canView) {
            // Purchase Order Details
            var purchaseDT = $('.table-purchase').on('preXhr.dt', function (e, settings, data) {
                showBatchLoader("purchase");
            }).DataTable({
                ajax: {
                    url: "@Url.Action("GetPurchasesJson")",
                    type: "POST",
