            }
        });

        $("#picForm").submit(function (evt) {
            evt.preventDefault();

            var formData = new FormData();
            formData.append("File", $("#item-image")[0].files[0]);
            formData.append("Id", item_details.id);

            $.ajax({
                type: "POST",
                url: "@Url.Action("SaveImage")",
                data: formData,
                async: false,
                cache: false,
                contentType: false,
                enctype: "multipart/form-data",
                processData: false,
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
