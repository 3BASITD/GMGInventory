<!-- Promo Modal -->
<div class="modal fade" id="promoModal" role="dialog" aria-labelledby="promoModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Item Promo</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="promoForm">
                <input type="hidden" name="Id" id="save-promo-id" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="save-promo-name" class="control-label mb-0 d-block">Name</label>
                                <input type="text" name="Name" id="save-promo-name" class="form-control" style="width: 100%" />
                                
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="save-promo-price" class="control-label mb-0 d-block">Price</label>
                                <input type="number" value="0" step="0.01" min="0" name="Price" id="save-promo-price" class="form-control form-control-sm" />
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="save-promo-effective" class="control-label mb-0 d-block">Effective Date</label>
                                <input type="date" name="EffectiveDate" id="save-promo-effective" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="save-promo-effective-time" class="control-label mb-0 d-block">Effective Time</label>
                                <input type="time" name="EffectiveTime" id="save-promo-effective-time" value="00:00:00" class="form-control form-control-sm" />
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="save-promo-expiration" class="control-label mb-0 d-block">Expiration Date</label>
                                <input type="date" name="ExpirationDate" id="save-promo-expiration" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="save-promo-expiration-time" class="control-label mb-0 d-block">Expiration Time</label>
                                <input type="time" name="ExpirationTime" id="save-promo-expiration-time" value="23:59:59" class="form-control form-control-sm" />
