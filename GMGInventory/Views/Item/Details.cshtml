        }

        $("#item-image").on("change", function () {
            if ($("#item-image").val() == "") {
                $("#pictureModal button[type=submit]").prop("disabled", true);
                $("label.custom-file-label[for='item-image']").text("Select image");
            } else {
                $("#pictureModal button[type=submit]").prop("disabled", false);
