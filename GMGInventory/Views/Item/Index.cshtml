@model IEnumerable<ItemViewVM>

@{
    ViewData["Title"] = "Items";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                <span class="fas fa-plus"></span> New Item
            </button>
            @await Html.PartialAsync("ItemFilter", ViewData["ItemFilter"])
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-item">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.InterchangeNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Warehouse)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<form id="deleteItemForm" asp-action="Delete">
    <input type="hidden" id="deleteItemId" name="Id" />
</form>

<form id="reactivateItemForm" asp-action="Reactivate">
    <input type="hidden" id="reactivateItemId" name="Id" />
</form>

<!-- Create Modal -->
<div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="createForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-code" class="control-label mb-0 d-block">Code</label>
                                <input type="text" name="Code" id="create-code" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-name" class="control-label mb-0 d-block">Name</label>
                                <input type="text" name="Name" id="create-name" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-part-number" class="control-label mb-0 d-block">Part Number</label>
                                <input type="text" name="PartNumber" id="create-part-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-part-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-interchange-number" class="control-label mb-0 d-block">Interchange Number</label>
                                <input type="text" name="InterchangeNumber" id="create-interchange-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-interchange-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-model-number" class="control-label mb-0 d-block">Model Number</label>
                                <input type="text" name="ModelNumber" id="create-model-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-model-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-size" class="control-label mb-0 d-block">Size</label>
                                <input type="text" name="Size" id="create-size" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-size" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-unit" class="control-label mb-0 d-block">Unit</label>
                                <select name="Unit" id="create-unit" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-unit" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-category" class="control-label mb-0 d-block">Category</label>
                                <select name="Category" id="create-category" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-category" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-item-type" class="control-label mb-0 d-block">Item Type</label>
                                <select name="ItemType" id="create-item-type" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-item-type" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-brand" class="control-label mb-0 d-block">Brand</label>
                                <select name="Brand" id="create-brand" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-brand" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-retail-price" class="control-label mb-0 d-block">Retail Price</label>
                                <input type="number" step="0.01" min="0" max="1999999.99" name="RetailPrice" id="create-retail-price" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-retail-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="create-net-price" class="control-label mb-0 d-block">Net Price</label>
                                <input type="number" step="0.01" min="0" max="1999999.99" name="NetPrice" id="create-net-price" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-net-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="editForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-code" class="control-label mb-0 d-block">Code</label>
                                <input type="text" name="Code" id="edit-code" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="edit-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-name" class="control-label mb-0 d-block">Name</label>
                                <input type="text" name="Name" id="edit-name" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-part-number" class="control-label mb-0 d-block">Part Number</label>
                                <input type="text" name="PartNumber" id="edit-part-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-part-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-interchange-number" class="control-label mb-0 d-block">Interchange Number</label>
                                <input type="text" name="InterchangeNumber" id="edit-interchange-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-interchange-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-model-number" class="control-label mb-0 d-block">Model Number</label>
                                <input type="text" name="ModelNumber" id="edit-model-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-model-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-size" class="control-label mb-0 d-block">Size</label>
                                <input type="text" name="Size" id="edit-size" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-size" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-unit" class="control-label mb-0 d-block">Unit</label>
                                <select name="Unit" id="edit-unit" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="edit-unit" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-category" class="control-label mb-0 d-block">Category</label>
                                <select name="Category" id="edit-category" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="edit-category" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-item-type" class="control-label mb-0 d-block">Item Type</label>
                                <select name="ItemType" id="edit-item-type" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="edit-item-type" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="edit-brand" class="control-label mb-0 d-block">Brand</label>
                                <select name="Brand" id="edit-brand" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="edit-brand" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" id="edit-id" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-edit"></span> Update
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load Select2 Unit
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetUnitOptions", "Item")",
            success: function(data, status, xhr) {
                $("#create-unit").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-unit").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Category
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Category")",
            success: function(data, status, xhr) {
                $("#create-category").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-category").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Item Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "ItemType")",
            success: function(data, status, xhr) {
                $("#create-item-type").select2({
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#createModal")
                });
                $("#edit-item-type").select2({
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Brand
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Brand")",
            success: function(data, status, xhr) {
                $("#create-brand").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-brand").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        var dataTable = $('.table-item').on('preXhr.dt', function(e, settings, data) {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fa fa-cog fa-spin"
            });
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function(data) {
                    var categoryId = $("#CategoryId").val();
                    var itemTypeId = $("#ItemTypeId").val();
                    var brandId = $("#BrandId").val();
                    var warehouseId = $("#WarehouseId").val();

                    if (categoryId) data.CategoryId = categoryId;
                    if (itemTypeId) data.ItemTypeId = itemTypeId;
                    if (brandId) data.BrandId = brandId;
                    if (warehouseId) data.WarehouseId = warehouseId;
                }
            },
            //processing: true,
            searchDelay: 1000,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "partNumber", name: "PartNumber" },
                { data: "interchangeNumber", name: "InterchangeNumber" },
                { data: "warehouse", name: "Warehouse" },
                { data: "retailPrice", name: "RetailPrice", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                {
                    orderable: false,
                    data: function(data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-bs-toggle="tooltip" title="View Details"><i class="fas fa-info-circle"></i></a>';
                        if (data.isActive) {
                            actions += '<div data-bs-toggle="tooltip" title="Edit Details"><button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal"><i class="fas fa-pencil-alt"></i></button></div>';
                            actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-bs-toggle="tooltip" title="Delete / Deactivate Item"><i class="far fa-trash-alt"></i></button>';
                        } else {
                            actions += '<button data-id="' + data.id + '" class="btn btn-success btn-xs reactivateBtn" type="button" data-bs-toggle="tooltip" title="Reactivate Item"><i class="fas fa-check"></i></button>';
                        }
                        return actions + "</div>";
                    }
                }
            ]
        });

        dataTable.on("init.dt", function() {
            reloadToolTip();

            $('.dataTables_filter input').unbind();
            $('.dataTables_filter input').keyup(function(e) {
                if (e.keyCode == 13) {
                    dataTable.search($(this).val()).draw();
                }
            });

            $.LoadingOverlay("hide");

            $('.deleteBtn').click(function(e) {
                swal({
                    title: "Delete / Deactivate Item",
                    text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        var btn = $(this);
                        var id = btn.data("id");
                        $('#deleteItemId').val(id);
                        $('#deleteItemForm').submit();
                    }
                });
            });

            $('.reactivateBtn').click(function(e) {
                swal({
                    title: "Reactivate Item",
                    text: "Are you sure you want to reactivate this record?",
                    icon: "info",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        var btn = $(this);
                        var id = btn.data("id");
                        $('#reactivateItemId').val(id);
                        $('#reactivateItemForm').submit();
                    }
                });
            });
            
            // Actions upon Display Edit Modal
            $(".editBtn").click(function(e) {
                var data = dataTable.row($(this).parents('tr')).data();

                $("#edit-id").val(data.id);
                $("#edit-code").val(data.code);
                $("#edit-name").val(data.name);
                $("#edit-part-number").val(data.partNumber);
                $("#edit-interchange-number").val(data.interchangeNumber);
                $("#edit-model-number").val(data.modelNumber);
                $("#edit-size").val(data.size);
                $("#edit-unit").val(data.unitId).trigger("change");
                $("#edit-category").val(data.categoryId).trigger("change");
                $("#edit-item-type").val(data.itemTypeId).trigger("change");
                $("#edit-brand").val(data.brandId).trigger("change");
            });
        });

        // Validation for Edit Modal
        var validateEdit = $("#editForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Code: { required: true, maxlength: 10 },
                Name: { required: true, maxlength: 100 },
                PartNumber: { maxlength: 50 },
                InterchangeNumber: { maxlength: 50 },
                ModelNumber: { maxlength: 50 },
                Size: { required: true, maxlength: 50 }
            },
            messages: {
                Code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
                Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                PartNumber: { maxlength: "Part number must not exceed 50 characters." },
                InterchangeNumber: { maxlength: "Interchange number must not exceed 50 characters." },
                ModelNumber: { maxlength: "Model number must not exceed 50 characters." },
                Size: { required: "Please enter size.", maxlength: "Size must not exceed 50 characters." }
            },
            submitHandler: function(form) {
                DoEdit();
                return false;
            }
        });

        // Send Edit to Controller
        function DoEdit() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("EditJson")",
                data: {
                    Id: $("#edit-id").val(),
                    Code: $("#edit-code").val(),
                    Name: $("#edit-name").val(),
                    PartNumber: $("#edit-part-number").val(),
                    InterchangeNumber: $("#edit-interchange-number").val(),
                    ModelNumber: $("#edit-model-number").val(),
                    Size: $("#edit-size").val(),
                    UnitId: $("#edit-unit").val(),
                    CategoryId: $("#edit-category").val(),
                    ItemTypeId: $("#edit-item-type").val(),
                    BrandId: $("#edit-brand").val()
                },
                error: jQueryCommonError,
                success: function(data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#editModal").modal("hide");
                        dataTable.ajax.reload();
                    }
                }
            });
        }

        // Actions upon Display Create Modal
        $(".createBtn").click(function(e) {
            $("#create-code").val("");
            $("#create-name").val("");
            $("#create-part-number").val("");
            $("#create-interchange-number").val("");
            $("#create-model-number").val("");
            $("#create-size").val("");
            $("#create-unit").prop("selectedIndex", 0).trigger("change");
            $("#create-category").prop("selectedIndex", 0).trigger("change");
            $("#create-item-type").prop("selectedIndex", 0).trigger("change");
            $("#create-brand").prop("selectedIndex", 0).trigger("change");
            $("#create-retail-price").val("");
            $("#create-net-price").val("");
        });

        // Validation for Create Modal
        var validateCreate = $("#createForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Code: { required: true, maxlength: 10 },
                Name: { required: true, maxlength: 100 },
                PartNumber: { maxlength: 50 },
                InterchangeNumber: { maxlength: 50 },
                ModelNumber: { maxlength: 50 },
                Size: { required: true, maxlength: 50 },
                RetailPrice: { required: true, range: [0, 1999999.99] },
                NetPrice: { required: true, range: [0, 1999999.99] }
            },
            messages: {
                Code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
                Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                PartNumber: { maxlength: "Part number must not exceed 50 characters." },
                InterchangeNumber: { maxlength: "Interchange number must not exceed 50 characters." },
                ModelNumber: { maxlength: "Model number must not exceed 50 characters." },
                Size: { required: "Please enter size.", maxlength: "Size must not exceed 50 characters." },
                RetailPrice: { required: "Please enter new Retail Price.", range: "Price must be between 0-1999999.99." },
                NetPrice: { required: "Please enter new Net Price.", range: "Price must be between 0-1999999.99." }
            },
            submitHandler: function(form) {
                DoCreate();
                return false;
            }
        });

        // Send Create to Controller
        function DoCreate() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("CreateJson")",
                data: {
                    Code: $("#create-code").val(),
                    Name: $("#create-name").val(),
                    PartNumber: $("#create-part-number").val(),
                    InterchangeNumber: $("#create-interchange-number").val(),
                    ModelNumber: $("#create-model-number").val(),
                    NetPrice: $("#create-net-price").val(),
                    RetailPrice: $("#create-retail-price").val(),
                    Size: $("#create-size").val(),
                    UnitId: $("#create-unit").val(),
                    CategoryId: $("#create-category").val(),
                    ItemTypeId: $("#create-item-type").val(),
                    BrandId: $("#create-brand").val()
                },
                error: jQueryCommonError,
                success: function(data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#createModal").modal("hide");
                        dataTable.ajax.reload();
                    }
                }
            });
        }

        function ApplyFilter() {
            dataTable.ajax.reload();
            $("#filterModal").modal("hide");
        }
    </script>
}