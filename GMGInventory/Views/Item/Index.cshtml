@if (userAccess.CanUploadDownload)
{
    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label mb-0" for="upload-file">Excel File</label>
                        <input type="file" id="upload-file" name="file"
                               accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                               class="form-control form-control-sm" />
                    </div>
                    <div class="row">
                        <div class="col-3">Items to upload</div>
                        <div class="col-9 upload-item-count"></div>
                        <div class="col-3">Done upload attempt</div>
                        <div class="col-9 upload-done-count"></div>
                    </div>
                    <table class="table table-striped" id="upload-table">
                        <thead>
                            <tr><th>Row #</th><th>Code</th><th>Name</th><th>Status</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="DoUpload()">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Upload Modal -->
    <div class="modal fade" id="uploadFileModal" role="dialog" aria-labelledby="uploadFileModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload File</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label mb-0" for="upload-excel-file">Excel File</label>
                        <input type="file" id="upload-excel-file" name="file"
                               accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                               class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="DoFileUpload()">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="pictureModal" role="dialog" aria-labelledby="pictureModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Item Image</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="picForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12">
                            <input type="hidden" id="add-image-id" />
                            <div id="add-image2-preview">
                                <img id="item-image-selected" src="images/no_image.png" class="img-circle elevation-2 w-100" alt="Cannot load Image">
                            </div>
                            @if (userAccess.CanUploadDownload)
                            {
                                <div class="input-group mt-3">
                                    <div class="custom-file">
                                        <input type="file" id="item-image" class="custom-file-input" name="ItemImage" accept="image/*" onchange="imagePreview(this, 'add-image2-preview', 'img-circle elevation-2 w-100', 'item-image-selected')" />
                                        <label class="custom-file-label" for="item-image">Choose image</label>
                                    </div>
                                </div>
                                <em class="d-block text-muted text-center">Image that are too large will be automatically adjusted upon saving</em>
                            }
                            else
                            {
                                <div class="input-group mt-3">
                                    <div class="custom-file">
                                        <input type="file" id="item-image" class="custom-file-input" name="ItemImage" accept="image/*" disabled="disabled" />
                                        <label class="custom-file-label" for="item-image">No access to upload image</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="px-3 pb-2 text-muted small modal-note">
                    Your filter, sort, and search will be saved for 1 hour
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary"><span class="fas fa-save mr-2"></span>Save</button>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" aria-label="Close"><span class="fas fa-times mr-2"></span>Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="viewStockBTModal" role="dialog" data-bs-keyboard="false" data-bs-backdrop="static" aria-hidden="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fetched Stock(s) from Barcotech Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-2"><em class="text-xs text-muted">The details below are shown only once and are not saved. After closing this page, you won’t be able to view them again. Here’s what happens to the fetched stock records.</em></div>
                <table class="table table-head-fixed table-striped table-hover table-fetch-bt">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Warehouse</th>
                            <th>Old Quantity</th>
                            <th>New Quantity</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var barcotech_user_access = @Html.Raw(Json.Serialize(barcotechUserAccess));

        // Load Select2 for Item Class
        $("#filter-item-class").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "ItemClass")"
            },
            dropdownParent: $('#filterModal')
        });

        // Load Select2 for Category
        $("#filter-category").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Category")"
            },
            dropdownParent: $('#filterModal')
        });

        // Load Select2 for Item Type
        $("#filter-item-type").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "ItemType")"
            },
            dropdownParent: $('#filterModal')
        });

        // Load Select2 for Brand
        $("#filter-brand").select2({
            tags: true,
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Brand")"
            },
            dropdownParent: $('#filterModal')
        });

        // Load Select2 for Warehouse
        $("#filter-warehouse").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Warehouse")"
            },
            dropdownParent: $('#filterModal'),
            minimumResultsForSearch: -1
        });

        if (user_access.canAdd) {
            loadSelect2("#create-unit", "#createModal", "@Url.Action("GetOptions2", "Unit")");
            loadSelect2("#create-brand", "#createModal", "@Url.Action("GetOptions2", "Brand")");
            loadSelect2("#create-item-class", "#createModal", "@Url.Action("GetOptions2", "ItemClass")", true);
            loadSelect2("#create-item-type", "#createModal", "@Url.Action("GetOptions2", "ItemType")");
            loadSelect2("#create-category", "#createModal", "@Url.Action("GetOptions2", "Category")");
            loadSelect2("#create-warehouse", "#createModal", "@Url.Action("GetOptions2", "Warehouse")");
        }

        if (user_access.canEdit) {
            loadSelect2("#edit-unit", "#editModal", "@Url.Action("GetOptions2", "Unit")");
            loadSelect2("#edit-brand", "#editModal", "@Url.Action("GetOptions2", "Brand")");
            loadSelect2("#edit-item-class", "#editModal", "@Url.Action("GetOptions2", "ItemClass")", true);
            loadSelect2("#edit-item-type", "#editModal", "@Url.Action("GetOptions2", "ItemType")");
            loadSelect2("#edit-category", "#editModal", "@Url.Action("GetOptions2", "Category")");
            loadSelect2("#edit-warehouse", "#editModal", "@Url.Action("GetOptions2", "Warehouse")");
        }

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            itemDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        if (!localStorage.hasOwnProperty("BASItemDTIsTable")) {
            localStorage.setItem("BASItemDTIsTable", false);
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            itemDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[1, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            ItemClassId: "",
            ItemClass: "",
            CategoryId: "",
            Category: "",
            ItemTypeId: "",
            ItemType: "",
            BrandId: "",
            Brand: "",
            WarehouseId: "",
            Warehouse: "",
            StatusId: 1
        };

        function checkDTChanged() {
            if(!itemDT) return false;
            
            return JSON.stringify(itemDT.order()) != JSON.stringify(defaultDTState.order) ||
                   itemDT.page.info().start != defaultDTState.page ||
                   itemDT.page.len() != defaultDTState.length ||
                   (itemDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-item-class").val() != defaultDTState.ItemClassId ||
                   $("#filter-category").val() != defaultDTState.CategoryId ||
                   $("#filter-item-type").val() != defaultDTState.ItemTypeId ||
                   $('#filter-brand').val() != defaultDTState.BrandId ||
                   $('#filter-warehouse').val() != defaultDTState.WarehouseId ||
                   $('#filter-status').val() != defaultDTState.StatusId;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
        }

        function resetToDefaultDTFilter() {
            $("#filter-item-class").val(defaultDTState.ItemClassId).trigger('change');
            $("#filter-category").val(defaultDTState.CategoryId).trigger('change');
            $("#filter-item-type").val(defaultDTState.ItemTypeId).trigger('change');
            $("#filter-brand").val(defaultDTState.BrandId).trigger('change');
            $("#filter-warehouse").val(defaultDTState.WarehouseId).trigger('change');
            $("#filter-status").val(defaultDTState.StatusId);
            
            localStorage.removeItem(dt_storage);

            if (itemDT) {
                itemDT.state.clear();
                itemDT.order(defaultDTState.order);
                itemDT.page(defaultDTState.page);
                itemDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        var itemDT = $('.table-item').DataTable({ 
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.CustomerId = $('#filter-customer').val();
                data.ItemClass = $('#filter-item-class option:selected').text();
                data.ItemClassId = $('#filter-item-class').val();
                data.Category = $('#filter-category option:selected').text();
                data.CategoryId = $('#filter-category').val();
                data.ItemType = $('#filter-item-type option:selected').text();
                data.ItemTypeId = $('#filter-item-type').val();
                data.Brand = $('#filter-brand option:selected').text();
                data.BrandId = $('#filter-brand').val();
                data.Warehouse = $('#filter-warehouse option:selected').text();
                data.WarehouseId = $('#filter-warehouse').val();
                data.StatusId = $('#filter-status').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.ItemClassId) {
                    var itemClassOption = new Option(data.ItemClass, data.ItemClassId, true, true);
                    $(itemClassOption).data('data', {
                        id: data.ItemClassId,
                        text: data.ItemClass
                    });
                    $("#filter-item-class").append(itemClassOption).trigger('change');
                }
                if(data.CategoryId) {
                    var categoryOption = new Option(data.Category, data.CategoryId, true, true);
                    $(categoryOption).data('data', {
                        id: data.CategoryId,
                        text: data.Category
                    });
                    $("#filter-category").append(categoryOption).trigger('change');
                }
                if(data.ItemTypeId) {
                    var itemTypeOption = new Option(data.ItemType, data.ItemTypeId, true, true);
                    $(itemTypeOption).data('data', {
                        id: data.ItemTypeId,
                        text: data.ItemType
                    });
                    $("#filter-item-type").append(itemTypeOption).trigger('change');
                }
                if(data.BrandId) {
                    var brandOption = new Option(data.Brand, data.BrandId, true, true);
                    $(brandOption).data('data', {
                        id: data.BrandId,
                        text: data.Brand
                    });
                    $("#filter-brand").append(brandOption).trigger('change');
                }
                if(data.WarehouseId) {
                    var warehouseOption = new Option(data.Warehouse, data.WarehouseId, true, true);
                    $(warehouseOption).data('data', {
                        id: data.WarehouseId,
                        text: data.Warehouse
                    });
                    $("#filter-warehouse").append(warehouseOption).trigger('change');
                }
                $('#filter-status').val(data.StatusId);
            },
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function (data) {
                    var itemClassId = $("#filter-item-class").val();
                    if (itemClassId) {
                        if ($("#filter-item-class").select2("data")[0].text != $("#filter-item-class").val()) {
                            data.ItemClassId = itemClassId;
                        } else {
                            data.ItemClassId = 0;
                            data.ItemClassKeyword = itemClassId;
                        }
                    }

                    var categoryId = $("#filter-category").val();
                    if (categoryId) {
                        if ($("#filter-category").select2("data")[0].text != $("#filter-category").val()) {
                            data.CategoryId = categoryId;
                        } else {
                            data.CategoryId = 0;
                            data.CategoryKeyword = categoryId;
                        }
                    }

                    var itemTypeId = $("#filter-item-type").val();
                    if (itemTypeId) {
                        if ($("#filter-item-type").select2("data")[0].text != $("#filter-item-type").val()) {
                            data.ItemTypeId = itemTypeId;
                        } else {
                            data.ItemTypeId = 0;
                            data.ItemTypeKeyword = itemTypeId;
                        }
                    }

                    var brandId = $("#filter-brand").val();
                    if (brandId) {
                        if ($("#filter-brand").select2("data")[0].text != $("#filter-brand").val()) {
                            data.BrandId = brandId;
                        } else {
                            data.BrandId = 0;
                            data.BrandKeyword = brandId;
                        }
                    }

                    var warehouseId = $("#filter-warehouse").val();
                    if (warehouseId) {
                        data.WarehouseId = warehouseId;
                    }

                    data.StatusId = $("#filter-status").val();
                    data.IsTable = localStorage.getItem("BASItemDTIsTable") == "true";
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.giveAction) {
                            if (data.image)
                                actions += `<img src="/images/Items/${data.image}" alt="Cannot load Image" class="item-image-${data.id} image-on-datatables clickable" onclick='DisplayImage(${JSON.stringify(data)})' />`;
                            else
                                actions += `<img src="/images/no_image.png" alt="Cannot load Image" class="item-image-${data.id} image-on-datatables clickable" onclick='DisplayImage(${JSON.stringify(data)})' />`;
                        }
                        return actions;
                    },
                    name: "Image"
                },
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                {
                    data: function (data, type, dataToSet) {
                        return data.oldCode || '<span class="text-muted">N/A</span>';
                    },
                    name: "OldCode"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.partNumber || '<span class="text-muted">N/A</span>';
                    },
                    name: "PartNumber" 
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.interchangeNumber || '<span class="text-muted">N/A</span>';
                    },
                    name: "InterchangeNumber"
                },
                {
                    data: function (data, type, dataToSet) {
                        if(data.warehouse) {
                            return "<a href='/Warehouse/Details/" + data.warehouseId + "' class='link-info' target='_blank'>" + data.warehouse + "</a>";
                        } else {
                            return '<span class="text-danger" data-microtip-title="Erroneous price data, please contact IT" data-microtip-position="bottom" role="tooltip"><span class="fas fa-exclamation-triangle"></span></span>';
                        }
                    },
                    name: "Warehouse" },
                {
                    data: function (data, type, dataToSet) {
                        if(data.retailPrice && data.retailPriceD >= 0) {
                            return data.retailPrice;
                        } else {
                            return '<span class="text-danger" data-microtip-title="Erroneous price data, please contact IT" data-microtip-position="bottom" role="tooltip"><span class="fas fa-exclamation-triangle"></span></span>';
                        }
                    },
                    name: "RetailPrice",
                    className: "text-end", 
                    visible: user_access.canView },
                {
                    data: function (data, type, dataToSet) {
                        if(data.netPrice && data.netPriceD >= 0) {
                            return data.netPrice;
                        } else {
                            return '<span class="text-danger" data-microtip-title="Erroneous price data, please contact IT" data-microtip-position="bottom" role="tooltip"><span class="fas fa-exclamation-triangle"></span></span>';
                        }
                    },
                    name: "NetPrice",
                    className: "text-end", 
                    visible: user_access.canView
                },
                {
                    data: function (data, type, dataToSet) {
                        //return '<span data-microtip-title="[Inventory:' + FormatStringInteger(data.quantityInventoryD) + ']+[Served:' + FormatStringInteger(data.quantityServedD == null || data.warehouse.toLowerCase().includes("main") != true ? 0 : data.quantityServedD) + ']-[Invoiced:' + FormatStringInteger(data.quantityInvoiceD == null || data.warehouse.toLowerCase().includes("main") != true ? 0 : data.quantityInvoiceD) + ']" data-microtip-position="bottom-left" role="tooltip">' + data.quantity + '</span>';
                        if (data.quantity && data.quantityD >= 0) {
                             return data.quantity;
                        } else {
                            return '<span class="text-danger" data-microtip-title="Erroneous inventory data, please contact IT" data-microtip-position="bottom" role="tooltip">' + data.quantity + ' <span class="fas fa-exclamation-triangle"></span></span>';
                        }
                    },
                    name: "Quantity",
                    className: "text-end"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (data.giveAction) { // check if first item specially for multiple warehouse
                            actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                            if (data.isActive) {
                                if (user_access.canEdit) {
                                    actions += '<button data-id="' + data.id + '" class="btn btn-warning btn-xs editBtn" data-microtip-title="Edit Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-pencil-alt"></span></button>';
                                }
                                if (user_access.canDelete) {
                                    actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete / Deactivate Item" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                                }
                                if (barcotech_user_access.canUploadDownload) {
                                    actions += '<button class="btn btn-light text-dark btn-xs" type="button" onclick="FetchStockBarcotech(' + data.id + ')" data-microtip-title="Fetch Stock(s) from Barcotech" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-download"></span></button>';
                                }
                            } else {
                                if (user_access.canAdd || user_access.canEdit) {
                                    actions += '<button data-id="' + data.id + '" class="btn btn-success btn-xs reactivateBtn" type="button" data-microtip-title="Reactivate Item" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-check"></span></button>';
                                }
                            } 
                        }
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order
        });

        const cardContainer = $('<div id="cardContainer" class="dt-card-view d-none"></div>');
        $('.table-item').after(cardContainer);

        function renderCards() {
            const container = $('#cardContainer').empty();
            const row = $('<div class="row dt-card-view"></div>').appendTo(container);

            itemDT.rows({ search: 'applied' }).every(function () {
                const d = this.data();
                var img = "";

                if(d.image)
                    img= `<img src="/images/Items/${d.image}" alt="Cannot load Image" class="item-image-${d.id} image-on-cards clickable w-100 rounded mb-3" onclick='DisplayImage(${JSON.stringify(d)})' />`;
                else
                    img= `<img src="/images/no_image.png" alt="Cannot load Image" class="item-image-${d.id} image-on-cards clickable w-100 rounded mb-3" onclick='DisplayImage(${JSON.stringify(d)})' />`;

                var actions = '<div class="btn-group d-block float-right" role="group">';
                actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + d.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                if (d.isActive) {
                    if (user_access.canEdit) {
                        actions += '<button data-id="' + d.id + '" class="btn btn-warning btn-xs editBtn" data-microtip-title="Edit Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-pencil-alt"></span></button>';
                    }
                    if (user_access.canDelete) {
                        actions += '<button data-id="' + d.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete / Deactivate Item" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                    }
                } else {
                    if (user_access.canAdd || user_access.canEdit) {
                        actions += '<button data-id="' + d.id + '" class="btn btn-success btn-xs reactivateBtn" type="button" data-microtip-title="Reactivate Item" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-check"></span></button>';
                    }
                }
                actions += "</div>";
                const card = $(`
                    <div class="col-md-3">
                        <div class="dt-card-item">
                            ${img}
                            <h5>${d.name}</h5>
                            <p><strong>Code:</strong> ${d.code}</p>
                            <p><strong>Part Number:</strong> ${d.partNumber || '<span class="text-muted">N/A</span>'}</p>
                            <p><strong>Interchange Number:</strong> ${d.interchangeNumber || '<span class="text-muted">N/A</span>'}</p>
                            ${actions}
                        </div>
                    </div>
                `);
                row.append(card);
            });
        }

        $('#toggleView').on('click', function () {
            if (localStorage.hasOwnProperty("BASItemDTIsTable")) {
                localStorage.setItem("BASItemDTIsTable", localStorage.getItem("BASItemDTIsTable") != "true");
            } else {
                localStorage.setItem("BASItemDTIsTable", false);
            }
            itemDT.ajax.reload();
        });

        itemDT.on("draw", function () {
            if (localStorage.getItem("BASItemDTIsTable") == "true") {
                $('.table-item').show();
                cardContainer.addClass('d-none');
                $('#toggleView').html('<span class="fas fa-border-all"></span> Card View');
            } else {
                renderCards();
                $('.table-item').hide();
                cardContainer.removeClass('d-none');
                $('#toggleView').html('<span class="fas fa-table"></span> List View');
            }

            checkDefaultFilter();

            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete / Deactivate Item",
                        text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteItemId').val(id);
                            $('#deleteItemForm').submit();
                        }
                    });
                });
            }

            if (user_access.canAdd || user_access.canEdit) {
                $('.reactivateBtn').click(function (e) {
                    swal({
                        title: "Reactivate Item",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#reactivateItemId').val(id);
                            $('#reactivateItemForm').submit();
                        }
                    });
                });
            }

            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var btn = $(this);
                    var id = btn.data("id");
                    var data = itemDT.data().toArray().find(s => s.id == id);
                    
                    $("#edit-id").val(data.id);
                    $("#edit-code").val(data.code);
                    $("#edit-name").val(data.name);
                    $("#edit-old-code").val(data.oldCode);
                    $("#edit-part-number").val(data.partNumber);
                    $("#edit-interchange-number").val(data.interchangeNumber);
                    $("#edit-model-number").val(data.modelNumber);
                    $("#edit-size").val(data.size);
                    if (data.itemClass) {
                        var itemClassOption = new Option(data.itemClass, data.itemClassId, true, true);
                        $("#edit-item-class").append(itemClassOption).trigger("change");
                    } else {
                        $("#edit-item-class").val("").trigger("change");
                    }
