        if (user_access.canUploadDownload) {
            var json_of_excel_headers;
            var json_of_excel;
            var colnumber = 17; // number of columns required for upload
            var done_upload_excel = 0;
            var duplicate_upload = 0;

            var opts = {
                readAsDefault: 'ArrayBuffer',
                dragClass: 'drag',
                on: {
                    load: function (e, file) {
                        var result = new Uint8Array(e.target.result);

                        var xlsread = XLSX.read(result, { type: 'array' });
                        json_of_excel = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                    }
                }
            };
            $("#upload-file").fileReaderJS(opts);

            // Actions upon file selection
            $("#upload-file").on("change", function () {
                done_upload_excel = 0;
                $(".upload-item-count").html("0");
                $(".upload-done-count").html("0");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            // Actions upon Display Upload Modal
            $(".uploadBtn").click(function (e) {
                done_upload_excel = 0;
                $("#upload-file").val("");
                $(".upload-item-count").html("0");
                $(".upload-done-count").html("0");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            function DoUpload() {
                if (!$("#upload-file").val()) {
                    toastr.warning("Please select a file first", "Warning");
                } else if (json_of_excel.length == 0) {
                    toastr.warning("The excel file is empty", "Warning");
                } else {
                    var columns = Object.keys(json_of_excel[0]);
                    $(".upload-item-count").html("0");
                    $(".upload-done-count").html("0");
                    $("#upload-table tbody").html("");
                    $("#upload-table").show();
                    duplicate_upload = 0;

                    var batchSize = 10;
                    var index = 0;

                    var requiredColumns = [
                    "Code", "Name", "Old SKU", "Part Number", "Interchange Number", "Warehouse",
                    "Model Number", "Item Class", "Category", "Item Type", "Brand", "Size", "Unit", "Quantity on Hand",
                    "Beginning Cost", "Gross Price", "Net Price", "Is Active"
                    ];

                    var uploadInterval = setInterval(function () {
                        for (var i = 0; i < batchSize && index < json_of_excel.length; i++, index++) {
                            var rowNum = json_of_excel[index].__rowNum__;
                            var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                            row$.append($('<td/>').html(rowNum));

                            for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                                var cellValue = json_of_excel[index][columns[colIndex]] || "";
                                if (colIndex == 0 || colIndex == 1)
                                    row$.append($('<td/>').html(cellValue));
                            }

                            var missingColumns = requiredColumns.filter(col => !columns.includes(col));

                            if (missingColumns.length > 0) {
                                var message = "Missing required columns: " + missingColumns.join(", ");
                                row$.append($('<td/>').html(message));
                                $("#upload-table").append(row$);
                                clearInterval(uploadInterval);
                                toastr.error(message, "Error");
                                return;
                            } else {
                                SaveXLSX(
                                    json_of_excel[index]["Code"],
                                    json_of_excel[index]["Name"],
                                    json_of_excel[index]["Old SKU"],
                                    json_of_excel[index]["Part Number"],
                                    json_of_excel[index]["Interchange Number"],
                                    json_of_excel[index]["Warehouse"],
                                    json_of_excel[index]["Model Number"],
                                    json_of_excel[index]["Item Class"],
                                    json_of_excel[index]["Category"],
                                    json_of_excel[index]["Item Type"],
                                    json_of_excel[index]["Brand"],
                                    json_of_excel[index]["Size"],
                                    json_of_excel[index]["Unit"],
                                    json_of_excel[index]["Quantity on Hand"],
                                    json_of_excel[index]["Beginning Cost"],
                                    json_of_excel[index]["Gross Price"],
                                    json_of_excel[index]["Net Price"],
                                    json_of_excel[index]["Is Active"],
                                    rowNum
                                );
                                row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                            }

                            $("#upload-table").append(row$);
                        }

                        if (index >= json_of_excel.length) {
                            clearInterval(uploadInterval);
                        }
                    }, 1000);
                }
            }

            function SaveXLSX(code, name, oldcode, part, interchange, warehouse, model, itemClass, category, itemtype, brand, size, unit, quantity, beginningcost, grossprice, netprice, isActive, rownum) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadJson")",
                    data: {
                        Code: code,
                        Name: name,
                        OldCode: oldcode,
                        PartNumber: part,
                        InterchangeNumber: interchange,
                        Warehouse: warehouse,
                        ModelNumber: model,
                        ItemClass: itemClass,
                        Category: category,
                        ItemType: itemtype,
                        Brand: brand,
                        Unit: unit,
                        Size: size,
                        Quantity: quantity,
                        BeginningCost: beginningcost,
                        GrossPrice: grossprice,
                        NetPrice: netprice,
                        IsActive: isActive.trim().toLowerCase() == "yes"
                    },
                    success: function (data, status, xhr) {
                        if (data.message == "Nothing to change") {
                            $("#upload-row" + rownum + "tr").remove();
                            duplicate_upload++;
                        } else {
                            $("#upload-row" + rownum + "td").html(data.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        let message = xhr.responseJSON?.message
                                   || xhr.responseText?.match(/(?<=:\s)(.*?)(?=\s*--->|\r?\n)/)?.[0]
                                   || error
                                   || "Problem sending to server. Try again";
                        $("#upload-row" + rownum + "td").html(message);
                    },
                    complete: function (xhr, status) {
                        UploadRowDone();
                    }
                });
            }

            function UploadRowDone() {
                done_upload_excel++;
                $(".upload-item-count").html(json_of_excel.length);
                $(".upload-done-count").html(done_upload_excel);
                $.LoadingOverlay("progress", parseInt((done_upload_excel / json_of_excel.length) * 100));
                if (done_upload_excel == json_of_excel.length && duplicate_upload > 0) {
                    $("#upload-table").append('<tr><td>*</td><td colspan="2">Excluded ' + duplicate_upload + ' row(s)</td><td>Already exist</td></tr>');
                    $("#upload-file").val("");
                }
                if (done_upload_excel === json_of_excel.length) {
                    $.LoadingOverlay("progress", 100);
                    itemDT.ajax.reload();
                }
            }

            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-item-clas").val()) { urlQuery.push("ItemClassId=" + $("#filter-item-class").val()); }
                if ($("#filter-category").val()) { urlQuery.push("CategoryId=" + $("#filter-category").val()); }
                if ($("#filter-item-type").val()) { urlQuery.push("ItemTypeId=" + $("#filter-item-type").val()); }
                if ($("#filter-brand").val()) { urlQuery.push("BrandId=" + $("#filter-brand").val()); }
                if ($("#filter-warehouse").val()) { urlQuery.push("WarehouseId=" + $("#filter-warehouse").val()); }
                if ($("#filter-status").val()) { urlQuery.push("StatusId=" + $("#filter-status").val()); }
                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });

            function DoFileUpload() {
                var formData = new FormData();
                formData.append("File", $("#upload-excel-file")[0].files[0]);

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadFileJson")",
                    data: formData,
                    loaderMessage: "Please wait while this completes. Whole file is being processed on server.<br><small class=\"text-muted\">Reloading the page will stop the process, which may result in some excel rows to fail.</small>",
                    //async: false,
                    cache: false,
                    contentType: false,
                    processData: false,
                    xhrFields: {
                        responseType: 'blob'  // important for file
                    },
                    //enctype: "multipart/form-data",
                    success: function (data, status, xhr) {
                        let statusHeader = xhr.getResponseHeader("X-Status");
                        let messageHeader = xhr.getResponseHeader("X-Message");
                        if (statusHeader == "Error") {
                            toastr.error(messageHeader, "Error");
                        } else {
                            // Create a temporary download link
                            let blob = new Blob([data]);
                            let url = window.URL.createObjectURL(blob);

                            let a = document.createElement("a");
                            a.href = url;

                            let disposition = xhr.getResponseHeader('Content-Disposition');
                            let fileName = "Result.xlsx";
                            if (disposition) {
                                // try UTF-8 encoded filename first
                                let utf8Match = disposition.match(/filename\*=UTF-8''(.+)/);
                                if (utf8Match && utf8Match[1]) {
                                    fileName = decodeURIComponent(utf8Match[1]);
                                } else {
                                    // fallback to normal filename
                                    let normalMatch = disposition.match(/filename="?([^";]+)"?/);
                                    if (normalMatch && normalMatch[1]) fileName = normalMatch[1];
                                }
                            }
                            a.download = fileName;
                            a.click();

                            window.URL.revokeObjectURL(url);

                            itemDT.ajax.reload();

                            toastr.success(messageHeader, "Success");

                            $("#uploadFileModal").modal("hide");
                        }
                    }
                });
            }
        }

        if(barcotech_user_access.canUploadDownload) {
            var stockDT = $('.table-fetch-bt').DataTable({
                data: [],
                filter: true,
                responsive: true,
                autoWidth: false,
                searching: false,
                //paging: false,
                columns: [
                    { data: "item", name: "Item" },
                    { data: "warehouse", name: "Warehouse" },
                    { data: "oldQuantity", name: "OldQuantity" },
                    { data: "newQuantity", name: "NewQuantity" },
                    { data: "remarks", name: "Remarks" }
                ],
                order: [[0, "asc"]]
            });

            function FetchStockBarcotech(itemId) {
                swal({
                    title: "Fetch Stock Record(s) from Barcotech",
                    text: "This action will get all stock records from Barcotech and save it here. The process may take some time, depending on the number of records fetched. Are you sure you want to proceed?",
                    icon: "warning",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("SyncStock")",
                            type: "POST",
                            data: {
                                ItemId: itemId,
                            },
                            loaderMessage: "Please wait while this completes.<br><small class=\"text-muted\">Reloading the page will stop the process, so some records may be saved while others are not.</small>",
                            success: function (data, status, xhr) {
                                stockDT.clear().draw();
                                $.each(data, function (i, v) {
                                    stockDT.row.add(v).draw();
                                });
                                $("#viewStockBTModal").modal("show");
                                itemDT.ajax.reload();
                            }
                        });
                    }
                });
            }
        }
