@if (userAccess.CanUploadDownload)
{
    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label mb-0" for="upload-file">Excel File</label>
                        <input type="file" id="upload-file" name="file"
                        accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                        class="form-control form-control-sm" />
                    </div>
                    <table class="table table-striped" id="upload-table">
                        <thead>
                            <tr><th>Row #</th><th>Code</th><th>Name</th><th>Status</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="DoUpload()">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        var loadselect2loaded = false;
        function LoadSelect2() {
            if (loadselect2loaded) return;
            loadselect2loaded = true;
            // Load Select2 Unit
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetUnitOptions", "Item")",
                success: function (data, status, xhr) {
                    $("#create-unit").select2({
                        data: data,
                        dropdownParent: $("#createModal")
                    });
                    $("#edit-unit").select2({
                        data: data,
                        dropdownParent: $("#editModal")
                    });
                }
            });

            // Load Select2 Category
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Category")",
                success: function (data, status, xhr) {
                    $("#create-category").select2({
                        data: data,
                        dropdownParent: $("#createModal")
                    });
                    $("#edit-category").select2({
                        data: data,
                        dropdownParent: $("#editModal")
                    });
                }
            });

            // Load Select2 Item Type
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "ItemType")",
                success: function (data, status, xhr) {
                    $("#create-item-type").select2({
                        data: data,
                        //theme: "bootstrap-5",
                        dropdownParent: $("#createModal")
                    });
                    $("#edit-item-type").select2({
                        data: data,
                        //theme: "bootstrap-5",
                        dropdownParent: $("#editModal")
                    });
                }
            });

            // Load Select2 Brand
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Brand")",
                success: function (data, status, xhr) {
                    $("#create-brand").select2({
                        data: data,
                        dropdownParent: $("#createModal")
                    });
                    $("#edit-brand").select2({
                        data: data,
                        dropdownParent: $("#editModal")
                    });
                }
            });
        }

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function (data) {
                    var categoryId = $("#CategoryId").val();
                    var itemTypeId = $("#ItemTypeId").val();
                    var brandId = $("#BrandId").val();
                    var warehouseId = $("#WarehouseId").val();

                    if (categoryId) data.CategoryId = categoryId;
                    if (itemTypeId) data.ItemTypeId = itemTypeId;
                    if (brandId) data.BrandId = brandId;
                    if (warehouseId) data.WarehouseId = warehouseId;
                }
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "partNumber", name: "PartNumber" },
                { data: "interchangeNumber", name: "InterchangeNumber" },
                { data: "warehouse", name: "Warehouse" },
                { data: "retailPrice", name: "RetailPrice", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                {
                    data: function (data, type, dataToSet) {
                        //return '<span data-microtip-title="[Inventory:' + FormatStringInteger(data.quantityInventoryD) + ']+[Served:' + FormatStringInteger(data.quantityServedD == null || data.warehouse.toLowerCase().includes("main") != true ? 0 : data.quantityServedD) + ']-[Invoiced:' + FormatStringInteger(data.quantityInvoiceD == null || data.warehouse.toLowerCase().includes("main") != true ? 0 : data.quantityInvoiceD) + ']" data-microtip-position="top-left" role="tooltip">' + data.quantity + '</span>';
                        return data.quantity;
                    },
                    name: "Quantity",
                    className: "text-end"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (data.giveAction) { // check if first item specially for multiple warehouse
                            actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                            if (userIsInRole("Inventory Manager") || userIsInRole("System Admin") || userIsInRole("Sales Director") || userIsInRole("Telemarketer")) {
                                if (data.isActive) {
                                    if (user_access.canEdit) {
                                        actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                                    }
                                    if (user_access.canDelete) {
                                        actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete / Deactivate Item" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                                    }
                                } else {
                                    if (user_access.canAdd || user_access.canEdit) {
                                        actions += '<button data-id="' + data.id + '" class="btn btn-success btn-xs reactivateBtn" type="button" data-microtip-title="Reactivate Item" data-microtip-position="top-left" role="tooltip"><i class="fas fa-check"></i></button>';
                                    }
                                }
                            }
                        }
                        return actions + "</div>";
                    }
                }
            ]
        });

        //itemDT.on("init.dt", function () {
        itemDT.on("draw", function () {
            hideLoader();

            LoadSelect2();
            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete / Deactivate Item",
                        text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteItemId').val(id);
                            $('#deleteItemForm').submit();
                        }
                    });
                });
            }
            if (user_access.canAdd || user_access.canEdit) {
                $('.reactivateBtn').click(function (e) {
                    swal({
                        title: "Reactivate Item",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#reactivateItemId').val(id);
                            $('#reactivateItemForm').submit();
                        }
                    });
                });
            }
            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = itemDT.row($(this).parents('tr')).data();

                    $("#edit-id").val(data.id);
                    $("#edit-code").val(data.code);
                    $("#edit-name").val(data.name);
                    $("#edit-part-number").val(data.partNumber);
                    $("#edit-interchange-number").val(data.interchangeNumber);
                    $("#edit-model-number").val(data.modelNumber);
                    $("#edit-size").val(data.size);
                    $("#edit-unit").val(data.unitId).trigger("change");
                    $("#edit-category").val(data.categoryId).trigger("change");
                    $("#edit-item-type").val(data.itemTypeId).trigger("change");
                    $("#edit-brand").val(data.brandId).trigger("change");
                });

                // Validation for Edit Modal
                var validateEdit = $("#editForm").validate({
                    errorClass: 'text-danger text-xs',
                    rules: {
                        Code: { required: true, maxlength: 50 },
                        Name: { required: true, maxlength: 100 },
                        PartNumber: { maxlength: 50 },
                        InterchangeNumber: { maxlength: 50 },
                        ModelNumber: { maxlength: 50 },
                        Size: { required: true, maxlength: 50 }
                    },
                    messages: {
                        Code: { required: "Please enter code.", maxlength: "Code must not exceed 50 characters." },
                        Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                        PartNumber: { maxlength: "Part number must not exceed 50 characters." },
                        InterchangeNumber: { maxlength: "Interchange number must not exceed 50 characters." },
                        ModelNumber: { maxlength: "Model number must not exceed 50 characters." },
                        Size: { required: "Please enter size.", maxlength: "Size must not exceed 50 characters." }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoEdit();
                    },
                    showErrors: validateShowErrors
                });

                // Send Edit to Controller
                function DoEdit() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("EditJson")",
                        data: {
                            Id: $("#edit-id").val(),
                            Code: $("#edit-code").val(),
                            Name: $("#edit-name").val(),
                            PartNumber: $("#edit-part-number").val(),
                            InterchangeNumber: $("#edit-interchange-number").val(),
                            ModelNumber: $("#edit-model-number").val(),
                            Size: $("#edit-size").val(),
                            UnitId: $("#edit-unit").val(),
                            CategoryId: $("#edit-category").val(),
                            ItemTypeId: $("#edit-item-type").val(),
                            BrandId: $("#edit-brand").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#editModal").modal("hide");
                                itemDT.ajax.reload();
                            }
                        }
                    });
                }
            }
        });
        if (user_access.canAdd) {
            // Actions upon Display Create Modal
            $(".createBtn").click(function (e) {
                $("#create-code").val("");
                $("#create-name").val("");
                $("#create-part-number").val("");
                $("#create-interchange-number").val("");
                $("#create-model-number").val("");
                $("#create-size").val("");
                $("#create-unit").prop("selectedIndex", 0).trigger("change");
                $("#create-category").prop("selectedIndex", 0).trigger("change");
                $("#create-item-type").prop("selectedIndex", 0).trigger("change");
                $("#create-brand").prop("selectedIndex", 0).trigger("change");
                $("#create-retail-price").val("");
                $("#create-net-price").val("");
            });

            // Validation for Create Modal
            var validateCreate = $("#createForm").validate({
                errorClass: 'text-danger text-xs',
                rules: {
                    Code: { required: true, maxlength: 50 },
                    Name: { required: true, maxlength: 100 },
                    PartNumber: { maxlength: 50 },
                    InterchangeNumber: { maxlength: 50 },
                    ModelNumber: { maxlength: 50 },
                    Size: { required: true, maxlength: 50 },
                    RetailPrice: { required: true, range: [0, 1999999.99] },
                    NetPrice: { required: true, range: [0, 1999999.99] }
                },
                messages: {
                    Code: { required: "Please enter code.", maxlength: "Code must not exceed 50 characters." },
                    Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                    PartNumber: { maxlength: "Part number must not exceed 50 characters." },
                    InterchangeNumber: { maxlength: "Interchange number must not exceed 50 characters." },
                    ModelNumber: { maxlength: "Model number must not exceed 50 characters." },
                    Size: { required: "Please enter size.", maxlength: "Size must not exceed 50 characters." },
                    RetailPrice: { required: "Please enter new Retail Price.", range: "Price must be between 0-1999999.99." },
                    NetPrice: { required: "Please enter new Net Price.", range: "Price must be between 0-1999999.99." }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoCreate();
                },
                showErrors: validateShowErrors
            });

            // Send Create to Controller
            function DoCreate() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("CreateJson")",
                    data: {
                        Code: $("#create-code").val(),
                        Name: $("#create-name").val(),
                        PartNumber: $("#create-part-number").val(),
                        InterchangeNumber: $("#create-interchange-number").val(),
                        ModelNumber: $("#create-model-number").val(),
                        NetPriceD: $("#create-net-price").val(),
                        RetailPriceD: $("#create-retail-price").val(),
                        Size: $("#create-size").val(),
                        UnitId: $("#create-unit").val(),
                        CategoryId: $("#create-category").val(),
                        ItemTypeId: $("#create-item-type").val(),
                        BrandId: $("#create-brand").val()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.success(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#createModal").modal("hide");
                            itemDT.ajax.reload();
                        }
                    }
                });
            }
        }
        function ApplyFilter() {
            itemDT.ajax.reload();
            $("#filterModal").modal("hide");
        }

        if (user_access.canUploadDownload) {
            var json_of_excel_headers;
            var json_of_excel;
            var colnumber = 10; // number of columns required for upload
            var done_upload_excel = 0;
            var duplicate_upload = 0;

            var opts = {
                readAsDefault: 'ArrayBuffer',
                dragClass: 'drag',
                on: {
                    load: function (e, file) {
                        var result = new Uint8Array(e.target.result);

                        var xlsread = XLSX.read(result, { type: 'array' });
                        json_of_excel = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                    }
                }
            };
            $("#upload-file").fileReaderJS(opts);

            // Actions upon file selection
            $("#upload-file").on("change", function () {
                done_upload_excel = 0;
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            // Actions upon Display Upload Modal
            $(".uploadBtn").click(function (e) {
                done_upload_excel = 0;
                $("#upload-file").val("");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            function DoUpload() {
                if (!$("#upload-file").val()) {
                    toastr.warning("Please select a file first", "Warning");
                } if (json_of_excel.length == 0) {
                    toastr.warning("The excel file is empty", "Warning");
                } else {
                    var columns = Object.keys(json_of_excel[0]);
                    $("#upload-table tbody").html("");
                    $("#upload-table").show();
                    duplicate_upload = 0;
                    for (var i = 0; i < json_of_excel.length; i++) {
                        var rowNum = json_of_excel[i].__rowNum__;
                        var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                        row$.append($('<td/>').html(json_of_excel[i].__rowNum__));
                        for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                            var cellValue = json_of_excel[i][columns[colIndex]];
                            if (cellValue == null)
                                cellValue = "";
                            if (colIndex == 0 || colIndex == 1)
                                row$.append($('<td/>').html(cellValue));
                        }
                        if (columns.includes("Code") == false
                            || columns.includes("Name") == false
                            || columns.includes("Part Number") == false
                            || columns.includes("Interchange Number") == false
                            || columns.includes("Warehouse") == false
                            || columns.includes("Model Number") == false
                            || columns.includes("Category") == false
                            || columns.includes("Item Type") == false
                            || columns.includes("Brand") == false
                            || columns.includes("Size") == false
                            || columns.includes("Unit") == false
                            || columns.includes("Quantity on Hand") == false) {
                            row$.append($('<td/>').html("Unexpected columns"));
                            UploadRowDone();
                        } else {
                            SaveXLSX(json_of_excel[i]["Code"],
                                json_of_excel[i]["Name"],
                                json_of_excel[i]["Part Number"],
                                json_of_excel[i]["Interchange Number"],
                                json_of_excel[i]["Warehouse"],
                                json_of_excel[i]["Model Number"],
                                json_of_excel[i]["Category"],
                                json_of_excel[i]["Item Type"],
                                json_of_excel[i]["Brand"],
                                json_of_excel[i]["Size"],
                                json_of_excel[i]["Unit"],
                                json_of_excel[i]["Quantity on Hand"],
                                rowNum);
                            row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                        }
                        $("#upload-table").append(row$);
                    }
                }
            }

            function SaveXLSX(code, name, part, interchange, warehouse, model, category, itemtype, brand, size, unit, quantity, rownum) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadJson")",
                    data: {
                        Code: code,
                        Name: name,
                        PartNumber: part,
                        InterchangeNumber: interchange,
                        Warehouse: warehouse,
                        ModelNumber: model,
                        Category: category,
                        ItemType: itemtype,
                        Brand: brand,
                        Unit: unit,
                        Size: size,
                        Quantity: quantity
                    },
                    success: function (data, status, xhr) {
                        if (data.message == "Nothing to change") {
                            $("#upload-row" + rownum + "tr").remove();
                            duplicate_upload++;
                        } else {
                            $("#upload-row" + rownum + "td").html(data.status + ": " + data.message);
                        }
                    },
                    complete: function (xhr, status) {
                        UploadRowDone();
                    }
                });
            }

            function UploadRowDone() {
                done_upload_excel++;
                $.LoadingOverlay("progress", parseInt((done_upload_excel / json_of_excel.length) * 100));
                if (done_upload_excel == json_of_excel.length && duplicate_upload > 0) {
                    $("#upload-table").append('<tr><td>*</td><td colspan="2">Excluded ' + duplicate_upload + ' row(s)</td><td>Already exist</td></tr>');
                    $("#upload-file").val("");
                }
            }

            $(".downloadBtn").click(function (e) {
                //window.location = "@Url.Action("DownloadFile")";
                var urlQuery = [];
                if ($("#CategoryId").val()) { urlQuery.push("CategoryId=" + $("#CategoryId").val()); }
                if ($("#ItemTypeId").val()) { urlQuery.push("ItemTypeId=" + $("#ItemTypeId").val()); }
                if ($("#BrandId").val()) { urlQuery.push("BrandId=" + $("#BrandId").val()); }
                if ($("#WarehouseId").val()) { urlQuery.push("WarehouseId=" + $("#WarehouseId").val()); }
                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }
    </script>
}