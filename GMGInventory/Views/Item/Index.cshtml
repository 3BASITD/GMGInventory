@model IEnumerable<ItemViewVM>

@{
    ViewData["Title"] = "Items";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
    var barcotechUserAccess = (ViewsAccessVM)ViewData["BarcotechUserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (barcotechUserAccess.CanUploadDownload)
            {
                <button class="btn btn-light text-dark btn-sm float-right ml-2"
                        data-microtip-title="Fetch Stock Record(s) from Barcotech"
                        data-microtip-position="bottom-left"
                        role="tooltip" 
                        onclick="FetchStockBarcotech()">
                    <span class="fas fa-download"></span> Fetch Stock
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Fetch Stock Record(s) from Barcotech&#10;Download Barcotech (Stock) access is required"
                        data-microtip-position="bottom-left"
                        role="tooltip">
                    <span class="fas fa-download mr-0"></span>
                </button>
            }
            <button type="button" id="toggleView" class="btn btn-primary btn-sm float-right ml-2"><span class="fas fa-border-all"></span> Card View</button>

            @* @await Html.PartialAsync("ItemFilter", ViewData["ItemFilter"]) *@
            <button class="btn btn-secondary btn-sm float-right ml-2 btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>

            @if (userAccess.CanAdd)
            {
                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="fas fa-plus"></span> New Item
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                <div class="dropdown float-right ml-2">
                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="dropdownMenuUpload" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuUpload">
                        <li><a class="dropdown-item btn-details-upload uploadBtn" data-bs-toggle="modal" data-bs-target="#uploadModal" data-company="ROW">Upload &amp; Track per Row</a></li>
                        <li><a class="dropdown-item btn-details-upload uploadFileBtn" data-bs-toggle="modal" data-bs-target="#uploadFileModal" data-company="FILE">Upload Whole File</a></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-item">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Image)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OldCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PartNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.InterchangeNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Warehouse)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
        @* <div id="cardContainer" class="dt-card-view d-none"></div> *@
    </div>
</div>

<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter-item-class" class="form-label mb-0">Item Class</label>
                            <select id="filter-item-class" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter-category" class="form-label mb-0">Category</label>
                            <select id="filter-category" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter-item-type" class="form-label mb-0">Item Type</label>
                            <select id="filter-item-type" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter-warehouse" class="form-label mb-0">Warehouse</label>
                            <select id="filter-warehouse" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" class="form-select form-select-sm">
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@if (userAccess.CanDelete)
{
    <form id="deleteItemForm" asp-action="Delete">
        <input type="hidden" id="deleteItemId" name="Id" />
    </form>
}

@if (userAccess.CanAdd || userAccess.CanEdit)
{
    <form id="reactivateItemForm" asp-action="Reactivate">
        <input type="hidden" id="reactivateItemId" name="Id" />
    </form>
}

@if (userAccess.CanAdd)
{
    <!-- Create Modal -->
    <div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="createForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-code" class="control-label mb-0 d-block">Code</label>
                                        <input type="text" name="Code" id="create-code" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-name" class="control-label mb-0 d-block">Name</label>
                                        <input type="text" name="Name" id="create-name" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-old-code" class="control-label mb-0 d-block">Old SKU / Code</label>
                                        <input type="text" name="OldCode" id="create-old-code" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-part-number" class="control-label mb-0 d-block">Part Number</label>
                                        <input type="text" name="PartNumber" id="create-part-number" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-interchange-number" class="control-label mb-0 d-block">Interchange Number</label>
                                        <input type="text" name="InterchangeNumber" id="create-interchange-number" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-model-number" class="control-label mb-0 d-block">Model Number</label>
                                        <input type="text" name="ModelNumber" id="create-model-number" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-size" class="control-label mb-0 d-block">Size</label>
                                        <input type="text" name="Size" id="create-size" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-unit" class="control-label mb-0 d-block">Unit</label>
                                        <select name="Unit" id="create-unit" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-item-class" class="control-label mb-0 d-block">Item Class</label>
                                        <select name="ItemClass" id="create-item-class" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-category" class="control-label mb-0 d-block">Category</label>
                                        <select name="Category" id="create-category" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-item-type" class="control-label mb-0 d-block">Item Type</label>
                                        <select name="ItemType" id="create-item-type" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-brand" class="control-label mb-0 d-block">Brand</label>
                                        <select name="Brand" id="create-brand" class="form-control" style="width: 100%">
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-beginning-cost" class="control-label mb-0 d-block">Beginning Cost <small class="text-info" data-microtip-title="Leave 0 if supposed empty" data-microtip-position="right" role="tooltip"><span class="fas fa-info-circle"></span></small></label>
                                        <input type="number" step="0.01" min="0" max="1999999.99" name="BeginningCost" id="create-beginning-cost" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-retail-price" class="control-label mb-0 d-block">Gross Price</label>
                                        <input type="number" step="0.01" min="0" max="1999999.99" name="RetailPrice" id="create-retail-price" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="create-net-price" class="control-label mb-0 d-block">Net Price</label>
                                        <input type="number" step="0.01" min="0" max="1999999.99" name="NetPrice" id="create-net-price" class="form-control form-control-sm" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
