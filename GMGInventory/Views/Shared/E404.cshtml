@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container full-height d-flex align-items-center justify-content-center">
    <div class="text-center">
        <h1 class="display-1 text-danger">404</h1>
        <h2 class="display-4">Page Not Found</h2>
        <p class="lead">The page or resource you’re looking for could not be found.</p>
        <p>It may have been moved, deleted, or the URL might be incorrect. Please check the URL or return to the homepage.</p>
        <a href="/" class="btn btn-primary">Return to Homepage</a>
    </div>
</div>
