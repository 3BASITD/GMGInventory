@model IList<SystemSettingVM>
@{
    var errorTitle = Model.FirstOrDefault(s => s.Name == "ErrorXXXTitle")?.Value ?? "Unknown Error";
    var errorDescription = Model.FirstOrDefault(s => s.Name == "ErrorXXXDescription")?.Value ?? "An unknown error have been encountered.";
    var errorSolution = Model.FirstOrDefault(s => s.Name == "ErrorXXXSolution")?.Value ?? "Please contact the administrator.";

    ViewData["Title"] = @errorTitle;
}

<div class="container full-height d-flex align-items-center justify-content-center">
    <div class="text-center">
        <h1 class="display-1 text-danger">???</h1>
        <h2 class="display-4">@errorTitle</h2>
        <p class="lead">@errorDescription</p>
        <p>@errorSolution</p>
        <a href="/" class="btn btn-primary">Return to Homepage</a>
        <p class="text-muted text-xs mt-5">Error message can be modified by the system administrator.</p>
    </div>
</div>
