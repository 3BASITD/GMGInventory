@{
    ViewData["Title"] = "Internal Server Error";
}

<div class="container full-height d-flex align-items-center justify-content-center">
    <div class="text-center">
        <h1 class="display-1 text-danger">500</h1>
        <h2 class="display-4">Internal Server Error</h2>
        <p class="lead">Oops! Something went wrong on our end.</p>
        <p>Our servers encountered an unexpected problem and couldn’t complete your request. Please try again later. If the issue persists, feel free to contact administrator.</p>
        <a href="/" class="btn btn-primary">Return to Homepage</a>
    </div>
</div>
