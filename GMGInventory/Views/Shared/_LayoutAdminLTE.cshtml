@using GMGInventory.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    var activeUser = UserManager.FindByNameAsync(User.Identity?.Name).Result;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @ViewData["Title"]</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&amp;display=fallback">
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-bs4/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-toggle/css/bootstrap2-toggle.min.css" />
    <link rel="stylesheet" href="~/lib/chart.js/Chart.min.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/lib/microtip/microtip.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-mini @(activeUser.IsDarkMode ? "dark-mode" : "")" style="height: auto;">
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand text-sm @(activeUser.IsDarkMode ? "navbar-dark" : "navbar-white navbar-light")">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-danger" id="logout-link" href="#">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>

        @*<aside class="main-sidebar sidebar-@(activeUser.IsDarkMode ? "dark" : "light")-danger elevation-4">*@
        <aside class="main-sidebar sidebar-dark-danger elevation-4">
            <a asp-controller="Home" asp-action="Index" class="brand-link">
                <img src="~/images/BAS-02.png" alt="Logo"
                     class="brand-image img-circle elevation-3 bg-white">
                <span class="brand-text font-weight-light">GMG Inventory</span>
            </a>

            <div class="sidebar os-theme-@(activeUser.IsDarkMode ? "light" : "dark") text-sm" style="overflow-y: auto;">
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img src="~/images/default_profile.jpg" class="img-circle elevation-2" alt="User">
                    </div>
                    <div class="info">
                        <a asp-controller="Profile" asp-action="Index" class="d-block">
                            @(activeUser.FirstName != null || activeUser.LastName != null
                            ? activeUser.FirstName + " " + activeUser.LastName
                            : activeUser.Nickname)
                        </a>
                    </div>
                </div>
                @if (activeUser.IsActive == false)
                {
                    <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column nav-flat" data-widget="treeview" role="menu" data-accordion="false">
                            <li class="nav-header">YOUR ACCOUNT IS DEACTIVATED</li>
                        </ul>
                    </nav>
                }
                else
                {
                    <partial name="_Navigation" />
                }
            </div>
        </aside>

        <div class="content-wrapper text-sm">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1></h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home"
                                && ViewContext.RouteData.Values["action"]?.ToString() != "Index")
                                {
                                    <li class="breadcrumb-item">
                                        <a asp-controller="Home" asp-action="Index">Home</a>
                                    </li>
                                }
                                @await RenderSectionAsync("Breadcrumb", required: false)
                                <li class="breadcrumb-item active">
                                    @ViewData["Title"]
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </section>

            <section class="content">
                <div class="container-fluid">
                    @if (TempData["SuccessMessage"] != null || TempData["WarningMessage"] != null || TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @(TempData["SuccessMessage"] ?? TempData["WarningMessage"] ?? TempData["ErrorMessage"])
                            <button type="button" class="close" aria-label="Close" data-bs-dismiss="alert">
                                <span aria-hidden="true">×</span>
                            </button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer no-print text-sm">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 0.0.1
            </div>
            Copyright © 2022 MISNet
        </footer>
    </div>

    <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
    </form>

    <div id="partial-holder" class="text-sm"></div>
    <div id="for-print"></div>
    <input type="hidden" id="current-user-nickname" value="@activeUser.Nickname" />
    <input type="hidden" class="current-user-role" value="temp" />
    @foreach(var role in @UserManager.GetRolesAsync(activeUser).Result.ToList())
    {
        <input type="hidden" class="current-user-role" value="@role"  />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/dist/additional-methods.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/lib/adminlte/js/adminlte.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/lib/popper.js/umd/popper.min.js"></script>
    <script src="~/lib/select2/js/select2.js"></script>
    <script src="~/lib/bootstrap-toggle/js/bootstrap2-toggle.min.js"></script>
    <script src="~/lib/chart.js/Chart.min.js"></script>
    <script src="~/lib/loadingoverlay/loadingoverlay.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/sheetjs/dist/xlsx.core.min.js"></script>
    <script src="~/lib/filereader/filereader.js"></script>
    <script src="~/lib/print-this/printThis.js"></script>
    <script src="~/lib/printout/printout.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
        @if (activeUser.IsDarkMode)
        {
            <text>
            $(".table").each(function() {
                $(this).addClass("table-dark");
            });
            </text>
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
