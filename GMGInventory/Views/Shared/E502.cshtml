@{
    ViewData["Title"] = "Bad Gateway";
}

<div class="container full-height d-flex align-items-center justify-content-center">
    <div class="text-center">
        <h1 class="display-1 text-danger">502</h1>
        <h2 class="display-4">Bad Gateway</h2>
        <p class="lead">We're having trouble reaching the server.</p>
        <p>One of the servers involved in processing your request is unavailable or returned an invalid response. This is usually temporary, so please try again in a few moments.</p>
        <a href="/" class="btn btn-primary">Return to Homepage</a>
    </div>
</div>
