<style>
    .modal-xl {
        max-width: 1200px;
    }
</style>
<div class="modal fade text-sm" id="itemDetailsModal" role="dialog" aria-labelledby="itemDetailsModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Item Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-4">
                        <p>
                            <span class="text-muted">Code</span>
                            <b class="d-block modal-item-code"></b>
                        </p>
                        <p>
                            <span class="text-muted">Name</span>
                            <b class="d-block modal-item-name"></b>
                        </p>
                        <p>
                            <span class="text-muted">Part Number</span>
                            <b class="d-block modal-item-part-number"></b>
                        </p>
                        <p>
                            <span class="text-muted">Interchange Number</span>
                            <b class="d-block modal-item-interchange-number"></b>
                        </p>
                    </div>
                    <div class="col-4">
                        <p>
                            <span class="text-muted">Model Number</span>
                            <b class="d-block modal-item-model-number"></b>
                        </p>
                        <p>
                            <span class="text-muted">Category</span>
                            <b class="d-block modal-item-category"></b>
                        </p>
                        <p>
                            <span class="text-muted">Item Type</span>
                            <b class="d-block modal-item-type"></b>
                        </p>
                        <p>
                            <span class="text-muted">Brand</span>
                            <b class="d-block modal-item-brand"></b>
                        </p>
                    </div>
                    <div class="col-4">
                        <p>
                            <span class="text-muted">Unit Code</span>
                            <b class="d-block modal-item-unit-code"></b>
                        </p>
                        <p>
                            <span class="text-muted">Size</span>
                            <b class="d-block modal-item-size"></b>
                        </p>
                        <p>
                            <span class="text-muted">Gross Price</span>
                            <b class="d-block modal-item-gross-price"></b>
                        </p>
                        <p>
                            <span class="text-muted">Net Price</span>
                            <b class="d-block modal-item-net-price"></b>
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="card card-danger card-tabs">
                            <div class="card-header p-0 pt-1 pl-2 pr-2">
                                <ul class="nav nav-tabs nav-fill nav-modal-item" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="modal-nav-warehouse-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-warehouse"
                                           aria-controls="modal-nav-warehouse" aria-selected="true">
                                            @*<br />*@Warehouse Details
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="modal-nav-purchase-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-purchase"
                                           aria-controls="modal-nav-purchase" aria-selected="true">
                                            Cost@*<br />*@ History
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="modal-nav-sales-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-sales"
                                           aria-controls="modal-nav-sales" aria-selected="true">
                                            Sales Order@*<br />*@ Details
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="modal-nav-count-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-count"
                                           aria-controls="modal-nav-count" aria-selected="true">
                                            Physical Count@*<br />*@ Adjustment
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="modal-nav-conversion-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-conversion"
                                           aria-controls="modal-nav-conversion" aria-selected="true">
                                            @*<br />*@Conversion Details
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="modal-nav-price-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-price"
                                           aria-controls="modal-nav-price" aria-selected="true">
                                            @*<br />*@Price History
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="modal-nav-transfer-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-transfer"
                                           aria-controls="modal-nav-transfer" aria-selected="true">
                                            Warehouse Transfer@*<br />*@ History
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="modal-nav-return-tab" role="tab"
                                           data-bs-toggle="tab" data-bs-target="#modal-nav-return"
                                           aria-controls="modal-nav-return" aria-selected="true">
                                            Sales Return@*<br />*@ History
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <div class="card-body">
                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="modal-nav-warehouse" role="tabpanel"
                                         aria-labelledby="modal-nav-warehouse-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-warehouse">
                                            <thead>
                                                <tr>
                                                    <th>Code</th>
                                                    <th>Name</th>
                                                    <th>Quantity</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="tab-pane fade" id="modal-nav-purchase" role="tabpanel" aria-labelledby="modal-nav-purchase-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-purchase">
                                            <thead>
                                                <tr>
                                                    <th>PO Number</th>
                                                    <th>Warehouse</th>
                                                    <th>Supplier</th>
                                                    <th>Quantity</th>
                                                    <th>Unit Cost</th>
                                                    <th>Currency</th>
                                                    <th>Conversion Factor</th>
                                                    <th>Converted Unit Price</th>
                                                    <th>Replenish Date</th>
                                                    <th>Replenish By</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="tab-pane fade" id="modal-nav-sales" role="tabpanel" aria-labelledby="modal-nav-sales-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-sales">
                                            <thead>
                                                <tr>
                                                    <th>SO Number</th>
                                                    <th>Customer</th>
                                                    <th>Unit Price</th>
                                                    <th>Quantity</th>
                                                    <th>Packed Quantity</th>
                                                    <th>Unserved Quantity</th>
                                                    <th>Discount 1</th>
                                                    <th>Discount 2</th>
                                                    <th>Agent</th>
                                                    <th>Created Date</th>
                                                    <th>Created By</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="tab-pane fade" id="modal-nav-count" role="tabpanel" aria-labelledby="modal-nav-count-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-count">
                                            <thead>
                                                <tr>
                                                    <th>Warehouse</th>
                                                    <th>Quantity From</th>
                                                    <th>Quantity To</th>
                                                    <th>Quantity Adjusted</th>
                                                    <th>Adjustment Date</th>
                                                    <th>Adjustment By</th>
                                                    <th>Remarks</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="tab-pane fade show" id="modal-nav-conversion" role="tabpanel" aria-labelledby="nav-conversion-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-conversion">
                                        </table>
                                    </div>
                                    <div class="tab-pane fade" id="modal-nav-price" role="tabpanel" aria-labelledby="modal-nav-price-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-price">
                                            <thead>
                                                <tr>
                                                    <th>Retail Price</th>
                                                    <th>Net Price</th>
                                                    <th>Update Date</th>
                                                    <th>Update By</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="tab-pane fade" id="modal-nav-transfer" role="tabpanel" aria-labelledby="modal-nav-transfer-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-transfer">
                                            <thead>
                                                <tr>
                                                    <th>Transfer Number</th>
                                                    <th>Source</th>
                                                    <th>Destination</th>
                                                    <th>Quantity</th>
                                                    <th>Transfer Date</th>
                                                    <th>Transfer By</th>
                                                    <th>Remarks</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                    <div class="tab-pane fade" id="modal-nav-return" role="tabpanel" aria-labelledby="modal-nav-return-tab">
                                        <table class="table table-head-fixed table-striped table-hover modal-table-return">
                                            <thead>
                                                <tr>
                                                    <th>SR Number</th>
                                                    <th>Item Code</th>
                                                    <th>Item Name</th>
                                                    <th>Quantity</th>
                                                    <th>Customer</th>
                                                    <th>Return Date</th>
                                                    <th>Return By</th>
                                                </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Close
                </button>
            </div>
        </div>
    </div>
</div>
<script>
    function LoadItemDetailsModal(id) {
        $.ajax({
            type: "POST",
            url: "@Url.Action("DetailsJson","Item")",
            data: {
                Id: id
            },
            beforeSend: function (xhr, error) {
                showLoader();
            },
            success: function (data, status, xhr) {
                if (data == null) {
                    toastr.error("Cannot find item", "Error");
                } else {
                    $(".modal-item-code").text(data.code);
                    $(".modal-item-name").text(data.name);
                    $(".modal-item-part-number").text(data.partNumber);
                    $(".modal-item-interchange-number").text(data.interchangeNumber);
                    $(".modal-item-model-number").text(data.modelNumber);
                    $(".modal-item-category").text(data.category);
                    $(".modal-item-type").text(data.itemType);
                    $(".modal-item-brand").text(data.brand);
                    $(".modal-item-unit-code").text(data.unitCode);
                    $(".modal-item-size").text(data.size);
                    $(".modal-item-gross-price").text(data.retailPrice);
                    $(".modal-item-net-price").text(data.netPrice);

                    $('.nav-modal-item a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                        var selectedTab = e.currentTarget.dataset.bsTarget;
                        if (selectedTab == "#modal-nav-warehouse") warehouseDT.ajax.reload();
                        if (selectedTab == "#modal-nav-purchase") purchaseDT.ajax.reload();
                        if (selectedTab == "#modal-nav-sales") salesDT.ajax.reload();
                        if (selectedTab == "#modal-nav-count") countDT.ajax.reload();
                        if (selectedTab == "#modal-nav-conversion") conversionDT.ajax.reload();
                        if (selectedTab == "#modal-nav-price") priceDT.ajax.reload();
                        if (selectedTab == "#modal-nav-transfer") transferDT.ajax.reload();
                        if (selectedTab == "#modal-nav-return") returnDT.ajax.reload();
                    });

                    // Warehouse Details
                    var warehouseDT = $('.modal-table-warehouse').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-warehouse");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetWarehousesJson","Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            }
                        },
                        serverSide: true,
                        filter: true,
                        responsive: true,
                        autoWidth: false,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "code", name: "Code" },
                            { data: "name", name: "Name" },
                            { data: "quantity", name: "Quantity", className: "text-end" }
                        ],
                        order: [[0, "asc"]]
                    }).on("draw.dt", function () {
                        HideTabLoader("modal-warehouse");
                    });

                    // Purchase Order Details
                    var purchaseDT = $('.modal-table-purchase').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-purchase");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetPurchasesJson","Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            }
                        },
                        serverSide: true,
                        filter: true,
                        responsive: true,
                        autoWidth: false,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "purchaseNumber", name: "PurchaseNumber" },
                            { data: "warehouse", name: "Warehouse" },
                            { data: "supplier", name: "Supplier" },
                            { data: "quantity", name: "Quantity", className: "text-end" },
                            { data: "unitCost", name: "UnitCost", className: "text-end" },
                            { data: "currency", name: "Currency" },
                            { data: "conversionFactor", name: "ConversionFactor", className: "text-end" },
                            { data: "convertedUnitPrice", name: "ConvertedUnitPrice", className: "text-end" },
                            { data: "replenishDate", name: "ReplenishDate" },
                            { data: "replenishBy", name: "ReplenishBy" },
                            { data: "status", name: "Status" }
                        ],
                        order: [[9, "desc"]]
                    }).on("draw.dt", function () {
                        HideTabLoader("modal-purchase");
                    });


                    // Sales Order Details
                    var salesDT = $('.modal-table-sales').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-sales");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetSalesJson","Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            }
                        },
                        serverSide: true,
                        filter: true,
                        responsive: true,
                        autoWidth: false,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "salesNumber", name: "SalesNumber" },
                            { data: "customer", name: "Customer" },
                            { data: "unitPrice", name: "UnitPrice" },
                            { data: "quantity", name: "Quantity", className: "text-end" },
                            { data: "packedQuantity", name: "PackedQuantity", className: "text-end" },
                            { data: "unservedQuantity", name: "UnservedQuantity", className: "text-end" },
                            { data: "discount1", name: "Discount1", className: "text-end" },
                            { data: "discount2", name: "Discount2", className: "text-end" },
                            { data: "agent", name: "Agent" },
                            { data: "orderDate", name: "OrderDate" },
                            { data: "orderBy", name: "OrderBy" }
                        ],
                        order: [[9, "desc"]]
                    }).on("draw.dt", function () {
                        HideTabLoader("modal-sales");
                    });


                    // Physical Count Adjustment
                    var countDT = $('.modal-table-count').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-count");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetCountsJson","Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            }
                        },
                        serverSide: true,
                        filter: true,
                        responsive: true,
                        autoWidth: false,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "warehouse", name: "Warehouse" },
                            { data: "quantityFrom", name: "QuantityFrom", className: "text-end" },
                            { data: "quantityTo", name: "QuantityTo", className: "text-end" },
                            { data: "quantityAdjusted", name: "QuantityAdjusted", className: "text-end" },
                            { data: "adjustmentDate", name: "AdjustmentDate" },
                            { data: "adjustmentBy", name: "AdjustmentBy" },
                            { data: "remarks", name: "Remarks" }
                        ],
                        order: [[4, "desc"]]
                    }).on("draw.dt", function () {
                        HideTabLoader("modal-count");
                    });

                    //Conversion Details
                    var conversionDT = $('.modal-table-conversion').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-conversion");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetConversionListJson", "Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            },
                        },
                        serverSide: true,
                        filter: false,
                        ordering: false,
                        searching: false,
                        responsive: true,
                        autoWidth: false,
                        paging: true,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "subItemCode", title: "Item" },
                            { data: "quantity", title: "Quantity" },
                            { data: "unitName", title: "Unit" },
                            { data: "equivalentQuantity", title: "Equivalent Quantity" },
                            { data: "equivalentUnitName", title: "Equivalent Unit" }
                        ],
                        order: [[0, "asc"]]
                    }).on("draw.dt", function () {
                        var data = conversionDT.row(0).data();

                        if (data != null && data.subItemId != null) {
                            for (var i = 2; i < 5; i++) {
                                conversionDT.column(i).visible(false, false);
                            }
                            conversionDT.column(0).visible(true, true);
                        } else {
                            var data = conversionDT.row(0).data();
                            if (data != null && data.subItemId == null) {
                                conversionDT.column(0).visible(false, false);
                            }
                        }

                        HideTabLoader("modal-conversion");
                    });

                    // Price History
                    var priceDT = $('.modal-table-price').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-conversion");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetPricesJson","Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            }
                        },
                        serverSide: true,
                        filter: true,
                        responsive: true,
                        autoWidth: false,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "retailPrice", name: "RetailPrice", className: "text-end" },
                            { data: "netPrice", name: "NetPrice", className: "text-end" },
                            { data: "updateDate", name: "UpdateDate" },
                            { data: "updateBy", name: "UpdateBy" }
                        ],
                        order: [[3, "desc"]]
                    }).on("draw.dt", function () {
                        HideTabLoader("modal-price");

                     
                    });


                    // Warehouse Transfer History
                    var transferDT = $('.modal-table-transfer').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-transfer");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetTransfersJson","Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            }
                        },
                        serverSide: true,
                        filter: true,
                        responsive: true,
                        autoWidth: false,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "transferNumber", name: "TransferNumber" },
                            { data: "source", name: "Source" },
                            { data: "destination", name: "Destination" },
                            { data: "quantity", name: "Quantity", className: "text-end" },
                            { data: "transferDate", name: "TransferDate" },
                            { data: "transferBy", name: "TransferBy" },
                            { data: "remarks", name: "Remarks" }
                        ],
                        order: [[4, "desc"]]
                    }).on("draw.dt", function () {
                        HideTabLoader("modal-transfer");
                    });


                    // Sales Return Details
                    var returnDT = $('.modal-table-return').on('preXhr.dt', function (e, settings, data) {
                        ShowTabLoader("modal-return");
                    }).DataTable({
                        destroy: true,
                        ajax: {
                            url: "@Url.Action("GetReturnsJson","Item")",
                            type: "POST",
                            data: function (data) {
                                data.Id = id;
                            }
                        },
                        serverSide: true,
                        filter: true,
                        responsive: true,
                        autoWidth: false,
                        search: {
                            return: true,
                        },
                        columns: [
                            { data: "returnNumber", name: "ReturnNumber" },
                            { data: "itemCode", name: "ItemCode" },
                            { data: "itemName", name: "ItemName" },
                            { data: "quantity", name: "Quantity", className: "text-end" },
                            { data: "customer", name: "Customer" },
                            { data: "returnDate", name: "ReturnDate" },
                            { data: "returnBy", name: "ReturnBy" }
                        ],
                        order: [[5, "desc"]]
                    }).on("draw.dt", function () {
                        HideTabLoader("modal-return");
                    });

                    hideLoader();
                    $("#itemDetailsModal").modal("show");
                }
            }
        });
    }
</script>