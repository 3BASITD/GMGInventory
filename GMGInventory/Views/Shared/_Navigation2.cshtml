                                           asp-area="" asp-controller="InventoryReport" asp-action="StockStatus">Stock Status Report</a>
                                    }
                                    @if (navPages.Contains(PageNames.SupplierPurchaseHistoryReport.ToEnumString()))
                                    {
                                        <a class="dropdown-item @(currentController == "InventoryReport" && currentAction == "SupplierPurchase" ? "active" : "")"
                                           asp-area="" asp-controller="InventoryReport" asp-action="SupplierPurchase">Supplier Purchase History</a>
                                    }
                                    @if (navPages.Contains(PageNames.WarehouseTransferReport.ToEnumString()))
                                    {
                                        <a class="dropdown-item @(currentController == "InventoryReport" && currentAction == "WarehouseTransfer" ? "active" : "")"
                                           asp-area="" asp-controller="InventoryReport" asp-action="WarehouseTransfer">Warehouse Transfer Report</a>
                                    }
                                </div>
                            }
                            @if (navPages.Contains(PageNames.CreditMemoListingReport.ToEnumString())
                                                || navPages.Contains(PageNames.DebitMemoListingReport.ToEnumString())
                                                || navPages.Contains(PageNames.PurchaseOrderReport.ToEnumString())
                                                || navPages.Contains(PageNames.PurchaseReturnReport.ToEnumString())
                                                || navPages.Contains(PageNames.PurchaseReceivingReport.ToEnumString()))
                            {
                                <div class="col-md-4 col-report">
                                    @if (navPages.Contains(PageNames.CreditMemoListingReport.ToEnumString())
                                                            || navPages.Contains(PageNames.DebitMemoListingReport.ToEnumString()))
                                    {
                                        <span class="dropdown-header">ACCOUNTING REPORT</span>
                                        @if (navPages.Contains(PageNames.CreditMemoListingReport.ToEnumString()))
                                        {
                                            <a class="dropdown-item @(currentController == "AccountingReport" && currentAction == "CreditMemo" ? "active" : "")"
                                               asp-area="" asp-controller="AccountingReport" asp-action="CreditMemo">Credit Memo Listing Report</a>
                                        }
                                        @if (navPages.Contains(PageNames.DebitMemoListingReport.ToEnumString()))
                                        {
                                            <a class="dropdown-item @(currentController == "AccountingReport" && currentAction == "DebitMemo" ? "active" : "")"
                                               asp-area="" asp-controller="AccountingReport" asp-action="DebitMemo">Debit Memo Listing Report</a>
                                        }
                                    }
                                    @if (navPages.Contains(PageNames.PurchaseOrderReport.ToEnumString())
                                                            || navPages.Contains(PageNames.PurchaseReturnReport.ToEnumString())
                                                            || navPages.Contains(PageNames.PurchaseReceivingReport.ToEnumString()))
                                    {
                                        <span class="dropdown-header">PROCUREMENT REPORT</span>
                                        @if (navPages.Contains(PageNames.PurchaseOrderReport.ToEnumString()))
                                        {
                                            <a class="dropdown-item @(currentController == "ProcurementReport" && currentAction == "PurchaseOrder" ? "active" : "")"
                                               asp-area="" asp-controller="ProcurementReport" asp-action="PurchaseOrder">Purchase Order Report</a>
                                        }
                                        @if (navPages.Contains(PageNames.PurchaseReceivingReport.ToEnumString()))
                                        {
                                            <a class="dropdown-item @(currentController == "ProcurementReport" && currentAction == "Receiving" ? "active" : "")"
                                               asp-area="" asp-controller="ProcurementReport" asp-action="PurchaseReceiving">Purchase Receiving Report</a>
                                        }
                                        @if (navPages.Contains(PageNames.PurchaseReturnReport.ToEnumString()))
                                        {
                                            <a class="dropdown-item @(currentController == "ProcurementReport" && currentAction == "Return" ? "active" : "")"
                                               asp-area="" asp-controller="ProcurementReport" asp-action="PurchaseReturn">Purchase Return Report</a>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </li>
        }
    </ul>
}