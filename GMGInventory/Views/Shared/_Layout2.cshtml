@using GMGInventory.Data
@using GMGInventory.Helpers
@using Microsoft.AspNetCore.Identity

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    var activeUser = UserManager.FindByNameAsync(User.Identity.Name).Result;
    ViewData["IsNavIconPlain"] = activeUser.IsNavIconPlain;
    var newIcon = activeUser.IsNavIconPlain == false;
    var title = ViewData["Title"];
    var titleDetails = ViewData["TitleDetails"];
    var initials = AvatarHelper.GetInitials(activeUser.FirstName + " " + activeUser.LastName);
    var avatarBG = AvatarHelper.GetColorFromString(initials);
    var avatarFG = AvatarHelper.InvertHex(avatarBG);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(titleDetails == null ? "" : $"{titleDetails} ")@title | @await Component.InvokeAsync("LayoutData", new { viewType = "CompanyTitle" })</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&amp;display=fallback">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/css/adminlte.css" />
    <link rel="stylesheet" href="~/lib/datatables-bs5/datatables.min.css" />
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-toggle/css/bootstrap2-toggle.min.css" />
    @* <link rel="stylesheet" href="~/lib/chart.js/Chart.min.css" /> *@
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/lib/microtip/microtip.css" />
    <link rel="stylesheet" href="~/lib/swiper-11.1.14/package/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/lib/summernote/summernote-bs5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (newIcon)
    {
        <link rel="stylesheet" href="~/css/fa-emoji-overwrite.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap-icon/bootstrap-icons.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-top-nav @(activeUser.IsDarkMode ? "dark-mode" : "")">
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand-lg @(activeUser.IsDarkMode ? "navbar-dark" : "navbar-white navbar-light") to-stick nav-sticked">
            <div class="container-fluid">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand brand-link">
                    @await Component.InvokeAsync("LayoutData", new { viewType = "NavigationImage" })
                    @await Component.InvokeAsync("LayoutData", new { viewType = "CompanyNavbar" })
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-lg-center" id="navbarCollapse">
                    @if (activeUser.IsActive == false)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a href="#" class="nav-link text-error">
                                    <span class="fas fa-ban"></span>
                                    YOUR ACCOUNT IS DEACTIVATED
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <partial name="_Navigation2" />
                    }
                </div>
                <ul class="navbar-nav navbar-no-expand ml-auto">
                    <li class="nav-item dropdown">
                        <a id="menuOption" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="nav-link dropdown-toggle">
                            @* @if (newIcon)
                            {
                                <span class="emoji">🎛️</span>
                            }
                            else
                            {

                                <span class="fas fa-cog"></span>
                            } *@
                            <span style="display:inline-block;
                                         width:30px;
                                         height:30px;
                                         border-radius:50%;
                                         background-color:@avatarBG;
                                         color:@avatarFG;
                                         font-weight:bold;
                                         text-align:center;
                                         line-height:30px;
                                         font-size:12px;
                                         margin-top:-10px;">
                                @initials
                            </span>
                            <span class="sticked-hide">OPTIONS</span>
                        </a>
                        <ul aria-labelledby="menuOption" class="dropdown-menu dropdown-menu-option mt-md-3 border-0 shadow">
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index">
                                    @if (newIcon)
                                    {
                                        <span class="emoji">👤</span>
                                    }
                                    else
                                    {

                                        <i class="nav-icon fas fa-user"></i>
                                    }
                                    @*  Profile *@
                                    @activeUser.FirstName @activeUser.LastName
                                </a>
                            </li>
                            <li class="dropdown-divider"></li>
                            <li class="bg-gradient-danger">
                                <a href="#" class="dropdown-item" id="logout-link">
                                    @if (newIcon)
                                    {
                                        <span class="emoji">⏻</span>
                                    }
                                    else
                                    {

                                        <i class="nav-icon fas fa-power-off"></i>
                                    }
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="content-wrapper text-sm">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1></h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home"
                                @*&& ViewContext.RouteData.Values["action"]?.ToString() != "Index"*@)
                                                                {
                                    <li class="breadcrumb-item">
                                        <a asp-controller="Home" asp-action="Index">Home</a>
                                    </li>
                                }
                                @await RenderSectionAsync("Breadcrumb", required: false)
                                <li class="breadcrumb-item active">
                                    @ViewData["Title"]
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </section>

            <section class="content">
                <div class="container-fluid">
                    @*
                    @if (TempData["SuccessMessage"] != null || TempData["WarningMessage"] != null || TempData["ErrorMessage"] != null)
                    {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @(TempData["SuccessMessage"] ?? TempData["WarningMessage"] ?? TempData["ErrorMessage"])
                    <button type="button" class="close" aria-label="Close" data-bs-dismiss="alert">
                    <span aria-hidden="true">×</span>
                    </button>
                    </div>
                    }
                    *@
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer no-print text-sm">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 3.0.1
            </div>
            Copyright © 2022-@(DateTime.Now.Year) MISNet
        </footer>
    </div>

    <div class="reloader">
        There seems to be a problem while loading.
        <button id="btn-reload" onclick="location.reload()" style="text-decoration: underline; color: blue; background: none; border: none;">
            Reload the page.
        </button>
        If the problem persists, consult IT.
    </div>

    @* <partial name="_ItemDetailsPartial" /> *@

    <form id="logoutForm" class="form-inline d-none" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
    </form>

    <div id="partial-holder" class="text-sm mb-0"></div>
    <div id="for-print"></div>
    <input type="hidden" id="current-user-nickname" value="@activeUser.Nickname" />
    <input type="hidden" class="current-user-role" value="temp" />
    @foreach (var role in @UserManager.GetRolesAsync(activeUser).Result.ToList())
    {
        <input type="hidden" class="current-user-role" value="@role" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/lib/adminlte/js/adminlte.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/dist/additional-methods.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/datatables-bs5/datatables.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.js"></script>
    <script src="~/lib/sweetalert/sweetalert.min.js"></script>
    <script src="~/lib/popper.js/umd/popper.min.js"></script>
    <script src="~/lib/select2/js/select2.js"></script>
    <script src="~/lib/bootstrap-toggle/js/bootstrap2-toggle.min.js"></script>
    @* <script src="~/lib/chart.js/Chart.min.js"></script> *@
    <script src="~/lib/chart.js4/chart.umd.min.js"></script>
    <script src="~/lib/loadingoverlay/loadingoverlay.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/sheetjs/dist/xlsx.core.min.js"></script>
    <script src="~/lib/filereader/filereader.js"></script>
    <script src="~/lib/print-this/printThis.js"></script>
    <script src="~/lib/jquery-mask/jquery.mask.js"></script>
    <script src="~/lib/jquery-number-2.1.6/jquery.number.min.js"></script>
    <script src="~/lib/swiper-11.1.14/package/swiper-bundle.min.js"></script>
    <script src="~/lib/summernote/summernote-bs5.min.js"></script>
    <script src="~/lib/tippy/tippy-bundle.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await Component.InvokeAsync("LayoutData", new { viewType = "ErrorJson" })
    <script>
            $(document).ready(function () {
                var layout_is_dark_mode = @Json.Serialize(activeUser.IsDarkMode);
                var layout_success_message = @Json.Serialize(TempData["SuccessMessage"]);
                var layout_warning_message = @Json.Serialize(TempData["WarningMessage"]);
                var layout_error_message = @Json.Serialize(TempData["ErrorMessage"]);

                if (layout_is_dark_mode)
                {
                    $(".table").each(function () {
                        $(this).addClass("table-dark");
                    });
                }

                const progressCircle = document.querySelector(".autoplay-progress svg");
                const progressContent = document.querySelector(".autoplay-progress span");
                var swiper = new Swiper(".swiper-container", {
                    spaceBetween: 30,
                    centeredSlides: true,
                    autoplay: {
                        delay: 2500,
                        disableOnInteraction: false
                    },
                    pagination: {
                        el: ".swiper-pagination",
                        clickable: true
                    },
                    navigation: {
                        nextEl: ".swiper-button-next",
                        prevEl: ".swiper-button-prev"
                    },
                    on: {
                        autoplayTimeLeft(s, time, progress) {
                            progressCircle.style.setProperty("--progress", 1 - progress);
                            progressContent.textContent = `${Math.ceil(time / 1000)}s`;
                        }
                    }
                });

                if (layout_success_message != null || layout_warning_message != null || layout_error_message != null)
                {
                    if (layout_success_message != null)
                            toastr.success(layout_success_message, "Success");
                    else if (layout_warning_message != null)
                            toastr.warning(layout_warning_message, "Warning");
                    else if (layout_error_message != null)
                            toastr.error(layout_error_message, "Error");
                }

                // TempData not working fine on Json, use this instead
                const local_success_message = localStorage.getItem("successMessage");
                const local_warning_message = localStorage.getItem("warningMessage");
                const local_error_message = localStorage.getItem("errorMessage");
                if (local_success_message != null || local_warning_message != null || local_error_message != null)
                {
                    if (local_success_message != null){
                        toastr.success(local_success_message, "Success");
                        localStorage.removeItem("successMessage");
                    } else if (local_warning_message != null){
                        toastr.success(local_warning_message, "Warning");
                        localStorage.removeItem("warningMessage");
                    } else if (local_error_message != null){
                        toastr.success(local_error_message, "Error");
                        localStorage.removeItem("errorMessage");
                    }

                    /* sample use
                        localStorage.setItem("successMessage", data.message);
                        window.location.reload();
                    */
                }
            });

            $("form#logoutForm").on("submit", function (event) {
                //localStorage.clear();
                Object.keys(localStorage).forEach(key => {
                    if (key.startsWith('BAS_DT')) {
                        localStorage.removeItem(key);
                    }
                });
                //event.preventDefault();
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>