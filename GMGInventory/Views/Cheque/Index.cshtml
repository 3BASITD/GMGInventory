                                    <input type="date" id="edit-collectDate" name="CollectDate" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="edit-customer" class="form-label mb-0">Customer Code</label>
                                    <select id="edit-customer" name="Customer" style="width:100%">
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="edit-amount" class="control-label mb-0 d-block">Amount</label>
                                    <input type="number" step="0.01" min="0" id="edit-amount" name="Amount" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="edit-status" class="form-label mb-0">Status</label>
                                    <select id="edit-status" name="Status" style="width:100%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="edit-checkNo" class="control-label mb-0 d-block">Check No</label>
                                    <input name="CheckNo" id="edit-checkNo" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                                <div class="form-group">
                                    <label for="edit-checkDate" class="control-label mb-0 d-block">Check Date</label>
                                    <input type="date" id="edit-checkDate" name="CheckDate" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="edit-check" class="control-label mb-0 d-block">Check</label>
                                    <input name="Check" id="edit-check" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="edit-branch" class="control-label mb-0 d-block">Branch</label>
                                    <input name="Branch" id="edit-branch" class="form-control form-control-sm" />
                                </div>
                                <input type="hidden" id="edit-id" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-edit"></span> Update
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
