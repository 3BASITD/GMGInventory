<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-createdBy" class="form-label mb-0">Created By</label>
                            <select id="filter-createdBy" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Check Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Check Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Customer
        $("#filter-customer").select2({
            tags: true,
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            },
            dropdownParent: $("#filterModal")
        });

        // Load Select2 Cheque Status
         $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "ChequeStatus")",
            success: function (data, status, xhr) {
                if (user_access.canAdd) {
                    $("#create-status").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        dropdownParent: $("#createModal")
                    });
                }
                if (user_access.canEdit) {
                    $("#edit-status").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        dropdownParent: $("#editModal")
                    });
                }

                $("#filter-status").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "ALL"
                    },
                    dropdownParent: $("#filterModal")
                })
            }
        });

        // Load Select2 Customer
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions2", "Customer")",
            success: function (data, status, xhr) {
                if (user_access.canAdd) {
                    $("#create-customer").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        dropdownParent: $("#createModal")
                    });
                }
                if (user_access.canEdit) {
                    $("#edit-customer").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        dropdownParent: $("#editModal")
                    });
                }
            }
        });

        // Load Select2 User
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "User")",
            success: function (data, status, xhr) {
                $("#filter-createdBy").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "ALL"
                    },
                    dropdownParent: $("#filterModal")
                })
            }
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            chequeDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            chequeDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[3, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            Customer: "",
            CustomerId: "",
            Status: "",
            StatusId: "",
            CreatedBy: "",
            CreatedById: "",
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo())
        };

        function checkDTChanged() {
            if(!chequeDT) return false;
            
            return JSON.stringify(chequeDT.order()) != JSON.stringify(defaultDTState.order) ||
                   chequeDT.page.info().start != defaultDTState.page ||
                   chequeDT.page.len() != defaultDTState.length ||
                   (chequeDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-customer").val() != defaultDTState.CustomerId ||
                   $("#filter-status").val() != defaultDTState.StatusId ||
                   $("#filter-createdBy").val() != defaultDTState.CreatedById ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);

            $('#filter-customer').val(defaultDTState.CustomerId).trigger('change');
            $('#filter-status').val(defaultDTState.StatusId).trigger('change');
            $('#filter-createdBy').val(defaultDTState.CreatedById).trigger('change');
            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            
            if (chequeDT) {
                chequeDT.state.clear();
                chequeDT.order(defaultDTState.order);
                chequeDT.page(defaultDTState.page);
                chequeDT.search(defaultDTState.search.search);
            }
        }

        // Load List on DataTable
        var chequeDT = $('.table-cheque').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.Customer = $('#filter-customer option:selected').text();
                data.CustomerId = $('#filter-customer').val();
                data.Status = $('#filter-status option:selected').text();
                data.StatusId = $('#filter-status').val();
                data.CreatedBy = $('#filter-createdBy option:selected').text();
                data.CreatedById = $('#filter-createdBy').val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.CustomerId) {
                    var customerOption = new Option(data.Customer, data.CustomerId, true, true);
                    $(customerOption).data('data', {
                        id: data.CustomerId,
                        text: data.Customer
                    });
                    $("#filter-customer").append(customerOption).trigger('change');
                }
                if(data.StatusId) {
                    var statusOption = new Option(data.Status, data.StatusId, true, true);
                    $(statusOption).data('data', {
                        id: data.StatusId,
                        text: data.Status
                    });
                    $("#filter-status").append(statusOption).trigger('change');
                }
                if(data.CreatedById) {
                    var createdByOption = new Option(data.CreatedBy, data.CreatedById, true, true);
                    $(createdByOption).data('data', {
                        id: data.CreatedById,
                        text: data.CreatedBy
                    });
                    $("#filter-createdBy").append(createdByOption).trigger('change');
                }
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function (data) {
                    var customerId = $("#filter-customer").val();
                    if (customerId) {
                        if ($("#filter-customer").select2("data")[0].name) {
                            data.CustomerId = customerId;
                        } else {
                            data.CustomerId = 0;
                        }
                    }
                    data.UserCreated = $("#filter-createdBy").val()
                    data.StatusId = $("#filter-status").val();
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "collectDate", name: "CollectDate" },
                { data: "refNo", name: "RefNo" },
                { data: "customerName", name: "CustomerName" },
                { data: "checkDate", name: "CheckDate" },
                { data: "check", name: "Check" },
                { data: "branch", name: "Branch" },
                { data: "checkNo", name: "CheckNo" },
                { data: "amount", name: "Amount" },
                { data: "statusCode", name: "Status" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<button class="btn btn-info btn-xs detailsBtn" data-bs-toggle="modal" data-bs-target="#detailsModal" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></button>';
                        actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-pencil-alt"></span></button>';
                        actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete Cheque" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order
        });

        // Load functions upon DataTable load
        chequeDT.on("draw", function () {
            checkDefaultFilter();

            $('.detailsBtn').click(function (e) {
                var data = chequeDT.row($(this).parents('tr')).data();
                $(".modal-detail-collectDate").html(data.collectDate);
                $(".modal-detail-refNo").html(data.refNo);
                $(".modal-detail-customerName").html(data.customerName);
                $(".modal-detail-checkDate").html(data.checkDate);
                $(".modal-detail-check").html(data.check);
                $(".modal-detail-branch").html(data.branch);
                $(".modal-detail-checkNo").html(data.checkNo);
                $(".modal-detail-amount").html(data.amount);
                $(".modal-detail-status").html(data.statusCode);
            });

            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete Cheque",
                        text: "Are you sure you want to delete this record?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteChequeId').val(id);
                            $('#deleteChequeForm').submit();
                        }
                    });
                });
            }

            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = chequeDT.row($(this).parents('tr')).data();
                    $("#edit-id").val(data.id);
                    $("#edit-collectDate").val(data.collectDate);
                    $("#edit-refNo").val(data.refNo);
                    $("#edit-customer").val(data.customerId).trigger("change");
                    $("#edit-checkDate").val(data.checkDate);
                    $("#edit-check").val(data.check);
                    $("#edit-branch").val(data.branch);
                    $("#edit-checkNo").val(data.checkNo);
                    $("#edit-amount").val(data.amountD);
                    $("#edit-status").val(data.statusId).trigger("change");
                });

                // Validation for Edit Modal
                var validateEdit = $("#editForm").validate({
                    rules: {
                        CollectDate: { required: true },
                        Customer: { required: true },
                        RefNo: { required: true },
                        Check: { required: true },
                        CheckDate: { required: true },
                        Amount: { required: true }
                    },
                    messages: {
                        CollectDate: { required: "Please enter Collect Date" },
                        Customer: { required: "Please choose Customer" },
                        RefNo: { required: "Please enter Ref No." },
                        Check: { required: "Please enter Check" },
                        CheckDate: { required: "Please enter Check Date" },
                        Amount: { required: "Please enter Amount" }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoEdit();
                    }
                });

                // Send Edit to Controller
                function DoEdit() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("EditJson")",
                        data: {
                            Id: $("#edit-id").val(),
                            CollectDateD: $("#edit-collectDate").val(),
                            RefNo: $("#edit-refNo").val(),
                            CustomerId: $("#edit-customer").val(),
                            CheckDateD: $("#edit-checkDate").val(),
                            Check: $("#edit-check").val(),
                            Branch: $("#edit-branch").val(),
                            CheckNo: $("#edit-checkNo").val(),
                            AmountD: $("#edit-amount").val(),
                            StatusId: $("#edit-status").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#editModal").modal("hide");
                                chequeDT.ajax.reload();
                                hideLoader();
                            }
                        }
                    });
                }
            }
        });
        if (user_access.canAdd) {
             // Actions upon Display Create Modal
            $(".createBtn").click(function (e) {
                $("#create-collectDate").val("");
                $("#create-refNo").val("");
                $("#create-customer").prop("selectedIndex", 0).trigger("change");
                $("#create-checkDate").val("");
                $("#create-check").val("");
                $("#create-branch").val("");
                $("#create-checkNo").val("");
                $("#create-amount").val("0");
                $("#create-status").prop("selectedIndex", 0).trigger("change");

            });

            // Validation for Create Modal
            var validateCreate = $("#createForm").validate({
                rules: {
                    CollectDate: { required: true },
                    Customer: { required: true },
                    RefNo: { required: true },
                    Check: { required: true },
                    Amount: { required: true }
                },
                messages: {
                    CollectDate: { required: "Please enter Collect Date" },
                    Customer: { required: "Please choose Customer" },
                    RefNo: { required: "Please enter Ref No." },
                    Check: { required: "Please enter Check" },
                    Amount: { required: "Please enter Amount" }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoCreate();
                }
            });

            // Send Create to Controller
            function DoCreate() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("CreateJson")",
                    data: {
                        CollectDateD: $("#create-collectDate").val(),
                        RefNo: $("#create-refNo").val(),
                        CustomerId: $("#create-customer").val(),
                        CheckDateD: $("#create-checkDate").val(),
                        Check: $("#create-check").val(),
                        Branch: $("#create-branch").val(),
                        CheckNo: $("#create-checkNo").val(),
                        AmountD: $("#create-amount").val(),
                        StatusId: $("#create-status").val(),
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#createModal").modal("hide");
                            chequeDT.ajax.reload();
                            hideLoader()
                        }
                    }
                });
            }
        }

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-customer").val()) { urlQuery.push("CustomerId=" + $("#filter-customer").val()); }
                if ($("#filter-status").val()) { urlQuery.push("StatusId=" + $("#filter-status").val()); }
                if ($("#filter-createdBy").val()) { urlQuery.push("UserCreated=" + $("#filter-createdBy").val()); }

                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());

                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });

            var json_of_excel;
            var colnumber = 8; // number of columns required for upload
            var done_upload_excel = 0;
            var duplicate_upload = 0;

            var opts = {
                readAsDefault: 'ArrayBuffer',
                dragClass: 'drag',
                on: {
                    load: function (e, file) {
                        var result = new Uint8Array(e.target.result);
                        var xlsread = XLSX.read(result, { type: 'array' });
                        var xlsjson = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                        json_of_excel = xlsjson;
                    }
                }
            };
            $("#upload-file").fileReaderJS(opts);

            // Actions upon file selection
            $("#upload-file").on("change", function () {
                done_upload_excel = 0;
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            // Actions upon Display Upload Modal
            $(".uploadBtn").click(function (e) {
                done_upload_excel = 0;
                $("#upload-file").val("");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            function DoUpload() {
                if (!$("#upload-file").val()) {
                    toastr.warning("Please select a file first", "Warning");
                } if (json_of_excel.length == 0) {
                    toastr.warning("The excel file is empty", "Warning");
                } else {
                    var columns = Object.keys(json_of_excel[0]);
                    $("#upload-table tbody").html("");
                    $("#upload-table").show();
                    duplicate_upload = 0;
                    for (var i = 0; i < json_of_excel.length; i++) {
                        var rowNum = json_of_excel[i].__rowNum__;
                        var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                        row$.append($('<td/>').html(json_of_excel[i].__rowNum__));
                        for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                            var cellValue = json_of_excel[i][columns[colIndex]];
                            if (cellValue == null)
                                cellValue = "";
                            row$.append($('<td/>').html(cellValue));
                        }
                        if (columns.includes("CollectDate") == false
                            || columns.includes("RefNo") == false
                            || columns.includes("CustomerName") == false
                            || columns.includes("CheckDate") == false
                            || columns.includes("Check") == false
                            || columns.includes("Branch") == false
                            || columns.includes("CheckNo") == false
                            || columns.includes("Amount") == false
                            || columns.includes("Status") == false) {
                            row$.append($('<td/>').html("Unexpected columns"));
                            UploadRowDone();
                        } else {
                            SaveXLSX(json_of_excel[i]["CollectDate"], json_of_excel[i]["RefNo"], json_of_excel[i]["CustomerName"], json_of_excel[i]["CheckDate"], json_of_excel[i]["Check"], json_of_excel[i]["Branch"], json_of_excel[i]["CheckNo"], json_of_excel[i]["Amount"], json_of_excel[i]["Status"], rowNum);
                            row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                        }
                        $("#upload-table").append(row$);
                    }
                }
            }

            function SaveXLSX(collectDate, refNo, customerName, checkDate, check, branch, checkNo, amount, status, rownum) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadJson")",
                    data: {
                        CollectDateD: collectDate,
                        RefNo: refNo,
                        CustomerName: customerName,
                        CheckDateD: checkDate,
                        Check: check,
                        Branch: branch,
                        CheckNo: checkNo,
                        AmountD: amount,
                        statusCode: status
                    },
                    success: function (data, status, xhr) {
                        if (data.message == "Already exist") {
                            $("#upload-row" + rownum + "tr").remove();
                            duplicate_upload++;
                        } else {
                            $("#upload-row" + rownum + "td").html(data.status + ": " + data.message);
                        }

                    },
                    complete: function (xhr, status) {
                        UploadRowDone();
                    }
                });
            }

            function UploadRowDone() {
                done_upload_excel++;
                if (done_upload_excel == json_of_excel.length && duplicate_upload > 0) {
                    $("#upload-table").append('<tr><td>*</td><td colspan="9">Excluded ' + duplicate_upload + ' row(s)</td><td>Already exist</td></tr>');
                    $("#upload-file").val("");
                }
            }

            
            function DoFileUpload() {
                var formData = new FormData();
                formData.append("File", $("#upload-excel-file")[0].files[0]);

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadFileJson")",
                    data: formData,
                    loaderMessage: "Please wait while this completes. Whole file is being processed on server.<br><small class=\"text-muted\">Reloading the page will stop the process, which may result in some excel rows to fail.</small>",
                    //async: false,
                    cache: false,
                    contentType: false,
                    processData: false,
                    xhrFields: {
                        responseType: 'blob'  // important for file
                    },
                    //enctype: "multipart/form-data",
                    success: function (data, status, xhr) {
                        let statusHeader = xhr.getResponseHeader("X-Status");
                        let messageHeader = xhr.getResponseHeader("X-Message");
                        if (statusHeader == "Error") {
                            toastr.error(messageHeader, "Error");
                        } else {
                            // Create a temporary download link
                            let blob = new Blob([data]);
                            let url = window.URL.createObjectURL(blob);

                            let a = document.createElement("a");
                            a.href = url;

                            let disposition = xhr.getResponseHeader('Content-Disposition');
                            let fileName = "Result.xlsx";
                            if (disposition) {
                                // try UTF-8 encoded filename first
                                let utf8Match = disposition.match(/filename\*=UTF-8''(.+)/);
                                if (utf8Match && utf8Match[1]) {
                                    fileName = decodeURIComponent(utf8Match[1]);
                                } else {
                                    // fallback to normal filename
                                    let normalMatch = disposition.match(/filename="?([^";]+)"?/);
                                    if (normalMatch && normalMatch[1]) fileName = normalMatch[1];
                                }
                            }
                            a.download = fileName;
                            a.click();

                            window.URL.revokeObjectURL(url);

                            chequeDT.ajax.reload();

                            toastr.success(messageHeader, "Success");

                            $("#uploadFileModal").modal("hide");
                        }
                    }
                });
            }
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                var urlQuery = [];
                if ($("#filter-customer").val()) { urlQuery.push("CustomerId=" + $("#filter-customer").val()); }
                if ($("#filter-status").val()) { urlQuery.push("StatusId=" + $("#filter-status").val()); }
                if ($("#filter-createdBy").val()) { urlQuery.push("UserCreated=" + $("#filter-createdBy").val()); }

                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());

                setTimeout(function () {
                    let win = window.open('@Url.Action("PrintCheques")?' + urlQuery.join("&"), '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
