@model IEnumerable<ChequeVM>

@{
    ViewData["Title"] = "Cheque";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
  

            @if (userAccess.CanPrint)
            {
                <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                    <span class="fas fa-print"></span> Print
                </button>
            }

            @if (userAccess.CanAdd)
            {
                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="fas fa-plus"></span> New Cheque
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                @* <button type="button" class="btn btn-secondary btn-sm float-right uploadBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <span class="fas fa-upload"></span> Upload
                </button> *@
                @* <div class="dropdown float-right ml-2">
                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" id="dropdownMenuUpload" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuUpload">
                        <li><a class="dropdown-item btn-details-upload uploadBtn" data-bs-toggle="modal" data-bs-target="#uploadModal">Upload &amp; Track per Row</a></li>
                        <li><a class="dropdown-item btn-details-upload uploadFileBtn" data-bs-toggle="modal" data-bs-target="#uploadFileModal">Upload Whole File</a></li>
                    </ul>
                </div> *@
                <button type="button" class="btn btn-secondary btn-sm float-right uploadFileBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadFileModal">
                    <span class="fas fa-upload"></span> Upload
                </button>
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn ml-2">
                    <span class="fas fa-download"></span> Download
                </button>
            }

            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-cheque">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.CollectDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RefNo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CheckDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Check)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Branch)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CheckNo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Amount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.StatusCode)
                    </th>
                    <th></th>
                </tr>
            </thead>

        </table>
    </div>
</div>

<form id="deleteChequeForm" asp-action="Delete">
    <input type="hidden" id="deleteChequeId" name="Id" />
</form>

@if (userAccess.CanAdd)
{
    <!-- Create Modal -->
    <div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Cheque</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                 
                </div>
                <form autocomplete="off" id="createForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="create-collectDate" class="control-label mb-0 d-block">Collect Date</label>
                                    <input type="date" id="create-collectDate" name="CollectDate" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="create-refNo" class="control-label mb-0 d-block">Ref No</label>
                                    <input name="RefNo" id="create-refNo" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="create-customer" class="form-label mb-0">Customer Code</label>
                                    <select id="create-customer" name="Customer" style="width:100%">
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="create-amount" class="control-label mb-0 d-block">Amount</label>
                                    <input type="number" step="0.01" min="0" id="create-amount" name="Amount" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="create-status" class="form-label mb-0">Status</label>
                                    <select id="create-status" name="Status" style="width:100%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="create-checkDate" class="control-label mb-0 d-block">Check Date</label>
                                    <input type="date" id="create-checkDate" name="CheckDate" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="create-check" class="control-label mb-0 d-block">Check</label>
                                    <input name="Check" id="create-check" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="create-branch" class="control-label mb-0 d-block">Branch</label>
                                    <input name="Branch" id="create-branch" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="create-checkNo" class="control-label mb-0 d-block">Check No</label>
                                    <input name="CheckNo" id="create-checkNo" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@if (userAccess.CanEdit)
