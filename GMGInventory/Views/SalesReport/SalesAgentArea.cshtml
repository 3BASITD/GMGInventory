@model IEnumerable<SalesAgentAreaRVM>

@{
    ViewData["Title"] = "Sales by Agent-Area";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-sales">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.AgentCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AgentName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Area)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Sales)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PercentSales)
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th></th>
                    <th colspan="2"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-area" class="form-label mb-0">Area</label>
                            <select id="filter-area" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-area-name" class="form-label mb-0">Area Name</label>
                            <input type="text" id="filter-area-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Invoice Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Invoice Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

<!-- Chart Modal -->
<div class="modal fade" id="chartModal" role="dialog" aria-labelledby="chartModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title chart-title">Sales Chart</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body d-flex justify-content-center">
                <canvas id="salesChart"></canvas>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load Select2 for Agent
        $("#filter-agent").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Agent")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-agent").on("select2:select", function () {
            $("#filter-agent-name").val($(this).select2("data")[0].name);
        });

        $("#filter-agent").on("select2:unselecting", function (e) {
            $("#filter-agent-name").val("");
        });

        // Load Select2 for Area
        $("#filter-area").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Area")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-area").on("select2:select", function () {
            $("#filter-area-name").val($(this).select2("data")[0].name);
        });

        $("#filter-area").on("select2:unselecting", function (e) {
            $("#filter-area-name").val("");
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            salesDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            salesDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[1, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            AgentId: "",
            AgentCode: "",
            Agent: "",
            AreaId: "",
            AreaCode: "",
            Area: "",
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo())
        };

        function checkDTChanged() {
            if(!salesDT) return false;
            
            return JSON.stringify(salesDT.order()) != JSON.stringify(defaultDTState.order) ||
                   salesDT.page.info().start != defaultDTState.page ||
                   salesDT.page.len() != defaultDTState.length ||
                   (salesDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-agent").val() != defaultDTState.AgentId ||
                   $("#filter-area").val() != defaultDTState.AreaId ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            $('#filter-agent').val(defaultDTState.AgentId).trigger('change');
            $("#filter-agent-name").val(defaultDTState.Agent);
            $('#filter-area').val(defaultDTState.AreaId).trigger('change');
            $("#filter-area-name").val(defaultDTState.Area);
            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            
            localStorage.removeItem(dt_storage);

            if (salesDT) {
                salesDT.state.clear();
                salesDT.order(defaultDTState.order);
                salesDT.page(defaultDTState.page);
                salesDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        // Load List on DataTable
        var salesDT = $('.table-sales').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.AgentId = $('#filter-agent').val();
                data.AgentCode = $('#filter-agent option:selected').text();
                data.Agent = $('#filter-agent-name').val();
                data.AreaId = $('#filter-area').val();
                data.AreaCode = $('#filter-area option:selected').text();
                data.Area = $('#filter-area-name').val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.AgentId) {
                    var agentOption = new Option(data.AgentCode, data.AgentId, true, true);
                    $(agentOption).data('data', {
                        id: data.AgentId,
                        text: data.AgentCode,
                        name: data.Agent
                    });
                    $("#filter-agent").append(agentOption).trigger('change');
                    $("#filter-agent-name").val(data.Agent);
                }
                if(data.AreaId) {
                    var areaOption = new Option(data.AreaCode, data.AreaId, true, true);
                    $(areaOption).data('data', {
                        id: data.AreaId,
                        text: data.AreaCode
                    });
                    $("#filter-area").append(areaOption).trigger('change');
                    $("#filter-area-name").val(data.Area);
                }
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetSalesAgentAreaDT")",
                type: "POST",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    var areaId = $("#filter-area").val();

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    if (agentId) data.Agent = agentId;
                    if (areaId) data.Area = areaId;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "agentCode", name: "AgentCode" },
                { data: "agentName", name: "AgentName" },
                { data: "area", name: "Area" },
                { data: "sales", name: "Sales", className: "text-end" },
                { data: "percentSales", name: "PercentSales", className: "text-end" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        return "<div class='progress progress-xs'><div class='progress-bar progress-bar-striped bg-success' style='width: " + data.percentSales + "'></div></div>";
                    }
                }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = salesDT.ajax.json();
                var api = this.api(), data;

                $(api.column(3).footer()).html(FormatStringDecimal(json.totalAmount));
            },
            order: defaultDTState.order,
            rowGroup: {
                startRender: null,
                endRender: function (rows, group) {
                    return $('<tr/>')
                        .append('<td colspan="3">Total for <strong>' + group + '</strong></td>')
                        .append('<td class="text-end">' + rows.data()[0].agentTotalSales + '</td>')
                        .append('<td></td>')
                        .append('<td><button class="btn btn-warning btn-xs btn-chart" data-bs-toggle="modal" data-bs-target="#chartModal" data-agent-id="' + rows.data()[0].agentId + '" data-agent-name="' + rows.data()[0].agentName + '" data-microtip-title="Show Chart" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-chart-pie"></span></button></td>');
                },
                dataSrc: function (data) {
                    if (data.agentCode.trim() == data.agentName.trim()) {
                        return data.agentCode;
                    } else {
                        return data.agentCode + ' - ' + data.agentName;
                    }
                }
            }
        }).on("draw", function () {
            checkDefaultFilter();

            $(".table-sales thead th").removeClass("text-end");

            var chartData = [];
            var chartLabels = [];
            var chartBGColor = [];
            var chartBDColor = [];
            var chartHVColor = [];

            var ctx = document.getElementById('salesChart');//.getContext('2d');
            var salesChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Sales per Area',
                        data: chartData,
                        backgroundColor: chartBGColor,
                        borderColor: chartBDColor,
                        hoverBackgroundColor: chartHVColor,
                        borderWidth: 1
                    }]
                },
                options: {
                    //title: {
                    //    display: true,
                    //    text: "Sales by Area"
                    //},
                    legend: {
                        display: true,
                        position: 'left'
                    },
                    tooltips: {
                        callbacks: {
                            label: function (tooltipItem, data) {

                                let label = data.labels[tooltipItem.index];
                                let value = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                                return label + ' ' + FormatStringDecimal(value);

                            }
                        }
                    }
                }
            });

            var randomColors = function () {
                var r = Math.floor(Math.random() * 200) + 55;
                var g = Math.floor(Math.random() * 200) + 55;
                var b = Math.floor(Math.random() * 200) + 55;
                return r + "," + g + "," + b;
            };

            $(".btn-chart").on("click", function () {
                var agentId = $(this).data("agent-id");
                var agentName = $(this).data("agent-name");
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetSalesAgentArea")",
                    data: {
                        Agent: agentId,
                        DateFrom: $("#filter-from").val(),
                        DateTo: $("#filter-to").val()
                    },
                    success: function (data, status, xhr) {
                        chartData = [];
                        chartLabels = [];
                        chartBGColor = [];
                        chartBDColor = [];
                        chartHVColor = [];
                        for (d of data) {
                            chartData.push(d.salesD);
                            chartLabels.push(d.area + " (" + d.percentSales + ")");
                            var color = randomColors();
                            chartBGColor.push("rgb(" + color + ",0.75)");
                            chartBDColor.push("rgb(" + color + ",0.75)");
                            chartHVColor.push("rgb(" + color + ",1)");
                        }
                        salesChart.data.labels = chartLabels;
                        salesChart.data.datasets[0].data = chartData;
                        salesChart.data.datasets[0].backgroundColor = chartBGColor;
                        salesChart.data.datasets[0].borderColor = chartBDColor;
                        salesChart.data.datasets[0].hoverBackgroundColor = chartHVColor;
                        salesChart.update();

                        $(".chart-title").text("Sales by Area (" + agentName + " from " + formatDateEn(new Date($("#filter-from").val())) + " to " + formatDateEn(new Date($("#filter-to").val())) + ")");
                    }
                });
            });
        });

        $(".btnFilter").on("click", function () {
            salesDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-area").val()) { urlQuery.push("Area=" + $("#filter-area").val()); }
            window.location = "@Url.Action("DownloadSalesAgentArea")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-area").val()) { urlQuery.push("Area=" + $("#filter-area").val()); }
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintSalesAgentArea")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
}