@model IEnumerable<SalesReturnRVM>

@{
    ViewData["Title"] = "Sales Return Listing";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-sales">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SRNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ReturnDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ReturnReason)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Agent)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SINumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ControlNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DeliveryDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PickupDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Unit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.QuantityReturned)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PriceReturned)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Amount)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th class="text-end">Total</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item" class="form-label mb-0">Item Code</label>
                            <select id="filter-item" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-item-name" class="form-label mb-0">Item Name</label>
                            <input type="text" id="filter-item-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var date_today = new Date();
        var date_year_ago = new Date();
        date_year_ago.setYear(date_year_ago.getFullYear() - 1);

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setFullYear(dt_from.getFullYear() + 1);
                    //dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setFullYear(dt_to.getFullYear() - 1);
                //dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        // Load Select2 for Customer
        $("#filter-customer").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-customer").on("select2:select", function () {
            $("#filter-customer-name").val($(this).select2("data")[0].name);
        });

        $("#filter-customer").on("select2:unselecting", function (e) {
            $("#filter-customer-name").val("");
        });

        // Load Select2 for Item
        $("#filter-item").select2({
            tags: true,
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                if (repo.name) {
                    return $(
                        "<strong>" + repo.text + "</strong> " +
                        (repo.text != repo.name
                            ? "<em class='fw-light'> - " + repo.name + "</em>"
                            : "") +
                        "<br />" +
                        "<small class='text-muted'>" +
                        (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                        (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                        "</small>");
                }
                return $("<strong>" + repo.text + "</strong> <em class='fw-light'> - All with keyword &quot;" + repo.text + "&quot;</em>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-item").on("select2:select", function () {
            if ($(this).select2("data")[0].name) {
                $("#filter-item-name").val($(this).select2("data")[0].name);
            } else if ($("#filter-item").val()) {
                $("#filter-item-name").val('All with keyword "' + $("#filter-item").val() + '"');
            }
        });

        $("#filter-item").on("select2:unselecting", function (e) {
            $("#filter-item-name").val("");
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            salesDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            salesDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            CustomerId: "",
            CustomerCode: "",
            Customer: "",
            ItemId: "",
            ItemCode: "",
            Item: "",
            DateFrom: DateForInput(date_year_ago),
            DateTo: DateForInput(date_today),
        };

        function checkDTChanged() {
            if(!salesDT) return false;
            
            return JSON.stringify(salesDT.order()) != JSON.stringify(defaultDTState.order) ||
                   salesDT.page.info().start != defaultDTState.page ||
                   salesDT.page.len() != defaultDTState.length ||
                   (salesDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-customer").val() != defaultDTState.CustomerId ||
                   $("#filter-item").val() != defaultDTState.ItemId ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
        }

        function resetToDefaultDTFilter() {
            $('#filter-customer').val(defaultDTState.CustomerId).trigger('change');
            $("#filter-customer-name").val(defaultDTState.Customer);
            $('#filter-item').val(defaultDTState.ItemId).trigger('change');
            $("#filter-item-name").val(defaultDTState.Item);
            $('#filter-from').val(defaultDTState.DateFrom);
            $('#filter-to').val(defaultDTState.DateTo);
            
            localStorage.removeItem(dt_storage);

            if (salesDT) {
                salesDT.state.clear();
                salesDT.order(defaultDTState.order);
                salesDT.page(defaultDTState.page);
                salesDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        // Load List on DataTable
        var salesDT = $('.table-sales').on('preXhr.dt', function (e, settings, data) {
            //showLoader();
        }).DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.CustomerId = $('#filter-customer').val();
                data.CustomerCode = $('#filter-customer option:selected').text();
                data.Customer = $('#filter-customer-name').val();
                data.ItemId = $('#filter-item').val();
                data.ItemCode = $('#filter-item option:selected').text();
                data.Item = $('#filter-item-name').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.CustomerId) {
                    var customerOption = new Option(data.CustomerCode, data.CustomerId, true, true);
                    $(customerOption).data('data', {
                        id: data.CustomerId,
                        text: data.CustomerCode,
                        name: data.Customer
                    });
                    $("#filter-customer").append(customerOption).trigger('change');
                    $("#filter-customer-name").val(data.Customer);
                }
                if(data.ItemId) {
                    var itemOption = new Option(data.ItemCode, data.ItemId, true, true);
                    $(itemOption).data('data', {
                        id: data.ItemId,
                        text: data.ItemCode,
                        name: data.Item
                    });
                    $("#filter-item").append(itemOption).trigger('change');
                    $("#filter-item-name").val(data.Item);
                }
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetSalesReturnDT")",
                type: "POST",
                data: function (data) {
                    var itemId = $("#filter-item").val();
                    if (itemId) {
                        if (isNaN(itemId)) {
                            data.Item = 0;
                            data.ItemKeyword = itemId;
                        } else {
                            data.Item = itemId;
                        }
                    }

                    var customerId = $("#filter-customer").val();
                    if (customerId) data.Customer = customerId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "srNumber", name: "SRNumber", responsivePriority: 1 },
                { data: "returnDate.format1", name: "ReturnDate", responsivePriority: 2 },
                { data: "returnReason", name: "ReturnReason", responsivePriority: 3 },
                {
                    data: function (data, type, dataToSet) {
                        return data.soNumber || "<span class='text-muted'>N/A</span>";
                    },
                    name: "SONumber",
                    responsivePriority: 4
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.orderDate ? data.orderDate.format1 : "<span class='text-muted'>N/A</span>";
                    },
                    name: "OrderDate", 
                    responsivePriority: 5
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.customer || "<span class='text-muted'>N/A</span>";
                    },
                    name: "Customer",
                    responsivePriority: 6
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.agent || "<span class='text-muted'>N/A</span>";
                    },
                    name: "Agent",
                    responsivePriority: 7
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.siNumber || "<span class='text-muted'>N/A</span>";
                    },
                    name: "SINumber",
                    responsivePriority: 8
                },
                { data: "controlNumber", name: "ControlNumber" },
                {
                    data: function (data, type, dataToSet) {
                        return data.deliveryDate ? data.deliveryDate.format1 : "<span class='text-muted'>N/A</span>";
                    },
                    name: "DeliveryDate",
                    responsivePriority: 9
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.pickupDate ? data.pickupDate.format1 : "<span class='text-muted'>N/A</span>";
                    },
                    name: "PickupDate", 
                    responsivePriority: 10
                },
                { data: "itemCode", name: "ItemCode", responsivePriority: 11 },
                { data: "itemName", name: "ItemName" },
                { data: "brand", name: "Brand" },
                { data: "itemType", name: "ItemType" },
                { data: "unit", name: "Unit", responsivePriority: 12 },
                { data: "quantityReturned", name: "QuantityReturned", className: "text-end", responsivePriority: 13 },
                { data: "priceReturned", name: "PriceReturned", className: "text-end", responsivePriority: 14 },
                { data: "amount", name: "Amount", className: "text-end", responsivePriority: 15 }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = salesDT.ajax.json();
                var api = this.api(), data;

                $(api.column(16).footer()).html(FormatStringInteger(json.totalQuantity));
                $(api.column(17).footer()).html(FormatStringDecimal(json.totalAmount));
                $(api.column(18).footer()).html(FormatStringDecimal(json.totalAmount2));
            },
            order: defaultDTState.order
        });

        // Load functions upon DataTable load
        salesDT.on("draw", function () {
            //hideLoader();
            checkDefaultFilter();

            $(".table-sales thead th").removeClass("text-end");
        });

        $(".btnFilter").on("click", function () {
            salesDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
            if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
            window.location = "@Url.Action("DownloadSalesReturn")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
            if ($("#filter-item").val()) { urlQuery.push("Item=" + $("#filter-item").val()); }
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintSalesReturn")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
    }