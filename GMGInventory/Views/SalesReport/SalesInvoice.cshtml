@model IEnumerable<SalesInvoiceRVM>

@{
    ViewData["Title"] = "Sales Invoice Listing";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-sales">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceNumber)
                    </th>
                    <th>
                        BIR Invoice Number
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Agent)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Amount)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="7" class="text-end">Total</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" class="form-control form-control-sm">
                                <option value="">All</option>
                                <option value="Draft">Draft</option>
                                <option value="Invoiced">Invoiced</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" class="form-control form-control-sm">
                                <option value="">All</option>
                                <option value="ML">MM & Luzon</option>
                                <option value="VM">Visayas & Mindanao</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load Select2 for Agent
        $("#filter-agent").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Agent")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-agent").on("select2:select", function () {
            $("#filter-agent-name").val($(this).select2("data")[0].name);
        });

        $("#filter-agent").on("select2:unselecting", function (e) {
            $("#filter-agent-name").val("");
        });

        // Load Select2 for Customer
        $("#filter-customer").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-customer").on("select2:select", function () {
            $("#filter-customer-name").val($(this).select2("data")[0].name);
        });

        $("#filter-customer").on("select2:unselecting", function (e) {
            $("#filter-customer-name").val("");
        });

        $("#filter-preset").val("L7D");
        $("#filter-from").val(DateForInput(getFilterDefaultDateFrom()));
        $("#filter-to").val(DateForInput(getFilterDefaultDateTo()));

        $("#filter-to").on("focusout", function () {
            var from = $("#filter-from").val();
            var to = $("#filter-to").val();

            if (from && to && new Date(from) > new Date(to))
                $("#filter-to").val(from);
        });

        $("#filter-from").on("focusout", function () {
            var from = $("#filter-from").val();
            var to = $("#filter-to").val();

            if (from && to && new Date(from) > new Date(to))
                $("#filter-from").val(to);
        });

        $("#filter-preset").on("change", function() {
            applyFilterPreset($(this).val());
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            salesDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            salesDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[1, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            AgentId: "",
            AgentCode: "",
            Agent: "",
            CustomerId: "",
            CustomerCode: "",
            Customer: "",
            Status: "",
            Region: "",
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo())
        };

        function checkDTChanged() {
            if(!salesDT) return false;
            
            return JSON.stringify(salesDT.order()) != JSON.stringify(defaultDTState.order) ||
                   salesDT.page.info().start != defaultDTState.page ||
                   salesDT.page.len() != defaultDTState.length ||
                   (salesDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-agent").val() != defaultDTState.AgentId ||
                   $("#filter-customer").val() != defaultDTState.CustomerId ||
                   $("#filter-status").val() != defaultDTState.Status ||
                   $("#filter-region").val() != defaultDTState.Region ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);

            $('#filter-agent').val(defaultDTState.AgentId).trigger('change');
            $("#filter-agent-name").val(defaultDTState.Agent);
            $('#filter-customer').val(defaultDTState.CustomerId).trigger('change');
            $("#filter-customer-name").val(defaultDTState.Customer);
            $('#filter-status').val(defaultDTState.Status).trigger('change');
            $('#filter-region').val(defaultDTState.Region).trigger('change');
            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            
            if (salesDT) {
                salesDT.state.clear();
                salesDT.order(defaultDTState.order);
                salesDT.page(defaultDTState.page);
                salesDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        // Load List on DataTable
        var salesDT = $('.table-sales').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.AgentId = $('#filter-agent').val();
                data.AgentCode = $('#filter-agent option:selected').text();
                data.Agent = $('#filter-agent-name').val();
                data.CustomerId = $('#filter-customer').val();
                data.CustomerCode = $('#filter-customer option:selected').text();
                data.Customer = $('#filter-customer-name').val();
                data.Status = $('#filter-status').val();
                data.Region = $('#filter-region').val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.AgentId) {
                    var agentOption = new Option(data.AgentCode, data.AgentId, true, true);
                    $(agentOption).data('data', {
                        id: data.AgentId,
                        text: data.AgentCode,
                        name: data.Agent
                    });
                    $("#filter-agent").append(agentOption).trigger('change');
                    $("#filter-agent-name").val(data.Agent);
                }
                if(data.CustomerId) {
                    var customerOption = new Option(data.CustomerCode, data.CustomerId, true, true);
                    $(customerOption).data('data', {
                        id: data.CustomerId,
                        text: data.CustomerCode,
                        name: data.Customer
                    });
                    $("#filter-customer").append(customerOption).trigger('change');
                    $("#filter-customer-name").val(data.Customer);
                }
                $('#filter-status').val(data.Status).trigger('change');
                $('#filter-region').val(data.Region).trigger('change');
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetSalesInvoiceDT")",
                type: "POST",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    var customerId = $("#filter-customer").val();
                    var statusId = $("#filter-status").val();
                    var region = $("#filter-region").val();

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    if (agentId) data.Agent = agentId;
                    if (customerId) data.Customer = customerId;
                    if (statusId) data.StatusCode = statusId;
                    if (region) data.Region2 = region;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "invoiceNumber", name: "InvoiceNumber" },
                { data: "controlNumber", name: "ControlNumber" },
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "customerCode", name: "CustomerCode" },
                { data: "customerName", name: "CustomerName" },
                { data: "agent", name: "Agent" },
                { data: "status", name: "Status" },
                { data: "amount", name: "Amount", className: "text-end", orderable: false }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = salesDT.ajax.json();
                var api = this.api(), data;

                $(api.column(7).footer()).html(FormatStringDecimal(json.totalAmount));
            },
            order: defaultDTState.order
        });

        // Load functions upon DataTable load
        salesDT.on("draw", function () {
            //hideLoader();
            checkDefaultFilter();

            $(".table-sales thead th").removeClass("text-end");
        });

        $(".btnFilter").on("click", function () {
            salesDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
            if ($("#filter-status").val()) { urlQuery.push("StatusCode=" + $("#filter-status").val()); }
            if ($("#filter-region").val()) { urlQuery.push("Region2=" + $("#filter-region").val()); }
            window.location = "@Url.Action("DownloadSalesInvoice")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-customer").val()) { urlQuery.push("Customer=" + $("#filter-customer").val()); }
            if ($("#filter-status").val()) { urlQuery.push("StatusCode=" + $("#filter-status").val()); }
            if ($("#filter-region").val()) { urlQuery.push("Region2=" + $("#filter-region").val()); }
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintSalesInvoice")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
    }