@model SalesAgentAreaPVM

@{
    Layout = "";
    var title = "Sales by Agent-Area";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Agent</strong>
        <span>@Model.Agent</span>
        <br />
        <strong>Area</strong>
        <span>@Model.Area</span>
        <br />
        <strong>Date From</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Date To</strong>
        <span>@Model.DateTo</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().AgentCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().AgentName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Area)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Sales)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().PercentSales)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Contents)
            {
                <tr>
                    <td><nobr>@item.AgentCode</nobr></td>
                    <td>@item.AgentName</td>
                    <td>@item.Area</td>
                    <td class="right-text"><nobr>@item.Sales</nobr></td>
                    <td class="right-text"><nobr>@item.PercentSales</nobr></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalSales</nobr></th>
                <th></th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>