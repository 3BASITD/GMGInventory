@model IEnumerable<OutboundRVM>

@{
    ViewData["Title"] = "Daily Outbound";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-sales">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.InvoiceDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OldSkuCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Quantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SalesOrderNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ControlNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Region)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Area)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end">Total</th>
                    <th></th>
                    <th colspan="4" class="text-end"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region-name" class="form-label mb-0">Region Name</label>
                            <input type="text" id="filter-region-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-area" class="form-label mb-0">Area</label>
                            <select id="filter-area" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-area-name" class="form-label mb-0">Area Name</label>
                            <input type="text" id="filter-area-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand-name" class="form-label mb-0">Brand Name</label>
                            <input type="text" id="filter-brand-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Invoice Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Invoice Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load Select2 for Region
        $("#filter-region").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Region")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-region").on("select2:select", function () {
            $("#filter-region-name").val($(this).select2("data")[0].name);
        });

        $("#filter-region").on("select2:unselecting", function (e) {
            $("#filter-region-name").val("");
        });

        // Load Select2 for Area
        $("#filter-area").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Area")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-area").on("select2:select", function () {
            $("#filter-area-name").val($(this).select2("data")[0].name);
        });

        $("#filter-area").on("select2:unselecting", function (e) {
            $("#filter-area-name").val("");
        });

        // Load Select2 for Brand
        $("#filter-brand").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Brand")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-brand").on("select2:select", function () {
            $("#filter-brand-name").val($(this).select2("data")[0].name);
        });

        $("#filter-brand").on("select2:unselecting", function (e) {
            $("#filter-brand-name").val("");
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            outboundDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            outboundDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            RegionId: "",
            RegionCode: "",
            Region: "",
            AreaId: "",
            AreaCode: "",
            Area: "",
            BrandId: "",
            BrandCode: "",
            Brand: "",
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo())
        };

        function checkDTChanged() {
            if(!outboundDT) return false;
            
            return JSON.stringify(outboundDT.order()) != JSON.stringify(defaultDTState.order) ||
                   outboundDT.page.info().start != defaultDTState.page ||
                   outboundDT.page.len() != defaultDTState.length ||
                   (outboundDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-region").val() != defaultDTState.RegionId ||
                   $("#filter-area").val() != defaultDTState.AreaId ||
                   $("#filter-brand").val() != defaultDTState.BrandId ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            $('#filter-region').val(defaultDTState.RegionId).trigger('change');
            $("#filter-region-name").val(defaultDTState.Region);
            $('#filter-area').val(defaultDTState.AreaId).trigger('change');
            $("#filter-area-name").val(defaultDTState.Area);
            $('#filter-brand').val(defaultDTState.BrandId).trigger('change');
            $("#filter-brand-name").val(defaultDTState.Brand);
            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            
            localStorage.removeItem(dt_storage);

            if (outboundDT) {
                outboundDT.state.clear();
                outboundDT.order(defaultDTState.order);
                outboundDT.page(defaultDTState.page);
                outboundDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        // Load List on DataTable
        var outboundDT = $('.table-sales').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.RegionId = $('#filter-region').val();
                data.RegionCode = $('#filter-region option:selected').text();
                data.Region = $('#filter-region-name').val();
                data.AreaId = $('#filter-area').val();
                data.AreaCode = $('#filter-area option:selected').text();
                data.Area = $('#filter-area-name').val();
                data.BrandId = $('#filter-brand').val();
                data.BrandCode = $('#filter-brand option:selected').text();
                data.Brand = $('#filter-brand-name').val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.RegionId) {
                    var regionOption = new Option(data.RegionCode, data.RegionId, true, true);
                    $(regionOption).data('data', {
                        id: data.RegionId,
                        text: data.RegionCode,
                        name: data.Region
                    });
                    $("#filter-region").append(regionOption).trigger('change');
                    $("#filter-region-name").val(data.Region);
                }
                if(data.AreaId) {
                    var areaOption = new Option(data.AreaCode, data.AreaId, true, true);
                    $(areaOption).data('data', {
                        id: data.AreaId,
                        text: data.AreaCode
                    });
                    $("#filter-area").append(areaOption).trigger('change');
                    $("#filter-area-name").val(data.Area);
                }
                if(data.BrandId) {
                    var brandOption = new Option(data.BrandCode, data.BrandId, true, true);
                    $(brandOption).data('data', {
                        id: data.BrandId,
                        text: data.BrandCode,
                        name: data.Brand
                    });
                    $("#filter-brand").append(brandOption).trigger('change');
                    $("#filter-brand-name").val(data.Brand);
                }
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetOutboundDT")",
                type: "POST",
                data: function (data) {
                    var area = $("#filter-area").val();
                    var region = $("#filter-region").val();
                    var brandId = $("#filter-brand").val();

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    if (area) data.Area= area;
                    if (region) data.Region= region;
                    if (brandId) data.Brand = brandId;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "invoiceDate", name: "InvoiceDate" },
                { data: "oldSkuCode", name: "OldSkuCode" },
                { data: "itemCode", name: "ItemCode" },
                { data: "itemName", name: "ItemName" },
                { data: "brand", name: "Brand" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "salesOrderNumber", name: "SalesOrderNumber" },
                { data: "controlNumber", name: "ControlNumber" },
                { data: "region", name: "Region" },
                { data: "area", name: "Area" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = outboundDT.ajax.json();
                var api = this.api(), data;

                $(api.column(5).footer()).html(FormatStringInteger(json.totalQuantity));
            },
            order: defaultDTState.order
        }).on("draw", function () {
            checkDefaultFilter();
            $(".table-sales thead th").removeClass("text-end");
        });

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-region").val()) { urlQuery.push("Region=" + $("#filter-region").val()); }
            if ($("#filter-area").val()) { urlQuery.push("Area=" + $("#filter-area").val()); }
            if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
            window.location = "@Url.Action("DownloadOutbound")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-region").val()) { urlQuery.push("Region=" + $("#filter-region").val()); }
            if ($("#filter-area").val()) { urlQuery.push("Area=" + $("#filter-area").val()); }
            if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintOutbound")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
    }