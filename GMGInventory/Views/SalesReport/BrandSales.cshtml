@model IEnumerable<BrandSalesRVM>

@{
    ViewData["Title"] = "Brand Sales";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-sales">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    @*<th>
                        @Html.DisplayNameFor(model => model.AgentCode)
                    </th>*@
                    <th>
                        @*@Html.DisplayNameFor(model => model.AgentName)*@
                        Agent
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Amount)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="2" class="text-end">Total</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setFullYear(dt_from.getFullYear() + 1);
                    //dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setFullYear(dt_to.getFullYear() - 1);
                //dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        // Load Select2 for Agent
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Agent")",
            success: function (data, status, xhr) {
                $("#filter-agent").select2({
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        // Load Select2 for Brand
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Brand")",
            success: function (data, status, xhr) {
                $("#filter-brand").select2({
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        // Load List on DataTable
        var salesDT = $('.table-sales').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetBrandSalesDT")",
                type: "POST",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    var brandId = $("#filter-brand").val();

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    if (agentId) data.Agent = agentId;
                    if (brandId) data.Brand = brandId;
                }
            },
            processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "brand", name: "Brand" },
                //{ data: "agentCode", name: "AgentCode" },
                { data: "agentName", name: "AgentName" },
                { data: "amount", name: "Amount", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = salesDT.ajax.json();
                var api = this.api(), data;

                $(api.column(2  ).footer()).html(FormatStringDecimal(json.totalAmount));
            }
        });

        // Load functions upon DataTable load
        salesDT.on("draw", function () {
            hideLoader();

            $(".table-sales thead th").removeClass("text-end");
        });

        $(".btnFilter").on("click", function () {
            salesDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
            window.location = "@Url.Action("DownloadBrandSales")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintBrandSales")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
    }