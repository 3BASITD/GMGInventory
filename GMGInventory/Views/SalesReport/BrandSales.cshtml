@model IEnumerable<BrandSalesRVM>

@{
    ViewData["Title"] = "Brand Sales";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-sales">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Brand)
                    </th>
                    @*<th>
                        @Html.DisplayNameFor(model => model.AgentCode)
                    </th>*@
                    <th>
                        @*@Html.DisplayNameFor(model => model.AgentName)*@
                        Agent
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Amount)
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th colspan="2" class="text-end">Total</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand" class="form-label mb-0">Brand</label>
                            <select id="filter-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-brand-name" class="form-label mb-0">Brand Name</label>
                            <input type="text" id="filter-brand-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var date_today = new Date();
        var date_year_ago = new Date();
        date_year_ago.setYear(date_year_ago.getFullYear() - 1);

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setFullYear(dt_from.getFullYear() + 1);
                    //dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setFullYear(dt_to.getFullYear() - 1);
                //dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        // Load Select2 for Agent
        $("#filter-agent").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: 'All',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Agent")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-agent").on("select2:select", function () {
            $("#filter-agent-name").val($(this).select2("data")[0].name);
        });

        $("#filter-agent").on("select2:unselecting", function (e) {
            $("#filter-agent-name").val("");
        });

        // Load Select2 for Brand
        $("#filter-brand").select2({
            //minimumInputLength: 1,
            allowClear: true,
            placeholder: {
                id: "",
                text: "All"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Brand")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter-brand").on("select2:select", function () {
            $("#filter-brand-name").val($(this).select2("data")[0].name);
        });

        $("#filter-brand").on("select2:unselecting", function (e) {
            $("#filter-brand-name").val("");
        });

        function ApplyFilter() {
            salesDT.ajax.reload(() => {
                $("#filterModal").modal("hide");
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            resetToDefaultDTFilter();

            salesDT.ajax.reload(() => {
                $("#filterModal").modal("hide");
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "asc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            AgentId: "",
            AgentCode: "",
            Agent: "",
            BrandId: "",
            BrandCode: "",
            Brand: "",
            DateFrom: DateForInput(date_year_ago),
            DateTo: DateForInput(date_today),
        };

        function checkDefaultFilter() {
            var changed = JSON.stringify(salesDT.order()) != JSON.stringify(defaultDTState.order) ||
                          salesDT.page.info().start != defaultDTState.page ||
                          salesDT.page.len() != defaultDTState.length ||
                          (salesDT.search() || "") != defaultDTState.search.search ||
                          $("#filter-agent").val() != defaultDTState.AgentId ||
                          $("#filter-brand").val() != defaultDTState.BrandId ||
                          $('#filter-from').val() != defaultDTState.DateFrom ||
                          $('#filter-to').val() != defaultDTState.DateTo;

            $(".btn-filter").toggleClass('btn-filtered', changed);
            $(".btnReset").toggle(changed);
        }

        function resetToDefaultDTFilter() {
            $('#filter-agent').val(defaultDTState.AgentId).trigger('change');
            $("#filter-agent-name").val(defaultDTState.Agent);
            $('#filter-brand').val(defaultDTState.BrandId).trigger('change');
            $("#filter-brand-name").val(defaultDTState.Brand);
            $('#filter-from').val(defaultDTState.DateFrom);
            $('#filter-to').val(defaultDTState.DateTo);

            salesDT.state.clear();
            salesDT.order(defaultDTState.order);
            salesDT.page(defaultDTState.page);
            salesDT.search(defaultDTState.search.search);
        }

        // Load List on DataTable
        var salesDT = $('.table-sales').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            stateSave: true,
            stateSaveParams: function (settings, data) {
                data.AgentId = $('#filter-agent').val();
                data.AgentCode = $('#filter-agent option:selected').text();
                data.Agent = $('#filter-agent-name').val();
                data.BrandId = $('#filter-brand').val();
                data.BrandCode = $('#filter-brand option:selected').text();
                data.Brand = $('#filter-brand-name').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.AgentId) {
                    var agentOption = new Option(data.AgentCode, data.AgentId, true, true);
                    $(agentOption).data('data', {
                        id: data.AgentId,
                        text: data.AgentCode,
                        name: data.Agent
                    });
                    $("#filter-agent").append(agentOption).trigger('change');
                    $("#filter-agent-name").val(data.Agent);
                }
                if(data.BrandId) {
                    var brandOption = new Option(data.BrandCode, data.BrandId, true, true);
                    $(brandOption).data('data', {
                        id: data.BrandId,
                        text: data.BrandCode,
                        name: data.Brand
                    });
                    $("#filter-brand").append(brandOption).trigger('change');
                    $("#filter-brand-name").val(data.Brand);
                }
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetBrandSalesDT")",
                type: "POST",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    var brandId = $("#filter-brand").val();

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    if (agentId) data.Agent = agentId;
                    if (brandId) data.Brand = brandId;
                }
            },
            processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "brand", name: "Brand" },
                //{ data: "agentCode", name: "AgentCode" },
                { data: "agentName", name: "AgentName" },
                { data: "amount", name: "Amount", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = salesDT.ajax.json();
                var api = this.api(), data;

                $(api.column(2).footer()).html(FormatStringDecimal(json.totalAmount));
            }
        });

        // Load functions upon DataTable load
        salesDT.on("draw", function () {
            hideLoader();
            checkDefaultFilter();

            $(".table-sales thead th").removeClass("text-end");
        });

        $(".btnFilter").on("click", function () {
            salesDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        $(".downloadBtn").click(function (e) {
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
            window.location = "@Url.Action("DownloadBrandSales")?" + urlQuery.join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            var urlQuery = [];
            urlQuery.push("DateFrom=" + $("#filter-from").val());
            urlQuery.push("DateTo=" + $("#filter-to").val());
            if ($("#filter-agent").val()) { urlQuery.push("Agent=" + $("#filter-agent").val()); }
            if ($("#filter-brand").val()) { urlQuery.push("Brand=" + $("#filter-brand").val()); }
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintBrandSales")?' + urlQuery.join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
    }