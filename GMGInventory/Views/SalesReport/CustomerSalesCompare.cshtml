@model IEnumerable<CustomerSalesRVM>

@{
    ViewData["Title"] = "Customer Sales (Compare)";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesReport" asp-action="CusomerSales">Customer Sales</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-primary btn-sm float-right printBtn ml-2">
                <span class="fas fa-print"></span> Print
            </button>
            <button type="button" class="btn btn-info btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
            <a class="btn btn-secondary btn-sm float-right ml-2" asp-action="CustomerSales">
                <span class="fas fa-not-equal"></span> Cancel Compare
            </a>
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-6">
                <div class="card card-secondary">
                    <div class="card-header">
                        <span class="card-title">Customer Sales #1</span>
                        </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-sales1">
                            <thead>
                                <tr>
                                    <th>
                                        Customer
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Brand)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Amount)
                                    </th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th colspan="2" class="text-end">Total</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card card-secondary">
                    <div class="card-header">
                        <span class="card-title">Customer Sales #2</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-sales2">
                            <thead>
                                <tr>
                                    <th>
                                        Customer
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Brand)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Amount)
                                    </th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th colspan="2" class="text-end">Total</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-header">
                <h6 class="modal-title">Customer Sales #1</h6>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter1-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter1-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter1-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter1-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter1-brand" class="form-label mb-0">Brand</label>
                            <select id="filter1-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter1-brand-name" class="form-label mb-0">Brand Name</label>
                            <input type="text" id="filter1-brand-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter1-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter1-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter1-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter1-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-header">
                <h6 class="modal-title">Customer Sales #2</h6>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter2-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter2-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter2-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter2-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter2-brand" class="form-label mb-0">Brand</label>
                            <select id="filter2-brand" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter2-brand-name" class="form-label mb-0">Brand Name</label>
                            <input type="text" id="filter2-brand-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter2-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter2-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label for="filter2-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter2-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var date_today = new Date();
        var date_month_ago = new Date();
        date_month_ago.setMonth(date_month_ago.getMonth() - 1);

        SetDateFilter1();
        SetDateFilter2();
        function SetDateFilter1() {
            if ($("#filter1-to").val() == "") {
                if ($("#filter1-from").val() == "") {
                    $("#filter1-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter1-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter1-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter1-from").val() == "") {
                var dt_to = new Date($("#filter1-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter1-from").val(DateForInput(dt_to));
            }
        }

        function SetDateFilter2() {
            if ($("#filter2-to").val() == "") {
                if ($("#filter2-from").val() == "") {
                    $("#filter2-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter2-from").val());
                    //dt_from.setFullYear(dt_from.getFullYear() + 1);
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter2-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter2-from").val() == "") {
                var dt_to = new Date($("#filter2-to").val());
                //dt_to.setFullYear(dt_to.getFullYear() - 1);
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter2-from").val(DateForInput(dt_to));
            }
        }

        $("#filter1-to, #filter1-from").on("focusout", SetDateFilter1);
        $("#filter2-to, #filter2-from").on("focusout", SetDateFilter2);

        // Load Select2 for Brand Filter 1
        $("#filter1-brand").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Brand")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter1-brand").on("select2:select", function () {
            $("#filter1-brand-name").val($(this).select2("data")[0].name);
        });

        $("#filter1-brand").on("select2:unselecting", function (e) {
            $("#filter1-brand-name").val("");
        });

        // Load Select2 for Brand Filter 2
        $("#filter2-brand").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Brand")"
            },
            dropdownParent: $('#filterModal')
        });

        $("#filter2-brand").on("select2:select", function () {
            $("#filter2-brand-name").val($(this).select2("data")[0].name);
        });

        $("#filter2-brand").on("select2:unselecting", function (e) {
            $("#filter2-brand-name").val("");
        });

        // Load Select2 for Customer Filter 1
        $("#filter1-customer").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter1-customer").on("select2:select", function () {
            $("#filter1-customer-name").val($(this).select2("data")[0].name);
        });

        $("#filter1-customer").on("select2:unselecting", function (e) {
            $("#filter1-customer-name").val("");
        });

        // Load Select2 for Customer Filter 2
        $("#filter2-customer").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter2-customer").on("select2:select", function () {
            $("#filter2-customer-name").val($(this).select2("data")[0].name);
        });

        $("#filter2-customer").on("select2:unselecting", function (e) {
            $("#filter2-customer-name").val("");
        });
        
        var dt_storage1 = "BAS_DT" + window.location.pathname.replace(/\//g, "_") + "_1";
        var dt_storage2 = "BAS_DT" + window.location.pathname.replace(/\//g, "_") + "_2";
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            salesDT1.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage1);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                salesDT2.ajax.reload(() => {
                    var saved = localStorage.getItem(dt_storage2);
                    if (saved) {
                        var parsed = JSON.parse(saved);
                        var expiry = parsed.timestamp + dt_duration;
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                    }
                    checkDefaultFilter();
                });
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            salesDT1.ajax.reload(() => {
                salesDT2.ajax.reload(() => {
                    checkDefaultFilter();
                });
            });
        }

        function createDefaultTableState() {
            return {
                order: [[0, "asc"]],
                page: 0,
                length: 10,
                search: { search: "" },
                BrandId: "",
                BrandCode: "",
                Brand: "",
                CustomerId: "",
                CustomerCode: "",
                Customer: "",
                DateFrom: DateForInput(date_month_ago),
                DateTo: DateForInput(date_today)
            };
        }

        var defaultDTState = {
            table1: createDefaultTableState(),
            table2: createDefaultTableState()
        };

        function hasTableChanged(dt, defaults, prefix) {
            return (
                JSON.stringify(dt.order()) !== JSON.stringify(defaults.order) ||
                dt.page.info().start !== defaults.page ||
                dt.page.len() !== defaults.length ||
                (dt.search() || "") !== defaults.search.search ||
                $(`#filter${prefix}-brand`).val() !== defaults.BrandId ||
                $(`#filter${prefix}-customer`).val() !== defaults.CustomerId ||
                $(`#filter${prefix}-from`).val() !== defaults.DateFrom ||
                $(`#filter${prefix}-to`).val() !== defaults.DateTo
            );
        }
        

        function checkDTChanged() {
            if(!salesDT1 && !salesDT2) return false;
            
            return hasTableChanged(salesDT1, defaultDTState.table1, 1) ||
                   hasTableChanged(salesDT2, defaultDTState.table2, 2);
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function setDefaultDTFilter(dt, defaults, prefix) {
            $(`#filter${prefix}-brand`).val(defaults.BrandId).trigger('change');
            $(`#filter${prefix}-brand-name`).val(defaults.Brand);
            $(`#filter${prefix}-customer`).val(defaults.CustomerId).trigger('change');
            $(`#filter${prefix}-customer-name`).val(defaults.Customer);
            $(`#filter${prefix}-from`).val(defaults.DateFrom);
            $(`#filter${prefix}-to`).val(defaults.DateTo);
            
            localStorage.removeItem(dt_storage1);
            localStorage.removeItem(dt_storage2);

            if (dt) {
                dt.state.clear();
                dt.order(defaults.order);
                dt.page(defaults.page);
                dt.search(defaults.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        function resetToDefaultDTFilter() {
            setDefaultDTFilter(salesDT1, defaultDTState.table1, 1);
            setDefaultDTFilter(salesDT2, defaultDTState.table2, 2);
        }

        // Load List 1 on DataTable
        var salesDT1 = $('.table-sales1').on('preXhr.dt', function (e, settings, data) {
            //showBatchLoader("sales1");
        }).DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage1, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved1 = localStorage.getItem(dt_storage1);
                const saved2 = localStorage.getItem(dt_storage2);
                if (saved1 || saved2) {
                    var age1 = dt_duration, age2 = dt_duration;
                    var expiry1 = 0, expiry2 = 0;
                    if (saved1) {
                        var parsed = JSON.parse(saved1);
                        var age1 = new Date().getTime() - parsed.timestamp;
                        var expiry1 = parsed.timestamp + dt_duration;
                    }
                    if (saved2) {
                        var parsed = JSON.parse(saved2);
                        var age2 = new Date().getTime() - parsed.timestamp;
                        var expiry2 = parsed.timestamp + dt_duration;
                    }

                    if (age1 < dt_duration || age2 < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry1 == 0 ? expiry2 : expiry1)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.BrandId = $('#filter1-brand').val();
                data.BrandCode = $('#filter1-brand option:selected').text();
                data.Brand = $('#filter1-brand-name').val();
                data.CustomerId = $('#filter1-customer').val();
                data.CustomerCode = $('#filter1-customer option:selected').text();
                data.Customer = $('#filter1-customer-name').val();
                data.DateFrom = $('#filter1-from').val();
                data.DateTo = $('#filter1-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.BrandId) {
                    var brandOption = new Option(data.BrandCode, data.BrandId, true, true);
                    $(brandOption).data('data', {
                        id: data.BrandId,
                        text: data.BrandCode,
                        name: data.Brand
                    });
                    $("#filter1-brand").append(brandOption).trigger('change');
                    $("#filter1-brand-name").val(data.Brand);
                }
                if(data.CustomerId) {
                    var customerOption = new Option(data.CustomerCode, data.CustomerId, true, true);
                    $(customerOption).data('data', {
                        id: data.CustomerId,
                        text: data.CustomerCode,
                        name: data.Customer
                    });
                    $("#filter1-customer").append(customerOption).trigger('change');
                    $("#filter1-customer-name").val(data.Customer);
                }
                $('#filter1-from').val(data.DateFrom);
                $('#filter1-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetCustomerSalesDT")",
                type: "POST",
                data: function (data) {
                    var brandId = $("#filter1-brand").val();
                    var customerId = $("#filter1-customer").val();

                    data.DateFrom = $("#filter1-from").val();
                    data.DateTo = $("#filter1-to").val();
                    if (brandId) data.Brand = brandId;
                    if (customerId) data.Customer = customerId;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "customerCode", name: "CustomerCode" },
                { data: "brand", name: "Brand" },
                { data: "amount", name: "Amount", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = salesDT1.ajax.json();
                var api = this.api(), data;

                $(api.column(2).footer()).html(FormatStringDecimal(json.totalAmount));
            },
            order: defaultDTState.table1.order
        });

        // Load functions upon DataTable load
        salesDT1.on("draw", function () {
            //hideBatchLoader("sales1");
            checkDefaultFilter();

            //$(".table-sales1 thead th").removeClass("text-end");
        });

        // Load List 2 on DataTable
        var salesDT2 = $('.table-sales2').on('preXhr.dt', function (e, settings, data) {
            //showBatchLoader("sales2");
        }).DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage2, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved1 = localStorage.getItem(dt_storage1);
                const saved2 = localStorage.getItem(dt_storage2);
                if (saved1 || saved2) {
                    var duration = 3600000; // 1 hour
                    var age1 = duration, age2 = duration;
                    var expiry1 = 0, expiry2 = 0;
                    if (saved1) {
                        var parsed = JSON.parse(saved1);
                        var age1 = new Date().getTime() - parsed.timestamp;
                        var expiry1 = parsed.timestamp + duration;
                    }
                    if (saved2) {
                        var parsed = JSON.parse(saved2);
                        var age2 = new Date().getTime() - parsed.timestamp;
                        var expiry2 = parsed.timestamp + duration;
                    }

                    if (age1 < duration || age2 < duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry1 == 0 ? expiry2 : expiry1)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.BrandId = $('#filter2-brand').val();
                data.BrandCode = $('#filter2-brand option:selected').text();
                data.Brand = $('#filter2-brand-name').val();
                data.CustomerId = $('#filter2-customer').val();
                data.CustomerCode = $('#filter2-customer option:selected').text();
                data.Customer = $('#filter2-customer-name').val();
                data.DateFrom = $('#filter2-from').val();
                data.DateTo = $('#filter2-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.BrandId) {
                    var brandOption = new Option(data.BrandCode, data.BrandId, true, true);
                    $(brandOption).data('data', {
                        id: data.BrandId,
                        text: data.BrandCode,
                        name: data.Brand
                    });
                    $("#filter2-brand").append(brandOption).trigger('change');
                    $("#filter2-brand-name").val(data.Brand);
                }
                if(data.CustomerId) {
                    var customerOption = new Option(data.CustomerCode, data.CustomerId, true, true);
                    $(customerOption).data('data', {
                        id: data.CustomerId,
                        text: data.CustomerCode,
                        name: data.Customer
                    });
                    $("#filter2-customer").append(customerOption).trigger('change');
                    $("#filter2-customer-name").val(data.Customer);
                }
                $('#filter2-from').val(data.DateFrom);
                $('#filter2-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetCustomerSalesDT")",
                type: "POST",
                data: function (data) {
                    var brandId = $("#filter2-brand").val();
                    var customerId = $("#filter2-customer").val();

                    data.DateFrom = $("#filter2-from").val();
                    data.DateTo = $("#filter2-to").val();
                    if (brandId) data.Brand = brandId;
                    if (customerId) data.Customer = customerId;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "customerCode", name: "CustomerCode" },
                { data: "brand", name: "Brand" },
                { data: "amount", name: "Amount", className: "text-end" }
            ],
            footerCallback: function (row, data, start, end, display) {
                var json = salesDT2.ajax.json();
                var api = this.api(), data;

                $(api.column(2).footer()).html(FormatStringDecimal(json.totalAmount));
            },
            order: defaultDTState.table2.order
        });

        // Load functions upon DataTable load
        salesDT2.on("draw", function () {
            //hideBatchLoader("sales2");
            checkDefaultFilter();

            //$(".table-sales1 thead th").removeClass("text-end");
        });

        $(".btnFilter").on("click", function () {
            salesDT1.ajax.reload();
            salesDT2.ajax.reload();
            $("#filterModal").modal("hide");
        });

        function urlQuery() {
            var urlQuery = [];
            urlQuery.push("filter1.DateFrom=" + $("#filter1-from").val());
            urlQuery.push("filter2.DateFrom=" + $("#filter2-from").val());
            urlQuery.push("filter1.DateTo=" + $("#filter1-to").val());
            urlQuery.push("filter2.DateTo=" + $("#filter2-to").val());
            if ($("#filter1-brand").val()) { urlQuery.push("filter1.Brand=" + $("#filter1-brand").val()); }
            if ($("#filter2-brand").val()) { urlQuery.push("filter2.Brand=" + $("#filter2-brand").val()); }
            if ($("#filter1-customer").val()) { urlQuery.push("filter1.Customer=" + $("#filter1-customer").val()); }
            if ($("#filter2-customer").val()) { urlQuery.push("filter2.Customer=" + $("#filter2-customer").val()); }
            return urlQuery;
        }

        $(".downloadBtn").click(function (e) {
            window.location = "@Url.Action("DownloadCustomerSalesCompare")?" + urlQuery().join("&");
        });

        $(".printBtn").on("click", function () {
            $.LoadingOverlay("show", {
                image: "",
                fontawesome: "fas fa-print"
            });
            setTimeout(function () {
                let win = window.open('@Url.Action("PrintCustomerSalesCompare")?' + urlQuery().join("&"), '');
                var wintimer = setInterval(function () {
                    if (win.closed) {
                        clearInterval(wintimer);
                        hideLoader();
                    }
                }, 100);
            }, 500);
        });
    </script>
    }