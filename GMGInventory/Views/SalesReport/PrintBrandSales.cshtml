@model BrandSalesPVM

@{
    Layout = "";
    var title = "Brand Sales";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Agent</strong>
        <span>@Model.Agent</span>
        <br />
        <strong>Brand</strong>
        <span>@Model.Brand</span>
        <br />
        <strong>Date From</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Date To</strong>
        <span>@Model.DateTo</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Brand)
                </th>
                @*<th>
                    @Html.DisplayNameFor(model => model.Contents.First().AgentCode)
                </th>*@
                <th>
                    @*@Html.DisplayNameFor(model => model.Contents.First().AgentName)*@
                    Agent
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Amount)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Contents)
            {
                <tr>
                    <td><nobr>@item.Brand</nobr></td>
                    @*<td>@item.AgentCode</td>*@
                    <td>@item.AgentName</td>
                    <td class="right-text"><nobr>@item.Amount</nobr></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalAmount</nobr></th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>