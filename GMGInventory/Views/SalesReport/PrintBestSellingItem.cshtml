@model BestSellingItemPVM

@{
    Layout = "";
    var title = "Best Selling Item (" + Model.Basis + ")";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Basis</strong>
        <span>@Model.Basis</span>
        <br />
        <strong>Brand</strong>
        <span>@Model.Brand</span>
        <br />
        <strong>Date From</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Date To</strong>
        <span>@Model.DateTo</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Brand)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().ItemCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().ItemName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().PartNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Unit)
                </th>
                @if (Model.Basis == "Quantity")
                {
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().Quantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().CurrentQuantity)
                    </th>
                }
                else
                {
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().UnitPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Contents.First().Amount)
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Contents)
            {
                <tr>
                    <td><nobr>@item.Brand</nobr></td>
                    <td>@item.ItemCode</td>
                    <td>@item.PartNumber</td>
                    <td>@item.ItemName</td>
                    <td><nobr>@item.Unit</nobr></td>
                    @if (Model.Basis == "Quantity")
                    {
                        <td class="right-text"><nobr>@item.Quantity</nobr></td>
                        <td class="right-text"><nobr>@item.CurrentQuantity</nobr></td>
                    }
                    else
                    {
                        <td class="right-text"><nobr>@item.UnitPrice</nobr></td>
                        <td class="right-text"><nobr>@item.Amount</nobr></td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="5" class="right-text">Total</th>
                @if (Model.Basis == "Quantity")
                {
                    <th class="right-text"><nobr>@Model.TotalQuantity</nobr></th>
                    <th class="right-text"><nobr>@Model.TotalCurrentQuantity</nobr></th>
                }
                else
                {
                    <th class="right-text"><nobr>@Model.TotalUnitPrice</nobr></th>
                    <th class="right-text"><nobr>@Model.TotalAmount</nobr></th>
                }
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100); 
    };
</script>
</html>