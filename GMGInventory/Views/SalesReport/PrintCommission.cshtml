@model CommissionPVM

@{
    Layout = "";
    var title = "Commission";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <p>
        <strong>Agent</strong>
        <span>@Model.Agent</span>
        <br />
        <strong>Area</strong>
        <span>@Model.Area</span>
        <br />
        <strong>Customer</strong>
        <span>@Model.Customer</span>
        <br />
        <strong>Date From</strong>
        <span>@Model.DateFrom</span>
        <br />
        <strong>Date To</strong>
        <span>@Model.DateTo</span>
    </p>
    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().InvoiceDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().InvoiceNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Customer)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().Agent)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().CommissionRate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().InvoiceAmount)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Contents.First().CommissionAmount)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Contents)
            {
                <tr>
                    <td><nobr>@item.InvoiceDate</nobr></td>
                    <td>@item.InvoiceNumber</td>
                    <td>@item.Customer</td>
                    <td>@item.Agent</td>
                    <td class="right-text"><nobr>@item.CommissionRate</nobr></td>
                    <td class="right-text"><nobr>@item.InvoiceAmount</nobr></td>
                    <td class="right-text"><nobr>@item.CommissionAmount</nobr></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="5" class="right-text">Total</th>
                <th class="right-text"><nobr>@Model.TotalInvoiceAmount</nobr></th>
                <th class="right-text"><nobr>@Model.TotalCommissionAmount</nobr></th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = window.close;
</script>
</html>