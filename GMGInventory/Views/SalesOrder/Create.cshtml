                    $(this).find("input").first().css({
                        'border-top-left-radius': '0.25rem',
                        'border-bottom-left-radius': '0.25rem'
                    });
                }
            });

            $(".discount-form-display").off("focusin").on("focusin", function() {
                $(this).siblings("label").hide();
                $(this).siblings('label[for="' + this.id + '"]').show();
                $(this).css('width', '100px');

                var firstInputRadius = $(this).siblings("label").first().is(':hidden') ? '0.25rem' : '';
                $(this).closest('.input-group').find('input').first().css({
                    'border-top-left-radius': firstInputRadius,
                    'border-bottom-left-radius': firstInputRadius
                });
            });

            $(".discount-form-display").off("focusout").on("focusout", function() {
                if($(this).val() == "") $(this).val(0);
                $(this).siblings("label").hide();
                $(this).css('width', '');

                var firstInputRadius = $(this).siblings("label").first().is(':hidden') ? '0.25rem' : '';
                $(this).closest('.input-group').find('input').first().css({
                    'border-top-left-radius': firstInputRadius,
                    'border-bottom-left-radius': firstInputRadius
                });
            });
        });

