                //var row_unitprice = row_data.unitPrice;
                var row_unitprice = parseFloat($(this.node()).find(".unitprice").val());
                var row_discount1 = parseFloat($(this.node()).find(".discount1").val());
                var row_discount2 = parseFloat($(this.node()).find(".discount2").val());
                var row_discount3 = parseFloat($(this.node()).find(".discount3").val());
                var row_discount4 = parseFloat($(this.node()).find(".discount4").val());
                var row_discount5 = parseFloat($(this.node()).find(".discount5").val());
                
                item_to_order.push({
                    lineNumber: row_data.lineNumber,
                    item: row_data.id,
                    quantity: row_quantity,
                    unitPrice: row_unitprice,
                    discount1: row_discount1,
                    discount2: row_discount2,
                    discount3: row_discount3,
                    discount4: row_discount4,
                    discount5: row_discount5,
                    customerBrandDiscountId: row_data.customerBrandDiscountId,
                    itemPromoId: row_data.itemPromoId
                });
            });
            return item_to_order;
        }

        $("#form-order button[type=submit]").on("click", function () {
            $("#action-type").val($(this).data("action"));
        });

        // Validation for Create
        var validateCreate = $("#form-order").validate({
            rules: {
                CustomerCode: { required: true },
                AgentCode: { required: true },
                OrderDate: { required: true },
                DeliveryDate: { required: true, greaterThanOrEqualDate: "#order-date" },
                Remarks: { maxlength: 500 },
                Instruction: { maxlength: 250 },
                SLA: { required: true }
            },
            messages: {
                CustomerCode: { required: "Please select customer" },
                AgentCode: { required: "Please select agent" },
                OrderDate: { required: "Please select date of order" },
                DeliveryDate: {
                    required: "Please select date of delivery",
                    greaterThanOrEqualDate: "Required delivery date must be on or after the order date"
                },
                Remarks: { maxlength: "Remarks must not exceed 500 characters." },
                Instruction: { maxlength: "Remarks must not exceed 250 characters." },
                SLA: { required: "Please select sla" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveOrder();
            }
        });

        function SaveOrder() {
            var itemsToOrder = GetItemsToOrder();
            var total_gross_price = 0
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_gross_price += parseFloat($(this.node()).find(".grossprice").html().replace(",", ""));
            });
            if (itemsToOrder.length == 0) {
                toastr.warning("No item to order. Add an item to the list to continue", "Warning");
            } else if (total_gross_price < parseFloat($("#order-discount").val())) {
                toastr.warning("Overall discount cannot be higher than total extended price", "Warning");
            } else if (itemsToOrder.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't order an item with 0 quantity", "Warning");
                // } else if ($("#order-customer-code").select2("data")[0].outstandingBalanceD > 0) {
                //     swal({
                //         title: "Customer's Outstanding Balance",
                //         text: "(" + $("#order-customer-code").select2("data")[0].text.trim() + ") " + $("#order-customer-code").select2("data")[0].name.trim() + " has an outstanding balance of " + $("#order-customer-code").select2("data")[0].outstandingBalance + ". Are you sure you want to continue submitting it?",
                //         icon: "info",
                //         buttons: {
                //             cancel: "No",
                //             continue: "Yes"
                //         },
                //         infoMode: true
                //     }).then((value) => {
                //         if (value == "continue") {
                //             DoSave();
                //         }
                //     });
                // } else {
                //     DoSave();
                // }
            } else {
                var customerStatus = $("#order-customer-code").select2("data")[0].customerStatus.trim().toLowerCase();
                if (customerStatus == "red flag" || customerStatus == "hold") {
                    swal({
                        title: "Customer's Status",
                        text: "Can't proceed because the customer is in \"" + customerStatus + "\" status",
                        icon: "warning",
                        dangerMode: true
                    });
                } else if (customerStatus == "watch list") {
                    swal({
                        title: "Customer's Status",
                        text: "Customer is currently on watch list. Do you want to continue?",
                        icon: "info",
                        buttons: {
                            cancel: "No",
                            continue: "Yes"
                        },
                        infoMode: true
                    }).then((value) => {
                        if (value == "continue") {
                            DoSave();
                        }
                    });
                } else {
                    DoSave();
                }
            }
        }

        function DoSave() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("SaveJson")",
                data: {
                    Customer: $("#order-customer-code").val(),
                    Region: $("#order-region").val(),
                    Forwarder: $("#order-forwarder").val(),
                    Agent: $("#order-agent-code").val(),
                    PurchaseOrder: $("#order-purchase-number").val(),
                    DeclaredValue: $("#order-declared-value").val(),
                    OrderDate: $("#order-date").val(),
                    Remarks: $("#order-remarks").val(),
                    Status: $("#action-type").val(),
                    DeliveryDate: $("#order-delivery-date").val(),
                    SericeLevelAgreement: $("#order-sla").val(),
                    OverallDiscount: $("#order-discount").val(),
                    WithLP: $("#order-with-lp").val(),
                    WithREYCONonDefective: $("#order-with-nondefect").val(),
                    WithREYCOJITLPDelivery: $("#order-with-jitlpdelivery").val(),
                    SpecialInstruction: $("#order-instruction").val(),
                    Items: GetItemsToOrder(),
                    ResubmitId: "@(TempData["SalesOrderId"])"
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        //toastr.success(data.message, "Success");
                        //toastr.warning("Page will redirect to details", 'Page Redirect', {
                        //    timeOut: 3000,
                        //    onHidden: function () {
                        window.location = "@Url.Action("Details")/" + data.newRow;
                        //    },
                        //    progressBar: true
                        //});
                    }
                }
            });
        }
    </script>
}
