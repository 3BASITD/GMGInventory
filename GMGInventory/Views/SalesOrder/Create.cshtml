        function GetBrandDiscount(brandId) {
            var custId = currentCustomer;
            if (!custId) return;
            var brandDiscountId = 0;

            $.ajax({
                url: "@Url.Action("GetBrandDiscount")",
                type: "POST",
                data: { customerId: custId, brandId: brandId }, // This sends id as a query parameter
                success: function (data) {
                    if(Object.keys(data).length == 0){
                        $("#add-discount1").val("0.00");
                        $('#add-discount1').prop('readonly', false);
                        $('.discount1-info').addClass('d-none');
                    } else{
                        $("#add-discount1").val(Round2Decimal(data[0].discount));
                        $("#add-discount-id").val(data[0].id);

                        $('#add-discount1').prop('readonly', true);
                        $('.discount1-info').removeClass('d-none');
                        
                        brandDiscountId = data[0].id;

                        if( user_access_special.canEdit || brandDiscountId == 0 || brandDiscountId == null )
                        {
                            $('#add-discount1').prop('readonly', false);
                            $('.discount1-info').addClass('d-none');
                        }

                        var quantity = parseFloat($("#add-quantity").val());
                        var unit_price = parseFloat($("#add-unit-price").val());
                        var discount1 = parseFloat($("#add-discount1").val());
                        var discount2 = parseFloat($("#add-discount2").val());
                        var discount3 = parseFloat($("#add-discount3").val());
                        var discount4 = parseFloat($("#add-discount4").val());
                        var discount5 = parseFloat($("#add-discount5").val());

                        var grossprice = quantity * unit_price;
                        var discounted1 = grossprice * (100 - discount1) / 100;
                        var discounted2 = discounted1 * (100 - discount2) / 100;
                        var discounted3 = discounted2 * (100 - discount3) / 100;
                        var discounted4 = discounted3 * (100 - discount4) / 100;
                        var discounted5 = discounted4 * (100 - discount5) / 100;
                        $("#add-gross-price").val(Round2Decimal(discounted5));
                    }
                }
            });
        }



        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.id == $("#add-code").select2("data")[0].id) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastr.warning($("#add-code").select2("data")[0].text + " has already been added", "Duplicate");
            } else {
                itemDT.row.add({
                    id: $("#add-code").select2("data")[0].id,
                    lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                    code: $("#add-code").select2("data")[0].text,
                    name: $("#add-code").select2("data")[0].name + ($("#add-code").select2("data")[0].itemPromoName == "" ? "": " ("+$("#add-code").select2("data")[0].itemPromoName+")" ),
