@{
    if (TempData["SalesOrderId"] != null)
    {
        ViewData["Title"] = "Resubmit Sales Order";
    }
    else
    {
        ViewData["Title"] = "New Sales Order";
    }
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;

    var userAccessSpecial = (ViewsAccessVM)ViewData["UserAccessSpecial"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesOrder" asp-action="Index">Sales Orders</a></li>
}

<div class="card card-default">
    <form id="form-order">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                    <span class="fas fa-save"></span> Save as Draft
                </button>
                <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submit">
                    <span class="fas fa-save"></span> @(TempData["SalesOrderId"] != null ? "Resubmit" : "Submit")
                </button>
                <input type="hidden" id="action-type" name="ActionType" value="">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="order-purchase-number" class="form-label mb-0">Purchase Order Number</label>
                        <input type="text" id="order-purchase-number" name="PurchaseNumber" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">
                        <label for="order-region" class="form-label mb-0">Region</label>
                        <select id="order-region" style="width: 100%"></select>
                    </div>
                    <div class="form-group">
                        <label for="order-forwarder" class="form-label mb-0">Forwarder</label>
                        <select id="order-forwarder" style="width: 100%"></select>
                    </div>
                    <div class="form-group">
                        <label for="order-date" class="form-label mb-0">Sales Order Date</label>
                        <input type="date" id="order-date" name="OrderDate" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">
                        <label for="order-delivery-date" class="form-label mb-0">Required Delivery Date</label>
                        <input type="date" id="order-delivery-date" name="DeliveryDate" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">
                        <label for="order-sla" class="form-label mb-0">Service Level Agreement</label>
                        <select id="order-sla" name="SLA" style="width: 100%"></select>
                    </div>
                </div>
                <div class="col-12 col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="order-agent-code" class="form-label mb-0">Agent Code</label>
                        <select id="order-agent-code" name="AgentCode" style="width: 100%"></select>
                    </div>
                    <div class="form-group">
                        <label for="order-agent-name" class="form-label mb-0">Agent Name</label>
                        <input type="text" id="order-agent-name" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                    <div class="form-group">
                        <label for="order-customer-code" class="form-label mb-0">Customer Code</label>
                        <select id="order-customer-code" name="CustomerCode" style="width: 100%"></select>
                    </div>
                    <div class="form-group">
                        <label for="order-customer-name" class="form-label mb-0">Customer Name</label>
                        <input type="text" id="order-customer-name" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                    <div class="form-group">
                        <label for="order-customer-address" class="form-label mb-0">Customer Address</label>
                        <input type="text" id="order-customer-address" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                    <div class="form-group">
                        <label for="order-customer-balance" class="form-label mb-0">Customer Outstanding Balance</label>
                        <input type="text" id="order-customer-balance" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="order-credit-limit" class="form-label mb-0">Customer Credit Limit</label>
                        <input type="text" id="order-credit-limit" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                    <div class="form-group">
                        <label for="order-credit-term" class="form-label mb-0">Customer Credit Term</label>
                        <input type="text" id="order-credit-term" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                    <div class="form-group">
                        <label for="order-customer-status" class="form-label mb-0">Customer Account Status</label>
                        <input type="text" id="order-customer-status" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                    <div class="form-group">
                        <label for="order-customer-priority" class="form-label mb-0">Customer Priority</label>
                        <input type="text" id="order-customer-priority" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                    <div class="form-group">
                        <label for="order-customer-branch" class="form-label mb-0">Customer Branch</label>
                        <input type="text" id="order-customer-branch" class="form-control form-control-sm" readonly="readonly" />
                    </div>
                </div>
                <div class="col-12 col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="order-discount" class="form-label mb-0">Overall Discount</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">PHP</span>
                            <input type="number" value="0" step="0.01" min="0" id="order-discount" name="Discount" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="order-with-lp" class="form-label mb-0">With L/P</label>
                        <select id="order-with-lp" class="form-select form-select-sm">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="order-with-nondefect" class="form-label mb-0">With REYCO Non-Defective</label>
                        <select id="order-with-nondefect" class="form-select form-select-sm">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="order-with-jitlpdelivery" class="form-label mb-0">With REYCO JIT L/P Delivery</label>
                        <select id="order-with-jitlpdelivery" style="width: 100%"></select>
                    </div>
                    <div class="form-group">
                        <label for="order-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="order-remarks" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group">
                        <label for="order-instruction" class="form-label mb-0">Special Instruction</label>
                        <input type="text" id="order-instruction" name="Instruction" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Sales Order Item(s)</span>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2">
                                    <span class="fas fa-plus"></span> Add Sales Order Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Inventory Count</th>
                                        <th>Allocated Quantity</th>
                                        <th>Unit Price</th>
                                        <th>Discount</th>
                                        <th>Extended Price</th> <!-- mas ok sana sabihing Gross Price kaso ayaw nila -->
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="2" class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th colspan="7"></th>
                                        <th class="total-gross-price">0.00</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Save Order Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Sales Order Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Code</label>
                                <select id="add-code" name="Code" style="width: 100%;">
                                    <option></option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Name</label>
                                <input type="text" id="add-name" name="Name" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                <span class="text-xs text-muted">Items in Inventory: <strong class="add-inventory"></strong></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-allocated-quantity" class="form-label mb-0">Allocated Quantity</label>
                                <input type="text" id="add-allocated-quantity" name="AllocatedQuantity" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit-price" class="form-label mb-0">Unit Price <span class="add-price-source"></span></label>
                                <input type="number" step="0.01" min="0.00" max="1999999.99" id="add-unit-price" name="UnitPrice" class="form-control form-control-sm" />
                                @*<input type="text" id="add-unit-price" name="UnitPrice" class="form-control form-control-sm" readonly="readonly" />*@
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount1" class="form-label mb-0">
                                    Discount 1
                                    <span class="discount1-info text-info d-none" data-microtip-title="Customer auto-brand discount. Sales Order (Special) Edit access is required to allow updating of discount 1" data-microtip-position="right" role="tooltip">
                                        <span class="fas fa-info-circle"></span>
                                    </span>
                                </label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount1" name="Discount1" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount2" class="form-label mb-0">Discount 2</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount2" name="Discount2" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount3" class="form-label mb-0">Discount 3</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount3" name="Discount3" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount4" class="form-label mb-0">Discount 4</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount4" name="Discount4" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount5" class="form-label mb-0">Discount 5</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount5" name="Discount5" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-gross-price" class="form-label mb-0">Extended Price</label>
                                <input type="number" id="add-gross-price" name="ExtendedPrice" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="hidden" id="add-discount-id" name="BrandDiscountId" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SalesOrderId"] != null)
    {
        <input type="hidden" id="resubmitSOId" value="@TempData["SalesOrderId"]" />
    }
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        var user_access_special = @Html.Raw(Json.Serialize(userAccessSpecial));

        var currentCustomer = null;

        // Load agent data for select2
        $("#order-agent-code").select2({
            //minimumInputLength: 1,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Agent")"
            }
        });

        $("#order-agent-code").on("select2:select", function () {
            $("#order-agent-name").val($(this).select2("data")[0].name);
            // $("#order-customer-code").val(null).trigger("change");
            // $("#order-customer-name").val("");
            // $("#order-customer-address").val("");
            // $("#order-customer-balance").val("");
            // $("#order-credit-term").val("");
            // $("#order-region").val("");
            // $("#order-customer-status").val("");
        });

        // Load customer data for select2
        $("#order-customer-code").select2({
            //minimumInputLength: 1,
            placeholder: '<empty>',
            language: {
                noResults: function () {
                    return "No customers found for selected Agent";
                }
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + 
                         (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : "") +
                         (repo.disabledReason ? "<br /><small class='text-danger'>" + repo.disabledReason + "</small>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetByAgentOptions", "Customer")",
                data: function (params) {
                    let base = $.fn.select2.defaults.defaults.ajax.data(params);
                    return Object.assign(base, {
                        agent: $("#order-agent-code").val()
                    });
                }
            }
        });

        // Load service level agreement data for select2
        $("#order-sla").select2({
            minimumResultsForSearch: -1,
            placeholder: '<empty>',
            ajax: {
                url: "@Url.Action("GetOptions2", "ServiceLevelAgreement")"
            }
        });

        // Load service level agreement data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "DeliveryTime")",
            data: { selectedId: null },
            success: function (data, status, xhr) {
                $("#order-with-jitlpdelivery").select2({
                    minimumResultsForSearch: -1,
                    ajax: null,
                    data: data,
                    placeholder: {
                        id: "",
                        text: "<empty>"
                    }
                });
            }
        });

        $("#order-customer-code").on("select2:select", function () {
            changingCustomerOrDateOrder();
        });

        $("#order-date").on("change", function() {
            changingCustomerOrDateOrder();
        });

        var currentCustomer = "";
        var currentDateOrder = DateForInput(new Date());
        function changingCustomerOrDateOrder() {
            var selectedCustomer = $("#order-customer-code").val() || "";
            var selectedDateOrder = $("#order-date").val() || "";

            if (itemDT.data().length > 0 && (selectedCustomer != currentCustomer || selectedDateOrder != currentDateOrder)) {
                var changed = selectedCustomer != currentCustomer ? "Customer Code"
                            : selectedDateOrder != currentDateOrder ? "Sales Order Date"
                            : "Customer Code / Sales Order Date";
                swal({
                    title: "Sales Order Items not empty",
                    text: "Changing the selected " + changed + " will clear the added items. Do you want to continue?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        swal.close();
                        itemDT.clear().draw();
                        clearItemForm();
                        
                        if (selectedCustomer != currentCustomer) {
                            currentCustomer = selectedCustomer;
                            LoadCustomerDetails();
                        }
                        if (selectedDateOrder != currentDateOrder) {
                            currentDateOrder = selectedDateOrder;
                        }
                    } else {
                        $("#order-customer-code").val(currentCustomer).trigger("change");
                        $("#order-date").val(currentDateOrder);
                    }
                });
            } else {
                if (selectedCustomer != currentCustomer) {
                    currentCustomer = selectedCustomer;
                    LoadCustomerDetails();
                }
                if (selectedDateOrder != currentDateOrder) {
                    currentDateOrder = selectedDateOrder;
                }
            }
        }

        function LoadCustomerDetails() {
            $("#order-customer-name").val($("#order-customer-code").select2("data")[0].name);
            $("#order-customer-address").val($("#order-customer-code").select2("data")[0].address);
            //$("#order-customer-balance").val($("#order-customer-code").select2("data")[0].outstandingBalance);
            $("#order-credit-limit").val($("#order-customer-code").select2("data")[0].creditLimit);
            $("#order-credit-term").val($("#order-customer-code").select2("data")[0].creditTerm);
            //$("#order-region").val($("#order-customer-code").select2("data")[0].region);
            $("#order-customer-status").val($("#order-customer-code").select2("data")[0].customerStatus);
            $("#order-customer-priority").val($("#order-customer-code").select2("data")[0].priority);
            $("#order-customer-branch").val($("#order-customer-code").select2("data")[0].branch);

            // if (parseFloat($("#order-customer-code").select2("data")[0].outstandingBalanceD) > 0) {
            //     toastr.warning("(" + $("#order-customer-code").select2("data")[0].text.trim() + ") " + $("#order-customer-code").select2("data")[0].name.trim() + " has an outstanding balance of " + $("#order-customer-code").select2("data")[0].outstandingBalance, "Outstanding Balance");
            // }
            
             var regionId = $("#order-customer-code").select2("data")[0].regionId;
            // var regionCode = $("#order-customer-code").select2("data")[0].regionCode;
            // var regionName = $("#order-customer-code").select2("data")[0].region;
            // var regionOption = new Option(regionCode, regionId, true, true);
            // $(regionOption).data('data', {
            //     id: regionId,
            //     text: regionCode,
            //     name: regionName
            // });
            // $("#order-region").append(regionOption).trigger("change");
            $("#order-region").val(regionId).trigger("change");

            if ($("#order-agent-code").val() == null) {
                var agentId = $("#order-customer-code").select2("data")[0].agentId;
                var agentCode = $("#order-customer-code").select2("data")[0].agentCode;
                var agentName = $("#order-customer-code").select2("data")[0].agent;
                var agentOption = new Option(agentCode, agentId, true, true);
                $(agentOption).data('data', {
                    id: agentId,
                    text: agentCode,
                    name: agentName
                });
                $("#order-agent-code").append(agentOption).trigger("change");
                $("#order-agent-name").val(agentName);
            }
            
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOutstandingBalance", "Customer")",
                data: { customerId: $("#order-customer-code").select2("data")[0].id },
                success: function (data, status, xhr) {
                    var balance = parseFloat(data);
                    $("#order-customer-balance").val(FormatStringInteger(balance));

                    if (balance > 0) {
                        toastr.warning("(" + $("#order-customer-code").select2("data")[0].text.trim() + ") " + $("#order-customer-code").select2("data")[0].name.trim() + " has an outstanding balance of " + FormatStringInteger(balance), "Outstanding Balance");
                    }
                }
            });
        }

        // Load region data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function (data, status, xhr) {
                $("#order-region").select2({
                    minimumResultsForSearch: -1,
                    ajax: null, //already fetched outside
                    data: data,
                    //minimumResultsForSearch: Infinity
                });
            }
        });

        // Load forwarder data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Forwarder")",
            success: function (data, status, xhr) {
                $("#order-forwarder").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    //minimumResultsForSearch: Infinity
                });
            }
        });

        // Load item for select2
        $("#add-code").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ?  "<em class='fw-light'> - " + repo.name + (repo.itemPromoName == "" ? "" : " ("+repo.itemPromoName+")") + "</em>"
                        : "") +
                    "<br />" +
                    "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptionsPromo", "Item")",
                data: function(params){
                    var query = {
                        search : params.term,
                        page : params.page,
                        orderDate : $("#order-date").val()
                    }
                    return query;
                }
            },
