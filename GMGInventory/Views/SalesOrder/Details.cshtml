@model SalesOrderDetailsVM

@{
    ViewData["Title"] = "Sales Order Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesOrder" asp-action="Index">Sales Orders</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (Model.Status == "Submitted")
            {
                @if (User.IsInRole(Roles.InventoryManager) || User.IsInRole(Roles.SalesDirector) || User.IsInRole(Roles.SystemAdmin) || User.IsInRole(Roles.Telemarketer))
                {
                    <button type="button" class="btn btn-primary btn-sm float-right ml-2 btn-details-submit">
                        <span class="fas fa-save"></span> Save
                    </button>
                }
                @if (User.IsInRole(Roles.InventoryManager) || User.IsInRole(Roles.SalesDirector) || User.IsInRole(Roles.SystemAdmin))
                {
                    @*<button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
            <span class="fas fa-print"></span> Print
            </button>*@
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 btn-details-approve">
                        <span class="fas fa-check"></span> Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-disapprove">
                        <span class="fas fa-times"></span> Disapprove
                    </button>
                }
            }
            else
            {
                if (User.IsInRole(Roles.InvoicingClerk) || User.IsInRole(Roles.SystemAdmin))
                {
                    if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy) && Model.ApprovedDate != null)
                    {
                        if (Model?.Status == "Approved")
                        {
                            <a href="@Url.Action("Create", "Pack")/@Model?.Id" class="btn btn-primary btn-sm float-right ml-2">
                                <span class="fas fa-box-open"></span> Start Packing
                            </a>
                        }
                        @*
            <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
            <span class="fas fa-print"></span> Print
            </button>*@
                    }
                }
                if (User.IsInRole(Roles.InvoicingClerk) || User.IsInRole(Roles.SystemAdmin) || User.IsInRole(Roles.Telemarketer))
                {
                    if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null && Model?.ResubmitId == null)
                    {
                        <a href="@Url.Action("Create")/@Model?.Id" class="btn btn-primary btn-sm float-right ml-2">
                            <span class="fas fa-edit"></span> Update to Resubmit
                        </a>
                    }
                }
            }
            <button type="button" class="btn btn-info btn-sm float-right ml-2 btn-details-print">
                <span class="fas fa-print"></span> Print
            </button>
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null)
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-danger text-sm" role="alert">
                        <strong>Disapproved:</strong>
                        @(string.IsNullOrWhiteSpace(Model?.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                    </div>
                </div>
                @if (Model?.ResubmitId != null)
                {
                    <div class="col-12">
                        <div class="alert alert-info text-sm" role="alert">
                            <strong>Resubmitted:</strong>
                            This has been resubmitted. You can view the details <a href="@Url.Action("Details", "SalesOrder", new {Id = Model?.ResubmitId})">here</a>.
                        </div>
                    </div>
                }
            </div>
        }
        <div class="row">
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SONumber)
                    </span>
                    <b class="d-block">
                        @Model?.SONumber
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerCode)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerCode
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerAddress)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.CustomerAddress.Trim()) ? "-" : Model.CustomerAddress)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerStatus)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.CustomerStatus.Trim()) ? "-" : Model.CustomerStatus)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AgentCode)
                    </span>
                    <b class="d-block">
                        @Model?.AgentCode
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OutstandingBalance)
                    </span>
                    <b class="d-block">
                        @Model?.OutstandingBalance
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.GrossNetPrice)
                    </span>
                    <b class="d-block">
                        @Model?.GrossNetPrice
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditTerms)
                    </span>
                    <b class="d-block">
                        @Model?.CreditTerms
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DeclaredValue)
                    </span>
                    <b class="d-block">
                        @Model?.DeclaredValue
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PONumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.PONumber?.Trim()) ? "-" : Model.PONumber)
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Forwarder)
                    </span>
                    <b class="d-block">
                        @Model?.Forwarder
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.Remarks.Trim()) ? "-" : Model.Remarks)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.SalesOrderBy)
                    </span>
                    <b class="d-block">
                        @Model?.SalesOrderBy
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </span>
                    <b class="d-block">
                        @Model?.OrderDate
                    </b>
                </p>
                @if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy) && Model.ApprovedDate != null)
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedBy)
                        </span>
                        <b class="d-block">
                            @(string.IsNullOrWhiteSpace(Model?.ApprovedBy) ? "-" : Model.ApprovedBy)
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ApprovedDate)
                        </span>
                        <b class="d-block">
                            @Model?.ApprovedDate
                        </b>
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null)
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DisapprovedBy)
                        </span>
                        <b class="d-block">
                            @(string.IsNullOrWhiteSpace(Model?.DisapprovedBy?.Trim()) ? "-" : Model.DisapprovedBy)
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DisapprovedDate)
                        </span>
                        <b class="d-block">
                            @Model?.DisapprovedDate
                        </b>
                    </p>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Sales Order Item(s)</span>
                        @if (Model?.Status == "Submitted" && (User.IsInRole(Roles.InventoryManager) || User.IsInRole(Roles.SalesDirector) || User.IsInRole(Roles.SystemAdmin) || User.IsInRole(Roles.Telemarketer)))
                        {
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                    <span class="fas fa-plus"></span> Add Item
                                </button>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Inventory Count</th>
                                    <th>Unit Price</th>
                                    <th>Discount 1</th>
                                    <th>Discount 2</th>
                                    <th>Extended Price</th>
                                    <th>Served Quantity</th>
                                    <th>Unserved Quantity</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th class="text-end">Total</th>
                                    <th class="total-quantity">0</th>
                                    <th colspan="7"></th>
                                    <th class="total-gross-price">0.00</th>
                                    <th class="total-served">0</th>
                                    <th class="total-unserved">0</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="po-status" value="@Model?.Status" />

<!-- Save Order Item Modal -->
<div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Sales Order Item</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-item">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-code" class="form-label mb-0">Code</label>
                                <div>
                                    <select id="add-code" name="Code" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                                <span data-valmsg-for="add-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-name" class="form-label mb-0">Name</label>
                                <input type="text" id="add-name" name="Name" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="add-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                <input type="number" min="0" max="1999999" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                <span class="text-xs text-muted">Items in Inventory: <strong class="add-inventory"></strong></span>
                                <span data-valmsg-for="add-quantity" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-unit-price" class="form-label mb-0">Unit Price <span class="add-price-source"></span></label>
                                <input type="number" step="0.01" min="0" max="1999999.99" id="add-unit-price" name="UnitPrice" class="form-control form-control-sm" />
                                <span data-valmsg-for="add-unit-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount1" class="form-label mb-0">Discount 1</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount1" name="Discount1" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="add-discount1" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-discount2" class="form-label mb-0">Discount 2</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="add-discount2" name="Discount2" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span data-valmsg-for="add-discount2" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label for="add-gross-price" class="form-label mb-0">Extended Price</label>
                                <input type="number" id="add-gross-price" name="ExtendedPrice" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="add-gross-price" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary btn-add">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Update Served Item Modal -->
