@model SalesOrderDetailsVM

@{
    ViewData["Title"] = "Sales Order Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="SalesOrder" asp-action="Index">Sales Orders</a></li>
}

<div class="card card-default">
    <form id="form-order">
        <div class="card-header">
            <span class="card-title po-title">@ViewData["Title"]</span>
            <div class="card-tools">
                @if (userAccess.CanPrint)
                {
                    <div class="dropdown float-right ml-2">
                        <button class="btn btn-info btn-sm dropdown-toggle" type="button" id="dropdownMenuPrint" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="fas fa-print"></span> Print
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuPrint">
                            <li><a class="dropdown-item btn-details-print" data-company="GMG">Use GMG Logo</a></li>
                            <li><a class="dropdown-item btn-details-print" data-company="BAS">Use BAS Logo</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <button type="button" class="btn btn-info btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Print access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-print"></span> Print
                    </button>
                }
                @if (Model.Status.ToLower() == "submitted")
                {
                    @if (userAccess.CanApproveDisapprove)
                    {
                        <button type="button" class="btn btn-success btn-sm float-right ml-2 btn-details-approve">
                            <span class="fas fa-check"></span> Approve
                        </button>
                        <button type="button" class="btn btn-danger btn-sm float-right ml-2 btn-details-disapprove">
                            <span class="fas fa-times"></span> Disapprove
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Approve / Disapprove access is required." data-microtip-position="bottom-left" role="tooltip">
                            <span class="fas fa-check"></span> Approve
                        </button>
                        <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Approve / Disapprove access is required." data-microtip-position="bottom-left" role="tooltip">
                            <span class="fas fa-times"></span> Disapprove
                        </button>
                    }
                }
                else if (Model.Status.ToLower() == "draft")
                {
                    @if (userAccess.CanEdit)
                    {
                        <button type="submit" class="btn btn-secondary btn-sm float-right ml-2" data-action="Draft">
                            <span class="fas fa-save"></span> Save as Draft
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm float-right ml-2" data-action="Submitted">
                            <span class="fas fa-save"></span> Submit
                        </button>
                        <input type="hidden" id="action-type" name="ActionType" value="">
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                            <span class="fas fa-save"></span> Save as Draft
                        </button>
                        <button type="button" class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                            <span class="fas fa-save"></span> Submit
                        </button>
                    }
                }
                else
                {
                    if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy) && Model.ApprovedDate != null)
                    {
                        if (Model?.IsAllPacked != true && Model?.Status.ToLower() != "draft" && Model?.Status.ToLower() != "submitted" && Model?.Status.ToLower() != "disapproved")
                        {
                            <a href="@Url.Action("Create", "Pack")/@Model?.Id?page=SalesOrder" target="_blank" class="btn btn-primary btn-sm float-right ml-2">
                                <span class="fas fa-box-open"></span> Start Packing
                            </a>
                        }
                    }
                    if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null && Model?.ResubmitId == null)
                    {
                        @if (userAccess.CanAdd)
                        {
                            <a href="@Url.Action("Create")/@Model?.Id" class="btn btn-primary btn-sm float-right ml-2">
                                <span class="fas fa-edit"></span> Update to Resubmit
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                                <span class="fas fa-edit"></span> Update to Resubmit
                            </button>
                        }
                    }
                }
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null)
            {
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-danger text-sm" role="alert">
                            <strong>Disapproved:</strong>
                            @(string.IsNullOrWhiteSpace(Model?.DisapprovedReason) ? "No reason why it was disapproved." : Model.DisapprovedReason)
                        </div>
                    </div>
                    @if (Model?.ResubmitId != null)
                    {
                        <div class="col-12">
                            <div class="alert alert-info text-sm" role="alert">
                                <strong>Resubmitted:</strong>
                                This has been resubmitted. You can view the details <a href="@Url.Action("Details", "SalesOrder", new { Id = Model?.ResubmitId })">here</a>.
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="row">
                <div class="col-3">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.SONumber)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.SONumber
                        </b>
                    </p>
                    <p class="text-sm">
                        @if (Model!.Status.ToLower().Contains("draft") && userAccess.CanEdit)
                        {
                            <label for="order-agent-code" class="form-label fw-normal mb-0">
                                @Html.DisplayNameFor(model => model.AgentCode)
                            </label>
                            <select id="order-agent-code" class="s2-bold s2ph-bold s2ph-dark" name="AgentCode" style="width: 100%"></select>
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.AgentCode)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.AgentCode
                            </b>
                        }
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.AgentName)
                        </span>
                        <b class="d-block form-gayahin order-agent-name">
                            @Model?.AgentName
                        </b>
                    </p>
                    <p class="text-sm">
                        @if (Model!.Status.ToLower().Contains("draft") && userAccess.CanEdit)
                        {
                            <label for="order-customer-code" class="form-label fw-normal mb-0">
                                @Html.DisplayNameFor(model => model.CustomerCode)
                            </label>
                            <select id="order-customer-code" class="s2-bold s2ph-bold s2ph-dark" name="CustomerCode" style="width: 100%"></select>
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.CustomerCode)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.CustomerCode
                            </b>
                        }
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerName)
                        </span>
                        <b class="d-block form-gayahin order-customer-name">
                            @Model?.CustomerName
                        </b>
                    </p>
                </div>
                <div class="col-3">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CustomerAddress)
                        </span>
                        <b class="d-block form-gayahin order-customer-address">
                            @(string.IsNullOrEmpty(Model?.CustomerAddress.Trim()) ? "N/A" : Model.CustomerAddress)
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.OutstandingBalance)
                        </span>
                        <b class="d-block form-gayahin order-customer-balance">
                            @Model?.OutstandingBalance
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.CreditTerms)
                        </span>
                        <b class="d-block form-gayahin order-credit-term">
                            @Model?.CreditTerms
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Region)
                        </span>
                        <b class="d-block form-gayahin order-region">
                            @Model?.Region
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.AccountStatus)
                        </span>
                        <b class="d-block form-gayahin order-customer-status">
                            @Model!.AccountStatus
                        </b>
                    </p>
                </div>
                <div class="col-3">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.PONumber)
                        </span>
                        <b class="d-block form-gayahin order-purchase-number">
                            @(string.IsNullOrEmpty(Model?.PONumber?.Trim()) ? "N/A" : Model.PONumber)
                        </b>
                    </p>
                    <p class="text-sm">
                        @if (Model!.Status.ToLower().Contains("draft") && userAccess.CanEdit)
                        {
                            <label for="order-forwarder" class="form-label fw-normal mb-0">
                                @Html.DisplayNameFor(model => model.Forwarder)
                            </label>
                            <select id="order-forwarder" class="s2-bold s2ph-bold s2ph-dark" name="Forwarder" style="width: 100%"></select>
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.Forwarder)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.Forwarder
                            </b>
                        }
                    </p>
                    <p class="text-sm">
                        @if (Model!.Status.ToLower().Contains("draft") && userAccess.CanEdit)
                        {
                            <label for="order-remarks" class="form-label fw-normal mb-0">
                                @Html.DisplayNameFor(model => model.Remarks)
                            </label>
                            <input type="text" id="order-remarks" name="Remarks" class="form-control form-control-sm" value="@Model.Remarks" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.Remarks)
                            </span>
                            <b class="d-block form-gayahin">
                                @(string.IsNullOrEmpty(Model?.Remarks.Trim()) ? "N/A" : Model.Remarks)
                            </b>
                        }
                    </p>
                    <p class="text-sm">
                        @if (Model!.Status.ToLower().Contains("draft"))
                        {
                            <label for="order-date" class="form-label fw-normal mb-0">
                                @Html.DisplayNameFor(model => model.OrderDate)
                            </label>
                            <input type="date" id="order-date" name="OrderDate" class="form-control form-control-sm" value="@Model.OrderDate3" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.OrderDate)
                            </span>
                            <b class="d-block form-gayahin order-date">
                                @Model?.OrderDate
                            </b>
                        }
                    </p>
                    <p class="text-sm">
                        @if (Model!.Status.ToLower().Contains("draft"))
                        {
                            <label for="order-delivery-date" class="form-label fw-normal mb-0">
                                @Html.DisplayNameFor(model => model.RequiredDeliveryDate)
                            </label>
                            <input type="date" id="order-delivery-date" name="DeliveryDate" class="form-control form-control-sm" value="@Model.RequiredDeliveryDate3" />
                        }
                        else
                        {
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.RequiredDeliveryDate)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.RequiredDeliveryDate
                            </b>
                        }
                    </p>
                </div>
                <div class="col-3">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Status)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.Status
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserCreated)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.UserCreated
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateCreated)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.DateCreated
                        </b>
                    </p>
                    @if (Model?.UserModified != null)
                    {
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.UserModified)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.UserModified
                            </b>
                        </p>
                    }
                    @if (Model?.DateModified != null)
                    {
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.DateModified)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.DateModified
                            </b>
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy) && Model.ApprovedDate != null)
                    {
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.ApprovedBy)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model.ApprovedBy
                            </b>
                        </p>
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.ApprovedDate)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.ApprovedDate
                            </b>
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null)
                    {
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.DisapprovedBy)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model.DisapprovedBy
                            </b>
                        </p>
                        <p class="text-sm">
                            <span class="text-muted">
                                @Html.DisplayNameFor(model => model.DisapprovedDate)
                            </span>
                            <b class="d-block form-gayahin">
                                @Model?.DisapprovedDate
                            </b>
                        </p>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Sales Order Item(s)</span>
                            @if (Model?.Status.ToLower() == "draft")
                            {
                                @if (userAccess.CanAdd)
                                {
                                    <div class="card-tools">
                                        <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                            <span class="fas fa-plus"></span> Add Sales Order Item
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>#</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>Inventory Count</th>
                                        <th>Unit Price</th>
                                        <th>Discount 1</th>
                                        <th>Discount 2</th>
                                        <th>Extended Price</th>
                                        <th>Served Quantity</th>
                                        <th>Unserved Quantity</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th colspan="2" class="text-end">Total</th>
                                        <th class="total-quantity">0</th>
                                        <th colspan="7"></th>
                                        <th class="total-gross-price">0.00</th>
                                        <th class="total-served">0</th>
                                        <th class="total-unserved">0</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@if (userAccess.CanAdd)
{
    <!-- Save Order Item Modal -->
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Sales Order Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-code" class="form-label mb-0">Code</label>
                                    <select id="add-code" name="Code" style="width: 100%;">
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-name" class="form-label mb-0">Name</label>
                                    <input type="text" id="add-name" name="Name" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-quantity" class="form-label mb-0">Quantity</label>
                                    <input type="number" min="0" max="1999999" id="add-quantity" name="Quantity" class="form-control form-control-sm" />
                                    <span class="text-xs text-muted">Items in Inventory: <strong class="add-inventory"></strong></span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-unit" class="form-label mb-0">Unit</label>
                                    <input type="text" id="add-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-unit-price" class="form-label mb-0">Unit Price <span class="add-price-source"></span></label>
                                    <input type="number" step="0.01" min="0" max="1999999.99" id="add-unit-price" name="UnitPrice" class="form-control form-control-sm" />
                                    @*<input type="text" id="add-unit-price" name="UnitPrice" class="form-control form-control-sm" readonly="readonly" />*@
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-discount1" class="form-label mb-0">Discount 1</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.01" min="0" max="100" id="add-discount1" name="Discount1" class="form-control form-control-sm" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-discount2" class="form-label mb-0">Discount 2</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.01" min="0" max="100" id="add-discount2" name="Discount2" class="form-control form-control-sm" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="form-group">
                                    <label for="add-gross-price" class="form-label mb-0">Extended Price</label>
                                    <input type="number" id="add-gross-price" name="ExtendedPrice" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-add">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (userAccess.CanEdit)
{
    <!-- Update Served Item Modal -->
    <div class="modal fade" id="servedModal" role="dialog" aria-labelledby="servedModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Sales Order Item Served Quantity</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="served-code" class="form-label mb-0">Item Code</label>
                                <input type="text" id="served-code" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="served-name" class="form-label mb-0">Item Name</label>
                                <input type="text" id="served-name" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="served-quantity" class="form-label mb-0">Quantity</label>
                                <input type="text" id="served-quantity" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="served-toadd" class="form-label mb-0">Served Quantity to Add</label>
                                <input type="number" min="0" max="1999999" id="served-toadd" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="served-inventory" class="form-label mb-0">Inventory Count</label>
                                <input type="text" id="served-inventory" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="served-served" class="form-label mb-0">Served Quantity</label>
                                <input type="text" id="served-served" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                <label for="served-unserved" class="form-label mb-0">Unserved Quantity</label>
                                <input type="text" id="served-unserved" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (userAccess.CanEdit)
                    {
                        <button type="button" class="btn btn-primary btn-update-served">
                            <span class="fas fa-pencil-alt"></span> Update
                        </button>
                    }
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (userAccess.CanApproveDisapprove)
{
    <form id="approve-form" asp-action="Approve">
        <input type="hidden" id="approve-id" name="Id" value="@Model?.Id" />
    </form>

    <form id="disapprove-form" asp-action="Disapprove">
        <input type="hidden" id="disapprove-id" name="Id" value="@Model?.Id" />
        <input type="hidden" id="disapprove-reason" name="Reason" />
    </form>
}
@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var so_details = @Html.Raw(Json.Serialize(Model));

        if (user_access.canEdit && so_details.status.toLowerCase().includes("draft")) {
            // Load agent data for select2
            $("#order-agent-code").select2({
                //minimumInputLength: 1,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetOptions2", "Agent")"
                }
            });

            $("#order-agent-code").on("select2:select", function () {
                $(".order-agent-name").text($(this).select2("data")[0].name);
                // $("#order-customer-code").val(null).trigger("change");
                // $(".order-customer-name").text("N/A");
                // $(".order-customer-address").text("N/A");
                // $(".order-customer-balance").text("N/A");
                // $(".order-credit-term").text("N/A");
                // $(".order-region").text("N/A");
                // $(".order-customer-status").text("N/A");
            });

            // Load customer data for select2
            $("#order-customer-code").select2({
                //minimumInputLength: 1,
                placeholder: '<empty>',
                language: {
                    noResults: function () {
                        return "No customers found for selected Agent";
                    }
                },
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetByAgentOptions", "Customer")",
                    data: function (params) {
                        let base = $.fn.select2.defaults.defaults.ajax.data(params);
                        return Object.assign(base, {
                            agent: $("#order-agent-code").val()
                        });
                    }
                }
            });

            $("#order-customer-code").on("select2:select", function () {
                $(".order-customer-name").text($(this).select2("data")[0].name);
                $(".order-customer-address").text($(this).select2("data")[0].address);
                $(".order-customer-balance").text($(this).select2("data")[0].outstandingBalance);
                $(".order-credit-term").text($(this).select2("data")[0].creditTerm);
                $(".order-region").text($(this).select2("data")[0].region);
                $(".order-customer-status").text($(this).select2("data")[0].customerStatus);

                if (parseFloat($(this).select2("data")[0].outstandingBalanceD) > 0) {
                    toastr.warning("(" + $("#order-customer-code").select2("data")[0].text.trim() + ") " + $("#order-customer-code").select2("data")[0].name.trim() + " has an outstanding balance of " + $(this).select2("data")[0].outstandingBalance, "Outstanding Balance");
                }

                if ($("#order-agent-code").val() == null) {
                    var agentId = $(this).select2("data")[0].agentId;
                    var agentCode = $(this).select2("data")[0].agentCode;
                    var agentName = $(this).select2("data")[0].agent;
                    var agentOption = new Option(agentCode, agentId, true, true);
                    $(agentOption).data('data', {
                      id: agentId,
                      text: agentCode,
                      name: agentName
                    });
                    $("#order-agent-code").append(agentOption).trigger("change");
                    $("#order-agent-name").val(agentName);
                }
            });

            // Load forwarder data for select2
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Forwarder")",
                success: function (data, status, xhr) {
                    $("#order-forwarder").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        //minimumResultsForSearch: Infinity
                    });
                }
            });

            var agentOption = new Option(so_details.agentCode, so_details.agentId, true, true);
            $("#order-agent-code").append(agentOption);
            $("#order-agent-code").trigger('change');

            var customerOption = new Option(so_details.customerCode, so_details.customerId, true, true);
            $("#order-customer-code").append(customerOption);
            $("#order-customer-code").trigger('change');

            var forwarderOption = new Option(so_details.forwarder, so_details.forwarderId, true, true);
            $("#order-forwarder").append(forwarderOption);
            $("#order-forwarder").trigger('change');

            $("#form-order button[type=submit]").on("click", function () {
                $("#action-type").val($(this).data("action"));
            });

            // Validation for Save
            var validateSave = $("#form-order").validate({
                rules: {
                    AgentCode: { required: true },
                    CustomerCode: { required: true },
                    Forwarder: { required: true },
                    OrderDate: { required: true },
                    DeliveryDate: { required: true, greaterThanOrEqualDate: "#order-date" },
                    Remarks: { maxlength: 500 }
                },
                messages: {
                    AgentCode: { required: "Please select agent" },
                    CustomerCode: { required: "Please select customer" },
                    Forwarder: { required: "Please select forwarder" },
                    OrderDate: { required: "Please select date of order" },
                    DeliveryDate: {
                        required: "Please select date of delivery",
                        greaterThanOrEqualDate: "Required delivery date must be on or after the order date"
                    },
                    Remarks: { maxlength: "Remarks must not exceed 500 characters." }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    SaveOrder();
                }
            });

            function SaveOrder() {
                var itemsToReplenish = GetItemsToOrder();
                if (itemsToReplenish.length == 0) {
                    toastr.warning("No item to replenish. Add an item to the list to continue", "Warning");
                } else if (itemsToReplenish.filter(s => parseInt(s.quantity) === 0).length > 0) {
                    toastr.warning("Some items have 0 quantity. Can't replenish an item with 0 quantity", "Warning");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("SaveJson")",
                        data: {
                            Id: @Model?.Id,
                            Agent: $("#order-agent-code").val(),
                            Customer: $("#order-customer-code").val(),
                            DeliveryDate: $("#order-delivery-date").val(),
                            Forwarder: $("#order-forwarder").val(),
                            Remarks: $("#order-remarks").val(),
                            OrderDate: $("#order-date").val(),
                            Status: $("#action-type").val(),
                            Items: itemsToReplenish
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                window.location.reload();
                            }
                        }
                    });
                }
            }
        }

        // Load item for select2
        $("#add-code").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $(
                    "<strong>" + repo.text + "</strong> " +
                    (repo.text != repo.name
                        ? "<em class='fw-light'> - " + repo.name + "</em>"
                        : "") +
                    "<br />" +
                    "<small class='text-muted'>" +
                    (repo.oldCode ? "Old SKU: " + repo.oldCode + "<br />" : "") +
                    (repo.partNumber ? "Part Number: " + repo.partNumber + "<br />" : "") +
                    "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")"
            },
            dropdownParent: $("#addModal")
        });

        $("#add-code").on("select2:select", function () {
            $("#add-name").val($("#add-code").select2("data")[0].name);
            if ($("#add-code").select2("data")[0].retailPriceD > $("#add-code").select2("data")[0].netPriceD) {
                $("#add-unit-price").val($("#add-code").select2("data")[0].retailPriceD);
                $("#add-gross-price").val($("#add-code").select2("data")[0].retailPriceD);
                $(".add-price-source").text("(Gross)");
            } else {
                $("#add-unit-price").val($("#add-code").select2("data")[0].netPriceD);
                $("#add-gross-price").val($("#add-code").select2("data")[0].netPriceD);
                $(".add-price-source").text("(Net)");
            }
            $("#add-unit").val($("#add-code").select2("data")[0].unit);
            $(".add-inventory").text($("#add-code").select2("data")[0].inventoryCount);
            $("#add-quantity").val("1");
            $("#add-code-error").html("");
        });

        $("#add-code").on("select2:unselecting", function (e) {
            $("#add-name").val("");
            $("#add-unit-price").val("");
            $(".add-price-source").text("");
            $("#add-unit").val("");
            $(".add-inventory").text("0");
            $("#add-quantity").val("0");
            $("#add-gross-price").val("0.00");
        });

        $("#add-quantity, #add-unit-price, #add-discount1, #add-discount2").on("input", function () {
            var quantity = parseFloat($("#add-quantity").val());
            var unit_price = parseFloat($("#add-unit-price").val());
            var discount1 = parseFloat($("#add-discount1").val());
            var discount2 = parseFloat($("#add-discount2").val());

            $("#add-gross-price").val(Round2Decimal(quantity * (((100 - discount1 - discount2) * unit_price) / 100)));
        });

        function clearItemForm() {
            $("#add-code").val("").trigger("change");
            $("#add-name").val("");
            $("#add-unit-price").val("0.00");
            $(".add-price-source").text("");
            $("#add-quantity").val("0");
            $("#add-unit").val("");
            $(".add-inventory").text("0");
            $("#add-discount1").val("0.00");
            $("#add-discount2").val("0.00");
            $("#add-gross-price").val("0.00");
        }

        $(".createBtn").on("click", clearItemForm);

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            rules: {
                Code: { required: true },
                Quantity: { required: true, isNotZero: true },
                UnitPrice: { required: true }
            },
            messages: {
                Code: { required: "Please select item to replenish." },
                Quantity: { required: "Please enter a quantity", isNotZero: "Can not replenish an item with 0 quantity" },
                UnitPrice: { required: "Please enter the unit cost", isNotZero: "Can not sell for free" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.itemId == $("#add-code").select2("data")[0].id) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastr.warning($("#add-code").select2("data")[0].text + " has already been added", "Duplicate");
            } else {
                itemDT.row.add({
                    itemId: $("#add-code").select2("data")[0].id,
                    lineNumber: itemDT.data().length == 0 ? 1 : (Math.max.apply(Math, itemDT.column(1).data().toArray()) + 1),
                    itemCode: $("#add-code").select2("data")[0].text,
                    itemName: $("#add-code").select2("data")[0].name,
                    inventoryCount: $("#add-code").select2("data")[0].inventoryCount,
                    quantity: Round2Decimal($("#add-quantity").val() || 0),
                    quantityD: $("#add-quantity").val() || 0,
                    unit: $("#add-code").select2("data")[0].unit,
                    sellingPrice: Round2Decimal($("#add-unit-price").val() || 0),
                    sellingPriceD: $("#add-unit-price").val() || 0,
                    discount1: Round2Decimal($("#add-discount1").val() || 0),
                    discount1D: $("#add-discount1").val() || 0,
                    discount2: Round2Decimal($("#add-discount2").val() || 0),
                    discount2D: $("#add-discount2").val() || 0,
                    grossPrice: Round2Decimal($("#add-gross-price").val() || 0),
                    grossPriceD: $("#add-gross-price").val() || 0,
                    servedQuantity: 0,
                    serverQuantityD: 0,
                    unservedQuantity: 0,
                    unservedQuantityD: 0
                }).order([1, 'asc']).draw();
                clearItemForm();

                toastr.success("Added " + $("#add-code").select2("data")[0].text + " on Sales Order Item(s)", "Success");
            }
        }

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { salesOrderId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (so_details.status.toLowerCase().includes("draft") && user_access.canEdit) {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="bottom-left" role="tooltip"><i class="fas fa-minus"></i></button>';
                            actions += '<button type="button" class="btn btn-info btn-xs btn-up-item" data-microtip-title="Move Up Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-up"></i></button>';
                            actions += '<button type="button" class="btn btn-info btn-xs btn-down-item" data-microtip-title="Move Down Item" data-microtip-position="top" role="tooltip"><i class="fas fa-arrow-down"></i></button>';
                        }
                        return actions + '</div>';
                    },
                    className: "form-cell"
                },
                { data: "lineNumber", name: "LineNumber", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        if (so_details.status.toLowerCase().includes("draft") && user_access.canEdit) {
                            return '<input type="number" min="0" max="1999999" value="' + data.quantityD + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                        } else {
                            return data.quantity
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unit", name: "Unit", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<nobr>' + data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="bottom-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span></nobr>';
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemName", name: "ItemName", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return (data.inventoryCount == 0 ? "<span class='text-danger'>" : "")
                            + data.inventoryCount
                            + (data.inventoryCount == 0 ? "</span>" : "");
                    },
                    name: "InventoryCount",
                    className: "form-cell text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (so_details.status.toLowerCase().includes("draft") && user_access.canEdit) {
                            return '<input type="number" min="0" step="0.01" max="1999999.99" value="' + Round2Decimal(data.sellingPriceD) + '" class="form-control form-control-sm unitprice" style="width: 100%;" />';
                        } else {
                            return Round2Decimal(data.sellingPriceD)
                        }
                    },
                    name: "SellingPrice",
                    className: "form-cell text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (so_details.status.toLowerCase().includes("draft") && user_access.canEdit) {
                            return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + Round2Decimal(data.discount1D) + '" class="form-control form-control-sm discount1" /><span class="input-group-text">%</span></div>';
                        } else {
                            return Round2Decimal(data.discount1)
                        }
                    },
                    name: "Discount1",
                    className: "form-cell text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (so_details.status.toLowerCase().includes("draft") && user_access.canEdit) {
                            return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + Round2Decimal(data.discount2D) + '" class="form-control form-control-sm discount2" /><span class="input-group-text">%</span></div>';
                        } else {
                            return Round2Decimal(data.discount2D)
                        }
                    },
                    name: "Discount2",
                    className: "form-cell text-end"
                },
                { data: "grossPrice", name: "GrossPrice", className: "form-cell text-end grossprice" },
                { data: "servedQuantity", name: "ServedQuantity", className: "form-cell text-end servedquantity" },
                { data: "unservedQuantity", name: "UnservedQuantity", className: "form-cell text-end unservedquantity" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.quantityD != data.servedQuantityD + data.unservedQuantityD || data.unservedQuantityD != 0) {
                            if (user_access.canEdit) {
                                actions += '<button type="button" class="btn btn-warning btn-xs btn-update-serve" data-microtip-title="Update Served Item" data-microtip-position="bottom-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                            }
                        }
                        return actions;
                    },
                    className: "form-cell"
                }
            ],
            order: [[1, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 2);
                columnDTTotalDecimal(api, 10);
                columnDTTotalInteger(api, 11);
                columnDTTotalInteger(api, 12);
            }
        });

        itemDT.on("draw", function () {
            //if (so_details.status.toLowerCase().includes("submitted")) {
            if (so_details.status.toLowerCase().includes("draft")) {
                itemDT.column(0).visible(true); // remove button
                itemDT.column(11).visible(false); // served quantity
                itemDT.column(12).visible(false); // unserved quantity
                itemDT.column(13).visible(false); // update served quantity button
            // } else if (so_details.status.toLowerCase().includes("approved")) {
            //     itemDT.column(0).visible(false);
            //     itemDT.column(11).visible(true);
            //     itemDT.column(12).visible(true);
            //     itemDT.column(13).visible(false);//true dati
            } else {
                itemDT.column(0).visible(false);
                itemDT.column(11).visible(true);//false dati
                itemDT.column(12).visible(true);//false dati
                itemDT.column(13).visible(false);
            }

            hideLoader();

            $(".btn-remove-item").on("click", function () {
                itemDT.row($(this).parents('tr')).remove().draw();
            });
            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");
            $(".table-item thead th").removeClass("grossprice");

            //ComputeTotalQuantity();
            //ComputeTotalGrossPrice();
            $(".quantity, .discount1, .discount2, .unitprice").on("input", function () {
                var row = itemDT.row($(this).closest('tr'));
                var rowData = row.data();

                var quantity = parseInt($(this).parents("tr").find(".quantity").val());
                var discount1 = parseFloat($(this).parents("tr").find(".discount1").val());
                var discount2 = parseFloat($(this).parents("tr").find(".discount2").val());
                //var unit_price = rowData.sellingPriceD;
                var unit_price = parseFloat($(this).parents("tr").find(".unitprice").val());

                //var gross_price = FormatStringDecimal(Round2Decimal(quantity * (((100 - discount1 - discount2) * unit_price) / 100)));
                var gross_price = FormatStringDecimal(Round2Decimal((quantity * unit_price * (100 - discount1) / 100) * (100 - discount2) / 100));

                $(this).parents("tr").find(".grossprice").html(gross_price);
                ComputeTotalQuantity();
                ComputeTotalGrossPrice();
            });

            if (user_access.canEdit) {
                $(".btn-update-serve").on("click", function () {
                    var itemdata = itemDT.row($(this).parents('tr')).data();
                    $("#served-code").data("id", itemdata.id);
                    $("#served-code").val(itemdata.itemCode);
                    $("#served-name").val(itemdata.itemName);
                    $("#served-quantity").val(itemdata.quantity);
                    $("#served-toadd").val(0);
                    $("#served-toadd").attr("max", itemdata.inventoryCount);
                    $("#served-inventory").val(itemdata.inventoryCount);
                    $("#served-inventory").data("prime", itemdata.inventoryCount);
                    $("#served-served").val(itemdata.servedQuantity);
                    $("#served-served").data("prime", itemdata.servedQuantity);
                    $("#served-unserved").val(itemdata.unservedQuantity);
                    $("#served-unserved").data("prime", itemdata.unservedQuantity);
                    $("#servedModal").modal("show");
                });

                if(so_details.status.toLowerCase().includes("draft")) {
                    itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                        var rowData = this.data();
                        if (rowData.lineNumber == 1)
                            $(this.node()).find(".btn-up-item").hide();
                        else
                            $(this.node()).find(".btn-up-item").show();

                        if (rowData.lineNumber == Math.max.apply(Math, itemDT.column(1).data().toArray()))
                            $(this.node()).find(".btn-down-item").hide();
                        else
                            $(this.node()).find(".btn-down-item").show();
                    });

                    $(".btn-up-item").off("click").on("click", function () {
                        var row = $(this).parents('tr');
                        var rowData = itemDT.row(row).data();

                        var currentLineNumber = rowData.lineNumber;
                        var newLineNumber = currentLineNumber - 1;

                        var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                            return itemDT.row(index).data().lineNumber == newLineNumber;
                        });

                        if (targetRowIndex != undefined) {
                            var targetRowData = itemDT.row(targetRowIndex).data();
                            targetRowData.lineNumber = currentLineNumber;
                            itemDT.row(targetRowIndex).data(targetRowData);
                        }

                        rowData.lineNumber = newLineNumber;
                        itemDT.row(row).data(rowData);

                        itemDT.order([1, 'asc']).draw();
                    });

                    $(".btn-down-item").off("click").on("click", function () {
                        var row = $(this).parents('tr');
                        var rowData = itemDT.row(row).data();
                        var currentLineNumber = rowData.lineNumber;
                        var newLineNumber = currentLineNumber + 1;

                        var targetRowIndex = itemDT.rows().indexes().toArray().find(function (index) {
                            return itemDT.row(index).data().lineNumber == newLineNumber;
                        });

                        if (targetRowIndex != undefined) {
                            var targetRowData = itemDT.row(targetRowIndex).data();
                            targetRowData.lineNumber = currentLineNumber;
                            itemDT.row(targetRowIndex).data(targetRowData);
                        }

                        rowData.lineNumber = newLineNumber;
                        itemDT.row(row).data(rowData);

                        itemDT.order([1, 'asc']).draw();
                    });
                }
            }
        });

        $("#served-toadd").on("input", function () {
            var toadd = parseInt($(this).val());
            var inventory = parseInt($("#served-inventory").data("prime"));
            var served = parseInt($("#served-served").data("prime"));
            if (toadd == 0) {
                $("#served-inventory").val(inventory);
                $("#served-served").val(served);
            } else {
                $("#served-inventory").val(inventory + " → " + (inventory - toadd));
                $("#served-served").val(served + " → " + (served + toadd));
            }
        });

        if (user_access.canEdit) {
            $(".btn-update-served").on("click", function () {
                if (parseInt($("#served-toadd").val()) <= 0) {
                    toastr.warning("Nothing to add", "Served Quantity");
                } else if (parseInt($("#served-inventory").data("prime")) <= 0) {
                    toastr.warning($("#served-code").val() + " needs replenishment.", "Inventory Count");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("UpdateServedSOItem")",
                        data: {
                            salesOrderLineItemId: $("#served-code").data("id"),
                            quantity: $("#served-toadd").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                $("#servedModal").modal("hide");
                                itemDT.ajax.reload();
                                toastr.success(data.message, "Success");
                            }
                        }
                    });
                }
            });
        }

        function ComputeTotalQuantity() {
            total_quantity = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        function ComputeTotalGrossPrice() {
            total_gross_price = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_gross_price += parseFloat($(this.node()).find(".grossprice").html().replace(",", ""));
            });
            $(".total-gross-price").html(FormatStringDecimal(total_gross_price));
        }

        function GetItemsToOrder() {
            var item_to_order = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                var row_unitprice = parseFloat($(this.node()).find(".unitprice").val());
                var row_discount1 = parseFloat($(this.node()).find(".discount1").val());
                var row_discount2 = parseFloat($(this.node()).find(".discount2").val());
                item_to_order.push({
                    lineNumber: row_data.lineNumber,
                    item: row_data.itemId,
                    quantity: row_quantity,
                    unitPrice: row_unitprice,
                    discount1: row_discount1,
                    discount2: row_discount2
                });
            });
            return item_to_order;
        }

        if (user_access.canApproveDisapprove) {
            $('.btn-details-approve').click(function (e) {
                swal({
                    title: "Approve Sales Order",
                    text: "Continue to approve this sales order?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $('#approve-form').submit();
                    }
                });
            });

            $('.btn-details-disapprove').click(function (e) {
                swal({
                    title: "Disapprove Sales Order",
                    text: "Continue to disapprove this sales order?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                    content: {
                        element: "input",
                        attributes: {
                            placeholder: "Reason for Disapproving",
                            type: "text"
                        }
                    }
                }).then((confirm) => {
                    if (confirm !== null) {
                        $("#disapprove-reason").val(confirm);
                        $('#disapprove-form').submit();
                    }
                });
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                var print_company = $(this).data("company");
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("Print")/' + @Model?.Id + '?Company=' + print_company, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
}