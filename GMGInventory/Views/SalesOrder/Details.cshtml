@if (userAccess.CanApproveDisapprove)
{
    <form id="approve-form" asp-action="Approve">
        <input type="hidden" id="approve-id" name="Id" value="@Model?.Id" />
    </form>

    <form id="disapprove-form" asp-action="Disapprove">
        <input type="hidden" id="disapprove-id" name="Id" value="@Model?.Id" />
        <input type="hidden" id="disapprove-reason" name="Reason" />
    </form>
}
@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load item for select2
        $("#add-code").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: "<empty>",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light text-secondary'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Item")",
                dataType: 'json',
                type: "POST",
                delay: 500,
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#addModal")
        });

        $("#add-code").on("select2:select", function () {
            $("#add-name").val($("#add-code").select2("data")[0].name);
            if ($("#add-code").select2("data")[0].retailPriceD > $("#add-code").select2("data")[0].netPriceD) {
                $("#add-unit-price").val($("#add-code").select2("data")[0].retailPriceD);
                $("#add-gross-price").val($("#add-code").select2("data")[0].retailPriceD);
                $(".add-price-source").text("(Gross)");
            } else {
                $("#add-unit-price").val($("#add-code").select2("data")[0].netPriceD);
                $("#add-gross-price").val($("#add-code").select2("data")[0].netPriceD);
                $(".add-price-source").text("(Net)");
            }
            $("#add-unit").val($("#add-code").select2("data")[0].unit);
            $(".add-inventory").text($("#add-code").select2("data")[0].inventoryCount);
            $("#add-quantity").val("1");
            $("#add-code-error").html("");
        });

        $("#add-code").on("select2:unselecting", function (e) {
            $("#add-name").val("");
            $("#add-unit-price").val("");
            $(".add-price-source").text("");
            $("#add-unit").val("");
            $(".add-inventory").text("0");
            $("#add-quantity").val("0");
            $("#add-gross-price").val("0.00");
        });

        $("#add-quantity, #add-unit-price, #add-discount1, #add-discount2").on("input", function () {
            var quantity = parseFloat($("#add-quantity").val());
            var unit_price = parseFloat($("#add-unit-price").val());
            var discount1 = parseFloat($("#add-discount1").val());
            var discount2 = parseFloat($("#add-discount2").val());

            $("#add-gross-price").val(Round2Decimal(quantity * (((100 - discount1 - discount2) * unit_price) / 100)));
        });

        function clearItemForm() {
            $("#add-code").val("").trigger("change");
            $("#add-name").val("");
            $("#add-unit-price").val("0.00");
            $(".add-price-source").text("");
            $("#add-quantity").val("0");
            $("#add-unit").val("");
            $(".add-inventory").text("0");
            $("#add-discount1").val("0.00");
            $("#add-discount2").val("0.00");
            $("#add-gross-price").val("0.00");
        }

        $(".createBtn").on("click", clearItemForm);

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            rules: {
                Code: { required: true },
                Quantity: { required: true, isNotZero: true },
                UnitPrice: { required: true }
            },
            messages: {
                Code: { required: "Please select item to replenish." },
                Quantity: { required: "Please enter a quantity", isNotZero: "Can not replenish an item with 0 quantity" },
                UnitPrice: { required: "Please enter the unit cost", isNotZero: "Can not sell for free" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var rowIndexes = [];
            itemDT.rows(function (idx, data, node) {
                if (data.itemId == $("#add-code").select2("data")[0].id) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastr.warning($("#add-code").select2("data")[0].text + " has already been added", "Duplicate");
            } else {
                itemDT.row.add({
                    itemId: $("#add-code").select2("data")[0].id,
                    itemCode: $("#add-code").select2("data")[0].text,
                    itemName: $("#add-code").select2("data")[0].name,
                    inventoryCount: $("#add-code").select2("data")[0].inventoryCount,
                    quantity: $("#add-quantity").val() || 0,
                    unit: $("#add-code").select2("data")[0].unit,
                    sellingPrice: Round2Decimal($("#add-unit-price").val() || 0),
                    sellingPriceD: $("#add-unit-price").val() || 0,
                    discount1: Round2Decimal($("#add-discount1").val() || 0),
                    discount1D: $("#add-discount1").val() || 0,
                    discount2: Round2Decimal($("#add-discount2").val() || 0),
                    discount2D: $("#add-discount2").val() || 0,
                    grossPrice: Round2Decimal($("#add-gross-price").val() || 0),
                    grossPriceD: $("#add-gross-price").val() || 0,
                    servedQuantity: 0,
                    serverQuantityD: 0,
                    unservedQuantity: 0,
                    unservedQuantityD: 0
                }).draw();
                clearItemForm();

                toastr.success("Added " + $("#add-code").select2("data")[0].text + " on Sales Order Item(s)", "Success");
            }
        }

        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemsJson")",
                data: { salesOrderId: @Model?.Id },
                dataSrc: function (json) {
                    return JSON.parse(JSON.stringify(json));
                },
                type: "POST",
            },
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if ($("#po-status").val().toLowerCase() == "draft" && user_access.canEdit) {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="top-left" role="tooltip"><i class="fas fa-minus"></i></button>';
                        }
                        return actions;
                    },
                    className: "form-cell"
                },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val().toLowerCase() == "draft" && user_access.canEdit) {
                            return '<input type="number" min="0" max="1999999" value="' + data.quantity + '" class="form-control form-control-sm quantity" style="width: 100%;" />';
                        } else {
                            return data.quantity
                        }
                    },
                    name: "Quantity",
                    className: "form-cell text-end"
                },
                { data: "unit", name: "Unit", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return data.itemCode + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>'
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemName", name: "ItemName", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return (data.inventoryCount == 0 ? "<span class='text-danger'>" : "")
                            + data.inventoryCount
                            + (data.inventoryCount == 0 ? "</span>" : "");
                    },
                    name: "InventoryCount",
                    className: "form-cell text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val().toLowerCase() == "draft" && user_access.canEdit) {
                            return '<input type="number" min="0" step="0.01" max="1999999.99" value="' + Round2Decimal(data.sellingPriceD) + '" class="form-control form-control-sm unitprice" style="width: 100%;" />';
                        } else {
                            return Round2Decimal(data.sellingPriceD)
                        }
                    },
                    name: "SellingPrice",
                    className: "form-cell text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val().toLowerCase() == "draft" && user_access.canEdit) {
                            return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + Round2Decimal(data.discount1D) + '" class="form-control form-control-sm discount1" /><span class="input-group-text">%</span></div>';
                        } else {
                            return Round2Decimal(data.discount1)
                        }
                    },
                    name: "Discount1",
                    className: "form-cell text-end"
                },
                {
                    data: function (data, type, dataToSet) {
                        if ($("#po-status").val().toLowerCase() == "draft" && user_access.canEdit) {
                            return '<div class="input-group input-group-sm" style="width: 100%;"><input type="number" step="0.01" min="0" max="100" value="' + Round2Decimal(data.discount2D) + '" class="form-control form-control-sm discount2" /><span class="input-group-text">%</span></div>';
                        } else {
                            return Round2Decimal(data.discount2D)
                        }
                    },
                    name: "Discount2",
                    className: "form-cell text-end"
                },
                { data: "grossPrice", name: "GrossPrice", className: "form-cell text-end grossprice" },
                { data: "servedQuantity", name: "ServedQuantity", className: "form-cell text-end servedquantity" },
                { data: "unservedQuantity", name: "UnservedQuantity", className: "form-cell text-end unservedquantity" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.quantityD != data.servedQuantityD + data.unservedQuantityD || data.unservedQuantityD != 0) {
                            if (user_access.canEdit) {
                                actions += '<button type="button" class="btn btn-warning btn-xs btn-update-serve" data-microtip-title="Update Served Item" data-microtip-position="top-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                            }
                        }
                        return actions;
                    },
                    className: "form-cell"
                }
            ],
            order: [[0, "asc"]],
            footerCallback: function (row, data, start, end, display) {
                var api = this.api(), data;

                columnDTTotalInteger(api, 1);
                columnDTTotalDecimal(api, 9);
                columnDTTotalInteger(api, 10);
                columnDTTotalInteger(api, 11);
            }
        });

        itemDT.on("draw", function () {
            if ($("#po-status").val().toLowerCase() == "submitted") {
                itemDT.column(0).visible(true); // remove button
                itemDT.column(10).visible(false); // served quantity
                itemDT.column(11).visible(false); // unserved quantity
                itemDT.column(12).visible(false); // update served quantity button
            } else if ($("#po-status").val().toLowerCase() == "approved") {
                itemDT.column(0).visible(false);
                itemDT.column(10).visible(true);
                itemDT.column(11).visible(true);
                itemDT.column(12).visible(true);
            } else {
                itemDT.column(0).visible(false);
                itemDT.column(10).visible(false);
                itemDT.column(11).visible(false);
                itemDT.column(12).visible(false);
            }
            //itemDT.ajax.reload();

            hideLoader();

            $(".btn-remove-item").on("click", function () {
                itemDT.row($(this).parents('tr')).remove().draw();
            });
            $(".table-item thead th").removeClass("form-cell");
            $(".table-item thead th").removeClass("text-end");
            $(".table-item thead th").removeClass("grossprice");

            //ComputeTotalQuantity();
            //ComputeTotalGrossPrice();
            $(".quantity, .unitprice, .discount1, .discount2").on("input", function () {
                var quantity = parseInt($(this).parents("tr").find(".quantity").val());
                var unit_price = parseFloat($(this).parents("tr").find(".unitprice").val());
                var discount1 = parseFloat($(this).parents("tr").find(".discount1").val());
                var discount2 = parseFloat($(this).parents("tr").find(".discount2").val());

                var gross_price = FormatStringDecimal(Round2Decimal(quantity * (((100 - discount1 - discount2) * unit_price) / 100)));
                $(this).parents("tr").find(".grossprice").html(gross_price);
                ComputeTotalQuantity();
                ComputeTotalGrossPrice();
            });

            if (user_access.canEdit) {
                $(".btn-update-serve").on("click", function () {
                    var itemdata = itemDT.row($(this).parents('tr')).data();
                    $("#served-code").data("id", itemdata.id);
                    $("#served-code").val(itemdata.itemCode);
                    $("#served-name").val(itemdata.itemName);
                    $("#served-quantity").val(itemdata.quantity);
                    $("#served-toadd").val(0);
                    $("#served-toadd").attr("max", itemdata.unservedQuantity);
                    $("#served-inventory").val(itemdata.inventoryCount);
                    $("#served-inventory").data("prime", itemdata.inventoryCount);
                    $("#served-served").val(itemdata.servedQuantity);
                    $("#served-served").data("prime", itemdata.servedQuantity);
                    $("#served-unserved").val(itemdata.unservedQuantity);
                    $("#served-unserved").data("prime", itemdata.unservedQuantity);
                    $("#servedModal").modal("show");
                });
            }
        });

        $("#served-toadd").on("input", function () {
            var toadd = parseInt($(this).val());
            var inventory = parseInt($("#served-inventory").data("prime"));
            var served = parseInt($("#served-served").data("prime"));
            var unserved = parseInt($("#served-unserved").data("prime"));
            if (toadd > unserved) {
                toadd = unserved;
            }
            if (toadd == 0) {
                $("#served-inventory").val(inventory);
                $("#served-served").val(served);
                $("#served-unserved").val(unserved);
            } else {
                $("#served-inventory").val(inventory + " → " + (inventory - toadd));
                $("#served-served").val(served + " → " + (served + toadd));
                $("#served-unserved").val(unserved + " → " + (unserved - toadd));
            }
        });

        if (user_access.canEdit) {
            $(".btn-update-served").on("click", function () {
                if (parseInt($("#served-toadd").val()) <= 0) {
                    toastr.warning("Nothing to add", "Served Quantity");
                } else if (parseInt($("#served-inventory").data("prime")) <= 0) {
                    toastr.warning($("#served-code").val() + " needs replenishment.", "Inventory Count");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("UpdateServedSOItem")",
                        data: {
                            salesOrderLineItemId: $("#served-code").data("id"),
                            quantity: $("#served-toadd").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                $("#servedModal").modal("hide");
                                itemDT.ajax.reload();
                                toastr.success(data.message, "Success");
                            }
                        }
                    });
                }
            });
        }

        function ComputeTotalQuantity() {
            total_quantity = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_quantity += parseInt($(this.node()).find(".quantity").val());
            });
            $(".total-quantity").html(FormatStringInteger(total_quantity));
        }

        function ComputeTotalGrossPrice() {
            total_gross_price = 0;
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                total_gross_price += parseFloat($(this.node()).find(".grossprice").html().replace(",", ""));
            });
            $(".total-gross-price").html(FormatStringDecimal(total_gross_price));
        }

        function GetItemsToOrder() {
            var item_to_replenish = [];
            itemDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_quantity = parseInt($(this.node()).find(".quantity").val());
                var row_unitprice = parseFloat($(this.node()).find(".unitprice").val());
                var row_discount1 = parseFloat($(this.node()).find(".discount1").val());
                var row_discount2 = parseFloat($(this.node()).find(".discount2").val());
                item_to_replenish.push({
                    item: row_data.itemId,
                    quantity: row_quantity,
                    unitPrice: row_unitprice,
                    discount1: row_discount1,
                    discount2: row_discount2
                });
            });
            return item_to_replenish;
        }

        if (user_access.canEdit) {
            $(".btn-details-draft").on("click", function () {
                SaveOrder("Draft");
            });

            $(".btn-details-submit").on("click", function () {
                SaveOrder("Submit");
            });

            function SaveOrder(status) {
                var itemsToReplenish = GetItemsToOrder();
                if (itemsToReplenish.length == 0) {
                    toastr.warning("No item to replenish. Add an item to the list to continue", "Warning");
                } else if (itemsToReplenish.filter(s => parseInt(s.quantity) === 0).length > 0) {
                    toastr.warning("Some items have 0 quantity. Can't replenish an item with 0 quantity", "Warning");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("SaveJson")",
                        data: {
                            Id: @Model?.Id,
                            Status: status,
                            Items: itemsToReplenish
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                window.location.reload();
                            }
                        }
                    });
                }
            }
        }

        if (user_access.canApproveDisapprove) {
            $('.btn-details-approve').click(function (e) {
                swal({
                    title: "Approve Sales Order",
                    text: "Continue to approve this sales order?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $('#approve-form').submit();
                    }
                });
            });

            $('.btn-details-disapprove').click(function (e) {
                swal({
                    title: "Disapprove Sales Order",
                    text: "Continue to disapprove this sales order?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                    content: {
                        element: "input",
                        attributes: {
                            placeholder: "Reason for Disapproving",
                            type: "text"
                        }
                    }
                }).then((confirm) => {
                    if (confirm !== null) {
                        $("#disapprove-reason").val(confirm);
                        $('#disapprove-form').submit();
                    }
                });
            });
        }

        if (user_access.canPrint) {
            $(".btn-details-print").on("click", function () {
                var print_company = $(this).data("company");
                $.LoadingOverlay("show", {
                    image: "",
                    fontawesome: "fas fa-print"
                });
                setTimeout(function () {
                    let win = window.open('@Url.Action("Print")/' + @Model?.Id + '?Company=' + print_company, '');
                    var wintimer = setInterval(function () {
                        if (win.closed) {
                            clearInterval(wintimer);
                            hideLoader();
                        }
                    }, 100);
                }, 500);
            });
        }
    </script>
}