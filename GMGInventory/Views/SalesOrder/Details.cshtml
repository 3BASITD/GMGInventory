    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Sales Order Item Served Quantity</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-md-6">
                        <div class="form-group">
                            <label for="served-code" class="form-label mb-0">Item Code</label>
                            <input type="text" id="served-code" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-group">
                            <label for="served-name" class="form-label mb-0">Item Name</label>
                            <input type="text" id="served-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        <div class="form-group">
                            <label for="served-quantity" class="form-label mb-0">Quantity</label>
                            <input type="text" id="served-quantity" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        <div class="form-group">
                            <label for="served-toadd" class="form-label mb-0">Served Quantity to Add</label>
                            <input type="number" min="0" max="1999999" id="served-toadd" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="form-group">
                            <label for="served-inventory" class="form-label mb-0">Inventory Count</label>
                            <input type="text" id="served-inventory" class="form-control form-control-sm" readonly="readonly" />
