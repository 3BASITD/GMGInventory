                        @Html.DisplayNameFor(model => model.CustomerName)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerAddress)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.CustomerAddress.Trim()) ? "-" : Model.CustomerAddress)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AccountStatus)
                    </span>
                    <b class="d-block">
                        @Model!.AccountStatus
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AgentCode)
                    </span>
                    <b class="d-block">
                        @Model?.AgentCode
                    </b>
                </p>
            </div>
            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OutstandingBalance)
