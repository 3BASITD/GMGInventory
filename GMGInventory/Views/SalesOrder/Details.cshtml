                </p>
                @* <p class="text-sm">
                <span class="text-muted">
                @Html.DisplayNameFor(model => model.GrossNetPrice)
                </span>
                <b class="d-block">
                @Model?.GrossNetPrice
                </b>
                </p> *@
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditTerms)
                    </span>
                    <b class="d-block">
                        @Model?.CreditTerms
                    </b>
                </p>
                @* <p class="text-sm">
                <span class="text-muted">
                @Html.DisplayNameFor(model => model.DeclaredValue)
                </span>
                <b class="d-block">
                @Model?.DeclaredValue
                </b>
                </p> *@
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.PONumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrEmpty(Model?.PONumber?.Trim()) ? "-" : Model.PONumber)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Region)
                    </span>
                    <b class="d-block">
                        @Model?.Region
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CommodityQuantity)
                    </span>
                    <b class="d-block">
