@model SalesOrderPrintVM

@{
    Layout = "";
    var title = "Sales Order";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <table class="formatted">
        <tr>
            <td colspan="2" rowspan="2" class="center-text">
                @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                {
                    <img src="~/images/BAS-02.png" class="logo" />
                } else
                {
                    <img src="~/images/GMG-01.png" class="logo" />
                }
            </td>
            <td colspan="4" rowspan="2">
                <dl>
                    <dt>Document Classification:</dt>
                    <dd>@title.ToUpper()</dd>
                    @if (Model.Status.ToLower() != "approved")
                    {
                        <dd>@("(" + Model.Status + ")")</dd>
                    }
                </dl>
            </td>
            <td colspan="3">
                <dl>
                    <dt>SO Date:</dt>
                    <dd>@Model.OrderDate</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td colspan="3">
                <dl>
                    <dt>SO No.:</dt>
                    <dd>@Model.SONumber</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td colspan="9">
                <div class="two-column">
                    <div class="column">
                        <div class="label">
                            <span>Customer:</span>
                            <strong class="detail">@Model.CustomerName</strong>
                        </div>
                        <div class="label">
                            <span>Contact Person:</span>
                            <strong class="detail">-</strong>
                        </div>
                        <div class="label">
                            <span>Contact No.:</span>
                            <strong class="detail">-</strong>
                        </div>
                        <div class="label">
                            <span>Address:</span>
                            <strong class="detail">@Model.CustomerAddress</strong>
                        </div>
                        <div class="label">
                            <span>Payment Terms:</span>
                            <strong class="detail">@Model.CreditTerms</strong>
                        </div>
                        <div class="label">
                            <span>Purchase Order #:</span>
                            <strong class="detail">@Model.PONumber</strong>
                        </div>
                    </div>
                    <div class="column">
                        <div class="label">
                            <span>Ship to:</span>
                            <strong class="detail"></strong>
                        </div>
                        <div class="label">
                            <span>Address:</span>
                            <strong class="detail"></strong>
                        </div>
                        <div class="label">
                            <span>Agent Name:</span>
                            <strong class="detail">@Model.AgentName</strong>
                        </div>
                        <div class="label">
                            <span>Forwarder:</span>
                            <strong class="detail">@Model.Forwarder</strong>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <th style="min-width: 10px;">#</th>
            <th style="min-width: 50px;">PART NUMBER</th>
            <th style="min-width: 25px;">SIZE</th>
            <th>ITEM DESCRIPTION</th>
            <th style="min-width: 50px;">QTY</th>
            <th style="min-width: 25px;">UOM</th>
            <th style="min-width: 50px;">UNIT PRICE</th>
            <th style="min-width: 50px;">DISCOUNT</th>
            <th style="min-width: 50px;">TOTAL</th>
        </tr>
        @for (var a = 1; a <= 19; a++)
        {
            var item = Model.Items.Where(s => s.LineNumber == a).FirstOrDefault();
            if (item != null)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    <td>@(string.IsNullOrWhiteSpace(item.ItemPartNumber) ? "-" : item.ItemPartNumber)</td>
                    <td>@item.ItemSize</td>
                    <td>@item.ItemName</td>
                    <td class="right-text"><nobr>@item.Quantity</nobr></td>
                    <td>@item.Unit</td>
                    <td>@item.SellingPrice</td>
                    <td>@item.Discount1 @item.Discount2</td>
                    <td class="right-text"><nobr>@item.GrossPrice</nobr></td>
                </tr>
            }
            else
            {
                <tr>
                    <td class="center-text" style="min-width: 10px;"><nobr>@a</nobr></td>
                    <td></td>
                    <td>@(Model.Items.Count() + 1 == a ? "* * NOTHING FOLLOWS * *" : "")</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            }
        }
        <tr>
            <td class="center-text" style="min-width: 10px;"><nobr>20</nobr></td>
            @{
                var twenties = Model.Items.Count(s => s.LineNumber >= 20);
            }
            @if (twenties == 0)
            {
                <td></td>
                <td>@(Model.Items.Count() == 19 ? "* * NOTHING FOLLOWS * *" : "")</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            }
            else if (twenties == 1)
            {
                var item = Model.Items.Where(s => s.LineNumber == 20).First();
                <td>@(string.IsNullOrWhiteSpace(item.ItemPartNumber) ? "-" : item.ItemPartNumber)</td>
                <td>-</td>
                <td>@item.ItemName</td>
                <td class="right-text"><nobr>@item.Quantity</nobr></td>
                <td>@item.Unit</td>
                <td>@item.SellingPrice</td>
                <td>@item.Discount1 @item.Discount2</td>
                <td class="right-text"><nobr>@item.GrossPrice</nobr></td>
            }
            else
            {
                var item = Model.Items.Where(s => s.LineNumber >= 20).ToList();
                <td></td>
                <td></td>
                <td>@(item.Count) more item(s)</td>
                <td class="right-text">@item.Sum(s => s.QuantityD)</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            }
        </tr>
        <tr>
            <td colspan="4">
                <dl>
                    <dt>Remarks:</dt>
                    <dd>@Model.Remarks</dd>
                </dl>
            </td>
            <td class="right-text"><nobr>@Model?.TotalQuantity</nobr></td>
            <td></td>
            <td></td>
            <td></td>
            <td class="right-text"><nobr>@Model?.TotalGrossPrice</nobr></td>
        </tr>
        <tr>
            <td colspan="9">
                <br />
                <br />
                <div class="two-column">
                    <div class="column center-text">
                        <dl>
                            <dd>@Model.UserCreated</dd>
                            <dt>Prepared By</dt>
                        </dl>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
                    {
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.ApprovedBy</dd>
                                <dt>Approved By</dt>
                            </dl>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                    {
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.DisapprovedBy</dd>
                                <dt>Disapproved By</dt>
                            </dl>
                        </div>
                    }
                </div>
            </td>
        </tr>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>