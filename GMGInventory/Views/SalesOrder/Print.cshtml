@model SalesOrderPrintVM

@{
    Layout = "";
    var title = "Sales Order";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <table class="formatted">
        <tr>
            <td rowspan="2" class="center-text" style="width: 100px;">
                @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                {
                    <img src="~/images/BAS-02.png" class="logo" />
                }
                else
                {
                    <img src="~/images/GMG-01.png" class="logo" />
                }
            </td>
            <td rowspan="2" style="width: 60%;">
                <dl>
                    <dt>Document Classification:</dt>
                    <dd>@title.ToUpper()</dd>
                    @if (Model.Status.ToLower() != "approved")
                    {
                        <dd>@("(" + Model.Status + ")")</dd>
                    }
                </dl>
            </td>
            <td style="width: 40%;">
                <dl>
                    <dt>SO Date:</dt>
                    <dd>@Model.OrderDate</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td>
                <dl>
                    <dt>SO No.:</dt>
                    <dd>@Model.SONumber</dd>
                </dl>
            </td>
        </tr>
        <tr>
            <td colspan="3">
                <div class="row-of-6">
                    <div class="col-1">
                        <span>Contact Person:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@(string.IsNullOrWhiteSpace(Model.CustomerContactPerson) ? "N/A" : Model.CustomerContactPerson)</strong>
                    </div>
                    <div class="col-1">
                        <span>Ship to:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">?</strong>
                    </div>
                </div>
                <div class="row-of-6">
                    <div class="col-1">
                        <span>Contact No.:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@(string.IsNullOrWhiteSpace(Model.CustomerContactNumber) ? "N/A" : Model.CustomerContactNumber)</strong>
                    </div>
                    <div class="col-1">
                        <span>Address:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">?</strong>
                    </div>
                </div>
                <div class="row-of-6">
                    <div class="col-1">
                        <span>Address:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "N/A" : Model.CustomerAddress)</strong>
                    </div>
                    <div class="col-1">
                        <span>Agent Name:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@Model.AgentName</strong>
                    </div>
                </div>
                <div class="row-of-6">
                    <div class="col-1">
                        <span>Payment Terms:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@Model.CreditTerms</strong>
                    </div>
                    <div class="col-1">
                        <span>Forwarder:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@Model.Forwarder</strong>
                    </div>
                </div>
                <div class="row-of-6">
                    <div class="col-1">
                        <span>Purchase Order #:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@(string.IsNullOrWhiteSpace(Model.PONumber) ? "N/A" : Model.PONumber)</strong>
                    </div>
                    <div class="col-1">
                        <span>Region:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@Model.Region</strong>
                    </div>
                </div>
                <div class="row-of-6">
                    <div class="col-3"></div>
                    <div class="col-1">
                        <span>RDD:</span>
                    </div>
                    <div class="col-2">
                        <strong class="detail">@Model.RequiredDeliveryDate</strong>
                    </div>
                </div>
            </td>
        </tr>
    </table>
    <table class="formatted">
        <thead>
            <tr>
                <th style="min-width: 10px;">#</th>
                <th style="min-width: 50px;">PART NUMBER</th>
                <th style="min-width: 25px;">SIZE</th>
                <th>ITEM DESCRIPTION</th>
                <th style="min-width: 50px;">QTY</th>
                <th style="min-width: 25px;">UOM</th>
                <th style="min-width: 50px;">UNIT PRICE</th>
                <th style="min-width: 50px;">DISCOUNT</th>
                <th style="min-width: 50px;">TOTAL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    <td>@(string.IsNullOrWhiteSpace(item.ItemPartNumber) ? "-" : item.ItemPartNumber)</td>
                    <td>@item.ItemSize</td>
                    <td>@item.ItemName</td>
                    <td class="center-text"><nobr>@item.Quantity</nobr></td>
                    <td>@item.Unit</td>
                    <td class="right-text">@item.SellingPrice</td>
                    <td class="right-text">@item.Discount1 @item.Discount2</td>
                    <td class="right-text"><nobr>@item.GrossPrice</nobr></td>
                </tr>
            }
            @{
                var itemCount = Model.Items.Count;
                var lastLineNumber = Model.Items.OrderByDescending(s => s.LineNumber).Select(s => s.LineNumber).First();
            }
            <tr>
                <td class="center-text" style="min-width: 10px;">@(lastLineNumber + 1)</td>
                <td></td>
                <td></td>
                <td>* * NOTHING FOLLOWS * *</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            @if (itemCount < 23)
            {
                for (var ctr = 2; ctr <= 23 - itemCount; ctr++)
                {
                    <tr>
                        <td class="center-text" style="min-width: 10px;">@(lastLineNumber + ctr)</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                }
            }
            <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th class="center-text"><nobr>@Model?.TotalQuantity</nobr></th>
                <th></th>
                <th></th>
                <th></th>
                <th class="right-text"><nobr>@Model?.TotalGrossPrice</nobr></th>
            </tr>
            <tr>
                <td colspan="9">
                    <dl>
                        <dt>Remarks:</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model?.Remarks) ? "N/A" : Model.Remarks)</dd>
                    </dl>
                </td>
            </tr>
            <tr>
                <td colspan="9">
                    <br />
                    <br />
                    <div class="two-column">
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.UserCreated</dd>
                                <dt>Prepared By</dt>
                            </dl>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ApprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.ApprovedBy</dd>
                                    <dt>Approved By</dt>
                                </dl>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DisapprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.DisapprovedBy</dd>
                                    <dt>Disapproved By</dt>
                                </dl>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>