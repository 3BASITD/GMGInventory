@model SalesOrderPrintVM

@{
    Layout = "";
    var title = "Sales Order";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
    <h3>@title</h3>
    <table class="table-header w100">
        <tr>
            <th>SO Number</th>
            <td>@Model?.SONumber</td>
            <th>@Html.DisplayNameFor(model => model.GrossNetPrice)</th>
            <td>@Model?.GrossNetPrice</td>
            <th>@Html.DisplayNameFor(model => model.SalesOrderBy)</th>
            <td>@Model?.SalesOrderBy</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.CustomerCode)</th>
            <td>@Model?.CustomerCode</td>
            <th>@Html.DisplayNameFor(model => model.CreditTerms)</th>
            <td>@Model?.CreditTerms</td>
            <th>@Html.DisplayNameFor(model => model.OrderDate)</th>
            <td>@Model?.OrderDate</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.CustomerName)</th>
            <td>@Model?.CustomerName</td>
            <th>@Html.DisplayNameFor(model => model.DeclaredValue)</th>
            <td>@Model?.DeclaredValue</td>
            @if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy) && Model.ApprovedDate != null)
            {
                <th>@Html.DisplayNameFor(model => model.ApprovedBy)</th>
                <td>@Model?.ApprovedBy</td>
            }
            else if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null)
            {
                <th>@Html.DisplayNameFor(model => model.DisapprovedBy)</th>
                <td>@Model?.DisapprovedBy</td>
            }
            else
            {
                <th>Status</th>
                <td><em>Not yet approved</em></td>
            }
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.CustomerAddress)</th>
            <td>@(string.IsNullOrWhiteSpace(Model?.CustomerAddress) ? "-" : Model.CustomerAddress)</td>
            <th>PO Number</th>
            <td>@(string.IsNullOrWhiteSpace(Model?.PONumber) ? "-" : Model.PONumber)</td>
            @if (!string.IsNullOrWhiteSpace(Model?.ApprovedBy) && Model.ApprovedDate != null)
            {
                <th>@Html.DisplayNameFor(model => model.ApprovedDate)</th>
                <td>@Model?.ApprovedDate</td>
            }
            else if (!string.IsNullOrWhiteSpace(Model?.DisapprovedBy) && Model.DisapprovedDate != null)
            {
                <th>@Html.DisplayNameFor(model => model.DisapprovedDate)</th>
                <td>@Model?.DisapprovedDate</td>
            }
            else
            {
                <th></th>
                <td></td>
            }
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.AgentName)</th>
            <td>@Model?.AgentName</td>
            <th>@Html.DisplayNameFor(model => model.Forwarder)</th>
            <td>@Model?.Forwarder</td>
            <th></th>
            <td></td>
        </tr>
    </table>


    <table class="table-items">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().Quantity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().Unit)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().ItemCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().ItemName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().InventoryCount)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().NetPrice)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().RetailPrice)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().SellingPrice)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().Discount1)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().Discount2)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Items.First().GrossPrice)
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Items == null)
            {
                <tr><td colspan="11">Empty record</td></tr>
            }
            else
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="right-text"><nobr>@item.Quantity</nobr></td>
                        <td><nobr>@item.Unit</nobr></td>
                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td class="right-text"><nobr>@item.InventoryCount</nobr></td>
                        <td class="right-text"><nobr>@item.NetPrice</nobr></td>
                        <td class="right-text"><nobr>@item.RetailPrice</nobr></td>
                        <td class="right-text"><nobr>@item.SellingPrice</nobr></td>
                        <td class="right-text"><nobr>@item.Discount1</nobr></td>
                        <td class="right-text"><nobr>@item.Discount2</nobr></td>
                        <td class="right-text"><nobr>@item.GrossPrice</nobr></td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <th class="right-text"><nobr>@Model?.TotalQuantity</nobr></th>
                <th colspan="9">Total</th>
                <th class="right-text"><nobr>@Model?.TotalGrossPrice</nobr></th>
            </tr>
        </tfoot>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = window.close;
</script>
</html>