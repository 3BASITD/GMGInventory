@model SalesOrderPrintVM

@{
    Layout = "";
    var title = "Sales Order";

    var submittedDisplay = DateTime.TryParse(Model.Details.SubmittedDate, out var submittedDate)
    ? submittedDate.ToString("MMMM dd, yyyy")
    : Model.Details.SubmittedDate;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMGInventory | @title</title>
    <link rel="icon" href="~/images/box.ico" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
    <style>
        @@media print {
            @@page {
                margin-left: 1.0in !important;
                margin-right: 1.0in !important;
            }
        }


        table.formatted dd, table.formatted strong.detail {
            font-size: 12px;
            margin: 5px 0;
            letter-spacing: 2px;
            font-weight: bold;
        }

    </style>
</head>
<body>
    <table class="formatted">
        <thead>
            <tr>
                <td colspan="10" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col center w-150px">
                            @if (TempData["CompanyLogo"]?.ToString() == "BAS")
                            {
                                <img src="~/images/BAS-02.png" class="logo" />
                            }
                            else
                            {
                                <img src="~/images/GMG-01.png" class="logo" />
                            }
                        </div>
                        <div class="sub-col center w-60pc p-50">
                            <span class="title">Document Classification:</span>
                            <span class="desc">
                                @title.ToUpper()
                                @if (Model.Details.Status.ToLower() != "approved")
                                {
                                    @("(" + Model.Details.Status + ")")
                                }
                            </span>
                        </div>
                        <div class="sub-col center w-40pc">
                            <span class="title">SO Date:</span>
                            <span class="desc">@Model.Details.OrderDate</span>
                            <hr />
                            <span class="title">Submitted Date:</span>
                            <span class="desc">@submittedDisplay</span>
                            <hr />
                            <span class="title">SO No.:</span>
                            <span class="desc">@Model.Details.SONumber</span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="10" style="padding:0;">
                    <div class="sub-header">
                        <div class="sub-col w-50pc">
                            <div class="label">
                                <span>Customer Name:</span>
                                <strong class="detail">@Model.Details.CustomerName</strong>
                            </div>
                            <div class="label">
                                <span>Contact Person:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.Details.CustomerContactPerson) ? "N/A" : Model.Details.CustomerContactPerson)</strong>
                            </div>
                            <div class="label">
                                <span>Contact No.:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.Details.CustomerContactNumber) ? "N/A" : Model.Details.CustomerContactNumber)</strong>
                            </div>
                            <div class="label">
                                <span>Address:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.Details.CustomerAddress) ? "N/A" : Model.Details.CustomerAddress)</strong>
                            </div>
                            <div class="label">
                                <span>Payment Terms:</span>
                                <strong class="detail">@Model.Details.CreditTerms</strong>
                            </div>
                            <div class="label">
                                <span>Purchase Order #:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.Details.PONumber) ? "N/A" : Model.Details.PONumber)</strong>
                            </div>
                            <div class="label">
                                <span>With L/P:</span>
                                <strong class="detail">@Model.Details.WithLP</strong>
                            </div>
                            <div class="label">
                                <span>With REYCO Non-Defective:</span>
                                <strong class="detail">@Model.Details.WithREYCONonDefective</strong>
                            </div>
                            <div class="label">
                                <span>With REYCO JIT L/P Delivery:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.Details.WithREYCOJITLPDelivery) ? "N/A" : Model.Details.WithREYCOJITLPDelivery)</strong>
                            </div>
                        </div>
                        <div class="sub-col w-50pc">
                            <div class="label">
                                <span>Ship To:</span>
                                <strong class="detail"></strong>
                            </div>
                            <div class="label">
                                <span>Address:</span>
                                <strong class="detail"></strong>
                            </div>
                            <div class="label">
                                <span>Agent Code:</span>
                                <strong class="detail">@Model.Details.AgentCode</strong>
                            </div>
                            <div class="label">
                                <span>Agent Name:</span>
                                <strong class="detail">@Model.Details.AgentName</strong>
                            </div>
                            <div class="label">
                                <span>Forwarder:</span>
                                <strong class="detail">@Model.Details.Forwarder</strong>
                            </div>
                            <div class="label">
                                <span>Region:</span>
                                <strong class="detail">@Model.Details.Region</strong>
                            </div>
                            <div class="label">
                                <span>RDD:</span>
                                <strong class="detail">@Model.Details.RequiredDeliveryDate</strong>
                            </div>
                            <div class="label">
                                <span>SLA:</span>
                                <strong class="detail">@(string.IsNullOrWhiteSpace(Model.Details.ServiceLevelAgreement) ? "N/A" : Model.Details.ServiceLevelAgreement)</strong>
                            </div>
                            <div class="label">
                                <span>Overall Discount:</span>
                                <strong class="detail">@Model.Details.OverallDiscount</strong>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="10">
                    <dl>
                        <dt>Remarks:</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Details.Remarks) ? "N/A" : Model.Details.Remarks)</dd>
                    </dl>
                </td>
            </tr>
            <tr>
                <td colspan="10">
                    <dl>
                        <dt>Special Instruction:</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Details.SpecialInstruction) ? "N/A" : Model.Details.SpecialInstruction)</dd>
                    </dl>
                </td>
            </tr>
            <tr>
                <th style="min-width: 10px;">#</th>
                <th style="min-width: 50px;">PART NUMBER</th>
                <th style="min-width: 25px;">SIZE</th>
                <th>ITEM DESCRIPTION</th>
                <th style="min-width: 50px;">QTY</th>
                <th style="min-width: 25px;">UOM</th>
                <th style="min-width: 50px;">UNIT PRICE</th>
                <th style="min-width: 50px;">DISCOUNT</th>
                <th style="min-width: 50px;">TOTAL</th>
                <th style="min-width: 50px;">UNSERVED</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="center-text"><nobr>@item.LineNumber</nobr></td>
                    <td>@(string.IsNullOrWhiteSpace(item.ItemPartNumber) ? "-" : item.ItemPartNumber)</td>
                    <td>@item.ItemSize</td>
                    <td>@item.ItemName</td>
                    <td class="center-text"><nobr>@item.Quantity</nobr></td>
                    <td>@item.Unit</td>
                    <td class="right-text">@item.SellingPrice</td>
                    @{
                        var discounts = new List<string>();
                        if (item.Discount1D > 0) discounts.Add(item.Discount1+ "%");
                        if (item.Discount2D > 0) discounts.Add(item.Discount2 + "%");
                        if (item.Discount3D > 0) discounts.Add(item.Discount3 + "%");
                        if (item.Discount4D > 0) discounts.Add(item.Discount4 + "%");
                        if (item.Discount5D > 0) discounts.Add(item.Discount5 + "%");
                    }
                    <td class="right-text">@string.Join("; ", discounts)</td>
                    <td class="right-text"><nobr>@item.GrossPrice</nobr></td>
                    <td class="right-text"><nobr>@item.UnservedQuantity</nobr></td>
                </tr>
            }
            @{
                var itemCount = Model.Items.Count;
                var lastLineNumber = Model.Items.OrderByDescending(s => s.LineNumber).Select(s => s.LineNumber).First();
            }
            <tr>
                <td class="center-text" style="min-width: 10px;">@(lastLineNumber + 1)</td>
                <td></td>
                <td></td>
                <td>* * NOTHING FOLLOWS * *</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            @if (itemCount < 20)
            {
                for (var ctr = 2; ctr <= 20 - itemCount; ctr++)
                {
                    <tr>
                        <td class="center-text" style="min-width: 10px;">@(lastLineNumber + ctr)</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                }
            }
            <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th class="center-text"><nobr>@Model.TotalQuantity</nobr></th>
                <th></th>
                <th></th>
                <th></th>
                <th class="right-text"><nobr>@Model.TotalGrossPrice</nobr></th>
                <th></th>
            </tr>
            <tr>
                <td colspan="10">
                    <br />
                    <br />
                    <div class="two-column">
                        <div class="column center-text">
                            <dl>
                                <dd>@Model.Details.UserCreated</dd>
                                <dt>Prepared By</dt>
                            </dl>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Details.ApprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.Details.ApprovedBy</dd>
                                    <dt>Approved By</dt>
                                </dl>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Details.DisapprovedBy))
                        {
                            <div class="column center-text">
                                <dl>
                                    <dd>@Model.Details.DisapprovedBy</dd>
                                    <dt>Disapproved By</dt>
                                </dl>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</body>
<script type="text/javascript">
    window.print();
    window.onafterprint = function () {
        setTimeout(function () {
            window.close();
        }, 100);
    };
</script>
</html>