@model IEnumerable<SalesOrderVM>

@{
    ViewData["Title"] = "Sales Orders";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
           
            @if (userAccess.CanAdd)
            {
                <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Create">
                    <span class="fas fa-plus"></span> New Sales Order
                </a>
            }
            <button class="btn btn-secondary btn-sm float-right ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-order">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PurchaseRequestDetail)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerAddress)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Area)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Region)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RequiredDeliveryDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Forwarder)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent Code</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Order Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Order Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="filter-status" class="control-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setFullYear(dt_from.getFullYear() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setFullYear(dt_to.getFullYear() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

        var loadfilterloaded = false;
        function LoadFilterSelect2() {
            if (loadfilterloaded) return;
            loadfilterloaded = true;

            // Load Select2 for Agent
            $("#filter-agent").select2({
                minimumInputLength: 1,
                allowClear: true,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetOptions2", "Agent")"
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-agent").on("select2:select", function () {
                $("#filter-agent-name").val($(this).select2("data")[0].name);
            });

            $("#filter-agent").on("select2:unselecting", function (e) {
                $("#filter-agent-name").val("");
            });

            // Load Select2 for Customer
            $("#filter-customer").select2({
                minimumInputLength: 1,
                allowClear: true,
                placeholder: '<All>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetOptions", "Customer")"
                },
                dropdownParent: $("#filterModal")
            });

            $("#filter-customer").on("select2:select", function () {
                $("#filter-customer-name").val($(this).select2("data")[0].name);
            });

            $("#filter-customer").on("select2:unselecting", function (e) {
                $("#filter-customer-name").val("");
            });

            // Load region data for select2
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Region")",
                success: function (data, status, xhr) {
                    $("#filter-region").select2({
                        ajax: null, //already fetched outside
                        allowClear: true,
                        placeholder: '<All>',
                        data: data,
                        minimumResultsForSearch: Infinity
                    });
                }
            });

            // Load forwarder data for select2 on edit
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "Forwarder")",
                success: function (data, status, xhr) {
                    $("#delivery-forwarder").select2({
                        ajax: null, //already fetched outside
                        data: data,
                        allowClear: true,
                        placeholder: {
                            id: "",
                            text: "<All>"
                        },
                        dropdownParent: $("#editModal")
                    });
                }
            });

            // Load status data for select2
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetStatusOptions")",
                success: function (data, status, xhr) {
                    $("#filter-status").select2({
                        ajax: null, //already fetched outside
                        allowClear: true,
                        placeholder: '<All>',
                        data: data,
                        minimumResultsForSearch: Infinity
                    });
                }
            });
        }

        $(".btnFilter").on("click", function () {
            orderDT.ajax.reload();
            $("#filterModal").modal("hide");
        });

        var orderDT = $('.table-order').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    var customerId = $("#filter-customer").val();
                    var regionId = $("#filter-region").val();

                    if (agentId) data.AgentId = agentId;
                    if (customerId) data.CustomerId = customerId;
                    if (regionId) data.RegionId = regionId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                    data.Status = $("#filter-status").val();
                },
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "soNumber", name: "SONumber" },
                { data: "purchaseRequestDetail", name: "PurchaseRequestDetail" },
                { data: "customer", name: "Customer" },
                { data: "customerAddress", name: "CustomerAddress" },
                { data: "area", name: "Area" },
                { data: "region", name: "Region" },
                { data: "orderDate", name: "OrderDate" },
                { data: "requiredDeliveryDate", name: "RequiredDeliveryDate" },
                { data: "forwarder", name: "Forwarder" },
                { data: "totalAmount", name: "TotalAmount", className: "text-end" },
                { data: "status", name: "Status" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '"  data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        if (data.status.toLowerCase() == "submitted" && data.orderBy == $("#current-user-nickname").val() && user_access.canDelete) {
                            actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button"  data-microtip-title="Delete Sales Order" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                        }
                        if  (user_access.canAdd &&  data.isAllPacked != true && data.status.toLowerCase() != "draft" && data.status.toLowerCase() != "submitted" && data.status.toLowerCase() != "disapproved") {
                            //actions += '<button data-id="' + data.id + '" class="btn btn-primary btn-xs packBtn" type="button" data-microtip-title="Start Packing" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-box-open"></span></button>';
                            actions += '<a href="@Url.Action("Create", "Pack")/' + data.id + '?page=SalesOrder" class="btn btn-primary btn-xs packBtn" type="button" data-microtip-title="Start Packing" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-box-open"></span></a>';
                        }
                        return actions + "</div>";
                    }
                }
            ],
            order: [[5, "desc"], [6, "desc"]]
        });

        orderDT.on("draw", function () {
            hideLoader();

            LoadFilterSelect2();

            $('.deleteBtn').click(function (e) {
                swal({
                    title: "Delete Draft",
                    text: "Are you sure you want to delete this order?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("DeleteJson")",
                            data: {
                                Id: $(this).data("id")
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Error") {
                                    toastr.error(data.message, "Error");
                                } else {
                                    orderDT.ajax.reload();
                                }
                            }
                        });
                    }
                });
            });
        });

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-agent").val()) { urlQuery.push("AgentId=" + $("#filter-agent").val()); }
                if ($("#filter-customer").val()) { urlQuery.push("CustomerId=" + $("#filter-customer").val()); }
                if ($("#filter-region").val()) { urlQuery.push("RegionId=" + $("#filter-region").val()); }

                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());
                urlQuery.push("Status=" + $("#filter-status").val());


                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }
    </script>
}