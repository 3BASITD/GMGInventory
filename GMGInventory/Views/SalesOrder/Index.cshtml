@model IEnumerable<SalesOrderVM>

@{
    ViewData["Title"] = "Sales Orders";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                <span class="fas fa-plus"></span> New Sales Order
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-order">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Customer)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ApprovedDisapprovedBy)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ApprovedDisapprovedDate)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var orderDT = $('.table-order').on('preXhr.dt', function (e, settings, data) {
                showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                { data: "soNumber", name: "SONumber" },
                { data: "customer", name: "Customer" },
                { data: "orderDate", name: "OrderDate" },
                { data: "totalAmount", name: "TotalAmount", className: "text-end" },
                { data: "status", name: "Status" },
                { data: "approvedDisapprovedBy", name: "ApprovedDisapprovedBy" },
                { data: "approvedDisapprovedDate", name: "ApprovedDisapprovedDate" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '"  data-microtip-title="View Details" data-microtip-position="left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                        if (data.status == "Submitted" && data.orderBy == $("#current-user-nickname").val()) {
                            actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button"  data-microtip-title="Delete Sales Order" data-microtip-position="left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                        }
                        if (data.status == "Approved" && (userIsInRole("Invoicing Clerk") || userIsInRole("System Admin"))) {
                            actions += '<button data-id="' + data.id + '" class="btn btn-primary btn-xs packBtn" type="button" data-microtip-title="Start Packing" data-microtip-position="left" role="tooltip"><i class="fas fa-box-open"></i></button>';
                        }
                        return actions + "</div>";
                    }
                }
            ],
            order: [[2, "desc"]]
        });

        orderDT.on("draw", function () {
            hideLoader();

            DatatablesSearchOnEnter('.table-order', orderDT);

            $('.deleteBtn').click(function (e) {
                swal({
                    title: "Delete Draft",
                    text: "Are you sure you want to delete this order?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("DeleteJson")",
                            data: {
                                Id: $(this).data("id")
                            },
                            error: jQueryCommonError,
                            success: function (data, status, xhr) {
                                if (data.status == "Error") {
                                    toastr.error(data.message, "Error");
                                } else {
                                    toastr.success(data.message, "Success");
                                    orderDT.ajax.reload();
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}