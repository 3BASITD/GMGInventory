@model IEnumerable<SalesOrderVM>

@{
    ViewData["Title"] = "Sales Orders";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
           
            @if (userAccess.CanAdd)
            {
                <a class="btn btn-primary btn-sm float-right ml-2" asp-action="Create">
                    <span class="fas fa-plus"></span> New Sales Order
                </a>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="New Sales Order&#10;Add access is required"
                        data-microtip-position="top-left"
                        role="tooltip">
                    <span class="fas fa-plus mr-0"></span>
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right ml-2 btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled"
                        data-microtip-title="Download&#10;Download access is required"
                        data-microtip-position="top-left"
                        role="tooltip">
                    <span class="fas fa-download mr-0"></span>
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-order">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderQueueNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PurchaseRequestDetail)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Priority)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomerAddress)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Area)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Region)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RequiredDeliveryDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Forwarder)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent Code</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-filedby" class="form-label mb-0">Filed By</label>
                            <select id="filter-filedby" class="form-select form-select-sm">
                                <option value="everyone">Everyone</option>
                                <option value="me">Only by Me</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="control-label mb-0">Status</label>
                            <select id="filter-status" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Order Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Order Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Agent
        $("#filter-agent").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Agent")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-agent").on("select2:select", function () {
            $("#filter-agent-name").val($(this).select2("data")[0].name);
        });

        $("#filter-agent").on("select2:unselecting", function (e) {
            $("#filter-agent-name").val("");
        });

        // Load Select2 for Customer
        $("#filter-customer").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions", "Customer")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-customer").on("select2:select", function () {
            $("#filter-customer-name").val($(this).select2("data")[0].name);
        });

        $("#filter-customer").on("select2:unselecting", function (e) {
            $("#filter-customer-name").val("");
        });

        // Load Select2 for Region
        $("#filter-region").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Region")"
            },
            dropdownParent: $("#filterModal"),
            minimumResultsForSearch: -1
        });

        $("#filter-region").on("select2:select", function () {
            $("#filter-region-name").val($(this).select2("data")[0].name);
        });

        $("#filter-region").on("select2:unselecting", function (e) {
            $("#filter-region-name").val("");
        });

        // Load Select2 for Status
        $("#filter-status").select2({
            allowClear: true,
            placeholder: {
                id: "",
                text: "ALL"
            },
            ajax: {
                url: "@Url.Action("GetStatusOptions2")"
            },
            dropdownParent: $("#filterModal"),
            minimumResultsForSearch: -1
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        $(".btnFilter").on("click", function () {
            $("#filterModal").modal("hide");
            orderDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        });

        $(".btnReset").on("click", function () {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            orderDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        });

        var defaultDTState = {
            order: [[0, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            AgentId: "",
            AgentCode: "",
            AgentName: "",
            CustomerId: "",
            CustomerCode: "",
            CustomerName: "",
            RegionId: "",
            Region: "",
            FiledBy: "everyone",
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo()),
            StatusId: "",
            Status: ""
        };

        function checkDTChanged() {
            if(!orderDT) return false;
            
            return JSON.stringify(orderDT.order()) != JSON.stringify(defaultDTState.order) ||
                   orderDT.page.info().start != defaultDTState.page ||
                   orderDT.page.len() != defaultDTState.length ||
                   (orderDT.search() || "") != defaultDTState.search.search ||
                   $("#filter-agent").val() != defaultDTState.AgentId ||
                   $("#filter-customer").val() != defaultDTState.CustomerId ||
                   $('#filter-region').val() != defaultDTState.RegionId ||
                   $('#filter-filedby').val() != defaultDTState.FiledBy ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo ||
                   $('#filter-status').val() != defaultDTState.StatusId;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);

            $("#filter-agent").val(defaultDTState.AgentId).trigger('change');
            $("#filter-agent-name").val(defaultDTState.AgentName);
            $("#filter-customer").val(defaultDTState.CustomerId).trigger('change');
            $("#filter-customer-name").val(defaultDTState.CustomerName);
            $('#filter-region').val(defaultDTState.RegionId).trigger('change');
            $('#filter-filedby').val(defaultDTState.FiledBy);
            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            $('#filter-status').val(defaultDTState.StatusId).trigger('change');
            
            if (orderDT) {
                orderDT.state.clear();
                orderDT.order(defaultDTState.order);
                orderDT.page(defaultDTState.page);
                orderDT.search(defaultDTState.search.search);
            }
        }

        var orderDT = $('.table-order').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.AgentId = $('#filter-agent').val();
                data.AgentCode = $('#filter-agent option:selected').text();
                data.AgentName = $('#filter-agent-name').val();
                data.CustomerId = $('#filter-customer').val();
                data.CustomerCode = $('#filter-customer option:selected').text();
                data.CustomerName = $('#filter-customer-name').val();
                data.RegionId = $('#filter-region').val();
                data.Region = $('#filter-region option:selected').text();
                data.FiledBy = $('#filter-filedby').val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $("#filter-from").val();
                data.DateTo = $("#filter-to").val();
                data.StatusId = $("#filter-status").val();
                data.Status = $('#filter-status option:selected').text();
            },
            stateLoadParams: function (settings, data) {
                if(data.AgentId) {
                    var agentOption = new Option(data.AgentCode, data.AgentId, true, true);
                    $(agentOption).data('data', {
                        id: data.AgentId,
                        text: data.AgentCode,
                        name: data.AgentName
                    });
                    $("#filter-agent").append(agentOption).trigger('change');
                    $("#filter-agent-name").val(data.AgentName);
                }
                if(data.CustomerId) {
                    var customerOption = new Option(data.CustomerCode, data.CustomerId, true, true);
                    $(customerOption).data('data', {
                        id: data.CustomerId,
                        text: data.CustomerCode,
                        name: data.CustomerName
                    });
                    $("#filter-customer").append(customerOption).trigger('change');
                    $("#filter-customer-name").val(data.CustomerName);
                }
                if(data.RegionId) {
                    var regionOption = new Option(data.Region, data.RegionId, true, true);
                    $(regionOption).data('data', {
                        id: data.RegionId,
                        text: data.Region
                    });
                    $("#filter-region").append(regionOption).trigger('change');
                }
                if(data.FiledBy != "me") data.FiledBy = "everyone";
                $('#filter-filedby').val(data.FiledBy);
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
                if(data.StatusId) {
                    var statusOption = new Option(data.Status, data.StatusId, true, true);
                    $(statusOption).data('data', {
                        id: data.StatusId,
                        text: data.Status
                    });
                    $("#filter-status").append(statusOption).trigger('change');
                }
            },
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    if (agentId) data.AgentId = agentId;

                    var customerId = $("#filter-customer").val();
                    if (customerId) data.CustomerId = customerId;

                    var regionId = $("#filter-region").val();
                    if (regionId) data.RegionId = regionId;

                    data.FiledBy = $("#filter-filedby").val();
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();

                    var statusId = $("#filter-status").val();
                    if (statusId) data.Status = statusId;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "soNumber", name: "SONumber", responsivePriority: 2 },
                {
                    data: function (data, type, dataToSet) {
                        if(data.orderQueueNumber)
                            return `<a href="/OrderQueue/Details/${data.orderQueueNumber}" class="link-info" target="_blank">${data.orderQueueNumber}</a>`;
                        else
                            return '<span class="text-muted">N/A</span>';
                    },
                    name: "OrderQueueNumber",
                    responsivePriority: 11
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.purchaseRequestDetail || '<span class="text-muted">N/A</span>';
                    },
                    name: "PurchaseRequestDetail",
                    responsivePriority: 12
                },
                {
                    data: function (data, type, dataToSet) {
                        return `<a href="/Customer/Details/${data.customerId}" class="link-info" target="_blank">${data.customerCode}</a>`;
                    },
                    name: "CustomerCode",
                    responsivePriority: 3
                },
                { data: "customerName", name: "CustomerName", responsivePriority: 13 },
                { data: "priority", name: "Priority", responsivePriority: 14 },
                {
                    data: function (data, type, dataToSet) {
                        return data.customerAddress || '<span class="text-muted">N/A</span>';
                    },
                    name: "CustomerAddress",
                    responsivePriority: 15
                },
                { data: "area", name: "Area", responsivePriority: 4 },
                { data: "region", name: "Region", responsivePriority: 5 },
                { data: "orderDate", name: "OrderDate", responsivePriority: 6 },
                { data: "requiredDeliveryDate", name: "RequiredDeliveryDate", responsivePriority: 7 },
                {
                    data: function (data, type, dataToSet) {
                        return data.forwarder || '<span class="text-muted">N/A</span>';
                    },
                    name: "Forwarder",
                    responsivePriority: 8
                },
                { data: "totalAmount", name: "TotalAmount", className: "text-end", responsivePriority: 9 },
                { data: "status", name: "Status", responsivePriority: 10 },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '"  data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        // if (data.status.toLowerCase() == "draft" && user_access.canDelete) {
                        //     actions += '<button type="button" data-id="' + data.id + '" class="btn btn-danger btn-xs" onclick="DeleteDraft(this)" data-microtip-title="Delete Sales Order" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                        // }
                        if  (user_access.canAdd &&  data.isAllPacked != true && data.status.toLowerCase() != "draft" && data.status.toLowerCase() != "submitted" && data.status.toLowerCase() != "disapproved") {
                            //actions += '<button data-id="' + data.id + '" class="btn btn-primary btn-xs packBtn" type="button" data-microtip-title="Start Packing" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-box-open"></span></button>';
                            actions += '<a href="@Url.Action("Create", "Pack")/' + data.id + '?page=SalesOrder" class="btn btn-primary btn-xs packBtn" type="button" data-microtip-title="Start Packing" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-box-open"></span></a>';
                        }
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order
        });

        orderDT.on("draw", function () {
            checkDefaultFilter();
        });

        if (user_access.canDelete) {
            function DeleteDraft(elem) {
                var row = $(elem).parents("tr");
                var rowData = orderDT.row(row).data();

                swal({
                    title: "Delete Draft Sales Order",
                    text: "Are you sure you want to permanently delete this draft sales order?",
                    icon: "success",
                    buttons: true,
                    successMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("DeleteDraft")",
                            data: {
                                Id: rowData.id
                            },
                            success: function (data, status, xhr) {
                                if (data.status == "Error") {
                                    toastr.error(data.message, "Error");
                                } else {
                                    window.location.reload();
                                }
                            }
                        });
                    }
                });
            };
        }

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-agent").val()) { urlQuery.push("AgentId=" + $("#filter-agent").val()); }
                if ($("#filter-customer").val()) { urlQuery.push("CustomerId=" + $("#filter-customer").val()); }
                if ($("#filter-region").val()) { urlQuery.push("RegionId=" + $("#filter-region").val()); }

                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());
                urlQuery.push("Status=" + $("#filter-status").val());


                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }
    </script>
}