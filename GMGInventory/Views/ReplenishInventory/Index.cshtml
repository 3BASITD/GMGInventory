@model IEnumerable<PurchaseOrderVM>

@{
    ViewData["Title"] = "Replenish Inventory";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                    <span class="fas fa-plus"></span> New Replenish Order
                </a>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-replenish">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Supplier)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PONumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderBy)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Destination)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TotalAmount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Status)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ReferenceNumber)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        var replenishDT = $('.table-replenish').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListDTJson")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "supplier", name: "Supplier" },
                { data: "poNumber", name: "PONumber" },
                { data: "orderDate", name: "OrderDate" },
                { data: "orderBy", name: "OrderBy" },
                { data: "destination", name: "Destination" },
                { data: "totalAmount", name: "TotalAmount", className: "text-end" },
                { data: "status", name: "Status" },
                { data: "referenceNumber", name: "ReferenceNumber" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        if (data.status.toLowerCase() == "draft" && data.orderBy == $("#current-user-nickname").val()) {
                            if (user_access.canDelete) {
                                actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" type="button" data-microtip-title="Delete Draft" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                            }
                        }
                        return actions + "</div>";
                    },
                    responsivePriority: 1
                }
            ],
            order: [[2, "desc"]]
        });

        replenishDT.on("draw", function () {
            hideLoader();
            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete Draft",
                        text: "Are you sure you want to delete this draft record?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            $.ajax({
                                type: "POST",
                                url: "@Url.Action("DeleteDraftJson")",
                                data: {
                                    Id: $(this).data("id")
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Error") {
                                        toastr.error(data.message, "Error");
                                    } else {
                                        toastr.success(data.message, "Success");
                                        replenishDT.ajax.reload();
                                    }
                                }
                            });
                        }
                    });
                });
            }
        });
    </script>
}