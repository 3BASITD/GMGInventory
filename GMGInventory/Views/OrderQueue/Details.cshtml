@model OrderQueueDetailsVM

@{
    ViewData["Title"] = "Order Queue Details";
    ViewData["TitleDetails"] = $"[{Model.OrderNumber}]";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="OrderQueue" asp-action="Index">Order Queue</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title po-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @* @if (Model.Status.ToLower().Contains("pending"))
            {
                @if (userAccess.CanEdit == false)
                {
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Ignore All&#10;Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-broom"></span> 
                    </button>
                }
                else if(Model.IsValidAgent == false
                     || Model.IsValidCustomer == false)
                     //|| Model.Items.Any(s=>s.IsValidItem == false))
                {
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Ignore All&#10;Record contains invalid data." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-broom"></span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2" onclick="MarkIgnoreOrder()">
                        <span class="fas fa-broom"></span> Ignore All
                    </button>
                }
            }
            else
            {
                <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Ignore All&#10;Action not allowed, only permitted for pending status" data-microtip-position="bottom-left" role="tooltip">
                    <span class="fas fa-broom"></span>
                </button>
            } *@
            @if (Model.Status.ToLower().Contains("pending") || Model.Status.ToLower().Contains("partial"))
            {
                @if (userAccess.CanEdit == false)
                {
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Ignore Selected&#10;Edit access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-broom"></span> 
                    </button>
                }
                else if(Model.IsValidAgent == false
                     || Model.IsValidCustomer == false)
                     //|| Model.Items.Any(s=>s.IsValidItem == false))
                {
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Ignore Selected&#10;Record contains invalid data." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-broom"></span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-danger btn-sm float-right ml-2" onclick="IgnoreOrderItem()">
                        <span class="fas fa-broom"></span> Ignore Selected
                    </button>
                }
            }
            else
            {
                <button type="button" class="btn btn-danger btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Ignore Selected&#10;Action not allowed, only permitted for pending status" data-microtip-position="bottom-left" role="tooltip">
                    <span class="fas fa-broom"></span>
                </button>
            }
            @* @if (Model.Status.ToLower().Contains("ignored") == false) *@
            
            @if (Model.Status.ToLower().Contains("pending") || Model.Status.ToLower().Contains("partial"))
            {
                @if (userAccess.CanAdd == false)
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Add Selected to Sales Order&#10;Add access is required." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-plus"></span>
                    </button>
                }
                else if(Model.IsValidAgent == false
                     || Model.IsValidCustomer == false)
                     //|| Model.Items.Any(s => s.IsValidItem == false))
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Add Selected to Sales Order&#10;Record contains invalid data." data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-plus"></span>
                    </button>
                }
                else if(Model.Items.Where(s => s.SalesOrderNumber != null).Count() == Model.Items.Count())
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Add Selected to Sales Order&#10;Nothing to add anymore. All items have been added to the sales order" data-microtip-position="bottom-left" role="tooltip">
                        <span class="fas fa-plus"></span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-success btn-sm float-right ml-2" onclick="AddToSalesOrder()">
                        <span class="fas fa-plus"></span> Add Selected to Sales Order
                    </button>
                }
            }
            else
            {
                <button type="button" class="btn btn-success btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Add Selected to Sales Order&#10;Action not allowed, order is already marked ignore." data-microtip-position="bottom-left" role="tooltip">
                    <span class="fas fa-plus"></span>
                </button>
            }
            <a class="btn btn-light btn-sm float-right ml-2" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 text-sm">
                <span class="text-muted">
                    @Html.DisplayNameFor(model => model.OrderNumber)
                </span>
                <b class="d-block">
                    @Model.OrderNumber
                </b>
            </div>
            <div class="col-md-4 text-sm">
                <span class="text-muted">
                    @Html.DisplayNameFor(model => model.Agent)
                </span>
                <b class="d-block">
                    @if (Model.IsValidAgent == false)
                    {
                        <span class="text-danger" data-microtip-title="Invalid Agent: Unknown PK_@Model.AgentId" data-microtip-position="right" role="tooltip">
                            @(string.IsNullOrWhiteSpace(Model.Agent) ? Html.Raw("<span class='fw-normal text-warning'>N/A</span>") : Model.Agent)
                            &emsp;<span class="fas fa-exclamation-triangle"></span>
                        </span>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Agent))
                    {
                        @Html.ActionLink(Model.Agent,
                                        "Details",
                                        "Agent", 
                                        new { id = Model.AgentId }, 
                                        new { @class = "text-info", 
                                              role = "tooltip",
                                              target = "_blank" })
                    }
                    else
                    {
                        <span class="fw-normal text-muted">N/A</span>
                    }
                </b>
            </div>
            <div class="col-md-4 text-sm">
                <span class="text-muted">
                    @Html.DisplayNameFor(model => model.Customer)
                </span>
                <b class="d-block">
                    @if (Model.IsValidCustomer == false)
                    {
                        <span class="text-danger" data-microtip-title="Invalid Customer: Unknown PK_@Model.CustomerId" data-microtip-position="right" role="tooltip">
                            @(string.IsNullOrWhiteSpace(Model.Customer) ? Html.Raw("<span class='fw-normal text-warning'>N/A</span>") : Model.Customer)
                            &emsp;<span class="fas fa-exclamation-triangle"></span>
                        </span>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Customer))
                    {
                        @Html.ActionLink(Model.Customer,
                                        "Details",
                                        "Customer", 
                                        new { id = Model.CustomerId }, 
                                        new { @class = "text-info", 
                                              role = "tooltip",
                                              target = "_blank" })
                    } 
                    else
                    {
                        <span class="fw-normal text-muted">N/A</span>
                    }
                </b>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 text-sm">
                <span class="text-muted">
                    @Html.DisplayNameFor(model => model.Instruction)
                </span>
                <b class="d-block">
                    @(string.IsNullOrWhiteSpace(Model.Instruction) ? Html.Raw("<span class='fw-normal text-muted'>N/A</span>") : Model.Instruction)
                </b>
            </div>
            <div class="col-md-8 text-sm">
                <span class="text-muted">
                    @Html.DisplayNameFor(model => model.Status)
                </span>
                <b class="d-block">
                    @(string.IsNullOrWhiteSpace(Model.Status) ? Html.Raw("<span class='fw-normal text-muted'>N/A</span>") : Html.Raw(Model.Status))
                </b>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Order Queue Item(s)</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" class="checkall" /></th>
                                    <th>Item Code</th>
                                    <th>Old Item Code</th>
                                    <th>Item Name</th>
                                    <th>Item Class</th>
                                    <th>Brand</th>
                                    <th>Model</th>
                                    <th>Size</th>
                                    <th>Part Number</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Unit Price</th>
                                    <th>Discount</th>
                                    <th>Extended Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            @if (Model.IsValidAgent == false ||
                                                 Model.IsValidCustomer == false)
                                            {
                                                <span class="text-danger" data-microtip-title="Cannot select this row because of invalid record. Please fix the Invalid Agent / Customer first." data-microtip-position="right" role="tooltip">
                                                    <span class="fas fa-exclamation-triangle"></span>
                                                </span>
                                            }
                                            else if (item.IsValidItem == false)
                                            {
                                                <span class="text-warning" data-microtip-title="Cannot select this row because of invalid data. Please fix the Invalid Item first." data-microtip-position="right" role="tooltip">
                                                    <span class="fas fa-exclamation-triangle"></span>
                                                </span>
                                            }
                                            else if(item.SalesOrderNumber != null && item.SalesOrderNumber.ToLower().Contains("ignored"))
                                            {
                                                <span class="text-danger" data-microtip-title="This item is ignored and can no longer be selected to add to a sales order." data-microtip-position="right" role="tooltip">
                                                    <span class="fas fa-times"></span>
                                                </span>
                                            } 
                                            else if(string.IsNullOrWhiteSpace(item.SalesOrderNumber) == false)
                                            {
                                                @Html.ActionLink(item.SalesOrderNumber,
                                                                 "Details",
                                                                 "SalesOrder", 
                                                                 new { id = item.SalesOrderId }, 
                                                                 new { @class = "text-info", 
                                                                       role = "tooltip",
                                                                       target = "_blank" })
                                            } 
                                            else
                                            {
                                                var checkRowGroup = item.ItemClass == null ? "null" : item.ItemClass.Replace(" ", "").ToLower();
                                                <input type="checkbox" class="checkrow checkrowgroup-@checkRowGroup" data-row-id="@item.Id" data-row-item-class="@item.ItemClass" />
                                            }
                                        </td>
                                        <td>@item.Code</td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.OldCode) 
                                            ? Html.Raw("<span class='text-muted'>N/A</span>") 
                                            : item.OldCode)
                                        </td>
                                        <td>
                                            @if (item.IsValidItem == false)
                                            {
                                                <span class="text-warning" data-microtip-title="Invalid Item: Unknown PK_@item.ItemId" data-microtip-position="right" role="tooltip">
                                                    @item.ItemName&emsp;<span class="fas fa-exclamation-triangle"></span>
                                                </span>
                                            }
                                            else
                                            {
                                                @item.ItemName
                                            }
                                        </td>
                                        @* <td data-order="@(string.IsNullOrWhiteSpace(item.ItemClass) ? "0" : "1_" + item.ItemClass)"> *@
                                            <td>
                                            @(string.IsNullOrWhiteSpace(item.ItemClass) 
                                            ? Html.Raw("<span class='text-muted'>N/A</span>") 
                                            : item.ItemClass)
                                        </td>
                                        <td>@item.Brand</td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Model) 
                                            ? Html.Raw("<span class='text-muted'>N/A</span>") 
                                            : item.Model)
                                        </td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Size) 
                                            ? Html.Raw("<span class='text-muted'>N/A</span>") 
                                            : item.Size)
                                        </td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.PartNumber) 
                                            ? Html.Raw("<span class='text-muted'>N/A</span>") 
                                            : item.PartNumber)
                                        </td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td>@item.Unit</td>
                                        <td class="text-end">@item.UnitPrice</td>
                                        <td>@item.Discount1%; @item.Discount2%; @item.Discount3%; @item.Discount4%; @item.Discount5%</td>
                                        <td class="text-end">@item.ExtendedPrice</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    @{
                                        var totalQuantity = string.Format("{0:#,##0}",Model.Items.Sum(s => s.QuantityD));
                                        var totalPrice = string.Format("{0:#,##0.00}",Model.Items.Sum(s => s.ExtendedPriceD));
                                    }
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th>Total</th>
                                    <th class="text-end">@totalQuantity</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th class="text-end">@totalPrice</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var order_details = @Html.Raw(Json.Serialize(Model));

        var itemDT = $('.table-item').DataTable({
            paging: false,
            order: [[1, "asc"]],
            orderFixed: [[4, 'asc']],
            columnDefs: [
                {
                    targets: 4,
                    visible: false,
                    render: function (data, type, row) {
                        if (type === 'sort') {
                            if (data == null ||
                                data.includes('N/A')) {
                                return '';
                            }
                            return $('<div>').html(data).text().toLowerCase();
                        }
                        return data;
                    }
                },
                {
                    targets: [2, 5, 6, 7, 8],
                    render: function(data, type, row, meta) {
                        if (type == "sort") {
                            var text = $('<div>').html(data).text().trim();

                            if (!text || text.toLowerCase() == "n/a") {
                                return "\uffff";
                            }
                            return text;
                        }
                        return data;
                    }
                }
            ],
            rowGroup: {
                startRender: function (rows, group) {
                    var normalizedGroup = group.trim().toLowerCase();

                    var isNoGroup = normalizedGroup == "no group";
                    var isInvalid = normalizedGroup == "invalid item";

                    var groupLabel = isNoGroup ? "<span class='text-muted'>N/A</span>" : 
                                     isInvalid ? `<span class='text-warning fw-normal'>
                                                    No Item Class because Item is invalid
                                                  </span>` :
                                     group;
                    var groupCheckbox = isNoGroup ? "<input type='checkbox' class='checkgroup checkgroup-null float-right' />" :
                                        isInvalid ? `<span class='text-warning fw-normal float-right'>
                                                    <span class='fas fa-exclamation-triangle'></span>
                                                  </span>` :
                                        "<input type='checkbox' class='checkgroup checkgroup-" + normalizedGroup.replace(" ", "") + " float-right' />";
                    return $('<tr/>').append('<td colspan="4"><strong>Item Class:&emsp;' + groupLabel + '</strong></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td>' + groupCheckbox + '</td>');
                },
                dataSrc: function (row) {
                    var value = $(row[4]).text().trim().toLowerCase();
                    return value == "no group" || value == "n/a" ? "No Group" : row[4];
                }
            }
        });

        $(document).on("change", ".checkall", function() {
            $(".checkrow").prop("checked", $(this).prop("checked"));
            $(".checkgroup").prop("checked", $(this).prop("checked"));
        });

        $(document).on("change", ".checkgroup", function() {
            var classList = $(this).attr("class");
            var groupName = classList.split(" ").find(c => c.startsWith("checkgroup-")).replace("checkgroup-", "");
            
            $(".checkrowgroup-" + groupName).prop("checked", $(this).prop("checked"));

            checkCheckboxIfAll();
        });

        $(document).on("change", ".checkrow", function() {
            var classList = $(this).attr("class");
            var groupName = classList.split(" ").find(c => c.startsWith("checkrowgroup-")).replace("checkrowgroup-", "");
            
            var rows_group_count = $(".checkrowgroup-" + groupName).length;
            var checked_group_count = $(".checkrowgroup-" + groupName + ":checked").length;

            if(checked_group_count == 0) {
                $(".checkgroup-" + groupName).prop("checked", false);
                $(".checkgroup-" + groupName).prop("indeterminate", false);
            } else if(checked_group_count == rows_group_count) {
                $(".checkgroup-" + groupName).prop("checked", true);
                $(".checkgroup-" + groupName).prop("indeterminate", false);
            } else {
                $(".checkgroup-" + groupName).prop("checked", false);
                $(".checkgroup-" + groupName).prop("indeterminate", true);
            }

            checkCheckboxIfAll();
        });

        function checkCheckboxIfAll() {
            var rows_count = $(".checkrow").length;
            var checked_count = $(".checkrow:checked").length;
            if(checked_count == 0) {
                $(".checkall").prop("checked", false);
                $(".checkall").prop("indeterminate", false);
            } else if(checked_count == rows_count) {
                $(".checkall").prop("checked", true);
                $(".checkall").prop("indeterminate", false);
            } else {
                $(".checkall").prop("checked", false);
                $(".checkall").prop("indeterminate", true);
            }

            const class_types = [...new Set(
                $(".checkrow:checked").map(function () {
                    return $(this).data("row-item-class");
                }).get()
            )];
            // if (class_types.length > 1) {
            //     swal({
            //         icon: 'warning',
            //         title: 'v4 Enhancement',
            //         text: atob("WW91IGFyZSB1c2luZyBhIHY0IGVuaGFuY2VtZW50IGZlYXR1cmUuIFRoaXMg") + atob("bWVzc2FnZSB3aWxsIGJlIHJlbW92ZWQgb25jZSB2NCBpcyBjb21wbGV0ZWQg") + atob("YW5kIG1hZGUgYXZhaWxhYmxlIGFzIGEgZnVsbHkgcGFpZCB2ZXJzaW9uLg=="),
            //         button: 'Continue'
            //     });
            //}
        }

        if (user_access.canAdd) {
            function AddToSalesOrder() {
                var row_selected = $(".checkrow:checked").map(function () {
                                                                  return $(this).data("row-id");
                                                              }).get();
                if (row_selected.length == 0) {
                    toastr.warning("Select at least one row to proceed with adding to the sales order", "No selected row");
                } else {
                    var timesAdded = "";
                    // if (order_details.convertTimes > 0) {
                    //     timesAdded += " <strong>This order already added " + order_details.convertTimes + " time(s)</strong>, adding it again might result to duplicate sales order.";
                    // }

                    swal({
                        title: "Add Selected to Sales Order",
                        content: {
                            element: "div",
                            attributes: {
                                style: "color: black;text-align: center;",
                                innerHTML: "Are you sure you want to add the selected item(s) to sales order?" + timesAdded
                            }
                        },
                        icon: "info",
                        buttons: true
                    }).then((confirm) => {
                        if (confirm) {
                            $.ajax({
                                url: "@Url.Action("Add")",
                                type: "POST",
                                data: {
                                    OrderNumber: order_details.orderNumber,
                                    ItemIds: row_selected
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        //swal.close();
                                        window.location.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        //toastr.error(data.message, data.status);
                                        ToastrAndConsoleError(data.status, data.message);
                                    }
                                }
                            });
                        }
                    });
                }
            }
        }

        if (user_access.canEdit) {
            // function MarkIgnoreOrder(ordernum) {
            //     swal({
            //         title: "Ignore All",
            //         text: "Are you sure you want to mark this order record to ignore?",
            //         icon: "error",
            //         buttons: true,
            //         dangerMode: true
            //     }).then((confirm) => {
            //         if (confirm) {
            //             $.ajax({
            //                 url: "@Url.Action("MarkIgnoreOrder")",
            //                 type: "POST",
            //                 data: {
            //                     OrderNumber: order_details.orderNumber
            //                 },
            //                 success: function (data, status, xhr) {
            //                     if (data.status == "Success") {
            //                         //swal.close();
            //                         window.location.reload();
            //                         toastr.success(data.message, data.status);
            //                     } else {
            //                         //toastr.error(data.message, data.status);
            //                         ToastrAndConsoleError(data.status, data.message);
            //                     }
            //                 }
            //             });
            //         }
            //     });
            // };
            
            function IgnoreOrderItem() {
                var row_selected = $(".checkrow:checked").map(function () {
                                                                  return $(this).data("row-id");
                                                              }).get();
                if (row_selected.length == 0) {
                    toastr.warning("Select at least one row to proceed with ignoring item", "No selected row");
                } else {
                    var timesAdded = "";
                    // if (order_details.convertTimes > 0) {
                    //     timesAdded += " <strong>This order already added " + order_details.convertTimes + " time(s)</strong>, adding it again might result to duplicate sales order.";
                    // }

                    swal({
                        title: "Ignore Selected Item",
                        content: {
                            element: "div",
                            attributes: {
                                style: "color: black;text-align: center;",
                                innerHTML: "Are you sure you want to ignore the selected item(s)?" + timesAdded
                            }
                        },
                        icon: "info",
                        buttons: true
                    }).then((confirm) => {
                        if (confirm) {
                            $.ajax({
                                url: "@Url.Action("Ignore")",
                                type: "POST",
                                data: {
                                    OrderNumber: order_details.orderNumber,
                                    ItemIds: row_selected
                                },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        //swal.close();
                                        window.location.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        //toastr.error(data.message, data.status);
                                        ToastrAndConsoleError(data.status, data.message);
                                    }
                                }
                            });
                        }
                    });
                }
            }
        }
    </script>
}