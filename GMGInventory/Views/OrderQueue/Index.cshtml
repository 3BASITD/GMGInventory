@model IEnumerable<OrderQueueVM>

@{
    ViewData["Title"] = "Order Queue";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right btn-filter" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-orders">
            <thead>
                <tr>
                    <th>Order Number</th>
                    <th>Agent</th>
                    <th>Customer</th>
                    <th>Extended Price</th>
                    <th>Status</th>
                    <th>Date Created</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-status" class="form-label mb-0">Status</label>
                            <select id="filter-status" class="form-control form-control-sm">
                                <option value="">All</option>
                                <option value="Pending">Pending</option>
                                <option value="PartialAdded">Added Partially</option>
                                <option value="FullAdded">Fully Added</option>
                                <option value="PartialIgnored">Ignored Partially</option>
                                <option value="FullIgnored">Fully Ignored</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        $("#filter-preset").val("L7D");
        $("#filter-from").val(DateForInput(getFilterDefaultDateFrom()));
        $("#filter-to").val(DateForInput(getFilterDefaultDateTo()));

        $("#filter-to").on("focusout", function () {
            var from = $("#filter-from").val();
            var to = $("#filter-to").val();

            if (from && to && new Date(from) > new Date(to))
                $("#filter-to").val(from);
        });

        $("#filter-from").on("focusout", function () {
            var from = $("#filter-from").val();
            var to = $("#filter-to").val();

            if (from && to && new Date(from) > new Date(to))
                $("#filter-from").val(to);
        });

        $("#filter-preset").on("change", function() {
            applyFilterPreset($(this).val());
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            orderDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            orderDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            Status: "",
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo())
        };

        function checkDTChanged() {
            if(!orderDT) return false;
            
            return JSON.stringify(orderDT.order()) != JSON.stringify(defaultDTState.order) ||
                   orderDT.page.info().start != defaultDTState.page ||
                   orderDT.page.len() != defaultDTState.length ||
                   (orderDT.search() || "") != defaultDTState.search.search ||
                   $('#filter-status').val() != defaultDTState.Status ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);
            
            $('#filter-status').val(defaultDTState.Status);
            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            
            if (orderDT) {
                orderDT.state.clear();
                orderDT.order(defaultDTState.order);
                orderDT.page(defaultDTState.page);
                orderDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        var orderDT = $('.table-orders').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                const saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.Status = $("#filter-status").val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $("#filter-from").val();
                data.DateTo = $("#filter-to").val();
            },
            stateLoadParams: function (settings, data) {
                $('#filter-status').val(data.Status);
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetOrdersDT")",
                type: "POST",
                data: function (data) {
                    data.Status = $("#filter-status").val();
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "orderNumber", name: "OrderNumber" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.isValidAgent == false) {
                            return `
                                <span class="text-warning" data-microtip-title="Invalid Agent: Unknown PK_${data.agentId}" data-microtip-position="right" role="tooltip">
                                    ${data.agent || "<span class='fw-normal text-muted'>N/A</span>"}
                                    &emsp;<span class="fas fa-exclamation-triangle"></span>
                                </span>`;
                        } else {
                            return data.agent || "<span class='fw-normal text-muted'>N/A</span>";
                        }
                    },
                    name: "Agent"
                },
                {
                    data: function (data, type, dataToSet) {
                        if (data.isValidCustomer == false) {
                            return `
                                <span class="text-warning" data-microtip-title="Invalid Customer: Unknown PK_${data.customerId}" data-microtip-position="right" role="tooltip">
                                    ${data.customer || "<span class='fw-normal text-muted'>N/A</span>"}
                                    &emsp;<span class="fas fa-exclamation-triangle"></span>
                                </span>`;
                        } else {
                            return data.customer || "<span class='fw-normal text-muted'>N/A</span>";
                        }
                    },
                    name: "Customer"
                },
                { data: "extendedPrice", name: "ExtendedPrice" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.status.toLowerCase().includes("partial")) {
                            return `
                                <span data-microtip-title="Added Count / Ignored Count / Item Count" data-microtip-position="right" role="tooltip">
                                    ${data.addedCount}/${data.ignoredCount}/${data.itemCount}
                                </span>`;
                        } else {
                            return data.status;
                        }
                    },
                    name: "Status"
                },
                { data: "dateCreated", name: "DateCreated" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.orderNumber + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        actions += '</div>';
                        return actions;
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order
        });

        orderDT.on("draw", function () {
            checkDefaultFilter();
        });

        if (user_access.canAdd) {
            function AddToSalesOrder(ordernum, count) {
                var timesAdded = "";
                if (count > 0) {
                    timesAdded += " <strong>This order already added " + count + " time(s)</strong>, adding it again might result to duplicate sales order.";
                }

                swal({
                    title: "Add to Sales Order",
                    content: {
                        element: "div",
                        attributes: {
                            style: "color: black;text-align: center;",
                            innerHTML: "Are you sure you want to add this record to sales order?" + timesAdded
                        }
                    },
                    icon: "info",
                    buttons: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("Add")",
                            type: "POST",
                            data: { OrderNumber: ordernum },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    swal.close();
                                    orderDT.ajax.reload();
                                    toastr.success(data.message, data.status);
                                } else {
                                    //toastr.error(data.message, data.status);
                                    ToastrAndConsoleError(data.status, data.message);
                                }
                            }
                        });
                    }
                });
            };
        }

        if (user_access.canEdit) {
            function MarkIgnoreOrder(ordernum) {
                swal({
                    title: "Ignore Order",
                    text: "Are you sure you want to mark this record to ignore?",
                    icon: "info",
                    buttons: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("MarkIgnoreOrder")",
                            type: "POST",
                            data: { OrderNumber: ordernum },
                            success: function (data, status, xhr) {
                                if (data.status == "Success") {
                                    swal.close();
                                    orderDT.ajax.reload();
                                    toastr.success(data.message, data.status);
                                } else {
                                    //toastr.error(data.message, data.status);
                                    ToastrAndConsoleError(data.status, data.message);
                                }
                            }
                        });
                    }
                });
            };
        }
    </script>
}