@{
    ViewData["Title"] = "New Warehouse Transfer";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Transfer" asp-action="Index">Warehouse Transfer</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label for="transfer-source" class="form-label mb-0">Source Warehouse</label>
                        <select id="transfer-source" name="Source" class="form-control select2"></select>
                        <span data-valmsg-for="transfer-source" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="transfer-destination" class="form-label mb-0">Destination Warehouse</label>
                        <select id="transfer-destination" name="Destination" class="form-control select2"></select>
                        <span data-valmsg-for="transfer-destination" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label for="transfer-date" class="form-label mb-0">Transfer Date</label>
                        <input type="date" id="transfer-date" name="TransferDate" class="form-control form-control-sm" />
                        <span data-valmsg-for="transfer-date" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="transfer-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="transfer-remarks" name="Remarks" class="form-control form-control-sm" />
                        <span data-valmsg-for="transfer-remarks" data-valmsg-replace="true" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <div class="card">
                        <div class="card-header bg-light source-name"></div>
                        <div class="card-body p-3">
                            <div class="form-group">
                                <label for="source-code" class="form-label mb-0">Code</label>
                                <select id="source-code" name="Code" class="form-control select2"></select>
                                <span data-valmsg-for="source-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="source-name" class="form-label mb-0">Name</label>
                                <input type="text" id="source-name" name="Name" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="source-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="source-current-quantity" class="form-label mb-0">Current Quantity</label>
                                <input type="number" min="0" max="1999999" id="source-current-quantity" name="CurrentQuantity" class="form-control form-control-sm" readonly="readonly" />
                                <span data-valmsg-for="source-current-quantity" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="source-transfer-quantity" class="form-label mb-0">Transfer Quantity</label>
                                <input type="number" min="0" max="1999999" id="source-transfer-quantity" name="TransferQuantity" class="form-control form-control-sm" />
                                <span data-valmsg-for="source-transfer-quantity" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="source-unit" class="form-label mb-0">Unit</label>
                                <input type="text" id="source-unit" name="Unit" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                            <div class="form-group">
                                <button class="btn btn-outline-warning">
                                    <i class="fas fa-angle-double-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-9">
                    <div class="card">
                        <div class="card-header bg-light destination-name"></div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item-destination">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Source Quantity</th>
                                        <th>Transfer Quantity</th>
                                        <th>Unit</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        // Load warehouse data for select2
        var warehouseOption;
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Warehouse")",
            success: function (data, status, xhr) {
                warehouseOption = data;
                // Load Select2 Source
                $("#transfer-source").select2({
                    data: warehouseOption
                });

                // Load Select2 Destination
                $("#transfer-destination").select2({
                    data: warehouseOption.filter(s => s.id !== $("#transfer-source").val())
                });
                ReloadTransferItemHeader();

                $("#transfer-source").on("select2:select", function () {
                    if ($("#transfer-destination").attr("data-select2-id")) {
                        $("#transfer-destination").select2("destroy");
                        $("#transfer-destination").empty();
                    }
                    $("#transfer-destination").select2({
                        data: warehouseOption.filter(s => s.id !== $("#transfer-source").val())
                    });
                    ReloadTransferItemHeader();
                });

                $("#transfer-destination").on("select2:select", function () {
                    ReloadTransferItemHeader();
                });
            }
        });

        function ReloadTransferItemHeader() {
            //sourceDT.ajax.reload();
            LoadSourceItems();
            $(".source-name").html($("#transfer-source option:selected").text() + "'s Available Item(s)");
            $(".destination-name").html("Transfer Item(s) to " + $("#transfer-destination option:selected").text());
        }

        function LoadSourceItems() {
            if ($("#source-code").attr("data-select2-id")) {
                $("#source-code").select2("destroy");
                $("#source-code").empty();
            }
            $("#source-code").select2({
                minimumInputLength: 1,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return (repo.text !== repo.name ? "(" + repo.text + ") " : "") + repo.name;
                },
                ajax: {
                    url: "@Url.Action("GetInWarehouseOptions", "Item")",
                    dataType: 'json',
                    type: "POST",
                    data: function (params) {
                        return {
                            search: params.term,
                            page: params.page || 1,
                            warehouse: $("#transfer-source").val()
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 50) < data.total_count
                            }
                        };
                    },
                    cache: true
                }
            });

            $("#source-code").on("select2:select", function () {
                $("#source-name").val($("#source-code").select2("data")[0].name);
                $("#source-current-quantity").val($("#source-code").select2("data")[0].quantity);
                $("#source-transfer-quantity").val($("#source-code").select2("data")[0].quantity);
                $("#source-unit").val($("#source-code").select2("data")[0].unit);
            });
        }

