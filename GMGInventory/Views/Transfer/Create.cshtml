@{
    ViewData["Title"] = "New Warehouse Transfer";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Transfer" asp-action="Index">Warehouse Transfer</a></li>
}

<form id="form-transfer">
    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                @if (userAccess.CanEdit)
                {
                    <button type="submit" class="btn btn-primary btn-sm float-right ml-2">
                        <span class="fas fa-dolly-flatbed"></span> Transfer Item
                    </button>
                }
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="transfer-source" class="form-label mb-0">Source Warehouse</label>
                        <select id="transfer-source" name="Source" style="width: 100%;"></select>
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="transfer-destination" class="form-label mb-0">Destination Warehouse</label>
                        <select id="transfer-destination" name="Destination" style="width: 100%;"></select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="transfer-date" class="form-label mb-0">Transfer Date</label>
                        <input type="date" id="transfer-date" name="TransferDate" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="transfer-remarks" class="form-label mb-0">Remarks</label>
                        <input type="text" id="transfer-remarks" name="Remarks" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <span class="card-title">Transfer Item(s)</span>
                            <div class="card-tools">
                                @if (userAccess.CanAdd)
                                {
                                    <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#addModal">
                                        <span class="fas fa-plus"></span> Add Replenish Item
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <table class="table table-head-fixed table-striped table-hover table-item-destination">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Source Quantity</th>
                                        <th>Transfer Quantity</th>
                                        <th>Unit</th>
                                        <th>Location Code</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@if (userAccess.CanAdd)
{
    <!-- Save Transfer Modal -->
    <div class="modal fade" id="addModal" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Transfer Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="form-item">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="source-code" class="form-label mb-0">Code</label>
                            <select id="source-code" name="Code" style="width: 100%;"></select>
                        </div>
                        <div class="form-group">
                            <label for="source-name" class="form-label mb-0">Name</label>
                            <input type="text" id="source-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                        <div class="form-group">
                            <label for="source-current-quantity" class="form-label mb-0">Current Quantity</label>
                            <input type="number" value="0" min="0" max="1999999" id="source-current-quantity" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                        <div class="form-group">
                            <label for="source-transfer-quantity" class="form-label mb-0">Transfer Quantity</label>
                            <input type="number" value="0" min="0" max="1999999" id="source-transfer-quantity" name="TransferQuantity" class="form-control form-control-sm" />
                        </div>
                        <div class="form-group">
                            <label for="source-unit" class="form-label mb-0">Unit</label>
                            <input type="text" id="source-unit" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                        <div class="form-group">
                            <label for="source-location-" class="form-label mb-0">Location Code</label>
                            <select id="source-location" name="LocationCode" style="width: 100%;"></select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 Location Code
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "LocationCode")",
            success: function (data, status, xhr) {
                $("#source-location").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "<none>"
                    },
                    dropdownParent: $('#addModal')
                });
            }
        });

        // Load warehouse data for select2
        var warehouseOption;
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Warehouse")",
            success: function (data, status, xhr) {
                warehouseOption = data;
                // Load Select2 Source
                $("#transfer-source").select2({
                    ajax: null, //already fetched outside
                    data: warehouseOption,
                    minimumResultsForSearch: -1,
                    templateResult: function (repo) {
                        if (repo.loading) {
                            return repo.text;
                        }
                        return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                    },
                });

                // Load Select2 Destination
                $("#transfer-destination").select2({
                    ajax: null, //already fetched outside
                    data: warehouseOption.filter(s => s.id !== $("#transfer-source").val()),
                    minimumResultsForSearch: -1,
                    templateResult: function (repo) {
                        if (repo.loading) {
                            return repo.text;
                        }
                        return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                    },
                });
                ReloadTransferItem();

                $("#transfer-source").on("select2:select", function () {
                    if ($("#transfer-destination").attr("data-select2-id")) {
                        $("#transfer-destination").select2("destroy");
                        $("#transfer-destination").empty();
                    }
                    $("#transfer-destination").select2({
                        ajax: null, //already fetched outside
                        data: warehouseOption.filter(s => s.id !== $("#transfer-source").val()),
                        minimumResultsForSearch: -1,
                        templateResult: function (repo) {
                            if (repo.loading) {
                                return repo.text;
                            }
                            return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                        },
                    });
                    ReloadTransferItem();
                });

                $("#transfer-destination").on("select2:select", function () {
                    ReloadTransferItem();
                });
            }
        });

        function ReloadTransferItem() {
            LoadSourceItems();
            destinationDT.clear().draw();
            $("#source-location").val("").trigger("change");
        }

        function LoadSourceItems() {
            AddItemFormReset();
            if ($("#source-code").attr("data-select2-id")) {
                $("#source-code").select2("destroy");
                $("#source-code").empty();
            }

            $("#source-code").select2({
                //minimumInputLength: 1,
                placeholder: '<empty>',
                templateResult: function (repo) {
                    if (repo.loading) {
                        return repo.text;
                    }
                    return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
                },
                ajax: {
                    url: "@Url.Action("GetInWarehouseOptions", "Item")",
                    data: function (params) {
                        let base = $.fn.select2.defaults.defaults.ajax.data(params);
                        return Object.assign(base, {
                            warehouse: $("#transfer-source").val()
                        });
                    }
                },
                dropdownParent: $("#addModal")
            });

            $("#source-code").on("select2:select", function () {
                $("#source-name").val($("#source-code").select2("data")[0].name);
                $("#source-current-quantity").val($("#source-code").select2("data")[0].quantityD);
                $("#source-transfer-quantity").val($("#source-code").select2("data")[0].quantityD);
                $("#source-unit").val($("#source-code").select2("data")[0].unit);
            });
         }

        // Validation for Add Item Modal
        var validateAdd = $("#form-item").validate({
            rules: {
                Code: { required: true },
                TransferQuantity: {
                    required: true,
                    isNotZero: true,
                    lessThanOrEqual: "#source-current-quantity"
                }
            },
            messages: {
                Code: { required: "Please select item to transfer." },
                TransferQuantity: {
                    required: "Please enter a quantity",
                    isNotZero: "Can not transfer an item with 0 quantity",
                    lessThanOrEqual: "Can not transfer more than the source quantity"
                },
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                AddItem();
            }
        });

        function AddItem() {
            var rowIndexes = [];
            destinationDT.rows(function (idx, data, node) {
                if (data.id == $("#source-code").select2("data")[0].id) {
                    rowIndexes.push(idx);
                }
                return false;
            });
            if (rowIndexes.length > 0) {
                toastr.warning($("#source-code").select2("data")[0].text + " has already been added", "Duplicate");
            } else {
                destinationDT.row.add({
                    id: $("#source-code").select2("data")[0].id,
                    code: $("#source-code").select2("data")[0].text,
                    name: $("#source-code").select2("data")[0].name,
                    sourceQuantity: $("#source-code").select2("data")[0].quantity,
                    transferQuantity: $("#source-transfer-quantity").val() || 0,
                    unit: $("#source-code").select2("data")[0].unit,
                    locationCode: $("#source-location").select2("data")[0].text,
                    locationCodeId: $("#source-location").select2("data")[0].id,
                }).draw();

                toastr.success("Added " + $("#source-code").select2("data")[0].text + " on Transfer Item(s)", "Success");
                AddItemFormReset();
            }
        }

        function AddItemFormReset() {
            $("#source-code").val("").trigger("change");
            $("#source-name").val("");
            $("#source-current-quantity").val("0");
            $("#source-transfer-quantity").val("0");
            $("#source-unit").val("");
            $("#source-location").val("").trigger("change");
        }

        if (user_access.canAdd) {
            $(".createBtn").on("click", function () {
                AddItemFormReset();
            });
        }
        // Validation for Create Modal
        var validateCreate = $("#form-transfer").validate({
            rules: {
                TransferDate: { required: true },
                Remarks: { maxlength: 500 }
            },
            messages: {
                TransferDate: { required: "Please enter date of transfer." },
                Remarks: { maxlength: "Sales Return must not exceed 500 characters" }
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                SaveTransfer();
            }
        });

        var destinationDT = $('.table-item-destination').DataTable({
            data: [],
            filter: true,
            responsive: true,
            autoWidth: false,
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (user_access.canEdit) {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-item" data-microtip-title="Remove Item" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-minus"></span></button>';
                        }
                        return actions;
                    }
                },
                { data: "code", name: "Code", className: "form-cell" },
                { data: "name", name: "Name", className: "form-cell" },
                { data: "sourceQuantity", name: "SourceQuantity", className: "form-cell" },
                {
                    data: function (data, type, dataToSet) {
                        return '<input type="number" min="0" max="' + data.sourceQuantity + '" value="' + data.transferQuantity + '" class="form-control form-control-sm" style="width: 100%;" />';
                    },
                    name: "TransferQuantity"
                },
                { data: "unit", name: "Name", className: "form-cell" },
                { data: "locationCode", name: "LocationCode", className: "form-cell" },
                { data: "locationCodeId", name: "LocationCodeId", className: "form-cell",visible: false },
            ]
        });

        destinationDT.on("draw", function () {
            $(".btn-remove-item").on("click", function () {
                destinationDT.row($(this).parents('tr')).remove().draw();
            });
            $(".table-item-destination th").removeClass("form-cell");
        });

        function GetItemsToTransfer() {
            var item_to_transfer = [];
            destinationDT.rows().every(function (rowIdx, tableLoop, rowLoop) {
                var row_data = this.data();
                var row_input = parseInt($(this.node()).find("input").val());
                item_to_transfer.push({
                    id: row_data.id,
                    quantity: row_input,
                    locationCodeId: row_data.locationCodeId
                });
            });
            return item_to_transfer;
        }

        function SaveTransfer() {
            var itemsToTransfer = GetItemsToTransfer();
            if (itemsToTransfer.length == 0) {
                toastr.warning("No item to transfer. Add an item to the list to continue");
            } else if (itemsToTransfer.filter(s => parseInt(s.quantity) === 0).length > 0) {
                toastr.warning("Some items have 0 quantity. Can't transfer an item with 0 quantity");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("CreateJson")",
                    data: {
                        TransferDate: $("#transfer-date").val(),
                        Source: $("#transfer-source").val(),
                        Destination: $("#transfer-destination").val(),
                        Remarks: $("#transfer-remarks").val(),
                        Items: itemsToTransfer
                    },
                    beforeSend: function (xhr, error) {
                        $(".save-overlay").showOverlay();
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            //toastr.warning("Page will redirect to details", 'Page Redirect', {
                            //    timeOut: 3000,
                            //    onHidden: function () {
                            window.location = "@Url.Action("Details")/" + data.newRow;
                            //    },
                            //    progressBar: true
                            //});
                        }
                    },
                    complete: function (xhr, status) {
                        $(".save-overlay").hideOverlay();
                    }
                });
            }
        }
    </script>
}
