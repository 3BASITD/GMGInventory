@model TransferVM

@{
    ViewData["Title"] = "Transfer Details";
    ViewData["TitleDetails"] = $"[{Model.Id}]";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Transfer" asp-action="Index">Warehouse Transfer</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Id)
                    </span>
                    <b class="d-block">
                        @Model.Id
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Source)
                    </span>
                    <b class="d-block">
                        @Html.ActionLink(Model.Source,
                                         "Details", 
                                         "Warehouse", 
                                         new { @Id = Model.SourceId }, 
                                                new { @class = "link-info", target = "_blank" })
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Destination)
                    </span>
                    <b class="d-block">
                        @Html.ActionLink(Model.Destination, 
                                         "Details",
                                         "Warehouse",
                                         new { @Id = Model.DestinationId }, 
                                                new { @class = "link-info", target = "_blank" })
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.TransferDate)
                    </span>
                    <b class="d-block">
                        @Model.TransferDate
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model.Remarks) ? Html.Raw("<span class='text-muted fw-normal'>N/A</span>") : Model.Remarks)
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreatedBy)
                    </span>
                    <b class="d-block">
                        @Model.CreatedBy
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block">
                        @Model.DateCreated
                    </b>
                </p>
            </div>
            <div class="col-4">
                @if (!string.IsNullOrWhiteSpace(Model.ModifiedBy))
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ModifiedBy)
                        </span>
                        <b class="d-block">
                            @Model.ModifiedBy
                        </b>
                    </p>
                }
            </div>
            <div class="col-4">
                @if (!string.IsNullOrWhiteSpace(Model.DateModified))
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block">
                            @Model.DateModified
                        </b>
                    </p>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <span class="card-title">Transfer Item(s)</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-head-fixed table-striped table-hover table-item">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Quantity</th>
                                    <th>Unit</th>
                                    <th>Location Code</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var itemDT = $('.table-item').on('preXhr.dt', function (e, settings, data) {
            //showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetItemTransferJson")",
                data: { transferId: @Model?.Id },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Loading table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    data: function (data, type, dataToSet) {
                        return `<a href="/Item/Details/${data.itemId}" class="link-info" target="_blank">${data.code}</a>`;
                    },
                    name: "Code"
                },
                { data: "name", name: "Name" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "unit", name: "Unit" },
                {
                    data: function (data, type, dataToSet) {
                        return data.locationCode || '<span class="text-muted">N/A</span>';
                    },
                    name: "LocationCode"
                },
            ],
            order: [[0, "asc"]]
        });

        itemDT.on("draw", function () {
            //hideLoader();
        });
    </script>
}