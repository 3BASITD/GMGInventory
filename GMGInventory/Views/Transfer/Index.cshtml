<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Check Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Check Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btnFilter"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

<!-- Barcotech Modal -->
<div class="modal fade" id="barcotechModal" role="dialog" aria-labelledby="barcotechModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fetch from Barcotech</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <table class="table table-head-fixed table-striped table-hover table-fetch">
                            <thead>
                                <tr>
                                    <th>Transfer Code</th>
                                    <th>Item Code</th>
                                    <th>Quantity Transfered</th>
                                    <th>Transfer Date</th>
                                    <th>Transfer By</th>
                                    <th>From Warehouse Code</th>
                                    <th>To Warehouse Code</th>
                                    <th>Bin Location Code</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));
        var barcotech_user_access = @Html.Raw(Json.Serialize(barcotechUserAccess));

        SetDateFilter();
        function SetDateFilter() {
            if ($("#filter-to").val() == "") {
                if ($("#filter-from").val() == "") {
                    $("#filter-to").val(DateForInput(new Date()));
                } else {
                    var dt_from = new Date($("#filter-from").val());
                    dt_from.setMonth(dt_from.getMonth() + 1);
                    $("#filter-to").val(DateForInput(dt_from));
                }
            }

            if ($("#filter-from").val() == "") {
                var dt_to = new Date($("#filter-to").val());
                dt_to.setMonth(dt_to.getMonth() - 1);
                $("#filter-from").val(DateForInput(dt_to));
            }
        }

        $("#filter-to, #filter-from").on("focusout", SetDateFilter);

         $(".btnFilter").on("click", function () {
            dataTable.ajax.reload();
            $("#filterModal").modal("hide");
        });

        var dataTable = $('.table-transfer').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetWarehouseTransferJson")",
                type: "POST",
                data: function (data) {
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "id", name: "Id" },
                {
                    data: function (data, type, dataToSet) {
                        return `<a href="/Warehouse/Details/${data.sourceId}" class="text-info" target="_blank">${data.source}</a>`;
                    },
                    name: "Source"
                },
                {
                    data: function (data, type, dataToSet) {
                        return `<a href="/Warehouse/Details/${data.destinationId}" class="text-info" target="_blank">${data.destination}</a>`;
                    },
                    name: "Destination"
                },
                { data: "itemCount", name: "ItemCount", className: "text-end" },
                { data: "transferDate", name: "TransferDate" },
                {
                    data: function (data, type, dataToSet) {
                        return data.remarks || '<span class="text-muted">N/A</span>';
                    },
                    name: "Remarks"
                },
                { data: "createdBy", name: "CreatedBy" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        return actions;
                    }
                }
            ],
            order: [[5, "desc"]]
        });

        dataTable.on("draw", function () {
            hideLoader();

            // Actions upon Display Update Modal
            $('.btn-update').click(function (e) {
                var data = dataTable.row($(this).parents('tr')).data();
                $("#update-code").val(data.code);
                $("#update-name").val(data.name);
                $("#update-retail").val(data.retailPrice);
                $("#update-net").val(data.netPrice);
                $("#update-id").val(data.id);
            });

            // Validation for Update Modal
            var validateUpdate = $("#form-update").validate({
                rules: {
                    retailPrice: { required: true, range: [0, 1999999.99] },
                    netPrice: { required: true, range: [0, 1999999.99] }
                },
                messages: {
                    retailPrice: {
                        required: "Please enter new Retail Price.",
                        range: "Price must be between 0-1999999.99."
                    },
                    netPrice: {
                        required: "Please enter new Net Price.",
                        range: "Price must be between 0-1999999.99."
                    }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoUpdate();
                }
            });

            // Send Update to Controller
            function DoUpdate() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateJson")",
                    data: {
                        Id: $("#update-id").val(),
                        RetailPrice: $("#update-retail").val(),
                        NetPrice: $("#update-net").val()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#updateModal").modal("hide");
                            dataTable.ajax.reload();
                        }
                    },
                    complete: function (xhr, status) {
                    }
                });
            }
        });

        function ApplyFilter() {
            $(".table").DataTable().ajax.reload();
            $("#filterModal").modal("hide");
        }

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());

                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }

        if (barcotech_user_access.canUploadDownload) {
            function FetchFromBarcotech() {
                swal({
                    title: "Fetch from Barcotech",
                    text: "This action will fetch all records from Barcotech. The process may take some time, depending on the number of records to be retrieve. Are you sure you want to proceed?",
                    icon: "warning",
                    buttons: true,
                    infoMode: true
                }).then((confirm) => {
                    if (confirm) {
                        $.ajax({
                            url: "@Url.Action("FetchFromBarcotech", "Transfer")",
                            type: "POST",
                            data: {
                                //FromDate: $("#").val() // wala pang filter sa api ng barcotech
                            },
                            loaderMessage: "Please wait while this completes.<br><small class=\"text-muted\">Reloading the page will stop the transfer, which may result in some records being transferred while others are not.</small>",
                            success: function (data, status, xhr) {
                                var success_ctr = 0;
                                $("table.table-fetch tbody").html("");
                                $.each(data, function (i, v) {
                                    $("table.table-fetch tbody").append(`
                                        <tr>
                                            <td>${v.data.transfer_code}</td>
                                            <td>${v.data.item_code}</td>
                                            <td>${v.data.qty_transferred}</td>
                                            <td>${v.data.transfer_date}</td>
                                            <td>${v.data.transferred_by}</td>
                                            <td>${v.data.from_wh_code}</td>
                                            <td>${v.data.to_wh_code}</td>
                                            <td>${v.data.bin_location_code}</td>
                                            <td class="${(v.status.toLowerCase() == "success" ? "text-success" : "text-danger")}">${v.message}</td>
                                        </tr>`);
                                    success_ctr++;
                                });
                                if(success_ctr > 0) {
                                    dataTable.ajax.reload();
                                }
                                $("#barcotechModal").modal("show");
                            }
                        });
                    }
                });
            }
        }
    </script>
}