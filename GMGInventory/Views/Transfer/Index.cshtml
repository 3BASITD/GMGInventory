@model IEnumerable<WarehouseTransferVM>

@{
    ViewData["Title"] = "Warehouse Transfer";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <a asp-action="Create" class="btn btn-primary btn-sm float-right ml-2">
                    <span class="fas fa-plus"></span> New Warehouse Transfer
                </a>
            }
            else
            {
                <button type="button" class="btn btn-primary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Add access is required." data-microtip-position="bottom-left" role="tooltip">
                    <span class="fas fa-plus"></span> New Warehouse Transfer
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn ml-2">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 ui-state-disabled" data-microtip-title="Upload / Download access is required." data-microtip-position="bottom" role="tooltip">
                    <span class="fas fa-download"></span> Download
                </button>
            }
            <button class="btn btn-secondary btn-sm float-right btn-filter ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-transfer">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Id)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Source)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Destination)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemCount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TransferDate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Remarks)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedBy)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Transfer Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Transfer Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

<!-- Barcotech Modal -->
<div class="modal fade" id="barcotechModal" role="dialog" aria-labelledby="barcotechModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fetch from Barcotech</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <table class="table table-head-fixed table-striped table-hover table-fetch">
                            <thead>
                                <tr>
                                    <th>Transfer Code</th>
                                    <th>Item Code</th>
                                    <th>Quantity Transfered</th>
                                    <th>Transfer Date</th>
                                    <th>Transfer By</th>
                                    <th>From Warehouse Code</th>
                                    <th>To Warehouse Code</th>
                                    <th>Bin Location Code</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            dataTable.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            dataTable.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[5, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo())
        };

        function checkDTChanged() {
            if(!dataTable) return false;
            
            return JSON.stringify(dataTable.order()) != JSON.stringify(defaultDTState.order) ||
                   dataTable.page.info().start != defaultDTState.page ||
                   dataTable.page.len() != defaultDTState.length ||
                   (dataTable.search() || "") != defaultDTState.search.search ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);

            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            
            if (dataTable) {
                dataTable.state.clear();
                dataTable.order(defaultDTState.order);
                dataTable.page(defaultDTState.page);
                dataTable.search(defaultDTState.search.search);
            }
        }

        var dataTable = $('.table-transfer').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetWarehouseTransferJson")",
                type: "POST",
                data: function (data) {
                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "id", name: "Id" },
                {
                    data: function (data, type, dataToSet) {
                        return `<a href="/Warehouse/Details/${data.sourceId}" class="link-info" target="_blank">${data.source}</a>`;
                    },
                    name: "Source"
                },
                {
                    data: function (data, type, dataToSet) {
                        return `<a href="/Warehouse/Details/${data.destinationId}" class="link-info" target="_blank">${data.destination}</a>`;
                    },
                    name: "Destination"
                },
                { data: "itemCount", name: "ItemCount", className: "text-end" },
                { data: "transferDate", name: "TransferDate" },
                {
                    data: function (data, type, dataToSet) {
                        return data.remarks || '<span class="text-muted">N/A</span>';
                    },
                    name: "Remarks"
                },
                { data: "createdBy", name: "CreatedBy" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';
                        return actions;
                    },
                    responsivePriority: 1
                }
            ],
            order: defaultDTState.order
        });

        dataTable.on("draw", function () {
            checkDefaultFilter();
        });

        
        if(user_access.canEdit) {
            // Actions upon Display Update Modal
            $(document).on("click", ".btn-update", function () {
                var data = dataTable.row($(this).parents('tr')).data();
                $("#update-code").val(data.code);
                $("#update-name").val(data.name);
                $("#update-retail").val(data.retailPrice);
                $("#update-net").val(data.netPrice);
                $("#update-id").val(data.id);
            });

            // Validation for Update Modal
            var validateUpdate = $("#form-update").validate({
                rules: {
                    retailPrice: { required: true, range: [0, 1999999.99] },
                    netPrice: { required: true, range: [0, 1999999.99] }
                },
                messages: {
                    retailPrice: {
                        required: "Please enter new Retail Price.",
                        range: "Price must be between 0-1999999.99."
                    },
                    netPrice: {
                        required: "Please enter new Net Price.",
                        range: "Price must be between 0-1999999.99."
                    }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoUpdate();
                }
            });

            // Send Update to Controller
            function DoUpdate() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateJson")",
                    data: {
                        Id: $("#update-id").val(),
                        RetailPrice: $("#update-retail").val(),
                        NetPrice: $("#update-net").val()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#updateModal").modal("hide");
                            dataTable.ajax.reload();
                        }
                    },
                    complete: function (xhr, status) {
                    }
                });
            }
        }

        if (user_access.canUploadDownload) {
            $(document).on("click", ".downloadBtn", function () {
                var urlQuery = [];
                urlQuery.push("DateFrom=" + $("#filter-from").val());
                urlQuery.push("DateTo=" + $("#filter-to").val());

                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }
    </script>
}