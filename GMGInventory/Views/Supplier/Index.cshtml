                    }
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetOptions", "Region")",
                        data: { includeId: data.regionId },
                        success: function (data, status, xhr) {
                            $("#edit-region").select2({
                                ajax: null, //already fetched outside
                                data: data,
                                allowClear: true,
                                placeholder: {
                                    id: "",
                                    text: "<empty>"
                                },
                                dropdownParent: $('#editModal')
                            });
                        }
                    });
                });

                // Validation for Edit Modal
                var validateEdit = $("#editForm").validate({
                    rules: {
                        Code: { required: true, maxlength: 50 },
                        Name: { required: true, maxlength: 100 },
                        TIN: { maxlength: 12 },
                        AddressLine1: { required: true, maxlength: 150 },
                        AddressLine2: { maxlength: 150 },
                        OfficeTelNo: { maxlength: 100 },
                        ContactPerson: { maxlength: 100 },
                        Region: {
                            required: function () {
                                var data = $("#edit-country").select2("data");
                                if (data && data.length > 0 && data[0].alpha2) {
                                    return data[0].alpha2.toLowerCase() === "ph";
                                }
                                return false;
                            }
                        },
                        VAT: { maxlength: 12 }
                    },
                    messages: {
                        Code: { required: "Please enter code.", maxlength: "Code must not exceed 50 characters." },
                        Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                        TIN: { maxlength: "Name must not exceed 12 characters." },
                        AddressLine1: { required: "Please enter address.", maxlength: "Address Line 1 must not exceed 150 characters." },
                        AddressLine2: { maxlength: "Address Line 2 must not exceed 150 characters." },
                        OfficeTelNo: { maxlength: "Office Tel No must not exceed 100 characters." },
                        ContactPerson: { maxlength: "Contact Person must not exceed 100 characters." },
                        Region: { required: "Please enter region." },
                        VAT: { maxlength: "VAT must not exceed 12 characters." },
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoEdit();
                    }
                });

                // Send Edit to Controller
                function DoEdit() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("EditJson")",
                        data: {
                            Id: $("#edit-id").val(),
                            Code: $("#edit-code").val(),
                            Name: $("#edit-name").val(),
                            TIN: $("#edit-tin").val(),
                            AddressLine1: $("#edit-addressline1").val(),
                            AddressLine2: $("#edit-addressline2").val(),
                            OfficeTelNo: $("#edit-officetelno").val(),
                            MobileNumber: $("#edit-mobileno").val(),
                            ContactPerson: $("#edit-contact-person").val(),
                            CountryId: $("#edit-country").val(),
                            RegionId: $("#edit-region").val(),
                            TermId: $("#edit-term").val(),
                            CurrencyId: $("#edit-currency").val(),
                            BusinessStyleId: $("#edit-businessStyle").val(),
                            VAT: $("#edit-vat").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#editModal").modal("hide");
                                dataTable.ajax.reload();
                                hideLoader()
                            }
                        }
                    });
                }
            }
        });

        if (user_access.canAdd) {
            // Actions upon Display Create Modal
            $(".createBtn").click(function (e) {
                $("#create-code").val("");
                $("#create-name").val("");
                $("#create-tin").val("");
                $("#create-addressline1").val("");
                $("#create-addressline2").val("");
                $("#create-officetelno").val("");
                $("#create-mobileno").val("");
                $("#create-contact-person").val("");
                $("#create-country").val(null).trigger("change");
                $("#create-region").prop("selectedIndex", 0).trigger("change");
                $("#create-term").prop("selectedIndex", 0).trigger("change");
                $("#create-currency").prop("selectedIndex", 0).trigger("change");
                $("#create-businessStyle").prop("selectedIndex", 0).trigger("change");
                $("#create-vat").val("");
            });

            // Validation for Create Modal
            var validateCreate = $("#createForm").validate({
                rules: {
                    Code: { required: true, maxlength: 50 },
                    Name: { required: true, maxlength: 100 },
                    TIN: { maxlength: 12 },
                    AddressLine1: { required: true, maxlength: 150 },
                    AddressLine2: { maxlength: 150 },
                    OfficeTelNo: { maxlength: 100 },
                    ContactPerson: { maxlength: 100 },
                    Region: { 
                        required: function () {
                            var data = $("#create-country").select2("data");
                            if (data && data.length > 0 && data[0].alpha2) {
                                return data[0].alpha2.toLowerCase() === "ph";
                            }
                            return false;
                        }
                    },
                    VAT: { maxlength: 12 }
                },
                messages: {
                    Code: { required: "Please enter code.", maxlength: "Code must not exceed 50 characters." },
                    Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                    TIN: { maxlength: "Name must not exceed 12 characters." },
                    AddressLine1: { required: "Please enter address.", maxlength: "Address Line 1 must not exceed 150 characters." },
                    AddressLine2: { maxlength: "Address Line 2 must not exceed 150 characters." },
                    OfficeTelNo: { maxlength: "Office Tel No must not exceed 100 characters." },
                    ContactPerson: { maxlength: "Contact Person must not exceed 100 characters." },
                    Region: { required: "Please enter region." },
                    VAT: { maxlength: "VAT must not exceed 12 characters." },
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoCreate();
                }
            });

            // Send Create to Controller
            function DoCreate() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("CreateJson")",
                    data: {
                        Code: $("#create-code").val(),
                        Name: $("#create-name").val(),
                        TIN: $("#create-tin").val(),
                        AddressLine1: $("#create-addressline1").val(),
                        AddressLine2: $("#create-addressline2").val(),
                        OfficeTelNo: $("#create-officetelno").val(),
                        MobileNumber: $("#create-mobileno").val(),
                        ContactPerson: $("#create-contact-person").val(),
                        CountryId: $("#create-country").val(),
                        RegionId: $("#create-region").val(),
                        TermId: $("#create-term").val(),
                        CurrencyId: $("#create-currency").val(),
                        BusinessStyleId: $("#create-businessStyle").val(),
                        VAT: $("#create-vat").val()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#createModal").modal("hide");
                            dataTable.ajax.reload();
                            hideLoader();
                        }
                    }
                });
            }
        }

        if (user_access.canUploadDownload) {

            $(".downloadBtn").click(function (e) {
                window.location = "@Url.Action("DownloadFile")";
            });
            var json_of_excel;
            var colnumber = 15; // number of columns required for upload
            var done_upload_excel = 0;
            var duplicate_upload = 0;

            var opts = {
                readAsDefault: 'ArrayBuffer',
                dragClass: 'drag',
                on: {
                    load: function (e, file) {
                        var result = new Uint8Array(e.target.result);
                        var xlsread = XLSX.read(result, { type: 'array' });
                        var xlsjson = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                        json_of_excel = xlsjson;
                    }
                }
            };
            $("#upload-file").fileReaderJS(opts);

            // Actions upon file selection
            $("#upload-file").on("change", function () {
                done_upload_excel = 0;
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            // Actions upon Display Upload Modal
            $(".uploadBtn").click(function (e) {
                done_upload_excel = 0;
                $("#upload-file").val("");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            function DoUpload() {
                if (!$("#upload-file").val()) {
                    toastr.error("Please select a file first");
                } if (json_of_excel.length == 0) {
                    toastr.error("The excel file is empty");
                } else {
                    var columns = Object.keys(json_of_excel[0]);
                    $("#upload-table tbody").html("");
                    $("#upload-table").show();
                    duplicate_upload = 0;
                    for (var i = 0; i < json_of_excel.length; i++) {
                        var rowNum = json_of_excel[i].__rowNum__;
                        var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                        row$.append($('<td/>').html(json_of_excel[i].__rowNum__));
                        for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                            var cellValue = json_of_excel[i][columns[colIndex]];
                            if (cellValue == null)
                                cellValue = "";
                            row$.append($('<td/>').html(cellValue));
                        }

                        debugger;

                        if (columns.includes("Code") == false
                            || columns.includes("Name") == false
                            || columns.includes("Address Line 1") == false
                            || columns.includes("Address Line 2") == false
                            || columns.includes("Country") == false
                            || columns.includes("Region") == false
                            || columns.includes("Contact Person") == false
                            || columns.includes("Office Tel No") == false
                            || columns.includes("Mobile No") == false
                            || columns.includes("Term") == false
                            || columns.includes("Currency") == false
                            || columns.includes("Business Style") == false
                            || columns.includes("VAT") == false
                            || columns.includes("TIN") == false
                            || columns.includes("Is Active") == false) {
                            row$.append($('<td/>').html("Unexpected columns"));
                            UploadRowDone();
                        } else {
                            SaveXLSX(json_of_excel[i]["Code"], json_of_excel[i]["Name"], json_of_excel[i]["Address Line 1"], json_of_excel[i]["Address Line 2"], json_of_excel[i]["Country"], json_of_excel[i]["Region"], json_of_excel[i]["Contact Person"], json_of_excel[i]["Office Tel No"], json_of_excel[i]["Mobile No"], json_of_excel[i]["Term"], json_of_excel[i]["Currency"], json_of_excel[i]["Business Style"], json_of_excel[i]["VAT"], json_of_excel[i]["TIN"], json_of_excel[i]["Is Active"], rowNum);
                            row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                        }
                        $("#upload-table").append(row$);
                    }
                }
            }

            function SaveXLSX(code, name, addressLine1, addressLine2, country, region, contactPerson, officeTelNo, mobileNo, term, currencyName, businessStyle, vat, tin, isActive, rownum) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadJson")",
                    data: {
                        Code: code,
                        Name: name,
                        AddressLine1: addressLine1,
                        AddressLine2: addressLine2,
                        CountryName: country,
                        RegionName: region,
                        ContactPerson: contactPerson,
                        OfficeTelNo: officeTelNo,
                        MobileNumber: mobileNo,
                        Term: term,
                        CurrencyName: currencyName,
                        BusinessStyleName: businessStyle,
                        VAT:vat,
                        TIN: tin,
                        isActive: isActive

                    },
                    success: function (data, status, xhr) {
                        if (data.message == "Already exist") {
                            $("#upload-row" + rownum + "tr").remove();
                            duplicate_upload++;
                        } else {
                            $("#upload-row" + rownum + "td").html(data.status + ": " + data.message);
                        }
                    },
                    complete: function (xhr, status) {
                        UploadRowDone();
                    }
                });
            }

            function UploadRowDone() {
                done_upload_excel++;
                if (done_upload_excel == json_of_excel.length && duplicate_upload > 0) {
                    $("#upload-table").append('<tr><td>*</td><td colspan="15">Excluded ' + duplicate_upload + ' row(s)</td><td>Already exist</td></tr>');
                    $("#upload-file").val("");
                }
            }
        }
    </script>
}