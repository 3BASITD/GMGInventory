@model IEnumerable<SupplierViewVM>

@{
    ViewData["Title"] = "Supplier";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="fas fa-plus"></span> New Supplier
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right uploadBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <span class="fas fa-upload"></span> Upload
                </button>
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn ml-2">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-supplier">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserModified)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateModified)
                    </th>

                    <th></th>
                </tr>
            </thead>

        </table>
    </div>
</div>
@if (userAccess.CanDelete)
{
    <form id="deleteSupplierForm" asp-action="Delete">
        <input type="hidden" id="deleteSupplierId" name="Id" />
    </form>
}
@if (userAccess.CanAdd || userAccess.CanEdit)
{
    <form id="reactivateSupplierForm" asp-action="Reactivate">
        <input type="hidden" id="reactivateSupplierId" name="Id" />
    </form>
}
@if (userAccess.CanAdd)
{
    <!-- Create Modal -->
    <div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" style="max-width: 75%;" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Supplier</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="createForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-code" class="control-label mb-0 d-block">Code</label>
                                    <input type="text" name="Code" id="create-code" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-name" class="control-label mb-0 d-block">Name</label>
                                    <input type="text" name="Name" id="create-name" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-addressline1" class="control-label mb-0 d-block">Address Line 1</label>
                                    <input type="text" name="AddressLine1" id="create-addressline1" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-addressline2" class="control-label mb-0 d-block">Address Line 2</label>
                                    <input type="text" name="AddressLine2" id="create-addressline2" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-country" class="control-label mb-0 d-block">Country</label>
                                    <select name="Country" id="create-country" class="form-control" style="width: 100%"></select>
                                </div>
                            </div>
                            <div class="col-md-4 create-region-container">
                                <div class="form-group">
                                    <label for="create-region" class="control-label mb-0 d-block">Region</label>
                                    <select name="Region" id="create-region" class="form-control" style="width: 100%"></select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-contact-person" class="control-label mb-0 d-block">Contact Person</label>
                                    <input type="text" name="ContactPerson" id="create-contact-person" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-mobileno" class="control-label mb-0 d-block">Mobile Number</label>
                                    <input type="text" name="MobileNumber" id="create-mobileno" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-officetelno" class="control-label mb-0 d-block">Office Tel No.</label>
                                    <input type="text" name="OfficeTelNo" id="create-officetelno" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-term" class="control-label mb-0 d-block">Term</label>
                                    <select name="Term" id="create-term" class="form-control" style="width: 100%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-currency" class="control-label mb-0 d-block">Currency</label>
                                    <select name="Currency" id="create-currency" class="form-control" style="width: 100%"></select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-businessStyle" class="control-label mb-0 d-block">Business Style</label>
                                    <select name="BusinessStyle" id="create-businessStyle" class="form-control" style="width: 100%"></select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-vat" class="control-label mb-0 d-block">VAT</label>
                                    <input type="text" name="VAT" id="create-vat" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-tin" class="control-label mb-0 d-block">TIN</label>
                                    <input type="text" name="TIN" id="create-tin" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

