<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" style="max-width: 80%;" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Supplier</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label mb-0" for="upload-file">Excel File</label>
                    <input type="file" id="upload-file" name="file"
                           accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                           class="form-control form-control-sm" />
                </div>
                <table class="table table-striped" id="upload-table">
                    <thead>
                        <tr><th>Row #</th><th>Code</th><th>Name</th><th>Contact Person</th><th>Contact Number</th><th>Email</th><th>Address Line 1</th><th>Address Line 2</th><th>Barangay</th><th>City/ Municipality</th><th>Area</th><th>Zip Code</th><th>Credit Limit</th><th>Currency</th><th>Is Foreign</th><th>Is Active</th><th>Status</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="DoUpload()">
                    <span class="fas fa-upload"></span> Upload
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Cancel
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>

        // Load Select2 for Area
        $("#create-area").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.region ? "<em class='fw-light text-secondary'> - " + repo.region + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Area")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#createModal")
        });

        $("#create-area").on("select2:select", function () {
            $("#create-region").val($(this).select2("data")[0].region);
        });

        $("#create-area").on("select2:unselecting", function (e) {
            $("#create-region").val("");
        });



        // Load Select2 for Area
        $("#edit-area").select2({
            minimumInputLength: 1,
            allowClear: true,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.region ? "<em class='fw-light text-secondary'> - " + repo.region + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Area")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#editModal")
        });

        $("#edit-area").on("select2:select", function () {
            $("#edit-region").val($(this).select2("data")[0].region);
        });

        $("#edit-area").on("select2:unselecting", function (e) {
            $("#edit-region").val("");
        });


        // Load Select2 Region
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function (data, status, xhr) {
                //$("#create-region").select2({
                //    data: data,
                //    dropdownParent: $("#createModal")
                //});
                //$("#edit-region").select2({
                //    data: data,
                //    dropdownParent: $("#editModal")
                //});
            }
        });



        //// Load Select2 Area
        //$.ajax({
        //    type: "POST",
        //    url: "@Url.Action("GetOptions", "Area")",
        //    success: function(data, status, xhr) {
        //        $("#create-area").select2({
        //            data: data,
        //            dropdownParent: $("#createModal")
        //        });
        //        $("#edit-area").select2({
        //            data: data,
        //            dropdownParent: $("#editModal")
        //        });
        //    }
        //});

        // Load Select2 Currency
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Currency")",
            success: function (data, status, xhr) {
                $("#create-currency").select2({
                    data: data,
