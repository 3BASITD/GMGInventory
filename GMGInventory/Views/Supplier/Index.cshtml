@if (userAccess.CanUploadDownload)
{
    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" style="max-width: 80%;" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Supplier</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label mb-0" for="upload-file">Excel File</label>
                        <input type="file" id="upload-file" name="file"
                               accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                               class="form-control form-control-sm" />
                    </div>
                    <table class="table table-striped" id="upload-table">
                        <thead>
                            <tr><th>Row #</th><th>Code</th><th>Name</th><th>Address Line 1</th><th>Address Line 2</th><th>Region</th><th>Contact Person</th><th>Office Tel No</th><th>Mobile No</th><th>Term</th><th>Currency</th><th>Business Style</th><th>VAT</th><th>TIN</th><th>Is Active</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="DoUpload()">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        $("#create-country").select2({
            //minimumInputLength: 1,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong><br /><small>Alpha-2 code: " + repo.alpha2 + "<br />Alpha-3 code: " + repo.alpha3 + "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Country")"
            },
            dropdownParent: $("#createModal")
        }).on("select2:select", function () {
            if($(this).select2("data")[0].alpha2.toLowerCase() == "ph") {
                $(".create-region-container").removeClass("d-none");
                $("#create-region").val(4).trigger("change");
            } else {
                $(".create-region-container").addClass("d-none");
                $("#create-region").val(null).trigger("change");
            }
        });

        $("#edit-country").select2({
            //minimumInputLength: 1,
            placeholder: '<empty>',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong><br /><small>Alpha-2 code: " + repo.alpha2 + "<br />Alpha-3 code: " + repo.alpha3 + "</small>");
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Country")"
            },
            dropdownParent: $("#editModal")
        }).on("select2:select", function () {
            if($(this).select2("data")[0].alpha2.toLowerCase() == "ph") {
                $(".edit-region-container").removeClass("d-none");
                $("#edit-region").val(4).trigger("change");
            } else {
                $(".edit-region-container").addClass("d-none");
                $("#edit-region").val(null).trigger("change");
            }
        });

        // Load Select2 Region
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function (data, status, xhr) {
                $("#create-region").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-region").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Currency
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Currency")",
            success: function (data, status, xhr) {
                $("#create-currency").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-currency").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 BusinessStyle
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "BusinessStyle")",
            success: function (data, status, xhr) {
                $("#create-businessStyle").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-businessStyle").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Credit Term
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CreditTerm")",
            success: function (data, status, xhr) {
                $("#create-term").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal"),
                    minimumResultsForSearch: -1
                });
                $("#edit-term").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal"),
                    minimumResultsForSearch: -1
                });
            }
        });

        // Load List on DataTable
        var dataTable = $('.table-supplier').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function (data) {
                    //var regionId = $("#RegionId").val();

                    //if (regionId) data.RegionId = regionId;
                },
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.isActive) {
                            return '<span class="fas fa-check text-success"></span>';
                        } else {
                            return '<span class="fas fa-times text-danger"></span>';
                        }
                    },
                    name: "IsActive"
                },
                { data: "userCreated", name: "UserCreated" },
                { data: "dateCreated", name: "DateCreated" },
                {
                    data: function (data, type, dataToSet) {
                        return data.userModified ? data.userModified : "<em class='text-muted'>N/A</em>";
                    },
                    name: "UserModified"
                },
                { 
                    data: function (data, type, dataToSet) {
                        return data.dateModified ? data.dateModified : "<em class='text-muted'>N/A</em>";
                    },
                    name: "DateModified"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-info-circle"></span></a>';

                        if (data.isActive) {
                            if (user_access.canEdit) {
                                actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Details" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-pencil-alt"></span></button>';
                            }
                            if (user_access.canDelete) {
                                actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete / Deactivate Supplier" data-microtip-position="bottom-left" role="tooltip"><span class="far fa-trash-alt"></span></button>';
                            }
                        } else {
                            if (user_access.canAdd || user_access.canEdit) {
                                actions += '<button data-id="' + data.id + '" class="btn btn-success btn-xs reactivateBtn" data-microtip-title="Reactivate Supplier" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-check"></span></button>';
                            }
                        }
                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions + "</div>";
                    }
                }
            ],
            order: [[0, "asc"]]
        });


        dataTable.on("draw", function () {
            hideLoader();

            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete / Deactivate Supplier",
                        text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteSupplierId').val(id);
                            $('#deleteSupplierForm').submit();
                        }
                    });
                });
            }
            if (user_access.canAdd || user_access.canEdit) {
                $('.reactivateBtn').click(function (e) {
                    swal({
                        title: "Reactivate Supplier",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#reactivateSupplierId').val(id);
                            $('#reactivateSupplierForm').submit();
                        }
                    });
                });
            }

            if (user_access.canEdit) {

                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = dataTable.row($(this).parents('tr')).data();
                    console.log(data);
                    $("#edit-id").val(data.id);
                    $("#edit-code").val(data.code);
                    $("#edit-name").val(data.name);
                    $("#edit-tin").val(data.tin);
                    $("#edit-addressline1").val(data.addressLine1);
                    $("#edit-addressline2").val(data.addressLine2);
                    $("#edit-officetelno").val(data.officeTelNo);
                    $("#edit-mobileno").val(data.mobileNumber);
                    $("#edit-contact-person").val(data.contactPerson);
                    var countryOption = new Option(data.countryName, data.countryId, true, true);
                    $("#edit-country").append(countryOption).trigger("change");
                    $("#edit-region").val(data.regionId).trigger("change");
                    $("#edit-term").val(data.termId).trigger("change");
                    $("#edit-currency").val(data.currencyId);
                    $("#edit-businessStyle").val(data.businessStyleId);
                    $("#edit-vat").val(data.vat);

                    // Load Select2 Currency on Edit
                    if ($("#edit-currency").attr("data-select2-id")) {
                        $("#edit-currency").select2("destroy");
                        $("#edit-currency").empty();
                    }
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetOptions", "Currency")",
                        data: { includeId: data.currencyId },
                        success: function (data, status, xhr) {
                            $("#edit-currency").select2({
                                ajax: null, //already fetched outside
                                data: data,
                                allowClear: true,
                                placeholder: {
                                    id: "",
                                    text: "<empty>"
                                },
                                dropdownParent: $('#editModal')
                            });
                        }
                    });

                    // Load Select2 BusinessStyle on Edit
                    if ($("#edit-businessStyle").attr("data-select2-id")) {
                        $("#edit-businessStyle").select2("destroy");
