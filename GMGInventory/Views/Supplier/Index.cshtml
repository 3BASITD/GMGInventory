        var json_of_excel;
        var colnumber = 15; // number of columns required for upload
        var done_upload_excel = 0;
        var duplicate_upload = 0;

        var opts = {
            readAsDefault: 'ArrayBuffer',
            dragClass: 'drag',
            on: {
                load: function (e, file) {
                    var result = new Uint8Array(e.target.result);
                    var xlsread = XLSX.read(result, { type: 'array' });
                    var xlsjson = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                    json_of_excel = xlsjson;
                }
            }
        };
        $("#upload-file").fileReaderJS(opts);

        // Actions upon file selection
        $("#upload-file").on("change", function () {
            done_upload_excel = 0;
            $("#upload-table tbody").html("");
            $("#upload-table").hide();
        });

        // Actions upon Display Upload Modal
        $(".uploadBtn").click(function (e) {
            done_upload_excel = 0;
            $("#upload-file").val("");
            $("#upload-table tbody").html("");
            $("#upload-table").hide();
        });

        function DoUpload() {
            if (!$("#upload-file").val()) {
                toastr.error("Please select a file first");
            } if (json_of_excel.length == 0) {
                toastr.error("The excel file is empty");
            } else {
                var columns = Object.keys(json_of_excel[0]);
                $("#upload-table tbody").html("");
                $("#upload-table").show();
                duplicate_upload = 0;
                for (var i = 0; i < json_of_excel.length; i++) {
                    var rowNum = json_of_excel[i].__rowNum__;
                    var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                    row$.append($('<td/>').html(json_of_excel[i].__rowNum__));
                    for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                        var cellValue = json_of_excel[i][columns[colIndex]];
                        if (cellValue == null)
                            cellValue = "";
                        row$.append($('<td/>').html(cellValue));
                    }
                    if (columns.includes("Code") == false
                        || columns.includes("Name") == false
                        || columns.includes("Contact Person") == false
                        || columns.includes("Contact Number") == false
                        || columns.includes("Email") == false
                        || columns.includes("Address Line 1") == false
                        || columns.includes("Address Line 2") == false
                        || columns.includes("Barangay") == false
                        || columns.includes("City/ Municipality") == false
                        || columns.includes("Area") == false
                        || columns.includes("Zip Code") == false
                        || columns.includes("Credit Limit") == false
                        || columns.includes("Currency") == false
                        || columns.includes("Is Foreign") == false
                        || columns.includes("Is Active") == false) {
                        row$.append($('<td/>').html("Unexpected columns"));
                        UploadRowDone();
                    } else {
                        SaveXLSX(json_of_excel[i]["Code"], json_of_excel[i]["Name"], json_of_excel[i]["Contact Person"], json_of_excel[i]["Contact Number"], json_of_excel[i]["Email"], json_of_excel[i]["Address Line 1"], json_of_excel[i]["Address Line 2"], json_of_excel[i]["Barangay"], json_of_excel[i]["City/ Municipality"], json_of_excel[i]["Area"], json_of_excel[i]["Zip Code"], json_of_excel[i]["Credit Limit"], json_of_excel[i]["Currency"], json_of_excel[i]["Is Foreign"], json_of_excel[i]["Is Active"], rowNum);
                        row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                    }
                    $("#upload-table").append(row$);
                }
            }
        }

        function SaveXLSX(code, name, contactPerson, contactNumber, emailAddress, addressLine1, addressLine2, barangay, city, areaName, zipCode, creditLimitD, currencyName, isForeign, isActive, rownum) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("UploadJson")",
                data: {
                    Code: code,
                    Name: name,
                    ContactPerson: contactPerson,
                    ContactNumber: contactNumber,
                    EmailAddress: emailAddress,
                    AddressLine1: addressLine1,
                    AddressLine2: addressLine2,
                    Barangay: barangay,
                    City: city,
                    AreaName: areaName,
                    ZipCode: zipCode,
                    CreditLimitD: creditLimitD,
                    CurrencyName: currencyName,
                    isForeign: isForeign,
                    isActive: isActive

                },
                success: function (data, status, xhr) {
                    if (data.message == "Already exist") {
                        $("#upload-row" + rownum + "tr").remove();
                        duplicate_upload++;
                    } else {
                        $("#upload-row" + rownum + "td").html(data.status + ": " + data.message);
                    }
                },
                complete: function (xhr, status) {
                    UploadRowDone();
                }
            });
        }

        function UploadRowDone() {
            done_upload_excel++;
            if (done_upload_excel == json_of_excel.length && duplicate_upload > 0) {
                $("#upload-table").append('<tr><td>*</td><td colspan="15">Excluded ' + duplicate_upload + ' row(s)</td><td>Already exist</td></tr>');
                $("#upload-file").val("");
            }
        }





    </script>
