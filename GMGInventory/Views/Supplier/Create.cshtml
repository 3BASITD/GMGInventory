@model SupplierVM

@{
    ViewData["Title"] = "New Supplier";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Supplier" asp-action="Index">Suppliers</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right mr-2" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <form asp-action="Create">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                 <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Code" class="control-label mb-0"></label>
                            <input asp-for="Code" class="form-control form-control-sm" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Name" class="control-label mb-0"></label>
                            <input asp-for="Name" class="form-control form-control-sm" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ContactPerson" class="control-label mb-0"></label>
                            <input asp-for="ContactPerson" class="form-control form-control-sm" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>

                          <div class="form-group">
                            <label asp-for="ContactNumber" class="control-label mb-0"></label>
                            <input asp-for="ContactNumber" class="form-control form-control-sm" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="EmailAddress" class="control-label mb-0"></label>
                            <input asp-for="EmailAddress" class="form-control form-control-sm" />
                            <span asp-validation-for="EmailAddress" class="text-danger"></span>
                        </div>
                 
                    </div>

                    <div class="col-md-4">
                       <div class="form-group">
                            <label asp-for="AddressLine1" class="control-label mb-0"></label>
                            <input asp-for="AddressLine1" class="form-control form-control-sm" />
                            <span asp-validation-for="AddressLine1" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="AddressLine2" class="control-label mb-0"></label>
                            <input asp-for="AddressLine2" class="form-control form-control-sm" />
                            <span asp-validation-for="AddressLine2" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Barangay" class="control-label mb-0"></label>
                            <input asp-for="Barangay" class="form-control form-control-sm" />
                            <span asp-validation-for="Barangay" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="City" class="control-label mb-0"></label>
                            <input asp-for="City" class="form-control form-control-sm" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="RegionId" class="control-label mb-0"></label>
                            <select asp-for="RegionId" asp-items="Model?.Regions" class="form-control select2">
                            </select>
                            <span asp-validation-for="RegionId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="AreaId" class="control-label mb-0"></label>
                            <select asp-for="AreaId" asp-items="Model?.Areas" class="form-control select2">
                            </select>
                            <span asp-validation-for="AreaId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ZipCode" class="control-label mb-0"></label>
                            <input asp-for="ZipCode" class="form-control form-control-sm" />
                            <span asp-validation-for="ZipCode" class="text-danger"></span>
                        </div>
                 
                    </div>

                     <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="CreditLimit" class="control-label mb-0"></label>
                            <input asp-for="CreditLimit" class="form-control form-control-sm" />
                            <span asp-validation-for="CreditLimit" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CurrencyId" class="control-label mb-0"></label>
                            <select asp-for="CurrencyId" asp-items="Model?.Currencies" class="form-control select2">
                            </select>
                            <span asp-validation-for="CurrencyId" class="text-danger"></span>
                        </div>
                         <div class="form-group">
                            <label asp-for="IsForeign" class="control-label mb-0"></label>
                            <input asp-for="IsForeign" class="checkbox" />
                            <span asp-validation-for="IsForeign" class="text-danger"></span>
                        </div>
                    </div>
                   
                </div>
            
            </div>
            <div class="card-footer">
                <div class="card-tools">
                    <button type="submit" class="btn btn-primary btn-sm float-right">
                        <span class="fas fa-save"></span> Save
                    </button>
                </div>
            </div>
        </form>
    </div>

    @section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
