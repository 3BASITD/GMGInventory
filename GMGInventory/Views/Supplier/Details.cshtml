@model SupplierViewVM

@{
    ViewData["Title"] = "Supplier Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Supplier" asp-action="Index">Suppliers</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Code)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.Code
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.RegionName)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.RegionName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Term)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.Term
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.TIN)
                    </span>
                    <b class="d-block form-gayahin">
                        @if (string.IsNullOrWhiteSpace(Model.TIN))
                        {
                            <em>N/A</em>
                        }
                        else
                        {
                            @Model.TIN
                        }
                    </b>
                </p>
                @if (!string.IsNullOrWhiteSpace(Model.DateModified))
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model.DateModified
                        </b>
                    </p>
                }
            </div>

            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.Name
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactPerson)
                    </span>
                    <b class="d-block form-gayahin">
                        @if (string.IsNullOrWhiteSpace(Model.ContactPerson))
                        {
                            <em>N/A</em>
                        }
                        else
                        {
                            @Model.ContactPerson
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CurrencyName)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.CurrencyName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.UserCreated
                    </b>
                </p>




            </div>
            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AddressLine1)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.AddressLine1
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OfficeTelNo)
                    </span>
                    <b class="d-block form-gayahin">
                        @if (string.IsNullOrWhiteSpace(Model.OfficeTelNo))
                        {
                            <em>N/A</em>
                        }
                        else
                        {
                            @Model.OfficeTelNo
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.BusinessStyleName)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.BusinessStyleName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model.DateCreated
                    </b>
                </p>

            </div>
            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AddressLine2)
                    </span>
                    <b class="d-block form-gayahin">
                        @if (string.IsNullOrWhiteSpace(Model.AddressLine2))
                        {
                            <em>N/A</em>
                        }
                        else
                        {
                            @Model.AddressLine2
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.MobileNumber)
                    </span>
                    <b class="d-block form-gayahin">
                        @if (string.IsNullOrWhiteSpace(Model.MobileNumber))
                        {
                            <em>N/A</em>
                        }
                        else
                        {
                            @Model.MobileNumber
                        }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.VAT)
                    </span>
                    <b class="d-block form-gayahin">
                        @if (string.IsNullOrWhiteSpace(Model.VAT))
                        {
                            <em>N/A</em>
                        }
                        else
                        {
                            @Model.VAT
                        }
                    </b>
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.UserModified))
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserModified)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model.UserModified
                        </b>
                    </p>
                }

            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-secondary">
                    <div class="card-header">
                        <span class="card-title">Supplier Item Register</span>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active">
                                <table class="table table-head-fixed table-striped table-hover table-purchase">
                                    <thead>
                                        <tr>
                                            <th>Item Code</th>
                                            <th>Item Description</th>
                                            <th>Quantity</th>
                                            <th>Unit Cost</th>
                                            <th>Total Cost</th>
                                            <th>Conversion Factor</th>
                                            <th>Converted Total Cost</th>
                                            <th>Replenish Date</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Purchase Order Details
        var purchaseDT = $('.table-purchase').on('preXhr.dt', function (e, settings, data) {
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetPurchasesJson")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model.Id;
                }
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    data: function (data, type, dataToSet) {
                        if (data.item == null) {
                            return "";
                        } else {
                            return data.item + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="bottom-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "Item",
                    className: "form-cell"
                },
                { data: "itemDescription", name: "ItemDescription" },
                { data: "quantity", name: "Quantity", className: "text-end" },
                { data: "unitCost", name: "UnitCost", className: "text-end" },
                { data: "totalCost", name: "TotalCost", className: "text-end" },
                { data: "conversionFactor", name: "ConversionFactor", className: "text-end" },
                { data: "convertedTotalCost", name: "ConvertedTotalCost", className: "text-end" },
                { data: "replenishDate", name: "ReplenishDate" }
            ],
            order: [[5, "desc"]]
        }).on("draw.dt", function () {
        });
    </script>
}