@model SupplierViewVM

@{
    ViewData["Title"] = "Supplier Details";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Supplier" asp-action="Index">Suppliers</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light btn-sm float-right" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Code)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Code
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.RegionName)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.RegionName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Term)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Term
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.TIN)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.TIN
                    </b>
                </p>
                @if (Model?.UserModified != "-")
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.DateModified
                        </b>
                    </p>
                }
            </div>

            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.Name
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactPerson)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.ContactPerson
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CurrencyName)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.CurrencyName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.UserCreated
                    </b>
                </p>

             
              
              
            </div>
            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AddressLine1)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.AddressLine1
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.OfficeTelNo)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.OfficeTelNo
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.BusinessStyleName)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.BusinessStyleName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.DateCreated
                    </b>
                </p>
              
            </div>
            <div class="col-3">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AddressLine2)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.AddressLine2
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.MobileNumber)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.MobileNumber
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.VAT)
                    </span>
                    <b class="d-block form-gayahin">
                        @Model?.VAT
                    </b>
                </p>

                @if (Model?.UserModified != "-")
                {
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.UserModified)
                        </span>
                        <b class="d-block form-gayahin">
                            @Model?.UserModified
                        </b>
                    </p>
                }
              
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-secondary">
                    <div class="card-header">
                        <span class="card-title">Supplier Item Register</span>                       
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active">
                                <table class="table table-head-fixed table-striped table-hover table-purchase">
                                    <thead>
                                        <tr>
                                            <th>Item Code</th>
                                            <th>Item Description</th>
                                            <th>Currency</th>
                                            <th>Conversion Factor</th>
                                            <th>Unit Cost</th>
                                            <th>Converted Unit Price</th>
                                            <th>Replenish Date</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Purchase Order Details
        var purchaseDT = $('.table-purchase').on('preXhr.dt', function (e, settings, data) {
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetPurchasesJson")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                }
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        if (data.item == null) {
                            return "";
                        } else {
                            return data.item + ' <span class="clickable" data-microtip-title="View Item Details" data-microtip-position="top-left" role="tooltip" onclick="LoadItemDetailsModal(' + data.itemId + ')"><i class="fas fa-info-circle text-info"></i></span>';
                        }
                    },
                    name: "ItemCode",
                    className: "form-cell"
                },
                { data: "itemDescription", name: "ItemDescription" },
                { data: "currency", name: "Currency" },
                { data: "conversionFactor", name: "ConversionFactor", className: "text-end" },
                { data: "unitCost", name: "UnitCost", className: "text-end" },
                { data: "convertedUnitPrice", name: "ConvertedUnitPrice", className: "text-end" },
                { data: "replenishDate", name: "ReplenishDate" }
            ],
            order: [[6, "desc"]]
        }).on("draw.dt", function () {
        });
    </script>
}