@model IEnumerable<ItemPriceUpdateVM>

@{
    ViewData["Title"] = "Price Update";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button type="button" class="btn btn-secondary btn-sm float-right ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right uploadBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <span class="fas fa-upload"></span> Upload
                </button>
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-update">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (userAccess.CanEdit)
{
    <!-- Update Price Modal -->
    <div class="modal fade" id="updateModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Price</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="form-update">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="update-code" class="control-label mb-0 d-block">Code</label>
                                    <input name="code" id="update-code" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                                <div class="form-group">
                                    <label for="update-name" class="control-label mb-0 d-block">Name</label>
                                    <input name="name" id="update-name" class="form-control form-control-sm" readonly="readonly" />
                                </div>
                                <div class="form-group">
                                    <label for="update-retail" class="control-label mb-0 d-block">Gross Price</label>
                                    <input type="number" step="0.01" min="0" max="1999999.99" name="RetailPrice" id="update-retail" class="form-control form-control-sm" />
                                </div>
                                <div class="form-group">
                                    <label for="update-net" class="control-label mb-0 d-block">Net Price</label>
                                    <input type="number" step="0.01" min="0" max="1999999.99" name="NetPrice" id="update-net" class="form-control form-control-sm" />
                                </div>
                                <input type="hidden" id="update-id" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-edit"></span> Update
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="filter-category" class="control-label mb-0">Category</label>
                            <select id="filter-category" name="CategoryId" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="filter-item-type" class="control-label mb-0">Item Type</label>
                            <select id="filter-item-type" name="ItemTypeId" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="filter-brand" class="control-label mb-0">Brand</label>
                            <select id="filter-brand" name="BrandId" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

@if (userAccess.CanUploadDownload)
{
    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Item</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label mb-0" for="upload-file">Excel File</label>
                        <input type="file" id="upload-file" name="file"
                        accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                        class="form-control form-control-sm" />
                    </div>
                    <table class="table table-striped" id="upload-table">
                        <thead>
                            <tr><th>Row #</th><th>Code</th><th>Gross Price</th><th>Net Price</th><th>Status</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="DoUpload()">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Category
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Category")",
            success: function (data, status, xhr) {
                $("#filter-category").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        // Load Select2 for Item Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "ItemType")",
            success: function (data, status, xhr) {
                $("#filter-item-type").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        // Load Select2 for Brand
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Brand")",
            success: function (data, status, xhr) {
                $("#filter-brand").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    allowClear: true,
                    placeholder: {
                        id: "",
                        text: "All"
                    },
                    dropdownParent: $('#filterModal')
                });
            }
        });

        var dataTable = $('.table-update').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
                data: function (data) {
                    var categoryId = $("#filter-category").val();
                    var itemTypeId = $("#filter-item-type").val();
                    var brandId = $("#filter-brand").val();

                    if (categoryId) data.CategoryId = categoryId;
                    if (itemTypeId) data.ItemTypeId = itemTypeId;
                    if (brandId) data.BrandId = brandId;
                },
            },
            //processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "retailPrice", name: "RetailPrice", className: "text-end" },
                { data: "netPrice", name: "NetPrice", className: "text-end" },
                { data: "userCreated", name: "UserCreated" },
                { data: "dateCreated", name: "DateCreated" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        if (data.isLatest) {
                            if (user_access.canEdit) {
                                actions += '<button class="btn btn-warning btn-xs btn-update" data-bs-toggle="modal" data-bs-target="#updateModal" data-microtip-title="Update Price" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-pencil-alt"></span></button>';
                            }
                        }
                        return actions;
                    },
                    responsivePriority: 1
                }
            ],
            order: [[5, "desc"]]
        });

        dataTable.on("draw", function () {
            hideLoader();

            $(".table-update thead th").removeClass("text-end");

            if (user_access.canEdit) {
                // Actions upon Display Update Modal
                $('.btn-update').click(function (e) {
                    var data = dataTable.row($(this).parents('tr')).data();
                    $("#update-code").val(data.code);
                    $("#update-name").val(data.name);
                    $("#update-retail").val(data.retailPrice);
                    $("#update-net").val(data.netPrice);
                    $("#update-id").val(data.id);
                });

                // Validation for Update Modal
                var validateUpdate = $("#form-update").validate({
                    rules: {
                        retailPrice: { required: true, range: [0, 1999999.99] },
                        netPrice: { required: true, range: [0, 1999999.99] }
                    },
                    messages: {
                        retailPrice: {
                            required: "Please enter new Retail Price.",
                            range: "Price must be between 0-1999999.99."
                        },
                        netPrice: {
                            required: "Please enter new Net Price.",
                            range: "Price must be between 0-1999999.99."
                        }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoUpdate();
                    }
                });

                // Send Update to Controller
                function DoUpdate() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("UpdateJson")",
                        data: {
                            Id: $("#update-id").val(),
                            RetailPrice: $("#update-retail").val(),
                            NetPrice: $("#update-net").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#updateModal").modal("hide");
                                dataTable.ajax.reload();
                            }
                        },
                        complete: function (xhr, status) {
                        }
                    });
                }
            }
        });

        function ApplyFilter() {
            dataTable.ajax.reload();
            $("#filterModal").modal("hide");
        }

        if (user_access.canUploadDownload) {
            var json_of_excel_headers;
            var json_of_excel;
            var colnumber = 4; // number of columns required for upload
            var done_upload_excel = 0;

            var opts = {
                readAsDefault: 'ArrayBuffer',
                dragClass: 'drag',
                on: {
                    load: function (e, file) {
                        var result = new Uint8Array(e.target.result);

                        var xlsread = XLSX.read(result, { type: 'array' });
                        json_of_excel = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                    }
                }
            };
            $("#upload-file").fileReaderJS(opts);

            // Actions upon file selection
            $("#upload-file").on("change", function () {
                done_upload_excel = 0;
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            // Actions upon Display Upload Modal
            $(".uploadBtn").click(function (e) {
                done_upload_excel = 0;
                $("#upload-file").val("");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            function DoUpload() {
                if (!$("#upload-file").val()) {
                    toastr.warning("Please select a file first", "Warning");
                } if (json_of_excel.length == 0) {
                    toastr.warning("The excel file is empty", "Warning");
                } else {
                    var columns = Object.keys(json_of_excel[0]);
                    $("#upload-table tbody").html("");
                    $("#upload-table").show();
                    for (var i = 0; i < json_of_excel.length; i++) {
                        var rowNum = json_of_excel[i].__rowNum__;
                        var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                        row$.append($('<td/>').html(json_of_excel[i].__rowNum__));
                        for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                            var cellValue = json_of_excel[i][columns[colIndex]];
                            if (cellValue == null)
                                cellValue = "";
                            if (colIndex == 0 || colIndex == 2 || colIndex == 3)
                                row$.append($('<td/>').html(cellValue));
                        }
                        if (columns.includes("Code") == false
                            || columns.includes("Name") == false
                            || columns.includes("Gross Price") == false
                            || columns.includes("Net Price") == false) {
                            row$.append($('<td/>').html("Unexpected columns"));
                            UploadRowDone();
                        } else {
                            SaveXLSX(json_of_excel[i]["Code"],
                                json_of_excel[i]["Gross Price"],
                                json_of_excel[i]["Net Price"],
                                rowNum);
                            row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                        }
                        $("#upload-table").append(row$);
                    }
                }
            }

            function SaveXLSX(code, retailprice, netprice, rownum) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadJson")",
                    data: {
                        Code: code,
                        RetailPrice: retailprice,
                        NetPrice: netprice
                    },
                    success: function (data, status, xhr) {
                        $("#upload-row" + rownum + "td").html(data.status + ": " + data.message);
                    },
                    complete: function (xhr, status) {
                        UploadRowDone();
                    }
                });
            }

            function UploadRowDone() {
                done_upload_excel++;
                $.LoadingOverlay("progress", parseInt((done_upload_excel / json_of_excel.length) * 100));
                if (done_upload_excel == json_of_excel.length) {
                    dataTable.ajax.reload();
                    $("#upload-file").val("");
                }
            }

            $(".downloadBtn").click(function (e) {
                var urlQuery = [];
                if ($("#filter-category").val()) { urlQuery.push("CategoryId=" + $("#filter-category").val()); }
                if ($("#filter-item-type").val()) { urlQuery.push("ItemTypeId=" + $("#filter-item-type").val()); }
                if ($("#filter-brand").val()) { urlQuery.push("BrandId=" + $("#filter-brand").val()); }
                window.location = "@Url.Action("DownloadFile")?" + urlQuery.join("&");
            });
        }
    </script>
}