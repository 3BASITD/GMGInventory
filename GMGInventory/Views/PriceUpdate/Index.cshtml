@model IEnumerable<ItemPriceUpdateVM>

@{
    ViewData["Title"] = "Price Update";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        @*<div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
        </div>*@
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-update">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RetailPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NetPrice)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Update Price Modal -->
<div class="modal fade" id="updateModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Price</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="form-update">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="update-code" class="control-label mb-0 d-block">Code</label>
                                <input name="code" id="update-code" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                            <div class="form-group">
                                <label for="update-name" class="control-label mb-0 d-block">Name</label>
                                <input name="name" id="update-name" class="form-control form-control-sm" readonly="readonly" />
                            </div>
                            <div class="form-group">
                                <label for="update-retail" class="control-label mb-0 d-block">Retail Price</label>
                                <input type="number" step="0.01" min="0" max="1999999.99" name="RetailPrice" id="update-retail" class="form-control form-control-sm" />
                                <span data-valmsg-for="update-retail" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="update-net" class="control-label mb-0 d-block">Net Price</label>
                                <input type="number" step="0.01" min="0" max="1999999.99" name="NetPrice" id="update-net" class="form-control form-control-sm" />
                                <span data-valmsg-for="update-net" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                            <input type="hidden" id="update-id" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-edit"></span> Update
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

