                { data: "forwarderPhoneNo", name: "ForwarderPhoneNo" },

            ],
            order: [[0, "asc"]]
        }).on("draw.dt", function () {
            //HideLoader("forwarder");

        });

        // Payment Details
        var paymentsDT = $('.table-payments').on('preXhr.dt', function (e, settings, data) {
            //ShowLoader("payments");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetPaymentJson")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
