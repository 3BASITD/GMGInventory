@model CustomerVM

@{
    ViewData["Title"] = "Customer Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Index">Customers</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
                <button type="button" class="btn btn-primary btn-sm float-right shippingBtn ml-2" data-bs-toggle="modal" data-bs-target="#shippingModal">
                    <span class="fas fa-plus"></span> Add Shipping Details
                </button>
                <button type="button" class="btn btn-primary btn-sm float-right forwarderBtn ml-2" data-bs-toggle="modal" data-bs-target="#forwarderModal">
                    <span class="fas fa-plus"></span> Add Forwarder Details
                </button>
                <button type="button" class="btn btn-primary btn-sm float-right editBtn ml-2" data-bs-toggle="modal" data-bs-target="#editModal">
                    <span class="fas fa-edit"></span> Edit Customer
                </button>

            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Code)
                        </span>
                        <b class="d-block">
                            @Model?.Code
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.RegionName)
                        </span>
                        <b class="d-block">
                            @Model?.RegionName
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ContactPerson)
                        </span>
                        <b class="d-block">
                            @(string.IsNullOrWhiteSpace(Model?.ContactPerson) ? "-" : Model?.ContactPerson)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Email)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Email) ? "-" : Model?.Email)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.TIN)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.TIN) ? "-" : Model?.TIN)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditLimit)
                    </span>
                    <b class="d-block">
                        @Model?.CreditLimit
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block">
                        @Model?.Name
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AreaName)
                    </span>
                    <b class="d-block">
                        @Model?.AreaName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactNumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.ContactNumber) ? "-" : Model?.ContactNumber)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AgentName)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.AgentName) ? "-" : Model?.AgentName)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.VAT)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.VAT) ? "-" : Model?.VAT)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Remarks) ? "-" : Model?.Remarks)
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.IsActive)
                    </span>
                    <b class="d-block">
                         
                    @if (Model?.IsActive == true)
           
                            {
                                <span class="fas fa-check text-success"></span>
                            }
                            else
                            {
                                <span class="fas fa-times text-danger"></span>
                            }
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerTypeName)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerTypeName
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Address)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Address) ? "-" : Model?.Address)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.FaxNumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.FaxNumber) ? "-" : Model?.FaxNumber)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditTermName)
                    </span>
                    <b class="d-block">
                        @Model?.CreditTermName
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-danger card-tabs">
                    <div class="card-header p-0 pt-1 pl-2 pr-2">
                        <ul class="nav nav-tabs nav-fill" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="nav-shipping-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-shipping"
                                   aria-controls="nav-shipping" aria-selected="true">
                                    Shipping Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-forwarder-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-forwarder"
                                   aria-controls="nav-forwarder" aria-selected="true">
                                    Forwarder Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-receivables-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-receivables"
                                   aria-controls="nav-receivables" aria-selected="true">
                                    Receivables
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-payments-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-payments"
                                   aria-controls="nav-payments" aria-selected="true">
                                    Payments
                                </a>
                            </li>

                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-shipping" role="tabpanel"
                                 aria-labelledby="nav-shipping-tab">
                                <table class="table table-head-fixed table-striped table-hover table-shipping">
                                    <thead>
                                        <tr>
                                            <th>Address</th>
                                            <th>Contact Person</th>
                                            <th>Fax Number</th>
                                            <th>Phone Number</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-forwarder" role="tabpanel" aria-labelledby="nav-forwarder-tab">
                                <table class="table table-head-fixed table-striped table-hover table-forwarder">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Address</th>
                                            <th>Fax Number</th>
                                            <th>Phone Number</th>

                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-receivables" role="tabpanel" aria-labelledby="nav-receivables-tab">
                                <table class="table table-head-fixed table-striped table-hover table-receivables">
                                    <thead>
                                        <tr>
                                            <th>Invoiced Date</th>
                                            <th>Invoiced Number</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-payments" role="tabpanel" aria-labelledby="nav-payments-tab">
                                <table class="table table-head-fixed table-striped table-hover table-payments">
                                    <thead>
                                        <tr>
                                            <th>Collector Receipt #</th>
                                            <th>SOA No</th>
                                            <th>Total Invoice Amount</th>
                                            <th>Amount Paid</th>
                                            <th>Over Payment</th>
                                            <th>Transaction Date</th>
                                            <th>Created By</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>


                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




