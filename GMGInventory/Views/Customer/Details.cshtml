        <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                <button class="nav-link active" id="nav-home-tab" data-bs-toggle="tab" data-bs-target="#nav-shipping" type="button" role="tab" aria-controls="nav-home" aria-selected="true">Shipping Address</button>
                <button class="nav-link" id="nav-profile-tab" data-bs-toggle="tab" data-bs-target="#nav-receivables" type="button" role="tab" aria-controls="nav-profile" aria-selected="false">Receivables</button>
                <button class="nav-link" id="nav-contact-tab" data-bs-toggle="tab" data-bs-target="#nav-payments" type="button" role="tab" aria-controls="nav-contact" aria-selected="false">Payments</button>
                <button class="nav-link" id="nav-contact-tab" data-bs-toggle="tab" data-bs-target="#nav-discount" type="button" role="tab" aria-controls="nav-contact" aria-selected="false">Brand Discount</button>
            </div>
        </nav>
        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane fade show active" id="nav-shipping" role="tabpanel" aria-labelledby="nav-home-tab">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">

                                <span class="card-title">Shipping Address Details</span>
                                <div class="card-tools">
                                    @if (userAccess.CanAdd)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm float-right shippingBtn ml-2" data-bs-toggle="modal" data-bs-target="#shippingModal">
                                            <span class="fas fa-plus"></span> Add Shipping Details
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="card-body">
                                <table class="table table-head-fixed table-striped table-hover table-shipping">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Address</th>
                                            <th>Contact Person</th>
                                            <th>Fax Number</th>
                                            <th>Phone Number</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="tab-pane fade" id="nav-receivables" role="tabpanel" aria-labelledby="nav-profile-tab">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                Receivables
                            </div>
                            <div class="card-body">
                                <table class="table table-head-fixed table-striped table-hover table-receivables">
                                    <thead>
                                        <tr>
                                            <th>Invoiced Date</th>
                                            <th>Invoiced Number</th>
                                            <th>BIR Invoiced Number</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3" class="text-end">Total</th>
                                            <th class="text-end">0.00</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="tab-pane fade" id="nav-payments" role="tabpanel" aria-labelledby="nav-contact-tab">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                Payments
                            </div>
                            <div class="card-body">
                                <table class="table table-head-fixed table-striped table-hover table-payments">
                                    <thead>
                                        <tr>
                                            <th>Collector Receipt #</th>
                                            <th>SOA No</th>
                                            <th>Total Invoice Amount</th>
                                            <th>Amount Paid</th>
                                            <th>Over Payment</th>
                                            <th>Transaction Date</th>
                                            <th>Created By</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th colspan="2" class="text-end">Total</th>
                                            <th class="text-end">0.00</th>
                                            <th class="text-end">0.00</th>
                                            <th class="text-end">0.00</th>
                                            <th colspan="3"></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="tab-pane fade" id="nav-discount" role="tabpanel" aria-labelledby="nav-contact-tab">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">

                                <span class="card-title">Brand Discount</span>
                                <div class="card-tools">
                                    @if (userAccess.CanUploadDownload)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm float-right downloadDiscountBtn ml-2">
                                            <span class="fas fa-download"></span> Download
                                        </button>
                                    }

                                    @if (userAccess.CanAdd)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm float-right discountBtn ml-2" data-bs-toggle="modal" data-bs-target="#discountModal">
                                            <span class="fas fa-plus"></span> Add Discount
                                        </button>
                                    }

                                </div>
                            </div>
                            <div class="card-body">
                                <table class="table table-head-fixed table-striped table-hover table-discount">
                                    <thead>
                                        <tr>
                                            
                                            <th>Brand</th>
                                            <th>Discount</th>
                                            <th>Date Created</th>
                                            <th>Created By</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        
        
        
    </div>
</div>




<!-- Edit Modal -->
<div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" style="max-width: 70%;" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Customer</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="editForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-code" class="control-label mb-0 d-block">Customer Code</label>
                                <input type="text" name="Code" id="edit-code" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-name" class="control-label mb-0 d-block">Customer Name</label>
                                <input type="text" name="Name" id="edit-name" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="edit-commission" class="form-label mb-0">Commission Rate</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.01" min="0" max="100" id="edit-commission" name="CommissionRate" class="form-control form-control-sm" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="form-group">
                                <label class="control-label mb-0 d-block" for="edit-usearearate"> Use Area Rate? </label>
                                <input class="form-check-input" type="checkbox" id="edit-usearearate" name="UseAreaRate">
                                @* <label for="edit-is-active" class="control-label mb-0 d-block">Use Area Rate?</label>
                                <input type="checkbox" name="IsActive" id="edit-is-active" class="form-control form-control-sm" />*@
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-region" class="control-label mb-0 d-block">Region</label>
                                <select name="Region" id="edit-region" class="form-control" style="width: 100%">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-area" class="control-label mb-0 d-block">Area</label>
                            <select name="Area" id="edit-area" class="form-control" style="width: 100%">
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-customer-type" class="control-label mb-0 d-block">Customer Type</label>
                            <select name="CustomerType" id="edit-customer-type" class="form-control" style="width: 100%">
                            </select>
                        </div>
                    </div>
