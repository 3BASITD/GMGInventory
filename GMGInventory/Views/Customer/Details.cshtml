                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="create-remarks" class="control-label mb-0 d-block">Remarks</label>
                                <input name="Remarks" id="create-remarks" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-remarks" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


