            rules: {
                Code: { required: true, maxlength: 50 },
                Name: { required: true, maxlength: 100 },
                Email: { maxlength: 50 },
                CreditLimit: { required: true, range: [0, 9999999999.99] },
                Branch: { maxlength: 250},
                Priority: { maxlength: 250},
                // Address: { required: true },
                // ContactPerson: { maxlength: 150 },
                // ContactNumber: { maxlength: 100 },
