@model CustomerVM

@{
    ViewData["Title"] = "Customer Details";
    ViewData["TitleDetails"] = $"[{Model.Code}]";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Index">Customers</a></li>
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-light btn-sm float-right ml-2" asp-action="Index">
                <span class="fas fa-arrow-left"></span> Back to List
            </a>
            @if (userAccess.CanEdit)
            {
                <button type="button" class="btn btn-primary btn-sm float-right editBtn ml-2" data-bs-toggle="modal" data-bs-target="#editModal">
                    <span class="fas fa-edit"></span> Edit Customer
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Code)
                    </span>
                    <b class="d-block details-code">
                        @Model?.Code
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block details-name">
                        @Model?.Name
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.IsActive)
                    </span>
                    <b class="d-block">

                        @if (Model?.IsActive == true)

                        {
                            <span class="fas fa-check text-success"></span>
                        }
                        else
                        {
                            <span class="fas fa-times text-danger"></span>
                        }
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.RegionName)
                    </span>
                    <b class="d-block details-region">
                        @Model?.RegionName
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AreaName)
                    </span>
                    <b class="d-block details-area">
                        @Model?.AreaName
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerTypeName)
                    </span>
                    <b class="d-block details-type">
                        @Model?.CustomerTypeName
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Email)
                    </span>
                    <b class="d-block details-email">
                        @(string.IsNullOrWhiteSpace(Model?.Email) ? "N/A" : Model?.Email)
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AgentName)
                    </span>
                    <b class="d-block details-agent">
                        @(string.IsNullOrWhiteSpace(Model?.AgentName) ? "N/A" : Model?.AgentName)
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.TIN)
                    </span>
                    <b class="d-block details-tin">
                        @(string.IsNullOrWhiteSpace(Model?.TIN) ? "N/A" : Model?.TIN)
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.VAT)
                    </span>
                    <b class="d-block details-vat">
                        @(string.IsNullOrWhiteSpace(Model?.VAT) ? "N/A" : Model?.VAT)
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditTermName)
                    </span>
                    <b class="d-block details-credit-term">
                        @Model?.CreditTermName
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditLimit)
                    </span>
                    <b class="d-block details-credit-limit">
                        @Model?.CreditLimit
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CommissionRate)
                    </span>
                    <b class="d-block details-commission-rate">
                        @Model?.CommissionRate
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerAccountStatusName)
                    </span>
                    <b class="d-block details-account-status">
                        @Model?.CustomerAccountStatusName
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Branch)
                    </span>
                    <b class="d-block details-branch">
                        @(string.IsNullOrWhiteSpace(Model?.Branch) ? "N/A" : Model?.Branch)
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Priority)
                    </span>
                    <b class="d-block details-priority">
                        @(string.IsNullOrWhiteSpace(Model?.Priority) ? "N/A" : Model?.Priority)
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block details-remarks">
                        @(string.IsNullOrWhiteSpace(Model?.Remarks) ? "N/A" : Model?.Remarks)
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </span>
                    <b class="d-block">
                        @Model?.DateCreated
                    </b>
                </p>
            </div>
            <div class="col-12 col-md-4 col-sm-6">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreatedBy)
                    </span>
                    <b class="d-block">
                        @Model?.CreatedBy
                    </b>
                </p>
            </div>
            @if (Model?.ModifiedBy != null)
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ModifiedBy)
                        </span>
                        <b class="d-block">
                            @Model?.ModifiedBy
                        </b>
                    </p>
                </div>
            }
            @if (Model?.DateModified != null)
            {
                <div class="col-12 col-md-4 col-sm-6">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </span>
                        <b class="d-block">
                            @Model?.DateModified
                        </b>
                    </p>
                </div>
            }
        </div>
