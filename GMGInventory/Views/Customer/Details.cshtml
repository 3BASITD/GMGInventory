@model CustomerVM

@{
    ViewData["Title"] = "Customer Details";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Index">Items</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
                <button type="button" class="btn btn-primary btn-sm float-right shippingBtn ml-2" data-bs-toggle="modal" data-bs-target="#shippingModal">
                    <span class="fas fa-plus"></span> Add Shipping Details
                </button>
                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="fas fa-plus"></span> Add Forwarder Details
                </button>
                <button type="button" class="btn btn-primary btn-sm float-right editBtn ml-2" data-bs-toggle="modal" data-bs-target="#editModal">
                    <span class="fas fa-plus"></span> Edit Customer
                </button>

            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Code)
                        </span>
                        <b class="d-block">
                            @Model?.Code
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.Regions)
                        </span>
                        <b class="d-block">
                            @Model?.Regions
                        </b>
                    </p>
                    <p class="text-sm">
                        <span class="text-muted">
                            @Html.DisplayNameFor(model => model.ContactPerson)
                        </span>
                        <b class="d-block">
                            @(string.IsNullOrWhiteSpace(Model?.ContactPerson) ? "-" : Model?.ContactPerson)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Email)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Email) ? "-" : Model?.Email)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.TIN)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.TIN) ? "-" : Model?.TIN)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditLimit)
                    </span>
                    <b class="d-block">
                        @Model?.CreditLimit
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Name)
                    </span>
                    <b class="d-block">
                        @Model?.Name
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Areas)
                    </span>
                    <b class="d-block">
                        @Model?.Areas
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.ContactNumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.ContactNumber) ? "-" : Model?.ContactNumber)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.AgentName)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.AgentName) ? "-" : Model?.AgentName)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.VAT)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.VAT) ? "-" : Model?.VAT)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Remarks)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Remarks) ? "-" : Model?.Remarks)
                    </b>
                </p>
            </div>
            <div class="col-4">
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.IsActive)
                    </span>
                    <b class="d-block">
                        @Model?.IsActive
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CustomerTypes)
                    </span>
                    <b class="d-block">
                        @Model?.CustomerTypes
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.Address)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.Address) ? "-" : Model?.Address)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.FaxNumber)
                    </span>
                    <b class="d-block">
                        @(string.IsNullOrWhiteSpace(Model?.FaxNumber) ? "-" : Model?.FaxNumber)
                    </b>
                </p>
                <p class="text-sm">
                    <span class="text-muted">
                        @Html.DisplayNameFor(model => model.CreditTerms)
                    </span>
                    <b class="d-block">
                        @Model?.CreditTerms
                    </b>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card card-danger card-tabs">
                    <div class="card-header p-0 pt-1 pl-2 pr-2">
                        <ul class="nav nav-tabs nav-fill" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="nav-shipping-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-shipping"
                                   aria-controls="nav-shipping" aria-selected="true">
                                    Shipping Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-forwarder-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-forwarder"
                                   aria-controls="nav-forwarder" aria-selected="true">
                                    Forwarder Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-receivables-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-receivables"
                                   aria-controls="nav-receivables" aria-selected="true">
                                    Receivables
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="nav-payments-tab" role="tab"
                                   data-bs-toggle="tab" data-bs-target="#nav-payments"
                                   aria-controls="nav-payments" aria-selected="true">
                                    Payments
                                </a>
                            </li>

                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="nav-shipping" role="tabpanel"
                                 aria-labelledby="nav-shipping-tab">
                                <table class="table table-head-fixed table-striped table-hover table-shipping">
                                    <thead>
                                        <tr>
                                            <th>Address</th>
                                            <th>Contact Person</th>
                                            <th>Fax Number</th>
                                            <th>Phone Number</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-forwarder" role="tabpanel" aria-labelledby="nav-forwarder-tab">
                                <table class="table table-head-fixed table-striped table-hover table-forwarder">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Address</th>
                                            <th>Fax Number</th>
                                            <th>Phone Number</th>

                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-receivables" role="tabpanel" aria-labelledby="nav-receivables-tab">
                                <table class="table table-head-fixed table-striped table-hover table-receivables">
                                    <thead>
                                        <tr>
                                            <th>Invoiced Date</th>
                                            <th>Invoiced Number</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="nav-payments" role="tabpanel" aria-labelledby="nav-payments-tab">
                                <table class="table table-head-fixed table-striped table-hover table-payments">
                                    <thead>
                                        <tr>
                                            <th>Collector Receipt #</th>
                                            <th>SOA No</th>
                                            <th>Total Invoice Amount</th>
                                            <th>Amount Paid</th>
                                            <th>Over Payment</th>
                                            <th>Transaction Date</th>
                                            <th>Created By</th>
                                            <th>Remarks</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>


                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<!-- Edit Modal -->
<div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" style="max-width: 70%;" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Customer</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="editForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-code" class="control-label mb-0 d-block">Customer Code</label>
                                <input type="text" name="Code" id="edit-code" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-name" class="control-label mb-0 d-block">Customer Name</label>
                                <input type="text" name="Name" id="edit-name" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-region" class="control-label mb-0 d-block">Region</label>
                                <select name="Region" id="edit-region" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="edit-region" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-area" class="control-label mb-0 d-block">Area</label>
                            <select name="Area" id="edit-area" class="form-control" style="width: 100%">
                            </select>
                            <span data-valmsg-for="edit-area" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label for="edit-customer-type" class="control-label mb-0 d-block">Customer Type</label>
                            <select name="CustomerType" id="edit-customer-type" class="form-control" style="width: 100%">
                            </select>
                            <span data-valmsg-for="edit-customer-type" data-valmsg-replace="true" class="text-danger"></span>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-contact-person" class="control-label mb-0 d-block">Contact Person</label>
                                <input type="text" name="ContactPerson" id="edit-contact-person" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-contact-person" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-contact-number" class="control-label mb-0 d-block">Contact Number</label>
                                <input type="text" name="ContactNumber" id="edit-contact-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-contact-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-address" class="control-label mb-0 d-block">Address</label>
                                <input type="text" name="Address" id="edit-address" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-address" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-email" class="control-label mb-0 d-block">Email Address</label>
                                <input type="text" name="Email" id="edit-email" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-email" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-agent" class="control-label mb-0 d-block">Agent Name</label>
                                <select name="Agent" id="edit-agent" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="edit-agent" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-fax-number" class="control-label mb-0 d-block">Fax Number</label>
                                <input type="text" name="FaxNumber" id="edit-fax-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-fax-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-tin" class="control-label mb-0 d-block">TIN</label>
                                <input type="text" name="TIN" id="edit-tin" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-tin" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-vat" class="control-label mb-0 d-block">VAT</label>
                                <input type="text" name="VAT" id="edit-vat" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-vat" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-credit-term" class="control-label mb-0 d-block">Credit Term</label>
                                <select name="CreditTerm" id="edit-credit-term" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="edit-credit-term" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="edit-credit-limit" class="control-label mb-0 d-block">Credit Limit</label>
                                <input type="number" name="CreditLimit" id="edit-credit-limit" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-credit-limit" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="edit-remarks" class="control-label mb-0 d-block">Remarks</label>
                                <input name="Remarks" id="edit-remarks" class="form-control form-control-sm" />
                                <span data-valmsg-for="edit-remarks" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <input type="hidden" id="edit-id" />

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-edit"></span> Update
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>





