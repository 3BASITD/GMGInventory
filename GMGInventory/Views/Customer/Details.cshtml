@section Scripts {
    <script>


        $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
            var selectedTab = e.currentTarget.dataset.bsTarget;
            if (selectedTab == "#nav-shipping") shippingDT.ajax.reload();
            if (selectedTab == "#nav-forwarder") forwarderDT.ajax.reload();
            if (selectedTab == "#nav-receivables") receivablesDT.ajax.reload();
            if (selectedTab == "#nav-payments") paymentsDT.ajax.reload();
        });

        var loaderDisplayed = [];

        function ShowLoader(mod) {
            if (loaderDisplayed.length === 0) {
                showLoader();
            }
            loaderDisplayed.push(mod);
        }

        function HideLoader(mod) {
            loaderDisplayed = loaderDisplayed.filter(s => s !== mod);
            if (loaderDisplayed.length === 0) {
                hideLoader();
            }
        }

        // Load Select2 Region
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function (data, status, xhr) {
                $("#create-region").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
