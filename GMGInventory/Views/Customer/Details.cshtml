            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoEdit();
            }
        });


        // Send Edit to Controller
        function DoEdit() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("EditJson")",
                data: {
                    Id: @Model.Id,
                    Code: $("#edit-code").val(),
                    Name: $("#edit-name").val(),
                    AreaId: $("#edit-area").val() ?? @Model?.AreaId,
                    CommissionRateD: $("#edit-commission").val(),
                    UseAreaRate: $("#edit-usearearate").prop("checked"),
                    CustomerTypeId: $("#edit-customer-type").val(),
                    Email: $("#edit-email").val(),
                    AgentId: $("#edit-agent").val(),
                    TIN: $("#edit-tin").val(),
                    VAT: $("#edit-vat").val(),
                    CreditTermId: $("#edit-credit-term").val(),
                    CreditLimitD: $("#edit-credit-limit").val(),
                    CustomerAccountStatusId: $("#edit-account-status").val(),
                    Remarks: $("#edit-remarks").val(),
                    IsActive: $("#edit-isactive").val(),
                    Branch: $("#edit-branch").val(),
                    PriorityD: $("#edit-priority").val()
                    // Address: $("#edit-address").val(),
                    // ContactPerson: $("#edit-contact-person").val(),
                    // ContactNumber: $("#edit-contact-number").val(),
                    // FaxNumber: $("#edit-fax-number").val()
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#editModal").modal("hide");

                        $(".details-code").text($("#edit-code").val());
                        $(".details-region").text($("#edit-region").select2("data")[0].text);
                        $(".details-email").text($("#edit-email").val() || "N/A");
                        $(".details-tin").text($("#edit-tin").val() || "N/A");
                        $(".details-credit-limit").text(FormatStringDecimal($("#edit-credit-limit").val()));
                        $(".details-name").text($("#edit-name").val());
                        if ($("#edit-area").val() != null) {
                            $(".details-area").text($("#edit-area").select2("data")[0].text);
                        }
                        $(".details-agent").text($("#edit-agent").select2("data")[0].text || "N/A");
                        $(".details-vat").text($("#edit-vat").val() || "N/A");
                        $(".details-remarks").text($("#edit-remarks").val() || "N/A");
                        $(".details-type").text($("#edit-customer-type").select2("data")[0].text);
                        $(".details-credit-term").text($("#edit-credit-term").select2("data")[0].text);
                        $(".details-commission-rate").text($("#edit-usearearate").prop("checked") ? "N/A" : FormatStringDecimal($("#edit-commission").val()));
                        $(".details-account-status").text($("#edit-account-status").select2("data")[0].text);
                        $(".details-branch").text($("#edit-branch").val());
                        $(".details-priority").text($("#edit-priority option:selected").text());
                        // $(".details-address").text($("#edit-address").val() || "N/A");
                        // $(".details-contact-person").text($("#edit-contact-person").val() || "N/A");
                        // $(".details-contact-number").text($("#edit-contact-number").val() || "N/A");
                        // $(".details-fax-number").text($("#edit-fax-number").val() || "N/A");
                        hideLoader();
                    }
                }
            });
        }

