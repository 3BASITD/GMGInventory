@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        //$('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
        //    var selectedTab = e.currentTarget.dataset.bsTarget;
        //    if (selectedTab == "#nav-shipping") shippingDT.ajax.reload();
        //    if (selectedTab == "#nav-forwarder") forwarderDT.ajax.reload();
        //    if (selectedTab == "#nav-receivables") receivablesDT.ajax.reload();
        //    if (selectedTab == "#nav-payments") paymentsDT.ajax.reload();
        //});

        var loaderDisplayed = [];

        function ShowLoader(mod) {
            if (loaderDisplayed.length === 0) {
                showLoader();
            }
            loaderDisplayed.push(mod);
        }

        function HideLoader(mod) {
            loaderDisplayed = loaderDisplayed.filter(s => s !== mod);
            if (loaderDisplayed.length === 0) {
                hideLoader();
            }
        }

        // Load Select2 Region
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function (data, status, xhr) {
                $("#create-region").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-region").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        $("#edit-region").on("select2:select", function () {
            $("#edit-area").val('').trigger('change');
        });

        // Load Select2 Area
        $("#edit-area").select2({
            //minimumInputLength: 1,
            placeholder: "",
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.name + "</strong><span> - " + repo.text + "</span>");
            },
            ajax: {
                url: "@Url.Action("GetByRegionOptions", "Area")",
                data: function (params) {
                    let base = $.fn.select2.defaults.defaults.ajax.data(params);
                    return Object.assign(base, {
                        region: $("#edit-region").val(),
                        includeId: @Model?.AreaId
                    });
                }
            },
            dropdownParent: $("#editModal")
        });

        // Load Select2 Customer Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CustomerType")",
            success: function (data, status, xhr) {
                $("#create-customer-type").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#createModal")
                });
                $("#edit-customer-type").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Agent Name
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Agent")",
            success: function (data, status, xhr) {
                $("#create-agent").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-agent").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });


        // Load Select2 Credit Term
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CreditTerm")",
            success: function (data, status, xhr) {
                $("#create-credit-term").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-credit-term").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Customer Account Status
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CustomerAccountStatus")",
            success: function (data, status, xhr) {
                $("#create-account-status").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#createModal"),
                    minimumResultsForSearch: -1
                });
                $("#edit-account-status").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#editModal"),
                    minimumResultsForSearch: -1
                });
            }
        });

        // Load Select2 Brand Name
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Brand")",
            success: function (data, status, xhr) {

                $("#save-discount-brand").select2({
                    ajax: null, //already fetched outside
                    data: data,
                    dropdownParent: $("#discountModal")
                });
            }
        });



        //Shipping Details
        var shippingDT = $('.table-shipping').on('preXhr.dt', function (e, settings, data) {
            //ShowLoader("shipping");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetShippingJson")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        if (data.isDefault == true) {
                            return '<span class="text-success" data-microtip-title="Default Address" data-microtip-position="top" role="tooltip"><span class="fas fa-star"></span></span>';
                        } else {
                            return '';
                        }
                    }
                },
                { data: "address", name: "Address" },
                { data: "contactPerson", name: "ContactPerson" },
                { data: "faxNumber", name: "FaxNumber" },
                { data: "phoneNumber", name: "PhoneNumber" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (user_access.canEdit) {
                            if (data.isActive != true) {
                                actions += '<button type="button" class="btn btn-success btn-xs btn-reactivate-shipping" data-microtip-title="Reactivate Shipping Address" data-microtip-position="top" role="tooltip"><span class="fas fa-check"></span></button>';
                            } else {
                                if (data.isDefault != true) {
                                    actions += '<button type="button" class="btn btn-info btn-xs btn-default-shipping" data-microtip-title="Set Default Shipping Address" data-microtip-position="top" role="tooltip"><span class="fas fa-star"></span></button>';
                                }
                                actions += '<button type="button" class="btn btn-primary btn-xs btn-update-shipping" data-microtip-title="Update Shipping Address" data-microtip-position="top" role="tooltip"><span class="fas fa-edit"></span></button>';
                            }
                        }
                        if (user_access.canDelete && data.isActive == true) {
                            actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-shipping" data-microtip-title="Delete / Deactivate Shipping Address" data-microtip-position="top" role="tooltip"><span class="fas fa-trash-alt"></span></button>';
                        }
                        return actions + '</div>';
                    },
                    className: "form-cell",
                    responsivePriority: 1
                }

            ],
            order: [[0, "asc"]]
        }).on("draw.dt", function () {
            //HideLoader("shipping");

            if (user_access.canDelete) {
                $('.btn-remove-shipping').off("click").on("click", function () {
                    swal({
                        title: "Delete / Deactivate Shipping Address",
                        text: "Are you sure you want to remove this record?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var row_data = shippingDT.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("DeleteOrDeactivateShippingJson")",
                                type: "POST",
                                data: { Id: row_data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        shippingDT.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
            }

            if (user_access.canEdit) {
                $('.btn-default-shipping').off("click").on("click", function () {
                    swal({
                        title: "Set Default Shipping Address",
                        text: "Are you sure you want to make this record as default?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var row_data = shippingDT.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("SetDefaultShippingJson")",
                                type: "POST",
                                data: { Id: row_data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        shippingDT.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });

                $('.btn-reactivate-shipping').off("click").on("click", function () {
                    swal({
                        title: "Reactivate Shipping Address",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var row_data = shippingDT.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("ReactivateShippingJson")",
                                type: "POST",
                                data: { Id: row_data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        shippingDT.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });

                $('.btn-update-shipping').off("click").on("click", function () {
                    var row_data = shippingDT.row($(this).parents('tr')).data();

                    $("#save-shipping-id").val(row_data.id);
                    $("#save-shipping-address").val(row_data.address);
                    $("#save-shipping-cperson").val(row_data.contactPerson);
                    $("#save-shipping-cnumber").val(row_data.phoneNumber);
                    $("#save-shipping-fnumber").val(row_data.faxNumber);

                    $("#shippingModal").modal("show");
                });
            }
        });


        //Discount Details
        var discountDT = $('.table-discount').on('preXhr.dt', function (e, settings, data) {
            //ShowLoader("discount");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetDiscountJson")",
                type: "POST",
                data: function (data) {
                    data.Id = @Model?.Id;
                },
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: false,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [

                { data: "brandName", name: "Brand" },
                { data: "discountRate", name: "DiscountRate" },
                { data: "dateCreated", name: "DateCreated" },
                { data: "createdBy", name: "CreatedBy" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        if (data.isActive) {
                            if (user_access.canEdit) {
                            
                                actions += '<button type="button" class="btn btn-primary btn-xs btn-update-discount" data-microtip-title="Update Brand Discount" data-microtip-position="top" role="tooltip"><span class="fas fa-edit"></span></button>';
                            
                            }
                            if (user_access.canDelete) {
                                actions += '<button type="button" class="btn btn-danger btn-xs btn-remove-discount" data-microtip-title="Delete / Deactivate Brand Discount" data-microtip-position="top" role="tooltip"><span class="fas fa-trash-alt"></span></button>';
                            }
                        } 
                        
                        else{
                            if (user_access.canAdd || user_access.canEdit) {
                               actions += '<button data-id="' + data.id + '" class="btn btn-success btn-xs btn-reactivate-discount" data-microtip-title="Reactivate Discount" data-microtip-position="bottom-left" role="tooltip"><span class="fas fa-check"></span></button>';
                            }
                        }
                        return actions + '</div>';
                    },
                    className: "form-cell",
                    responsivePriority: 1
                }

            ],
            order: [[0, "asc"]]
        }).on("draw.dt", function () {
            //HideLoader("discount");

            if (user_access.canDelete) {
                $('.btn-remove-discount').off("click").on("click", function () {
                    swal({
                        title: "Delete Brand Discount",
                        text: "Are you sure you want to remove this record?",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var row_data = discountDT.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("DeleteOrDeactivateDiscountJson")",
                                type: "POST",
                                data: { Id: row_data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        discountDT.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
            }

            if (user_access.canEdit) {

                $('.btn-reactivate-discount').off("click").on("click", function () {
                    swal({
                        title: "Reactivate Discount",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var row_data = discountDT.row($(this).parents('tr')).data();

                            $.ajax({
                                url: "@Url.Action("ReactivateDiscountJson")",
                                type: "POST",
                                data: { Id: row_data.id },
                                success: function (data, status, xhr) {
                                    if (data.status == "Success") {
                                        swal.close();
                                        discountDT.ajax.reload();
                                        toastr.success(data.message, data.status);
                                    } else {
                                        toastr.error(data.message, data.status);
                                    }
                                }
                            });
                        }
                    });
                });
                
                $('.btn-update-discount').off("click").on("click", function () {
                    var row_data = discountDT.row($(this).parents('tr')).data();

                    $("#save-discount-id").val(row_data.id);
                    $("#save-discount-brand").val(row_data.brandId).trigger("change");
                    $("#save-discount").val(row_data.discount);
                    

                    $("#discountModal").modal("show");
                });
            }
        });

        $(".discountBtn").click(function (e) {
            $("#save-shipping-id").val("");
            $("#save-discount-brand").val(0).trigger("change");
            $("#save-discount").val("");
            
        });

        // Forwarder Details
        var forwarderDT = $('.table-forwarder').on('preXhr.dt', function (e, settings, data) {
            //ShowLoader("forwarder");
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetForwarderJson")",
