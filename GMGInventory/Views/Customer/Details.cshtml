            },
            messages: {
                Code: { required: "Please enter code.", maxlength: "Code must not exceed 50 characters." },
                Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                Email: { maxlength: "Email number must not exceed 50 characters." },
                CreditLimit: { required: "Please enter credit limit.", range: "Credit Limit must be between 0-9999999999.99." },
                Branch: { maxlength: "Branch must not exceed 250 characters." },
                //Priorities: { maxlength: "Priority must not exceed 250 characters." },
