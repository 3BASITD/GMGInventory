@model IEnumerable<CustomerVM>

@{
    ViewData["Title"] = "Customer";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
            <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                <span class="fas fa-plus"></span> New Customer
            </button>
            <button type="button" class="btn btn-secondary btn-sm float-right uploadBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
                <span class="fas fa-upload"></span> Upload
            </button>
            <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                <span class="fas fa-download"></span> Download
            </button>
    </div>

    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-Customer">
            <thead>
                <tr>
                  
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AgentName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreditLimit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OutstandingBalance)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                   
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>


<!-- Create Modal -->
<div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static" >
    <div class="modal-dialog" style="max-width: 70%;" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Customer</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form autocomplete="off" id="createForm">
                <div class="modal-body" >
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-code" class="control-label mb-0 d-block">Customer Code</label>
                                <input type="text" name="Code" id="create-code" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-code" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-name" class="control-label mb-0 d-block">Customer Name</label>
                                <input type="text" name="Name" id="create-name" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-name" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                         @*<div class="col-md-4">
                            <div class="form-group">
                                <label for="create-is-active" class="control-label mb-0 d-block">Is Active?</label>
                                <input type="checkbox" name="IsActive" id="create-is-active" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-is-active" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>*@
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-region" class="control-label mb-0 d-block">Region</label>
                                <select name="Region" id="create-region" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-region" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                              <label for="create-area" class="control-label mb-0 d-block">Area</label>
                                <select name="Area" id="create-area" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-area" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                          <div class="col-md-4">
                            <label for="create-customer-type" class="control-label mb-0 d-block">Customer Type</label>
                                <select name="CustomerType" id="create-customer-type" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-customer-type" data-valmsg-replace="true" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-contact-person" class="control-label mb-0 d-block">Contact Person</label>
                                <input type="text" name="ContactPerson" id="create-contact-person" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-contact-person" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-contact-number" class="control-label mb-0 d-block">Contact Number</label>
                                <input type="text" name="ContactNumber" id="create-contact-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-contact-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                          <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-address" class="control-label mb-0 d-block">Address</label>
                                <input type="text" name="Address" id="create-address" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-address" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                               <label for="create-email" class="control-label mb-0 d-block">Email</label>
                                <input type="text" name="Email" id="create-email" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-email" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-agent" class="control-label mb-0 d-block">Agent Name</label>
                                <select name="Agent" id="create-agent" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-agent" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-fax-number" class="control-label mb-0 d-block">Fax Number</label>
                                <input type="text" name="FaxNumber" id="create-fax-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-fax-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-tin" class="control-label mb-0 d-block">TIN</label>
                                <input type="text" name="TIN" id="create-tin" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-tin" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                               <label for="create-vat" class="control-label mb-0 d-block">VAT</label>
                                <input type="text" name="VAT" id="create-vat" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-vat" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                         <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-credit-term" class="control-label mb-0 d-block">Credit Term</label>
                                <select name="CreditTerm" id="create-credit-term" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-credit-term" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-credit-limit" class="control-label mb-0 d-block">Credit Limit</label>
                                <input type="number" name="CreditLimit" id="create-credit-limit" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-credit-limit" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="create-remarks" class="control-label mb-0 d-block">Remarks</label>
                                <input name="Remarks" id="create-remarks" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-remarks" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
         // Load Select2 Region
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function(data, status, xhr) {
                $("#create-region").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-region").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Area
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Area")",
            success: function(data, status, xhr) {
                $("#create-area").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-area").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Customer Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CustomerType")",
            success: function(data, status, xhr) {
                $("#create-customer-type").select2({
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#createModal")
                });
                $("#edit-customer-type").select2({
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Agent Name
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Agent")",
            success: function(data, status, xhr) {
                $("#create-agent").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-agent").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        
        // Load Select2 Credit Term
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CreditTerm")",
            success: function(data, status, xhr) {
                $("#create-credit-term").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-credit-term").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load List on DataTable
        var dataTable = $('.table-Customer').on('preXhr.dt', function(e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson", "Customer")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "agentName", name: "AgentName" },
                { data: "creditLimit", name: "CreditLimit" },
                { data: "outstandingBalance", name: "OutstandingBalance" },
                {
                    data: function(data, type, dataToSet) {
                        if (data.isActive) {
                            return '<span class="fas fa-check text-success"></span>';
                        } else {
                            return '<span class="fas fa-times text-danger"></span>';
                        }
                    },
                    name: "IsActive"
                },
                {
                   orderable: false,
                    data: function(data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                        return actions;
                    }
                }
                
            ]
        });

        


         // Actions upon Display Create Modal
        $(".createBtn").click(function(e) {
            $("#create-code").val("");
            $("#create-area").val("");
            $("#create-customer-type").val("");
            $("#create-contact-person").val("");
            $("#create-contact-number").val("");
            $("#create-address").val("");
            $("#create-agent").prop("selectedIndex", 0).trigger("change");
            $("#create-region").prop("selectedIndex", 0).trigger("change");
            $("#create-credit-term").prop("selectedIndex", 0).trigger("change");
            $("#create-area").prop("selectedIndex", 0).trigger("change");
            $("#create-customer-type").prop("selectedIndex", 0).trigger("change");
            $("#create-email").val("");
            $("#create-fax-number").val("");
            $("#create-tin").val("");
            $("#create-vat").val("");
            $("#create-credit-limit").val("");
            $("#create-remarks").val("");
        });

        // Validation for Create Modal
        var validateCreate = $("#createForm").validate({
            errorClass: 'text-danger text-xs',
            rules: {
                Code: { required: true, maxlength: 10 },
                Name: { required: true, maxlength: 100 },
                ContactPerson: { maxlength: 50 },
                ContactNumber: { maxlength: 50 },
                Email: { maxlength: 50 },
                Address: { required: true, maxlength: 50 },
                CreditLimit: { required: true, range: [0, 1999999.99] }
            },
            messages: {
                Code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
                Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                ContactPerson: { maxlength: "Contact Person must not exceed 50 characters." },
                ContactNumber: { maxlength: "Contact Number number must not exceed 50 characters." },
                Email: { maxlength: "Email number must not exceed 50 characters." },
                Address: { required: "Please enter address.", maxlength: "Address must not exceed 50 characters." },
                CreditLimit: { required: "Please enter credit limit.", range: "Credit Limit must be between 0-1999999.99." }
                
            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoCreate();
            }
        });

        // Send Create to Controller
        function DoCreate() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("CreateJson")",
                data: {
                    Code: $("#create-code").val(),
                    Name: $("#create-name").val(),
                    AreaId: $("#create-area").val(),
                    CustomerTypeId: $("#create-customer-type").val(),
                    ContactPerson: $("#create-contact-person").val(),
                    ContactNumber: $("#create-contact-number").val(),
                    Address: $("#create-address").val(),
                    Email: $("#create-email").val(),
                    AgentId: $("#create-agent").val(),
                    FaxNumber: $("#create-fax-number").val(),
                    TIN: $("#create-tin").val(),
                    VAT: $("#create-vat").val(),
                    CreditTermId: $("#create-credit-term").val(),
                    CreditLimit: $("#create-credit-limit").val(),
                    Remarks: $("#create-remarks").val()
                },
                error: jQueryCommonError,
                success: function(data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#createModal").modal("hide");
                        dataTable.ajax.reload();
                    }
                }
            });
        }

        // load functions upon datatable load
        dataTable.on("draw", function () {
            hideLoader();

            DatatablesSearchOnEnter('.table-Customer', dataTable);
        });

      

    </script>
 }