@if (userAccess.CanUploadDownload)
{
    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" style="max-width: 90%;" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Customer</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label mb-0" for="upload-file">Excel File</label>
                        <input type="file" id="upload-file" name="file"
                        accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                        class="form-control form-control-sm" />
                    </div>
                    <table class="table table-striped" id="upload-table">
                        <thead>
                            <tr><th>Row #</th><th>Code</th><th>Name</th><th>Commission Rate</th><th>Region</th><th>Area</th><th>Customer Type</th><th>Contact Person</th><th>Contact Number</th><th>Address</th><th>Email</th><th>Agent</th><th>Fax Number</th><th>TIN</th><th>VAT</th><th>Credit Term</th><th>Credit Limit</th><th>Remarks</th><th>Status</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="DoUpload()">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 Region
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function (data, status, xhr) {
                $("#create-region").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-region").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        $("#create-region").on("select2:select", function () {
            $("#edit-area").val('').trigger('change');
        });

        // Load Select2 Area
        $("#create-area").select2({
            //minimumInputLength: 1,
            placeholder: "",
            ajax: {
                url: "@Url.Action("GetByRegionOptions", "Area")",
                dataType: 'json',
                type: "POST",
                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1,
                        region: $("#create-region").val()
                            };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 50) < data.total_count
                        }
                    };
                },
                cache: true
            },
            dropdownParent: $("#createModal")
        });

        // Load Select2 Customer Type
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CustomerType")",
            success: function (data, status, xhr) {
                $("#create-customer-type").select2({
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#createModal")
                });
                $("#edit-customer-type").select2({
                    data: data,
                    //theme: "bootstrap-5",
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load Select2 Agent Name
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Agent")",
            success: function (data, status, xhr) {
                $("#create-agent").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-agent").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });


        // Load Select2 Credit Term
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "CreditTerm")",
            success: function (data, status, xhr) {
                $("#create-credit-term").select2({
                    data: data,
                    dropdownParent: $("#createModal")
                });
                $("#edit-credit-term").select2({
                    data: data,
                    dropdownParent: $("#editModal")
                });
            }
        });

        // Load List on DataTable
        var dataTable = $('.table-Customer').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson", "Customer")",
                type: "POST",
            },
            processing: true,
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "agentName", name: "AgentName" },
                { data: "creditLimit", name: "CreditLimit" },
                { data: "outstandingBalance", name: "OutstandingBalance" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.isActive) {
                            return '<span class="fas fa-check text-success"></span>';
                        } else {
                            return '<span class="fas fa-times text-danger"></span>';
                        }
                    },
                    name: "IsActive"
                },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '<div class="btn-group" role="group">';
                        actions += '<a class="btn btn-info btn-xs" asp-action="Details" href="@Url.Action("Details")/' + data.id + '" data-microtip-title="View Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-info-circle"></i></a>';
                        if (data.isActive) {
                            if (user_access.canDelete) {
                                  actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Deactivate Customer" data-microtip-position="top-left" role="tooltip"><i class="fas fa-exclamation-triangle"></i></button>';
                            }
                        } else {
                            if (user_access.canAdd || user_access.canEdit) {
                                   actions += '<button data-id="' + data.id + '" class="btn btn-success btn-xs reactivateBtn" data-microtip-title="Reactivate Customer" data-microtip-position="top-left" role="tooltip"><i class="fas fa-check"></i></button>';
                            }
                        }
                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions + "</div>";
                    }
                }

            ]
        });

        if (user_access.canAdd) {
            $("#create-usearearate").on("change", function () {
                if ($(this).prop("checked")) {
                    $("#create-commission").val("");
                    $("#create-commission").prop("readonly", "readonly")
                }
                else {
                    $("#create-commission").val(0);
                    $("#create-commission").removeAttr("readonly")

                }


            })


            // Actions upon Display Create Modal
            $(".createBtn").click(function (e) {
                $("#create-code").val("");
                $("#create-area").val("");
                $("#create-customer-type").val("");
                $("#create-contact-person").val("");
                $("#create-contact-number").val("");
                $("#create-address").val("");
                $("#create-agent").prop("selectedIndex", 0).trigger("change");
                $("#create-region").prop("selectedIndex", 0).trigger("change");
                $("#create-credit-term").prop("selectedIndex", 0).trigger("change");
                $("#create-area").prop("selectedIndex", 0).trigger("change");
                $("#create-customer-type").prop("selectedIndex", 0).trigger("change");
                $("#create-email").val("");
                $("#create-fax-number").val("");
                $("#create-tin").val("");
                $("#create-vat").val("");
                $("#create-commission").val("");
                $("#create-usearearate").val("");
                $("#create-credit-limit").val("");
                $("#create-remarks").val("");
            });
        }
        // Validation for Create Modal
        var validateCreate = $("#createForm").validate({
            rules: {
                Code: { required: true, maxlength: 10 },
                Name: { required: true, maxlength: 100 },
                ContactPerson: { maxlength: 50 },
                ContactNumber: { maxlength: 50 },
                Email: { maxlength: 50 },
                Address: { required: true },
                CreditLimit: { required: true, range: [0, 1999999.99] }
            },
            messages: {
                Code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
                Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                ContactPerson: { maxlength: "Contact Person must not exceed 50 characters." },
                ContactNumber: { maxlength: "Contact Number number must not exceed 50 characters." },
                Email: { maxlength: "Email number must not exceed 50 characters." },
                Address: { required: "Please enter address." },
                CreditLimit: { required: "Please enter credit limit.", range: "Credit Limit must be between 0-1999999.99." }

            },
            submitHandler: function (form, event) {
                event.preventDefault();
                DoCreate();
            }
        });

        // Send Create to Controller
        function DoCreate() {
            $.ajax({
                type: "POST",
                url: "@Url.Action("CreateJson")",
                data: {
                    Code: $("#create-code").val(),
                    Name: $("#create-name").val(),
                    AreaId: $("#create-area").val(),
                    CustomerTypeId: $("#create-customer-type").val(),
                    ContactPerson: $("#create-contact-person").val(),
                    ContactNumber: $("#create-contact-number").val(),
                    Address: $("#create-address").val(),
                    Email: $("#create-email").val(),
                    AgentId: $("#create-agent").val(),
                    FaxNumber: $("#create-fax-number").val(),
                    TIN: $("#create-tin").val(),
                    VAT: $("#create-vat").val(),
                    CommissionRateD: $("#create-commission").val(),
                    UseAreaRate: $("#create-usearearate").prop("checked"),
                    CreditTermId: $("#create-credit-term").val(),
                    CreditLimit: $("#create-credit-limit").val(),
                    Remarks: $("#create-remarks").val()
                },
                success: function (data, status, xhr) {
                    if (data.status == "Error") {
                        toastr.error(data.message, "Error");
                    } else {
                        toastr.success(data.message, "Success");
                        $("#createModal").modal("hide");
                        dataTable.ajax.reload();
                        hideLoader();
                    }
                }
            });
        }



        // load functions upon datatable load
        dataTable.on("draw", function () {
            hideLoader();
            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Deactivate Customer",
                        text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteCustomerId').val(id);
                            $('#deleteCustomerForm').submit();
                        }
                    });
                });
            }
            if (user_access.canAdd || user_access.canEdit) {
                $('.reactivateBtn').click(function (e) {
                    swal({
                        title: "Reactivate Customer",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#reactivateCustomerId').val(id);
                            $('#reactivateCustomerForm').submit();
                        }
                    });
                });
            }
            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = dataTable.row($(this).parents('tr')).data();
                    $("#edit-id").val(data.id);
                    $("#edit-code").val(data.code);
                    $("#edit-area").val(data.areaId);
                    $("#edit-name").val(data.name);
                    $("#edit-customer-type").val(data.customerTypeId);
                    $("#edit-contact-person").val(data.contactPerson);
                    $("#edit-contact-number").val(data.contactNumber);
                    $("#edit-address").val(data.address);
                    $("#edit-agent").val(data.agentId).trigger("change");
                    $("#edit-region").val(data.regionId).trigger("change");
                    $("#edit-credit-term").val(data.creditTermId).trigger("change");
                    $("#edit-area").val(data.areaId).trigger("change");
                    $("#edit-customer-type").val(data.customerTypeId).trigger("change");
                    $("#edit-email").val(data.email);
                    $("#edit-fax-number").val(data.faxNumber);
                    $("#edit-tin").val(data.tin);
                    $("#edit-vat").val(data.vat);
                    $("#edit-credit-limit").val(data.creditLimit);
                    $("#edit-remarks").val(data.remarks);

                });
            }


            // Validation for Edit Modal
            var validateEdit = $("#editForm").validate({
                rules: {
                    Code: { required: true, maxlength: 10 },
                    Name: { required: true, maxlength: 100 },
                    ContactPerson: { maxlength: 50 },
                    ContactNumber: { maxlength: 50 },
                    Email: { maxlength: 50 },
                    Address: { required: true },
                    CreditLimit: { required: true, range: [0, 1999999.99] }
                },
                messages: {
                    Code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
                    Name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." },
                    ContactPerson: { maxlength: "Contact Person must not exceed 50 characters." },
                    ContactNumber: { maxlength: "Contact Number number must not exceed 50 characters." },
                    Email: { maxlength: "Email number must not exceed 50 characters." },
                    Address: { required: "Please enter address." },
                    CreditLimit: { required: "Please enter credit limit.", range: "Credit Limit must be between 0-1999999.99." }

                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoEdit();
                }
            });

            // Send Edit to Controller
            function DoEdit() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("EditJson")",
                    data: {
                        Id: $("#edit-id").val(),
                        Code: $("#edit-code").val(),
                        Name: $("#edit-name").val(),
                        AreaId: $("#edit-area").val(),
                        CustomerTypeId: $("#edit-customer-type").val(),
                        ContactPerson: $("#edit-contact-person").val(),
                        ContactNumber: $("#edit-contact-number").val(),
                        Address: $("#edit-address").val(),
                        Email: $("#edit-email").val(),
                        AgentId: $("#edit-agent").val(),
                        FaxNumber: $("#edit-fax-number").val(),
                        TIN: $("#edit-tin").val(),
                        VAT: $("#edit-vat").val(),
                        CreditTermId: $("#edit-credit-term").val(),
                        CreditLimit: $("#edit-credit-limit").val(),
                        Remarks: $("#edit-remarks").val()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#editModal").modal("hide");
                            dataTable.ajax.reload();
                        }
                    }
                });
            }


        });

        if (user_access.canUploadDownload) {
            $(".downloadBtn").click(function (e) {
                window.location = "@Url.Action("DownloadFile")";
            });

            var json_of_excel;
            var colnumber = 17; // number of columns required for upload
            var done_upload_excel = 0;
            var duplicate_upload = 0;

            var opts = {
                readAsDefault: 'ArrayBuffer',
                dragClass: 'drag',
                on: {
                    load: function (e, file) {
                        var result = new Uint8Array(e.target.result);
                        var xlsread = XLSX.read(result, { type: 'array' });
                        var xlsjson = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                        json_of_excel = xlsjson;
                    }
                }
            };
            $("#upload-file").fileReaderJS(opts);

            // Actions upon file selection
            $("#upload-file").on("change", function () {
                done_upload_excel = 0;
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            // Actions upon Display Upload Modal
            $(".uploadBtn").click(function (e) {
                done_upload_excel = 0;
                $("#upload-file").val("");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });
        }

        function DoUpload() {
                if (!$("#upload-file").val()) {
                    toastr.warning("Please select a file first", "Warning");
                } if (json_of_excel.length == 0) {
                    toastr.warning("The excel file is empty", "Warning");
                } else {
                    var columns = Object.keys(json_of_excel[0]);
                    $("#upload-table tbody").html("");
                    $("#upload-table").show();
                    duplicate_upload = 0;
                    for (var i = 0; i < json_of_excel.length; i++) {
                        var rowNum = json_of_excel[i].__rowNum__;
                        var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                        row$.append($('<td/>').html(json_of_excel[i].__rowNum__));
                        for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                            var cellValue = json_of_excel[i][columns[colIndex]];
                            if (cellValue == null)
                                cellValue = "";
                            row$.append($('<td/>').html(cellValue));
                        }
                        if (columns.includes("Code") == false
                            || columns.includes("Name") == false
                            || columns.includes("Commission Rate") == false
                            || columns.includes("Region") == false
                            || columns.includes("Area") == false
                            || columns.includes("Customer Type") == false
                            || columns.includes("Contact Person") == false
                            || columns.includes("Contact Number") == false
                            || columns.includes("Address") == false
                            || columns.includes("Email") == false
                            || columns.includes("Agent") == false
                            || columns.includes("Fax Number") == false
                            || columns.includes("TIN") == false
                            || columns.includes("VAT") == false
                            || columns.includes("Credit Term") == false
                            || columns.includes("Credit Limit") == false
                            || columns.includes("Remarks") == false) {
                            row$.append($('<td/>').html("Unexpected columns"));
                            UploadRowDone();
                        } else {
                            SaveXLSX(json_of_excel[i]["Code"], json_of_excel[i]["Name"], json_of_excel[i]["Commission Rate"], json_of_excel[i]["Region"], json_of_excel[i]["Area"], json_of_excel[i]["Customer Type"], json_of_excel[i]["Contact Person"], json_of_excel[i]["Contact Number"], json_of_excel[i]["Address"], json_of_excel[i]["Email"], json_of_excel[i]["Agent"], json_of_excel[i]["Fax Number"], json_of_excel[i]["TIN"], json_of_excel[i]["VAT"], json_of_excel[i]["Credit Term"], json_of_excel[i]["Credit Limit"], json_of_excel[i]["Remarks"], rowNum);
                            row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                        }
                        $("#upload-table").append(row$);
                    }
                }
            }
        
        function SaveXLSX(code, name, commissionRateD, regionName, areaName, customerTypeName, contactPerson, contactNumber, address, email, agentName, faxNumber, tIN, vAT, creditTermName, creditLimitD, remarks, rownum) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("UploadJson")",
                data: {
                    Code: code,
                    Name: name,
                    CommissionRateD: commissionRateD,
                    RegionName: regionName,
                    AreaName: areaName,
                    CustomerTypeName: customerTypeName,
                    ContactPerson: contactPerson,
                    ContactNumber: contactNumber,
                    Address: address,
                    Email: email,
                    AgentName: agentName,
                    FaxNumber: faxNumber,
                    TIN: tIN,
                    VAT: vAT,
                    CreditTermName: creditTermName,
                    CreditLimitD: creditLimitD,
                    Remarks: remarks

                },
                success: function (data, status, xhr) {
                    if (data.message == "Already exist") {
                        $("#upload-row" + rownum + "tr").remove();
                        duplicate_upload++;
                    } else {
                        $("#upload-row" + rownum + "td").html(data.status + ": " + data.message);
                    }
                },
                complete: function (xhr, status) {
                    UploadRowDone();
                }
            });
        }

        function UploadRowDone() {
            done_upload_excel++;
            if (done_upload_excel == json_of_excel.length && duplicate_upload > 0) {
                $("#upload-table").append('<tr><td>*</td><td colspan="17">Excluded ' + duplicate_upload + ' row(s)</td><td>Already exist</td></tr>');
                $("#upload-file").val("");
            }
        }


    </script>
 }