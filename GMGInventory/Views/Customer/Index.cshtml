@model IEnumerable<CustomerVM>

@{
    ViewData["Title"] = "Customer";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        @if (userAccess.CanAdd)
        {
                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="fas fa-plus"></span> New Customer
                </button>
        }
        @if (userAccess.CanUploadDownload)
        {
            <button type="button" class="btn btn-secondary btn-sm float-right uploadBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
                <span class="fas fa-upload"></span> Upload
            </button>
            <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn ml-2">
                <span class="fas fa-download"></span> Download
            </button>
        }
    </div>

    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-Customer">
            <thead>
                <tr>

                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AgentName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreditLimit)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OutstandingBalance)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>

                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (userAccess.CanDelete)
{
    <form id="deleteCustomerForm" asp-action="Delete">
        <input type="hidden" id="deleteCustomerId" name="Id" />
    </form>
}

@if (userAccess.CanAdd || userAccess.CanEdit)
{
    <form id="reactivateCustomerForm" asp-action="Reactivate">
        <input type="hidden" id="reactivateCustomerId" name="Id" />
    </form>
}
@if (userAccess.CanAdd)
{
    <!-- Create Modal -->
    <div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" style="max-width: 75%;" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Customer</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="createForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-code" class="control-label mb-0 d-block">Customer Code</label>
                                    <input type="text" name="Code" id="create-code" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-name" class="control-label mb-0 d-block">Customer Name</label>
                                    <input type="text" name="Name" id="create-name" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="create-commission" class="form-label mb-0">Commission Rate</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.01" min="0" max="100" id="create-commission" name="CommissionRate" class="form-control form-control-sm" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label class="control-label mb-0 d-block" for="create-usearearate"> Use Area Rate? </label>
                                    <input class="form-check-input" type="checkbox" id="create-usearearate" name="UseAreaRate">
                                    @* <label for="create-is-active" class="control-label mb-0 d-block">Use Area Rate?</label>
                                <input type="checkbox" name="IsActive" id="create-is-active" class="form-control form-control-sm" />*@
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-region" class="control-label mb-0 d-block">Region</label>
                                    <select name="Region" id="create-region" class="form-control" style="width: 100%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label for="create-area" class="control-label mb-0 d-block">Area</label>
                                <select name="Area" id="create-area" class="form-control" style="width: 100%">
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="create-customer-type" class="control-label mb-0 d-block">Customer Type</label>
                                <select name="CustomerType" id="create-customer-type" class="form-control" style="width: 100%">
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-contact-person" class="control-label mb-0 d-block">Contact Person</label>
                                    <input type="text" name="ContactPerson" id="create-contact-person" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-contact-number" class="control-label mb-0 d-block">Contact Number</label>
                                    <input type="text" name="ContactNumber" id="create-contact-number" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-address" class="control-label mb-0 d-block">Address</label>
                                    <input type="text" name="Address" id="create-address" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-email" class="control-label mb-0 d-block">Email</label>
                                    <input type="text" name="Email" id="create-email" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-agent" class="control-label mb-0 d-block">Agent Name</label>
                                    <select name="Agent" id="create-agent" class="form-control" style="width: 100%">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-fax-number" class="control-label mb-0 d-block">Fax Number</label>
                                    <input type="text" name="FaxNumber" id="create-fax-number" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-tin" class="control-label mb-0 d-block">TIN</label>
                                    <input type="text" name="TIN" id="create-tin" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-vat" class="control-label mb-0 d-block">VAT</label>
                                    <input type="text" name="VAT" id="create-vat" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-credit-term" class="control-label mb-0 d-block">Credit Term</label>
                                    <select name="CreditTerm" id="create-credit-term" class="form-control" style="width: 100%">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="create-credit-limit" class="control-label mb-0 d-block">Credit Limit</label>
                                    <input type="number" name="CreditLimit" id="create-credit-limit" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label for="create-remarks" class="control-label mb-0 d-block">Customer Status</label>
                                    <input name="Remarks" id="create-remarks" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

