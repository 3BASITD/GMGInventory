                                <span data-valmsg-for="create-contact-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                          <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-address" class="control-label mb-0 d-block">Address</label>
                                <input type="text" name="Address" id="create-address" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-address" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                               <label for="create-email" class="control-label mb-0 d-block">Email</label>
                                <input type="text" name="Email" id="create-email" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-email" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-agent" class="control-label mb-0 d-block">Agent Name</label>
                                <select name="Agent" id="create-agent" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-agent" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-fax-number" class="control-label mb-0 d-block">Fax Number</label>
                                <input type="text" name="FaxNumber" id="create-fax-number" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-fax-number" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-tin" class="control-label mb-0 d-block">TIN</label>
                                <input type="text" name="TIN" id="create-tin" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-tin" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                               <label for="create-vat" class="control-label mb-0 d-block">VAT</label>
                                <input type="text" name="VAT" id="create-vat" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-vat" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                         <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-credit-term" class="control-label mb-0 d-block">Credit Term</label>
                                <select name="CreditTerm" id="create-credit-term" class="form-control" style="width: 100%">
                                </select>
                                <span data-valmsg-for="create-credit-term" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="create-credit-limit" class="control-label mb-0 d-block">Credit Limit</label>
                                <input type="number" name="CreditLimit" id="create-credit-limit" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-credit-limit" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="create-remarks" class="control-label mb-0 d-block">Remarks</label>
                                <input name="Remarks" id="create-remarks" class="form-control form-control-sm" />
                                <span data-valmsg-for="create-remarks" data-valmsg-replace="true" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <span class="fas fa-plus"></span> Add
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>




