@model CustomerVM

@{
    ViewData["Title"] = "New Customer";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Index">Customers</a></li>
}

    <div class="card card-default">
        <div class="card-header">
            <span class="card-title">@ViewData["Title"]</span>
            <div class="card-tools">
                <a class="btn btn-light btn-sm float-right mr-2" asp-action="Index">
                    <span class="fas fa-arrow-left"></span> Back to List
                </a>
            </div>
        </div>
        <form asp-action="Create">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                 <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Code" class="control-label mb-0"></label>
                            <input asp-for="Code" class="form-control form-control-sm" />
                            <span asp-validation-for="Code" class="text-danger"></span>

                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Name" class="control-label mb-0"></label>
                            <input asp-for="Name" class="form-control form-control-sm" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="CustomerTypeId" class="control-label mb-0"></label>
                            <select asp-for="CustomerTypeId" asp-items="Model?.CustomerTypes" class="form-control select2option">
                            </select>
                            <span asp-validation-for="CustomerTypeId" class="text-danger"></span>
                        </div>
                    </div>   
                 </div>

                 <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="RegionId" class="control-label mb-0"></label>
                            <select asp-for="RegionId" asp-items="Model?.Regions" class="form-control select2option">
                            </select>
                            <span asp-validation-for="RegionId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="AreaId" class="control-label mb-0"></label>
                            <select asp-for="AreaId" asp-items="Model?.Areas" class="form-control select2option">
                            </select>
                            <span asp-validation-for="AreaId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Address" class="control-label mb-0"></label>
                            <input asp-for="Address" class="form-control form-control-sm" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>   
                 </div>

                 <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="ContactPerson" class="control-label mb-0"></label>
                            <input asp-for="ContactPerson" class="form-control form-control-sm" />
                            <span asp-validation-for="ContactPerson" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="ContactNumber" class="control-label mb-0"></label>
                            <input asp-for="ContactNumber" class="form-control form-control-sm" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="FaxNumber" class="control-label mb-0"></label>
                            <input asp-for="FaxNumber" class="form-control form-control-sm" />
                            <span asp-validation-for="FaxNumber" class="text-danger"></span>
                        </div>
                    </div>   
                 </div>

                 <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Email" class="control-label mb-0"></label>
                            <input asp-for="Email" class="form-control form-control-sm" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="AgentId" class="control-label mb-0"></label>
                            <select asp-for="AgentId" asp-items="Model?.Agents" class="form-control select2option">
                            </select>
                            <span asp-validation-for="AgentId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="CreditTermId" class="control-label mb-0"></label>
                            <select asp-for="CreditTermId" asp-items="Model?.CreditTerms" class="form-control select2option">
                            </select>
                            <span asp-validation-for="CreditTermId" class="text-danger"></span>
                        </div>
                    </div>   
                 </div>

                  <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="TIN" class="control-label mb-0"></label>
                            <input asp-for="TIN" class="form-control form-control-sm" />
                            <span asp-validation-for="TIN" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="CreditLimit" class="control-label mb-0"></label>
                            <input asp-for="CreditLimit" class="form-control form-control-sm" />
                            <span asp-validation-for="CreditLimit" class="text-danger"></span>
                        </div>
                    </div>
                    
                 </div>

                 <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="Remarks" class="control-label mb-0"></label>
                            <input asp-for="Remarks" class="form-control form-control-sm" />
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>
                    </div>
                 </div>


              
            </div>

            <div class="card-footer">
                <div class="card-tools">
                    <button type="submit" class="btn btn-primary btn-sm float-right">
                        <span class="fas fa-save"></span> Save
                    </button>
                </div>
            </div>
        </form>
    </div>

    @section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
