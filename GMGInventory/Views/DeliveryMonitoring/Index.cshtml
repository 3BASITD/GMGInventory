                        }
                    },
                    DeliveryDate: {
                        required: function () {
                            return $("#delivery-status").select2("data")[0].name.trim().toLowerCase() == "delivered";
                        }
                    },
                    ReceiveDate: {
                        required: function () {
                            return $("#delivery-method").select2("data")[0].name.trim().toLowerCase() == "customer pickup";
                        }
                    },
                    Forwarder: {
                        required: function () {
                            var selected = $("#delivery-method").select2("data")[0].name.trim().toLowerCase();
                            return selected == "forwarder" || selected == "courier";
                        }
                    },
                    Waybill: {
                        required: function () {
                            var selected = $("#delivery-method").select2("data")[0].name.trim().toLowerCase();
                            return selected == "forwarder" || selected == "courier";
                        },
                        maxlength: 150
                    },
                    Driver: {
                        required: function () {
                            return $("#delivery-method").select2("data")[0].name.trim().toLowerCase() == "company truck";
                        }
                    },
                    Vehicle: {
                        required: function () {
                            return $("#delivery-method").select2("data")[0].name.trim().toLowerCase() == "company truck";
                        }
                    },
                    ReceiverName: {
                        required: function () {
                            return $("#delivery-method").select2("data")[0].name.trim().toLowerCase() == "customer pickup";
                        },
                        maxlength: 500
                    },
                    ReceiverContact: {
                        required: function () {
                            return $("#delivery-method").select2("data")[0].name.trim().toLowerCase() == "customer pickup";
                        },
                        maxlength: 500
                    },
                    Remarks: { maxlength: 500 }
                },
                messages: {
                    PickupDate: { required: "Please select pickup date" },
                    DeliveryDate: { required: "Please select delivery date" },
                    ReceiveDate: { required: "Please select receive date" },
                    Forwarder: { required: "Please select forwarder" },
                    Waybill: { required: "Please enter waybill" },
                    Driver: { required: "Please select driver" },
                    Vehicle: { required: "Please select vehicle" },
                    ReceiverName: { required: "Please enter name of receiver" , maxlength: "Name must not exceed 500 characters" },
                    ReceiverContact: { required: "Please enter contact of receiver" , maxlength: "Contact must not exceed 500 characters" },
                    Remarks: { maxlength: "Remarks must not exceed 500 characters" }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoSave();
                }
            });

            // Send Delivery to Controller
            function DoSave() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SaveDelivery")",
                    data: {
                        SalesOrderId: $("#delivery-so-number").data("Id"),
                        PackId: $("#delivery-pack-number").val(),
                        DeliveryStatusId: $("#delivery-status").val(),
                        PickupDate: $("#delivery-pickup-date").val(),
                        DeliveryDate: $("#delivery-delivery-date").val(),
                        ReceiveDate: $("#delivery-receive-date").val(),
                        DeliveryMethodId: $("#delivery-method").val(),
                        ForwarderId: $("#delivery-forwarder").val(),
                        Waybill: $("#delivery-waybill").val(),
                        ReceiverName: $("#delivery-receiver-name").val(),
                        ReceiverContact: $("#delivery-receiver-contact").val(),
                        Remarks: $("#delivery-remarks").val()
                    },
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            //toastr.error(data.message, data.status);
                            ToastrAndConsoleError(data.status, data.message);
                        } else {
                            toastr.success(data.message, "Success");
                            $("#deliveryModal").modal("hide");
                            deliveryDT.ajax.reload();
                            hideLoader()
                        }
                    }
                });
            }
        }

        function loadSelect2({
            selector,
            url,
            selected,
            allowClear,
            allowSearch,
            functionOnComplete
        }) {
            var $el = $(selector);

            if ($el.hasClass("select2-hidden-accessible")) {
                $el.select2("destroy");
            }
            $el.empty();

            $.ajax({
                type: "POST",
                url: url,
                data: { includeId: selected },
                success: function (response) {
                    $el.select2({
                        ajax: null, // already fetched outside
                        data: response,
                        allowClear: allowClear,
                        minimumResultsForSearch: allowSearch ? 0 : -1,
                        placeholder: {
                            id: "",
                            text: "<empty>"
                        },
                        dropdownParent: $("#deliveryModal")
                    });
                },
                complete: function () {
                    if (!selected && allowClear)
                        $el.val(null).trigger("change");
                    functionOnComplete?.();
                }
            });
        }

        function DisplayStatusFields() {
            $(".delivery-pickup-date-container").hide();
            $(".delivery-delivery-date-container").hide();
            var selected = $("#delivery-status").select2("data")[0].name.trim().toLowerCase();
            if (selected == "picked up") {
                $(".delivery-pickup-date-container").show();
                $("#delivery-delivery-date").val(null);
            } else if(selected == "delivered") {
                $(".delivery-delivery-date-container").show();
                $("#delivery-pickup-date").val(null);
            }
        }
        
        function DisplayMethodFields() {
            $(".forwarder-container").hide();
            $(".waybill-container").hide();
            $(".vehicle-container").hide();
            var selected = $("#delivery-method").select2("data")[0].name.trim().toLowerCase();
            if (selected == "company truck") {
                $(".vehicle-container").show();
                $("#delivery-forwarder").val(null).trigger("change");
                $("#delivery-waybill").val("");
            } else if (selected == "forwarder" || selected == "courier") {
                $(".forwarder-container").show();
                $(".waybill-container").show();
                $("#delivery-driver").val(null).trigger("change");
                $("#delivery-vehicle").val(null).trigger("change");
            } else if (selected == "customer pickup") {
                $("#delivery-forwarder").val(null).trigger("change");
                $("#delivery-waybill").val("");
                $("#delivery-driver").val(null).trigger("change");
                $("#delivery-vehicle").val(null).trigger("change");
            }
        }

