@{
    ViewData["Title"] = "Delivery Monitoring";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="alert alert-info" role="alert">
    <span class="fas fa-exclamation-triangle mr-3"></span>You are using a v4 enhancement feature. This message will be removed once v4 is completed and made available as a fully paid version.
</div>

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <button class="btn btn-secondary btn-sm float-right btn-filter ml-2" data-bs-toggle="modal" data-bs-target="#filterModal">
                <span class="fas fa-filter"></span> Filter
            </button>
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right ml-2 downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-delivery">
            <thead>
                <tr>
                    <th>Sales Order Date</th>
                    <th>Sales Order Number</th>
                    <th>Total Sales Order</th>
                    <th>Order Queue Number</th>
                    <th>Service Level Agreement</th>
                    <th>Customer</th>
                    <th>Sales Order Prepared By</th>
                    <th>Sales Order Approved By</th>
                    <th>Special Instruction</th>
                    <th>Forwarder</th>
                    <th>Status 1</th>
                    <th>Status 2</th>
                    <th>Status 3</th>
                    <th>Status 4</th>
                    <th>Status 5</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="card-footer">
        <button class="btn btn-secondary btn-sm float-right btn-chart ml-2" data-bs-toggle="modal" data-bs-target="#chartModal">
            <span class="fas fa-chart-pie mr-0"></span>
        </button>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Filter Table</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent" class="form-label mb-0">Agent Code</label>
                            <select id="filter-agent" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-agent-name" class="form-label mb-0">Agent Name</label>
                            <input type="text" id="filter-agent-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer" class="form-label mb-0">Customer Code</label>
                            <select id="filter-customer" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-customer-name" class="form-label mb-0">Customer Name</label>
                            <input type="text" id="filter-customer-name" class="form-control form-control-sm" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-region" class="form-label mb-0">Region</label>
                            <select id="filter-region" style="width:100%">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-preset" class="form-label mb-0">Date Range</label>
                            <select id="filter-preset" class="form-control form-control-sm">
                                <option value="TD">Today</option>
                                <option value="L7D">Last 7 Days</option>
                                <option value="MTD">Month to Date</option>
                                <option value="LM">Last Month</option>
                                <option value="YTD">Year to Date</option>
                                <option value="">Custom Range</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-from" class="form-label mb-0">Sales Order Date From</label>
                            <input type="date" id="filter-from" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-group">
                            <label for="filter-to" class="control-label mb-0">Sales Order Date To</label>
                            <input type="date" id="filter-to" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-3 pb-2 text-muted small modal-note">
                Your filter, sort, and search will be saved for 1 hour
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btnReset" onclick="ResetFilter()"><span class="fas fa-undo"></span> Reset to Default</button>
                <button type="button" class="btn btn-primary" onclick="ApplyFilter()"><span class="fas fa-filter"></span> Apply Filter</button>
            </div>
        </div>
    </div>
</div>

