<!-- Chart Modal -->
<div class="modal fade" id="chartModal" role="dialog" aria-labelledby="chartModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title chart-title">Last 7 Days Count Chart</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body d-flex justify-content-center">
                <canvas id="salesChart"></canvas>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <span class="fas fa-times"></span> Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load Select2 for Agent
        $("#filter-agent").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2", "Agent")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-agent").on("select2:select", function () {
            $("#filter-agent-name").val($(this).select2("data")[0].name);
        });

        $("#filter-agent").on("select2:unselecting", function (e) {
            $("#filter-agent-name").val("");
        });

        // Load Select2 for Customer
        $("#filter-customer").select2({
            allowClear: true,
            placeholder: 'ALL',
            templateResult: function (repo) {
                if (repo.loading) {
                    return repo.text;
                }
                return $("<strong>" + repo.text + "</strong> " + (repo.text !== repo.name ? "<em class='fw-light'> - " + repo.name + "</em>" : ""));
            },
            ajax: {
                url: "@Url.Action("GetOptions2Simple", "Customer")"
            },
            dropdownParent: $("#filterModal")
        });

        $("#filter-customer").on("select2:select", function () {
            $("#filter-customer-name").val($(this).select2("data")[0].name);
        });

        $("#filter-customer").on("select2:unselecting", function (e) {
            $("#filter-customer-name").val("");
        });

        // Load region data for select2
        $.ajax({
            type: "POST",
            url: "@Url.Action("GetOptions", "Region")",
            success: function (data, status, xhr) {
                $("#filter-region").select2({
                    ajax: null, //already fetched outside
                    allowClear: true,
                    placeholder: 'ALL',
                    data: data,
                    minimumResultsForSearch: Infinity
                });
            }
        });

        var dt_storage = "BAS_DT" + window.location.pathname.replace(/\//g, "_");
        var dt_duration = 3600000; // 1 hour

        function ApplyFilter() {
            $("#filterModal").modal("hide");
            deliveryDT.ajax.reload(() => {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var expiry = parsed.timestamp + dt_duration;
                    $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                }
                checkDefaultFilter();
            });
        }

        function ResetFilter() {
            $("#filterModal").modal("hide");
            resetToDefaultDTFilter();
            deliveryDT.ajax.reload(() => {
                checkDefaultFilter();
            });
        }

        var defaultDTState = {
            order: [[0, "desc"]],
            page: 0,
            length: 10,
            search: { search: "" },
            Agent: "",
            AgentName: "",
            AgentId: "",
            Customer: "",
            CustomerId: "",
            Region: "",
            RegionId: "",
            Preset: "L7D",
            DateFrom: DateForInput(getFilterDefaultDateFrom()),
            DateTo: DateForInput(getFilterDefaultDateTo())
        };

        function checkDTChanged() {
            if(!deliveryDT) return false;
            
            return JSON.stringify(deliveryDT.order()) != JSON.stringify(defaultDTState.order) ||
                   deliveryDT.page.info().start != defaultDTState.page ||
                   deliveryDT.page.len() != defaultDTState.length ||
                   $("#filter-agent").val() != defaultDTState.AgentId ||
                   $("#filter-customer").val() != defaultDTState.CustomerId ||
                   $("#filter-region").val() != defaultDTState.RegionId ||
                   $("#filter-preset").val() != defaultDTState.Preset ||
                   $('#filter-from').val() != defaultDTState.DateFrom ||
                   $('#filter-to').val() != defaultDTState.DateTo;
        }

        function checkDefaultFilter() {
            $(".btn-filter").toggleClass('btn-filtered', checkDTChanged());
            $(".btnReset").toggle(checkDTChanged());
            if (!checkDTChanged()) {
                $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
            }
        }

        function resetToDefaultDTFilter() {
            localStorage.removeItem(dt_storage);
            
            $('#filter-agent').val(defaultDTState.AgentId).trigger('change');
            $('#filter-agent-name').val(defaultDTState.AgentName);
            $('#filter-customer').val(defaultDTState.CustomerId).trigger('change');
            $('#filter-customer-name').val(defaultDTState.CustomerName);
            $('#filter-region').val(defaultDTState.RegionId).trigger('change');
            $('#filter-preset').val(defaultDTState.Preset);
            applyFilterPreset(defaultDTState.Preset);
            
            if (deliveryDT) {
                deliveryDT.state.clear();
                deliveryDT.order(defaultDTState.order);
                deliveryDT.page(defaultDTState.page);
                deliveryDT.search(defaultDTState.search.search);
            }
            
            $(".modal-note").text("Your filter, sort, and search will be saved for 1 hour");
        }

        var deliveryDT = $('.table-delivery').DataTable({
            stateSave: true,
            stateSaveCallback: function(settings, data) {
                var now = new Date().getTime();
                var dtState = { data: data, timestamp: now, duration: dt_duration, pathname: window.location.pathname };
                localStorage.setItem(dt_storage, JSON.stringify(dtState));
            },
            stateLoadCallback: function(settings) {
                var saved = localStorage.getItem(dt_storage);
                if (saved) {
                    var parsed = JSON.parse(saved);
                    var age = new Date().getTime() - parsed.timestamp;
                    var expiry = parsed.timestamp + dt_duration;
                    if (age < dt_duration) {
                        $(".modal-note").text("Your filter, sort, and search resets on " + (new Date(expiry)).toLocaleString());
                        return parsed.data;
                    } else {
                        resetToDefaultDTFilter();
                    }
                }
                return null;
            },
            stateSaveParams: function (settings, data) {
                data.Agent = $('#filter-agent option:selected').text();
                data.AgentId = $('#filter-agent').val();
                data.AgentName = $('#filter-agent-name').val();
                data.Customer = $('#filter-customer option:selected').text();
                data.CustomerId = $('#filter-customer').val();
                data.CustomerName = $('#filter-customer-name').val();
                data.Region = $('#filter-region option:selected').text();
                data.RegionId = $('#filter-region').val();
                data.Preset = $('#filter-preset').val();
                data.DateFrom = $('#filter-from').val();
                data.DateTo = $('#filter-to').val();
            },
            stateLoadParams: function (settings, data) {
                if(data.AgentId) {
                    var agentOption = new Option(data.Agent, data.AgentId, true, true);
                    $(agentOption).data('data', {
                        id: data.AgentId,
                        text: data.Agent,
                        name: data.AgentName
                    });
                    $("#filter-agent").append(agentOption).trigger('change');
                    $("#filter-agent-name").val(data.AgentName);
                }
                if(data.CustomerId) {
                    var customerOption = new Option(data.Customer, data.CustomerId, true, true);
                    $(customerOption).data('data', {
                        id: data.CustomerId,
                        text: data.Customer,
                        name: data.CustomerName
                    });
                    $("#filter-customer").append(customerOption).trigger('change');
                    $("#filter-customer-name").val(data.CustomerName);
                }
                if(data.RegionId) {
                    var regionOption = new Option(data.Region, data.RegionId, true, true);
                    $(regionOption).data('data', {
                        id: data.RegionId,
                        text: data.Region
                    });
                    $("#filter-region").append(regionOption).trigger('change');
                }
                $('#filter-preset').val(data.Preset).trigger('change');
                $('#filter-from').prop('readonly', data.Preset != "");
                $('#filter-from').val(data.DateFrom);
                $('#filter-to').prop('readonly', data.Preset != "");
                $('#filter-to').val(data.DateTo);
            },
            ajax: {
                url: "@Url.Action("GetListDT")",
                data: function (data) {
                    var agentId = $("#filter-agent").val();
                    if (agentId) data.AgentId = agentId;

                    var customerId = $("#filter-customer").val();
                    if (customerId) data.CustomerId = customerId;

                    var regionId = $("#filter-region").val();
                    if (regionId) data.RegionId = regionId;

                    data.DateFrom = $("#filter-from").val();
                    data.DateTo = $("#filter-to").val();
                },
                type: "POST",
                beforeSend: function (jqXHR, settings) {
                    settings.isDataTableRequest = true;
                }
            },
            processing: true,
            language: {
                processing: "<div class='dt-loader'>Processing table, please wait...</div>"
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "dateOrder", name: "DateOrder" },
                {
                    data: function (data, type, dataToSet) {
                        return "<a href='/SalesOrder/Details/" + data.salesOrderId + "' class='link-info' target='_blank'>" + data.salesOrderNumber + "</a>";
                    },
                    name: "SalesOrderNumber"
                },
                {
                    data: function(data, type, dataToSet) {
                        if (data.totalSalesOrder)
                            return data.totalSalesOrder || '<em class="text-muted">N/A</em>';
                        else
                            return '<span class="text-muted">N/A</span>';
                    },
                    name: "TotalSalesOrder"
                },
                {
                    data: function (data, type, dataToSet) {
                        if(data.orderQueueNumber)
                            return `<a href="/OrderQueue/Details/${data.orderQueueNumber}" class="link-info" target="_blank">${data.orderQueueNumber}</a>`;
                        else
                            return '<span class="text-muted">N/A</span>';
                    },
                    name: "OrderQueueNumber"
                },
                { data: "serviceLevelAgreement", name: "ServiceLevelAgreement" },
                {
                    data: function (data, type, dataToSet) {
                        return `<a href="/Customer/Details/${data.customerId}" class="link-info with-wrap" target="_blank">${data.customer}</a>`;
                    },
                    name: "Customer"
                },
                { data: "soPreparedBy", name: "SOPreparedBy" },
                {
                    data: function (data, type, dataToSet) {
                        return data.soApprovedBy || '<em class="text-muted">N/A</em>';
                    },
                    name: "SOApprovedBy"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.specialInstruction || '<em class="text-muted">N/A</em>';
                    },
                    name: "SpecialInstruction"
                },
                {
                    data: function (data, type, dataToSet) {
                        return data.forwarder || '<em class="text-muted">N/A</em>';
                    },
                    name: "Forwarder"
                },
                { data: "status1", name: "Status1" },
                {
                    //orderable: false,
                    data: function (data, type, dataToSet) {
                        //return "<span class='badge badge-danger'>COMING SOON</span>";
                        return data.status2 || '<em class="text-muted">N/A</em>';
                    },
                    name: "Status2"
                },
                {
                    //orderable: false,
