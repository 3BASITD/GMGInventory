        var salesChart = null;

        $(document).on("click", ".btn-chart", function () {
            $.post("@Url.Action("GetLatestCount")", function (data) {
                if (!salesChart)
                    createSalesChart(data);
                else
                    updateSalesChart(data);
            });
        });

        function createSalesChart(data) {
            var ctx = document.getElementById("salesChart");

            salesChart = new Chart(ctx, {
                type: "bar",
                options: {
                    responsive: true,
                    scales: {
                        x: {
                            stacked: true
                        },
                        y: {
                            stacked: true
                        }
                    },
                    interaction: {
                        mode: 'nearest',
                        axis: 'x',
                        intersect: false
                    }
                },
                data: {
                    labels: data.map(x => x.date),
                    datasets: [
                        {
                            label: "Orders",
                            fill: true,
                            backgroundColor: "blue",
                            data: data.map(x => x.orderCount)
                        },
                        {
                            label: "Picked",
                            fill: true,
                            backgroundColor: "orange",
                            data: data.map(x => x.pickCount)
                        },
                        {
                            label: "Packed",
                            fill: true,
                            backgroundColor: "purple",
                            data: data.map(x => x.packCount)
                        },
                        {
                            label: "Invoiced",
                            fill: true,
                            backgroundColor: "teal",
                            data: data.map(x => x.invoiceCount)
                        },
                        {
                            label: "Delivered",
                            fill: true,
                            backgroundColor: "green",
                            data: data.map(x => x.deliveredCount)
                        }
                    ]
                }
            });
        }

        function updateSalesChart(data) {
            salesChart.data.labels = data.map(x => x.date);

            salesChart.data.datasets[0].data = data.map(x => x.orderCount);
            salesChart.data.datasets[1].data = data.map(x => x.pickCount);
            salesChart.data.datasets[2].data = data.map(x => x.packCount);
            salesChart.data.datasets[3].data = data.map(x => x.invoiceCount);
            salesChart.data.datasets[4].data = data.map(x => x.deliveredCount);

            salesChart.update();
        }
    </script>
