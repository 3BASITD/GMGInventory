@model IEnumerable<BrandViewVM>

@{
    ViewData["Title"] = "Brand";
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            <a class="btn btn-primary btn-sm float-right" asp-action="Create">
                <span class="fas fa-plus"></span> New Brand
            </a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserModified)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateModified)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null)
                {
                    <tr><td colspan="9"><p class="text-center m-0">This record is empty</p></td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Code</td>
                            <td>@item.Name</td>
                            <td>@item.ItemType.Name</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="fas fa-check text-success"></span>
                                }
                                else
                                {
                                    <span class="fas fa-times text-danger"></span>
                                }
                            </td>
                            <td>@item.UserCreated</td>
                            <td>@item.DateCreated</td>
                            <td>@item.UserModified</td>
                            <td>@item.DateModified</td>
                            <td>
                                <a class="btn btn-info btn-xs" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                @if (item.IsActive)
                                {
                                    <a class="btn btn-warning btn-xs" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                    <button data-id="@item.Id" class="btn btn-danger btn-xs deleteBtn" type="button">
                                        <i class="far fa-trash-alt"></i>
                                    </button>
                                }
                                else
                                {
                                    <button data-id="@item.Id" class="btn btn-success btn-xs reactivateBtn" type="button">
                                        <i class="fas fa-check"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<form id="deleteBrandForm" asp-action="Delete">
    <input type="hidden" id="deleteBrandId" name="Id" />
</form>

<form id="reactivateBrandForm" asp-action="Reactivate">
    <input type="hidden" id="reactivateBrandId" name="Id" />
</form>

<form id="deleteBrandForm" asp-action="Delete">
    <input type="hidden" id="deleteBrandId" name="Id" />
</form>

<form id="reactivateBrandForm" asp-action="Reactivate">
    <input type="hidden" id="reactivateBrandId" name="Id" />
</form>


@section Scripts {
    <script>

        $('.table').DataTable({
            order: [[0, "desc"]]
        });

        $('.deleteBtn').click(function(e) {
            swal({
                title: "Delete / Deactivate Brand",
                text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                icon: "warning",
                buttons: true,
                dangerMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#deleteBrandId').val(id);
                    $('#deleteBrandForm').submit();
                }
            });
        });

        $('.reactivateBtn').click(function(e) {
            swal({
                title: "Reactivate Brand",
                text: "Are you sure you want to reactivate this record?",
                icon: "info",
                buttons: true,
                infoMode: true
            }).then((confirm) => {
                if (confirm) {
                    var btn = $(this);
                    var id = btn.data("id");
                    $('#reactivateBrandId').val(id);
                    $('#reactivateBrandForm').submit();
                }
            });
        });
    </script>
}