@model IEnumerable<BrandViewVM>

@{
    ViewData["Title"] = "Brand";
    var userAccess = (ViewsAccessVM)ViewData["UserAccess"]!;
}

<div class="card card-default">
    <div class="card-header">
        <span class="card-title">@ViewData["Title"]</span>
        <div class="card-tools">
            @if (userAccess.CanAdd)
            {
                <button type="button" class="btn btn-primary btn-sm float-right createBtn ml-2" data-bs-toggle="modal" data-bs-target="#createModal">
                    <span class="fas fa-plus"></span> New Brand
                </button>
            }
            @if (userAccess.CanUploadDownload)
            {
                <button type="button" class="btn btn-secondary btn-sm float-right uploadBtn ml-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <span class="fas fa-upload"></span> Upload
                </button>
                <button type="button" class="btn btn-secondary btn-sm float-right downloadBtn">
                    <span class="fas fa-download"></span> Download
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        <table class="table table-head-fixed table-striped table-hover table-brands">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Code)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ItemType)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateCreated)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserModified)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateModified)
                    </th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@if (userAccess.CanDelete)
{
    <form id="deleteBrandForm" asp-action="Delete">
        <input type="hidden" id="deleteBrandId" name="Id" />
    </form>
}

@if (userAccess.CanAdd || userAccess.CanEdit)
{
    <form id="reactivateBrandForm" asp-action="Reactivate">
        <input type="hidden" id="reactivateBrandId" name="Id" />
    </form>
}

@if (userAccess.CanAdd)
{
    <!-- Create Modal -->
    <div class="modal fade" id="createModal" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Brand</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="createForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="create-code" class="control-label mb-0 d-block">Code</label>
                                    <input name="code" id="create-code" class="form-control form-control-sm" />
                                    <span data-valmsg-for="create-code" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label for="create-name" class="control-label mb-0 d-block">Name</label>
                                    <input name="name" id="create-name" class="form-control form-control-sm" />
                                    <span data-valmsg-for="create-name" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label for="create-itemType" class="control-label mb-0 d-block">Item Type</label>
                                    <select name="itemType" id="create-itemType" class="form-control" style="width: 100%">
                                    </select>
                                    <span data-valmsg-for="create-itemType" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-plus"></span> Add
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (userAccess.CanEdit)
{
    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Brand</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form autocomplete="off" id="editForm">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label for="edit-code" class="control-label mb-0 d-block">Code</label>
                                    <input name="code" id="edit-code" class="form-control form-control-sm" readonly="readonly" />
                                    <span data-valmsg-for="edit-code" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label for="edit-name" class="control-label mb-0 d-block">Name</label>
                                    <input name="name" id="edit-name" class="form-control form-control-sm" />
                                    <span data-valmsg-for="edit-name" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label for="edit-itemType" class="control-label mb-0 d-block">Item Type</label>
                                    <select name="itemType" id="edit-itemType" class="form-control" style="width: 100%">
                                    </select>
                                    <span data-valmsg-for="edit-itemType" data-valmsg-replace="true" class="text-danger"></span>
                                </div>
                                <input type="hidden" id="edit-id" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <span class="fas fa-edit"></span> Update
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <span class="fas fa-times"></span> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (userAccess.CanUploadDownload)
{
    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" role="dialog" aria-labelledby="uploadModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Brand</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label mb-0" for="upload-file">Excel File</label>
                        <input type="file" id="upload-file" name="file"
                        accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                        class="form-control form-control-sm" />
                    </div>
                    <table class="table table-striped" id="upload-table">
                        <thead>
                            <tr><th>Row #</th><th>Code</th><th>Name</th><th>Item Type</th><th>Status</th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" onclick="DoUpload()">
                        <span class="fas fa-upload"></span> Upload
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <span class="fas fa-times"></span> Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" role="dialog" aria-labelledby="detailsModalLabel" aria-hidden="true" data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Brand Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <dl class="row">
                    <dt class="col-sm-4">Code</dt>
                    <dd class="col-sm-8 modal-detail-code"></dd>
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8 modal-detail-name"></dd>
                    <dt class="col-sm-4">Item Type</dt>
                    <dd class="col-sm-8 modal-detail-itemType"></dd>
                    <dt class="col-sm-4">Active</dt>
                    <dd class="col-sm-8 modal-detail-isactive"></dd>
                    <dt class="col-sm-4">User Created</dt>
                    <dd class="col-sm-8 modal-detail-usercreated"></dd>
                    <dt class="col-sm-4">Date Created</dt>
                    <dd class="col-sm-8 modal-detail-datecreated"></dd>
                    <dt class="col-sm-4">User Modified</dt>
                    <dd class="col-sm-8 modal-detail-usermodified"></dd>
                    <dt class="col-sm-4">Date Modified</dt>
                    <dd class="col-sm-8 modal-detail-datemodified"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var user_access = @Html.Raw(Json.Serialize(userAccess));

        // Load List on DataTable
        var dataTable = $('.table-brands').on('preXhr.dt', function (e, settings, data) {
            showLoader();
        }).DataTable({
            ajax: {
                url: "@Url.Action("GetListJson")",
                type: "POST",
            },
            serverSide: true,
            filter: true,
            responsive: true,
            autoWidth: false,
            search: {
                return: true,
            },
            columns: [
                { data: "code", name: "Code" },
                { data: "name", name: "Name" },
                { data: "itemType", name: "ItemType" },
                {
                    data: function (data, type, dataToSet) {
                        if (data.isActive) {
                            return '<span class="fas fa-check text-success"></span>';
                        } else {
                            return '<span class="fas fa-times text-danger"></span>';
                        }
                    },
                    name: "IsActive"
                },
                { data: "userCreated", name: "UserCreated" },
                { data: "dateCreated", name: "DateCreated" },
                { data: "userModified", name: "UserModified" },
                { data: "dateModified", name: "DateModified" },
                {
                    orderable: false,
                    data: function (data, type, dataToSet) {
                        var actions = '';
                        actions += '<button class="btn btn-info btn-xs detailsBtn" data-bs-toggle="modal" data-bs-target="#detailsModal" data-microtip-title="View Details data-microtip-position="top-left" role="tooltip"><i class="fas fa-info-circle"></i></button>';
                        if (data.isActive) {
                            if (user_access.canEdit) {
                                actions += '<button class="btn btn-warning btn-xs editBtn" data-bs-toggle="modal" data-bs-target="#editModal" data-microtip-title="Edit Details" data-microtip-position="top-left" role="tooltip"><i class="fas fa-pencil-alt"></i></button>';
                            }
                            if (user_access.canDelete) {
                                actions += '<button data-id="' + data.id + '" class="btn btn-danger btn-xs deleteBtn" data-microtip-title="Delete / Deactivate Brand" data-microtip-position="top-left" role="tooltip"><i class="far fa-trash-alt"></i></button>';
                            }
                        } else {
                            if (user_access.canAdd || user_access.canEdit) {
                                actions += '<button data-id="' + data.id + '" class="btn btn-success btn-xs reactivateBtn" data-microtip-title="Reactivate Brand" data-microtip-position="top-left" role="tooltip"><i class="fas fa-check"></i></button>';
                            }
                        }
                        actions = '<div class="btn-group" role="group" aria-label="Table Actions">' + actions + '</div>';
                        return actions;
                    }
                }
            ]
        });

        // Load functions upon DataTable load
        dataTable.on("draw", function () {
            hideLoader();

            if (user_access.canDelete) {
                $('.deleteBtn').click(function (e) {
                    swal({
                        title: "Delete / Deactivate Brand",
                        text: "Are you sure you want to delete this record? If this is used on other records, this will be deactivated instead.",
                        icon: "warning",
                        buttons: true,
                        dangerMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#deleteBrandId').val(id);
                            $('#deleteBrandForm').submit();
                        }
                    });
                });
            }

            if (user_access.canAdd || user_access.canEdit) {
                $('.reactivateBtn').click(function (e) {
                    swal({
                        title: "Reactivate Brand",
                        text: "Are you sure you want to reactivate this record?",
                        icon: "info",
                        buttons: true,
                        infoMode: true
                    }).then((confirm) => {
                        if (confirm) {
                            var btn = $(this);
                            var id = btn.data("id");
                            $('#reactivateBrandId').val(id);
                            $('#reactivateBrandForm').submit();
                        }
                    });
                });
            }

            $('.detailsBtn').click(function (e) {
                var data = dataTable.row($(this).parents('tr')).data();
                $(".modal-detail-code").html(data.code);
                $(".modal-detail-name").html(data.name);
                $(".modal-detail-itemType").html(data.itemType);
                $(".modal-detail-isactive").html(data.isActive + (data.isActive ? '' : ' <span class="fas fa-question-circle text-primary" data-microtip-title="This was deleted but instead marked as Inactive because it was used in other records." data-microtip-position="top-left" role="tooltip"></span>'));
                $(".modal-detail-usercreated").html(data.userCreated);
                $(".modal-detail-datecreated").html(data.dateCreated);
                $(".modal-detail-usermodified").html(data.userModified);
                $(".modal-detail-datemodified").html(data.dateModified);
            });

            if (user_access.canEdit) {
                // Actions upon Display Edit Modal
                $(".editBtn").click(function (e) {
                    var data = dataTable.row($(this).parents('tr')).data();

                    $("#edit-id").val(data.id);
                    $("#edit-code").val(data.code);
                    $("#edit-name").val(data.name);
                    //$("#edit-category").val(data.categoryId);
                    //$("#edit-category").trigger("change");

                    // Load Select2 Category on Edit
                    if ($("#edit-itemType").attr("data-select2-id")) {
                        $("#edit-itemType").select2("destroy");
                        $("#edit-itemType").empty();
                    }
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetOptions", "ItemType")",
                        data: { includeId: data.ItemTypeId },
                        success: function (data, status, xhr) {
                            $("#edit-itemType").select2({
                                data: data,
                                allowClear: true,
                                placeholder: {
                                    id: "",
                                    text: "<empty>"
                                },
                                dropdownParent: $('#editModal')
                            });
                        }
                    });
                });

                // Validation for Edit Modal
                var validateEdit = $("#editForm").validate({
                    errorClass: 'text-danger text-xs',
                    rules: {
                        code: { required: true, maxlength: 10 },
                        name: { required: true, maxlength: 100 }
                    },
                    messages: {
                        code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
                        name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." }
                    },
                    submitHandler: function (form, event) {
                        event.preventDefault();
                        DoEdit();
                    },
                    showErrors: validateShowErrors
                });

                // Send Edit to Controller
                function DoEdit() {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("EditJson")",
                        data: {
                            Id: $("#edit-id").val(),
                            Code: $("#edit-code").val(),
                            Name: $("#edit-name").val(),
                            ItemTypeId: $("#edit-itemType").val()
                        },
                        success: function (data, status, xhr) {
                            if (data.status == "Error") {
                                toastr.error(data.message, "Error");
                            } else {
                                toastr.success(data.message, "Success");
                                $("#editModal").modal("hide");
                                dataTable.ajax.reload();
                            }
                        },
                        complete: function (xhr, status) {
                        }
                    });
                }
            }
        });

        if (user_access.canAdd) {
            // Load Select2 Category on Add
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetOptions", "ItemType")",
                success: function (data, status, xhr) {
                    $("#create-itemType").select2({
                        data: data,
                        allowClear: true,
                        placeholder: {
                            id: "",
                            text: "<empty>"
                        },
                        dropdownParent: $('#createModal')
                    });
                }
            });

            // Actions upon Display Create Modal
            $(".createBtn").click(function (e) {
                $("#create-code").val("");
                $("#create-name").val("");
            });

            // Validation for Create Modal
            var validateCreate = $("#createForm").validate({
                errorClass: 'text-danger text-xs',
                rules: {
                    code: { required: true, maxlength: 10 },
                    name: { required: true, maxlength: 100 }
                },
                messages: {
                    code: { required: "Please enter code.", maxlength: "Code must not exceed 10 characters." },
                    name: { required: "Please enter name.", maxlength: "Name must not exceed 100 characters." }
                },
                submitHandler: function (form, event) {
                    event.preventDefault();
                    DoCreate();
                },
                showErrors: validateShowErrors
            });

            // Send Create to Controller
            function DoCreate() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("CreateJson")",
                    data: {
                        Code: $("#create-code").val(),
                        Name: $("#create-name").val(),
                        ItemTypeId: $("#create-itemType").val()
                    },
                    //beforeSend: function (xhr, error) {
                    //    $(".save-overlay").showOverlay();
                    //},
                    success: function (data, status, xhr) {
                        if (data.status == "Error") {
                            toastr.error(data.message, "Error");
                        } else {
                            toastr.success(data.message, "Success");
                            $("#createModal").modal("hide");
                            dataTable.ajax.reload();
                        }
                    },
                    complete: function (xhr, status) {
                        //$(".save-overlay").hideOverlay();
                    }
                });
            }
        }

        if (user_access.canUploadDownload) {
            var json_of_excel;
            var colnumber = 3; // number of columns required for upload
            var done_upload_excel = 0;
            var duplicate_upload = 0;

            var opts = {
                readAsDefault: 'ArrayBuffer',
                dragClass: 'drag',
                on: {
                    load: function (e, file) {
                        var result = new Uint8Array(e.target.result);
                        var xlsread = XLSX.read(result, { type: 'array' });
                        var xlsjson = XLSX.utils.sheet_to_json(xlsread.Sheets[xlsread.SheetNames[0]], { defval: "" });
                        json_of_excel = xlsjson;
                    }
                }
            };
            $("#upload-file").fileReaderJS(opts);

            // Actions upon file selection
            $("#upload-file").on("change", function () {
                done_upload_excel = 0;
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            // Actions upon Display Upload Modal
            $(".uploadBtn").click(function (e) {
                done_upload_excel = 0;
                $("#upload-file").val("");
                $("#upload-table tbody").html("");
                $("#upload-table").hide();
            });

            function DoUpload() {
                if (!$("#upload-file").val()) {
                    toastr.error("Please select a file first");
                } if (json_of_excel.length == 0) {
                    toastr.error("The excel file is empty");
                } else {
                    var columns = Object.keys(json_of_excel[0]);
                    $("#upload-table tbody").html("");
                    $("#upload-table").show();
                    duplicate_upload = 0;
                    for (var i = 0; i < json_of_excel.length; i++) {
                        var rowNum = json_of_excel[i].__rowNum__;
                        var row$ = $('<tr/>').attr("id", "upload-row" + rowNum + "tr");
                        row$.append($('<td/>').html(json_of_excel[i].__rowNum__));
                        for (var colIndex = 0; colIndex < colnumber; colIndex++) {
                            var cellValue = json_of_excel[i][columns[colIndex]];
                            if (cellValue == null)
                                cellValue = "";
                            row$.append($('<td/>').html(cellValue));
                        }
                        if (columns.includes("Code") == false
                            || columns.includes("Name") == false
                            || columns.includes("ItemType") == false) {
                            row$.append($('<td/>').html("Unexpected columns"));
                            UploadRowDone();
                        } else {
                            SaveXLSX(json_of_excel[i]["Code"], json_of_excel[i]["Name"], json_of_excel[i]["ItemType"], rowNum);
                            row$.append($('<td/>').attr("id", "upload-row" + rowNum + "td"));
                        }
                        $("#upload-table").append(row$);
                    }
                }
            }

            function SaveXLSX(code, name, itemType, rownum) {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UploadJson")",
                    data: {
                        Code: code,
                        Name: name,
                        ItemType: itemType
                    },
                    success: function (data, status, xhr) {
                        if (data.message == "Already exist") {
                            $("#upload-row" + rownum + "tr").remove();
                            duplicate_upload++;
                        } else {
                            $("#upload-row" + rownum + "td").html(data.status + ": " + data.message);
                        }
                    },
                    complete: function (xhr, status) {
                        UploadRowDone();
                    }
                });
            }

            function UploadRowDone() {
                done_upload_excel++;
                if (done_upload_excel == json_of_excel.length && duplicate_upload > 0) {
                    $("#upload-table").append('<tr><td colspan="5">Excluded because it already exist: ' + duplicate_upload + ' row(s)</tr>');
                    $("#upload-file").val("");
                }
            }

            $(".downloadBtn").click(function (e) {
                window.location = "@Url.Action("DownloadFile")";
            });
        }
    </script>
}

