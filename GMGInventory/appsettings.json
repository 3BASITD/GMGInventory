SELECT sos.SourceOrderNumber, sos.SalesOrderId, itm.Id, sos.Status, sos.UserCreated, sos.DateCreated
FROM SalesOrderSources sos
JOIN PriceappOrders.dbo.Orders pdo ON sos.SourceOrderNumber = pdo.OrderNo
JOIN Items itm ON pdo.ItemName = itm.Name
JOIN SalesOrderLineItems soli ON sos.SalesOrderId = soli.SalesOrderId AND itm.Id = soli.ItemId
WHERE sos.Status = 'Added' 


