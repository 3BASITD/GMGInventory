pang ayos sa Purpose at Region ng Purchase Order

  
UPDATE po
SET
    po.PurposeId = pr.PurposeId,
    po.RegionId = a.RegionId
	
FROM PurchaseOrderNews po
JOIN PurchaseOrderNewLineItems poli ON poli.PurchaseOrderId = po.Id
JOIN PurchaseRequestLineItems prli ON poli.RequestItemId = prli.Id
JOIN PurchaseRequests pr ON prli.PurchaseRequestId = pr.Id
LEFT JOIN SalesOrders so ON prli.SalesOrderId = so.Id
LEFT JOIN Customers c ON so.CustomerId = c.Id
LEFT JOIN Areas a ON c.AreaId = a.Id



