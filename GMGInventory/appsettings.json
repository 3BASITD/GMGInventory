  pang update ng duplicate

  WITH Duplicated AS (

    SELECT DocumentNumber
    FROM PurchaseRequests
    GROUP BY DocumentNumber
    HAVING COUNT(*) > 1
),
Numbered AS (
    SELECT
        pr.Id,
        pr.DocumentNumber,
        ROW_NUMBER() OVER (
            PARTITION BY pr.DocumentNumber
            ORDER BY pr.Id
        ) AS rn
    FROM PurchaseRequests pr
    INNER JOIN Duplicated d
        ON pr.DocumentNumber = d.DocumentNumber
)
UPDATE Numbered
SET DocumentNumber = DocumentNumber + '.' + CAST(rn AS varchar(10));

